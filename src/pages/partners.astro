---
import Layout from '../layouts/Layout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { getCollection } from 'astro:content';

const sponsors = (await getCollection('sponsors')).sort((a, b) => a.data.order - b.data.order);
---
<Layout
  title="Partners & Sponsorship | Lobi Stars Football Club"
  description="Meet the official partners of Lobi Stars FC and enquire about sponsorship: kit, stadium advertising, digital and community partnerships."
>
  <div class="page-hero wrap">
    <div class="stag">Partner With Us</div>
    <h1 class="stitle">Partners &amp; <span class="r">Sponsorship</span></h1>
    <div class="divr"></div>
    <p class="muted pt-lede">Join forces with one of Nigeria's most iconic football clubs. From jersey branding to digital activations, we offer tailored partnership opportunities that put your brand at the heart of the action.</p>
  </div>

  <div class="page-content wrap">
    <section aria-labelledby="current-partners">
      <h2 class="pt-h2" id="current-partners">Our Official Partners</h2>
      {sponsors.length > 0 ? (
        <ul class="pt-grid">
          {sponsors.map(s => {
            const hasUrl = s.data.url && s.data.url !== '#';
            return (
              <li class="pt-item">
                {hasUrl ? (
                  <a href={s.data.url} target="_blank" rel="noopener"><img src={s.data.logo} alt="" loading="lazy" /><span>{s.data.name}</span></a>
                ) : (
                  <div><img src={s.data.logo} alt="" loading="lazy" /><span>{s.data.name}</span></div>
                )}
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="muted">Partner announcements coming soon.</p>
      )}
    </section>

    <section class="panel pt-form" aria-labelledby="enquiry-title">
      <h2 class="pt-h2" id="enquiry-title">Partnership Enquiry</h2>
      <p class="pt-note">Our commercial team will reach out within 48 hours.</p>
      <EnquiryForm kind="partnership" />
    </section>
  </div>
</Layout>

<style>
  .pt-lede { max-width: 700px; font-size: 17px; line-height: 1.7; }
  .pt-h2 { margin: 0 0 18px; font: 400 32px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; color: var(--white); }
  .pt-grid { list-style: none; margin: 0 0 48px; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 16px; }
  .pt-item a, .pt-item div {
    display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 22px 16px; height: 100%;
    border: 1px solid var(--d4); border-radius: 12px; background: #fff; text-decoration: none; color: var(--white);
    transition: border-color .2s, box-shadow .2s;
  }
  .pt-item a:hover, .pt-item a:focus-visible { border-color: var(--red); box-shadow: 0 10px 24px rgba(15, 17, 21, .08); }
  .pt-item img { height: 64px; max-width: 100%; object-fit: contain; }
  .pt-item span { font: 700 15px/1.2 'Barlow Condensed', sans-serif; text-align: center; }
  .pt-form { max-width: 780px; }
  .pt-note { margin: -8px 0 22px; color: var(--red-text); font: 700 13px/1.3 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; }
</style>
