---
// Shown by the app (service worker) only when the phone has no connection.
// Self-contained (no other files needed), so it works offline. Never indexed.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="robots" content="noindex, nofollow" />
<meta name="theme-color" content="#E31E24" />
<title>You're offline | Lobi Stars FC</title>
<style is:inline>
  html, body { margin: 0; height: 100%; }
  body { display: flex; align-items: center; justify-content: center; padding: 24px; box-sizing: border-box; background: linear-gradient(160deg, #15181D, #2A0507); color: #fff; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif; text-align: center; }
  main { max-width: 420px; }
  img { display: block; margin: 0 auto; width: 96px; height: 96px; object-fit: contain; }
  h1 { margin: 18px 0 8px; font-size: 28px; letter-spacing: .5px; }
  p { margin: 0 0 22px; line-height: 1.55; color: rgba(255, 255, 255, .85); }
  button { min-height: 48px; padding: 12px 26px; border: 0; border-radius: 10px; background: #E31E24; color: #fff; font: 700 16px/1 inherit; font-family: inherit; cursor: pointer; }
  .ghost { background: transparent; border: 1.5px solid rgba(255, 255, 255, .5); margin-left: 8px; }
  button:hover, button:focus-visible { background: #FFC72C; color: #15181D; outline: none; }
</style>
</head>
<body>
<main>
  <img src="/images/lobi-stars-badge.png" alt="Lobi Stars FC" width="96" height="96" />
  <h1>You're offline</h1>
  <p>There's no internet connection right now. Scores, fixtures, tickets and commentary need a connection, so check your data or Wi-Fi and try again.</p>
  <button type="button" onclick="location.reload()">Try again</button>
  <button type="button" class="ghost" onclick="history.length > 1 ? history.back() : (location.href = '/')">← Go back</button>
</main>
<script is:inline>window.addEventListener('online', function () { location.reload(); });</script>
</body>
</html>
