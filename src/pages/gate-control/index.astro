---
// Gate Control: the matchday ticket stewards' own area (sign-in, gate choice,
// ticket scanner, today's check-ins, activity, staff). Served by
// functions/gate-control/[[path]].js for /gate-control/ and /gate-control/login/
// with strict security headers (camera allowed on this page only). Separate
// from the website admin: its own staff, sign-in and cookie.
import '../../styles/gateControl.css';
import { readFileSync } from 'node:fs';
// The club badge is built into the page (about 10 KB) so it always shows, even when the app opens offline.
// The Lobi Gate Control logo, built into the page (about 20 KB) so it always shows, even offline.
const BADGE = `data:image/png;base64,${readFileSync('public/images/gate-control/logo-96.png').toString('base64')}`;
const I = {
  scan: '<path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2"/><rect x="7" y="7" width="4" height="4"/><rect x="13" y="7" width="4" height="4"/><rect x="7" y="13" width="4" height="4"/><path d="M13 13h1.5v1.5M17 17h-1.5v-1.5M13 17h1"/>',
  today: '<path d="M3 21h18"/><rect x="5" y="11" width="3" height="7"/><rect x="10.5" y="6" width="3" height="12"/><rect x="16" y="9" width="3" height="9"/>',
  activity: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/>',
  staff: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="17.5" cy="9" r="2.5"/><path d="M16.5 14.2A5 5 0 0 1 22 19"/>',
  out: '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5M21 12H9"/>',
  alert: '<path d="M12 3 2 21h20L12 3z"/><path d="M12 10v5M12 18v.5"/>',
  torch: '<path d="M8 2h8l-1 6H9L8 2z"/><path d="M9 8h6v4l-1 10h-4L9 12V8z"/><path d="M12 13v3"/>',
  flip: '<path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/>',
  pin: '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
};
const svg = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="same-origin" />
  <meta name="theme-color" content="#0c0f14" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Lobi Gate Control" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>Lobi Gate Control | Lobi Stars FC</title>
  <link rel="icon" type="image/png" href="/images/gate-control/favicon-32.png" />
  <link rel="apple-touch-icon" href="/images/gate-control/apple-touch-icon.png" />
  <link rel="manifest" href="/gate-control.webmanifest" />
</head>
<body>
  <!-- Sign in -->
  <section class="gc-center" id="signin" hidden>
    <form class="gc-card gc-activate" id="signinForm" novalidate>
      <img class="gc-logo" src="/images/gate-control/logo-640.webp" alt="Lobi Gate Control" width="320" height="320" />
      <h1>Lobi Gate Control</h1>
      <p class="gc-caps">Lobi Stars FC · Ticket scanner</p>
      <p class="gc-err" id="signinErr" role="alert" hidden></p>
      <div class="gc-field">
        <label for="passcode">Scanner passcode</label>
        <input class="gc-input gc-pass" id="passcode" inputmode="numeric" autocomplete="one-time-code" maxlength="9" placeholder="1234-5678" required />
      </div>
      <button class="gc-btn red huge wide" type="submit" id="signinBtn">Switch on this scanner</button>
      <p class="gc-note">Get your passcode from the Lobi Stars FC admin. It works once, on this phone only, and the scanner then stays on until the club switches it off.</p>
    </form>
  </section>

  <!-- Choose the gate -->
  <section class="gc-center" id="gatePick" hidden>
    <div class="gc-card">
      <p class="gc-caps" id="gateHello"></p>
      <h1 style="font-size:40px;margin-top:6px">Which gate are you at?</h1>
      <p class="gc-note" style="margin-top:8px">Your check-ins are recorded at this gate. You can change it at any time.</p>
      <p class="gc-err" id="gateErr" role="alert" hidden></p>
      <div class="gc-gates" id="gateList"></div>
      <button type="button" class="gc-btn ghost wide" id="gateCancel" hidden>Cancel</button>
    </div>
  </section>

  <!-- The app -->
  <div id="app" hidden>
    <header class="gc-top">
      <img src={BADGE} alt="" width="36" height="36" />
      <div class="gc-top-t"><b>Lobi Gate Control</b><small id="who"></small></div>
      <span class="gc-spacer"></span>
      <span class="gc-net" id="netChip" role="status" hidden></span>
      <button type="button" class="gc-chip" id="gateChip" aria-label="Change gate"><Fragment set:html={svg(I.pin)} /><span id="gateName"></span></button>
    </header>

    <div class="gc-msgs" id="msgs" aria-live="assertive"></div>
    <main class="gc-main">
      <!-- Scan -->
      <section id="v-scan" aria-labelledby="scanH">
        <h2 class="gc-sr" id="scanH">Scan tickets</h2>
        <div class="gc-practice-bar" id="practiceBar" hidden>
          <div><b>Practice mode</b> · nothing is checked in or counted. Scan or type a practice ticket:</div>
          <ul id="practiceList"></ul>
          <button type="button" class="gc-btn ghost" id="practiceOff">End practice</button>
        </div>
        <p class="gc-gates-banner" id="gatesBanner" role="status" hidden></p>
        <div class="gc-readybox" id="readyBox" hidden><b>Before the gates open</b><ul id="readyList"></ul></div>
        <div class="gc-mode" role="group" aria-label="What a scan does">
          <button type="button" id="modeAdmit" aria-pressed="true">Check in</button>
          <button type="button" class="look" id="modeLook" aria-pressed="false">Look up only</button>
        </div>
        <div class="gc-capchips" id="capChips" aria-live="polite"></div>
        <div class="gc-tally" aria-live="polite" aria-label="Fans checked in today">
          <button type="button" class="gc-tile me" data-view="today"><b id="cMe">0</b><span>You today</span></button>
          <button type="button" class="gc-tile" data-view="today"><b id="cGate">0</b><span id="cGateL">This gate</span></button>
          <button type="button" class="gc-tile all" data-view="today"><b id="cAll">0</b><span>All gates</span></button>
        </div>
        <div id="result" aria-live="assertive"></div>
        <div id="scanBox">
          <div class="gc-cam" id="cam" hidden>
            <video id="camVideo" playsinline muted autoplay></video>
            <div class="gc-cam-frame" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            <p class="gc-cam-tip">Hold the ticket's QR code inside the square</p>
            <div class="gc-cam-tools">
              <button type="button" class="gc-icon" id="torchBtn" hidden aria-pressed="false" aria-label="Torch"><Fragment set:html={svg(I.torch)} /></button>
              <button type="button" class="gc-icon" id="flipBtn" hidden aria-label="Switch camera"><Fragment set:html={svg(I.flip)} /></button>
            </div>
          </div>
          <p class="gc-scanner" id="scannerHint"><span class="gc-scanner-dot" aria-hidden="true"></span><span id="scannerText"><b>Wireless or USB scanner?</b> Just scan: the result shows here. Keep this page open and in front.</span></p>
          <button type="button" class="gc-btn red huge wide" id="camBtn"><Fragment set:html={svg(I.scan)} /><span id="camLbl">Scan ticket</span></button>
          <p class="gc-err" id="camErr" role="alert" hidden style="margin-top:12px"></p>
          <div class="gc-or">or type the ticket number</div>
          <form id="typeForm" class="gc-type-row" novalidate>
            <label class="gc-sr" for="ticketNo">Ticket number</label>
            <div class="gc-type"><span>LS-TIX-</span><input id="ticketNo" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="200" inputmode="text" placeholder="ABCD2345EFGH" /></div>
            <button class="gc-btn gold" type="submit" style="min-height:62px">Check</button>
          </form>
          <p class="gc-hint">The 12 letters and numbers after LS-TIX- on the ticket. For a season ticket, type the whole number (LS-SZN-…).</p>
          <div class="gc-count"><span id="myRefused"></span><span id="lastAt"></span></div>
          <div class="gc-panel gc-recent" id="recentBox" hidden><p class="gc-caps" style="margin:0 0 4px">My last scans</p><ul class="gc-list" id="recentList"></ul></div>
          <p class="gc-hint" id="offlineInfo"></p>
          <button type="button" class="gc-btn ghost wide gc-practice-btn" id="practiceBtn" aria-pressed="false">Practice mode (training)</button>
        </div>
      </section>

      <!-- Today -->
      <section id="v-today" hidden aria-labelledby="todayH">
        <div class="gc-h"><h2 id="todayH">Today at the gates</h2><span class="gc-caps" id="todayAt"></span></div>
        <div class="gc-panel" id="supBox" hidden>
          <p class="gc-caps" style="margin:0 0 8px">Supervisor: message every steward</p>
          <form id="msgForm" novalidate>
            <p class="gc-err" id="msgErr" hidden></p>
            <div class="gc-field"><label for="msgText">Message</label><input class="gc-input" id="msgText" maxlength="240" placeholder="e.g. Gate C closed: send fans to Main Gate" autocomplete="off" /></div>
            <div class="gc-row2">
              <div class="gc-field"><label for="msgGate">Send to</label><select class="gc-input" id="msgGate"></select></div>
              <div class="gc-field"><label for="msgHours">Show for</label><select class="gc-input" id="msgHours"><option value="0.5">30 minutes</option><option value="1">1 hour</option><option value="3" selected>3 hours</option><option value="8">All day</option></select></div>
            </div>
            <button class="gc-btn gold wide" type="submit">Send message</button>
          </form>
          <ul class="gc-list" id="supMsgs" style="margin-top:10px"></ul>
          <div class="gc-row-btns"><a class="gc-btn ghost" id="reportBtn" href="/api/gate-control/report" download>Download today's report (CSV)</a></div>
        </div>
        <div id="todayBody"><p class="gc-empty">Loading…</p></div>
      </section>

      <!-- Incidents -->
      <section id="v-incidents" hidden aria-labelledby="incH">
        <div class="gc-h"><h2 id="incH">Incidents</h2><span class="gc-caps" id="incCount"></span></div>
        <form class="gc-panel" id="incForm" novalidate>
          <p class="gc-caps" style="margin:0 0 10px">Report an incident at your gate</p>
          <p class="gc-err" id="incErr" hidden></p>
          <div class="gc-field"><label for="incCat">What happened</label><select class="gc-input" id="incCat"></select></div>
          <div class="gc-field"><label for="incText">Details (who, where, what was done)</label><textarea class="gc-input" id="incText" maxlength="1000"></textarea></div>
          <div class="gc-field"><label for="incTicket">Ticket number (if any)</label><input class="gc-input" id="incTicket" maxlength="40" autocomplete="off" autocapitalize="characters" /></div>
          <button type="submit" class="gc-btn red wide">Report</button>
          <p class="gc-hint">Emergency? Call for help first, then report it here. Supervisors see every report straight away.</p>
        </form>
        <div class="gc-panel"><p class="gc-caps" style="margin:0 0 4px" id="incListT">Today's reports</p><ul class="gc-list" id="incList"></ul></div>
      </section>

      <!-- Activity -->
      <section id="v-activity" hidden aria-labelledby="actH">
        <div class="gc-h"><h2 id="actH">Activity</h2><a class="gc-btn ghost" id="actCsv" hidden href="#">Download CSV</a></div>
        <div class="gc-filters">
          <div class="gc-field" style="margin:0"><label for="actDay">Day</label><input class="gc-input" type="date" id="actDay" /></div>
          <div class="gc-field" style="margin:0" id="actStaffWrap" hidden><label for="actStaff">Person</label><select class="gc-input" id="actStaff"><option value="">Everyone</option></select></div>
        </div>
        <div class="gc-panel"><ul class="gc-list" id="actList"></ul></div>
        <div class="gc-pager"><button type="button" class="gc-btn ghost" id="actPrev">Newer</button><span class="gc-caps" id="actPage"></span><button type="button" class="gc-btn ghost" id="actNext">Older</button></div>
      </section>

      <!-- Staff (Super Admins) -->
      <section id="v-staff" hidden aria-labelledby="staffH">
        <div class="gc-h"><h2 id="staffH">Ticket stewards</h2><button type="button" class="gc-btn gold" id="addStaff">Add a steward</button></div>
        <p class="gc-note" style="margin-top:0">Stewards sign in at <b>lobistarsfc.com/gate-control</b> with their Staff ID and password. Gate Supervisors can also re-admit a used ticket (with a reason) and see everyone's activity.</p>
        <div class="gc-staff" id="staffList"></div>
        <div class="gc-panel" style="margin-top:18px">
          <h3 style="font-size:26px;margin-bottom:8px">Gates</h3>
          <p class="gc-note" style="margin:0 0 10px">One gate per line. Stewards choose their gate when they sign in.</p>
          <p class="gc-ok" id="gatesOk" hidden>Gates saved.</p>
          <p class="gc-err" id="gatesErr" hidden></p>
          <textarea class="gc-input" id="gatesText" aria-label="Gates, one per line"></textarea>
          <button type="button" class="gc-btn red" id="gatesSave" style="margin-top:10px">Save gates</button>
        </div>
        <div class="gc-panel">
          <h3 style="font-size:26px;margin-bottom:8px">Which stands each gate is for</h3>
          <p class="gc-note" style="margin:0 0 10px">Tick the stands a gate lets in. A ticket for another stand is shown <b>WRONG GATE</b> with where to send the fan (stewards can still press "Admit here anyway"). A gate with nothing ticked lets in every stand.</p>
          <p class="gc-ok" id="standsOk" hidden>Saved.</p>
          <p class="gc-err" id="standsErr" hidden></p>
          <div id="standsGrid" class="gc-stands"></div>
          <button type="button" class="gc-btn red" id="standsSave" style="margin-top:10px">Save</button>
        </div>
      </section>
    </main>

    <nav class="gc-tabs" aria-label="Gate Control">
      <button type="button" class="gc-tab" data-view="scan" aria-current="page"><Fragment set:html={svg(I.scan)} />Scan</button>
      <button type="button" class="gc-tab" data-view="today"><Fragment set:html={svg(I.today)} />Today</button>
      <button type="button" class="gc-tab" data-view="incidents"><Fragment set:html={svg(I.alert)} />Incidents<span class="gc-badge" id="incBadge" hidden></span></button>
      <button type="button" class="gc-tab" data-view="activity"><Fragment set:html={svg(I.activity)} />Activity</button>
      <button type="button" class="gc-tab" data-view="staff" id="staffTab" hidden><Fragment set:html={svg(I.staff)} />Staff</button>
    </nav>
  </div>

  <dialog class="gc-dlg" id="staffDlg">
    <form id="staffForm" method="dialog" novalidate>
      <h3 id="staffDlgT">Add a steward</h3>
      <p class="gc-err" id="staffErr" hidden></p>
      <div class="gc-row2">
        <div class="gc-field"><label for="sfId">Staff ID</label><input class="gc-input" id="sfId" autocapitalize="characters" placeholder="LSG-001" maxlength="20" /></div>
        <div class="gc-field"><label for="sfRole">Role</label><select class="gc-input" id="sfRole"><option value="steward">Ticket Steward</option><option value="supervisor">Gate Supervisor</option></select></div>
      </div>
      <div class="gc-field"><label for="sfName">Full name</label><input class="gc-input" id="sfName" maxlength="80" autocomplete="off" /></div>
      <div class="gc-field"><label for="sfPw" id="sfPwL">Password (at least 8 characters)</label><input class="gc-input" id="sfPw" type="text" maxlength="72" autocomplete="new-password" /></div>
      <label class="gc-check" id="sfActiveWrap" hidden><input type="checkbox" id="sfActive" /> Can sign in</label>
      <div class="gc-row2" style="margin-top:8px"><button type="button" class="gc-btn ghost" id="sfCancel">Cancel</button><button type="submit" class="gc-btn red" id="sfSave">Save</button></div>
    </form>
  </dialog>

  <dialog class="gc-dlg" id="readmitDlg">
    <form id="readmitForm" method="dialog" novalidate>
      <h3>Let this ticket back in?</h3>
      <p class="gc-note" style="margin-top:0">Only for someone who was checked in and stepped out (for example, to the car or for first aid). Your name and the reason are recorded.</p>
      <p class="gc-err" id="readmitErr" hidden></p>
      <div class="gc-field"><label for="readmitWhy">Reason</label><input class="gc-input" id="readmitWhy" maxlength="200" placeholder="e.g. Went out to the car park, seen leaving by me" /></div>
      <div class="gc-row2"><button type="button" class="gc-btn ghost" id="readmitCancel">Cancel</button><button type="submit" class="gc-btn red">Re-admit</button></div>
    </form>
  </dialog>

  <div class="gc-toast" id="toast" role="status" hidden></div>

  <script>
    import '../../scripts/gateControl/app';
  </script>
</body>
</html>
