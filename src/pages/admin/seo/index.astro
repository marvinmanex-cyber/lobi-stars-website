---
// Admin › SEO Scanner (only the Super Admins). The score with its trend, the
// target keywords on Google, the top 5 opportunities, every issue with its three
// actions (AI Fix / Set up AI to fix this next time / Fix it myself), fixes
// waiting for approval, one page's details, the history of fixes with Google
// figures before and after, alerts, and a printable (PDF) report.
import Layout from '../../../layouts/Layout.astro';
import AdminNav from '../../../components/admin/AdminNav.astro';
---
<Layout title="SEO Scanner | Lobi Stars Admin" description="SEO Scanner: how the website does on Google, and what to fix." noindex>
  <div class="wrap seo">
    <AdminNav current="seo" />
    <header class="seo-head">
      <div><div class="stag">Settings</div><h1 class="stitle">🔎 SEO <span class="r">Scanner</span></h1></div>
      <div class="seo-acts noprint">
        <button type="button" class="btn-p" id="scanNow">Scan now</button>
        <a class="btn-o" href="/admin/seo/settings/">Settings &amp; connections</a>
        <a class="btn-o" href="/admin/seo/learn/">SEO basics</a>
        <button type="button" class="btn-o" id="pdf">Download report (PDF)</button>
      </div>
    </header>
    <p class="seo-msg" id="msg" role="status" aria-live="polite" hidden></p>
    <div class="seo-prog noprint" id="prog" hidden><div class="seo-bar"><span id="bar"></span></div><p id="progText"></p></div>

    <section class="seo-top">
      <div class="seo-score" id="scoreCard"><div class="seo-ring" id="ring"><b id="score">–</b><small>/100</small></div>
        <div><h2 id="scoreTitle">Loading…</h2><p class="muted" id="scoreSub"></p><div id="trend" class="seo-trend" aria-label="Score over the last 90 days"></div></div></div>
      <div class="seo-counts" id="counts"></div>
    </section>
    <div id="setup"></div>
    <div id="alerts"></div>

    <section class="seo-card" id="waitingCard" hidden><h2 id="waiting">Waiting for your approval</h2><div id="waitingList"></div></section>

    <section class="seo-card"><h2>Top 5 opportunities</h2><p class="muted">What would help most right now.</p><div id="top"></div></section>

    <section class="seo-card">
      <div class="seo-row"><h2>Target keywords on Google</h2>
        <label class="noprint">Device <select id="device"><option value="all">All devices</option><option value="mobile">Mobile</option><option value="desktop">Desktop</option></select></label></div>
      <p class="muted" id="rankLabel"></p>
      <div class="seo-scroll"><table id="ranks"><thead><tr><th>Search phrase</th><th>Position</th><th>Change (7 days)</th><th>Last 28 days</th><th>Page Google shows</th><th>Clicks</th></tr></thead><tbody></tbody></table></div>
      <p class="muted noprint"><a href="/admin/seo/settings/#keywords">Edit the keyword list</a></p>
    </section>

    <section class="seo-card">
      <div class="seo-row"><h2>Issues</h2><span class="muted" id="issueCount"></span></div>
      <div class="seo-filters noprint">
        <select id="fCat" aria-label="Category"><option value="">All categories</option></select>
        <select id="fSev" aria-label="Severity"><option value="">All severities</option><option value="critical">Critical</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select>
        <select id="fStatus" aria-label="Status"><option value="open">Open</option><option value="ignored">Ignored</option></select>
        <input id="fText" type="search" placeholder="Search page or problem" aria-label="Search" />
      </div>
      <div id="issues"><p class="muted">Loading…</p></div>
    </section>

    <section class="seo-card" id="pageCard" hidden><div class="seo-row"><h2 id="pageTitle">Page</h2><button type="button" class="btn-o noprint" id="pageClose">Close</button></div><div id="pageBody"></div></section>

    <section class="seo-card"><h2>History</h2><p class="muted">Every fix, who or what made it, and Google's figures for the page in the 28 days before and after (the "after" appears 30 days after the fix).</p><div id="history"></div></section>

    <section class="seo-card"><h2>AI use</h2><p class="muted" id="usage"></p></section>
  </div>
</Layout>

<style>
  .seo { --blue: #1C3F7A; --red: #C8102E; }
  .seo-head { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; align-items: flex-end; margin-bottom: 14px; }
  .seo-acts { display: flex; flex-wrap: wrap; gap: 8px; } .seo-acts a { text-decoration: none; }
  .seo-msg { padding: 10px 14px; border-radius: 10px; background: #DCFCE7; color: #166534; margin: 0 0 12px; } .seo-msg.err { background: #FEE2E2; color: #991B1B; }
  .seo-prog { margin: 0 0 14px; } .seo-bar { height: 10px; border-radius: 999px; background: var(--a-line); overflow: hidden; }
  .seo-bar span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--blue), var(--red)); transition: width .3s; } .seo-prog p { margin: 6px 0 0; font-size: 13px; color: var(--a-muted); }
  .seo-top { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 12px; margin-bottom: 14px; }
  .seo-score { display: flex; gap: 18px; align-items: center; padding: 18px; border-radius: 18px; background: var(--a-card); border: 2px solid var(--blue); }
  .seo-ring { width: 104px; height: 104px; border-radius: 50%; flex: none; display: grid; place-content: center; text-align: center; background: conic-gradient(var(--sc, var(--blue)) calc(var(--p, 0) * 1%), var(--a-line) 0); position: relative; }
  .seo-ring::before { content: ''; position: absolute; inset: 10px; border-radius: 50%; background: var(--a-card); }
  .seo-ring b, .seo-ring small { position: relative; } .seo-ring b { font: 800 34px/1 'Barlow Condensed', 'Barlow', sans-serif; color: var(--sc, var(--blue)); } .seo-ring small { color: var(--a-muted); font-size: 12px; }
  .seo-score h2 { margin: 0; font: 800 22px 'Barlow Condensed', 'Barlow', sans-serif; color: var(--blue); }
  :global(body.admin-dark) .seo-score h2 { color: #93C5FD; }
  .seo-trend { margin-top: 6px; } .seo-trend :global(svg) { width: 100%; max-width: 360px; height: 46px; }
  .seo-counts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .seo :global(.seo-count) { border-radius: 14px; padding: 10px 12px; background: var(--a-card); border: 1px solid var(--a-line); border-left: 6px solid var(--c); cursor: pointer; text-align: left; font: inherit; color: inherit; }
  .seo :global(.seo-count b) { display: block; font: 800 24px 'Barlow Condensed', sans-serif; } .seo :global(.seo-count small) { color: var(--a-muted); }
  .seo-card { background: var(--a-card); border: 1px solid var(--a-line); border-radius: 16px; padding: 18px 20px; margin-bottom: 16px; }
  .seo-card h2 { margin: 0 0 6px; font: 700 18px 'Barlow', sans-serif; color: var(--blue); } :global(body.admin-dark) .seo-card h2 { color: #93C5FD; }
  .seo-row { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; align-items: center; }
  .seo :global(.muted) { color: var(--a-muted); font-size: 14px; margin: 0 0 8px; }
  .seo { min-width: 0; } .seo-card { min-width: 0; } .seo-scroll { overflow-x: auto; max-width: calc(100vw - 32px); } .seo :global(table) { width: 100%; border-collapse: collapse; }
  .seo :global(th), .seo :global(td) { padding: 8px 10px; text-align: left; font-size: 13px; border-bottom: 1px solid var(--a-line); vertical-align: top; }
  .seo :global(th) { color: var(--a-muted); font-weight: 700; }
  .seo :global(.up) { color: #15803D; font-weight: 700; } .seo :global(.down) { color: var(--red); font-weight: 700; }
  .seo-filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 12px; } .seo-filters select, .seo-filters input { font: inherit; font-size: 14px; padding: 7px 10px; border-radius: 8px; border: 1px solid var(--a-line); background: var(--a-card); color: inherit; }
  .seo-filters input { flex: 1 1 200px; }
  .seo :global(.seo-item) { border: 1px solid var(--a-line); border-left: 6px solid var(--c); border-radius: 12px; padding: 12px 14px; margin: 10px 0; }
  .seo :global(.seo-item h3) { margin: 0 0 4px; font-size: 15px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .seo :global(.badge) { padding: 2px 9px; border-radius: 999px; font-size: 12px; font-weight: 800; color: #fff; background: var(--c); }
  .seo :global(.chip) { padding: 2px 8px; border-radius: 999px; font-size: 12px; background: var(--a-line); }
  .seo :global(.seo-item p) { margin: 4px 0; font-size: 14px; line-height: 1.5; }
  .seo :global(.seo-item a.pg) { color: var(--blue); font-weight: 600; } :global(body.admin-dark) .seo :global(.seo-item a.pg) { color: #93C5FD; }
  .seo :global(.three) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 10px 0 4px; }
  .seo :global(.three button) { min-height: 46px; padding: 8px 10px; border-radius: 10px; border: 0; color: #fff; font: inherit; font-weight: 700; font-size: 14px; cursor: pointer; line-height: 1.2; }
  .seo :global(.three .a1) { background: var(--red); } .seo :global(.three .a2) { background: var(--blue); } .seo :global(.three .a3) { background: #475569; }
  .seo :global(.three button:disabled) { opacity: .45; cursor: not-allowed; }
  .seo :global(.small-btns) { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .seo :global(.small-btns button), .seo :global(.panel button) { font: inherit; font-size: 13px; padding: 6px 12px; border-radius: 8px; border: 1px solid var(--a-line); background: var(--a-card); color: inherit; cursor: pointer; min-height: 36px; }
  .seo :global(.panel) { margin-top: 10px; padding: 12px 14px; border-radius: 12px; background: #EFF6FF; border: 1px solid #BFDBFE; color: #1E3A8A; }
  :global(body.admin-dark) .seo :global(.panel) { background: #172554; border-color: #1E40AF; color: #DBEAFE; }
  .seo :global(.panel h4) { margin: 0 0 6px; font-size: 15px; } .seo :global(.panel ol) { margin: 6px 0; padding-left: 22px; } .seo :global(.panel li) { margin: 4px 0; line-height: 1.45; }
  .seo :global(.panel pre) { white-space: pre-wrap; word-break: break-word; background: rgba(255,255,255,.7); color: #0f172a; padding: 10px; border-radius: 8px; font-size: 12.5px; max-height: 340px; overflow: auto; }
  .seo :global(.ba) { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 8px 0; }
  .seo :global(.ba > div) { background: rgba(255,255,255,.75); color: #0f172a; border-radius: 8px; padding: 8px 10px; font-size: 13px; word-break: break-word; }
  .seo :global(.ba b) { display: block; font-size: 12px; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 4px; } .seo :global(.ba .bef b) { color: #991B1B; } .seo :global(.ba .aft b) { color: #166534; }
  .seo :global(.panel label) { display: block; font-size: 13px; font-weight: 700; margin: 8px 0 3px; }
  .seo :global(.panel input), .seo :global(.panel textarea) { width: 100%; box-sizing: border-box; font: inherit; font-size: 14px; padding: 7px 9px; border-radius: 8px; border: 1px solid #93C5FD; background: #fff; color: #0f172a; }
  .seo :global(.panel textarea) { min-height: 150px; font-family: ui-monospace, monospace; font-size: 12.5px; }
  .seo :global(.panel .go) { background: #15803D; border-color: #15803D; color: #fff; font-weight: 700; }
  .seo :global(.panel .warn) { color: #92400E; font-size: 13px; }
  .seo :global(.spark) { width: 110px; height: 28px; }
  .seo :global(.alert) { padding: 10px 14px; border-radius: 12px; background: #FEE2E2; color: #991B1B; margin-bottom: 8px; font-size: 14px; }
  .seo :global(.setup) { padding: 12px 14px; border-radius: 12px; background: #FEF3C7; color: #78350F; margin-bottom: 12px; font-size: 14px; } .seo :global(.setup a) { color: inherit; font-weight: 700; }
  @media (max-width: 760px) { .seo-top { grid-template-columns: 1fr; } .seo :global(.three) { grid-template-columns: 1fr; } .seo :global(.ba) { grid-template-columns: 1fr; } .seo-score { flex-direction: column; align-items: flex-start; } }
  @media print {
    :global(nav), :global(header.site-header), :global(.admin-nav), :global(aside), .noprint, .seo :global(.three), .seo :global(.small-btns), .seo :global(.panel) { display: none !important; }
    .seo-card, .seo :global(.seo-item) { break-inside: avoid; }
  }
</style>

<script is:inline>
(function () {
  const code = sessionStorage.getItem('ls_admin_code') || '__session__';
  const H = { 'x-admin-code': code, 'Content-Type': 'application/json' };
  const $ = id => document.getElementById(id);
  const el = (t, p = {}, ...k) => { const n = document.createElement(t); for (const [a, v] of Object.entries(p)) { if (v == null) continue; if (a === 'class') n.className = v; else if (a === 'text') n.textContent = v; else if (a === 'html') n.innerHTML = v; else if (a === 'style') n.setAttribute('style', v); else if (a.startsWith('on')) n.addEventListener(a.slice(2), v); else n.setAttribute(a, v); } k.flat().forEach(x => x != null && x !== false && n.append(x)); return n; };
  const SEV = { critical: '#7F1D1D', high: '#C8102E', medium: '#D97706', low: '#64748B' };
  const SEVL = { critical: 'Critical', high: 'High', medium: 'Medium', low: 'Low' };
  const when = s => s ? new Date(s).toLocaleString('en-GB', { timeZone: 'Africa/Lagos', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '–';
  let D = null, scanning = false;
  function msg(t, ok = true) { $('msg').textContent = t; $('msg').className = 'seo-msg' + (ok ? '' : ' err'); $('msg').hidden = false; $('msg').scrollIntoView({ block: 'nearest' }); }
  async function api(body, q = '') {
    const r = await fetch('/api/admin/seo' + q, body ? { method: 'POST', headers: H, body: JSON.stringify(body) } : { headers: H, cache: 'no-store' });
    if (r.status === 401) { location.href = '/admin/login/?next=/admin/seo/'; throw new Error('Please sign in'); }
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || (r.status >= 500 ? 'The website took too long to answer. Please try again.' : 'Request failed'));
    return d;
  }
  const copy = async t => { try { await navigator.clipboard.writeText(t); msg('Copied.'); } catch { msg('Could not copy: select the text and copy it yourself.', false); } };
  // Sparkline: lower position is better, so the line is drawn upside down (up = better).
  function spark(vals, { invert = true, w = 110, h = 28, max = null, color = '#1C3F7A' } = {}) {
    const v = vals.filter(x => x != null);
    if (v.length < 2) return el('span', { class: 'muted', text: v.length ? '' : '–' });
    const lo = Math.min(...v), hi = max ?? Math.max(...v), span = Math.max(1, hi - lo);
    const pts = v.map((x, i) => `${(i / (v.length - 1)) * (w - 4) + 2},${invert ? 2 + ((x - lo) / span) * (h - 4) : h - 2 - ((x - lo) / span) * (h - 4)}`).join(' ');
    const s = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    s.setAttribute('viewBox', `0 0 ${w} ${h}`); s.setAttribute('class', 'spark'); s.setAttribute('role', 'img'); s.setAttribute('aria-label', `From ${v[0]} to ${v[v.length - 1]}`);
    s.innerHTML = `<polyline fill="none" stroke="${color}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" points="${pts}"/>`;
    return s;
  }

  async function load() {
    try { D = await api(); } catch (e) { msg(e.message, false); return; }
    render();
    if (D.running && !scanning) follow(D.running.id);
  }
  function render() {
    const s = D.score;
    const sc = s == null ? '#64748B' : s >= 80 ? '#15803D' : s >= 60 ? '#D97706' : '#C8102E';
    $('ring').style.setProperty('--p', s ?? 0); $('ring').style.setProperty('--sc', sc); $('score').textContent = s ?? '–';
    $('scoreTitle').textContent = s == null ? 'No scan yet' : s >= 80 ? 'Good shape on Google' : s >= 60 ? 'Some things to improve' : 'Needs attention';
    $('scoreSub').textContent = (D.change != null ? `${D.change > 0 ? '▲ +' : D.change < 0 ? '▼ ' : '± '}${D.change} since last week · ` : '') + (D.lastScan ? `Last scan ${when(D.lastScan.finishedAt)}${D.lastScan.kind === 'quick' ? ` (quick check of ${(D.lastScan.summary?.paths || []).length || 1} page${(D.lastScan.summary?.paths || []).length > 1 ? 's' : ''})` : ` (${D.lastScan.pages || D.lastScan.pagesTotal} pages)`}` : 'Press "Scan now" for the first scan.') + ` · ${D.newThisWeek} new issues this week, ${D.fixedIssues} fixed`;
    $('trend').replaceChildren(D.trend.length > 1 ? spark(D.trend.map(t => t.score), { invert: false, w: 360, h: 46, color: sc }) : el('span'));
    $('counts').replaceChildren(...['critical', 'high', 'medium', 'low'].map(k => el('button', { type: 'button', class: 'seo-count', style: `--c:${SEV[k]}`, onclick: () => { $('fSev').value = k; $('fStatus').value = 'open'; issues(); $('issues').scrollIntoView({ behavior: 'smooth' }); } }, el('b', { text: D.counts[k] }), el('small', { text: SEVL[k] }))));
    // What is not connected yet.
    const c = D.connections, miss = [];
    if (!c.gsc.connected) miss.push('Google Search Console');
    if (!c.pagespeed.connected) miss.push('the PageSpeed key (optional)');
    if (!c.ai.connected) miss.push('Claude (AI)');
    if (!c.github.connected) miss.push('GitHub (needed to apply fixes)');
    $('setup').replaceChildren(...(miss.length ? [el('div', { class: 'setup' }, `Not connected yet: ${miss.join(', ')}. `, el('a', { href: '/admin/seo/settings/', text: 'Set up connections' }))] : []));
    const today = new Date(Date.now() + 3600e3).toISOString().slice(0, 10);
    $('alerts').replaceChildren(...D.alerts.filter(a => a.day >= new Date(Date.now() - 2 * 864e5).toISOString().slice(0, 10)).map(a => el('div', { class: 'alert' }, el('b', { text: `${a.day === today ? 'Today' : a.day}: ` }), a.message)));
    $('waitingCard').hidden = !D.waiting.length;
    $('waitingList').replaceChildren(...D.waiting.map(f => { const box = el('div'); showFix(box, f); return el('div', { class: 'seo-item', style: '--c:#1C3F7A' }, el('h3', {}, f.name, f.auto ? el('span', { class: 'chip', text: 'Prepared by an automation rule' }) : null), el('p', { text: f.path || 'Whole website' }), box); }));
    $('top').replaceChildren(...(D.top.length ? D.top.map((i, n) => el('div', { class: 'seo-item', style: `--c:${SEV[i.severity]}` }, el('h3', {}, `${n + 1}. ${i.name}`, el('span', { class: 'badge', text: i.severityLabel })), el('p', { text: i.problem }), el('p', { class: 'muted', text: i.why }), threeButtons(i))) : [el('p', { class: 'muted', text: 'Nothing urgent: well done.' })]));
    ranks(D.ranks);
    const cat = $('fCat');
    if (cat.options.length === 1) for (const k of D.categories) cat.append(el('option', { value: k.key, text: `${k.icon} ${k.label}` }));
    issues();
    history();
    const u = D.usage;
    $('usage').textContent = `Today $${u.today.toFixed(3)} of the $${u.dailyLimit} daily limit (${u.todayCalls} calls); this month $${u.month.toFixed(3)} of $${u.monthlyLimit}. The site-wide monthly AI budget (AI Settings) also applies. Structured data, redirects, links, robots.txt and VS Code instructions cost nothing.`;
  }
  function ranks(r) {
    $('rankLabel').textContent = r.label + '.';
    const tb = $('ranks').querySelector('tbody');
    tb.replaceChildren(...r.rows.map(k => el('tr', {},
      el('td', {}, k.keyword, k.confirmed ? null : el('span', { class: 'chip', text: ' suggested', title: 'Not confirmed yet (Settings › Keywords)' })),
      el('td', { text: k.position == null ? 'Not seen yet' : k.position }),
      el('td', { class: k.change > 0 ? 'up' : k.change < 0 ? 'down' : '', text: k.change == null ? '' : k.change > 0 ? `▲ ${k.change}` : k.change < 0 ? `▼ ${-k.change}` : '–' }),
      el('td', {}, spark(k.spark)),
      el('td', {}, k.page ? el('a', { href: '#', class: 'pg', onclick: e => { e.preventDefault(); openPage(k.page); }, text: k.page }) : '', k.target && k.page && k.page !== k.target ? el('div', { class: 'down', text: `meant: ${k.target}` }) : null),
      el('td', { text: k.clicks }))));
    if (!r.rows.length) tb.append(el('tr', {}, el('td', { colspan: 6, text: 'No keywords yet.' })));
  }
  $('device').addEventListener('change', async () => { try { ranks(await api(null, `?view=ranks&device=${$('device').value}`)); } catch (e) { msg(e.message, false); } });

  function threeButtons(i) {
    const box = el('div');
    const a = i.actions;
    const wrap = el('div', {},
      el('div', { class: 'three' },
        el('button', { type: 'button', class: 'a1', disabled: a.ai ? null : '', title: a.ai ? '' : 'No AI Fix for this kind of issue', onclick: () => aiFix(i, box) }, a.code ? '🤖 AI Fix (VS Code instruction)' : '🤖 AI Fix'),
        el('button', { type: 'button', class: 'a2', disabled: a.automate ? null : '', title: a.automate ? '' : 'This kind of issue needs a person or code', onclick: () => { location.href = `/admin/seo/settings/?rule=${encodeURIComponent(i.type)}#rules`; } }, '⚙️ Set up AI to fix this next time'),
        el('button', { type: 'button', class: 'a3', onclick: () => myself(i, box) }, '🛠️ Fix it myself')),
      el('div', { class: 'small-btns' },
        i.path ? el('button', { type: 'button', onclick: () => checkAgain([i.path]) }, '🔁 Check again') : null,
        i.path ? el('button', { type: 'button', onclick: () => openPage(i.path) }, '📄 Page details') : null,
        i.status === 'ignored' ? el('button', { type: 'button', onclick: () => unignore(i) }, 'Stop ignoring') : el('button', { type: 'button', onclick: () => ignore(i) }, 'Mark as ignored')),
      box);
    return wrap;
  }
  function issueItem(i) {
    const fx = i.fix;
    return el('div', { class: 'seo-item', style: `--c:${SEV[i.severity]}` },
      el('h3', {}, i.name, el('span', { class: 'badge', text: i.severityLabel }), el('span', { class: 'chip', text: (D.categories.find(c => c.key === i.category) || {}).label || i.category }),
        fx?.status === 'applied' ? el('span', { class: 'chip', text: `Fix applied ${when(fx.applied_at)}: checking after the rebuild` }) : fx?.status === 'proposed' ? el('span', { class: 'chip', text: 'Fix waiting for approval' }) : null),
      el('p', {}, i.path ? el('a', { href: '#', class: 'pg', onclick: e => { e.preventDefault(); openPage(i.path); }, text: i.path }) : el('b', { text: 'Whole website' }), ' · ', i.problem),
      el('p', { class: 'muted', text: `Why it matters: ${i.why}` }),
      i.status === 'ignored' ? el('p', { class: 'muted', text: `Ignored by ${i.ignoredBy}: ${i.ignoredReason}` }) : null,
      threeButtons(i));
  }
  function issues() {
    const cat = $('fCat').value, sev = $('fSev').value, st = $('fStatus').value, q = $('fText').value.trim().toLowerCase();
    const list = (st === 'ignored' ? D.ignored : D.issues).filter(i => (!cat || i.category === cat) && (!sev || i.severity === sev) && (!q || `${i.path} ${i.problem} ${i.name}`.toLowerCase().includes(q)));
    $('issueCount').textContent = `${list.length} shown`;
    const shown = list.slice(0, 80);
    $('issues').replaceChildren(...(shown.length ? shown.map(issueItem) : [el('p', { class: 'muted', text: st === 'ignored' ? 'Nothing ignored.' : 'No issues here.' })]), list.length > 80 ? el('p', { class: 'muted', text: `${list.length - 80} more: use the filters to narrow the list.` }) : null);
  }
  ['fCat', 'fSev', 'fStatus'].forEach(id => $(id).addEventListener('change', issues));
  $('fText').addEventListener('input', issues);

  // ── AI Fix: preview, edit, approve, cancel ──
  async function aiFix(i, box) {
    box.replaceChildren(el('div', { class: 'panel', text: 'Preparing… (nothing changes until you approve)' }));
    try { const r = await api({ action: 'prepare', issueId: i.id }); showFix(box, r.fix, i); }
    catch (e) { box.replaceChildren(el('div', { class: 'panel' }, el('p', { text: e.message }))); }
  }
  function showFix(box, f, issue) {
    const p = f.proposal || {};
    const kids = [el('h4', { text: p.kind === 'vscode' ? 'VS Code instruction' : p.kind === 'draft' || p.kind === 'ideas' ? 'Suggestion (nothing is changed)' : 'Preview: before and after' }), el('p', { text: p.summary || '' })];
    const fields = {};
    if (p.kind === 'vscode' || p.vscode) {
      const t = p.vscode;
      kids.push(el('pre', { text: t }), el('button', { type: 'button', onclick: () => copy(t) }, '📋 Copy'), el('button', { type: 'button', onclick: () => developer(issue?.id || f.issue_id) }, '✉️ Send to developer'));
    }
    if (p.kind === 'draft' || p.kind === 'ideas') kids.push(el('pre', { text: p.draft }), el('button', { type: 'button', onclick: () => copy(p.draft) }, '📋 Copy'));
    if (p.kind === 'seo_meta') {
      kids.push(el('div', { class: 'ba' }, el('div', { class: 'bef' }, el('b', { text: 'Now' }), el('div', { text: p.preview.before.title || '(no title)' }), el('small', { text: p.preview.before.description || '(no description)' })),
        el('div', { class: 'aft' }, el('b', { text: 'After' }), el('div', { text: p.preview.after.title }), el('small', { text: p.preview.after.description }))));
      for (const k of p.editable || []) { fields[k] = el('input', { value: p.preview.after[k] || '', maxlength: k === 'title' ? 70 : 170 }); const n = el('small', { class: 'warn' }); const upd = () => { n.textContent = `${fields[k].value.length} characters (aim ${k === 'title' ? '30–60' : '70–160'})`; }; fields[k].addEventListener('input', upd); upd(); kids.push(el('label', { text: k === 'title' ? 'Title (edit if you like)' : 'Description (edit if you like)' }), fields[k], n); }
    } else if (p.kind === 'alt') {
      (p.rows || []).forEach((r, n) => { fields[`alt${n + 1}`] = el('input', { value: r.alt, maxlength: 125 }); kids.push(el('label', { text: r.src }), el('img', { src: r.src, alt: '', style: 'max-width:160px;max-height:100px;border-radius:6px;display:block;margin:4px 0' }), fields[`alt${n + 1}`]); });
    } else if (p.kind === 'robots') {
      kids.push(el('div', { class: 'ba' }, el('div', { class: 'bef' }, el('b', { text: 'Now' }), el('pre', { text: p.preview.before || '(empty)' })), el('div', { class: 'aft' }, el('b', { text: 'After' }), el('pre', { text: p.preview.after }))));
      fields.text = el('textarea', {}); fields.text.value = p.preview.after; kids.push(el('label', { text: 'robots.txt (edit if you like)' }), fields.text);
    } else if (p.kind === 'redirect') {
      kids.push(el('div', { class: 'ba' }, el('div', { class: 'bef' }, el('b', { text: 'Now' }), el('div', { text: p.preview.before })), el('div', { class: 'aft' }, el('b', { text: 'After' }), el('div', { text: p.preview.after }))));
      fields.to = el('input', { value: p.changes[0].item.to }); kids.push(el('label', { text: 'Send visitors to (edit if you like)' }), fields.to);
    } else if (p.preview && !['vscode', 'draft', 'ideas'].includes(p.kind)) {
      const show = v => Array.isArray(v) ? v.join('\n') : typeof v === 'string' ? v : JSON.stringify(v, null, 2);
      kids.push(el('div', { class: 'ba' }, el('div', { class: 'bef' }, el('b', { text: 'Now' }), el('pre', { text: show(p.preview.before) })), el('div', { class: 'aft' }, el('b', { text: 'After' }), el('pre', { text: show(p.preview.after) }))));
    }
    for (const w of p.warnings || []) kids.push(el('p', { class: 'warn', text: `⚠️ ${w}` }));
    if (p.note) kids.push(el('p', { class: 'warn', text: p.note }));
    if (f.status === 'proposed') {
      kids.push(el('div', {}, el('button', { type: 'button', class: 'go', onclick: async e => {
        e.target.disabled = true;
        const edited = {}; for (const [k, inp] of Object.entries(fields)) edited[k] = inp.value;
        try { const r = await api({ action: 'apply', fixId: f.id, edited }); msg(r.message || 'Applied.'); box.replaceChildren(el('div', { class: 'panel', text: `✅ ${r.message}` })); setTimeout(load, 1200); }
        catch (err) { e.target.disabled = false; msg(err.message, false); }
      } }, '✅ Approve'), el('button', { type: 'button', onclick: async () => { try { await api({ action: 'cancel', fixId: f.id }); box.replaceChildren(); msg('Cancelled: nothing was changed.'); load(); } catch (err) { msg(err.message, false); } } }, 'Cancel')));
      if (p.cost) kids.push(el('small', { class: 'muted', text: `AI cost about $${Number(p.cost).toFixed(4)}` }));
    }
    box.replaceChildren(el('div', { class: 'panel' }, ...kids));
  }
  async function myself(i, box) {
    box.replaceChildren(el('div', { class: 'panel', text: 'Loading…' }));
    try {
      const r = await api(null, `?view=issue&id=${encodeURIComponent(i.id)}`);
      const g = r.guide;
      const kids = [el('h4', { text: `How to fix it yourself (usually: ${g.who})` }), el('ol', {}, ...g.steps.map(s => el('li', { text: s })))];
      if (g.admin) kids.push(el('p', {}, 'Where: ', el('a', { href: g.admin.href, text: g.admin.label })));
      if (g.help) kids.push(el('p', {}, 'Google’s help: ', el('a', { href: g.help, target: '_blank', rel: 'noopener', text: g.help })));
      if (r.vscode) kids.push(el('h4', { text: 'For the developer (VS Code)' }), el('pre', { text: r.vscode }), el('button', { type: 'button', onclick: () => copy(r.vscode) }, '📋 Copy'), el('button', { type: 'button', onclick: () => developer(i.id) }, '✉️ Send to developer'));
      if (i.path) kids.push(el('button', { type: 'button', onclick: () => checkAgain([i.path]) }, '🔁 Check again'));
      box.replaceChildren(el('div', { class: 'panel' }, ...kids));
    } catch (e) { box.replaceChildren(el('div', { class: 'panel', text: e.message })); }
  }
  async function developer(id) { try { msg((await api({ action: 'developer', issueId: id })).message); } catch (e) { msg(e.message, false); } }
  async function ignore(i) {
    const reason = prompt('Why should this be ignored? (Everyone sees the reason.)');
    if (reason == null) return;
    try { await api({ action: 'ignore', issueId: i.id, reason }); msg('Ignored. It stays in the "Ignored" list and no longer counts in the score.'); load(); } catch (e) { msg(e.message, false); }
  }
  async function unignore(i) { try { await api({ action: 'unignore', issueId: i.id }); load(); } catch (e) { msg(e.message, false); } }

  // ── Scans ──
  async function follow(id) {
    scanning = true; $('prog').hidden = false; $('scanNow').disabled = true;
    try {
      for (let n = 0; n < 2000; n++) {
        const r = await api({ action: 'step', id });
        const s = r.scan;
        $('bar').style.width = `${s.steps ? Math.round((s.step / s.steps) * 100) : 0}%`;
        $('progText').textContent = s.done ? 'Done.' : `${s.current}${s.pagesTotal ? ` (${s.pagesDone}/${s.pagesTotal} pages)` : ''}…`;
        if (s.done) { msg(`Scan finished: score ${s.score}/100, ${s.summary?.new ?? 0} new issues.${s.summary?.errors?.length ? ` Some checks could not run: ${s.summary.errors.slice(0, 3).join(' · ')}` : ''}`, !s.summary?.errors?.length); break; }
        if (r.busy) await new Promise(res => setTimeout(res, 1500));
      }
    } catch (e) { msg(`${e.message} The scan carries on in the background.`, false); }
    scanning = false; $('prog').hidden = true; $('scanNow').disabled = false; load();
  }
  async function checkAgain(paths) {
    try { const r = await api({ action: 'scan', kind: 'quick', paths }); msg(r.already ? 'A scan is already running: following it.' : `Checking ${paths.join(', ')} again…`); follow(r.scan.id); } catch (e) { msg(e.message, false); }
  }
  $('scanNow').addEventListener('click', async () => {
    try { const r = await api({ action: 'scan', kind: 'full' }); msg(r.already ? 'A scan is already running: following it.' : 'Full scan started. It reads every page politely (2 a second), so it takes a few minutes; you can leave this page, it carries on.'); follow(r.scan.id); } catch (e) { msg(e.message, false); }
  });

  // ── One page ──
  async function openPage(path) {
    $('pageCard').hidden = false; $('pageTitle').textContent = path; $('pageBody').replaceChildren(el('p', { class: 'muted', text: 'Loading…' }));
    $('pageCard').scrollIntoView({ behavior: 'smooth' });
    try {
      const r = await api(null, `?view=page&path=${encodeURIComponent(path)}`);
      const d = r.page?.data;
      const rows = d ? [['Status', r.page.status], ['Last scanned', when(r.page.scannedAt)], ['In sitemap', r.page.inSitemap ? 'Yes' : 'No'], ['Title', `${d.title || '(none)'} (${d.titleLen || 0} characters)`], ['Description', `${d.desc || '(none)'} (${(d.desc || '').length} characters)`],
        ['Main heading', (d.h1 || []).join(' / ') || '(none)'], ['Words', d.wordCount], ['Pictures', `${(d.images || []).length} (${(d.images || []).filter(x => x.alt === null).length} without alt text)`], ['Structured data', (d.schema || []).join(', ') || '(none)'], ['Canonical', d.canonical || '(none)'], ['Noindex', d.noindex ? 'Yes' : 'No'], ['Links to other pages', (d.links || []).length]] : [];
      if (r.google) rows.push(['Google (28 days)', `${r.google.clicks} clicks, ${r.google.impressions} times seen, ${(r.google.ctr * 100).toFixed(1)}% clicked, average position ${r.google.position.toFixed(1)}`]);
      for (const s of r.speed.slice(0, 2)) rows.push([`Speed (${s.strategy}, ${s.date})`, `${s.score}/100 · LCP ${Number(s.lcp).toFixed(1)} s · CLS ${s.cls ?? '–'}${s.inp ? ` · INP ${Math.round(s.inp)} ms` : ''}`]);
      $('pageBody').replaceChildren(
        el('p', {}, el('a', { href: path, target: '_blank', rel: 'noopener', text: 'Open the page ↗' }), ' · ', el('a', { href: '#', onclick: e => { e.preventDefault(); checkAgain([path]); }, text: 'Check again' })),
        rows.length ? el('table', {}, el('tbody', {}, ...rows.map(([k, v]) => el('tr', {}, el('th', { text: k }), el('td', { text: String(v) }))))) : el('p', { class: 'muted', text: 'Not scanned yet.' }),
        r.ranks.length ? el('p', { text: `Keywords: ${r.ranks.map(k => `"${k.keyword}" ${k.position ?? '–'}`).join(', ')}` }) : null,
        el('h4', { text: `${r.issues.length} issue${r.issues.length === 1 ? '' : 's'} on this page` }), ...r.issues.map(issueItem));
    } catch (e) { $('pageBody').replaceChildren(el('p', { text: e.message })); }
  }
  $('pageClose').addEventListener('click', () => { $('pageCard').hidden = true; });

  // ── History ──
  async function history() {
    try {
      const r = await api(null, '?view=history');
      const fig = m => m ? `${m.clicks} clicks · ${m.impressions} seen${m.position ? ` · pos. ${m.position}` : ''}` : '–';
      $('history').replaceChildren(r.fixes.length ? el('div', { class: 'seo-scroll' }, el('table', {}, el('thead', {}, el('tr', {}, ...['When', 'Fix', 'Page', 'By', 'Status', 'Google before', 'Google after', ''].map(t => el('th', { text: t })))),
        el('tbody', {}, ...r.fixes.map(f => el('tr', {}, el('td', { text: when(f.appliedAt || f.createdAt) }), el('td', { text: f.name }), el('td', { text: f.path || 'Whole website' }), el('td', { text: f.auto ? 'Automatic rule' : f.by }),
          el('td', { text: { applied: 'Applied', undone: `Undone ${when(f.undoneAt)}`, failed: `Failed: ${f.note || ''}`, cancelled: 'Cancelled' }[f.status] || f.status }), el('td', { text: fig(f.metrics?.before) }), el('td', { text: fig(f.metrics?.after) }),
          el('td', {}, f.undoable ? el('button', { type: 'button', class: 'btn-o', onclick: async () => { if (!confirm('Undo this fix? The file goes back to how it was before.')) return; try { msg((await api({ action: 'undo', fixId: f.id })).message); load(); } catch (e) { msg(e.message, false); } } }, '↩️ Undo') : null)))))) : el('p', { class: 'muted', text: 'No fixes yet.' }));
    } catch (e) { $('history').replaceChildren(el('p', { text: e.message })); }
  }
  $('pdf').addEventListener('click', async () => { try { await api({ action: 'report' }); } catch {} window.print(); });
  load();
})();
</script>
