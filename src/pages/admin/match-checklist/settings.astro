---
// Matchday › Match Checklist › Reminder settings (Super Admins): when the
// daily reminder email goes out (Lagos time), how many days before / after
// the match, who gets it, a preview of today's email and a test send.
import Layout from '../../../layouts/Layout.astro';
import AdminNav from '../../../components/admin/AdminNav.astro';
import ChecklistTabs from '../../../components/admin/ChecklistTabs.astro';
---
<Layout title="Checklist Reminders | Lobi Stars Admin" description="Daily match checklist reminder emails." noindex>
  <div class="wrap mcs">
    <AdminNav current="match-checklist" />
    <header class="mcs-head">
      <div><div class="stag">Matchday</div><h1 class="stitle">Checklist <span class="r">Reminders</span></h1></div>
      <ChecklistTabs current="settings" />
    </header>
    <p class="mcs-msg" id="msg" role="status" aria-live="polite" hidden></p>
    <p class="mcs-warn" id="warn" hidden>⚠️ Email is not set up on this server (RESEND_API_KEY), so reminders can't be sent yet.</p>
    <div class="mcs-grid">
      <section class="mcs-card" aria-labelledby="setH">
        <h2 id="setH">Daily reminder email</h2>
        <p class="mcs-sub">One email per person per day, listing what is overdue, due today and due in the next 3 days. Nothing is sent on days when nothing is outstanding.</p>
        <form id="form" class="mcs-form">
          <label class="mcs-sw"><span><b>Send reminders</b><small>Switch off to stop all reminder emails</small></span><input type="checkbox" role="switch" name="remindersEnabled" /></label>
          <div class="mcs-2">
            <label>Send at (Lagos time)<input name="reminderSendTime" type="time" required /></label>
            <label>Start reminding (days before kick-off)<input name="reminderDaysBefore" type="number" min="0" max="30" step="1" required /></label>
          </div>
          <label>Keep reminding about after-match tasks for (days after the match)<input name="postMatchReminderDays" type="number" min="0" max="30" step="1" required /></label>
          <label>Who gets it<select name="recipientMode">
            <option value="all_admins">All admins (every staff login except gate and kitchen helpers)</option>
            <option value="owners_plus_super_admins">Only task owners, plus Super Admins</option>
          </select></label>
          <label>Also send to (optional, comma-separated)<input name="extraRecipientEmails" type="text" autocomplete="off" placeholder="coach@example.com, manager@example.com" /></label>
          <div class="mcs-actions"><button type="button" class="btn-o" id="testBtn">Send a test reminder to me</button><button class="btn-p" type="submit">Save settings</button></div>
        </form>
      </section>
      <section class="mcs-card" aria-labelledby="prevH">
        <h2 id="prevH">Today's email (preview)</h2>
        <div id="preview"><p class="muted">Loading…</p></div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .mcs { max-width: 1200px; padding-top: 20px; padding-bottom: 60px; }
  .mcs-head { display: flex; justify-content: space-between; align-items: end; gap: 12px 24px; flex-wrap: wrap; margin-bottom: 16px; }
  .mcs-msg { position: fixed; left: 50%; transform: translateX(-50%); bottom: 18px; z-index: 1500; width: max-content; max-width: calc(100vw - 32px); padding: 12px 16px; border-radius: 12px; margin: 0; box-shadow: 0 14px 34px rgba(0,0,0,.22); font-weight: 600; }
  .mcs-msg.ok { background: #E8F7EE; color: #17643A; } .mcs-msg.err { background: #FDECEC; color: #A3161B; }
  .mcs-warn { margin: 0 0 14px; padding: 12px 16px; border-radius: 12px; background: #FFF7E6; border: 1px solid #F6D58E; color: #7A4B00; }
  .mcs-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 16px; align-items: start; }
  .mcs-card { background: var(--a-card); border: 1px solid var(--a-line); border-radius: 16px; padding: 18px 20px; }
  .mcs-card h2 { margin: 0 0 4px; font: 700 19px/1.2 'Barlow', sans-serif; color: var(--a-ink); }
  .mcs-sub { margin: 0 0 14px; color: var(--a-muted); font-size: 14px; }
  .mcs-form { display: grid; gap: 12px; }
  .mcs-form label { display: grid; gap: 5px; font-size: 13px; font-weight: 700; color: var(--a-muted); }
  .mcs-form input:not([type="checkbox"]), .mcs-form select { min-height: 42px; border: 1px solid var(--a-line); border-radius: 10px; padding: 8px 10px; background: var(--a-card); color: var(--a-ink); font: inherit; font-size: 15px; font-weight: 400; width: 100%; box-sizing: border-box; min-width: 0; }
  .mcs-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .mcs-form .mcs-sw { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 4px 0 8px; border-bottom: 1px solid var(--a-line); cursor: pointer; }
  .mcs-sw b { display: block; font-size: 15px; color: var(--a-ink); } .mcs-sw small { font-weight: 400; }
  .mcs-sw input { appearance: none; width: 46px; height: 26px; border-radius: 999px; background: #CBD2DA; position: relative; flex: none; cursor: pointer; }
  .mcs-sw input::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; transition: transform .15s; }
  .mcs-sw input:checked { background: #16A34A; } .mcs-sw input:checked::after { transform: translateX(20px); }
  .mcs-sw input:focus-visible { outline: 3px solid #FFC72C; outline-offset: 2px; }
  .mcs-actions { display: flex; justify-content: flex-end; gap: 8px; flex-wrap: wrap; }
  .mcs :global(.mcs-p h3) { margin: 12px 0 4px; font-size: 15px; color: var(--a-ink); }
  .mcs :global(.mcs-p ul) { margin: 0 0 6px; padding-left: 18px; font-size: 14px; color: var(--a-muted); }
  .mcs :global(.mcs-p .od) { color: #DC2626; font-weight: 700; }
  @media (max-width: 900px) { .mcs-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .mcs-2 { grid-template-columns: 1fr; } .mcs-actions button { flex: 1 1 100%; } }
</style>

<script is:inline>
(function () {
  const H = { 'Content-Type': 'application/json', 'x-admin-code': sessionStorage.getItem('ls_admin_code') || '__session__' };
  const $ = id => document.getElementById(id);
  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  let msgT;
  function msg(t, ok) { const m = $('msg'); m.textContent = t; m.className = 'mcs-msg ' + (ok ? 'ok' : 'err'); m.hidden = false; clearTimeout(msgT); msgT = setTimeout(() => { m.hidden = true; }, 7000); }
  async function api(method, body) {
    const r = await fetch('/api/admin/match-checklist/settings', method === 'GET' ? { headers: H, cache: 'no-store' } : { method, headers: H, body: JSON.stringify(body) });
    if (r.status === 401) { location.href = '/admin/login/?next=/admin/match-checklist/settings/'; throw new Error('Please sign in again.'); }
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || 'Request failed');
    return d;
  }
  function preview(p) {
    if (!p || p.skipped) return `<p class="muted">${esc(p?.skipped || 'Nothing to send.')}</p>`;
    const list = (label, items, cls) => items.length ? `<h3 class="${cls || ''}">${label} (${items.length})</h3><ul>${items.map(t => `<li>${esc(t)}</li>`).join('')}</ul>` : '';
    return `<div class="mcs-p"><p><b>Subject:</b> ${esc(p.subject)}</p><p class="muted">Goes to ${p.recipients.length} ${p.recipients.length === 1 ? 'person' : 'people'}: ${esc(p.recipients.map(r => r.to).join(', '))}</p>
      ${p.checklists.map(c => `<h3>${esc(c.match)}</h3>${list('<span class="od">Overdue</span>', c.overdue)}${list('Due today', c.today)}${list('Due in the next 3 days', c.soon)}`).join('')}
      ${p.brokenLinks.length ? `<h3>Broken task links (Super Admins only)</h3><ul>${p.brokenLinks.map(b => `<li>${esc(b)}</li>`).join('')}</ul>` : ''}</div>`;
  }
  async function load() {
    try {
      const d = await api('GET'), f = $('form').elements, s = d.settings;
      f.remindersEnabled.checked = s.remindersEnabled; f.reminderSendTime.value = s.reminderSendTime; f.reminderDaysBefore.value = s.reminderDaysBefore;
      f.postMatchReminderDays.value = s.postMatchReminderDays; f.recipientMode.value = s.recipientMode; f.extraRecipientEmails.value = s.extraRecipientEmails;
      $('warn').hidden = d.emailReady;
      $('preview').innerHTML = preview(d.preview) + (s.lastSentDate ? `<p class="muted">Last daily run: ${esc(s.lastSentDate)}</p>` : '');
    } catch (e) { $('preview').textContent = e.message; }
  }
  $('form').addEventListener('submit', async e => {
    e.preventDefault(); const f = e.target.elements;
    try {
      await api('PUT', { remindersEnabled: f.remindersEnabled.checked, reminderSendTime: f.reminderSendTime.value, reminderDaysBefore: Number(f.reminderDaysBefore.value), postMatchReminderDays: Number(f.postMatchReminderDays.value), recipientMode: f.recipientMode.value, extraRecipientEmails: f.extraRecipientEmails.value });
      msg('Settings saved.', true); load();
    } catch (err) { msg(err.message, false); }
  });
  $('testBtn').addEventListener('click', async () => {
    try { const d = await api('POST', { action: 'test' }); msg(`Test reminder sent to ${d.to}.`, true); } catch (err) { msg(err.message, false); }
  });
  load();
})();
</script>
