---
// In-seat food orders (Commerce › In-Seat Food › Orders). Only PAID orders
// (confirmed with Paystack on the server) are prepared; "Awaiting payment"
// orders are shown separately and must not be prepared. Staff move paid
// orders: Start preparing -> Out for delivery -> Delivered. Refreshes every
// 20 seconds.
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
---
<Layout title="In-Seat Food Orders | Lobi Stars Admin" description="In-seat food orders." noindex>
  <div class="wrap fo">
    <AdminNav current="food-orders" />
    <div class="stag">Commerce › In-Seat Food</div>
    <h1 class="stitle">Food <span class="r">Orders</span></h1>
    <p class="muted fo-lede">Prepare only <strong>Paid</strong> orders: their payment has been confirmed with Paystack. <strong>Awaiting payment</strong> orders are not paid yet and expire automatically. This page refreshes itself every 20 seconds.</p>
    <p class="fo-msg" id="msg" role="status" aria-live="polite" hidden></p>

    <section class="fo-stats" id="stats" aria-label="Today"></section>

    <div class="fo-filter" role="group" aria-label="Show">
      <button type="button" data-show="open" aria-pressed="true">To do</button>
      <button type="button" data-show="awaiting" aria-pressed="false">Awaiting payment <span id="awaitN"></span></button>
      <button type="button" data-show="today" aria-pressed="false">Today</button>
      <button type="button" data-show="all" aria-pressed="false">All</button>
      <span class="fo-updated" id="updated"></span>
    </div>
    <div class="fo-list" id="list"><p class="muted">Loading…</p></div>

    <details class="panel fo-settings">
      <summary>Settings</summary>
      <form id="settings" class="fo-set">
        <label for="expiry">Unpaid orders expire after</label>
        <input id="expiry" type="number" min="1" max="120" required /> <span>minutes</span>
        <button class="btn-p" type="submit">Save</button>
      </form>
    </details>
  </div>
</Layout>

<style>
  .fo { max-width: 1200px; padding-top: 28px; padding-bottom: 80px; }
  .fo-lede { max-width: 860px; margin-bottom: 16px; }
  .fo-msg { padding: 12px 16px; border-radius: 8px; margin: 0 0 16px; }
  .fo-msg.ok { background: #E8F7EE; color: #17643A; } .fo-msg.err { background: #FDECEC; color: #A3161B; }
  .fo :global(.fo-stats) { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 12px; margin-bottom: 18px; }
  .fo :global(.fo-stat) { padding: 16px; border-radius: 14px; background: linear-gradient(145deg, color-mix(in srgb, var(--c) 14%, var(--a-card)), var(--a-card) 70%); border: 1px solid color-mix(in srgb, var(--c) 25%, var(--a-line)); }
  .fo :global(.fo-stat b) { display: block; font: 400 34px/1 'Bebas Neue', sans-serif; color: color-mix(in srgb, var(--c) 80%, var(--a-ink)); }
  .fo :global(.fo-stat span) { font: 700 12px/1.3 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: var(--lt); }
  .fo :global(.fo-stat small) { display: block; margin-top: 4px; color: var(--lt); font-size: 13px; }
  .fo-filter { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 14px; }
  .fo-filter button { padding: 8px 16px; border-radius: 999px; border: 1px solid var(--d4); background: var(--a-card); color: var(--a-ink); cursor: pointer; font-weight: 700; }
  .fo-filter button[aria-pressed='true'] { background: #F97316; border-color: #F97316; color: #fff; }
  .fo-updated { margin-left: auto; color: var(--lt); font-size: 13px; }
  .fo :global(.fo-list) { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 14px; }
  .fo :global(.fo-card) { background: var(--a-card); border: 1px solid var(--d4); border-radius: 14px; padding: 16px; display: flex; flex-direction: column; gap: 10px; box-shadow: 0 6px 18px rgba(15,17,21,.05); border-top: 5px solid var(--s); }
  .fo :global(.fo-card.unpaid) { opacity: .7; background: var(--a-soft); }
  .fo :global(.fo-top) { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  .fo :global(.fo-seat) { font: 400 30px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .fo :global(.fo-seat small) { display: block; font: 600 13px 'Barlow', sans-serif; letter-spacing: 0; color: var(--lt); }
  .fo :global(.fo-badge) { padding: 4px 10px; border-radius: 999px; font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: #fff; background: var(--s); white-space: nowrap; }
  .fo :global(.fo-who) { font-weight: 700; }
  .fo :global(.fo-items) { list-style: none; margin: 0; padding: 0; font-size: 15px; }
  .fo :global(.fo-items li) { display: flex; justify-content: space-between; gap: 10px; padding: 3px 0; border-bottom: 1px dashed var(--d4); }
  .fo :global(.fo-note) { margin: 0; padding: 8px 10px; border-radius: 8px; background: #FFF8E1; color: #6B4700; font-size: 14px; }
  .fo :global(.fo-meta) { font-size: 13px; color: var(--lt); line-height: 1.5; }
  .fo :global(.fo-meta a) { color: var(--red-text); font-weight: 700; }
  .fo :global(.fo-age) { font-weight: 700; } .fo :global(.fo-age.warn) { color: #B45309; } .fo :global(.fo-age.late) { color: #B91C1C; }
  .fo :global(.fo-acts) { display: flex; gap: 8px; flex-wrap: wrap; }
  .fo :global(.fo-acts button) { flex: 1 1 auto; min-height: 44px; padding: 8px 12px; border-radius: 10px; border: 1px solid var(--d4); background: var(--a-card); color: var(--a-ink); cursor: pointer; font-weight: 700; }
  .fo :global(.fo-acts .go) { background: var(--g); border-color: var(--g); color: #fff; }
  .fo :global(.fo-empty) { grid-column: 1 / -1; text-align: center; padding: 40px 16px; color: var(--lt); border: 1px dashed var(--d4); border-radius: 14px; background: var(--a-card); }
  .fo :global(.fo-empty b) { display: block; font-size: 34px; margin-bottom: 6px; }
  .fo-settings { margin-top: 26px; padding: 16px 20px !important; }
  .fo-settings summary { cursor: pointer; font-weight: 700; }
  .fo-set { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 12px; }
  .fo-set input { width: 90px; padding: 8px 10px; border-radius: 8px; border: 1px solid var(--d4); font: inherit; }
</style>

<script is:inline>
(function () {
  const code = sessionStorage.getItem('ls_admin_code') || '__session__';
  const $ = id => document.getElementById(id);
  const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const naira = k => '₦' + (Number(k || 0) / 100).toLocaleString('en-NG');
  const time = iso => iso ? new Date(iso).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Lagos' }) : '';
  const day = iso => iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'Africa/Lagos' }) : '';
  const msg = (t, ok) => { $('msg').textContent = t; $('msg').className = 'fo-msg ' + (ok ? 'ok' : 'err'); $('msg').hidden = false; };
  // The next step for each status: [button label, new status, colour].
  const NEXT = { PAID: ['Start preparing', 'PREPARING', '#2563EB'], PREPARING: ['Out for delivery', 'OUT_FOR_DELIVERY', '#7C3AED'], OUT_FOR_DELIVERY: ['Delivered', 'DELIVERED', '#166534'] };
  const BACK = { PREPARING: ['Back to paid', 'PAID'], OUT_FOR_DELIVERY: ['Back to preparing', 'PREPARING'], DELIVERED: ['Not delivered', 'OUT_FOR_DELIVERY'], CANCELLED: ['Mark refunded', 'REFUNDED'] };
  let show = 'open', ST = {};

  async function api(path, opts = {}) {
    const res = await fetch(path, { ...opts, headers: { 'Content-Type': 'application/json', 'x-admin-code': code } });
    const d = await res.json().catch(() => ({}));
    if (res.status === 401) location.href = '/admin/login/?next=/admin/food-orders/';
    if (!res.ok) throw new Error(d.error || 'Request failed');
    return d;
  }
  function card(o) {
    const st = ST[o.status] || { label: o.status, color: '#6B7280' };
    const unpaid = o.status === 'AWAITING_PAYMENT';
    const since = o.paidAt || o.createdAt;
    const mins = Math.max(0, Math.round((Date.now() - new Date(since).getTime()) / 60000));
    const active = ['PAID', 'PREPARING', 'OUT_FOR_DELIVERY'].includes(o.status);
    const age = active ? `<span class="fo-age ${mins >= 20 ? 'late' : mins >= 10 ? 'warn' : ''}">${mins < 1 ? 'paid just now' : `paid ${mins} min ago`}</span> · `
      : unpaid ? `Expires ${esc(time(o.expiresAt))} · ` : '';
    const nx = NEXT[o.status], bk = BACK[o.status];
    const acts = unpaid ? '<p class="fo-meta">Not paid yet: do not prepare.</p>'
      : (nx ? `<button class="go" style="--g:${nx[2]}" data-s="${nx[1]}">${nx[0]}</button>` : '') +
        (bk ? `<button data-s="${bk[1]}">${bk[0]}</button>` : '') +
        (['PAID', 'PREPARING', 'OUT_FOR_DELIVERY'].includes(o.status) ? '<button data-s="CANCELLED">Cancel</button>' : '');
    return `<article class="fo-card${unpaid ? ' unpaid' : ''}" style="--s:${st.color}" data-id="${esc(o.id)}" data-ref="${esc(o.ref)}">` +
      `<div class="fo-top"><div class="fo-seat">Seat ${esc(o.seat)}<small>${esc(o.stand || 'Stand not given')}</small></div><span class="fo-badge">${esc(st.label)}</span></div>` +
      `<div class="fo-who">${esc(o.name || '–')} · ${esc(o.ref)}</div>` +
      `<ul class="fo-items">${o.items.map(i => `<li><span>${esc(i.qty)} × ${esc(i.name)}</span><span>${naira(i.priceKobo * i.qty)}</span></li>`).join('')}</ul>` +
      (o.notes ? `<p class="fo-note">📝 ${esc(o.notes)}</p>` : '') +
      `<p class="fo-meta">${age}${show === 'open' || unpaid ? '' : esc(day(since)) + ' · '}<strong>${naira(o.totalKobo)}</strong>${o.paidLate ? ' · paid after expiry' : ''}<br>` +
      `📞 <a href="tel:${esc(o.phone)}">${esc(o.phone)}</a>${o.paystackRef && !unpaid ? ` · Paystack ${esc(o.paystackRef)}` : ''}` +
      `${o.statusBy ? `<br>${esc(st.label)} · ${esc(o.statusBy)}, ${esc(time(o.statusAt))}` : ''}</p>` +
      `<div class="fo-acts">${acts}</div></article>`;
  }
  async function load() {
    try {
      const d = await api('/api/admin/food-orders?show=' + show);
      ST = d.statuses;
      if (document.activeElement !== $('expiry')) $('expiry').value = d.settings.paymentExpiryMinutes;
      const t = d.today;
      $('awaitN').textContent = t.awaiting ? `(${t.awaiting})` : '';
      $('stats').innerHTML = [
        ['#F97316', t.open, 'To do now', 'Paid, preparing or on the way'],
        ['#F59E0B', t.awaiting, 'Awaiting payment', 'Not to be prepared'],
        ['#16A34A', t.orders, 'Paid orders today', naira(t.revenueKobo) + ' paid'],
        ['#8B5CF6', t.topItems[0] ? t.topItems[0].name : '–', 'Most ordered today', t.topItems.slice(0, 3).map(i => `${i.name} × ${i.qty}`).join(', ')],
      ].map(([c, n, l, s]) => `<div class="fo-stat" style="--c:${c}"><b>${esc(n)}</b><span>${esc(l)}</span>${s ? `<small>${esc(s)}</small>` : ''}</div>`).join('');
      $('list').innerHTML = d.orders.length ? d.orders.map(card).join('')
        : `<p class="fo-empty"><b>🍽️</b>${show === 'open' ? 'No paid orders waiting. The kitchen is all clear 🎉' : show === 'awaiting' ? 'No orders waiting for payment.' : 'No food orders yet.'}</p>`;
      $('updated').textContent = 'Updated ' + new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit', timeZone: 'Africa/Lagos' });
    } catch (err) { msg(err.message, false); }
  }
  $('list').addEventListener('click', async e => {
    const b = e.target.closest('button[data-s]'); if (!b) return;
    const c = b.closest('[data-id]');
    if (b.dataset.s === 'CANCELLED' && !confirm(`Cancel order ${c.dataset.ref}? Any refund is done in the Paystack dashboard; mark it "Refunded" here afterwards.`)) return;
    b.disabled = true;
    try { await api('/api/admin/food-orders', { method: 'POST', body: JSON.stringify({ id: c.dataset.id, status: b.dataset.s }) }); await load(); }
    catch (err) { msg(err.message, false); b.disabled = false; }
  });
  document.querySelectorAll('[data-show]').forEach(b => b.addEventListener('click', () => {
    show = b.dataset.show;
    document.querySelectorAll('[data-show]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
    load();
  }));
  $('settings').addEventListener('submit', async e => {
    e.preventDefault();
    try { await api('/api/admin/food-orders', { method: 'POST', body: JSON.stringify({ settings: { paymentExpiryMinutes: Number($('expiry').value) } }) }); msg('Saved. New orders use this time limit.', true); }
    catch (err) { msg(err.message, false); }
  });
  load();
  setInterval(load, 20000);
})();
</script>
