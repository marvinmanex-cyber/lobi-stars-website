---
// Fans & Inbox › Newsletter: write the weekly newsletter (headline, message,
// photo, next match, stories), choose the sponsor adverts, preview it, send a
// test and send it to every subscriber. Sponsor adverts (logo, link, text)
// are managed in their own tab and can be added, changed, reordered,
// switched off or deleted. Partners › Newsletter Sponsor Adverts opens that tab.
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
---
<Layout title="Newsletter | Lobi Stars Admin" description="Write and send the Lobi Stars weekly newsletter." noindex>
  <div class="wrap nl">
    <AdminNav current="newsletter" />
    <div class="nl-head">
      <div><div class="stag">Fans &amp; Inbox</div><h1 class="stitle">News<span class="r">letter</span></h1></div>
      <a class="btn-o sm" href="/newsletter/" target="_blank" rel="noopener">View the sign-up page ↗</a>
    </div>
    <p class="nl-banner" id="banner" hidden></p>
    <section class="nl-stats" id="stats" aria-label="Subscribers"></section>
    <div class="nl-tabs" role="tablist">
      <button type="button" role="tab" data-tab="issues" aria-selected="true">✉️ Newsletters</button>
      <button type="button" role="tab" data-tab="sponsors" aria-selected="false">🤝 Sponsor adverts</button>
      <button type="button" role="tab" data-tab="settings" aria-selected="false">🎨 Template &amp; settings</button>
      <button type="button" role="tab" data-tab="subs" aria-selected="false">👥 Subscribers</button>
    </div>
    <p class="nl-msg" id="msg" role="status" aria-live="polite" hidden></p>

    <!-- Newsletters -->
    <section data-pane="issues">
      <div id="issueList">
        <div class="nl-bar"><button type="button" class="btn-p" id="newIssue">＋ New newsletter</button><span class="muted">Starts with this week's news, the next match and all active sponsor adverts. Change anything before sending.</span></div>
        <div class="panel"><div class="scroll" id="issues"><p class="muted">Loading…</p></div></div>
      </div>

      <div id="editor" hidden>
        <div class="nl-bar">
          <button type="button" class="btn-o sm" id="backList">← All newsletters</button>
          <span class="badge" id="edStatus"></span>
          <span class="muted" id="edSaved"></span>
        </div>
        <div class="nl-ed">
          <form class="nl-form" id="form" autocomplete="off">
            <fieldset class="panel"><legend>1. The email</legend>
              <label>Subject (what fans see in their inbox) *<input name="subject" maxlength="150" required placeholder="The Lobi Stars Weekly: derby day is here" /></label>
              <label>Preview text (shown after the subject in most inboxes)<input name="preheader" maxlength="200" placeholder="Tickets, team news and a word from our partners" /></label>
            </fieldset>
            <fieldset class="panel"><legend>2. Main message</legend>
              <label>Headline<input name="headline" maxlength="150" placeholder="A big week for the Pride of Benue" /></label>
              <label>Message <span class="muted">(each fan is greeted by first name; leave an empty line between paragraphs)</span><textarea name="intro" rows="6" maxlength="6000"></textarea></label>
              <div class="nl-img" data-img="hero_image">
                <span class="nl-lbl">Main photo (optional, wide pictures look best)</span>
                <div class="nl-img-row"><img alt="" hidden /><input name="hero_image" placeholder="https://… or upload" /><label class="btn-o sm nl-up">Upload<input type="file" accept="image/*" hidden /></label><button type="button" class="btn-o sm" data-clear>Remove</button></div>
              </div>
              <div class="nl-2"><label>Button text<input name="hero_button_text" maxlength="40" placeholder="Buy tickets" /></label><label>Button link<input name="hero_button_url" placeholder="/tickets/ or https://…" /></label></div>
            </fieldset>
            <fieldset class="panel"><legend>3. Next match</legend>
              <label class="nl-check"><input type="checkbox" name="include_match" /> Show the next Lobi Stars match (date, time, venue and a tickets button), filled in automatically</label>
            </fieldset>
            <fieldset class="panel"><legend>4. Stories</legend>
              <div id="stories"></div>
              <div class="nl-bar">
                <button type="button" class="btn-o sm" id="addStory">＋ Add a story</button>
                <select id="newsPick" aria-label="Add from club news"><option value="">＋ Add from club news…</option></select>
              </div>
            </fieldset>
            <fieldset class="panel"><legend>5. Sponsor adverts</legend>
              <label>"In partnership with" at the top<select name="top_sponsor_id"><option value="">None</option></select></label>
              <p class="nl-lbl">Adverts in this newsletter <span class="muted">(tick to include; ↑ ↓ to change the order; any number)</span></p>
              <ul class="nl-picks" id="sponsorPicks"></ul>
              <p class="muted">Add or change sponsor logos, links and text in the <a href="?tab=sponsors" data-go="sponsors">Sponsor adverts</a> tab.</p>
            </fieldset>
          </form>
          <div class="nl-pv">
            <div class="nl-pv-head"><b>Preview</b><span class="muted">as fans will see it</span>
              <span class="nl-pv-size"><button type="button" data-w="600" aria-pressed="true">Computer</button><button type="button" data-w="375" aria-pressed="false">Phone</button></span></div>
            <iframe id="pv" title="Newsletter preview" sandbox="allow-popups allow-popups-to-escape-sandbox"></iframe>
          </div>
        </div>
        <div class="nl-actions" id="actions">
          <button type="button" class="btn-p" id="save">💾 Save draft</button>
          <span class="nl-test"><input type="email" id="testTo" placeholder="your@email.com" aria-label="Send a test to" /><button type="button" class="btn-o" id="sendTest">Send test</button></span>
          <button type="button" class="btn-p nl-send" id="sendAll">📨 Send to subscribers</button>
          <span class="nl-sched"><label for="schedAt">or send on</label><input type="datetime-local" id="schedAt" /><button type="button" class="btn-o" id="schedule">🕒 Schedule</button></span>
          <p class="nl-sched-info" id="schedInfo" hidden><span id="schedText"></span> <button type="button" class="btn-o" id="unschedule">Cancel schedule</button></p>
        </div>
        <div class="panel nl-report" id="report" hidden></div>
      </div>
    </section>

    <!-- Sponsor adverts -->
    <section data-pane="sponsors" hidden>
      <div class="nl-bar">
        <button type="button" class="btn-p" id="newSponsor">＋ Add sponsor advert</button>
        <button type="button" class="btn-o" id="importPartners">Import club partners</button>
        <span class="muted">Each advert has a logo, a link to the sponsor's website, a title and short text. Switch one off to keep it for later, or delete it.</span>
      </div>
      <div class="nl-spgrid" id="sponsors"></div>
    </section>

    <!-- Template & settings -->
    <section data-pane="settings" hidden>
      <form class="nl-form nl-setform" id="setForm" autocomplete="off">
        <fieldset class="panel"><legend>Wording in every newsletter</legend>
          <p class="muted">These words appear in every newsletter. Leave a box empty to go back to the standard wording.</p>
          <label>Name under the club badge<input name="title" maxlength="60" /></label>
          <div class="nl-2"><label>"Next match" heading<input name="matchLabel" maxlength="40" /></label><label>Stories heading<input name="storiesLabel" maxlength="40" /></label></div>
          <div class="nl-2"><label>Featured sponsors heading<input name="featuredLabel" maxlength="40" /></label><label>Sponsor adverts heading<input name="partnersLabel" maxlength="40" /></label></div>
          <label>Line under the sponsor adverts heading<input name="partnersText" maxlength="200" /></label>
        </fieldset>
        <fieldset class="panel"><legend>Footer</legend>
          <label>Club address<input name="footerAddress" maxlength="160" /></label>
          <label>Why fans get this email (the unsubscribe link is added after it)<textarea name="footerNote" rows="2" maxlength="300"></textarea></label>
          <p class="nl-lbl">Social links (leave empty to hide)</p>
          <div class="nl-2"><label>Facebook<input name="facebook" placeholder="https://www.facebook.com/…" /></label><label>X<input name="x" placeholder="https://x.com/…" /></label></div>
          <div class="nl-2"><label>Instagram<input name="instagram" placeholder="https://www.instagram.com/…" /></label><label>YouTube<input name="youtube" placeholder="https://www.youtube.com/@…" /></label></div>
          <div class="nl-2"><label>TikTok<input name="tiktok" placeholder="https://www.tiktok.com/@…" /></label><label>WhatsApp Channel<input name="whatsapp" placeholder="https://whatsapp.com/channel/…" /></label></div>
        </fieldset>
        <div class="nl-bar"><button class="btn-p" type="submit">Save template settings</button><button type="button" class="btn-o" id="setReset">Back to the standard wording</button><span class="muted">Changes apply to newsletters not yet sent (and to previews straight away).</span></div>
      </form>
    </section>

    <!-- Subscribers -->
    <section data-pane="subs" hidden>
      <div class="panel nl-subs" id="subs"></div>
    </section>
  </div>

  <dialog class="nl-dlg" id="spDlg" aria-labelledby="spTitle">
    <form method="dialog" class="nl-x"><button aria-label="Close">&times;</button></form>
    <h2 id="spTitle">Sponsor advert</h2>
    <form id="spForm" class="nl-form" autocomplete="off">
      <input type="hidden" name="id" />
      <label>Sponsor name *<input name="name" maxlength="80" required /></label>
      <div class="nl-img" data-img="logo">
        <span class="nl-lbl">Logo (PNG with a clear background looks best)</span>
        <div class="nl-img-row"><img alt="" hidden /><input name="logo" placeholder="https://… or upload" /><label class="btn-o sm nl-up">Upload<input type="file" accept="image/*" hidden /></label><button type="button" class="btn-o sm" data-clear>Remove</button></div>
      </div>
      <label>Website link<input name="link" placeholder="https://www.sponsor.com" /></label>
      <label>Title above the name<input name="headline" maxlength="60" placeholder="Official Banking Partner" /></label>
      <label>Advert text<textarea name="text" rows="3" maxlength="300" placeholder="Open an account in minutes and get…"></textarea></label>
      <label>Offer or promo code (optional, shown in a highlighted box)<input name="offer" maxlength="120" placeholder="10% off with code LOBISTARS" /></label>
      <label>Address (optional)<input name="address" maxlength="160" placeholder="12 Old Otukpo Road, Makurdi" /></label>
      <div class="nl-2"><label>Phone (optional)<input name="phone" maxlength="40" placeholder="0803 123 4567" /></label><label>Email (optional)<input name="email" type="email" maxlength="120" placeholder="hello@sponsor.com" /></label></div>
      <label class="nl-check"><input type="checkbox" name="featured" /> Featured: show as a big advert across the whole email (above the other sponsors)</label>
      <div class="nl-img" data-img="banner_image">
        <span class="nl-lbl">Wide advert picture for featured adverts (optional, about 1200 × 600)</span>
        <div class="nl-img-row"><img alt="" hidden /><input name="banner_image" placeholder="https://… or upload" /><label class="btn-o sm nl-up">Upload<input type="file" accept="image/*" hidden /></label><button type="button" class="btn-o sm" data-clear>Remove</button></div>
      </div>
      <div class="nl-2"><label>Button text<input name="button_text" maxlength="30" placeholder="Visit website" /></label>
        <label class="nl-check nl-active"><input type="checkbox" name="active" checked /> Active (can be added to newsletters)</label></div>
      <div class="nl-dacts"><button type="button" class="btn-o" id="spDelete">Delete</button><button class="btn-p" type="submit">Save advert</button></div>
    </form>
  </dialog>
</Layout>

<style>
  .nl { max-width: 1500px; padding-top: 20px; padding-bottom: 90px; }
  .nl-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
  .sm { min-height: 40px; padding: 6px 12px; font-size: 13px; }
  .nl-banner { background: #FFF7E6; color: #7A4B00; border: 1px solid #F6D58E; border-radius: 12px; padding: 10px 14px; margin: 0 0 12px; font-size: 14px; }
  :global(body.admin-dark) .nl-banner { background: #3A2E12; color: #F6D58E; border-color: #5A4718; }
  .nl-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-bottom: 14px; }
  .nl :global(.nl-stat) { background: var(--a-card); border: 1px solid var(--a-line); border-radius: 14px; padding: 12px 14px; border-left: 4px solid #8B5CF6; }
  .nl :global(.nl-stat b) { display: block; font: 400 32px/1 'Bebas Neue', sans-serif; color: var(--a-ink); }
  .nl :global(.nl-stat span) { font-size: 13px; color: var(--a-muted); }
  .nl-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
  .nl-tabs button { border: 1px solid var(--a-line); background: var(--a-card); color: var(--a-ink); border-radius: 999px; padding: 8px 14px; font-weight: 700; cursor: pointer; min-height: 40px; }
  .nl-tabs button[aria-selected="true"] { background: #8B5CF6; border-color: #8B5CF6; color: #fff; }
  .nl-msg { position: fixed; left: 50%; transform: translateX(-50%); bottom: 18px; z-index: 1500; width: max-content; max-width: calc(100vw - 32px); padding: 12px 16px; border-radius: 12px; margin: 0; box-shadow: 0 14px 34px rgba(0,0,0,.22); font-weight: 600; }
  .nl-msg.ok { background: #E8F7EE; color: #17643A; } .nl-msg.err { background: #FDECEC; color: #A3161B; }
  .nl-bar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin: 0 0 12px; }
  .nl-bar .muted { font-size: 13px; flex: 1; min-width: 200px; }
  .nl :global(.nl-row-acts) { display: flex; gap: 6px; flex-wrap: wrap; }
  .nl :global(.nl-row-acts button), .nl :global(.nl-row-acts a) { min-height: 36px; padding: 4px 10px; border-radius: 8px; border: 1px solid var(--a-line); background: var(--a-card); color: var(--a-ink); font-size: 13px; font-weight: 700; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; }

  .nl-ed { display: grid; grid-template-columns: minmax(380px, 1fr) minmax(0, 620px); gap: 16px; align-items: start; }
  .nl-form { display: grid; gap: 12px; min-width: 0; }
  .nl-form fieldset { border: 1px solid var(--a-line); border-radius: 14px; padding: 14px 16px 16px; margin: 0; display: grid; gap: 10px; background: var(--a-card); min-width: 0; }
  .nl-form legend { font: 700 16px/1 'Barlow', sans-serif; padding: 0 6px; color: var(--a-ink); }
  .nl-form label, .nl-lbl { display: grid; gap: 4px; font-size: 13px; font-weight: 700; color: var(--a-muted); }
  .nl-lbl { display: block; margin: 0; }
  .nl-form input:not([type=checkbox]):not([type=file]), .nl-form textarea, .nl-form select, .nl-bar select { min-height: 42px; border: 1px solid var(--a-line); border-radius: 10px; padding: 8px 10px; background: var(--a-card); color: var(--a-ink); font: inherit; font-size: 15px; font-weight: 400; width: 100%; min-width: 0; }
  .nl-bar select { width: auto; max-width: 100%; }
  .nl-form textarea { resize: vertical; line-height: 1.5; }
  .nl-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .nl-check { display: flex !important; gap: 10px; align-items: flex-start; font-weight: 600 !important; color: var(--a-ink) !important; font-size: 14px !important; }
  .nl-check input { width: 20px; height: 20px; flex: none; accent-color: #8B5CF6; margin-top: 1px; }
  .nl-active { align-self: end; padding-bottom: 10px; }
  .nl :global(.nl-img-row), .nl-dlg :global(.nl-img-row) { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-top: 4px; }
  .nl :global(.nl-img-row img), .nl-dlg :global(.nl-img-row img) { width: 64px; height: 44px; object-fit: contain; border: 1px solid var(--a-line); border-radius: 8px; background: #fff; }
  .nl :global(.nl-img-row input), .nl-dlg :global(.nl-img-row input) { flex: 1; min-width: 160px; }
  .nl-up { cursor: pointer; display: inline-flex; align-items: center; }
  .nl :global(.nl-story) { border: 1px solid var(--a-line); border-radius: 12px; padding: 12px; margin-bottom: 10px; display: grid; gap: 8px; background: var(--a-soft); }
  .nl :global(.nl-story-h) { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-weight: 700; color: var(--a-ink); }
  .nl :global(.nl-mini) { display: inline-flex; gap: 4px; }
  .nl :global(.nl-mini button) { width: 36px; height: 36px; border: 1px solid var(--a-line); background: var(--a-card); color: var(--a-ink); border-radius: 8px; cursor: pointer; font-size: 15px; }
  .nl-picks { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .nl :global(.nl-pick) { display: flex; gap: 10px; align-items: center; border: 1px solid var(--a-line); border-radius: 10px; padding: 8px 10px; background: var(--a-soft); }
  .nl :global(.nl-pick img) { width: 54px; height: 32px; object-fit: contain; background: #fff; border-radius: 6px; }
  .nl :global(.nl-pick label) { display: flex; flex: 1; gap: 8px; align-items: center; color: var(--a-ink); font-size: 14px; font-weight: 600; min-width: 0; }
  .nl :global(.nl-pick input) { width: 20px; height: 20px; accent-color: #8B5CF6; flex: none; }
  .nl-pv { position: sticky; top: 76px; border: 1px solid var(--a-line); border-radius: 14px; overflow: hidden; background: var(--a-card); }
  .nl-pv-head { display: flex; gap: 8px; align-items: center; padding: 10px 12px; border-bottom: 1px solid var(--a-line); flex-wrap: wrap; }
  .nl-pv-head .muted { font-size: 13px; flex: 1; }
  .nl-pv-size { display: inline-flex; border: 1px solid var(--a-line); border-radius: 999px; overflow: hidden; }
  .nl-pv-size button { border: 0; background: var(--a-card); color: var(--a-ink); padding: 6px 12px; font-size: 13px; font-weight: 700; cursor: pointer; min-height: 34px; }
  .nl-pv-size button[aria-pressed="true"] { background: var(--a-ink); color: var(--a-card); }
  #pv { display: block; width: 100%; height: calc(100vh - 200px); min-height: 560px; border: 0; background: #EEF0F3; margin: 0 auto; transition: width .2s; }
  .nl-actions { position: sticky; bottom: 0; z-index: 20; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; padding: 12px 14px; margin-top: 14px; background: var(--a-card); border: 1px solid var(--a-line); border-radius: 14px; box-shadow: 0 -8px 22px rgba(15,17,21,.08); }
  .nl-test { display: inline-flex; gap: 6px; flex: 1; min-width: 240px; }
  .nl-test input { flex: 1; min-height: 42px; border: 1px solid var(--a-line); border-radius: 10px; padding: 8px 10px; background: var(--a-card); color: var(--a-ink); min-width: 0; }
  .nl-send { background: #15803D !important; border-color: #15803D !important; }
  .nl-sched { display: inline-flex; gap: 6px; align-items: center; flex-wrap: wrap; }
  .nl-sched label { font-size: 13px; color: var(--a-muted); }
  .nl-sched input { min-height: 42px; border: 1px solid var(--a-line); border-radius: 10px; padding: 8px 10px; background: var(--a-card); color: var(--a-ink); }
  .nl-sched-info { flex-basis: 100%; margin: 0; padding: 10px 12px; border-radius: 10px; background: #FFF8E1; color: #5c4300; font-weight: 600; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .nl-sched-info[hidden] { display: none; }
  .nl-report { margin-top: 14px; padding: 16px; }
  .nl :global(.nl-report h3) { margin: 0 0 8px; font: 700 18px/1.2 'Barlow', sans-serif; }

  .nl-spgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .nl :global(.nl-sp) { border: 1px solid var(--a-line); border-radius: 14px; background: var(--a-card); padding: 14px; display: grid; gap: 8px; align-content: start; }
  .nl :global(.nl-sp.off) { opacity: .6; }
  .nl :global(.nl-sp-logo) { height: 70px; display: flex; align-items: center; justify-content: center; background: #fff; border-radius: 10px; border: 1px solid var(--a-line); }
  .nl :global(.nl-sp-logo img) { max-height: 56px; max-width: 80%; object-fit: contain; }
  .nl :global(.nl-sp h3) { margin: 0; font: 700 17px/1.25 'Barlow', sans-serif; color: var(--a-ink); }
  .nl :global(.nl-sp p) { margin: 0; font-size: 13px; color: var(--a-muted); overflow-wrap: anywhere; }
  .nl :global(.nl-subs) { padding: 18px; }
  .nl-setform { max-width: 900px; }
  .nl :global(.nl-subs ul) { margin: 8px 0 14px; padding-left: 20px; line-height: 1.7; }

  .nl-dlg { margin: auto; border: 0; border-radius: 16px; padding: 22px; width: min(620px, calc(100vw - 24px)); max-height: calc(100vh - 30px); background: var(--a-card); color: var(--a-ink); position: relative; }
  .nl-dlg::backdrop { background: rgba(0,0,0,.5); }
  .nl-dlg ::placeholder, .nl ::placeholder { color: var(--a-muted); opacity: .75; font-weight: 400; }
  .nl-dlg h2 { margin: 0 0 12px; font: 400 26px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; padding-right: 44px; }
  .nl-dlg .nl-form label { display: grid; gap: 4px; font-size: 13px; font-weight: 700; color: var(--a-muted); }
  .nl-dlg input:not([type=checkbox]):not([type=file]), .nl-dlg textarea { min-height: 42px; border: 1px solid var(--a-line); border-radius: 10px; padding: 8px 10px; background: var(--a-card); color: var(--a-ink); font: inherit; font-size: 15px; width: 100%; }
  .nl-x { position: absolute; top: 12px; right: 12px; } .nl-x button { width: 40px; height: 40px; border: 0; background: var(--a-soft); color: var(--a-ink); border-radius: 50%; font-size: 22px; cursor: pointer; }
  .nl-dacts { display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; margin-top: 6px; }

  @media (max-width: 1300px) { .nl-ed { grid-template-columns: 1fr; } .nl-pv { position: static; } #pv { height: 760px; } }
  @media (max-width: 560px) { .nl-2 { grid-template-columns: 1fr; } .nl-actions { position: static; } .nl-actions > * { flex: 1 1 100%; } .nl-test { min-width: 0; } }
</style>

<script is:inline>
(function () {
  const code = sessionStorage.getItem('ls_admin_code') || '__session__';
  const $ = id => document.getElementById(id);
  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const H = { 'x-admin-code': code };
  async function api(path, body) {
    const res = await fetch(path, body === undefined ? { headers: H, cache: 'no-store' } : { method: 'POST', headers: { ...H, 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    if (res.status === 401) { location.href = '/admin/login/?next=' + encodeURIComponent(location.pathname + location.search); throw new Error('Please sign in again.'); }
    const d = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(d.error || 'Something went wrong. Please try again.');
    return d;
  }
  let msgT;
  function msg(t, ok) { const m = $('msg'); m.textContent = t; m.className = 'nl-msg ' + (ok ? 'ok' : 'err'); m.hidden = false; clearTimeout(msgT); msgT = setTimeout(() => { m.hidden = true; }, ok ? 5000 : 10000); }
  const day = iso => iso ? new Date(iso).toLocaleString('en-GB', { timeZone: 'Africa/Lagos', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
