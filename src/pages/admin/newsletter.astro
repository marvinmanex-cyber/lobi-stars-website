  // Picture uploads (made smaller first), for the editor and the sponsor form.
  async function shrink(file, maxW, keepPng) {
    const img = await new Promise((ok, bad) => { const i = new Image(); i.onload = () => ok(i); i.onerror = bad; i.src = URL.createObjectURL(file); });
    const scale = Math.min(1, maxW / img.naturalWidth);
    const c = document.createElement('canvas'); c.width = Math.round(img.naturalWidth * scale); c.height = Math.round(img.naturalHeight * scale);
    const ctx = c.getContext('2d');
    if (!keepPng) { ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, c.width, c.height); }
    ctx.drawImage(img, 0, 0, c.width, c.height);
    const type = keepPng ? 'image/png' : 'image/jpeg';
    return new Promise(ok => c.toBlob(b => ok(b), type, 0.85));
  }
  document.addEventListener('change', async e => {
    const inp = e.target;
    if (!(inp instanceof HTMLInputElement) || inp.type !== 'file' || !inp.closest('.nl-img')) return;
    const file = inp.files[0]; inp.value = '';
    if (!file) return;
    if (!/^image\//.test(file.type)) { msg('Please choose a picture (JPG, PNG, WebP or GIF).', false); return; }
    const logo = inp.closest('.nl-img').dataset.img === 'logo';
    try {
      const blob = file.type === 'image/gif' && file.size < 900000 ? file : await shrink(file, logo ? 600 : 1200, logo || file.type === 'image/png');
      const res = await fetch('/api/admin/newsletter/asset', { method: 'POST', headers: { ...H, 'Content-Type': blob.type }, body: blob });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(d.error || 'Upload failed.');
      const field = inp.closest('.nl-img').querySelector('input:not([type=file])');
      field.value = d.url; field.dispatchEvent(new Event('input', { bubbles: true })); imgPreviews();
      msg('Picture uploaded.', true);
    } catch (err) { msg(err.message, false); }
  });
  document.addEventListener('click', e => {
