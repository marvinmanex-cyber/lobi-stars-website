      if (t.closest('[data-edit]')) editSponsor(at('data-edit'));
      if (t.closest('[data-toggle]')) { const x = at('data-toggle'); await api('/api/admin/newsletter', { action: 'save_sponsor', sponsor: { ...x, active: !x.active } }); await load(); msg(x.active ? x.name + ' switched off.' : x.name + ' switched on.', true); }
      if (t.closest('[data-sdel]')) { const x = at('data-sdel'); if (confirm('Delete the ' + x.name + ' advert? It is removed from future newsletters.')) { await api('/api/admin/newsletter', { action: 'delete_sponsor', id: x.id }); await load(); msg('Advert deleted.', true); } }
      const up = t.closest('[data-sup]'), down = t.closest('[data-sdown]');
      if (up || down) {
        const i = Number((up || down).getAttribute(up ? 'data-sup' : 'data-sdown')), j = up ? i - 1 : i + 1;
        if (j < 0 || j >= s.length) return;
        const ids = s.map(x => x.id); [ids[i], ids[j]] = [ids[j], ids[i]];
        await api('/api/admin/newsletter', { action: 'order_sponsors', ids }); await load();
      }
    } catch (err) { msg(err.message, false); }
  });
  $('spForm').addEventListener('input', imgPreviews);
  $('spForm').addEventListener('submit', async e => {
    e.preventDefault(); const f = e.target.elements;
    try {
      await api('/api/admin/newsletter', { action: 'save_sponsor', sponsor: { id: f.id.value || undefined, name: f.name.value, logo: f.logo.value.trim(), link: f.link.value.trim(), headline: f.headline.value, text: f.text.value, button_text: f.button_text.value, active: f.active.checked, offer: f.offer.value, address: f.address.value, phone: f.phone.value, email: f.email.value, featured: f.featured.checked, banner_image: f.banner_image.value.trim() } });
      $('spDlg').close(); await load(); msg('Sponsor advert saved.', true);
      if (cur && editable(cur.status)) { const keep = collect(); fill({ ...cur, ...keep }); refreshPreview(true); }
    } catch (err) { msg(err.message, false); }
  });
  $('spDelete').addEventListener('click', async () => {
    const f = $('spForm').elements; if (!f.id.value || !confirm('Delete this sponsor advert?')) return;
    try { await api('/api/admin/newsletter', { action: 'delete_sponsor', id: f.id.value }); $('spDlg').close(); await load(); msg('Advert deleted.', true); } catch (err) { msg(err.message, false); }
  });
  $('importPartners').addEventListener('click', async () => {
    try {
      const partners = await fetch('/data/partners.json').then(r => r.json());
      const r = await api('/api/admin/newsletter', { action: 'import_partners', partners: partners.map(p => ({ name: p.name, logo: p.logo, link: p.website, headline: p.officialTitle || p.tier })) });
      await load(); msg(r.added ? r.added + ' club partners added. Check each one and add advert text.' : 'All club partners are already in the list.', true);
    } catch (err) { msg(err.message, false); }
  });

  // ── Template & settings ──
  function fillSettings() {
    const f = $('setForm').elements;
    for (const [k, v] of Object.entries(data.settings || {})) if (f[k]) f[k].value = v || '';
  }
  $('setForm').addEventListener('submit', async e => {
    e.preventDefault();
    const f = e.target.elements, settings = {};
    for (const k of Object.keys(data.defaults || {})) if (f[k]) settings[k] = f[k].value;
    try { const r = await api('/api/admin/newsletter', { action: 'save_settings', settings }); data.settings = r.settings; fillSettings(); msg('Template settings saved.', true); if (cur) refreshPreview(true); }
    catch (err) { msg(err.message, false); }
  });
  $('setReset').addEventListener('click', async () => {
    if (!confirm('Go back to the standard wording and links?')) return;
    try { const r = await api('/api/admin/newsletter', { action: 'save_settings', settings: data.defaults }); data.settings = r.settings; fillSettings(); msg('Standard wording restored.', true); }
    catch (err) { msg(err.message, false); }
  });

  // ── Subscribers ──
  function drawSubs() {
    const c = data.counts;
    $('subs').innerHTML = `<h2 style="margin:0 0 8px;font:400 26px/1 'Bebas Neue',sans-serif">Who receives the newsletter</h2>
      <p><b>${c.recipients.toLocaleString('en-NG')}</b> people will receive the next newsletter: everyone in the fan database who agreed to club news by email and has not unsubscribed, except those who switched the weekly newsletter off.</p>
      <ul><li>${c.signups} signed up with the newsletter form (footer, homepage or the newsletter page)</li>
      <li>${c.weekly} chose the weekly newsletter · ${c.matchday} matchday &amp; ticket alerts · ${c.offers} partner offers</li></ul>
      <p>Every email has an <b>Unsubscribe</b> link and a <b>Newsletter options</b> link where fans change what they get.</p>
      <div class="nl-row-acts"><a href="/admin/fans/?source=newsletter">See subscribers in the Fan Database</a><a href="/admin/contact-sources/">Download contact lists</a><a href="/newsletter/" target="_blank" rel="noopener">The sign-up page ↗</a></div>`;
  }

  window.addEventListener('beforeunload', e => { if (dirty) { e.preventDefault(); e.returnValue = ''; } });
  (async () => {
    try {
      const t = new URLSearchParams(location.search).get('tab'); if (t) tab(t);
      news = await fetch('/data/news-index.json').then(r => r.json()).catch(() => []);
      await load(); newsFill();
    } catch (err) { msg(err.message, false); }
  })();
})();
</script>
