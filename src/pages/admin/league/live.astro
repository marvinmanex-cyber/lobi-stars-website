---
// League › Live mode (?id=<fixture>): for a phone beside the pitch. Big
// buttons, a huge score, every tap saved at once ("Saved at 16:47"). A second
// tap within 3 seconds is ignored; if the network fails the screen keeps its
// state and says so in red until it is retried.
import Layout from '../../../layouts/Layout.astro';
import AdminNav from '../../../components/admin/AdminNav.astro';
import LeagueKit from '../../../components/admin/league/LeagueKit.astro';
---
<Layout title="Live Mode | Lobi Stars Admin" description="Live score entry." noindex>
  <div class="wrap la lv">
    <AdminNav current="league-results" />
    <div id="app"><p class="la-muted">Loading…</p></div>
  </div>
  <LeagueKit />
</Layout>

<style is:global>
  .lv { max-width: 640px; }
  .lv-status { text-align: center; margin: 4px 0 10px; }
  .lv-status .la-chip { font-size: 16px; padding: 6px 16px; }
  .lv-teams { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; text-align: center; font: 700 18px/1.2 'Barlow', sans-serif; }
  .lv-score { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; text-align: center; font: 400 112px/1 'Bebas Neue', sans-serif; margin: 6px 0 14px; }
  .lv-score span:nth-child(2) { font-size: 60px; color: var(--a-muted); }
  .lv-goals { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .lv-btn { min-height: 76px; border-radius: 16px; border: 0; font: 700 22px 'Barlow', sans-serif; cursor: pointer; touch-action: manipulation; }
  .lv-btn.goal { background: #E31E24; color: #fff; }
  .lv-btn.big { width: 100%; background: #15181D; color: #fff; margin-top: 12px; }
  .lv-btn.ft { background: #17643A; }
  .lv-btn:disabled { opacity: .45; cursor: not-allowed; }
  .lv-btn:focus-visible { outline: 4px solid #FFC72C; outline-offset: 2px; }
  .lv-undo { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 10px; }
  .lv-undo button { min-height: 44px; border-radius: 10px; border: 1.5px solid var(--a-line); background: var(--a-card); color: var(--a-ink); font: 600 14px 'Barlow', sans-serif; cursor: pointer; }
  .lv-saved { text-align: center; font-weight: 700; margin: 14px 0 0; min-height: 22px; }
  .lv-saved.err { background: #A3161B; color: #fff; padding: 12px; border-radius: 10px; }
  .lv-saved.ok { color: #17643A; }
</style>

<script is:inline>
(function () {
  var LA = window.LA, el = LA.el, app = document.getElementById('app');
  var id = new URLSearchParams(location.search).get('id');
  var f = null, busy = false, lastTap = { action: '', at: 0 }, failed = null;
  if (!/^\d+$/.test(id || '')) { app.replaceChildren(el('p', { class: 'la-msg err', text: 'Open Live mode from Fixtures or Results.' })); return; }

  function load() {
    LA.api('/api/admin/league/fixtures').then(function (r) {
      if (!r.ok) { app.replaceChildren(el('p', { class: 'la-msg err', text: r.d.error || 'Could not load the match.' })); return; }
      f = r.d.fixtures.find(function (x) { return String(x.id) === id; });
      if (!f) { app.replaceChildren(el('p', { class: 'la-msg err', text: 'Match not found.' })); return; }
      draw();
    });
  }

  function act(action, confirmText) {
    if (busy) return;
    if (action.indexOf('goal') >= 0 && lastTap.action === action && Date.now() - lastTap.at < 3000) { say('Second tap ignored.', 'ok'); return; }
    var run = function () {
      busy = true; lastTap = { action: action, at: Date.now() }; draw();
      LA.api('/api/admin/league/fixtures/' + f.id + '/live', { method: 'POST', body: { action: action } }).then(function (r) {
        busy = false;
        if (!r.ok) {
          failed = action;
          say((r.d.error || 'Not saved.') + (r.status === 0 ? ' Nothing was changed: tap "Try again".' : ''), 'err');
          draw(); return;
        }
        failed = null;
        var s = r.d.fixture;
        if (s) { f.status = s.status; f.homeGoals = s.home_goals; f.awayGoals = s.away_goals; }
        draw();
        say(r.d.ignored ? 'Second tap ignored.' : 'Saved at ' + new Date().toLocaleTimeString('en-GB', { timeZone: 'Africa/Lagos', hour: '2-digit', minute: '2-digit' }), 'ok');
      });
    };
    if (confirmText) LA.confirm(confirmText, f.home.name + ' ' + (f.homeGoals ?? 0) + ' – ' + (f.awayGoals ?? 0) + ' ' + f.away.name, 'Yes').then(function (y) { if (y) run(); });
    else run();
  }
  var msg = { text: '', cls: '' };
  function say(text, cls) { msg = { text: text, cls: cls }; var s = document.getElementById('lvSaved'); if (s) { s.textContent = text; s.className = 'lv-saved ' + cls; } }

  function draw() {
    var st = f.status, inPlay = st === 'live' || st === 'half_time';
    var b = function (text, action, cls, enabled, confirmText) { return el('button', { type: 'button', class: 'lv-btn ' + cls, text: text, disabled: busy || !enabled, onclick: function () { act(action, confirmText); } }); };
    app.replaceChildren.apply(app, [
      el('p', { class: 'la-muted', style: 'text-align:center;margin:0', text: f.competition + (f.matchday ? ' · Matchday ' + f.matchday : '') + ' · ' + LA.date(f.kickoff) + ', ' + LA.time(f.kickoff) }),
      el('div', { class: 'lv-status' }, LA.chip(st)),
      el('div', { class: 'lv-teams' }, el('span', {}, LA.crest(f.home), el('br'), f.home.name), el('span', {}, LA.crest(f.away), el('br'), f.away.name)),
      el('div', { class: 'lv-score', 'aria-live': 'polite', 'aria-label': 'Score ' + (f.homeGoals ?? 0) + ' to ' + (f.awayGoals ?? 0) }, el('span', { text: String(f.homeGoals ?? 0) }), el('span', { text: '–' }), el('span', { text: String(f.awayGoals ?? 0) })),
      el('div', { class: 'lv-goals' }, b('+1 ' + f.home.shortName, 'goal_home', 'goal', inPlay), b('+1 ' + f.away.shortName, 'goal_away', 'goal', inPlay)),
      el('div', { class: 'lv-undo' },
        el('button', { type: 'button', text: 'Undo home goal', disabled: busy || !inPlay || !f.homeGoals, onclick: function () { act('undo_goal_home', 'Take away a ' + f.home.shortName + ' goal?'); } }),
        el('button', { type: 'button', text: 'Undo away goal', disabled: busy || !inPlay || !f.awayGoals, onclick: function () { act('undo_goal_away', 'Take away a ' + f.away.shortName + ' goal?'); } })),
      st === 'scheduled' || st === 'postponed' ? b('Kick-off', 'kickoff', 'big', true, 'Start the match now?') : null,
      st === 'live' ? b('Half time', 'half_time', 'big', true) : null,
      st === 'half_time' ? b('Second half', 'second_half', 'big', true) : null,
      inPlay ? b('Full time', 'full_time', 'big ft', true, 'End the match? The result goes into the table.') : null,
      failed ? el('button', { type: 'button', class: 'lv-btn big', text: 'Try again', onclick: function () { var a = failed; failed = null; act(a); } }) : null,
      el('p', { class: 'lv-saved ' + msg.cls, id: 'lvSaved', role: 'status', 'aria-live': 'assertive', text: busy ? 'Saving…' : msg.text }),
      el('p', { style: 'text-align:center' }, el('a', { href: '/admin/league/results/?matchday=' + (f.matchday || ''), text: '← Results' }))].filter(Boolean));
  }
  load();
})();
</script>
