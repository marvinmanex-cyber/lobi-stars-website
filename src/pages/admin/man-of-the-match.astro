---
// Matchday › Man of the Match Sponsor (Super Admins only): the sponsor shown on /man-of-the-match/
// and on every announcement card. Settings record "motm_sponsor"; changes are logged.
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
import SponsorEditor from '../../components/admin/SponsorEditor.astro';
---
<Layout title="Man of the Match Sponsor | Lobi Stars Admin" description="The Man of the Match sponsor." noindex>
  <div class="wrap ms">
    <AdminNav current="motm-sponsor" />
    <header><div class="stag">Matchday</div><h1 class="stitle">Man of the Match <span class="r">Sponsor</span></h1></header>
    <SponsorEditor game="motm" where={'Shown on the Man of the Match page ("Man of the Match, sponsored by …") and on every announcement card.'} />
  </div>
</Layout>
