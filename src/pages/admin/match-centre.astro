---
import { getRoster } from '../../lib/players';
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';

// Lobi Stars players for the matchday squad picker (MOTM voting uses only these).
const roster = (await getRoster())
  .sort((a, b) => a.data.number - b.data.number)
  .map(p => ({ slug: p.id, name: p.data.name, number: p.data.number, position: p.data.position, isSample: p.data.isSample }));
---
<Layout title="Match Centre Editor | Lobi Stars Admin" description="Update Lobi Stars FC Match Centre pages." noindex>
  <div class="wrap mce">
    <AdminNav current="match-centre" />
    <div class="stag">Admin</div>
    <h1 class="stitle">Match <span class="r">Centre</span></h1>

    <p class="mce-msg" id="msg" role="status" aria-live="polite" hidden></p>

    <div class="form-grp mce-pick">
      <label class="form-lbl" for="matchSel">Match</label>
      <select class="form-sel" id="matchSel"><option value="">Loading matches…</option></select>
      <a id="viewLink" class="mce-view" target="_blank" rel="noopener" hidden>View public page &rarr;</a>
    </div>

    <section class="mce-control" id="control" hidden aria-labelledby="ctl-h">
      <div class="ctl-head">
        <h2 id="ctl-h">Match control</h2>
        <span class="ctl-badge" id="ctlBadge">Upcoming</span>
      </div>
      <p class="ctl-away" id="ctlAway" hidden>This is an away game: Matchday Live features (voting, predictions and the stream) are switched off. Fans still get the live commentary link. Use the form below for the score and report.</p>
      <div id="ctlHome">
        <dl class="ctl-facts">
          <div><dt>Scheduled kick-off</dt><dd id="ctlSched">–</dd></div>
          <div><dt>Kick-off recorded</dt><dd id="ctlKick">Not started</dd></div>
          <div><dt>Full-time recorded</dt><dd id="ctlEnd">–</dd></div>
        </dl>
        <p class="ctl-auto" id="ctlAuto" hidden></p>
        <div class="ctl-buttons">
          <button type="button" class="ctl-btn start" id="kickoffBtn">▶ Start Match (Kick-off)</button>
          <button type="button" class="ctl-btn end" id="fulltimeBtn">■ End Match (Full-time)</button>
        </div>
        <p class="muted ctl-note">Press <strong>Start Match</strong> at kick-off: Man of the Match voting opens. Press <strong>End Match</strong> at the final whistle and enter the score: voting closes and results are calculated. If nobody presses End Match, the match closes automatically 2 hours 15 minutes after kick-off (you can still add the final score afterwards). All times use the server clock in Nigerian time (WAT).</p>
        <div class="ctl-motm">
          <div class="ctl-motm-head">
            <h3>Man of the Match votes</h3>
            <a class="btn-o" id="motmCsv" href="#">Export votes (CSV)</a>
          </div>
          <p class="muted ctl-note">Staff can see the votes at any time. Fans only see the totals after full time.</p>
          <div id="motmBox"><p class="muted">Loading…</p></div>
        </div>
      </div>
    </section>

    <section class="mce-check" id="checklist" hidden aria-labelledby="chk-h">
      <h2 id="chk-h">Matchday content checklist</h2>
      <p class="muted chk-note">Recommended content for this match. Ticks update from the Match Centre fields below and from published news stories with this match's date and the matching <em>Matchday content type</em>. <strong>Create article</strong> opens the CMS with the match filled in.</p>
      <ul class="chk-list" id="chkList"></ul>
    </section>

    <dialog class="ctl-dialog" id="ftDialog" aria-labelledby="ft-h">
      <form id="ftForm" method="dialog">
        <h2 id="ft-h">Final score</h2>
        <p class="muted">Enter the full-time score. This ends the match, closes voting and calculates results.</p>
        <div class="ft-score">
          <label><span data-home>Home</span><input class="form-inp" id="ftHome" type="number" min="0" max="99" required /></label>
          <span class="ft-dash">–</span>
          <label><span data-away>Away</span><input class="form-inp" id="ftAway" type="number" min="0" max="99" required /></label>
        </div>
        <p class="form-error" id="ftErr" hidden></p>
        <div class="ft-actions">
          <button type="button" class="btn-o" id="ftCancel">Cancel</button>
          <button type="submit" class="btn-p" id="ftConfirm">Confirm full-time</button>
        </div>
      </form>
    </dialog>

    <form id="mcForm" hidden>
      <fieldset class="mce-set">
        <legend>Status &amp; score</legend>
        <div class="mce-row3">
          <div class="form-grp"><label class="form-lbl" for="status">Status</label>
            <select class="form-sel" id="status">
              <option value="scheduled">Upcoming</option><option value="live">Live</option><option value="half-time">Half-time</option>
              <option value="full-time">Full-time</option><option value="postponed">Postponed</option><option value="cancelled">Cancelled</option>
            </select></div>
          <div class="form-grp"><label class="form-lbl" for="homeScore"><span data-home>Home</span> score</label><input class="form-inp" id="homeScore" type="number" min="0" max="99" /></div>
          <div class="form-grp"><label class="form-lbl" for="awayScore"><span data-away>Away</span> score</label><input class="form-inp" id="awayScore" type="number" min="0" max="99" /></div>
        </div>
      </fieldset>

      <fieldset class="mce-set">
        <legend>Live timeline</legend>
        <p class="muted mce-hint">Add goals, cards and substitutions as they happen, then press <strong>Save</strong>. The public page refreshes every 30 seconds while the status is Live.</p>
        <div id="timeline"></div>
        <div class="mce-quick">
          <button type="button" class="btn-o" data-add="goal">+ Goal</button>
          <button type="button" class="btn-o" data-add="yellow">+ Yellow</button>
          <button type="button" class="btn-o" data-add="red">+ Red</button>
          <button type="button" class="btn-o" data-add="sub">+ Sub</button>
          <button type="button" class="btn-o" data-add="note">+ Note</button>
        </div>
      </fieldset>

      <fieldset class="mce-set" id="squadSet">
        <legend>Matchday squad (Lobi Stars players for Man of the Match)</legend>
        <p class="muted mce-hint">Choose who is in the starting XI and on the bench. Only these players appear in Man of the Match voting. Press <strong>Save Match Centre</strong> when done. <span id="squadCount"></span></p>
        {roster.length === 0 ? <p class="muted">No players yet. Add the squad in the Content CMS (Squad / Players) first.</p> : (
          <div class="sq-scroll"><table class="sq-table">
            <thead><tr><th scope="col">Player</th><th scope="col">Not selected</th><th scope="col">Starting XI</th><th scope="col">Bench</th></tr></thead>
            <tbody>
              {roster.map(p => (
                <tr>
                  <th scope="row">#{p.number} {p.name} <span class="muted">({p.position}){p.isSample && ' – sample'}</span></th>
                  <td><input type="radio" name={`sq-${p.slug}`} value="" data-squad={p.slug} checked aria-label={`${p.name}: not selected`} /></td>
                  <td><input type="radio" name={`sq-${p.slug}`} value="starting" data-squad={p.slug} aria-label={`${p.name}: starting XI`} /></td>
                  <td><input type="radio" name={`sq-${p.slug}`} value="bench" data-squad={p.slug} aria-label={`${p.name}: bench`} /></td>
                </tr>
              ))}
            </tbody>
          </table></div>
        )}
      </fieldset>

      <fieldset class="mce-set" id="streamSet">
        <legend>Live stream (Watch Live)</legend>
        <p class="muted mce-hint" id="streamHint">Paste the YouTube and/or Facebook link for this game's live stream. Fans see it on Matchday Live; after the match it stays there as the full match replay. Leave blank to show links to the official channels instead.</p>
        <div class="form-row">
          <div class="form-grp"><label class="form-lbl" for="ytUrl">YouTube live link</label><input class="form-inp" id="ytUrl" type="url" inputmode="url" placeholder="https://www.youtube.com/live/..." /></div>
          <div class="form-grp"><label class="form-lbl" for="fbUrl">Facebook live link</label><input class="form-inp" id="fbUrl" type="url" inputmode="url" placeholder="https://www.facebook.com/.../videos/..." /></div>
        </div>
      </fieldset>

      <fieldset class="mce-set">
        <legend>Preview &amp; report</legend>
        <div class="form-grp"><label class="form-lbl" for="preview">Match preview (blank line between paragraphs)</label><textarea class="form-ta" id="preview" rows="6"></textarea></div>
        <div class="form-grp"><label class="form-lbl" for="report">Match report</label><textarea class="form-ta" id="report" rows="8"></textarea></div>
      </fieldset>

      <fieldset class="mce-set">
        <legend>Line-ups (one player per line, e.g. "1 John Doe")</legend>
        <div class="mce-row2">
          <div class="form-grp"><label class="form-lbl" for="homeXI"><span data-home>Home</span> starting XI</label><textarea class="form-ta" id="homeXI" rows="11"></textarea></div>
          <div class="form-grp"><label class="form-lbl" for="awayXI"><span data-away>Away</span> starting XI</label><textarea class="form-ta" id="awayXI" rows="11"></textarea></div>
          <div class="form-grp"><label class="form-lbl" for="homeSubs"><span data-home>Home</span> substitutes</label><textarea class="form-ta" id="homeSubs" rows="5"></textarea></div>
          <div class="form-grp"><label class="form-lbl" for="awaySubs"><span data-away>Away</span> substitutes</label><textarea class="form-ta" id="awaySubs" rows="5"></textarea></div>
        </div>
      </fieldset>

      <fieldset class="mce-set">
        <legend>Stats (home / away)</legend>
        <div class="mce-stats" id="stats"></div>
      </fieldset>

      <fieldset class="mce-set">
        <legend>Gallery</legend>
        <div class="form-grp"><label class="form-lbl" for="gallery">One photo per line: image link | caption (upload photos in the Content CMS media library first)</label>
          <textarea class="form-ta" id="gallery" rows="5" placeholder="/images/match-photo-1.jpg | Celebrating the opener"></textarea></div>
      </fieldset>

      <div class="mce-save">
        <button type="submit" class="btn-p" id="saveBtn">Save Match Centre</button>
      </div>
    </form>
  </div>
</Layout>

<style>
  .mce { max-width: 980px; padding-top: 40px; padding-bottom: 100px; }
  .mce-nav { display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 28px; font: 600 14px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; }
  .mce-nav a { color: var(--lt); text-decoration: none; }
  .mce-nav .mce-back { color: var(--gold-text); }
  .mce-msg { padding: 12px 16px; border-radius: 8px; margin: 0 0 16px; }
  .mce-msg.ok { background: #E8F7EE; color: #17643A; }
  .mce-msg.err { background: #FDECEC; color: #A3161B; }
  .mce-pick { max-width: 640px; }
  .mce-view { display: inline-block; margin-top: 8px; color: var(--red-text); font-weight: 700; }
  .mce-control { border: 2px solid var(--d4); border-radius: 14px; padding: 18px 20px; margin: 0 0 20px; background: var(--dark); }
  .ctl-head { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
  .ctl-head h2 { margin: 0; font: 400 28px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .ctl-badge { padding: 5px 10px; border-radius: 20px; background: var(--d3); font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; }
  .ctl-badge.live { background: var(--red); color: #fff; }
  .ctl-badge.ft { background: #15181D; color: #fff; }
  .ctl-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin: 0 0 12px; }
  .ctl-facts dt { font: 700 11px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; color: var(--lt); margin-bottom: 4px; }
  .ctl-facts dd { margin: 0; font-weight: 700; }
  .ctl-auto, .ctl-away { padding: 10px 12px; border-radius: 8px; background: #FFF6D6; color: #5C4300; margin: 0 0 12px; }
  .ctl-buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .ctl-btn { padding: 20px 14px; border-radius: 10px; border: 0; cursor: pointer; color: #fff; font: 700 18px/1.1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; }
  .ctl-btn.start { background: #17803D; }
  .ctl-btn.end { background: var(--red); }
  .ctl-btn:disabled { background: #C9CED6; color: #5B6472; cursor: not-allowed; }
  .ctl-btn:focus-visible { outline: 3px solid #15181D; outline-offset: 2px; }
  .ctl-note { margin: 12px 0 0; font-size: 14px; line-height: 1.6; }
  .ctl-dialog { border: 0; border-radius: 14px; padding: 26px; width: min(440px, 92vw); box-shadow: 0 30px 80px rgba(0, 0, 0, .35); }
  .ctl-dialog::backdrop { background: rgba(15, 17, 21, .6); }
  .ctl-dialog h2 { margin: 0 0 6px; font: 400 30px/1 'Bebas Neue', sans-serif; }
  .ft-score { display: grid; grid-template-columns: 1fr auto 1fr; gap: 10px; align-items: end; margin: 16px 0; }
  .ft-score label { display: flex; flex-direction: column; gap: 6px; font-weight: 700; font-size: 14px; }
  .ft-score .form-inp { font-size: 28px; text-align: center; }
  .ft-dash { font-size: 28px; padding-bottom: 10px; }
  .ft-actions { display: flex; justify-content: flex-end; gap: 10px; }
  .sq-scroll { overflow-x: auto; position: relative; margin-bottom: 12px; }
  .sq-table { width: 100%; border-collapse: collapse; min-width: 480px; font-size: 15px; }
  .sq-table th, .sq-table td { padding: 8px 10px; border-bottom: 1px solid var(--d4); text-align: center; }
  .sq-table th[scope='row'] { text-align: left; font-weight: 600; }
  .sq-table thead th { font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: var(--lt); }
  .sq-table input { width: 18px; height: 18px; accent-color: var(--red); }
  @media (max-width: 600px) { .ctl-buttons { grid-template-columns: 1fr; } }
  .ctl-motm { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--d4); }
  .ctl-motm-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }
  .ctl-motm h3 { margin: 0; font: 400 22px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .ctl-motm :global(.motm-table) { width: 100%; border-collapse: collapse; font-size: 14px; }
  .ctl-motm :global(.motm-table th), .ctl-motm :global(.motm-table td) { padding: 7px 8px; border-bottom: 1px solid var(--d4); text-align: left; }
  .ctl-motm :global(.motm-table tr.win td) { font-weight: 700; color: var(--red-text); }
  .ctl-motm :global(.motm-bar) { display: inline-block; width: 80px; height: 8px; margin-right: 8px; border-radius: 4px; background: linear-gradient(90deg, var(--red) var(--w), var(--d3) var(--w)); vertical-align: middle; }
  .mce-check { border: 1px solid var(--d4); border-radius: 14px; padding: 18px 20px; margin: 0 0 22px; background: #fff; }
  .mce-check h2 { margin: 0 0 6px; font: 400 26px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .chk-note { font-size: 14px; margin: 0 0 12px; }
  .chk-list { list-style: none; margin: 0; padding: 0; }
  .chk-list :global(li) { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--d4); flex-wrap: wrap; }
  .chk-list :global(.chk-tick) { width: 26px; height: 26px; flex-shrink: 0; border-radius: 50%; border: 2px solid var(--d4); display: inline-flex; align-items: center; justify-content: center; font-weight: 700; color: #fff; }
  .chk-list :global(li.done .chk-tick) { background: #17643A; border-color: #17643A; }
  .chk-list :global(.chk-main) { flex: 1; min-width: 200px; }
  .chk-list :global(.chk-main a) { color: var(--red-text); font-weight: 600; }
  .chk-list :global(.chk-create) { padding: 7px 12px !important; font-size: 12px !important; }
  .mce-set { min-width: 0; border: 1px solid var(--d4); border-radius: 12px; padding: 18px 20px 6px; margin: 0 0 18px; }
  .mce-set legend { padding: 0 8px; font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; color: var(--gold-text); }
  .mce-hint { margin: 0 0 12px; font-size: 14px; }
  .mce-row3 { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 14px; }
  .mce-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14px; }
  .mce-quick { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0 14px; }
  .mce-quick .btn-o { padding: 9px 14px; font-size: 12px; }
  .mce :global(.tl-row) { display: grid; grid-template-columns: 70px 120px 120px 1fr 1fr 40px; gap: 8px; margin-bottom: 8px; }
  .mce :global(.tl-row .form-inp), .mce :global(.tl-row .form-sel) { padding: 9px 10px; font-size: 14px; }
  .mce :global(.tl-del) { border: 1px solid var(--d4); background: #fff; border-radius: 6px; cursor: pointer; font-size: 18px; }
  .mce-stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0 18px; }
  .mce :global(.st-pair) { display: grid; grid-template-columns: 1fr 70px 70px; gap: 8px; align-items: center; margin-bottom: 12px; }
  .mce :global(.st-pair .form-inp) { padding: 9px 10px; }
  .mce-save { position: sticky; bottom: 0; padding: 14px 0; background: linear-gradient(to top, #fff 70%, rgba(255, 255, 255, 0)); }
  .mce-save .btn-p { width: 100%; padding: 16px; }
  @media (max-width: 700px) {
    .mce-row3, .mce-row2 { grid-template-columns: 1fr; }
    .mce :global(.tl-row) { grid-template-columns: 60px 1fr 1fr 36px; }
    .mce :global(.tl-row .tl-player) { grid-column: 1 / 3; }
    .mce :global(.tl-row .tl-detail) { grid-column: 3 / 5; }
  }
</style>

<script is:inline>
(function () {
  const code = sessionStorage.getItem('ls_admin_code') || '';
  const $ = id => document.getElementById(id);
  const msg = $('msg');
  const show = (text, ok) => { msg.textContent = text; msg.className = 'mce-msg ' + (ok ? 'ok' : 'err'); msg.hidden = false; };
  if (!code) { location.href = '/admin/login/?next=' + encodeURIComponent(location.pathname + location.search); return; }

  // ── Matchday content checklist ──
  let newsIndex = null;
  async function renderChecklist(m) {
    if (!newsIndex) {
      try { newsIndex = await fetch('/data/news-index.json').then(r => r.json()); } catch { newsIndex = []; }
    }
    const day = new Date(new Date(m.event_date).getTime() + 3600e3).toISOString().slice(0, 10);
    const forMatch = newsIndex.filter(n => n.matchDate === day);
    const story = type => forMatch.find(n => n.contentType === type);
    const anyLineup = [m.lineups?.home, m.lineups?.away].some(l => l && l.starting && l.starting.length);
    const vs = `${m.home_team} vs ${m.away_team}`;
    const ITEMS = [
      { type: 'Preview', when: 'MD-2 (two days before)', done: !!story('Preview') || !!(m.preview || '').trim(), title: `Preview: ${vs}`, category: 'First Team' },
      { type: 'Team News', when: 'MD-1 (day before)', done: !!story('Team News'), title: `Team news: ${vs}`, category: 'Team News' },
      { type: 'Line-ups', when: '1 hour before kick-off', done: anyLineup || !!story('Line-ups'), title: `Line-ups: ${vs}`, category: 'First Team' },
      { type: 'Live updates', when: 'During the match', done: (m.timeline || []).length > 0 || !!story('Live updates'), title: `Live: ${vs}`, category: 'First Team' },
      { type: 'Match Report', when: 'After full time', done: !!(m.report || '').trim() || !!story('Match Report'), title: `Report: ${vs}`, category: 'First Team' },
      { type: 'Highlights', when: 'After full time', done: !!(m.youtube_url || m.facebook_url) || !!story('Highlights'), title: `Highlights: ${vs}`, category: 'First Team' },
      { type: 'Reaction/Interview', when: 'After full time', done: !!story('Reaction/Interview'), title: `Reaction: ${vs}`, category: 'First Team' },
    ];
    const esc = t => String(t).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    document.getElementById('chkList').innerHTML = ITEMS.map(it => {
      const q = new URLSearchParams({ title: it.title, category: it.category, contentType: it.type, matchDate: day });
      const linked = story(it.type);
      return `<li class="${it.done ? 'done' : ''}"><span class="chk-tick" aria-hidden="true">${it.done ? '✓' : ''}</span>`
        + `<span class="chk-main"><strong>${esc(it.type)}</strong> <span class="muted">${esc(it.when)}</span>`
        + `${linked ? ` · <a href="/news/${esc(linked.slug)}/" target="_blank" rel="noopener">view story</a>` : ''}</span>`
        + `<span class="sr-only">${it.done ? 'Done' : 'Not done yet'}</span>`
        + `<a class="btn-o chk-create" href="/admin/#/collections/news/new?${q}" target="_blank" rel="noopener">Create article</a></li>`;
    }).join('');
    document.getElementById('checklist').hidden = false;
  }

  async function api(path, opts) {
    const res = await fetch(path, Object.assign({}, opts, { headers: { 'Content-Type': 'application/json', 'x-admin-code': code } }));
    const data = await res.json().catch(() => ({}));
    if (res.status === 401) { sessionStorage.removeItem('ls_admin_code'); location.href = '/admin/login/?next=' + encodeURIComponent(location.pathname + location.search); throw new Error('unauthorised'); }
    if (!res.ok) throw new Error(data.error || 'Request failed');
    return data;
  }

  const STATS = [['possession', 'Possession %'], ['shots', 'Shots'], ['shotsOnTarget', 'Shots on target'], ['corners', 'Corners'], ['fouls', 'Fouls'], ['yellowCards', 'Yellow cards'], ['redCards', 'Red cards']];
  $('stats').innerHTML = STATS.map(([k, l]) =>
    `<div class="st-pair"><label class="form-lbl" for="st-${k}-h">${l}</label>` +
    `<input class="form-inp" id="st-${k}-h" type="number" min="0" max="99" aria-label="${l} home">` +
    `<input class="form-inp" id="st-${k}-a" type="number" min="0" max="99" aria-label="${l} away"></div>`).join('');

  const TYPES = [['goal', 'Goal'], ['own-goal', 'Own goal'], ['penalty', 'Penalty goal'], ['yellow', 'Yellow card'], ['red', 'Red card'], ['sub', 'Substitution'], ['note', 'Note']];
  let current = null;

  function addRow(e) {
    e = e || {};
    const row = document.createElement('div');
    row.className = 'tl-row';
    const esc = s => String(s || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
    row.innerHTML =
      `<input class="form-inp tl-min" placeholder="Min" aria-label="Minute" value="${esc(e.minute)}">` +
      `<select class="form-sel tl-type" aria-label="Event type">${TYPES.map(([v, l]) => `<option value="${v}"${v === e.type ? ' selected' : ''}>${l}</option>`).join('')}</select>` +
      `<select class="form-sel tl-team" aria-label="Team"><option value="">—</option><option value="home"${e.team === 'home' ? ' selected' : ''}>${esc(current ? current.home_team : 'Home')}</option><option value="away"${e.team === 'away' ? ' selected' : ''}>${esc(current ? current.away_team : 'Away')}</option></select>` +
      `<input class="form-inp tl-player" placeholder="Player" aria-label="Player" value="${esc(e.player)}">` +
      `<input class="form-inp tl-detail" placeholder="Detail (e.g. assist, 'on for X')" aria-label="Detail" value="${esc(e.detail)}">` +
      `<button type="button" class="tl-del" aria-label="Remove this event">&times;</button>`;
    row.querySelector('.tl-del').addEventListener('click', () => row.remove());
    $('timeline').append(row);
    return row;
  }
  document.querySelectorAll('[data-add]').forEach(b => b.addEventListener('click', () => {
    const r = addRow({ type: b.dataset.add, team: 'home' });
    r.querySelector('.tl-min').focus();
  }));

  const lines = s => s.split('\n').map(x => x.trim()).filter(Boolean);
  const num = v => v === '' ? null : Number(v);

  function fill(m) {
    current = m;
    document.querySelectorAll('[data-home]').forEach(e => { e.textContent = m.home_team; });
    document.querySelectorAll('[data-away]').forEach(e => { e.textContent = m.away_team; });
    $('status').value = m.status;
    $('homeScore').value = m.home_score ?? '';
    $('awayScore').value = m.away_score ?? '';
    $('preview').value = m.preview || '';
    $('ytUrl').value = m.youtube_url || '';
    $('fbUrl').value = m.facebook_url || '';
    $('streamSet').hidden = !m.is_home;
    $('report').value = m.report || '';
    $('homeXI').value = m.lineups.home.starting.join('\n');
    $('awayXI').value = m.lineups.away.starting.join('\n');
    $('homeSubs').value = m.lineups.home.subs.join('\n');
    $('awaySubs').value = m.lineups.away.subs.join('\n');
    STATS.forEach(([k]) => { const v = m.stats[k] || ['', '']; $(`st-${k}-h`).value = v[0]; $(`st-${k}-a`).value = v[1]; });
    $('gallery').value = (m.gallery || []).map(g => g.caption ? `${g.url} | ${g.caption}` : g.url).join('\n');
    $('timeline').innerHTML = '';
    (m.timeline || []).forEach(addRow);
    // Squad radios
    const pos = {};
    (m.squad?.starting || []).forEach(p => { pos[p.slug] = 'starting'; });
    (m.squad?.bench || []).forEach(p => { pos[p.slug] = 'bench'; });
    document.querySelectorAll('input[data-squad]').forEach(r => { r.checked = (pos[r.dataset.squad] || '') === r.value; });
    countSquad();
    renderControl(m);
    renderChecklist(m);
    $('viewLink').href = `/matches/${m.slug}/`;
    $('viewLink').hidden = false;
    $('mcForm').hidden = false;
  }

  function squadSelection() {
    const out = { starting: [], bench: [] };
    document.querySelectorAll('input[data-squad]:checked').forEach(r => { if (r.value) out[r.value].push(r.dataset.squad); });
    return out;
  }
  function countSquad() {
    const s = squadSelection();
    const el = $('squadCount');
    if (el) el.textContent = `Selected: ${s.starting.length} starting, ${s.bench.length} on the bench.`;
  }
  document.querySelectorAll('input[data-squad]').forEach(r => r.addEventListener('change', countSquad));

  const fmtWat = iso => iso ? new Date(iso).toLocaleString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Lagos' }) + ' WAT' : '–';
  function renderControl(m) {
    $('control').hidden = false;
    const home = !!m.is_home;
    $('ctlAway').hidden = home;
    $('ctlHome').hidden = !home;
    $('squadSet').hidden = !home;
    const badge = $('ctlBadge');
    const live = m.status === 'live' || m.status === 'half-time';
    badge.textContent = live ? 'Live' : m.status === 'full-time' ? 'Full time' : m.status === 'postponed' ? 'Postponed' : m.status === 'cancelled' ? 'Cancelled' : 'Upcoming';
    badge.className = 'ctl-badge' + (live ? ' live' : m.status === 'full-time' ? ' ft' : '');
    $('ctlSched').textContent = fmtWat(m.event_date);
    $('ctlKick').textContent = m.kickoff_at ? fmtWat(m.kickoff_at) : 'Not started';
    $('ctlEnd').textContent = m.ended_at ? fmtWat(m.ended_at) : '–';
    const auto = $('ctlAuto');
    auto.hidden = !m.auto_closed;
    if (m.auto_closed) auto.textContent = m.home_score === null
      ? 'This match closed automatically 2h15 after kick-off. Press "End Match" to enter the final score.'
      : 'This match closed automatically 2h15 after kick-off.';
    $('kickoffBtn').disabled = live || m.status === 'full-time' || m.status === 'cancelled';
    $('fulltimeBtn').disabled = !(live || (m.status === 'full-time' && m.home_score === null));
    if (home) loadMotm(m);
    if (m.status === 'full-time' && m.home_score !== null) $('fulltimeBtn').textContent = '✓ Full-time recorded';
    else $('fulltimeBtn').textContent = '■ End Match (Full-time)';
  }

  async function loadMotm(m) {
    $('motmCsv').href = `/api/admin/motm/${encodeURIComponent(m.id)}?format=csv`;
    const box = $('motmBox');
    try {
      const d = await api(`/api/admin/motm/${encodeURIComponent(m.id)}`);
      if (!d.rows.length) { box.innerHTML = '<p class="muted">No squad picked and no votes yet.</p>'; return; }
      const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      box.innerHTML = `<p><strong>${d.total}</strong> vote${d.total === 1 ? '' : 's'}${d.winners.length ? ` &middot; Leading: ${esc(d.rows.filter(r => r.winner).map(r => r.name).join(' & '))}` : ''}</p>` +
        '<div class="sq-scroll"><table class="motm-table"><thead><tr><th>Player</th><th>Votes</th><th>%</th></tr></thead><tbody>' +
        d.rows.map(r => `<tr${r.winner ? ' class="win"' : ''}><td>${r.number != null ? '#' + esc(r.number) + ' ' : ''}${esc(r.name)}</td><td>${r.votes}</td><td><span class="motm-bar" style="--w:${r.pct}%"></span>${r.pct}%</td></tr>`).join('') +
        '</tbody></table></div>';
    } catch (err) { box.innerHTML = `<p class="muted">${err.message}</p>`; }
  }

  $('kickoffBtn').addEventListener('click', async () => {
    if (!current || !confirm(`Start ${current.home_team} vs ${current.away_team} now? This opens Man of the Match voting.`)) return;
    try {
      await api(`/api/admin/match-centre/${encodeURIComponent(current.id)}`, { method: 'POST', body: JSON.stringify({ action: 'kickoff' }) });
      show('Kick-off recorded. The match is LIVE and voting is open.', true);
      await open(current.id);
    } catch (err) { show(err.message, false); }
  });
  const ftDialog = $('ftDialog');
  $('fulltimeBtn').addEventListener('click', () => {
    if (!current) return;
    $('ftHome').value = current.home_score ?? ''; $('ftAway').value = current.away_score ?? '';
    $('ftErr').hidden = true;
    ftDialog.showModal(); $('ftHome').focus();
  });
  $('ftCancel').addEventListener('click', () => ftDialog.close());
  $('ftForm').addEventListener('submit', async e => {
    e.preventDefault();
    const h = $('ftHome').value, a = $('ftAway').value;
    if (h === '' || a === '') { $('ftErr').textContent = 'Please enter both scores.'; $('ftErr').hidden = false; return; }
    $('ftConfirm').disabled = true;
    try {
      const r = await api(`/api/admin/match-centre/${encodeURIComponent(current.id)}`, { method: 'POST', body: JSON.stringify({ action: 'fulltime', home_score: Number(h), away_score: Number(a) }) });
      ftDialog.close();
      const done = `Full-time recorded: ${current.home_team} ${h} – ${a} ${current.away_team}. Voting is closed.`;
      const pw = !current.is_home ? '' : r.predictionWinner ? ' Predict & Win: we have a winner (see the Predict & Win page).' : ' Predict & Win: no correct prediction this time.';
      // open() clears the message, so show it afterwards.
      await open(current.id);
      show(done + pw, true);
    } catch (err) { $('ftErr').textContent = err.message; $('ftErr').hidden = false; }
    finally { $('ftConfirm').disabled = false; }
  });

  async function open(id) {
    msg.hidden = true;
    if (!id) { $('mcForm').hidden = true; $('viewLink').hidden = true; return; }
    const { match } = await api(`/api/admin/match-centre/${encodeURIComponent(id)}`);
    fill(match);
    history.replaceState(null, '', `?id=${encodeURIComponent(id)}`);
  }

  $('matchSel').addEventListener('change', e => open(e.target.value).catch(err => show(err.message, false)));

  $('mcForm').addEventListener('submit', async e => {
    e.preventDefault();
    if (!current) return;
    const stats = {};
    STATS.forEach(([k]) => { const h = $(`st-${k}-h`).value, a = $(`st-${k}-a`).value; if (h !== '' || a !== '') stats[k] = [num(h) || 0, num(a) || 0]; });
    const body = {
      status: $('status').value,
      home_score: num($('homeScore').value), away_score: num($('awayScore').value),
      preview: $('preview').value, report: $('report').value,
      youtube_url: $('ytUrl').value.trim(), facebook_url: $('fbUrl').value.trim(),
      lineups: { home: { starting: lines($('homeXI').value), subs: lines($('homeSubs').value) },
                 away: { starting: lines($('awayXI').value), subs: lines($('awaySubs').value) } },
      timeline: [...document.querySelectorAll('.tl-row')].map(r => ({
        minute: r.querySelector('.tl-min').value.trim(), type: r.querySelector('.tl-type').value,
        team: r.querySelector('.tl-team').value, player: r.querySelector('.tl-player').value.trim(),
        detail: r.querySelector('.tl-detail').value.trim(),
      })),
      stats,
      gallery: lines($('gallery').value).map(l => { const [url, ...cap] = l.split('|'); return { url: url.trim(), caption: cap.join('|').trim() }; }),
      squad: squadSelection(),
    };
    const btn = $('saveBtn');
    btn.disabled = true; btn.textContent = 'Saving…';
    try {
      await api(`/api/admin/match-centre/${encodeURIComponent(current.id)}`, { method: 'PUT', body: JSON.stringify(body) });
      show('Saved. The public Match Centre is updated.', true);
      await open(current.id);
    } catch (err) { show(err.message, false); }
    finally { btn.disabled = false; btn.textContent = 'Save Match Centre'; }
  });

  (async () => {
    try {
      const { events } = await api('/api/admin/events');
      const sel = $('matchSel');
      sel.innerHTML = '<option value="">Choose a match…</option>' + events.map(e => {
        const d = new Date(e.event_date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Africa/Lagos' });
        const t = `${d} — ${e.home_team} vs ${e.away_team}`.replace(/</g, '&lt;');
        return `<option value="${e.id}">${t}</option>`;
      }).join('');
      const want = new URLSearchParams(location.search).get('id');
      if (want) { sel.value = want; await open(want); }
    } catch (err) { if (err.message !== 'unauthorised') show(err.message, false); }
  })();
})();
</script>
