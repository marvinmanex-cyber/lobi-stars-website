---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
---
<Layout title="Analytics | Lobi Stars Admin" description="Lobi Stars FC website analytics." noindex>
  <div class="wrap ad">
    <AdminNav current="analytics" />
    <div class="stag">Admin</div>
    <h1 class="stitle">Website <span class="r">Analytics</span></h1>
    <p class="muted ad-lede">
      All times are Nigerian time (WAT). No IP addresses are stored. Visitors who reject cookies are counted as
      page views only, and staff who are signed in are never counted.
    </p>

    <div class="ad-bar">
      <div class="ad-range" role="group" aria-label="Date range">
        <button type="button" data-range="today">Today</button>
        <button type="button" data-range="7d">7 days</button>
        <button type="button" data-range="30d" class="on">30 days</button>
        <button type="button" data-range="season">This season</button>
        <button type="button" data-range="custom">Custom</button>
      </div>
      <form class="ad-custom" id="customForm" hidden>
        <label>From <input type="date" id="from" required /></label>
        <label>To <input type="date" id="to" required /></label>
        <button type="submit" class="btn-o sm">Apply</button>
      </form>
      <span class="ad-label" id="rangeLabel"></span>
    </div>
    <p class="ad-err" id="err" role="alert" hidden></p>

    <section class="kpis" id="kpis" aria-label="Key figures"></section>

    <section class="panel">
      <div class="ph"><h2>Where our contacts come from</h2></div>
      <p class="muted small">Share of all contacts in the fan database that came through each source. One person can come through several sources (for example, a ticket buyer who also joined the newsletter), so these can add up to more than 100%.</p>
      <div class="src-cards" id="srcCards"></div>
      <div class="two">
        <div>
          <h3>First source</h3>
          <p class="muted small">How each person first reached us. This one always adds up to 100%.</p>
          <div class="chart sq"><canvas id="firstTouch" aria-label="First source chart"></canvas></div>
        </div>
        <div>
          <h3>Devices</h3>
          <p class="muted small">Page views by device type.</p>
          <div class="chart sq"><canvas id="devices" aria-label="Devices chart"></canvas></div>
        </div>
      </div>
    </section>

    <section class="panel">
      <div class="ph"><h2>Page views and visitors</h2></div>
      <div class="chart"><canvas id="daily" aria-label="Page views and visitors per day"></canvas></div>
    </section>

    <section class="panel">
      <div class="ph"><h2>Traffic sources</h2></div>
      <p class="muted small">Where visitors clicked from (page views).</p>
      <div class="chart"><canvas id="traffic" aria-label="Traffic sources chart"></canvas></div>
    </section>

    <div class="two">
      <section class="panel"><div class="ph"><h2>Top 10 pages</h2></div><div id="topPages"></div></section>
      <section class="panel"><div class="ph"><h2>Top states</h2></div><div id="locations"></div></section>
    </div>

    <section class="panel">
      <div class="ph"><h2>Latest sign-ups</h2><a class="btn-o sm" href="/admin/fans">Open fan database</a></div>
      <div id="recent"></div>
    </section>

    <section class="panel">
      <div class="ph"><h2>Matchday</h2></div>
      <p class="muted small">Lobi Stars home games. MOTM votes and predictions appear once those features are switched on.</p>
      <div id="matchday"></div>
    </section>

    <section class="panel">
      <div class="ph"><h2>Partners</h2><a class="btn-p sm" id="partnerCsv" href="#">Export Partner Report (CSV)</a></div>
      <p class="muted small">Impressions = page views in the period (every page shows every partner's logo in the footer). Clicks = visits to the partner's website from ours.</p>
      <div id="partners"></div>
    </section>
  </div>
</Layout>

<style>
  .ad { max-width: 1200px; padding-top: 40px; padding-bottom: 90px; }
  .ad-lede { max-width: 760px; margin-bottom: 22px; }
  .ad-bar { display: flex; flex-wrap: wrap; gap: 12px 18px; align-items: center; margin-bottom: 20px; }
  .ad-range { display: flex; flex-wrap: wrap; gap: 6px; }
  .ad-range button { border: 1px solid var(--d4); background: #fff; border-radius: 999px; padding: 8px 14px; cursor: pointer; font: 600 14px/1 'Barlow', sans-serif; color: var(--white); }
  .ad-range button.on { background: var(--red); border-color: var(--red); color: #fff; }
  .ad-custom { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 14px; }
  .ad-custom input { padding: 6px 8px; border: 1px solid var(--d4); border-radius: 6px; font: inherit; }
  .ad-label { color: var(--lt); font-size: 14px; }
  .ad-err { background: #FDECEC; color: #A3161B; padding: 12px 16px; border-radius: 8px; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 14px; margin-bottom: 22px; }
  .kpis :global(.kpi) { background: #fff; border: 1px solid var(--d4); border-radius: 12px; padding: 16px 18px; min-width: 0; }
  .kpis :global(.kpi-l) { font: 700 12px/1.2 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; color: var(--lt); }
  .kpis :global(.kpi-v) { font: 400 40px/1.1 'Bebas Neue', sans-serif; margin: 6px 0 2px; }
  :global(.chg) { font-size: 13px; font-weight: 700; }
  :global(.chg.up) { color: #17643A; } :global(.chg.down) { color: #A3161B; } :global(.chg.flat) { color: var(--lt); }
  .panel { margin-bottom: 22px; min-width: 0; }
  .ph { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .ph h2 { margin: 0; font: 400 28px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .panel h3 { margin: 18px 0 4px; font: 700 15px/1.2 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; }
  .small { font-size: 14px; margin: 0 0 12px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .two > * { min-width: 0; }
  .chart { position: relative; height: 300px; }
  .chart.sq { height: 280px; max-width: 420px; }
  .src-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; }
  .src-cards :global(.sc) { border: 1px solid var(--d4); border-left: 4px solid var(--red); border-radius: 8px; padding: 10px 12px; }
  .src-cards :global(.sc b) { display: block; font: 400 30px/1 'Bebas Neue', sans-serif; }
  .src-cards :global(.sc span) { font-size: 13px; color: var(--lt); }
  .panel :global(.scroll) { overflow-x: auto; position: relative; }
  .panel :global(table) { width: 100%; border-collapse: collapse; font-size: 14px; }
  .panel :global(th), .panel :global(td) { padding: 9px 10px; border-bottom: 1px solid var(--d4); text-align: left; }
  .panel :global(th) { font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.2px; text-transform: uppercase; color: var(--lt); }
  .panel :global(td.n), .panel :global(th.n) { text-align: right; font-variant-numeric: tabular-nums; }
  .panel :global(td.path) { word-break: break-all; }
  .sm { padding: 8px 14px; font-size: 13px; }
  @media (max-width: 760px) {
    .two { grid-template-columns: 1fr; }
    .chart { height: 240px; }
    .kpis { grid-template-columns: 1fr 1fr; gap: 10px; }
    .kpis :global(.kpi) { padding: 12px; }
    .kpis :global(.kpi-v) { font-size: 32px; }
  }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script is:inline>
(function () {
  const code = sessionStorage.getItem('ls_admin_code') || '__session__';
  const $ = id => document.getElementById(id);
  const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const fmt = n => Number(n || 0).toLocaleString('en-NG');
  const COLORS = ['#E31E24', '#15181D', '#865C08', '#2F6FDE', '#17A05D', '#8A55D6', '#F08C1A', '#7A8088'];
  const charts = {};
  let saved = null;
  try { saved = localStorage.getItem('ls_an_range'); } catch {}
  let range = ['today', '7d', '30d', 'season'].includes(saved) ? saved : '30d', from = '', to = '';

  function change(now, prev) {
    if (!prev && !now) return '<span class="chg flat">No change</span>';
    if (!prev) return '<span class="chg up">&#9650; New</span>';
    const p = Math.round(((now - prev) / prev) * 1000) / 10;
    if (p === 0) return '<span class="chg flat">0% vs previous</span>';
    return `<span class="chg ${p > 0 ? 'up' : 'down'}">${p > 0 ? '&#9650;' : '&#9660;'} ${Math.abs(p)}% vs previous</span>`;
  }
  const table = (head, rows, empty) => rows.length
    ? `<div class="scroll"><table><thead><tr>${head.map(h => `<th class="${h.n ? 'n' : ''}">${esc(h.t)}</th>`).join('')}</tr></thead><tbody>${rows.join('')}</tbody></table></div>`
    : `<p class="muted">${esc(empty)}</p>`;
  function draw(id, config) {
    if (!window.Chart) return;
    charts[id]?.destroy();
    config.options = Object.assign({ responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }, config.options || {});
    charts[id] = new Chart($(id), config);
  }
  const fmtWat = iso => iso ? new Date(new Date(iso).getTime() + 3600000).toISOString().slice(0, 16).replace('T', ' ') : '';

  async function load() {
    const q = new URLSearchParams({ range });
    if (range === 'custom') { q.set('from', from); q.set('to', to); }
    $('partnerCsv').href = '/api/admin/partner-report?' + q;
    $('err').hidden = true;
    let d;
    try {
      const res = await fetch('/api/admin/analytics?' + q, { headers: { 'x-admin-code': code } });
      d = await res.json();
      if (!res.ok) throw new Error(d.error || 'Could not load analytics');
    } catch (e) {
      $('err').textContent = e.message; $('err').hidden = false;
      if (/admin code/i.test(e.message)) location.href = '/admin/login/?next=/admin/analytics';
      return;
    }
    $('rangeLabel').textContent = `${d.range.label} (compared with the ${d.range.days} day${d.range.days === 1 ? '' : 's'} before)`;

    const K = d.kpis;
    $('kpis').innerHTML = [
      ['Page views', K.pageViews], ['Unique visitors', K.uniqueVisitors], ['Downloads', K.downloads],
      ['Enquiries', K.enquiries], ['Total contacts', K.totalContacts], ['New contacts', K.newContacts],
    ].map(([l, k]) => `<div class="kpi"><div class="kpi-l">${l}</div><div class="kpi-v">${fmt(k.value)}</div>${change(k.value, k.previous)}</div>`).join('');

    $('srcCards').innerHTML = d.sources.map(s => `<div class="sc"><b>${s.pct}%</b><span>${esc(s.label)} &middot; ${fmt(s.contacts)}</span></div>`).join('')
      + `<div class="sc"><b>${fmt(d.totalContacts)}</b><span>Total contacts</span></div>`;

    const ft = d.firstTouch.filter(f => f.contacts > 0);
    draw('firstTouch', { type: 'doughnut', data: { labels: ft.length ? ft.map(f => f.source) : ['No contacts yet'], datasets: [{ data: ft.length ? ft.map(f => f.contacts) : [1], backgroundColor: ft.length ? COLORS : ['#E5E7EB'] }] } });
    draw('devices', { type: 'doughnut', data: { labels: d.devices.length ? d.devices.map(x => x.device) : ['No visits yet'], datasets: [{ data: d.devices.length ? d.devices.map(x => x.views) : [1], backgroundColor: d.devices.length ? COLORS : ['#E5E7EB'] }] } });
    draw('daily', {
      type: 'line',
      data: { labels: d.daily.map(x => x.day), datasets: [
        { label: 'Page views', data: d.daily.map(x => x.views), borderColor: '#E31E24', backgroundColor: 'rgba(227,30,36,.12)', fill: true, tension: .3 },
        { label: 'Unique visitors', data: d.daily.map(x => x.visitors), borderColor: '#15181D', tension: .3 },
      ] },
      options: { scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } },
    });
    const tk = Object.keys(d.traffic);
    draw('traffic', {
      type: 'bar',
      data: { labels: tk, datasets: [{ label: 'Page views', data: tk.map(k => d.traffic[k]), backgroundColor: ['#25D366', '#1877F2', '#C13584', '#15181D', '#F4B400', '#7A8088', '#865C08'] }] },
      options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } },
    });

    $('topPages').innerHTML = table([{ t: 'Page' }, { t: 'Views', n: 1 }, { t: 'Visitors', n: 1 }],
      d.topPages.map(p => `<tr><td class="path">${esc(p.path)}</td><td class="n">${fmt(p.views)}</td><td class="n">${fmt(p.visitors)}</td></tr>`), 'No page views in this period.');
    $('locations').innerHTML = table([{ t: 'State' }, { t: 'Country' }, { t: 'Views', n: 1 }],
      d.locations.map(l => `<tr><td>${esc(l.region)}</td><td>${esc(l.country)}</td><td class="n">${fmt(l.views)}</td></tr>`), 'No page views in this period.');
    $('recent').innerHTML = table([{ t: 'Name' }, { t: 'Source' }, { t: 'When (WAT)' }],
      d.recentSignups.map(s => `<tr><td>${esc(s.name)}</td><td>${esc(s.source)}</td><td>${esc(fmtWat(s.at))}</td></tr>`), 'No contacts yet.');
    $('matchday').innerHTML = table([{ t: 'Match' }, { t: 'Date' }, { t: 'Live page visitors', n: 1 }, { t: 'Watch clicks', n: 1 }, { t: 'Commentary clicks', n: 1 }, { t: 'MOTM votes', n: 1 }, { t: 'Predictions', n: 1 }],
      d.matchday.map(m => `<tr><td>${esc(m.match)}</td><td>${esc(fmtWat(m.date))}</td><td class="n">${fmt(m.liveViewers)}</td><td class="n">${fmt(m.watchPlays)}</td><td class="n">${fmt(m.commentaryClicks)}</td><td class="n">${fmt(m.votes)}</td><td class="n">${fmt(m.predictions)}</td></tr>`), 'No home games yet.');
    $('partners').innerHTML = table([{ t: 'Partner' }, { t: 'Tier' }, { t: 'Impressions', n: 1 }, { t: 'Clicks', n: 1 }, { t: 'Click rate', n: 1 }],
      d.partners.map(p => `<tr><td>${esc(p.name)}</td><td>${esc(p.tier)}</td><td class="n">${fmt(d.partnerImpressions)}</td><td class="n">${fmt(p.clicks)}</td><td class="n">${d.partnerImpressions ? ((p.clicks / d.partnerImpressions) * 100).toFixed(2) : '0.00'}%</td></tr>`), 'No partners found.');
  }

  document.querySelectorAll('[data-range]').forEach(b => b.addEventListener('click', () => {
    document.querySelectorAll('[data-range]').forEach(x => x.classList.toggle('on', x === b));
    $('customForm').hidden = b.dataset.range !== 'custom';
    if (b.dataset.range === 'custom') { $('from').focus(); return; }
    range = b.dataset.range;
    try { localStorage.setItem('ls_an_range', range); } catch {}
    load();
  }));
  $('customForm').addEventListener('submit', e => { e.preventDefault(); range = 'custom'; from = $('from').value; to = $('to').value; load(); });
  document.querySelectorAll('[data-range]').forEach(x => x.classList.toggle('on', x.dataset.range === range));
  load();
})();
</script>
