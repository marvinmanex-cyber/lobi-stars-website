---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Visitor Analytics | Lobi Stars Admin">
  <div class="wrap admin-wrap">
    <div class="admin-nav">
      <a href="/" class="an-back">&larr; Back to site</a>
      <a href="/admin/">Content CMS</a>
      <a href="/admin/matches">Manage matches</a>
    </div>
    <div class="stag">Admin</div>
    <h1 class="stitle">Visitor <span class="r">Analytics</span></h1>
    <p class="admin-lede">
      First-party traffic for this site. No IP addresses or personal data are stored &mdash;
      visitors are counted with a random id kept in their own browser. Staff areas
      (<code>/admin</code>, <code>/scan</code>) are never tracked.
    </p>

    <!-- Passcode gate -->
    <div id="gate" class="gate-card">
      <div class="gate-icon">&#128274;</div>
      <h2>Admin access</h2>
      <p class="muted">Enter the admin code to view analytics.</p>
      <input id="code" type="password" placeholder="Admin code" autocomplete="off" />
      <button id="unlock" class="btn-p">Unlock</button>
      <div id="gate-err" class="gate-err"></div>
    </div>

    <!-- Dashboard -->
    <div id="dash" hidden>
      <div class="dash-bar">
        <div class="range" role="group" aria-label="Date range">
          <button data-days="7">7 days</button>
          <button data-days="30" class="on">30 days</button>
          <button data-days="90">90 days</button>
        </div>
        <div class="dash-bar-actions">
          <span id="updated" class="updated"></span>
          <button id="refresh" class="btn-o sm">Refresh</button>
          <button id="lock-btn" class="btn-o sm">Lock</button>
        </div>
      </div>

      <div id="err" class="dash-err" hidden></div>

      <div id="cards" class="cards"></div>

      <section class="panel">
        <div class="panel-head">
          <h3>Page views per day</h3>
          <div id="chart-legend" class="legend"></div>
        </div>
        <div id="chart" class="chart"></div>
      </section>

      <div class="two-col">
        <section class="panel">
          <div class="panel-head"><h3>Top pages</h3></div>
          <div id="pages"></div>
        </section>
        <section class="panel">
          <div class="panel-head"><h3>Traffic sources</h3></div>
          <div id="refs"></div>
        </section>
      </div>

      <div class="two-col">
        <section class="panel">
          <div class="panel-head"><h3>Countries</h3></div>
          <div id="countries"></div>
        </section>
        <section class="panel">
          <div class="panel-head"><h3>Devices</h3></div>
          <div id="devices"></div>
        </section>
      </div>
    </div>
  </div>

  <style is:global>
    .admin-wrap{max-width:1060px;padding-top:112px;padding-bottom:90px;min-height:78vh;}
    .admin-nav{display:flex;gap:20px;flex-wrap:wrap;font-family:'Barlow Condensed',sans-serif;
      font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:26px;}
    .admin-nav a{color:var(--lt);text-decoration:none;transition:color .15s;}
    .admin-nav a:hover{color:var(--gold);}
    .admin-nav .an-back{color:var(--gold);}
    .admin-lede{max-width:660px;margin:6px 0 28px;font-size:14px;line-height:1.6;color:var(--lt);}
    .admin-lede code{background:var(--d3);padding:1px 6px;border-radius:4px;font-size:12px;}

    /* ---- gate ---- */
    .gate-card{max-width:400px;margin:10px 0;padding:32px 28px;text-align:center;
      background:var(--d2);border:1px solid var(--d4);border-radius:14px;box-shadow:0 18px 40px rgba(0,0,0,.14);}
    .gate-icon{font-size:30px;margin-bottom:8px;}
    .gate-card h2{font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:1px;color:var(--white);}
    .gate-card p{font-size:13px;margin:4px 0 18px;}
    .gate-card input{width:100%;padding:13px 14px;border-radius:8px;border:1px solid var(--d4);
      background:var(--d3);color:var(--white);font-size:16px;margin-bottom:14px;text-align:center;letter-spacing:2px;}
    .gate-card input:focus{outline:none;border-color:var(--gold);}
    .gate-card .btn-p{width:100%;}
    .gate-err{display:none;margin-top:12px;font-size:13px;color:var(--red);}
    .gate-err.show{display:block;}

    /* ---- dashboard chrome ---- */
    .dash-bar{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;margin-bottom:22px;}
    .dash-bar-actions{display:flex;align-items:center;gap:10px;}
    .updated{font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--lt);}
    .range button{font-family:'Barlow Condensed',sans-serif;font-size:12px;font-weight:700;letter-spacing:1px;
      text-transform:uppercase;padding:9px 18px;border:1px solid var(--d4);background:transparent;color:var(--white);cursor:pointer;}
    .range button:first-child{border-radius:6px 0 0 6px;}
    .range button:last-child{border-radius:0 6px 6px 0;}
    .range button + button{border-left:none;}
    .range button.on{background:var(--red);border-color:var(--red);color:#fff;}
    .btn-o.sm{padding:9px 16px;font-size:12px;}
    .dash-err{padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:14px;
      background:rgba(212,32,43,.14);color:var(--red);}

    /* ---- stat cards ---- */
    .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin-bottom:26px;}
    .stat{background:var(--d2);border:1px solid var(--d4);border-radius:12px;padding:18px 20px;position:relative;overflow:hidden;}
    .stat::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--gold);opacity:.5;}
    .stat.accent::before{background:var(--red);opacity:1;}
    .stat .n{font-family:'Bebas Neue',sans-serif;font-size:36px;line-height:1;color:var(--white);}
    .stat .l{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--lt);margin-top:8px;}
    .stat .sub{font-size:11px;color:var(--lt);margin-top:4px;}

    /* ---- panels ---- */
    .panel{background:var(--d2);border:1px solid var(--d4);border-radius:14px;padding:20px 22px;margin-bottom:20px;}
    .panel-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;}
    .panel-head h3{font-family:'Barlow Condensed',sans-serif;font-size:13px;font-weight:700;
      letter-spacing:3px;text-transform:uppercase;color:var(--gold);}
    .legend{font-size:11px;color:var(--lt);letter-spacing:.5px;}

    /* ---- chart ---- */
    .chart{width:100%;}
    .chart svg{width:100%;height:auto;max-height:300px;display:block;overflow:visible;}
    .chart .grid line{stroke:var(--d4);stroke-width:1;}
    .chart .ylab{fill:var(--lt);font-size:10px;font-family:'Barlow',sans-serif;}
    .chart .xlab{fill:var(--lt);font-size:10px;font-family:'Barlow',sans-serif;text-anchor:middle;}
    .chart .bar{fill:var(--red);}
    .chart .bar:hover{fill:var(--gold);}
    .chart .area{fill:rgba(227,30,36,.12);}
    .chart .line{fill:none;stroke:var(--red);stroke-width:2;}
    .chart .empty{fill:var(--lt);font-size:12px;font-family:'Barlow',sans-serif;text-anchor:middle;}

    /* ---- data tables ---- */
    .dtable{width:100%;border-collapse:collapse;font-size:13px;}
    .dtable th{text-align:left;font-family:'Barlow Condensed',sans-serif;font-size:10px;letter-spacing:1.5px;
      text-transform:uppercase;color:var(--lt);padding:0 12px 8px;font-weight:700;}
    .dtable th:last-child{text-align:right;}
    .dtable td{padding:10px 12px;border-top:1px solid var(--d4);color:var(--white);vertical-align:middle;}
    .dtable td.rank{color:var(--lt);width:22px;font-family:'Bebas Neue',sans-serif;font-size:15px;}
    .dtable td.key{max-width:1px;width:100%;}
    .dtable td.key .kbar{position:relative;display:block;border-radius:4px;overflow:hidden;padding:6px 8px;}
    .dtable td.key .kbar .fill{position:absolute;left:0;top:0;bottom:0;background:rgba(227,30,36,.14);}
    .dtable td.key .kbar span{position:relative;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block;}
    .dtable td.val{text-align:right;font-weight:700;white-space:nowrap;color:var(--white);}
    .dtable td.val small{color:var(--lt);font-weight:400;margin-left:6px;}
    .dt-empty{padding:18px 12px;font-size:13px;color:var(--lt);}

    .two-col{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
    @media(max-width:820px){ .two-col{grid-template-columns:1fr;} }
    @media(max-width:520px){ .cards{grid-template-columns:1fr 1fr;} }
  </style>

  <script is:inline>
  (function () {
    let code = sessionStorage.getItem('ls_admin_code') || '';
    let days = 30;

    const $ = id => document.getElementById(id);
    const gate = $('gate'), dash = $('dash'), gateErr = $('gate-err'), err = $('err');

    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, c =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }
    const num = n => Number(n || 0).toLocaleString();

    async function api(path) {
      const res = await fetch(path, { headers: { 'x-admin-code': code } });
      if (res.status === 401) {
        sessionStorage.removeItem('ls_admin_code');
        code = '';
        dash.hidden = true;
        gate.style.display = '';
        gateErr.textContent = 'Code rejected — enter it again.';
        gateErr.classList.add('show');
        throw new Error('unauthorised');
      }
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || ('Request failed (' + res.status + ')'));
      return data;
    }

    function statCard(n, l, opts) {
      opts = opts || {};
      return '<div class="stat' + (opts.accent ? ' accent' : '') + '">' +
        '<div class="n">' + num(n) + '</div>' +
        '<div class="l">' + esc(l) + '</div>' +
        (opts.sub ? '<div class="sub">' + esc(opts.sub) + '</div>' : '') +
        '</div>';
    }

    function renderTable(rows, head, keyFn, valFn, subFn) {
      const el = rows.el;
      if (!rows.data || !rows.data.length) {
        el.innerHTML = '<div class="dt-empty">No data in this period yet.</div>';
        return;
      }
      const max = Math.max.apply(null, rows.data.map(valFn)) || 1;
      const body = rows.data.map((r, i) => {
        const v = valFn(r);
        const pct = (v / max * 100).toFixed(1);
        const sub = subFn ? subFn(r) : null;
        return '<tr>' +
          '<td class="rank">' + (i + 1) + '</td>' +
          '<td class="key"><span class="kbar"><span class="fill" style="width:' + pct + '%"></span>' +
            '<span title="' + esc(keyFn(r)) + '">' + esc(keyFn(r)) + '</span></span></td>' +
          '<td class="val">' + num(v) + (sub != null ? '<small>' + esc(sub) + '</small>' : '') + '</td>' +
          '</tr>';
      }).join('');
      el.innerHTML = '<table class="dtable"><thead><tr><th></th><th>' + esc(head[0]) +
        '</th><th>' + esc(head[1]) + '</th></tr></thead><tbody>' + body + '</tbody></table>';
    }

    // Build a continuous day series (fills gaps with zeros) so the chart
    // always reads as a real timeline, even with one day of data.
    function fillDays(daily, n) {
      const byDay = {};
      (daily || []).forEach(d => { byDay[d.day] = d; });
      const out = [];
      const today = new Date();
      for (let i = n - 1; i >= 0; i--) {
        const dt = new Date(today.getTime() - i * 86400000);
        const key = dt.toISOString().slice(0, 10);
        const hit = byDay[key];
        out.push({ day: key, views: hit ? +hit.views : 0, visitors: hit ? +hit.visitors : 0 });
      }
      return out;
    }

    function renderChart(daily) {
      const series = fillDays(daily, days);
      const W = 1000, H = 235, padL = 34, padB = 22, padT = 10;
      const plotW = W - padL, plotH = H - padB - padT;
      const max = Math.max.apply(null, series.map(d => d.views)) || 1;
      const niceMax = max <= 4 ? max : Math.ceil(max / 5) * 5;
      const totalViews = series.reduce((s, d) => s + d.views, 0);

      if (!totalViews) {
        $('chart').innerHTML = '<svg viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="xMidYMid meet">' +
          '<text class="empty" x="' + (W / 2) + '" y="' + (H / 2) + '">No page views recorded yet in this period.</text></svg>';
        $('chart-legend').textContent = '';
        return;
      }

      const x = i => padL + (series.length === 1 ? plotW / 2 : i * plotW / (series.length - 1));
      const y = v => padT + plotH - (v / niceMax) * plotH;
      const bw = Math.max(2, Math.min(26, plotW / series.length - 3));

      let grid = '', ylabs = '';
      const steps = niceMax <= 4 ? niceMax : 4;
      for (let s = 0; s <= steps; s++) {
        const val = Math.round(niceMax * s / steps);
        const yy = y(val);
        grid += '<line x1="' + padL + '" y1="' + yy + '" x2="' + W + '" y2="' + yy + '"/>';
        ylabs += '<text class="ylab" x="' + (padL - 8) + '" y="' + (yy + 3) + '" text-anchor="end">' + val + '</text>';
      }

      const bars = series.map((d, i) => {
        const bx = x(i) - bw / 2, by = y(d.views), bh = padT + plotH - by;
        return '<rect class="bar" x="' + bx.toFixed(1) + '" y="' + by.toFixed(1) + '" width="' + bw.toFixed(1) +
          '" height="' + Math.max(0, bh).toFixed(1) + '" rx="2"><title>' + esc(d.day) + ' ' +
          num(d.views) + ' views · ' + num(d.visitors) + ' visitors</title></rect>';
      }).join('');

      const line = series.map((d, i) => (i ? 'L' : 'M') + x(i).toFixed(1) + ' ' + y(d.views).toFixed(1)).join(' ');
      const area = 'M' + x(0).toFixed(1) + ' ' + (padT + plotH) + ' ' + line.replace(/^M/, 'L') +
        ' L' + x(series.length - 1).toFixed(1) + ' ' + (padT + plotH) + ' Z';

      const nLab = Math.min(series.length, days <= 7 ? 7 : days <= 30 ? 6 : 6);
      let xlabs = '';
      for (let k = 0; k < nLab; k++) {
        const idx = Math.round(k * (series.length - 1) / (nLab - 1 || 1));
        const dt = new Date(series[idx].day + 'T00:00:00');
        const lab = dt.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
        xlabs += '<text class="xlab" x="' + x(idx).toFixed(1) + '" y="' + (H - 4) + '">' + lab + '</text>';
      }

      $('chart').innerHTML =
        '<svg viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Page views per day">' +
        '<g class="grid">' + grid + '</g>' + ylabs +
        '<path class="area" d="' + area + '"/>' +
        bars +
        '<path class="line" d="' + line + '"/>' +
        xlabs +
        '</svg>';
      $('chart-legend').textContent = num(totalViews) + ' views over ' + days + ' days';
    }

    async function load() {
      err.hidden = true;
      try {
        const d = await api('/api/admin/analytics?days=' + days);
        const avgPages = d.totals.sessions ? (d.totals.views / d.totals.sessions).toFixed(1) : '0';
        $('cards').innerHTML =
          statCard(d.totals.visitors, 'Unique visitors') +
          statCard(d.totals.views, 'Page views') +
          statCard(d.totals.sessions, 'Sessions', { sub: avgPages + ' pages / session' }) +
          statCard(d.today.visitors, 'Visitors today', { accent: true }) +
          statCard(d.today.views, 'Views today', { accent: true }) +
          statCard(d.newReturning.new_views, 'First-time views') +
          statCard(d.newReturning.returning_views, 'Returning views');

        renderChart(d.daily);

        renderTable({ el: $('pages'), data: d.topPages }, ['Page', 'Views'],
          r => r.path, r => r.views, r => r.visitors + ' v');
        renderTable({ el: $('refs'), data: d.referrers }, ['Source', 'Views'],
          r => r.host, r => r.views);
        renderTable({ el: $('countries'), data: d.countries }, ['Country', 'Views'],
          r => r.country, r => r.views, r => r.visitors + ' v');
        renderTable({ el: $('devices'), data: d.devices }, ['Device', 'Views'],
          r => r.device, r => r.views);

        $('updated').textContent = 'Updated ' + new Date().toLocaleTimeString('en-US',
          { hour: 'numeric', minute: '2-digit' });
      } catch (e) {
        if (e.message !== 'unauthorised') { err.textContent = e.message; err.hidden = false; }
      }
    }

    document.querySelectorAll('.range button').forEach(b => {
      b.addEventListener('click', () => {
        document.querySelectorAll('.range button').forEach(x => x.classList.remove('on'));
        b.classList.add('on');
        days = parseInt(b.dataset.days, 10);
        load();
      });
    });
    $('refresh').addEventListener('click', load);

    async function unlock() {
      const entered = $('code').value.trim();
      if (!entered) return;
      code = entered;
      try {
        await api('/api/admin/analytics?days=7');
        sessionStorage.setItem('ls_admin_code', code);
        gate.style.display = 'none';
        dash.hidden = false;
        gateErr.classList.remove('show');
        load();
      } catch (e) {
        if (e.message !== 'unauthorised') { gateErr.textContent = e.message; gateErr.classList.add('show'); }
      }
    }
    $('unlock').addEventListener('click', unlock);
    $('code').addEventListener('keydown', e => { if (e.key === 'Enter') unlock(); });
    $('lock-btn').addEventListener('click', () => {
      sessionStorage.removeItem('ls_admin_code');
      location.reload();
    });

    if (code) {
      gate.style.display = 'none';
      dash.hidden = false;
      load();
    }
  })();
  </script>
</Layout>
