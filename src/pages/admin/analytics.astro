---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
---
<Layout title="Analytics | Lobi Stars Admin" description="Lobi Stars FC website analytics." noindex>
  <div class="wrap ad">
    <AdminNav current="analytics" />
    <div class="stag">Admin</div>
    <h1 class="stitle">Website <span class="r">Analytics</span></h1>
    <p class="muted ad-lede">
      All times are Nigerian time. No IP addresses are stored. Visitors who reject cookies are counted as
      page views only, and staff who are signed in are never counted.
    </p>

    <div class="ad-bar">
      <div class="ad-range" role="group" aria-label="Date range">
        <button type="button" data-range="today">Today</button>
        <button type="button" data-range="7d">7 days</button>
        <button type="button" data-range="30d" class="on">30 days</button>
        <button type="button" data-range="season">This season</button>
        <button type="button" data-range="custom">Custom</button>
      </div>
      <form class="ad-custom" id="customForm" hidden>
        <label>From <input type="date" id="from" required /></label>
        <label>To <input type="date" id="to" required /></label>
        <button type="submit" class="btn-o sm">Apply</button>
      </form>
      <span class="ad-label" id="rangeLabel"></span>
    </div>
    <div class="dl-top" role="group" aria-label="Download and present">
      <span class="dl-top-l">Download &amp; present:</span>
      <button type="button" class="btn-p sm" id="dlXlsx">&#128202; Excel (all data)</button>
      <button type="button" class="btn-o sm" id="dlPptx">&#128253; PowerPoint slides</button>
      <button type="button" class="btn-o sm" id="dlPrint">&#128424; Print / PDF</button>
      <span class="gs-status" id="dlMsg" role="status"></span>
    </div>
    <p class="ad-err" id="err" role="alert" hidden></p>

    <section class="kpis" id="kpis" aria-label="Key figures"></section>

    <section class="panel recs" id="sec-recs" hidden>
      <div class="ph"><h2>&#128161; Recommendations</h2><span class="gs-status" id="recWhen"></span><a class="btn-o sm" id="aiFixLink" href="/admin/ai/" hidden>&#129302; Fix with AI</a></div>
      <p class="muted small">The website looks at Google search, Google Analytics and its own figures for the <b>last 28 days</b> (compared with the 28 days before), and suggests what to do next. Open a card for a step-by-step guide. "Mark as done" hides it for 30 days.</p>
      <div id="recAi"></div>
      <div class="rec-glance" id="recGlance"></div>
      <div class="rec-list" id="recList"></div>
      <details class="rec-done" id="recDoneWrap" hidden><summary id="recDoneSum"></summary><div id="recDone"></div></details>
    </section>

    <section class="panel" id="sec-sources">
      <div class="ph"><h2>Where our contacts come from</h2></div>
      <p class="muted small">Share of all contacts in the fan database that came through each source. One person can come through several sources (for example, a ticket buyer who also joined the newsletter), so these can add up to more than 100%.</p>
      <div class="src-cards" id="srcCards"></div>
      <div class="two">
        <div>
          <h3>First source</h3>
          <p class="muted small">How each person first reached us. This one always adds up to 100%.</p>
          <div class="chart sq"><canvas id="firstTouch" aria-label="First source chart"></canvas></div>
        </div>
        <div>
          <h3>Devices</h3>
          <p class="muted small">Page views by device type.</p>
          <div class="chart sq"><canvas id="devices" aria-label="Devices chart"></canvas></div>
        </div>
      </div>
    </section>

    <section class="panel">
      <div class="ph"><h2>Page views and visitors</h2></div>
      <div class="chart"><canvas id="daily" aria-label="Page views and visitors per day"></canvas></div>
    </section>

    <section class="panel">
      <div class="ph"><h2>Traffic sources</h2></div>
      <p class="muted small">Where visitors clicked from (page views).</p>
      <div class="chart"><canvas id="traffic" aria-label="Traffic sources chart"></canvas></div>
    </section>

    <section class="panel gs" id="sec-google" hidden>
      <div class="ph">
        <h2>Google &amp; Search</h2>
        <div class="gs-act"><span class="gs-status" id="gsStatus" role="status"></span><button type="button" class="btn-o sm" id="gsSync">Sync now</button></div>
      </div>
      <p class="muted small">From Google Search Console (how the club shows up in Google search) and Google Analytics 4 (visitors who accepted cookies), copied every morning. Google adds search figures 2&ndash;3 days late, so the last days of a period are usually low.</p>
      <div id="gsNote"></div>
      <h3>Google search</h3>
      <div class="kpis" id="gsKpis"></div>
      <h3>Google Analytics 4</h3>
      <div class="kpis" id="gaKpis"></div>
      <h3>Day by day: all sources</h3>
      <p class="muted small">Page views (the website's own counting, everyone), GA4 sessions (only visitors who accepted cookies), and clicks and appearances in Google search.</p>
      <div class="chart"><canvas id="gsDaily" aria-label="Page views, GA4 sessions and Google search per day"></canvas></div>
      <div class="three">
        <div><h3>How visitors arrived (GA4)</h3><p class="muted small">Sessions by channel.</p><div class="chart sq"><canvas id="gaChannels" aria-label="GA4 sessions by channel"></canvas></div></div>
        <div><h3>Google search by device</h3><p class="muted small">Appearances in Google.</p><div class="chart sq"><canvas id="gsDevicesChart" aria-label="Google search appearances by device"></canvas></div></div>
        <div><h3>GA4 visits by device</h3><p class="muted small">Sessions.</p><div class="chart sq"><canvas id="gaDevicesChart" aria-label="GA4 sessions by device"></canvas></div></div>
      </div>
      <h3>Top search phrases</h3>
      <p class="muted small">What people typed in Google before seeing the club. Google hides rare phrases.</p>
      <div class="chart tall"><canvas id="gsQueriesChart" aria-label="Top search phrases: clicks and appearances"></canvas></div>
      <div id="gsQueries"></div>
      <h3>Pages: search, visits and views</h3>
      <p class="muted small">Each page with its Google search clicks and appearances, average position in Google (1 = top), GA4 sessions and the website's own page views.</p>
      <div class="chart tall"><canvas id="gsPagesChart" aria-label="Top pages: search clicks, GA4 sessions and page views"></canvas></div>
      <div id="gsPages"></div>
      <h3>Key events (GA4): this period and the one before</h3>
      <div class="chart"><canvas id="gaEventsChart" aria-label="Key events this period and the period before"></canvas></div>
      <div class="two">
        <div><h3>Key events (GA4)</h3><div id="gaEvents"></div></div>
        <div><h3>Google search by country</h3><div class="chart sq"><canvas id="gsCountriesChart" aria-label="Google search appearances by country"></canvas></div><div id="gsCountries"></div></div>
      </div>
    </section>

    <div class="two">
      <section class="panel"><div class="ph"><h2>Top 10 pages</h2></div><div class="chart"><canvas id="topPagesChart" aria-label="Top 10 pages by views"></canvas></div><div id="topPages"></div></section>
      <section class="panel"><div class="ph"><h2>Top states</h2></div><div class="chart"><canvas id="locationsChart" aria-label="Top states by views"></canvas></div><div id="locations"></div></section>
    </div>

    <section class="panel">
      <div class="ph"><h2>Latest sign-ups</h2><a class="btn-o sm" href="/admin/fans">Open fan database</a></div>
      <div id="recent"></div>
    </section>

    <section class="panel" id="sec-matchday">
      <div class="ph"><h2>Matchday</h2></div>
      <p class="muted small">Lobi Stars home games. MOTM votes and predictions appear once those features are switched on.</p>
      <div id="matchday"></div>
    </section>

    <section class="panel" id="sec-commentary">
      <div class="ph"><h2>Lobi Stars FC Live (commentary)</h2><a class="btn-o sm" id="broadcastCsv" href="#">Broadcast Report (CSV)</a></div>
      <p class="muted small">Listens = presses of Play. Unique listeners = listening sessions. Peak = most people listening at the same time.</p>
      <div id="broadcast"></div>
    </section>

    <section class="panel" id="sec-partners">
      <div class="ph"><h2>Partners</h2><a class="btn-p sm" id="partnerCsv" href="#">Export Partner Report (CSV)</a></div>
      <p class="muted small">Impressions = page views in the period (every page shows every partner's logo in the footer). Clicks = visits to the partner's website from ours.</p>
      <div id="partners"></div>
    </section>
  </div>
</Layout>

<style>
  .ad { max-width: 1200px; padding-top: 40px; padding-bottom: 90px; }
  .ad-lede { max-width: 760px; margin-bottom: 22px; }
  .ad-bar { display: flex; flex-wrap: wrap; gap: 12px 18px; align-items: center; margin-bottom: 20px; }
  .ad-range { display: flex; flex-wrap: wrap; gap: 6px; }
  .ad-range button { border: 1px solid var(--d4); background: var(--a-card); border-radius: 999px; padding: 8px 14px; cursor: pointer; font: 600 14px/1 'Barlow', sans-serif; color: var(--white); }
  .ad-range button.on { background: var(--red); border-color: var(--red); color: #fff; }
  .ad-custom { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 14px; }
  .ad-custom input { padding: 6px 8px; border: 1px solid var(--d4); border-radius: 6px; font: inherit; }
  .ad-label { color: var(--lt); font-size: 14px; }
  .ad-err { background: #FDECEC; color: #A3161B; padding: 12px 16px; border-radius: 8px; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 14px; margin-bottom: 22px; }
  .kpis :global(.kpi) { position: relative; border-radius: 16px; padding: 16px 18px; min-width: 0; background: linear-gradient(145deg, color-mix(in srgb, var(--c) 16%, var(--a-card)), var(--a-card) 72%); border: 1px solid color-mix(in srgb, var(--c) 28%, var(--a-line)); box-shadow: 0 8px 22px rgba(15,17,21,.05); }
  .kpis :global(.kpi-ic) { float: right; width: 40px; height: 40px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 19px; background: color-mix(in srgb, var(--c) 22%, var(--a-card)); }
  .kpis :global(.kpi-v) { color: color-mix(in srgb, var(--c) 80%, var(--a-ink)); }
  :global(.chg) { display: inline-block; padding: 3px 8px; border-radius: 999px; }
  :global(.chg.up) { background: color-mix(in srgb, #10B981 16%, transparent); } :global(.chg.down) { background: color-mix(in srgb, #E31E24 14%, transparent); }
  .kpis :global(.kpi-l) { font: 700 12px/1.2 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; color: var(--lt); }
  .kpis :global(.kpi-v) { font: 400 40px/1.1 'Bebas Neue', sans-serif; margin: 6px 0 2px; }
  :global(.chg) { font-size: 13px; font-weight: 700; }
  :global(.chg.up) { color: #17643A; } :global(.chg.down) { color: #A3161B; } :global(.chg.flat) { color: var(--lt); }
  .panel { margin-bottom: 22px; min-width: 0; }
  .ph { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .ph h2 { margin: 0; font: 400 28px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .panel h3 { margin: 18px 0 4px; font: 700 15px/1.2 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; }
  .small { font-size: 14px; margin: 0 0 12px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .two > * { min-width: 0; }
  .chart { position: relative; height: 300px; }
  .chart.sq { height: 280px; max-width: 420px; }
  .src-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; }
  .src-cards :global(.sc) { border: 1px solid color-mix(in srgb, var(--c, #E31E24) 30%, var(--a-line)); border-left: 5px solid var(--c, #E31E24); border-radius: 12px; padding: 10px 12px; background: color-mix(in srgb, var(--c, #E31E24) 7%, var(--a-card)); }
  .src-cards :global(.sc b) { color: color-mix(in srgb, var(--c, #E31E24) 80%, var(--a-ink)); }
  .src-cards :global(.sc b) { display: block; font: 400 30px/1 'Bebas Neue', sans-serif; }
  .src-cards :global(.sc span) { font-size: 13px; color: var(--lt); }
  .panel :global(.scroll) { overflow-x: auto; position: relative; }
  .panel :global(table) { width: 100%; border-collapse: collapse; font-size: 14px; }
  .panel :global(th), .panel :global(td) { padding: 9px 10px; border-bottom: 1px solid var(--d4); text-align: left; }
  .panel :global(th) { font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.2px; text-transform: uppercase; color: var(--lt); }
  .panel :global(td.n), .panel :global(th.n) { text-align: right; font-variant-numeric: tabular-nums; }
  .panel :global(td.path) { word-break: break-all; }
  .sm { padding: 8px 14px; font-size: 13px; }
  .gs-act { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .gs-status { font-size: 13px; color: var(--lt); }
  .gs :global(.gs-note) { border-radius: 10px; padding: 12px 14px; margin: 0 0 14px; font-size: 14px; background: color-mix(in srgb, #EAB308 14%, var(--a-card)); border: 1px solid color-mix(in srgb, #EAB308 40%, var(--a-line)); }
  .gs :global(.gs-note.bad) { background: #FDECEC; color: #A3161B; border-color: #F5B5B7; }
  .gs .kpis { margin-bottom: 8px; }
  .recs { border-radius: 18px; padding: 18px 20px; background: linear-gradient(145deg, color-mix(in srgb, #EAB308 10%, var(--a-card)), var(--a-card) 70%); border: 1px solid color-mix(in srgb, #EAB308 35%, var(--a-line)); }
  .recs :global(.rec-glance) { margin: 0 0 14px; }
  .recs :global(.rec-glance h3) { margin-top: 4px; }
  .recs :global(.rec-glance ul) { margin: 6px 0 0; padding-left: 20px; font-size: 15px; line-height: 1.5; }
  .recs :global(.rec-list) { display: grid; gap: 12px; }
  .recs :global(.rec) { border: 1px solid var(--a-line); border-left: 5px solid var(--pc, #0EA5E9); border-radius: 12px; background: var(--a-card); padding: 14px 16px; min-width: 0; }
  .recs :global(.rec-top) { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 6px; }
  .recs :global(.pill) { font: 700 11px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.2px; text-transform: uppercase; padding: 5px 9px; border-radius: 999px; background: color-mix(in srgb, var(--pc, #0EA5E9) 16%, var(--a-card)); color: color-mix(in srgb, var(--pc, #0EA5E9) 85%, var(--a-ink)); }
  .recs :global(.pill.area) { --pc: #64748B; }
  .recs :global(.rec h4) { margin: 0 0 6px; font: 700 18px/1.25 'Barlow', sans-serif; }
  .recs :global(.rec p) { margin: 0 0 8px; font-size: 14.5px; line-height: 1.5; }
  .recs :global(.rec summary) { cursor: pointer; font-weight: 700; color: var(--red); padding: 4px 0; }
  .recs :global(.rec ol) { margin: 8px 0 10px; padding-left: 22px; font-size: 14.5px; line-height: 1.55; }
  .recs :global(.rec ol li) { margin-bottom: 6px; overflow-wrap: anywhere; }
  .recs :global(.rec-act) { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px; }
  .recs :global(.rec-none) { padding: 14px; border-radius: 12px; background: color-mix(in srgb, #10B981 12%, var(--a-card)); }
  .recs :global(.rec-ai) { border-radius: 12px; padding: 12px 14px; margin-bottom: 14px; background: color-mix(in srgb, #8B5CF6 10%, var(--a-card)); border: 1px solid color-mix(in srgb, #8B5CF6 30%, var(--a-line)); font-size: 14.5px; line-height: 1.55; white-space: pre-line; }
  .recs .rec-done { margin-top: 14px; font-size: 14px; }
  .recs .rec-done summary { cursor: pointer; color: var(--lt); }
  @media (max-width: 760px) { .recs { padding: 14px 12px; } }
  .three { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; }
  .three > * { min-width: 0; }
  .chart.tall { height: 380px; }
  .dl-top { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: -6px 0 18px; }
  .dl-top-l { font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.2px; text-transform: uppercase; color: var(--lt); }
  /* Small download buttons under every chart (PNG) and table (CSV). */
  :global(.dlbar) { display: flex; justify-content: flex-end; gap: 6px; margin: 4px 0 6px; }
  :global(.dlbar button) { border: 1px solid var(--a-line); background: var(--a-card); color: var(--lt); border-radius: 999px; padding: 4px 10px; font: 600 12px/1 'Barlow', sans-serif; cursor: pointer; }
  :global(.dlbar button:hover) { color: var(--red); border-color: var(--red); }
  @media (max-width: 760px) { .chart.tall { height: 420px; } }
  /* Print / Save as PDF: a clean report (no menus or buttons, every guide open). */
  @media print {
    :global(.ash), :global(.skip-link), :global(.dlbar), .dl-top, .ad-range, .ad-custom, :global(.rec-act), .gs-act button, .recs .rec-done { display: none !important; }
    :global(body), :global(html) { background: #fff !important; }
    .ad { padding: 0; max-width: none; }
    .kpis :global(.kpi), .recs :global(.rec), .chart, .panel :global(tr) { break-inside: avoid; }
    .ph, .panel h3 { break-after: avoid; }
    .panel { margin-bottom: 14px; }
    .two, .three { grid-template-columns: 1fr 1fr; }
    .chart { height: 260px; } .chart.tall { height: 320px; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
  /* Wide tables scroll sideways on phones instead of squeezing page addresses. */
  #gsPages :global(table) { min-width: 720px; }
  #gsQueries :global(table) { min-width: 460px; }
  #gsPages :global(td.path) { word-break: normal; overflow-wrap: anywhere; min-width: 140px; }
  @media (max-width: 760px) {
    .two { grid-template-columns: 1fr; }
    .chart { height: 240px; }
    .kpis { grid-template-columns: 1fr 1fr; gap: 10px; }
    .kpis :global(.kpi) { padding: 12px; }
    .kpis :global(.kpi-v) { font-size: 32px; }
  }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script is:inline>
(function () {
  const code = sessionStorage.getItem('ls_admin_code') || '__session__';
  const $ = id => document.getElementById(id);
  const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const fmt = n => Number(n || 0).toLocaleString('en-NG');
  // Club red and gold first, then the bright admin accent palette.
  const COLORS = ['#E31E24', '#EAB308', '#10B981', '#0EA5E9', '#8B5CF6', '#F97316', '#14B8A6', '#EC4899', '#64748B'];
  let lastData = null;
  const cardColor = () => getComputedStyle(document.body).getPropertyValue('--a-card').trim() || '#fff';
  const charts = {};
  let saved = null;
  try { saved = localStorage.getItem('ls_an_range'); } catch {}
  let range = ['today', '7d', '30d', 'season'].includes(saved) ? saved : '30d', from = '', to = '';

  function change(now, prev) {
    if (!prev && !now) return '<span class="chg flat">No change</span>';
    if (!prev) return '<span class="chg up">&#9650; New</span>';
    const p = Math.round(((now - prev) / prev) * 1000) / 10;
    if (p === 0) return '<span class="chg flat">0% vs previous</span>';
    return `<span class="chg ${p > 0 ? 'up' : 'down'}">${p > 0 ? '&#9650;' : '&#9660;'} ${Math.abs(p)}% vs previous</span>`;
  }
  const table = (head, rows, empty) => rows.length
    ? `<div class="scroll"><table><thead><tr>${head.map(h => `<th class="${h.n ? 'n' : ''}">${esc(h.t)}</th>`).join('')}</tr></thead><tbody>${rows.join('')}</tbody></table></div>`
    : `<div class="empty-state"><b>📭</b><p>${esc(empty)}</p></div>`;
  function draw(id, config) {
    if (!window.Chart) return;
    charts[id]?.destroy();
    const css = getComputedStyle(document.body);
    Chart.defaults.font.family = 'Barlow, sans-serif';
    Chart.defaults.color = css.getPropertyValue('--a-muted').trim() || '#5B6472';
    Chart.defaults.borderColor = css.getPropertyValue('--a-line').trim() || '#E3E6EA';
    const base = {
      responsive: true, maintainAspectRatio: false,
      animation: { duration: 700, easing: 'easeOutQuart' },
      plugins: {
        legend: { position: 'bottom', labels: { usePointStyle: true, pointStyle: 'circle', padding: 16 } },
        tooltip: { backgroundColor: '#15181D', padding: 10, cornerRadius: 10 },
      },
    };
    const o = config.options || {};
    config.options = Object.assign({}, base, o, { plugins: Object.assign({}, base.plugins, o.plugins || {}) });
    charts[id] = new Chart($(id), config);
  }
  // Pie (doughnut) and horizontal bar helpers for the new charts.
  function pie(id, labels, values, emptyLabel) {
    const has = values.some(v => v > 0);
    draw(id, { type: 'doughnut', data: { labels: has ? labels : [emptyLabel], datasets: [{ data: has ? values : [1], backgroundColor: has ? COLORS : ['#E5E7EB'], borderWidth: 3, borderColor: cardColor(), hoverOffset: 10, borderRadius: 6 }] }, options: { cutout: '58%' } });
  }
  const short = s => (String(s).length > 34 ? String(s).slice(0, 32) + '…' : String(s));
  function hbar(id, labels, datasets, legend = true) {
    draw(id, { type: 'bar', data: { labels: labels.map(short), datasets: datasets.map(ds => Object.assign({ borderRadius: 6, borderSkipped: false, maxBarThickness: 22 }, ds)) },
      options: { indexAxis: 'y', plugins: { legend: { display: legend, position: 'bottom', labels: { usePointStyle: true, pointStyle: 'circle', padding: 16 } } }, scales: { x: { beginAtZero: true, ticks: { precision: 0 } }, y: { ticks: { autoSkip: false } } } } });
  }
  // Redraw in the right colours when someone switches light/dark mode.
  document.addEventListener('ls:theme', () => { if (lastData) render(lastData); if (lastGoogle) renderGoogle(lastGoogle); });
  const fmtWat = iso => iso ? new Date(new Date(iso).getTime() + 3600000).toISOString().slice(0, 16).replace('T', ' ') : '';

  async function load() {
    const q = new URLSearchParams({ range });
    if (range === 'custom') { q.set('from', from); q.set('to', to); }
    $('partnerCsv').href = '/api/admin/partner-report?' + q;
    $('broadcastCsv').href = '/api/admin/broadcast-report?' + q;
    $('err').hidden = true;
    loadGoogle(q);
    let d;
    try {
      const res = await fetch('/api/admin/analytics?' + q, { headers: { 'x-admin-code': code } });
      d = await res.json();
      if (!res.ok) throw new Error(d.error || 'Could not load analytics');
    } catch (e) {
      $('err').textContent = e.message; $('err').hidden = false;
      if (/admin code/i.test(e.message)) location.href = '/admin/login/?next=/admin/analytics';
      return;
    }
    lastData = d;
    render(d);
  }

  // ── Google & Search (only for staff with "All reports"; hidden otherwise) ──
  let lastGoogle = null, syncing = false, googleTried = false, recsTried = false;
  const EVENT_LABELS = {
    ticket_purchase_start: 'Ticket checkout started', ticket_purchase_complete: 'Tickets bought', kitchen_order_start: 'Food order started',
    kitchen_order_complete: 'Food orders placed', newsletter_signup: 'Newsletter sign-ups', membership_signup: 'Membership sign-ups',
    watch_live_click: 'Watch live clicks', whatsapp_channel_join_click: 'WhatsApp Channel joins', social_click: 'Social media clicks', prediction_submitted: 'Predictions sent',
  };
  const ISO3 = { nga: 'NG', gbr: 'GB', usa: 'US', gha: 'GH', can: 'CA', zaf: 'ZA', ken: 'KE', deu: 'DE', fra: 'FR', irl: 'IE', ind: 'IN', are: 'AE', cmr: 'CM', ben: 'BJ', nld: 'NL', ita: 'IT', esp: 'ES', aus: 'AU', bra: 'BR', chn: 'CN', tur: 'TR', sau: 'SA', egy: 'EG', tgo: 'TG', civ: 'CI', sen: 'SN', bel: 'BE', swe: 'SE', nor: 'NO', pol: 'PL' };
  let countryName = c => c.toUpperCase();
  try { const dn = new Intl.DisplayNames(['en'], { type: 'region' }); countryName = c => (ISO3[c] ? dn.of(ISO3[c]) : c.toUpperCase()); } catch {}
  const mins = s => `${Math.floor(s / 60)}m ${String(s % 60).padStart(2, '0')}s`;
  function kpiCard(label, now, prev, ic, color, opts = {}) {
    const show = opts.fmt ? opts.fmt(now) : fmt(now);
    let chg = change(now, prev);
    if (opts.lowerIsBetter && prev && now && now !== prev) {
      const better = now < prev, diff = Math.abs(Math.round((now - prev) * 10) / 10);
      chg = `<span class="chg ${better ? 'up' : 'down'}">${better ? '&#9650; ' + diff + ' places higher' : '&#9660; ' + diff + ' places lower'}</span>`;
    }
    return `<div class="kpi" style="--c:${color}"><span class="kpi-ic" aria-hidden="true">${ic}</span><div class="kpi-l">${label}</div><div class="kpi-v">${show}</div>${chg}</div>`;
  }

  async function loadGoogle(q) {
    try {
      const res = await fetch('/api/admin/analytics-google?' + q, { headers: { 'x-admin-code': code } });
      if (res.status === 403 || res.status === 401) { $('sec-google').hidden = true; return; }
      const g = await res.json();
      if (!res.ok) throw new Error(g.error || 'Could not load the Google figures');
      lastGoogle = g;
      $('sec-google').hidden = false;
      renderGoogle(g);
    } catch (e) {
      $('sec-google').hidden = false;
      $('gsNote').innerHTML = `<p class="gs-note bad">${esc(e.message)}</p>`;
    } finally { googleTried = true; }
  }

  function statusText(s) {
    if (s.run && !s.run.done) return `Syncing&hellip; part ${Math.min(s.run.idx + 1, s.run.tasks)} of ${s.run.tasks}`;
    if (s.lastSuccess) return `Last sync: ${esc(fmtWat(s.lastSuccess.at))} (${esc(s.lastSuccess.by)})`;
    return 'Not synced yet';
  }

  function renderGoogle(g) {
    const s = g.status;
    $('gsStatus').innerHTML = statusText(s);
    $('gsSync').disabled = syncing || (s.config.missing || []).length > 0 && !s.config.gsc && !s.config.ga4;
    const notes = [];
    if (!s.config.gsc && !s.config.ga4) notes.push(`<p class="gs-note bad">Not connected to Google yet: ${esc((s.config.missing || []).join('; '))}. See handover A27.</p>`);
    if (s.lastError && (!s.lastSuccess || s.lastError.at > s.lastSuccess.at)) notes.push(`<p class="gs-note bad">The last sync (${esc(fmtWat(s.lastError.at))}) had a problem: ${esc(s.lastError.failures.map(f => f.task + ': ' + f.error).join(' | '))}</p>`);
    if (s.hasData && !s.ga4Latest) notes.push('<p class="gs-note">No GA4 figures yet. Google needs 24&ndash;48 hours after GA4 is set up before they can be copied; the morning sync will pick them up.</p>');
    if (s.gscLatest) notes.push(`<p class="muted small">Search figures up to ${esc(s.gscLatest)}${s.ga4Latest ? `; GA4 figures up to ${esc(s.ga4Latest)}` : ''}.</p>`);
    $('gsNote').innerHTML = notes.join('');

    const G = g.gsc, A = g.ga4;
    $('gsKpis').innerHTML = [
      kpiCard('Search clicks', G.now.clicks, G.prev.clicks, '🖱️', '#0EA5E9'),
      kpiCard('Appearances in Google', G.now.impressions, G.prev.impressions, '👀', '#8B5CF6'),
      kpiCard('Click rate', G.now.ctr, G.prev.ctr, '🎯', '#10B981', { fmt: v => v + '%' }),
      kpiCard('Average position', G.now.position, G.prev.position, '🏁', '#EAB308', { fmt: v => (v ? v : '&ndash;'), lowerIsBetter: true }),
    ].join('');
    $('gaKpis').innerHTML = [
      kpiCard('Sessions', A.now.sessions, A.prev.sessions, '📲', '#E31E24'),
      kpiCard('Users (sum of days)', A.now.users, A.prev.users, '🧑‍🤝‍🧑', '#F97316'),
      kpiCard('Engagement rate', A.now.engagement, A.prev.engagement, '💬', '#14B8A6', { fmt: v => v + '%' }),
      kpiCard('Avg. session', A.now.duration, A.prev.duration, '⏱️', '#64748B', { fmt: mins }),
    ].join('');

    const dd = g.daily;
    draw('gsDaily', { type: 'bar',
      data: { labels: dd.days, datasets: [
        { type: 'line', label: 'Page views (website)', data: dd.views, borderColor: '#E31E24', backgroundColor: 'rgba(227,30,36,.10)', fill: true, tension: .35, borderWidth: 3, pointRadius: 2, spanGaps: true, yAxisID: 'y' },
        { type: 'line', label: 'GA4 sessions', data: dd.sessions, borderColor: '#F97316', tension: .35, borderWidth: 3, pointRadius: 2, spanGaps: true, yAxisID: 'y' },
        { type: 'line', label: 'Google search clicks', data: dd.clicks, borderColor: '#0EA5E9', tension: .35, borderWidth: 3, pointRadius: 2, spanGaps: true, yAxisID: 'y' },
        { type: 'bar', label: 'Appearances in Google', data: dd.impressions, backgroundColor: 'rgba(139,92,246,.22)', borderRadius: 4, yAxisID: 'y1' },
      ] },
      options: { interaction: { mode: 'index', intersect: false }, scales: {
        y: { beginAtZero: true, ticks: { precision: 0 }, title: { display: true, text: 'Views, sessions, clicks' } },
        y1: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false }, ticks: { precision: 0 }, title: { display: true, text: 'Appearances' } },
      } },
    });
    const ch = A.channels.filter(c => c.sessions > 0);
    draw('gaChannels', { type: 'doughnut', data: { labels: ch.length ? ch.map(c => c.channel) : ['No GA4 sessions yet'], datasets: [{ data: ch.length ? ch.map(c => c.sessions) : [1], backgroundColor: ch.length ? COLORS : ['#E5E7EB'], borderWidth: 3, borderColor: cardColor(), hoverOffset: 10, borderRadius: 6 }] }, options: { cutout: '62%' } });

    pie('gsDevicesChart', G.devices.map(x => x.value.charAt(0) + x.value.slice(1).toLowerCase()), G.devices.map(x => x.impressions), 'No search figures yet');
    pie('gaDevicesChart', A.devices.map(x => x.device), A.devices.map(x => x.sessions), 'No GA4 sessions yet');
    const tq = G.queries.slice(0, 10);
    hbar('gsQueriesChart', tq.map(x => x.value), [{ label: 'Clicks', data: tq.map(x => x.clicks), backgroundColor: '#0EA5E9' }, { label: 'Appearances', data: tq.map(x => x.impressions), backgroundColor: 'rgba(139,92,246,.55)' }]);
    const tp = g.pages.slice(0, 10);
    hbar('gsPagesChart', tp.map(p => p.path), [{ label: 'Search clicks', data: tp.map(p => p.clicks), backgroundColor: '#0EA5E9' }, { label: 'GA4 sessions', data: tp.map(p => p.sessions), backgroundColor: '#F97316' }, { label: 'Page views', data: tp.map(p => p.views), backgroundColor: '#E31E24' }]);
    draw('gaEventsChart', { type: 'bar', data: { labels: A.events.map(e => EVENT_LABELS[e.name] || e.name), datasets: [
      { label: 'This period', data: A.events.map(e => e.value), backgroundColor: '#E31E24', borderRadius: 8, maxBarThickness: 30 },
      { label: 'Period before', data: A.events.map(e => e.previous), backgroundColor: 'rgba(100,116,139,.45)', borderRadius: 8, maxBarThickness: 30 },
    ] }, options: { scales: { y: { beginAtZero: true, ticks: { precision: 0 } }, x: { ticks: { autoSkip: false, maxRotation: 50, minRotation: 30 } } } } });
    const cs = G.countries.slice(0, 6), rest = G.countries.slice(6).reduce((s, c) => s + c.impressions, 0);
    pie('gsCountriesChart', cs.map(c => countryName(c.value)).concat(rest ? ['Other'] : []), cs.map(c => c.impressions).concat(rest ? [rest] : []), 'No search figures yet');
    $('gsQueries').innerHTML = table([{ t: 'Search phrase' }, { t: 'Clicks', n: 1 }, { t: 'Appearances', n: 1 }, { t: 'Click rate', n: 1 }, { t: 'Position', n: 1 }],
      G.queries.map(x => `<tr><td>${esc(x.value)}</td><td class="n">${fmt(x.clicks)}</td><td class="n">${fmt(x.impressions)}</td><td class="n">${x.ctr}%</td><td class="n">${x.position}</td></tr>`), 'No search phrases in this period.');
    $('gsPages').innerHTML = table([{ t: 'Page' }, { t: 'Search clicks', n: 1 }, { t: 'Appearances', n: 1 }, { t: 'Click rate', n: 1 }, { t: 'Position', n: 1 }, { t: 'GA4 sessions', n: 1 }, { t: 'Page views', n: 1 }],
      g.pages.map(p => `<tr><td class="path">${esc(p.path)}</td><td class="n">${fmt(p.clicks)}</td><td class="n">${fmt(p.impressions)}</td><td class="n">${p.impressions ? p.ctr + '%' : '&ndash;'}</td><td class="n">${p.position ?? '&ndash;'}</td><td class="n">${fmt(p.sessions)}</td><td class="n">${fmt(p.views)}</td></tr>`), 'No figures in this period.');
    $('gaEvents').innerHTML = table([{ t: 'Event' }, { t: 'Count', n: 1 }, { t: 'Change', n: 1 }],
      A.events.map(e => `<tr><td>${esc(EVENT_LABELS[e.name] || e.name)}</td><td class="n">${fmt(e.value)}</td><td class="n">${change(e.value, e.previous)}</td></tr>`), 'No GA4 events yet.');
    $('gsCountries').innerHTML = table([{ t: 'Country' }, { t: 'Clicks', n: 1 }, { t: 'Appearances', n: 1 }],
      G.countries.map(c => `<tr><td>${esc(countryName(c.value))}</td><td class="n">${fmt(c.clicks)}</td><td class="n">${fmt(c.impressions)}</td></tr>`), 'No search figures in this period.');
  }

  // Super Admins: a shortcut to AI Fix (Claude prepares fixes for these).
  document.addEventListener('ls:admin', e => { const a = e.detail; if (a && a.permissions && a.permissions.includes('ai.fix')) document.getElementById('aiFixLink').hidden = false; });
  // ── Recommendations (last 28 days; only for staff with "All reports") ──
  const PRI = { high: ['Do this first', '#E31E24'], medium: ['Worth doing', '#EAB308'], low: ['When you have time', '#10B981'] };
  async function recPost(body) {
    const r = await fetch('/api/admin/analytics-recommendations', { method: 'POST', headers: { 'x-admin-code': code, 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || 'Something went wrong');
    return d;
  }
  async function loadRecs() {
    try {
      const res = await fetch('/api/admin/analytics-recommendations', { headers: { 'x-admin-code': code } });
      if (res.status === 403 || res.status === 401) { $('sec-recs').hidden = true; return; }
      const d = await res.json();
      if (!res.ok) throw new Error(d.error || 'Could not load the recommendations');
      $('sec-recs').hidden = false;
      renderRecs(d);
    } catch (e) {
      $('sec-recs').hidden = false;
      $('recList').innerHTML = `<p class="gs-note bad">${esc(e.message)}</p>`;
    } finally { recsTried = true; }
  }
  const linkBtn = l => l ? `<a class="btn-o sm" href="${esc(l.href)}"${l.external ? ' target="_blank" rel="noopener"' : ''}>${esc(l.label)}${l.external ? ' &#8599;' : ''}</a>` : '';
  function recCard(r, isDone) {
    const [pl, pc] = PRI[r.priority] || PRI.medium;
    return `<article class="rec" style="--pc:${pc}">
      <div class="rec-top"><span class="pill">${pl}</span><span class="pill area">${esc(r.area)}</span></div>
      <h4>${esc(r.title)}</h4>
      <p>${esc(r.finding)}</p>
      <details${isDone ? '' : ''}><summary>How to do it (${r.steps.length} steps)</summary><ol>${r.steps.map(s => `<li>${esc(s)}</li>`).join('')}</ol></details>
      <div class="rec-act">${linkBtn(r.link)}${isDone
        ? `<span class="gs-status">Marked done ${esc(fmtWat(r.done.at))} by ${esc(r.done.by)}</span><button type="button" class="btn-o sm" data-undo="${esc(r.id)}">Show again</button>`
        : `<button type="button" class="btn-o sm" data-done="${esc(r.id)}">&#10003; Mark as done</button>`}</div>
    </article>`;
  }
  let lastRecs = null;
  function renderRecs(d) {
    lastRecs = d;
    $('recWhen').textContent = d.latest.gsc ? `Search figures to ${d.latest.gsc}${d.latest.ga4 ? ', GA4 to ' + d.latest.ga4 : ''}` : '';
    $('recGlance').innerHTML = d.glance.length ? `<h3>At a glance</h3><ul>${d.glance.map(g => `<li>${esc(g)}</li>`).join('')}</ul>` : '';
    $('recList').innerHTML = d.recs.length ? d.recs.map(r => recCard(r, false)).join('')
      : '<p class="rec-none">&#9989; Nothing needs attention right now. New recommendations appear here as the figures change (the figures are refreshed every morning).</p>';
    $('recDoneWrap').hidden = !d.done.length;
    $('recDoneSum').textContent = `Marked as done (${d.done.length})`;
    $('recDone').innerHTML = d.done.map(r => recCard(r, true)).join('');
    const ai = d.ai || {};
    $('recAi').innerHTML = ai.summary && ai.summary.text
      ? `<div class="rec-ai"><b>&#129302; Weekly summary by Claude</b> <span class="gs-status">(${esc(fmtWat(ai.summary.at))})</span>\n${esc(ai.summary.text).replace(/\*\*([^*\n]+)\*\*/g, '<b>$1</b>').replace(/^#+\s*/gm, '')}</div>${ai.enabled ? '<p><button type="button" class="btn-o sm" id="aiNow">Write a new summary now</button></p>' : ''}`
      : ai.enabled ? '<p><button type="button" class="btn-o sm" id="aiNow">Write the weekly summary now</button></p>' : '';
    $('aiNow')?.addEventListener('click', async e => {
      const b = e.currentTarget; b.disabled = true; b.textContent = 'Writing…';
      try { await recPost({ action: 'ai_summary' }); loadRecs(); } catch (err) { b.textContent = err.message; }
    });
  }
  $('sec-recs').addEventListener('click', async e => {
    const b = e.target.closest('[data-done],[data-undo]');
    if (!b) return;
    b.disabled = true; b.textContent = 'Saving…';
    const card = b.closest('.rec'); if (card) card.style.opacity = '.5';
    try { await recPost(b.dataset.done ? { action: 'done', id: b.dataset.done } : { action: 'undo', id: b.dataset.undo }); loadRecs(); }
    catch (err) { b.disabled = false; b.textContent = err.message; }
  });

  // "Sync now": start a sync of the last 4 days, then step through it.
  $('gsSync').addEventListener('click', async () => {
    if (syncing) return;
    syncing = true; $('gsSync').disabled = true; $('gsStatus').textContent = 'Starting…';
    const post = body => fetch('/api/admin/analytics-sync', { method: 'POST', headers: { 'x-admin-code': code, 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(r => r.json().then(d => ({ ok: r.ok, d })));
    try {
      let { ok, d } = await post({ action: 'sync' });
      if (!ok) throw new Error(d.error || 'Could not start the sync');
      let run = d.run;
      for (let i = 0; i < 200 && run && !run.done; i++) {
        $('gsStatus').innerHTML = `Syncing&hellip; part ${Math.min(run.idx + 1, run.tasks)} of ${run.tasks} (${fmt(run.rows)} rows)`;
        ({ ok, d } = await post({ action: 'step' }));
        if (!ok) throw new Error(d.error || 'The sync stopped');
        run = d.run;
      }
      $('gsStatus').innerHTML = run && run.failures && run.failures.length ? `Finished with problems: ${esc(run.failures.map(f => f.task).join(', '))}` : `Sync finished: ${fmt(run ? run.rows : 0)} rows updated`;
      syncing = false;
      const q = new URLSearchParams({ range }); if (range === 'custom') { q.set('from', from); q.set('to', to); }
      setTimeout(() => { loadGoogle(q); loadRecs(); }, 1500);
    } catch (e) {
      $('gsStatus').textContent = e.message;
    } finally { syncing = false; $('gsSync').disabled = false; }
  });

  function render(d) {
    $('rangeLabel').textContent = `${d.range.label} (compared with the ${d.range.days} day${d.range.days === 1 ? '' : 's'} before)`;

    const K = d.kpis;
    $('kpis').innerHTML = [
      ['Page views', K.pageViews, '📈', '#0EA5E9'], ['Unique visitors', K.uniqueVisitors, '🧑‍🤝‍🧑', '#8B5CF6'], ['Downloads', K.downloads, '⬇️', '#14B8A6'],
      ['Enquiries', K.enquiries, '✉️', '#F97316'], ['Total contacts', K.totalContacts, '👥', '#E31E24'], ['New contacts', K.newContacts, '✨', '#10B981'],
    ].map(([l, k, ic, c]) => `<div class="kpi" style="--c:${c}"><span class="kpi-ic" aria-hidden="true">${ic}</span><div class="kpi-l">${l}</div><div class="kpi-v">${fmt(k.value)}</div>${change(k.value, k.previous)}</div>`).join('');

    $('srcCards').innerHTML = d.sources.map((s, i) => `<div class="sc" style="--c:${COLORS[i % COLORS.length]}"><b>${s.pct}%</b><span>${esc(s.label)} &middot; ${fmt(s.contacts)}</span></div>`).join('')
      + `<div class="sc"><b>${fmt(d.totalContacts)}</b><span>Total contacts</span></div>`;

    const ft = d.firstTouch.filter(f => f.contacts > 0);
    draw('firstTouch', { type: 'doughnut', data: { labels: ft.length ? ft.map(f => f.source) : ['No contacts yet'], datasets: [{ data: ft.length ? ft.map(f => f.contacts) : [1], backgroundColor: ft.length ? COLORS : ['#E5E7EB'], borderWidth: 3, borderColor: cardColor(), hoverOffset: 10, borderRadius: 6 }] }, options: { cutout: '62%' } });
    draw('devices', { type: 'doughnut', data: { labels: d.devices.length ? d.devices.map(x => x.device) : ['No visits yet'], datasets: [{ data: d.devices.length ? d.devices.map(x => x.views) : [1], backgroundColor: d.devices.length ? COLORS.slice(3) : ['#E5E7EB'], borderWidth: 3, borderColor: cardColor(), hoverOffset: 10, borderRadius: 6 }] }, options: { cutout: '62%' } });
    draw('daily', {
      type: 'line',
      data: { labels: d.daily.map(x => x.day), datasets: [
        { label: 'Page views', data: d.daily.map(x => x.views), borderColor: '#E31E24', backgroundColor: 'rgba(227,30,36,.14)', fill: true, tension: .35, borderWidth: 3, pointRadius: 2, pointHoverRadius: 6 },
        { label: 'Unique visitors', data: d.daily.map(x => x.visitors), borderColor: '#0EA5E9', backgroundColor: 'rgba(14,165,233,.10)', fill: true, tension: .35, borderWidth: 3, pointRadius: 2, pointHoverRadius: 6 },
      ] },
      options: { scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } },
    });
    const tk = Object.keys(d.traffic);
    draw('traffic', {
      type: 'bar',
      data: { labels: tk, datasets: [{ label: 'Page views', data: tk.map(k => d.traffic[k]), backgroundColor: COLORS, borderRadius: 10, borderSkipped: false, maxBarThickness: 46 }] },
      options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } },
    });

    hbar('topPagesChart', d.topPages.map(p => p.path), [{ label: 'Views', data: d.topPages.map(p => p.views), backgroundColor: '#0EA5E9' }, { label: 'Visitors', data: d.topPages.map(p => p.visitors), backgroundColor: '#8B5CF6' }]);
    hbar('locationsChart', d.locations.map(l => l.region + (l.country ? ` (${l.country})` : '')), [{ label: 'Views', data: d.locations.map(l => l.views), backgroundColor: COLORS }], false);
    $('topPages').innerHTML = table([{ t: 'Page' }, { t: 'Views', n: 1 }, { t: 'Visitors', n: 1 }],
      d.topPages.map(p => `<tr><td class="path">${esc(p.path)}</td><td class="n">${fmt(p.views)}</td><td class="n">${fmt(p.visitors)}</td></tr>`), 'No page views in this period.');
    $('locations').innerHTML = table([{ t: 'State' }, { t: 'Country' }, { t: 'Views', n: 1 }],
      d.locations.map(l => `<tr><td>${esc(l.region)}</td><td>${esc(l.country)}</td><td class="n">${fmt(l.views)}</td></tr>`), 'No page views in this period.');
    $('recent').innerHTML = table([{ t: 'Name' }, { t: 'Source' }, { t: 'When' }],
      d.recentSignups.map(s => `<tr><td>${esc(s.name)}</td><td>${esc(s.source)}</td><td>${esc(fmtWat(s.at))}</td></tr>`), 'No contacts yet.');
    $('matchday').innerHTML = table([{ t: 'Match' }, { t: 'Date' }, { t: 'Live page visitors', n: 1 }, { t: 'Watch clicks', n: 1 }, { t: 'Commentary clicks', n: 1 }, { t: 'MOTM votes', n: 1 }, { t: 'Predictions', n: 1 }],
      d.matchday.map(m => `<tr><td>${esc(m.match)}</td><td>${esc(fmtWat(m.date))}</td><td class="n">${fmt(m.liveViewers)}</td><td class="n">${fmt(m.watchPlays)}</td><td class="n">${fmt(m.commentaryClicks)}</td><td class="n">${fmt(m.votes)}</td><td class="n">${fmt(m.predictions)}</td></tr>`), 'No home games yet.');
    $('broadcast').innerHTML = table([{ t: 'Match' }, { t: 'Kick-off' }, { t: 'Listens', n: 1 }, { t: 'Unique listeners', n: 1 }, { t: 'Avg. minutes', n: 1 }, { t: 'Peak', n: 1 }],
      (d.broadcast || []).map(b => `<tr><td>${esc(b.match)}</td><td>${esc(fmtWat(b.date))}</td><td class="n">${fmt(b.listens)}</td><td class="n">${fmt(b.uniqueListeners)}</td><td class="n">${b.avgMinutes}</td><td class="n">${fmt(b.peak)}</td></tr>`), 'No matches with commentary in this period.');
    $('partners').innerHTML = table([{ t: 'Partner' }, { t: 'Tier' }, { t: 'Impressions', n: 1 }, { t: 'Clicks', n: 1 }, { t: 'Click rate', n: 1 }],
      d.partners.map(p => `<tr><td>${esc(p.name)}</td><td>${esc(p.tier)}</td><td class="n">${fmt(d.partnerImpressions)}</td><td class="n">${fmt(p.clicks)}</td><td class="n">${d.partnerImpressions ? ((p.clicks / d.partnerImpressions) * 100).toFixed(2) : '0.00'}%</td></tr>`), 'No partners found.');
  }

  document.querySelectorAll('[data-range]').forEach(b => b.addEventListener('click', () => {
    document.querySelectorAll('[data-range]').forEach(x => x.classList.toggle('on', x === b));
    $('customForm').hidden = b.dataset.range !== 'custom';
    if (b.dataset.range === 'custom') { $('from').focus(); return; }
    range = b.dataset.range;
    try { localStorage.setItem('ls_an_range', range); } catch {}
    load();
  }));
  $('customForm').addEventListener('submit', e => { e.preventDefault(); range = 'custom'; from = $('from').value; to = $('to').value; load(); });
  document.querySelectorAll('[data-range]').forEach(x => x.classList.toggle('on', x.dataset.range === range));
  // ── Download & present ──
  // PNG under every chart, CSV under every table, and Excel / PowerPoint / Print
  // for the whole page. The fan sign-up list is never included in downloads.
  const CSV_TABLES = ['topPages', 'locations', 'matchday', 'broadcast', 'partners', 'gsQueries', 'gsPages', 'gaEvents', 'gsCountries'];
  const fileTag = () => (lastData ? lastData.range.label.replace(/\s+to\s+/, '_to_') : new Date().toISOString().slice(0, 10));
  const slug = s => String(s).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 50);
  const titleOf = el => el.getAttribute('aria-label') || el.id;
  function save(blob, name) {
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name;
    document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 4000);
  }
  /** The chart as a picture: its title on top, on the page's card colour. */
  function chartPng(id, withTitle = true) {
    const ch = charts[id]; if (!ch) return null;
    const c = ch.canvas, r = window.devicePixelRatio || 1, head = withTitle ? Math.round(58 * r) : Math.round(8 * r);
    const out = document.createElement('canvas'); out.width = c.width; out.height = c.height + head;
    const x = out.getContext('2d');
    x.fillStyle = cardColor(); x.fillRect(0, 0, out.width, out.height);
    if (withTitle) {
      // Title on the first line (shrunk to fit narrow charts), the period underneath.
      const css = getComputedStyle(document.body), pad = Math.round(10 * r), room = out.width - 2 * pad;
      x.fillStyle = css.getPropertyValue('--a-ink').trim() || '#15181D';
      let size = 18; x.font = `700 ${Math.round(size * r)}px Barlow, sans-serif`;
      while (size > 11 && x.measureText(titleOf(c)).width > room) { size--; x.font = `700 ${Math.round(size * r)}px Barlow, sans-serif`; }
      x.fillText(titleOf(c), pad, Math.round(22 * r), room);
      if (lastData) {
        x.fillStyle = css.getPropertyValue('--a-muted').trim() || '#5B6472';
        x.font = `500 ${Math.round(13 * r)}px Barlow, sans-serif`;
        x.fillText(lastData.range.label, pad, Math.round(42 * r), room);
      }
    }
    x.drawImage(c, 0, head);
    return { url: out.toDataURL('image/png'), w: out.width, h: out.height };
  }
  function tableRows(id) {
    const t = $(id)?.querySelector('table'); if (!t) return [];
    return [...t.querySelectorAll('tr')].map(tr => [...tr.children].map(td => {
      // Plain numbers (1,234 -> 1234) so Excel reads them as numbers.
      const v = td.textContent.replace(/\s+/g, ' ').trim();
      return /^-?\d{1,3}(,\d{3})+(\.\d+)?%?$/.test(v) ? v.replace(/,/g, '') : v;
    }));
  }
  const toCsv = rows => '﻿' + rows.map(r => r.map(v => /[",\n]/.test(v) ? `"${v.replace(/"/g, '""')}"` : v).join(',')).join('\r\n');
  // Add the small buttons once (the charts and tables inside are redrawn, these stay).
  document.querySelectorAll('.chart canvas').forEach(c => {
    const bar = document.createElement('div'); bar.className = 'dlbar';
    bar.innerHTML = `<button type="button" data-png="${c.id}" title="Download this chart as a picture">&#11015; Chart (PNG)</button>`;
    c.closest('.chart').after(bar);
  });
  CSV_TABLES.forEach(id => {
    const bar = document.createElement('div'); bar.className = 'dlbar';
    bar.innerHTML = `<button type="button" data-csv="${id}" title="Download this table for Excel">&#11015; Table (CSV)</button>`;
    $(id).after(bar);
  });
  document.addEventListener('click', e => {
    const p = e.target.closest('[data-png]'), c = e.target.closest('[data-csv]');
    if (p) { const img = chartPng(p.dataset.png); if (!img) return; fetch(img.url).then(r => r.blob()).then(b => save(b, `lobi-stars-${slug(titleOf($(p.dataset.png)))}-${fileTag()}.png`)); }
    if (c) { const rows = tableRows(c.dataset.csv); if (rows.length) save(new Blob([toCsv(rows)], { type: 'text/csv;charset=utf-8' }), `lobi-stars-${slug(c.dataset.csv)}-${fileTag()}.csv`); }
  });
  const libs = {};
  const loadLib = (name, src) => libs[name] || (libs[name] = new Promise((ok, bad) => { const s = document.createElement('script'); s.src = src; s.onload = ok; s.onerror = () => { delete libs[name]; bad(new Error('Could not load the download tool. Check the internet connection and try again.')); }; document.head.appendChild(s); }));
  const msg = t => { $('dlMsg').textContent = t; };
  const pctChange = (now, prev) => (prev ? Math.round(((now - prev) / prev) * 1000) / 10 + '%' : '');
  /** Downloads wait until every section has loaded (at most a minute). */
  const whenReady = () => new Promise(res => {
    const t0 = Date.now();
    (function wait() {
      const ready = lastData && googleTried && recsTried;
      if (ready || Date.now() - t0 > 60000) res(); else setTimeout(wait, 300);
    })();
  });

  /** Every figure on the page as tables (also used for the slides). */
  function sheets() {
    const d = lastData, g = lastGoogle, r = lastRecs, S = {};
    if (d) {
      const K = d.kpis, KL = [['Page views', K.pageViews], ['Unique visitors', K.uniqueVisitors], ['Downloads', K.downloads], ['Enquiries', K.enquiries], ['Total contacts', K.totalContacts], ['New contacts', K.newContacts]];
      S['Summary'] = [['Lobi Stars FC website analytics'], ['Period', d.range.label], ['Compared with', `the ${d.range.days} days before`], ['Downloaded', fmtWat(new Date().toISOString())], [],
        ['Figure', 'This period', 'Period before', 'Change'], ...KL.map(([l, k]) => [l, k.value, k.previous, pctChange(k.value, k.previous)])];
      if (g) {
        const G = g.gsc, A = g.ga4;
        S['Summary'].push([], ['Google search', 'This period', 'Period before', 'Change'],
          ['Search clicks', G.now.clicks, G.prev.clicks, pctChange(G.now.clicks, G.prev.clicks)], ['Appearances in Google', G.now.impressions, G.prev.impressions, pctChange(G.now.impressions, G.prev.impressions)],
          ['Click rate %', G.now.ctr, G.prev.ctr, ''], ['Average position (lower is better)', G.now.position, G.prev.position, ''],
          [], ['Google Analytics 4', 'This period', 'Period before', 'Change'],
          ['Sessions', A.now.sessions, A.prev.sessions, pctChange(A.now.sessions, A.prev.sessions)], ['Users (sum of days)', A.now.users, A.prev.users, pctChange(A.now.users, A.prev.users)],
          ['Engagement rate %', A.now.engagement, A.prev.engagement, ''], ['Average session (seconds)', A.now.duration, A.prev.duration, '']);
      }
      S['Daily visits'] = [['Day', 'Page views', 'Unique visitors'], ...d.daily.map(x => [x.day, x.views, x.visitors])];
      S['Traffic sources'] = [['Source', 'Page views'], ...Object.entries(d.traffic)];
      S['Devices'] = [['Device', 'Page views'], ...d.devices.map(x => [x.device, x.views])];
      S['Contact sources'] = [['Source', 'Contacts', '% of all contacts'], ...d.sources.map(s => [s.label, s.contacts, s.pct])];
      S['First source'] = [['Source', 'Contacts'], ...d.firstTouch.map(f => [f.source, f.contacts])];
      S['Top pages'] = [['Page', 'Views', 'Visitors'], ...d.topPages.map(p => [p.path, p.views, p.visitors])];
      S['Top states'] = [['State', 'Country', 'Views'], ...d.locations.map(l => [l.region, l.country, l.views])];
      S['Matchday'] = [['Match', 'Date', 'Live page visitors', 'Watch clicks', 'Commentary clicks', 'MOTM votes', 'Predictions'], ...d.matchday.map(m => [m.match, fmtWat(m.date), m.liveViewers, m.watchPlays, m.commentaryClicks, m.votes, m.predictions])];
      S['Commentary'] = [['Match', 'Kick-off', 'Listens', 'Unique listeners', 'Avg. minutes', 'Peak'], ...(d.broadcast || []).map(b => [b.match, fmtWat(b.date), b.listens, b.uniqueListeners, b.avgMinutes, b.peak])];
      S['Partners'] = [['Partner', 'Tier', 'Impressions', 'Clicks'], ...d.partners.map(p => [p.name, p.tier, d.partnerImpressions, p.clicks])];
    }
    if (g) {
      const dd = g.daily;
      S['Google daily'] = [['Day', 'Page views (website)', 'GA4 sessions', 'Search clicks', 'Appearances in Google'], ...dd.days.map((day, i) => [day, dd.views[i] ?? '', dd.sessions[i] ?? '', dd.clicks[i] ?? '', dd.impressions[i] ?? ''])];
      S['Search phrases'] = [['Search phrase', 'Clicks', 'Appearances', 'Click rate %', 'Position'], ...g.gsc.queries.map(x => [x.value, x.clicks, x.impressions, x.ctr, x.position])];
      S['Pages (all sources)'] = [['Page', 'Search clicks', 'Appearances', 'Click rate %', 'Position', 'GA4 sessions', 'Page views'], ...g.pages.map(p => [p.path, p.clicks, p.impressions, p.ctr, p.position ?? '', p.sessions, p.views])];
      S['Search countries'] = [['Country', 'Clicks', 'Appearances'], ...g.gsc.countries.map(c => [countryName(c.value), c.clicks, c.impressions])];
      S['Search devices'] = [['Device', 'Clicks', 'Appearances'], ...g.gsc.devices.map(c => [c.value, c.clicks, c.impressions])];
      S['GA4 channels'] = [['Channel', 'Sessions', 'Users'], ...g.ga4.channels.map(c => [c.channel, c.sessions, c.users])];
      S['GA4 devices'] = [['Device', 'Sessions'], ...g.ga4.devices.map(c => [c.device, c.sessions])];
      S['Key events'] = [['Event', 'This period', 'Period before', 'Change'], ...g.ga4.events.map(e => [EVENT_LABELS[e.name] || e.name, e.value, e.previous, pctChange(e.value, e.previous)])];
    }
    if (r) {
      S['At a glance'] = [['Last 28 days'], ...r.glance.map(x => [x])];
      S['Recommendations'] = [['Priority', 'Area', 'Recommendation', 'What we found', 'How to do it', 'Link'],
        ...r.recs.map(x => [(PRI[x.priority] || PRI.medium)[0], x.area, x.title, x.finding, x.steps.map((s, i) => `${i + 1}. ${s}`).join('\n'), x.link ? new URL(x.link.href, location.origin).href : ''])];
    }
    return S;
  }

  $('dlXlsx').addEventListener('click', async () => {
    try {
      if (!lastData || !googleTried || !recsTried) { msg('Loading the figures…'); await whenReady(); }
      msg('Preparing the Excel file…');
      await loadLib('xlsx', 'https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js');
      const wb = XLSX.utils.book_new();
      for (const [name, rows] of Object.entries(sheets())) {
        const ws = XLSX.utils.aoa_to_sheet(rows);
        ws['!cols'] = (rows.reduce((m, r) => (r.length > m.length ? r : m), [])).map((_, i) => ({ wch: Math.min(60, Math.max(10, ...rows.map(r => String(r[i] ?? '').length))) }));
        XLSX.utils.book_append_sheet(wb, ws, name.slice(0, 31));
      }
      XLSX.writeFile(wb, `Lobi-Stars-Analytics-${fileTag()}.xlsx`);
      msg('Excel file downloaded.');
    } catch (e) { msg(e.message); }
  });

  $('dlPptx').addEventListener('click', async () => {
    try {
      if (!lastData || !googleTried || !recsTried) { msg('Loading the figures…'); await whenReady(); }
      msg('Preparing the slides…');
      await loadLib('pptx', 'https://cdn.jsdelivr.net/npm/pptxgenjs@3.12.0/dist/pptxgen.bundle.js');
      const pptx = new PptxGenJS(); pptx.layout = 'LAYOUT_WIDE'; pptx.title = 'Lobi Stars FC website report';
      const RED = 'E31E24', INK = '15181D', MUTED = '5B6472', W = 13.33;
      const header = (s, t) => { s.background = { color: 'FFFFFF' }; s.addShape(pptx.ShapeType.rect, { x: 0, y: 0, w: W, h: 0.12, fill: { color: RED } }); s.addText(t, { x: 0.5, y: 0.3, w: W - 1, h: 0.7, fontFace: 'Arial', fontSize: 26, bold: true, color: INK }); s.addText(`Lobi Stars FC · ${lastData ? lastData.range.label : ''}`, { x: 0.5, y: 6.95, w: W - 1, h: 0.35, fontSize: 11, color: MUTED }); };
      // 1. Title
      const t = pptx.addSlide(); t.background = { color: INK };
      t.addShape(pptx.ShapeType.rect, { x: 0, y: 0, w: 0.35, h: 7.5, fill: { color: RED } });
      t.addText('LOBI STARS FC', { x: 0.9, y: 2.0, w: 11, h: 0.8, fontSize: 40, bold: true, color: 'FFFFFF' });
      t.addText('Website report', { x: 0.9, y: 2.8, w: 11, h: 0.7, fontSize: 30, color: 'EAB308' });
      t.addText(`${lastData ? lastData.range.label : ''}\nGoogle search, Google Analytics and the website's own figures\nDownloaded ${fmtWat(new Date().toISOString())}`, { x: 0.9, y: 3.8, w: 11, h: 1.4, fontSize: 16, color: 'D1D5DB' });
      // 2. Key figures
      const d = lastData, g = lastGoogle;
      if (d) {
        const K = d.kpis;
        const cards = [['Page views', K.pageViews], ['Unique visitors', K.uniqueVisitors], ['Enquiries', K.enquiries], ['New contacts', K.newContacts]];
        if (g) cards.push(['Search clicks', { value: g.gsc.now.clicks, previous: g.gsc.prev.clicks }], ['Appearances in Google', { value: g.gsc.now.impressions, previous: g.gsc.prev.impressions }], ['GA4 sessions', { value: g.ga4.now.sessions, previous: g.ga4.prev.sessions }], ['Engagement rate', { value: g.ga4.now.engagement, previous: g.ga4.prev.engagement, pct: 1 }]);
        const s = pptx.addSlide(); header(s, 'Key figures');
        cards.forEach(([label, k], i) => {
          const x = 0.5 + (i % 4) * 3.1, y = 1.3 + Math.floor(i / 4) * 2.7, ch = pctChange(k.value, k.previous);
          s.addShape(pptx.ShapeType.roundRect, { x, y, w: 2.9, h: 2.4, fill: { color: 'F5F6F8' }, line: { color: 'E3E6EA' }, rectRadius: 0.12 });
          s.addText(label.toUpperCase(), { x: x + 0.2, y: y + 0.15, w: 2.5, h: 0.4, fontSize: 11, bold: true, color: MUTED });
          s.addText(fmt(k.value) + (k.pct ? '%' : ''), { x: x + 0.2, y: y + 0.6, w: 2.5, h: 0.9, fontSize: 36, bold: true, color: RED });
          s.addText(ch ? `${ch.startsWith('-') ? '▼' : '▲'} ${ch.replace('-', '')} vs period before` : 'No earlier figure', { x: x + 0.2, y: y + 1.6, w: 2.5, h: 0.5, fontSize: 12, color: ch.startsWith('-') ? 'A3161B' : '17643A' });
        });
      }
      // 3. At a glance
      if (lastRecs && lastRecs.glance.length) {
        const s = pptx.addSlide(); header(s, 'At a glance (last 28 days)');
        s.addText(lastRecs.glance.map(x => ({ text: x, options: { bullet: true, breakLine: true } })), { x: 0.6, y: 1.2, w: W - 1.2, h: 5.5, fontSize: 18, color: INK, valign: 'top', paraSpaceAfter: 10 });
      }
      // 4. One slide per chart
      const order = ['daily', 'traffic', 'devices', 'firstTouch', 'topPagesChart', 'locationsChart', 'gsDaily', 'gaChannels', 'gsDevicesChart', 'gaDevicesChart', 'gsQueriesChart', 'gsPagesChart', 'gaEventsChart', 'gsCountriesChart'];
      for (const id of order) {
        const c = charts[id]; if (!c || !$(id) || $(id).closest('[hidden]')) continue;
        const img = chartPng(id, false); if (!img) continue;
        const s = pptx.addSlide(); header(s, titleOf($(id)));
        const maxW = W - 1, maxH = 5.6, ratio = img.w / img.h;
        const w = Math.min(maxW, maxH * ratio), h = w / ratio;
        s.addImage({ data: img.url, x: (W - w) / 2, y: 1.15, w, h });
      }
      // 5. Recommendations, one per slide, with the steps
      if (lastRecs) for (const r of lastRecs.recs) {
        const s = pptx.addSlide(); header(s, r.title);
        const [pl] = PRI[r.priority] || PRI.medium;
        s.addText(`${pl.toUpperCase()} · ${r.area.toUpperCase()}`, { x: 0.5, y: 1.0, w: W - 1, h: 0.4, fontSize: 12, bold: true, color: RED });
        s.addText(r.finding, { x: 0.5, y: 1.45, w: W - 1, h: 1.1, fontSize: 16, color: INK, valign: 'top' });
        s.addText('How to do it', { x: 0.5, y: 2.6, w: W - 1, h: 0.4, fontSize: 14, bold: true, color: INK });
        // Numbers written in the text, so every viewer (PowerPoint, Google Slides, Keynote) shows 1, 2, 3…
        s.addText(r.steps.map((x, i) => ({ text: `${i + 1}.  ${x}`, options: { breakLine: true, indentLevel: 0 } })), { x: 0.6, y: 3.0, w: W - 1.2, h: 3.8, fontSize: 14, color: INK, valign: 'top', paraSpaceAfter: 8 });
      }
      await pptx.writeFile({ fileName: `Lobi-Stars-Website-Report-${fileTag()}.pptx` });
      msg('PowerPoint downloaded.');
    } catch (e) { msg(e.message); }
  });

  // Print / Save as PDF: every "How to do it" guide open while printing.
  $('dlPrint').addEventListener('click', async () => {
    if (!lastData || !googleTried || !recsTried) { msg('Loading the figures…'); await whenReady(); msg(''); }
    const closed = [...document.querySelectorAll('#sec-recs details:not([open])')];
    closed.forEach(dt => { dt.open = true; });
    Object.values(charts).forEach(c => c.resize());
    setTimeout(() => { window.print(); closed.forEach(dt => { dt.open = false; }); }, 300);
  });

  load();
  loadRecs();
})();
</script>
