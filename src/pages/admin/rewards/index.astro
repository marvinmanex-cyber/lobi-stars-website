---
// Admin › Rewards: Lobi Stars Rewards settings (every earn rate, bonus, cap
// and the launch switch), totals, member lookup (points history, adjust with a
// reason, suspend) and "run the job now". All changes go to the audit log.
// TODO (later phases): tiers, catalogue, fulfilment queue, analytics.
import Layout from '../../../layouts/Layout.astro';
import AdminNav from '../../../components/admin/AdminNav.astro';
import LeagueKit from '../../../components/admin/league/LeagueKit.astro';
---
<Layout title="Rewards | Lobi Stars Admin" description="Lobi Stars Rewards settings and members." noindex>
  <div class="wrap la">
    <AdminNav current="rewards" />
    <header class="la-head"><div><div class="stag">Rewards</div><h1 class="stitle">Lobi Stars <span class="r">Rewards</span></h1></div>
      <div class="la-row"><a class="btn-o" href="/rewards/?preview=1" target="_blank" rel="noopener">Preview fan pages ↗</a><button class="btn-o" type="button" id="runNow">Run the points job now</button></div></header>
    <p class="la-lede">Fans earn Pride Points only from things the website records itself: confirmed Paystack payments, tickets scanned at the gate, Man of the Match votes and Predict &amp; Win. Points have no cash value. Change any number below and press <b>Save settings</b>; it applies to new points from then on.</p>

    <section class="la-card" aria-labelledby="h-stats"><h2 id="h-stats">Totals</h2><div id="stats" class="la-row"><p class="la-muted">Loading…</p></div></section>

    <section class="la-card" aria-labelledby="h-set">
      <h2 id="h-set">Settings</h2>
      <form id="set">
        <label class="la-row rw-live"><input type="checkbox" name="live" /> <span><b>Rewards is live for fans</b>: shows Rewards on the registration form, My account and /rewards. Leave off until the programme is ready.</span></label>
        <div id="fields"></div>
        <button class="btn-p" type="submit">Save settings</button>
      </form>
    </section>

    <section class="la-card" aria-labelledby="h-mem">
      <h2 id="h-mem">Find a member</h2>
      <form id="find" class="la-row" style="align-items:flex-end">
        <label class="la-f">Email or member number<input name="q" maxlength="120" placeholder="fan@example.com or LSR-000123" style="min-width:260px" /></label>
        <button class="btn-o" type="submit">Find</button>
      </form>
      <div id="member"></div>
    </section>
  </div>
  <LeagueKit />
</Layout>

<style is:global>
  .rw-live { gap: 10px; align-items: flex-start; margin: 0 0 16px; padding: 12px 14px; border-radius: 10px; background: rgba(255, 199, 44, .14); border: 1px solid rgba(201, 162, 39, .55); }
  .rw-live input { width: 22px; height: 22px; min-height: auto; flex: none; }
  .rw-group { margin: 0 0 16px; }
  .rw-group h3 { margin: 0 0 8px; font-size: 16px; }
  .rw-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 10px; }
  .rw-grid input { width: 100%; }
  .rw-grid small { display: block; color: var(--a-muted, #6b7280); font-weight: 400; }
  .rw-stat { background: var(--a-card); border: 1px solid var(--a-line); border-radius: 12px; padding: 10px 14px; min-width: 150px; }
  .rw-stat b { display: block; font-size: 22px; }
  .rw-mem { margin-top: 14px; }
  .rw-plus { color: #0B7A2E; font-weight: 700; } .rw-minus { color: #B91C1C; font-weight: 700; }
</style>

<script is:inline>
(function () {
  var LA = window.LA, el = LA.el, $ = function (id) { return document.getElementById(id); };
  var fmt = function (n) { return Number(n || 0).toLocaleString('en-NG'); };
  // Every editable number, grouped, with plain-English labels.
  var GROUPS = [
    ['Joining', [['welcomeBonus', 'Welcome bonus (points)', 'After the email is confirmed'], ['profileBonus', 'Profile bonus (points)', 'State of residence + date of birth']]],
    ['Purchases (points per ₦100 paid)', [['ticketsPer100', 'Match tickets', 'Pending until the match is played'], ['shopPer100', 'Shirts & merchandise', 'Our own checkout only (not Jumia)'], ['foodPer100', 'In-seat food', 'When the order is paid'], ['membershipPer100', 'Annual membership', ''], ['membershipBonus', 'Membership bonus (points)', 'On top of the points above']]],
    ['Matchday', [['attendance', 'Attending a home match (points)', 'Ticket scanned at the gate, once per match'], ['streakLength', 'Home matches in a row', 'For the streak bonus'], ['streakBonus', 'Streak bonus (points)', ''], ['motmVote', 'Man of the Match vote (points)', ''], ['prediction', 'Predict & Win entry (points)', ''], ['predictionCorrect', 'Correct result (points)', 'At full-time'], ['predictionExact', 'Exact score (points)', 'At full-time (instead of correct result)'], ['engagementMonthlyCap', 'Monthly limit: votes + predictions', '0 = no limit; attendance not included']]],
    ['Referrals and birthdays', [['referral', 'Referral (points to the referrer)', 'After the friend\'s first paid purchase'], ['referralMaxPerSeason', 'Most referral rewards per season', ''], ['birthday', 'Birthday month (points)', 'Once a year'], ['birthdayDobMinDays', 'Date of birth saved at least (days)', 'Before the birthday bonus']]],
  ];
  var DECIMAL = { ticketsPer100: 1, shopPer100: 1, foodPer100: 1, membershipPer100: 1 };

  function load() {
    LA.api('/api/admin/rewards').then(function (r) {
      if (!r.ok) { $('stats').replaceChildren(el('p', { class: 'la-msg err', text: r.d.error || 'Could not load.' })); return; }
      var s = r.d.settings, st = r.d.stats;
      $('stats').replaceChildren(
        el('div', { class: 'rw-stat' }, el('b', { text: fmt(st.members) }), 'members' + (st.suspended ? ' (' + st.suspended + ' suspended)' : '')),
        el('div', { class: 'rw-stat' }, el('b', { text: fmt(st.available) }), 'points available'),
        el('div', { class: 'rw-stat' }, el('b', { text: fmt(st.pending) }), 'points pending'),
        el('div', { class: 'rw-stat' }, el('b', { text: String((st.referrals.awarded || 0)) }), 'referrals rewarded' + (st.referrals.flagged ? ' · ' + st.referrals.flagged + ' flagged' : '')));
      var f = $('set'); f.elements.live.checked = !!s.live;
      $('fields').replaceChildren.apply($('fields'), GROUPS.map(function (g) {
        return el('div', { class: 'rw-group' }, el('h3', { text: g[0] }), el('div', { class: 'rw-grid' }, g[1].map(function (x) {
          return el('label', { class: 'la-f' }, x[1], el('input', { name: x[0], type: 'number', min: 0, step: DECIMAL[x[0]] ? '0.01' : '1', value: s[x[0]], required: true }), x[2] ? el('small', { text: x[2] + ' · default ' + r.d.defaults[x[0]] }) : el('small', { text: 'default ' + r.d.defaults[x[0]] }));
        })));
      }).concat([el('div', { class: 'rw-group' }, el('h3', { text: 'Season' }), el('div', { class: 'rw-grid' }, el('label', { class: 'la-f' }, 'Season starts', el('input', { name: 'seasonStart', type: 'date', value: s.seasonStart, required: true }), el('small', { text: 'Referral limit per season (and tiers, later)' }))))]));
    });
  }
  $('set').addEventListener('submit', function (e) {
    e.preventDefault(); var f = this.elements, body = { live: f.live.checked, seasonStart: f.seasonStart.value };
    GROUPS.forEach(function (g) { g[1].forEach(function (x) { body[x[0]] = Number(f[x[0]].value); }); });
    var go = function () { LA.api('/api/admin/rewards', { method: 'PUT', body: { settings: body } }).then(function (r) { r.ok ? (LA.toast('Settings saved'), load()) : LA.toast(r.d.error || 'Could not save.', true); }); };
    if (body.live && !window.__rwWasLive) LA.confirm('Make Lobi Stars Rewards live for fans?', ['Fans will see Rewards on the registration form, My account and /rewards. Check the Rewards Terms have been reviewed first.'], 'Make it live').then(function (y) { if (y) go(); }); else go();
  });

  function showMember(q) {
    LA.api('/api/admin/rewards/member?q=' + encodeURIComponent(q)).then(function (r) {
      var box = $('member');
      if (!r.ok) { box.replaceChildren(el('p', { class: 'la-msg err', text: r.d.error || 'Not found.' })); return; }
      var m = r.d.member;
      var pts = el('input', { type: 'number', step: 1, placeholder: 'e.g. 50 or -50', style: 'width:140px' }), why = el('input', { maxlength: 160, placeholder: 'Reason (shown to the fan)', style: 'min-width:260px' });
      box.replaceChildren(el('div', { class: 'rw-mem' },
        el('p', {}, el('b', { text: m.name + ' · ' + m.memberNo }), el('br'), el('span', { class: 'la-muted', text: m.email + (m.verified ? '' : ' (email not confirmed)') + ' · joined ' + LA.when(m.joinedAt.replace(' ', 'T') + 'Z') + (m.state ? ' · ' + m.state : '') })),
        el('div', { class: 'la-row' }, el('div', { class: 'rw-stat' }, el('b', { text: fmt(r.d.balance) }), 'available'), el('div', { class: 'rw-stat' }, el('b', { text: fmt(r.d.pending) }), 'pending'),
          el('span', { class: 'la-chip ' + (m.status === 'active' ? 'full_time' : 'cancelled'), text: m.status })),
        el('h3', { text: 'Adjust points' }),
        el('div', { class: 'la-row', style: 'align-items:flex-end' }, el('label', { class: 'la-f' }, 'Points (+/-)', pts), el('label', { class: 'la-f' }, 'Reason', why),
          el('button', { type: 'button', class: 'btn-p btn-sm', text: 'Adjust', onclick: function () { act({ memberId: m.id, action: 'adjust', points: Number(pts.value), reason: why.value }, q); } }),
          el('button', { type: 'button', class: 'btn-o btn-sm', text: m.status === 'active' ? 'Suspend (fraud)' : 'Restore', onclick: function () { act({ memberId: m.id, action: m.status === 'active' ? 'suspend' : 'unsuspend', reason: why.value }, q); } })),
        el('h3', { text: 'Points history' }),
        r.d.history.length ? LA.table(['When', 'What', 'Points', 'Status'], r.d.history.map(function (h) {
          return el('tr', {}, el('td', { text: LA.when(h.createdAt.replace(' ', 'T') + 'Z') }), el('td', { text: h.description }), el('td', { class: h.points >= 0 ? 'rw-plus' : 'rw-minus', text: (h.points >= 0 ? '+' : '') + fmt(h.points) }), el('td', { text: h.status }));
        })) : el('p', { class: 'la-muted', text: 'No points yet.' }),
        r.d.referrals.length ? el('h3', { text: 'Friends referred' }) : null,
        r.d.referrals.length ? LA.table(['Friend', 'Status', 'Note'], r.d.referrals.map(function (x) { return el('tr', {}, el('td', { text: x.email }), el('td', { text: x.status }), el('td', { text: x.reason || '' })); })) : null));
    });
  }
  function act(body, q) { LA.api('/api/admin/rewards/member', { method: 'POST', body: body }).then(function (r) { r.ok ? (LA.toast('Done'), showMember(q), load()) : LA.toast(r.d.error || 'Could not do that.', true); }); }
  $('find').addEventListener('submit', function (e) { e.preventDefault(); var q = this.elements.q.value.trim(); if (q) showMember(q); });
  $('runNow').addEventListener('click', function () { LA.api('/api/admin/rewards/run', { method: 'POST', body: {} }).then(function (r) { r.ok ? LA.toast('Done: ' + r.d.released + ' ticket points made available, ' + r.d.predictions + ' prediction results, ' + r.d.birthdays + ' birthdays') : LA.toast(r.d.error || 'Could not run.', true); }); });
  LA.api('/api/admin/rewards').then(function (r) { window.__rwWasLive = !!(r.ok && r.d.settings.live); });
  load();
})();
</script>
