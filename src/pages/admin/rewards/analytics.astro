---
// Admin › Rewards › Reports: how Lobi Stars Rewards is doing (members, Star
// Points issued / used / expired, points in fans' balances and their naira
// value, points by month, how points are earned, tiers, rewards redeemed),
// "Checks" (accounts worth a look) and the Excel download (needs "can export
// fan data"). From /api/admin/rewards/analytics. Chart colours: validated
// categorical slots 1-3 (light and dark admin themes); the monthly chart also
// has a table view.
import Layout from '../../../layouts/Layout.astro';
import AdminNav from '../../../components/admin/AdminNav.astro';
import LeagueKit from '../../../components/admin/league/LeagueKit.astro';
---
<Layout title="Rewards Reports | Lobi Stars Admin" description="Lobi Stars Rewards reports, checks and export." noindex>
  <div class="wrap la">
    <AdminNav current="rewards-analytics" />
    <header class="la-head"><div><div class="stag">Rewards</div><h1 class="stitle">Rewards <span class="r">Reports</span></h1></div>
      <div class="la-row"><a class="btn-p" id="xlsx" href="/api/admin/rewards/analytics?format=xlsx">Download Excel</a><a class="btn-o" href="/admin/rewards/">Settings &amp; members</a></div></header>
    <p class="la-muted" id="liveNote" hidden>Rewards is not live yet: these figures come from staff testing and previews.</p>

    <section class="rr-tiles" id="tiles" aria-label="Summary"><p class="la-muted">Loading…</p></section>

    <section class="la-card" aria-labelledby="h-m">
      <h2 id="h-m">Star Points by month</h2>
      <div class="rr-legend" aria-hidden="true"><span><i style="--c:var(--s1)"></i>Issued</span><span><i style="--c:var(--s2)"></i>Used</span><span><i style="--c:var(--s3)"></i>Expired</span></div>
      <div class="rr-chart"><canvas id="cMonths" role="img" aria-label="Bar chart: Star Points issued, used and expired in each of the last 12 months"></canvas></div>
      <details class="rr-table"><summary>Show as a table</summary><div id="tMonths"></div></details>
    </section>

    <div class="rr-two">
      <section class="la-card" aria-labelledby="h-s">
        <h2 id="h-s">How fans earn Star Points</h2>
        <div class="rr-chart tall"><canvas id="cSources" role="img" aria-label="Bar chart: Star Points earned by each way of earning"></canvas></div>
        <details class="rr-table"><summary>Show as a table</summary><div id="tSources"></div></details>
      </section>
      <section class="la-card" aria-labelledby="h-t">
        <h2 id="h-t">Tiers (active members)</h2>
        <div id="tiers"></div>
        <h2 id="h-r" style="margin-top:18px">Rewards redeemed</h2>
        <div id="rewards"></div>
      </section>
    </div>

    <section class="la-card" aria-labelledby="h-f">
      <h2 id="h-f">Checks</h2>
      <p class="la-muted">Accounts worth a look. A check is not proof of cheating: look at the account in <a href="/admin/rewards/">Lobi Stars Rewards › Members</a> before you put it on hold or adjust points.</p>
      <div id="flags"><p class="la-muted">Loading…</p></div>
    </section>
  </div>
  <LeagueKit />
</Layout>

<style is:global>
  body { --s1: #2a78d6; --s2: #eb6834; --s3: #1baf7a; }
  body.admin-dark { --s1: #3987e5; --s2: #d95926; --s3: #199e70; }
  .rr-tiles { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); margin: 0 0 16px; }
  .rr-tile { padding: 14px 16px; border-radius: 12px; background: var(--a-card, #fff); border: 1px solid var(--a-line, #E3E6EA); }
  .rr-tile span { display: block; font: 700 12px/1.3 'Barlow Condensed', sans-serif; letter-spacing: .06em; text-transform: uppercase; color: var(--a-muted, #5B6472); }
  .rr-tile b { display: block; margin-top: 4px; font: 400 34px/1 'Bebas Neue', sans-serif; letter-spacing: .5px; color: var(--a-ink, #15181D); }
  .rr-tile small { display: block; margin-top: 4px; color: var(--a-muted, #5B6472); font-size: 13px; }
  .rr-chart { position: relative; height: 300px; }
  .rr-chart.tall { height: 360px; }
  .rr-legend { display: flex; gap: 16px; flex-wrap: wrap; margin: 0 0 8px; font-size: 14px; color: var(--a-ink, #15181D); }
  .rr-legend i { display: inline-block; width: 12px; height: 12px; border-radius: 3px; background: var(--c); margin-right: 6px; vertical-align: -1px; }
  .rr-table { margin-top: 10px; }
  .rr-table summary { cursor: pointer; font-weight: 600; color: var(--a-muted, #5B6472); }
  .rr-two { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); }
  .rr-flag { padding: 12px 14px; border-radius: 10px; border: 1px solid var(--a-line, #E3E6EA); border-left: 4px solid #C9A227; margin: 0 0 10px; background: var(--a-card, #fff); }
  .rr-flag b { display: block; }
  .rr-flag p { margin: 4px 0 0; }
  .rr-flag ul { margin: 6px 0 0; padding-left: 18px; }
  @media (max-width: 480px) { .rr-two { grid-template-columns: 1fr; } .rr-chart { height: 260px; } }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script is:inline>
(function () {
  var LA = window.LA, el = LA.el, $ = function (id) { return document.getElementById(id); };
  var fmt = function (n) { return Number(n || 0).toLocaleString('en-NG'); };
  var css = function (v) { return getComputedStyle(document.body).getPropertyValue(v).trim(); };
  function tile(label, value, note) { return el('div', { class: 'rr-tile' }, el('span', { text: label }), el('b', { text: value }), note ? el('small', { text: note }) : null); }

  // Excel: fetched with the admin login (a plain link would not carry it), then saved.
  $('xlsx').addEventListener('click', function (e) {
    e.preventDefault();
    var code = sessionStorage.getItem('ls_admin_code') || '__session__';
    fetch(this.href, { headers: { 'x-admin-code': code }, cache: 'no-store' }).then(function (res) {
      if (!res.ok) return res.json().catch(function () { return {}; }).then(function (d) { throw new Error(d.error || 'Download failed.'); });
      var name = ((res.headers.get('Content-Disposition') || '').match(/filename="([^"]+)"/) || [])[1] || 'lobi-stars-rewards.xlsx';
      return res.blob().then(function (blob) { var url = URL.createObjectURL(blob); var link = Object.assign(document.createElement('a'), { href: url, download: name }); document.body.appendChild(link); link.click(); link.remove(); setTimeout(function () { URL.revokeObjectURL(url); }, 5000); });
    }).catch(function (err) { LA.toast(err.message, true); });
  });

  LA.api('/api/admin/rewards/analytics').then(function (r) {
    if (!r.ok) { $('tiles').replaceChildren(el('p', { class: 'la-msg err', text: r.d.error || 'Could not load.' })); return; }
    var d = r.d, s = d.summary;
    $('liveNote').hidden = !!d.live;
    $('tiles').replaceChildren(
      tile('Rewards members', fmt(s.members), fmt(s.active) + ' active' + (s.suspended ? ', ' + fmt(s.suspended) + ' on hold' : '')),
      tile('Joined (30 days)', fmt(s.joined30)),
      tile('Points issued', fmt(s.issued), fmt(s.pending) + ' pending (tickets before the match)'),
      tile('Points used', fmt(s.used), 'On rewards and at checkout'),
      tile('Points expired', fmt(s.expired), fmt(s.takenBack) + ' taken back after refunds'),
      tile("In fans' balances", fmt(s.outstanding), 'Worth about ₦' + fmt(Math.round(s.outstandingKobo / 100)) + ' (₦' + fmt(s.pointValueKobo / 100) + ' a point)'));

    $('tMonths').replaceChildren(LA.table(['Month', 'Issued', 'Used', 'Expired', 'New members'], d.months.map(function (m) { return el('tr', {}, el('td', { text: m.label }), el('td', { text: fmt(m.issued) }), el('td', { text: fmt(m.used) }), el('td', { text: fmt(m.expired) }), el('td', { text: fmt(m.joined) })); })));
    $('tSources').replaceChildren(d.sources.length ? LA.table(['Way', 'Star Points', 'Times'], d.sources.map(function (x) { return el('tr', {}, el('td', { text: x.label }), el('td', { text: fmt(x.points) }), el('td', { text: fmt(x.count) })); })) : el('p', { class: 'la-muted', text: 'No points earned yet.' }));
    $('tiers').replaceChildren(LA.table(['Tier', 'Active members'], d.tiers.map(function (t) { return el('tr', {}, el('td', { text: t.name }), el('td', { text: fmt(t.members) })); })));
    $('rewards').replaceChildren(d.rewards.length ? LA.table(['Reward', 'Times', 'Star Points'], d.rewards.map(function (x) { return el('tr', {}, el('td', { text: x.item }), el('td', { text: fmt(x.count) }), el('td', { text: fmt(x.points) })); })) : el('p', { class: 'la-muted', text: 'No rewards redeemed yet.' }));
    // One card per kind of check (one per shared device); up to 10 lines each.
    var cards = [], byType = {};
    d.flags.forEach(function (f) {
      if (f.type === 'device') { cards.push({ label: f.label, note: f.detail, lines: f.members.map(function (p) { return p.memberNo + ' · ' + p.name + ' · ' + p.email; }) }); return; }
      if (!byType[f.type]) { byType[f.type] = { label: f.label, lines: [] }; cards.push(byType[f.type]); }
      f.members.forEach(function (p) { byType[f.type].lines.push(p.memberNo + ' · ' + p.name + ' · ' + p.email + ': ' + f.detail); });
    });
    $('flags').replaceChildren.apply($('flags'), cards.length ? cards.map(function (c) {
      var shown = c.lines.slice(0, 10);
      return el('div', { class: 'rr-flag' }, el('b', { text: c.label + (c.note ? '' : ' (' + c.lines.length + ')') }), c.note ? el('p', { text: c.note }) : null,
        el('ul', {}, shown.map(function (t) { return el('li', { text: t }); })), c.lines.length > 10 ? el('p', { class: 'la-muted', text: 'and ' + (c.lines.length - 10) + ' more (all of them are in the Excel download, sheet "Checks").' }) : null);
    }) : [el('p', { class: 'la-muted', text: 'Nothing to look at right now.' })]);

    if (!window.Chart) return;
    Chart.defaults.font.family = 'Barlow, sans-serif';
    Chart.defaults.color = css('--a-muted') || '#5B6472';
    Chart.defaults.borderColor = css('--a-line') || '#E3E6EA';
    var surface = css('--a-card') || '#FFFFFF';
    var bar = { borderRadius: { topLeft: 4, topRight: 4 }, borderSkipped: 'bottom', borderWidth: { top: 0, left: 2, right: 2, bottom: 0 }, borderColor: surface, maxBarThickness: 22 };
    new Chart($('cMonths'), {
      type: 'bar',
      data: { labels: d.months.map(function (m) { return m.label; }), datasets: [
        Object.assign({ label: 'Issued', data: d.months.map(function (m) { return m.issued; }), backgroundColor: css('--s1') }, bar),
        Object.assign({ label: 'Used', data: d.months.map(function (m) { return m.used; }), backgroundColor: css('--s2') }, bar),
        Object.assign({ label: 'Expired', data: d.months.map(function (m) { return m.expired; }), backgroundColor: css('--s3') }, bar),
      ] },
      options: { maintainAspectRatio: false, interaction: { mode: 'index', intersect: false }, plugins: { legend: { display: false }, tooltip: { callbacks: { label: function (c) { return c.dataset.label + ': ' + fmt(c.parsed.y) + ' points'; } } } },
        scales: { x: { grid: { display: false } }, y: { beginAtZero: true, ticks: { callback: function (v) { return fmt(v); } } } } },
    });
    new Chart($('cSources'), {
      type: 'bar',
      data: { labels: d.sources.map(function (x) { return x.label; }), datasets: [Object.assign({ label: 'Star Points', data: d.sources.map(function (x) { return x.points; }), backgroundColor: css('--s1') }, bar, { borderRadius: { topRight: 4, bottomRight: 4 }, borderSkipped: 'left', borderWidth: { top: 2, bottom: 2, left: 0, right: 0 } })] },
      options: { indexAxis: 'y', maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { callbacks: { label: function (c) { return fmt(c.parsed.x) + ' points (' + fmt(d.sources[c.dataIndex].count) + ' times)'; } } } },
        scales: { y: { grid: { display: false } }, x: { beginAtZero: true, ticks: { callback: function (v) { return fmt(v); } } } } },
    });
  });
})();
</script>
