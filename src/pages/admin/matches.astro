---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Manage Matches | Lobi Stars Admin">
  <div class="wrap admin-wrap">
    <div class="admin-nav">
      <a href="/" class="an-back">&larr; Back to site</a>
      <a href="/admin/">Content CMS</a>
      <a href="/admin/analytics">Analytics</a>
    </div>
    <div class="stag">Admin</div>
    <h1 class="stitle">Manage <span class="r">Matches</span></h1>
    <p class="admin-lede">
      These fixtures power the homepage countdown and the
      <a href="/tickets">Buy Tickets</a> page. Changes go live immediately.
      News, squad and photos are handled in <a href="/admin/">the content CMS</a>.
    </p>

    <!-- Passcode gate -->
    <div id="gate" class="gate-card">
      <div class="gate-icon">&#128274;</div>
      <h2>Admin access</h2>
      <p class="muted">Enter the admin code to manage fixtures.</p>
      <input id="code" type="password" placeholder="Admin code" autocomplete="off" />
      <button id="unlock" class="btn-p">Unlock</button>
      <div id="gate-err" class="gate-err"></div>
    </div>

    <!-- Manager -->
    <div id="manager" hidden>
      <div class="dash-bar">
        <button id="new-btn" class="btn-p">&#43;&nbsp; New match</button>
        <div class="dash-bar-actions">
          <button id="refresh" class="btn-o sm">Refresh</button>
          <button id="lock-btn" class="btn-o sm">Lock</button>
        </div>
      </div>

      <div id="msg" class="dash-msg" hidden></div>

      <!-- Add / edit form -->
      <form id="form" class="panel form-panel" hidden>
        <div class="form-title" id="f-title">New match</div>

        <div class="fset">
          <div class="fset-label">Match details</div>
          <div class="f-grid">
            <label>Home team<input id="f-home" type="text" value="Lobi Stars FC" required/></label>
            <label>Away team<input id="f-away" type="text" placeholder="e.g. Kada Warriors FC" required/></label>
            <label>Competition<input id="f-comp" type="text" value="NNL Conference D" required/></label>
            <label>Venue<input id="f-venue" type="text" value="McCarthy Stadium, Makurdi" required/></label>
            <label class="span2">Kick-off<input id="f-date" type="datetime-local" required/></label>
          </div>
          <p class="fhint">Kick-off is your device's local time (WAT on a Nigeria-set device).</p>
        </div>

        <div class="fset">
          <div class="fset-label">Ticket pricing (&#8358;)</div>
          <div class="f-grid f-grid-3">
            <label>VIP<input id="f-vip" type="number" min="0" step="50" value="0" required/></label>
            <label>Premium<input id="f-prem" type="number" min="0" step="50" value="0" required/></label>
            <label>Regular<input id="f-reg" type="number" min="0" step="50" value="0" required/></label>
          </div>
        </div>

        <div class="fset">
          <label class="f-check"><input id="f-active" type="checkbox" checked/> <span>Visible on the site</span></label>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-p" id="f-save">Save match</button>
          <button type="button" class="btn-o" id="f-cancel">Cancel</button>
        </div>
      </form>

      <div id="list" class="mlist"></div>
    </div>
  </div>

  <style is:global>
    .admin-wrap{max-width:940px;padding-top:112px;padding-bottom:90px;min-height:78vh;}
    .admin-nav{display:flex;gap:20px;flex-wrap:wrap;font-family:'Barlow Condensed',sans-serif;
      font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:26px;}
    .admin-nav a{color:var(--lt);text-decoration:none;transition:color .15s;}
    .admin-nav a:hover{color:var(--gold);}
    .admin-nav .an-back{color:var(--gold);}
    .admin-lede{max-width:640px;margin:6px 0 28px;font-size:14px;line-height:1.6;color:var(--lt);}
    .admin-lede a{color:var(--gold);}

    /* ---- gate ---- */
    .gate-card{max-width:400px;margin:10px 0;padding:32px 28px;text-align:center;
      background:var(--d2);border:1px solid var(--d4);border-radius:14px;box-shadow:0 18px 40px rgba(0,0,0,.14);}
    .gate-icon{font-size:30px;margin-bottom:8px;}
    .gate-card h2{font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:1px;color:var(--white);}
    .gate-card p{font-size:13px;margin:4px 0 18px;}
    .gate-card input{width:100%;padding:13px 14px;border-radius:8px;border:1px solid var(--d4);
      background:var(--d3);color:var(--white);font-size:16px;margin-bottom:14px;text-align:center;letter-spacing:2px;}
    .gate-card input:focus{outline:none;border-color:var(--gold);}
    .gate-card .btn-p{width:100%;}
    .gate-err{display:none;margin-top:12px;font-size:13px;color:var(--red);}
    .gate-err.show{display:block;}

    /* ---- chrome ---- */
    .dash-bar{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;margin-bottom:20px;}
    .dash-bar-actions{display:flex;align-items:center;gap:10px;}
    .btn-p, .btn-o{border-radius:6px;}
    .btn-o.sm{padding:9px 16px;font-size:12px;}
    #new-btn{padding:11px 22px;font-size:13px;}
    .dash-msg{padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:14px;}
    .dash-msg.ok{background:rgba(76,175,80,.15);color:#3fae44;}
    .dash-msg.bad{background:rgba(212,32,43,.14);color:var(--red);}

    /* ---- panel / form ---- */
    .panel{background:var(--d2);border:1px solid var(--d4);border-radius:14px;}
    .form-panel{padding:24px;margin-bottom:26px;}
    .form-title{font-family:'Bebas Neue',sans-serif;font-size:24px;letter-spacing:1px;color:var(--white);margin-bottom:18px;}
    .fset{padding:16px 0;border-top:1px solid var(--d4);}
    .fset:first-of-type{border-top:none;padding-top:0;}
    .fset-label{font-family:'Barlow Condensed',sans-serif;font-size:11px;font-weight:700;letter-spacing:2px;
      text-transform:uppercase;color:var(--gold);margin-bottom:12px;}
    .f-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
    .f-grid-3{grid-template-columns:1fr 1fr 1fr;}
    .f-grid label{display:flex;flex-direction:column;font-size:11px;letter-spacing:1px;text-transform:uppercase;
      color:var(--lt);gap:6px;}
    .f-grid label.span2{grid-column:1/-1;}
    .f-grid input{padding:11px 12px;border-radius:8px;border:1px solid var(--d4);background:var(--d3);
      color:var(--white);font-size:15px;text-transform:none;letter-spacing:0;}
    .f-grid input:focus{outline:none;border-color:var(--gold);}
    .fhint{font-size:12px;color:var(--lt);margin-top:10px;}
    .f-check{display:flex;align-items:center;gap:10px;font-size:14px;color:var(--white);cursor:pointer;}
    .f-check input{width:18px;height:18px;accent-color:var(--red);}
    .form-actions{display:flex;gap:10px;padding-top:18px;border-top:1px solid var(--d4);}
    .form-actions .btn-p{padding:11px 26px;}
    .form-actions .btn-o{padding:11px 22px;}

    /* ---- match list ---- */
    .mlist{display:flex;flex-direction:column;gap:14px;}
    .m-card{background:var(--d2);border:1px solid var(--d4);border-radius:14px;padding:18px 20px;
      display:grid;grid-template-columns:auto 1fr auto;gap:16px;align-items:start;}
    .m-card.inactive{opacity:.6;}
    .m-crest{width:46px;height:46px;border-radius:50%;object-fit:contain;background:#fff;
      padding:3px;box-shadow:0 0 0 1px var(--d4);flex-shrink:0;}
    .m-crest.ph{display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;
      font-size:20px;color:#8a8a8a;padding:0;}
    .m-main{min-width:0;}
    .m-teams{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:19px;letter-spacing:.3px;
      color:var(--white);line-height:1.2;}
    .m-when{font-size:13px;color:var(--white);margin-top:5px;}
    .m-sub{font-size:12px;color:var(--lt);margin-top:3px;}
    .m-prices{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;}
    .chip{font-size:11px;letter-spacing:.5px;padding:3px 9px;border-radius:20px;background:var(--d3);
      color:var(--lt);border:1px solid var(--d4);}
    .m-side{display:flex;flex-direction:column;align-items:flex-end;gap:10px;}
    .pills{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;}
    .pill{font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:3px 9px;border-radius:20px;}
    .pill.on{background:rgba(76,175,80,.2);color:#3fae44;}
    .pill.off{background:var(--d3);color:var(--lt);}
    .pill.past{background:rgba(255,199,44,.16);color:var(--gold);}
    .pill.sold{background:rgba(212,32,43,.14);color:var(--red);}
    .m-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;}
    .m-actions button{font-family:'Barlow Condensed',sans-serif;font-size:12px;font-weight:700;letter-spacing:1px;
      text-transform:uppercase;padding:7px 14px;border-radius:6px;cursor:pointer;border:1px solid var(--d4);
      background:transparent;color:var(--white);transition:border-color .15s,color .15s;}
    .m-actions button:hover{border-color:var(--gold);color:var(--gold);}
    .m-actions button.danger:hover{border-color:var(--red);color:var(--red);}

    @media(max-width:640px){
      .f-grid,.f-grid-3{grid-template-columns:1fr;}
      .m-card{grid-template-columns:auto 1fr;}
      .m-side{grid-column:1/-1;align-items:stretch;}
      .pills,.m-actions{justify-content:flex-start;}
    }
  </style>

  <script is:inline>
  (function () {
    let code = sessionStorage.getItem('ls_admin_code') || '';

    const $ = id => document.getElementById(id);
    const gate = $('gate'), manager = $('manager'), gateErr = $('gate-err');
    const form = $('form'), list = $('list'), msg = $('msg');

    // Opponent crests already in /public/images, keyed by a normalised name.
    const CRESTS = {
      'abs fc': '/images/abs-illorin.jpg',
      'bichi first fc': '/images/bichi-first.jpg',
      'bichi first': '/images/bichi-first.jpg',
      'kada warriors fc': '/images/kadawarriors-kaduna.jpg',
      'kada warriors': '/images/kadawarriors-kaduna.jpg',
      'lobi stars fc': '/images/lobi-stars-fc.jpg',
      'lobi stars': '/images/lobi-stars-fc.jpg',
      'mighty jets': '/images/mighty-jets-jos.jpg',
      'mighty jets feeder / bida lions': '/images/mighty-jets-jos.jpg',
      'sokoto united fc': '/images/sokoto-united.jpg',
      'sokoto united': '/images/sokoto-united.jpg',
      'wikki tourists fc': '/images/wikki-tourists.jpg',
      'wikki tourists': '/images/wikki-tourists.jpg',
      'yobe desert stars fc': '/images/yobe-desert-stars.jpg',
      'yobe desert stars': '/images/yobe-desert-stars.jpg',
      'kano pillars': '/images/kano-pillars-logo.png',
    };
    const crestFor = name => CRESTS[String(name || '').trim().toLowerCase()] || null;
    // The "opponent" is whichever side isn't Lobi Stars.
    function opponent(e) {
      const h = String(e.home_team || '').toLowerCase();
      return h.indexOf('lobi') === 0 ? e.away_team : e.home_team;
    }

    function showMsg(text, ok) {
      msg.textContent = text;
      msg.hidden = false;
      msg.className = 'dash-msg ' + (ok ? 'ok' : 'bad');
      if (ok) setTimeout(() => { msg.hidden = true; }, 3500);
    }

    async function api(path, opts = {}) {
      const res = await fetch(path, {
        ...opts,
        headers: { 'Content-Type': 'application/json', 'x-admin-code': code, ...(opts.headers || {}) },
      });
      if (res.status === 401) {
        sessionStorage.removeItem('ls_admin_code');
        code = '';
        manager.hidden = true;
        gate.style.display = '';
        gateErr.textContent = 'Code rejected — enter it again.';
        gateErr.classList.add('show');
        throw new Error('unauthorised');
      }
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || ('Request failed (' + res.status + ')'));
      return data;
    }

    const naira = kobo => '₦' + (Number(kobo) / 100).toLocaleString();
    const pad = n => String(n).padStart(2, '0');

    function isoToLocalInput(iso) {
      const d = new Date(iso);
      return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) +
        'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    }
    function fmtWhen(iso) {
      const d = new Date(iso);
      return d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) +
        ' · ' + d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
    }
    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, c =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function cardHtml(e) {
      const past = new Date(e.event_date).getTime() < Date.now();
      const opp = opponent(e);
      const crest = crestFor(opp);
      const orders = e.paid_orders || 0;
      const crestEl = crest
        ? '<img class="m-crest" width="46" height="46" src="' + crest + '" alt="" loading="lazy" onerror="this.style.visibility=\'hidden\'"/>'
        : '<div class="m-crest ph">' + esc(String(opp || '?').charAt(0).toUpperCase()) + '</div>';
      return '<div class="m-card ' + (e.active ? '' : 'inactive') + '" data-id="' + esc(e.id) + '">' +
        crestEl +
        '<div class="m-main">' +
          '<div class="m-teams">' + esc(e.home_team) + '  vs  ' + esc(e.away_team) + '</div>' +
          '<div class="m-when">' + fmtWhen(e.event_date) + '</div>' +
          '<div class="m-sub">' + esc(e.competition) + ' &nbsp;•&nbsp; ' + esc(e.venue) + '</div>' +
          '<div class="m-prices">' +
            '<span class="chip">VIP ' + naira(e.vip_price_kobo) + '</span>' +
            '<span class="chip">Premium ' + naira(e.premium_price_kobo) + '</span>' +
            '<span class="chip">Regular ' + naira(e.regular_price_kobo) + '</span>' +
          '</div>' +
        '</div>' +
        '<div class="m-side">' +
          '<div class="pills">' +
            '<span class="pill ' + (e.active ? 'on' : 'off') + '">' + (e.active ? 'Live' : 'Hidden') + '</span>' +
            (past ? '<span class="pill past">Past</span>' : '') +
            (orders ? '<span class="pill sold">' + orders + ' sold</span>' : '') +
          '</div>' +
          '<div class="m-actions">' +
            '<button data-act="edit">Edit</button>' +
            '<button data-act="toggle">' + (e.active ? 'Hide' : 'Show') + '</button>' +
            '<button data-act="delete" class="danger">Delete</button>' +
          '</div>' +
        '</div>' +
        '</div>';
    }

    let cache = [];
    async function load() {
      const data = await api('/api/admin/events');
      cache = data.events || [];
      list.innerHTML = cache.length ? cache.map(cardHtml).join('') :
        '<div class="empty-state">No matches yet — add the first one.</div>';
    }

    function openForm(e) {
      form.hidden = false;
      $('f-title').textContent = e ? 'Edit match' : 'New match';
      $('f-id') && ($('f-id').value = e ? e.id : '');
      $('f-home').value = e ? e.home_team : 'Lobi Stars FC';
      $('f-away').value = e ? e.away_team : '';
      $('f-comp').value = e ? e.competition : 'NNL Conference D';
      $('f-venue').value = e ? e.venue : 'McCarthy Stadium, Makurdi';
      $('f-date').value = e ? isoToLocalInput(e.event_date) : '';
      $('f-active').checked = e ? !!e.active : true;
      $('f-vip').value = e ? e.vip_price_kobo / 100 : 0;
      $('f-prem').value = e ? e.premium_price_kobo / 100 : 0;
      $('f-reg').value = e ? e.regular_price_kobo / 100 : 0;
      form._editId = e ? e.id : '';
      form.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    function closeForm() { form.hidden = true; form._editId = ''; }

    form.addEventListener('submit', async ev => {
      ev.preventDefault();
      const localDate = $('f-date').value;
      if (!localDate) return;
      const payload = {
        home_team: $('f-home').value,
        away_team: $('f-away').value,
        competition: $('f-comp').value,
        venue: $('f-venue').value,
        event_date: new Date(localDate).toISOString(),
        active: $('f-active').checked,
        vip_price_kobo: Math.round(Number($('f-vip').value) * 100),
        premium_price_kobo: Math.round(Number($('f-prem').value) * 100),
        regular_price_kobo: Math.round(Number($('f-reg').value) * 100),
      };
      const id = form._editId || '';
      $('f-save').disabled = true;
      try {
        await api(id ? '/api/admin/events/' + id : '/api/admin/events', {
          method: id ? 'PUT' : 'POST',
          body: JSON.stringify(payload),
        });
        closeForm();
        await load();
        showMsg(id ? 'Match updated.' : 'Match created.', true);
      } catch (err) {
        showMsg(err.message, false);
      } finally {
        $('f-save').disabled = false;
      }
    });

    $('f-cancel').addEventListener('click', closeForm);
    $('new-btn').addEventListener('click', () => openForm(null));
    $('refresh').addEventListener('click', () => load().catch(err => showMsg(err.message, false)));

    list.addEventListener('click', async ev => {
      const btn = ev.target.closest('button[data-act]');
      if (!btn) return;
      const id = btn.closest('.m-card').dataset.id;
      const e = cache.find(x => x.id === id);
      if (!e) return;
      const act = btn.dataset.act;

      if (act === 'edit') { openForm(e); return; }

      if (act === 'toggle') {
        try {
          await api('/api/admin/events/' + id, {
            method: 'PUT',
            body: JSON.stringify({
              home_team: e.home_team, away_team: e.away_team, competition: e.competition,
              venue: e.venue, event_date: e.event_date, active: !e.active,
              vip_price_kobo: e.vip_price_kobo, premium_price_kobo: e.premium_price_kobo,
              regular_price_kobo: e.regular_price_kobo,
            }),
          });
          await load();
        } catch (err) { showMsg(err.message, false); }
        return;
      }

      if (act === 'delete') {
        if (!confirm('Delete ' + e.home_team + ' vs ' + e.away_team + '? This cannot be undone.')) return;
        try {
          await api('/api/admin/events/' + id, { method: 'DELETE' });
          await load();
          showMsg('Match deleted.', true);
        } catch (err) { showMsg(err.message, false); }
      }
    });

    async function unlock() {
      const entered = $('code').value.trim();
      if (!entered) return;
      code = entered;
      try {
        await api('/api/admin/events');
        sessionStorage.setItem('ls_admin_code', code);
        gate.style.display = 'none';
        manager.hidden = false;
        gateErr.classList.remove('show');
        await load();
      } catch (err) {
        if (err.message !== 'unauthorised') {
          gateErr.textContent = err.message;
          gateErr.classList.add('show');
        }
      }
    }
    $('unlock').addEventListener('click', unlock);
    $('code').addEventListener('keydown', e => { if (e.key === 'Enter') unlock(); });
    $('lock-btn').addEventListener('click', () => {
      sessionStorage.removeItem('ls_admin_code');
      location.reload();
    });

    if (code) {
      gate.style.display = 'none';
      manager.hidden = false;
      load().catch(() => {});
    }
  })();
  </script>
</Layout>
