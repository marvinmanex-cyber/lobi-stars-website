---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
---
<Layout title="Staff Accounts | Lobi Stars Admin" description="Manage Lobi Stars FC staff accounts." noindex>
  <div class="wrap st">
    <AdminNav current="staff" />
    <div class="stag">Admin</div>
    <h1 class="stitle">Staff <span class="r">Accounts</span></h1>
    <p class="muted st-lede">Only Super Admins can manage staff. Each person's <strong>role</strong> decides which parts of the admin they see and change; the server checks it on every request. Give <strong>Can export fan data</strong> only to people who need to download contact lists.</p>
    <section class="panel st-rolesed" aria-labelledby="rolesH">
      <h2 id="rolesH">Roles and what they include</h2>
      <p class="muted">Each role is a set of permissions. Open a role to see or change what it includes; changes apply to everyone with that role within a minute and are recorded in the Activity Log. Only the Super Admin role manages staff and roles.</p>
      <div id="roles"><p class="muted">Loading…</p></div>
    </section>
    <p class="st-msg" id="msg" role="status" aria-live="polite" hidden></p>

    <form class="panel st-form" id="newForm">
      <h2>Add a staff account</h2>
      <div class="form-row">
        <div class="form-grp"><label class="form-lbl" for="n-name">Name</label><input class="form-inp" id="n-name" required /></div>
        <div class="form-grp"><label class="form-lbl" for="n-email">Email</label><input class="form-inp" id="n-email" type="email" required /></div>
      </div>
      <div class="form-grp"><label class="form-lbl" for="n-role">Role</label><select class="form-sel" id="n-role" required><option value="">Choose a role…</option></select></div>
      <div class="form-grp"><label class="form-lbl" for="n-pass">Temporary password (12+ characters)</label><input class="form-inp" id="n-pass" type="text" minlength="12" required autocomplete="off" /></div>
      <label class="st-check"><input type="checkbox" id="n-must" checked /> They must choose their own password the first time they sign in</label>
      <label class="st-check"><input type="checkbox" id="n-export" /> Can export fan data (download the fan database)</label>
      <button type="submit" class="btn-p">Add staff account</button>
    </form>

    <div class="st-list" id="list"><p class="muted">Loading…</p></div>
  </div>
</Layout>

<style>
  .st { max-width: 980px; padding-top: 40px; padding-bottom: 90px; }
  .st-lede { max-width: 700px; margin-bottom: 20px; }
  .st-msg { padding: 12px 16px; border-radius: 8px; margin: 0 0 16px; }
  .st-msg.ok { background: #E8F7EE; color: #17643A; } .st-msg.err { background: #FDECEC; color: #A3161B; }
  .st-form { margin-bottom: 26px; }
  .st-form h2 { margin: 0 0 14px; font: 400 26px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .st-rolesed { margin: 0 0 26px; }
  .st-rolesed h2 { margin: 0 0 8px; font: 400 26px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .st-rolesed :global(details) { border: 1px solid var(--d4); border-radius: 10px; margin: 8px 0; background: var(--a-card); }
  .st-rolesed :global(summary) { cursor: pointer; padding: 12px 14px; font-weight: 700; display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: baseline; }
  .st-rolesed :global(summary small) { font-weight: 400; color: var(--a-muted, #5B6470); }
  .st-rolesed :global(.rbody) { padding: 0 14px 14px; }
  .st-rolesed :global(fieldset) { border: 0; margin: 10px 0 0; padding: 0; }
  .st-rolesed :global(legend) { font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 6px; }
  .st-rolesed :global(label.perm) { display: flex; gap: 10px; align-items: flex-start; padding: 4px 0; font-size: 14px; }
  .st-rolesed :global(label.perm input) { width: 17px; height: 17px; margin-top: 2px; accent-color: var(--red); flex: none; }
  .st-rolesed :global(.tag) { font-size: 11px; padding: 2px 8px; border-radius: 99px; background: #FFF4E5; color: #7A4B00; font-weight: 700; }
  .st-rolesed :global(.ract) { margin-top: 12px; display: flex; gap: 8px; flex-wrap: wrap; }
  .st-rolesed :global(.ract button) { padding: 8px 14px; border-radius: 8px; border: 1px solid var(--d4); background: var(--a-card); cursor: pointer; font: inherit; font-size: 14px; }
  .st-rolesed :global(.ract button.save) { background: var(--red); color: #fff; border-color: var(--red); font-weight: 700; }
  .st-list :global(select) { padding: 6px 8px; border-radius: 6px; border: 1px solid var(--d4); font: inherit; font-size: 13px; }
  .st-check { display: flex; gap: 10px; align-items: center; margin: 6px 0 16px; font-weight: 600; }
  .st-check input { width: 18px; height: 18px; accent-color: var(--red); }
  .st-list :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; }
  .st-list :global(th), .st-list :global(td) { padding: 10px 12px; border-bottom: 1px solid var(--d4); text-align: left; vertical-align: middle; }
  .st-list :global(thead th) { background: #15181D; color: #fff; font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; }
  .st-list :global(.inactive) { opacity: .55; }
  .st-list :global(button) { margin: 2px 6px 2px 0; padding: 6px 10px; border-radius: 6px; border: 1px solid var(--d4); background: var(--a-card); cursor: pointer; font-size: 13px; }
  .st-list :global(.scroll) { overflow-x: auto; position: relative; }
</style>

<script is:inline>
(function () {
  const code = sessionStorage.getItem('ls_admin_code') || '__session__';
  const $ = id => document.getElementById(id);
  const msg = $('msg');
  const show = (t, ok) => { msg.textContent = t; msg.className = 'st-msg ' + (ok ? 'ok' : 'err'); msg.hidden = false; };
  const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  async function api(path, opts = {}) {
    const res = await fetch(path, { ...opts, headers: { 'Content-Type': 'application/json', 'x-admin-code': code } });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || 'Request failed');
    return data;
  }
  async function load() {
    try {
      const { staff, roles } = await api('/api/admin/staff');
      if ($('n-role').options.length < 2) $('n-role').insertAdjacentHTML('beforeend', roles.filter(r => !r.legacy).map(r => `<option value="${esc(r.id)}">${esc(r.label)}</option>`).join(''));
      const roleSel = s => `<select data-role aria-label="Role for ${esc(s.name)}">${roles.map(r => `<option value="${esc(r.id)}"${r.id === s.role ? ' selected' : ''}>${esc(r.label)}</option>`).join('')}</select>`;
      $('list').innerHTML = staff.length ? '<div class="scroll"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Can export</th><th>Two-step login</th><th>Last login</th><th>Signed in now</th><th></th></tr></thead><tbody>' +
        staff.map(s => `<tr class="${s.active ? '' : 'inactive'}" data-id="${esc(s.id)}"><td>${esc(s.name)}${s.active ? '' : ' (deactivated)'}</td><td>${esc(s.email)}</td>` +
          `<td>${roleSel(s)}</td><td>${s.can_export_fan_data ? 'Yes' : 'No'}</td><td>${s.totp_enabled ? '🔐 On' : 'Off'}</td><td>${s.last_login_at ? esc(s.last_login_at) + ' UTC' : 'Never'}${s.must_change_password ? '<br><small>Must choose a new password</small>' : ''}${s.locked_until ? '<br><strong>🔒 Locked</strong>' : ''}</td><td>${s.signed_in ? `${s.signed_in} device${s.signed_in === 1 ? '' : 's'}` : '—'}</td><td>` +
          `<button data-act="export">${s.can_export_fan_data ? 'Remove export' : 'Allow export'}</button>` +
          `<button data-act="active">${s.active ? 'Deactivate' : 'Reactivate'}</button><button data-act="password">Reset password</button>${s.totp_enabled ? '<button data-act="twostep">Reset two-step</button>' : ''}${s.locked_until ? '<button data-act="unlock">Unlock</button>' : ''}${s.signed_in ? '<button data-act="signout">Sign out everywhere</button>' : ''}</td></tr>`).join('') +
        '</tbody></table></div>' : '<div class="empty-state"><b>🧑‍💼</b><p>No staff accounts yet. Add the first one above.</p></div>';
      $('list')._staff = staff;
    } catch (e) { $('list').innerHTML = `<p class="muted">${esc(e.message)}</p>`; }
  }
  $('list').addEventListener('click', async e => {
    const b = e.target.closest('button[data-act]'); if (!b) return;
    const id = b.closest('tr').dataset.id; const s = $('list')._staff.find(x => x.id === id);
    const body = {};
    if (b.dataset.act === 'export') body.canExport = !s.can_export_fan_data;
    if (b.dataset.act === 'active') { if (s.active && !confirm(`Deactivate ${s.name}? They will be signed out on every device straight away.`)) return; body.active = !s.active; }
    if (b.dataset.act === 'unlock') body.unlock = true;
    if (b.dataset.act === 'signout') { if (!confirm(`Sign ${s.name} out on every device?`)) return; body.signOut = true; }
    if (b.dataset.act === 'twostep') { if (!confirm(`Switch off two-step login for ${s.name}? Use this if they lost their phone; they should set it up again in My account.`)) return; body.resetTwoStep = true; }
    if (b.dataset.act === 'password') { const p = prompt(`New temporary password for ${s.name} (12+ characters). They will be signed out and must choose their own password when they next sign in:`); if (!p) return; body.password = p; body.mustChange = true; }
    try { await api(`/api/admin/staff/${encodeURIComponent(id)}`, { method: 'PUT', body: JSON.stringify(body) }); show('Saved.', true); load(); }
    catch (err) { show(err.message, false); }
  });
  $('list').addEventListener('change', async e => {
    const sel = e.target.closest('select[data-role]'); if (!sel) return;
    try { await api(`/api/admin/staff/${encodeURIComponent(sel.closest('tr').dataset.id)}`, { method: 'PUT', body: JSON.stringify({ role: sel.value }) }); show('Role saved. It applies the next time they open a page.', true); load(); }
    catch (err) { show(err.message, false); }
  });
  $('newForm').addEventListener('submit', async e => {
    e.preventDefault();
    try {
      await api('/api/admin/staff', { method: 'POST', body: JSON.stringify({ name: $('n-name').value, email: $('n-email').value, password: $('n-pass').value, role: $('n-role').value, canExport: $('n-export').checked, mustChange: $('n-must').checked }) });
      show('Staff account created. Share the email and temporary password with them privately.', true);
      e.target.reset(); load();
    } catch (err) { show(err.message, false); }
  });
  // Roles and permissions (Super Admin).
  async function loadRoles() {
    try {
      const { permissions, roles } = await api('/api/admin/roles');
      $('roles').innerHTML = roles.map(r => {
        const has = new Set(r.permissions);
        const groups = permissions.map(g => `<fieldset><legend>${esc(g.group)}</legend>${g.items.map(p =>
          `<label class="perm"><input type="checkbox" value="${esc(p.id)}"${has.has(p.id) ? ' checked' : ''}${r.locked || p.id === 'staff.manage' ? ' disabled' : ''} /> <span>${esc(p.label)}</span></label>`).join('')}</fieldset>`).join('');
        return `<details data-role="${esc(r.id)}"><summary>${esc(r.label)} <small>${esc(r.about || '')}</small>${r.changed ? '<span class="tag">Changed</span>' : ''}${r.legacy ? '<span class="tag">Old role</span>' : ''}${r.readOnly ? '<span class="tag">Read only</span>' : ''}</summary>
          <div class="rbody">${r.locked ? '<p class="muted">The Super Admin role always includes everything.</p>' : ''}${groups}
          ${r.locked ? '' : `<div class="ract"><button type="button" class="save" data-save>Save ${esc(r.label)}</button>${r.changed ? '<button type="button" data-reset>Back to the default</button>' : ''}</div>`}</div></details>`;
      }).join('');
    } catch (e) { $('roles').innerHTML = `<p class="muted">${esc(e.message)}</p>`; }
  }
  $('roles').addEventListener('click', async e => {
    const btn = e.target.closest('button[data-save], button[data-reset]'); if (!btn) return;
    const d = btn.closest('details'); const id = d.dataset.role;
    const body = btn.hasAttribute('data-reset') ? { id, reset: true } : { id, permissions: [...d.querySelectorAll('input:checked')].map(i => i.value) };
    if (body.reset && !confirm('Put this role back to its default permissions?')) return;
    try { await api('/api/admin/roles', { method: 'PUT', body: JSON.stringify(body) }); show('Role saved. It applies within a minute.', true); await loadRoles(); document.querySelector(`#roles details[data-role="${id}"]`)?.setAttribute('open', ''); }
    catch (err) { show(err.message, false); }
  });
  load();
  loadRoles();
})();
</script>
