---
// Settings › Data Backup (Super Admin only): download everything the website
// stores (fans, messages, orders, tickets, votes, settings…) as one Excel
// workbook or a JSON file, to keep a private copy.
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
---
<Layout title="Data Backup | Lobi Stars Admin" description="Download a backup of the website data." noindex>
  <div class="wrap bk">
    <AdminNav current="backup" />
    <div class="stag">Settings</div>
    <h1 class="stitle">Data <span class="r">Backup</span></h1>
    <p class="muted bk-lede">Download everything the website stores (fans and contacts, messages, newsletter, tickets, food orders, votes, predictions, matches and settings) as one file. Keep a copy somewhere safe <b>at least once a month</b> and before big changes. Passwords, sign-in links, two-step login secrets and stored pictures are never included.</p>
    <p class="bk-warn">🔒 The backup contains fans' personal data. Store it privately (not in email or shared chats) and delete old copies you no longer need.</p>
    <p class="bk-msg" id="msg" role="status" aria-live="polite" hidden></p>
    <div class="bk-acts">
      <button type="button" class="btn-p" id="xlsx">⬇ Download backup (Excel)</button>
      <button type="button" class="btn-o" id="json">⬇ Download backup (JSON, for the website manager)</button>
    </div>
    <div class="bk-prog" id="prog" hidden><div class="bk-bar"><span id="bar"></span></div><p id="progText"></p></div>

    <section class="panel"><h2>Past backups</h2><div id="history"><p class="muted">Loading…</p></div></section>
    <section class="panel"><h2>What is included</h2><div class="scroll" id="tables"><p class="muted">Loading…</p></div></section>
  </div>
</Layout>

<style>
  .bk { max-width: 1000px; padding-top: 20px; padding-bottom: 60px; }
  .bk-lede { max-width: 860px; }
  .bk-warn { padding: 12px 16px; border-radius: 12px; background: #FFF7E6; color: #7A4B00; border: 1px solid #F6D58E; }
  :global(body.admin-dark) .bk-warn { background: #3A2E12; color: #F6D58E; border-color: #5A4718; }
  .bk-msg { padding: 12px 16px; border-radius: 10px; }
  .bk-msg.ok { background: #E8F7EE; color: #17643A; } .bk-msg.err { background: #FDECEC; color: #A3161B; }
  .bk-acts { display: flex; gap: 10px; flex-wrap: wrap; margin: 14px 0; }
  .bk-prog { margin: 0 0 16px; }
  .bk-bar { height: 12px; border-radius: 999px; background: var(--a-soft); border: 1px solid var(--a-line); overflow: hidden; }
  .bk-bar span { display: block; height: 100%; width: 0; background: #16A34A; transition: width .2s; }
  .panel { padding: 18px; margin-bottom: 16px; }
  .panel h2 { margin: 0 0 10px; font: 400 26px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .bk :global(table) { width: 100%; border-collapse: separate; border-spacing: 0; }
  .bk :global(th), .bk :global(td) { padding: 8px 12px; text-align: left; font-size: 14px; }
</style>

<script>
  import { buildXlsx } from '../../../functions/api/_lib/xlsx.js';
  const code = sessionStorage.getItem('ls_admin_code') || '__session__';
  const H = { 'x-admin-code': code, 'Content-Type': 'application/json' };
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const wat = (iso: string) => new Date(iso.includes('T') ? iso : iso.replace(' ', 'T') + 'Z').toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Lagos' });
  let tables: { table: string; rows: number; columns: number }[] = [];
  const msg = (t: string, ok: boolean) => { $('msg').textContent = t; $('msg').className = 'bk-msg ' + (ok ? 'ok' : 'err'); $('msg').hidden = false; };
  async function get(path: string) {
    const r = await fetch(path, { headers: H, cache: 'no-store' });
    if (r.status === 401) { location.href = '/admin/login/?next=/admin/backup/'; throw new Error('Please sign in again.'); }
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || 'Request failed');
    return d;
  }
  async function load() {
    try {
      const d = await get('/api/admin/backup');
      tables = d.tables;
      $('tables').innerHTML = `<table><thead><tr><th>Table</th><th>Rows</th><th>Columns</th></tr></thead><tbody>${tables.map(t => `<tr><td>${esc(t.table)}</td><td>${t.rows.toLocaleString('en-NG')}</td><td>${t.columns}</td></tr>`).join('')}</tbody></table>`;
      $('history').innerHTML = d.history.length ? `<table><thead><tr><th>When (WAT)</th><th>By</th><th>What</th></tr></thead><tbody>${d.history.map((h: any) => `<tr><td>${esc(wat(h.ts))}</td><td>${esc(h.staff_name)}</td><td>${esc(h.detail)}</td></tr>`).join('')}</tbody></table>`
        : '<p class="muted">No backup has been downloaded yet. Download one now.</p>';
    } catch (err) { msg((err as Error).message, false); }
  }
  async function backup(format: 'xlsx' | 'json') {
    const btns = [$('xlsx'), $('json')] as HTMLButtonElement[]; btns.forEach(b => { b.disabled = true; });
    $('prog').hidden = false;
    const total = tables.reduce((s, t) => s + t.rows, 0) || 1;
    let done = 0;
    const data: Record<string, { columns: string[]; rows: unknown[][] }> = {};
    try {
      for (const t of tables) {
        data[t.table] = { columns: [], rows: [] };
        let offset: number | null = 0;
        while (offset !== null) {
          const d: any = await get(`/api/admin/backup?table=${encodeURIComponent(t.table)}&offset=${offset}`);
          data[t.table].columns = d.columns; data[t.table].rows.push(...d.rows);
          done += d.rows.length; offset = d.next;
          ($('bar') as HTMLElement).style.width = `${Math.min(100, Math.round(done / total * 100))}%`;
          $('progText').textContent = `Reading ${t.table}… ${done.toLocaleString('en-NG')} of about ${total.toLocaleString('en-NG')} rows`;
        }
      }
      const stamp = new Date().toISOString().slice(0, 10);
      let blob: Blob;
      if (format === 'json') {
        const body = { site: 'lobistarsfc.com', createdAt: new Date().toISOString(), tables: Object.fromEntries(Object.entries(data).map(([n, t]) => [n, t.rows.map(r => Object.fromEntries(t.columns.map((c, i) => [c, r[i]])))])) };
        blob = new Blob([JSON.stringify(body)], { type: 'application/json' });
      } else {
        const sheets = [{ name: 'About this backup', columns: ['Item', 'Value'], rows: [
          ['Website', 'lobistarsfc.com'], ['Created', new Date().toLocaleString('en-GB', { timeZone: 'Africa/Lagos' }) + ' WAT'], ['Tables', tables.length], ['Rows', done],
          ['Left out', 'Passwords, sign-in links, two-step login secrets, push keys, private links and stored pictures'],
          ['Keep it safe', "This file contains fans' personal data. Store it privately and delete old copies."],
        ] }, ...Object.entries(data).filter(([, t]) => t.columns.length).map(([n, t]) => ({ name: n, columns: t.columns, rows: t.rows }))];
        blob = new Blob([buildXlsx(sheets)], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
      }
      const url = URL.createObjectURL(blob);
      const a = Object.assign(document.createElement('a'), { href: url, download: `lobi-stars-backup-${stamp}.${format}` });
      document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(url), 5000);
      await fetch('/api/admin/backup', { method: 'POST', headers: H, body: JSON.stringify({ format, tables: tables.length, rows: done }) });
      msg(`Backup downloaded: ${tables.length} tables, ${done.toLocaleString('en-NG')} rows. Store it somewhere private.`, true);
      load();
    } catch (err) { msg(`The backup could not be completed: ${(err as Error).message}`, false); }
    finally { btns.forEach(b => { b.disabled = false; }); $('prog').hidden = true; }
  }
  $('xlsx').addEventListener('click', () => backup('xlsx'));
  $('json').addEventListener('click', () => backup('json'));
  load();
</script>
