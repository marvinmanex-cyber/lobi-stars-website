---
// Settings › Data Backup (Super Admin only): download everything the website
// stores (fans, messages, orders, tickets, votes, settings…) as one Excel
// workbook or a JSON file, to keep a private copy.
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
---
<Layout title="Data Backup | Lobi Stars Admin" description="Download a backup of the website data." noindex>
  <div class="wrap bk">
    <AdminNav current="backup" />
    <div class="stag">Settings</div>
    <h1 class="stitle">Data <span class="r">Backup</span></h1>
    <p class="muted bk-lede">Download everything the website stores (fans and contacts, messages, newsletter, tickets, food orders, votes, predictions, matches and settings) as one file. Keep a copy somewhere safe <b>at least once a month</b> and before big changes. Passwords, sign-in links, two-step login secrets and stored pictures are never included.</p>
    <p class="bk-warn">🔒 The backup contains fans' personal data. Store it privately (not in email or shared chats) and delete old copies you no longer need.</p>
    <p class="bk-msg" id="msg" role="status" aria-live="polite" hidden></p>
    <div class="bk-acts">
      <button type="button" class="btn-p" id="xlsx">⬇ Download backup (Excel)</button>
      <button type="button" class="btn-o" id="json">⬇ Download backup (JSON, for the website manager)</button>
    </div>
    <div class="bk-prog" id="prog" hidden><div class="bk-bar"><span id="bar"></span></div><p id="progText"></p></div>

    <section class="panel"><h2>Automatic backups</h2>
      <p class="muted">Every night from 02:00 the website saves an <strong>encrypted</strong> copy of the database in separate storage, and copies the programme files every Sunday. Backups are kept for 30 days. If a backup fails, the Super Admin who receives the security emails is emailed.</p>
      <p id="autoState" class="bk-state">Loading…</p>
      <div class="bk-acts"><button type="button" class="btn-o" id="autoNow">Start a backup now</button></div>
      <div class="scroll" id="autoList"></div>
      <p class="bk-small" id="offsite"></p>
      <form id="offsiteForm" class="bk-off">
        <label>Email the encrypted copy every Monday to<input class="form-inp" type="email" name="email" id="offsiteEmail" placeholder="e.g. dkakaan2@gmail.com" autocomplete="off" /></label>
        <button type="submit" class="btn-o">Save</button>
        <button type="button" class="btn-o" id="offsiteNow">Send one now</button>
      </form>
      <p class="muted bk-small">A copy outside Cloudflare is what lets the website be rebuilt if the Cloudflare account were ever lost (DISASTER-RECOVERY.md). The weekly email does it for you, and a small Google script can save each one into Google Drive. You can also press <strong>Download encrypted copy</strong> yourself. The files are locked with the backup key: keep the key somewhere else.</p>
      <p class="muted bk-small">To restore: download the backup for the day you need (a fresh two-step code is asked for) and give the file to the developer, with the steps in the Staff guide (section 25, Data backup). For the last 7 days Cloudflare can also put the whole database back to any minute.</p>
    </section>
    <section class="panel"><h2>Past backups</h2><div id="history"><p class="muted">Loading…</p></div></section>
    <section class="panel"><h2>What is included</h2><div class="scroll" id="tables"><p class="muted">Loading…</p></div></section>
  </div>
</Layout>

<style>
  .bk { max-width: 1000px; padding-top: 20px; padding-bottom: 60px; }
  .bk-lede { max-width: 860px; }
  .bk-warn { padding: 12px 16px; border-radius: 12px; background: #FFF7E6; color: #7A4B00; border: 1px solid #F6D58E; }
  :global(body.admin-dark) .bk-warn { background: #3A2E12; color: #F6D58E; border-color: #5A4718; }
  .bk-msg { padding: 12px 16px; border-radius: 10px; }
  .bk-msg.ok { background: #E8F7EE; color: #17643A; } .bk-msg.err { background: #FDECEC; color: #A3161B; }
  .bk-acts { display: flex; gap: 10px; flex-wrap: wrap; margin: 14px 0; }
  .bk-prog { margin: 0 0 16px; }
  .bk-bar { height: 12px; border-radius: 999px; background: var(--a-soft); border: 1px solid var(--a-line); overflow: hidden; }
  .bk-bar span { display: block; height: 100%; width: 0; background: #16A34A; transition: width .2s; }
  .panel { padding: 18px; margin-bottom: 16px; }
  .bk-off { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; margin-top: 14px; } .bk-off label { display: grid; gap: 4px; font-size: 14px; flex: 1 1 260px; }
  .bk-state { font-weight: 700; } .bk-state.bad, .bk-small.bad { color: #A3161B; } .bk-small.bad { font-weight: 700; } .bk-small { font-size: 13px; margin-top: 10px; }
  .bk :global(td button) { padding: 6px 10px; border-radius: 6px; border: 1px solid var(--a-line); background: var(--a-card); cursor: pointer; font-size: 13px; }
  .panel h2 { margin: 0 0 10px; font: 400 26px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .bk :global(table) { width: 100%; border-collapse: separate; border-spacing: 0; }
  .bk :global(th), .bk :global(td) { padding: 8px 12px; text-align: left; font-size: 14px; }
</style>

<script>
  import { buildXlsx } from '../../../functions/api/_lib/xlsx.js';
  const code = sessionStorage.getItem('ls_admin_code') || '__session__';
  const H = { 'x-admin-code': code, 'Content-Type': 'application/json' };
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const wat = (iso: string) => new Date(iso.includes('T') ? iso : iso.replace(' ', 'T') + 'Z').toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Lagos' });
  let tables: { table: string; rows: number; columns: number }[] = [];
  const msg = (t: string, ok: boolean) => { $('msg').textContent = t; $('msg').className = 'bk-msg ' + (ok ? 'ok' : 'err'); $('msg').hidden = false; };
  async function get(path: string) {
    const r = await fetch(path, { headers: H, cache: 'no-store' });
    if (r.status === 401) { location.href = '/admin/login/?next=/admin/backup/'; throw new Error('Please sign in again.'); }
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || 'Request failed');
    return d;
  }
  async function load() {
    try {
      const d = await get('/api/admin/backup');
      tables = d.tables;
      $('tables').innerHTML = `<table><thead><tr><th>Table</th><th>Rows</th><th>Columns</th></tr></thead><tbody>${tables.map(t => `<tr><td>${esc(t.table)}</td><td>${t.rows.toLocaleString('en-NG')}</td><td>${t.columns}</td></tr>`).join('')}</tbody></table>`;
      $('history').innerHTML = d.history.length ? `<table><thead><tr><th>When</th><th>By</th><th>What</th></tr></thead><tbody>${d.history.map((h: any) => `<tr><td>${esc(wat(h.ts))}</td><td>${esc(h.staff_name)}</td><td>${esc(h.detail)}</td></tr>`).join('')}</tbody></table>`
        : '<p class="muted">No backup has been downloaded yet. Download one now.</p>';
    } catch (err) { msg((err as Error).message, false); }
  }
  async function backup(format: 'xlsx' | 'json') {
    const btns = [$('xlsx'), $('json')] as HTMLButtonElement[]; btns.forEach(b => { b.disabled = true; });
    $('prog').hidden = false;
    const total = tables.reduce((s, t) => s + t.rows, 0) || 1;
    let done = 0;
    const data: Record<string, { columns: string[]; rows: unknown[][] }> = {};
    try {
      for (const t of tables) {
        data[t.table] = { columns: [], rows: [] };
        let offset: number | null = 0;
        while (offset !== null) {
          const d: any = await get(`/api/admin/backup?table=${encodeURIComponent(t.table)}&offset=${offset}`);
          data[t.table].columns = d.columns; data[t.table].rows.push(...d.rows);
          done += d.rows.length; offset = d.next;
          ($('bar') as HTMLElement).style.width = `${Math.min(100, Math.round(done / total * 100))}%`;
          $('progText').textContent = `Reading ${t.table}… ${done.toLocaleString('en-NG')} of about ${total.toLocaleString('en-NG')} rows`;
        }
      }
      const stamp = new Date().toISOString().slice(0, 10);
      let blob: Blob;
      if (format === 'json') {
        const body = { site: 'lobistarsfc.com', createdAt: new Date().toISOString(), tables: Object.fromEntries(Object.entries(data).map(([n, t]) => [n, t.rows.map(r => Object.fromEntries(t.columns.map((c, i) => [c, r[i]])))])) };
        blob = new Blob([JSON.stringify(body)], { type: 'application/json' });
      } else {
        const sheets = [{ name: 'About this backup', columns: ['Item', 'Value'], rows: [
          ['Website', 'lobistarsfc.com'], ['Created', new Date().toLocaleString('en-GB', { timeZone: 'Africa/Lagos' })], ['Tables', tables.length], ['Rows', done],
          ['Left out', 'Passwords, sign-in links, two-step login secrets, push keys, private links and stored pictures'],
          ['Keep it safe', "This file contains fans' personal data. Store it privately and delete old copies."],
        ] }, ...Object.entries(data).filter(([, t]) => t.columns.length).map(([n, t]) => ({ name: n, columns: t.columns, rows: t.rows }))];
        blob = new Blob([buildXlsx(sheets)], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
      }
      const url = URL.createObjectURL(blob);
      const a = Object.assign(document.createElement('a'), { href: url, download: `lobi-stars-backup-${stamp}.${format}` });
      document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(url), 5000);
      await fetch('/api/admin/backup', { method: 'POST', headers: H, body: JSON.stringify({ format, tables: tables.length, rows: done }) });
      msg(`Backup downloaded: ${tables.length} tables, ${done.toLocaleString('en-NG')} rows. Store it somewhere private.`, true);
      load();
    } catch (err) { msg(`The backup could not be completed: ${(err as Error).message}`, false); }
    finally { btns.forEach(b => { b.disabled = false; }); $('prog').hidden = true; }
  }
  // Automatic backups.
  async function loadAuto() {
    try {
      const d: any = await get('/api/admin/backup?auto=status');
      const st = $('autoState');
      if (!d.ready) { st.textContent = 'Not switched on yet: the storage and key need setting up (developer).'; st.className = 'bk-state bad'; ($('autoNow') as HTMLButtonElement).hidden = true; return; }
      const kb = (b: number) => `${Math.max(1, Math.round(b / 1024)).toLocaleString('en-NG')} KB`;
      st.className = 'bk-state' + (d.error ? ' bad' : '');
      st.textContent = d.running ? `A backup is running now (${d.running.left} tables to go).`
        : d.error ? `The last backup failed (${wat(d.error.at)}): ${d.error.error}`
        : d.last ? `Last backup: ${d.last.day} · ${d.last.tables} tables · ${Number(d.last.rows).toLocaleString('en-NG')} rows · ${kb(d.last.bytes)} encrypted · finished ${wat(d.last.at)}`
        : 'No automatic backup yet: the first runs tonight from 02:00 (or press Start a backup now).';
      $('autoList').innerHTML = d.backups.length ? `<table><thead><tr><th>Day</th><th>Tables</th><th>Rows</th><th></th></tr></thead><tbody>${d.backups.map((b: any) =>
        `<tr><td>${esc(b.day)}</td><td>${b.complete ? b.tables : b.complete === false ? 'not finished' : ''}</td><td>${b.complete ? Number(b.rows).toLocaleString('en-NG') : ''}</td><td>${b.complete ? `<button type="button" data-day="${esc(b.day)}">Download for restoring</button> <button type="button" data-raw="${esc(b.day)}">Download encrypted copy</button>` : ''}</td></tr>`).join('')}</tbody></table>` : '';
      $('offsite').textContent = d.offsiteAt ? `Last encrypted copy kept outside Cloudflare: ${wat(d.offsiteAt)}${Date.now() - Date.parse(d.offsiteAt) > 35 * 864e5 ? ' (more than a month ago: download a new one)' : ''}.` : 'No encrypted copy has been kept outside Cloudflare yet: download one now and once a month.';
      $('offsiteEmail').value = d.offsiteEmail || '';
      $('offsite').className = 'bk-small' + (!d.offsiteAt || Date.now() - Date.parse(d.offsiteAt) > 35 * 864e5 ? ' bad' : ' muted');
    } catch (err) { msg((err as Error).message, false); }
  }
  $('autoNow').addEventListener('click', async () => {
    try { await fetch('/api/admin/backup', { method: 'POST', headers: H, body: JSON.stringify({ action: 'backup_now' }) }).then(async r => { const d = await r.json(); if (!r.ok) throw new Error(d.error); }); msg('Backup started. It finishes over the next few minutes.', true); loadAuto(); }
    catch (err) { msg((err as Error).message, false); }
  });
  $('offsiteForm').addEventListener('submit', async e => {
    e.preventDefault();
    try { const r = await fetch('/api/admin/backup', { method: 'POST', headers: H, body: JSON.stringify({ action: 'offsite_email', email: $('offsiteEmail').value }) }); const d = await r.json(); if (!r.ok) throw new Error(d.error); msg($('offsiteEmail').value ? 'Saved: the encrypted copy is emailed every Monday.' : 'The weekly email is off.', true); loadAuto(); }
    catch (err) { msg((err as Error).message, false); }
  });
  $('offsiteNow').addEventListener('click', async () => {
    try { const r = await fetch('/api/admin/backup', { method: 'POST', headers: H, body: JSON.stringify({ action: 'offsite_send_now' }) }); const d = await r.json(); if (!r.ok) throw new Error(d.error); msg(`The encrypted backup of ${d.day} was emailed to ${d.to}.`, true); loadAuto(); }
    catch (err) { msg((err as Error).message, false); }
  });
  $('autoList').addEventListener('click', async e => {
    // The whole backup, still encrypted, to keep outside Cloudflare (Google Drive, a USB stick).
    const raw = (e.target as HTMLElement).closest('button[data-raw]') as HTMLButtonElement | null;
    if (raw) {
      raw.disabled = true;
      try {
        const r = await fetch(`/api/admin/backup?autoraw=${raw.dataset.raw}`, { headers: H });
        if (!r.ok) throw new Error((await r.json().catch(() => ({}))).error || 'Download failed');
        const url = URL.createObjectURL(await r.blob());
        const a = Object.assign(document.createElement('a'), { href: url, download: `lobi-stars-encrypted-backup-${raw.dataset.raw}.json` });
        document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(url), 5000);
        msg('Encrypted copy downloaded. Keep it outside Cloudflare (for example Google Drive or a USB stick). It can only be opened with the backup key.', true);
        loadAuto();
      } catch (err) { msg((err as Error).message, false); }
      finally { raw.disabled = false; }
      return;
    }
    const b = (e.target as HTMLElement).closest('button[data-day]') as HTMLButtonElement | null; if (!b) return;
    const day = b.dataset.day!; b.disabled = true;
    try {
      const man: any = await get(`/api/admin/backup?autoday=${day}`);
      const out: Record<string, Record<string, unknown>[]> = {};
      let n = 0;
      for (const p of man.parts) {
        const part: any = await get(`/api/admin/backup?autopart=${encodeURIComponent(p.key)}`);
        (out[part.table] ||= []).push(...part.rows.map((r: unknown[]) => Object.fromEntries(part.columns.map((c: string, i: number) => [c, r[i]]))));
        n += part.rows.length;
        $('progText').textContent = `Reading ${part.table}… ${n.toLocaleString('en-NG')} rows`; $('prog').hidden = false;
      }
      const blob = new Blob([JSON.stringify({ site: 'lobistarsfc.com', createdAt: day, automatic: true, tables: out })], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = Object.assign(document.createElement('a'), { href: url, download: `lobi-stars-backup-${day}-restore.json` });
      document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(url), 5000);
      await fetch('/api/admin/backup', { method: 'POST', headers: H, body: JSON.stringify({ action: 'restore_download', day, rows: n }) });
      msg(`Backup of ${day} downloaded (${n.toLocaleString('en-NG')} rows). Keep it private.`, true);
    } catch (err) { msg((err as Error).message, false); }
    finally { b.disabled = false; $('prog').hidden = true; }
  });
  loadAuto();
  $('xlsx').addEventListener('click', () => backup('xlsx'));
  $('json').addEventListener('click', () => backup('json'));
  load();
</script>
