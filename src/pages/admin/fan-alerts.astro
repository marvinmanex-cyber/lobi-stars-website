---
// Matchday › Fan Match Alerts: phone notifications for fans who turned on
// "🔔 Match alerts" (radio show / commentary on air, kick-off, goals,
// half-time, full time). Switch automatic alerts on or off, send an alert by
// hand (e.g. "Pre-match show starts in 10 minutes") and see what was sent.
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
---
<Layout title="Fan Match Alerts | Lobi Stars Admin" description="Match-day notifications for fans." noindex>
  <div class="wrap fa">
    <AdminNav current="fan-alerts" />
    <header class="fa-head">
      <div><div class="stag">Matchday</div><h1 class="stitle">Fan Match <span class="r">Alerts</span></h1></div>
      <p class="fa-lede">Fans who turn on <b>🔔 Match alerts</b> (homepage, fixtures, match and commentary pages) get a notification on their phone. Most alerts go out by themselves; you can also send one now.</p>
    </header>
    <p class="fa-msg" id="msg" role="status" aria-live="polite" hidden></p>
    <p class="fa-warn" id="warn" hidden></p>

    <section class="fa-stats" id="stats" aria-label="Fans signed up"></section>

    <div class="fa-grid">
      <section class="fa-card" aria-labelledby="sendH">
        <h2 id="sendH">Send an alert now</h2>
        <p class="fa-sub">Pick a ready-made alert or write your own.</p>
        <div class="fa-presets" id="presets">
          <button type="button" data-preset="pre">🎙️ Pre-match show starting</button>
          <button type="button" data-preset="comm">🎙️ Commentary starting</button>
          <button type="button" data-preset="lineup">📋 Team line-up is out</button>
          <button type="button" data-preset="tickets">🎟️ Tickets on sale</button>
        </div>
        <form id="send" class="fa-form">
          <label>Title<input name="title" maxlength="100" required placeholder="🎙️ Pre-match show starts in 10 minutes" /></label>
          <label>Message<textarea name="body" maxlength="200" rows="2" placeholder="Build-up and team news on Lobi Stars FC Live."></textarea></label>
          <div class="fa-2">
            <label>Opens<select name="url">
              <option value="/commentary/">Live commentary</option>
              <option value="/fixtures/">Fixtures</option>
              <option value="/tickets/">Tickets</option>
              <option value="/news/">News</option>
              <option value="/">Homepage</option>
            </select></label>
            <label>Send to fans who chose<select name="category"></select></label>
          </div>
          <div class="fa-actions"><span class="fa-count" id="sendCount"></span><button class="btn-p" type="submit">Send alert</button></div>
        </form>
      </section>

      <section class="fa-card" aria-labelledby="autoH">
        <h2 id="autoH">Automatic alerts</h2>
        <p class="fa-sub">Sent once per match, as it happens. Switch off any you don't want.</p>
        <form id="auto" class="fa-switches"></form>
        <p class="fa-note">The radio alert goes out when Lobi Stars FC Live goes on air (it says "Pre-match show is live" if that's before kick-off). Kick-off and full time come from the <b>Start Match</b> / <b>Full Time</b> buttons in Live Match Control; goals and half-time from saving the score and status there.</p>
      </section>
    </div>

    <section class="fa-card" aria-labelledby="logH">
      <div class="fa-cardhead"><h2 id="logH">Recent alerts</h2><button type="button" class="btn-o sm" id="refresh">↻ Refresh</button></div>
      <div id="log"><p class="muted">Loading…</p></div>
    </section>
  </div>
</Layout>

<style>
  .fa { max-width: 1200px; padding-top: 20px; padding-bottom: 60px; }
  .fa-head { display: grid; grid-template-columns: auto 1fr; gap: 8px 28px; align-items: end; margin-bottom: 16px; }
  .fa-lede { margin: 0; color: var(--a-muted); font-size: 15px; line-height: 1.55; max-width: 640px; }
  .fa-msg { position: fixed; left: 50%; transform: translateX(-50%); bottom: 18px; z-index: 1500; width: max-content; max-width: calc(100vw - 32px); padding: 12px 16px; border-radius: 12px; margin: 0; box-shadow: 0 14px 34px rgba(0,0,0,.22); font-weight: 600; }
  .fa-msg.ok { background: #E8F7EE; color: #17643A; } .fa-msg.err { background: #FDECEC; color: #A3161B; }
  .fa-warn { margin: 0 0 14px; padding: 12px 16px; border-radius: 12px; background: #FFF7E6; border: 1px solid #F6D58E; color: #7A4B00; }
  :global(body.admin-dark) .fa-warn { background: #3A2E12; color: #F6D58E; border-color: #5A4718; }
  .fa-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 16px; }
  .fa :global(.fa-stat) { background: var(--a-card); border: 1px solid var(--a-line); border-radius: 14px; padding: 14px 16px; border-top: 4px solid var(--c); }
  .fa :global(.fa-stat b) { display: block; font: 400 34px/1 'Bebas Neue', sans-serif; color: var(--a-ink); }
  .fa :global(.fa-stat span) { font-size: 13px; color: var(--a-muted); }
  .fa-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 16px; align-items: start; margin-bottom: 16px; }
  .fa-card { background: var(--a-card); border: 1px solid var(--a-line); border-radius: 16px; padding: 18px 20px; box-shadow: 0 6px 18px rgba(15,17,21,.04); }
  .fa-card h2 { margin: 0 0 4px; font: 700 19px/1.2 'Barlow', sans-serif; color: var(--a-ink); }
  .fa-cardhead { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 10px; }
  .fa-sub { margin: 0 0 14px; color: var(--a-muted); font-size: 14px; }
  .fa-presets { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
  .fa-presets button { min-height: 38px; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--a-line); background: var(--a-soft); color: var(--a-ink); font-size: 13px; font-weight: 700; cursor: pointer; }
  .fa-presets button:hover { border-color: #E31E24; }
  .fa-form { display: grid; gap: 12px; }
  .fa-form label { display: grid; gap: 5px; font-size: 13px; font-weight: 700; color: var(--a-muted); }
  .fa-form input, .fa-form textarea, .fa-form select { min-height: 42px; border: 1px solid var(--a-line); border-radius: 10px; padding: 8px 10px; background: var(--a-card); color: var(--a-ink); font: inherit; font-size: 15px; font-weight: 400; width: 100%; min-width: 0; }
  .fa-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .fa-actions { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding-top: 4px; }
  .fa-count { color: var(--a-muted); font-size: 13px; }
  .fa-switches { display: grid; gap: 2px; }
  .fa :global(.fa-sw) { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 11px 2px; border-bottom: 1px solid var(--a-line); cursor: pointer; }
  .fa :global(.fa-sw:last-child) { border-bottom: 0; }
  .fa :global(.fa-sw b) { display: block; font-size: 15px; color: var(--a-ink); }
  .fa :global(.fa-sw small) { color: var(--a-muted); font-size: 12px; }
  .fa :global(.fa-sw input) { appearance: none; width: 46px; height: 26px; border-radius: 999px; background: #CBD2DA; position: relative; flex: none; cursor: pointer; transition: background .15s; }
  .fa :global(.fa-sw input::after) { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; transition: transform .15s; box-shadow: 0 1px 3px rgba(0,0,0,.25); }
  .fa :global(.fa-sw input:checked) { background: #16A34A; }
  .fa :global(.fa-sw input:checked::after) { transform: translateX(20px); }
  .fa :global(.fa-sw input:focus-visible) { outline: 3px solid #FFC72C; outline-offset: 2px; }
  .fa-note { margin: 12px 0 0; padding: 10px 12px; border-radius: 10px; background: var(--a-soft); color: var(--a-muted); font-size: 13px; line-height: 1.5; }
  .fa :global(table) { width: 100%; border-collapse: separate; border-spacing: 0; }
  .fa :global(th), .fa :global(td) { padding: 10px 12px; text-align: left; font-size: 14px; vertical-align: top; }
  .fa :global(.pill) { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 12px; font-weight: 700; white-space: nowrap; }
  .fa :global(.pill.done) { background: #DCFCE7; color: #166534; } .fa :global(.pill.go) { background: #DBEAFE; color: #1E40AF; }
  .fa :global(td.nw) { white-space: nowrap; }
  .sm { min-height: 36px; padding: 6px 12px; font-size: 13px; }
  @media (max-width: 960px) { .fa-grid { grid-template-columns: 1fr; } .fa-head { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .fa-stats { grid-template-columns: 1fr 1fr; } .fa-2 { grid-template-columns: 1fr; } .fa-actions .btn-p { width: 100%; } }
</style>

<script is:inline>
(function () {
  const code = sessionStorage.getItem('ls_admin_code') || '__session__';
  const H = { 'Content-Type': 'application/json', 'x-admin-code': code };
  const $ = id => document.getElementById(id);
  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const wat = iso => new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Lagos' });
  const DESC = { radio_live: 'When Lobi Stars FC Live goes on air', kickoff: 'When Start Match is pressed', halftime: 'When the status is set to half-time', second_half: 'When the second half starts', fulltime: 'When the match is ended', goal: 'Every goal (from the score)' };
  const PRESETS = {
    pre: { title: '🎙️ The pre-match show starts now', body: 'Build-up, team news and analysis on Lobi Stars FC Live. Tap to listen.', url: '/commentary/', category: 'radio' },
    comm: { title: '🎙️ Live commentary is starting', body: 'Listen to every kick on Lobi Stars FC Live.', url: '/commentary/', category: 'radio' },
    lineup: { title: '📋 The Lobi Stars line-up is out', body: 'See who starts today. Tap for the team.', url: '/fixtures/', category: 'match' },
    tickets: { title: '🎟️ Tickets are on sale', body: 'Get yours for the next home match before they go.', url: '/tickets/', category: 'match' },
  };
  let data = null;
  let msgT;
  function msg(t, ok) { const m = $('msg'); m.textContent = t; m.className = 'fa-msg ' + (ok ? 'ok' : 'err'); m.hidden = false; clearTimeout(msgT); msgT = setTimeout(() => { m.hidden = true; }, 6000); }
  async function api(body) {
    const r = await fetch('/api/admin/fan-alerts', body ? { method: 'POST', headers: H, body: JSON.stringify(body) } : { headers: H, cache: 'no-store' });
    if (r.status === 401) { location.href = '/admin/login/?next=/admin/fan-alerts/'; throw new Error('Please sign in again.'); }
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || 'Request failed');
    return d;
  }
  function countFor(cat) { return data ? (data.counts[cat] || 0) : 0; }
  function drawCount() { const c = $('send').elements.category.value; $('sendCount').textContent = `Goes to ${countFor(c).toLocaleString('en-NG')} fan device${countFor(c) === 1 ? '' : 's'}`; }
  async function load() {
    try {
      data = await api();
      const c = data.counts;
      $('stats').innerHTML = [['#E31E24', c.total, 'Fan devices signed up'], ['#8B5CF6', c.radio, '🎙️ Radio & commentary'], ['#16A34A', c.match, '⚽ Kick-off & results'], ['#F59E0B', c.goals, '🥅 Goals']]
        .map(([col, n, l]) => `<div class="fa-stat" style="--c:${col}"><b>${Number(n || 0).toLocaleString('en-NG')}</b><span>${l}</span></div>`).join('');
      $('warn').hidden = data.pushReady;
      $('warn').innerHTML = '⚠️ <b>Alerts cannot be sent yet:</b> the push keys (VAPID) still need to be added on the server. Fans can already see the sign-up box once they are added.';
      const sel = $('send').elements.category;
      if (!sel.options.length) for (const [k, l] of Object.entries(data.categories)) sel.add(new Option(l, k));
      drawCount();
      $('auto').innerHTML = Object.entries(data.kinds).map(([k, v]) => `<label class="fa-sw"><span><b>${esc(v.label)}</b><small>${esc(DESC[k] || '')}</small></span><input type="checkbox" role="switch" name="${esc(k)}" ${data.settings[k] ? 'checked' : ''} aria-label="${esc(v.label)}"></label>`).join('');
      $('log').innerHTML = data.jobs.length ? `<div class="scroll"><table><thead><tr><th>When</th><th>Alert</th><th>Sent by</th><th>Delivered</th><th></th></tr></thead><tbody>${data.jobs.map(j => `<tr><td class="nw">${esc(wat(j.created_at))}</td><td><b>${esc(j.title)}</b>${j.body ? `<br><span class="muted">${esc(j.body)}</span>` : ''}</td><td>${esc(j.created_by || '')}</td><td class="nw">${j.sent}${j.failed ? ` <span class="muted">(${j.failed} failed)</span>` : ''}</td><td>${j.done_at ? '<span class="pill done">Done</span>' : '<span class="pill go">Sending…</span>'}</td></tr>`).join('')}</tbody></table></div>`
        : '<div class="empty-state"><b>🔔</b>No alerts sent yet.</div>';
      if (data.jobs.some(j => !j.done_at)) setTimeout(load, 4000);
    } catch (e) { msg(e.message, false); }
  }
  $('presets').addEventListener('click', e => {
    const b = e.target.closest('[data-preset]'); if (!b) return;
    const p = PRESETS[b.dataset.preset], f = $('send').elements;
    f.title.value = p.title; f.body.value = p.body; f.url.value = p.url; f.category.value = p.category; drawCount(); f.title.focus();
  });
  $('send').elements.category.addEventListener('change', drawCount);
  $('send').addEventListener('submit', async e => {
    e.preventDefault(); const f = e.target.elements;
    const n = countFor(f.category.value);
    if (!confirm(`Send "${f.title.value}" to ${n} fan device${n === 1 ? '' : 's'} now?`)) return;
    try {
      await api({ send: { title: f.title.value, body: f.body.value, url: f.url.value, category: f.category.value } });
      msg('Alert is going out now.', true); e.target.reset(); drawCount();
      document.dispatchEvent(new Event('ls:fan-alert-sent'));
      load();
    } catch (err) { msg(err.message, false); }
  });
  $('auto').addEventListener('change', async () => {
    const settings = {}; $('auto').querySelectorAll('input').forEach(i => { settings[i.name] = i.checked; });
    try { await api({ settings }); msg('Automatic alerts saved.', true); } catch (err) { msg(err.message, false); load(); }
  });
  $('refresh').addEventListener('click', load);
  load();
})();
</script>
