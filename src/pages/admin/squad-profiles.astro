---
// Squad › Profile Submissions (Website & Data Officer and Super Admins). Every
// profile sent from the Squad & Staff Data Portal: the full answers (including
// private details, for the club only) and photos; Verify & publish, Request
// changes (the note shows in the portal), Mark as left the club / Restore.
// Super Admins also: the name check (old single names → surname / first / middle),
// Edit (any answer and the club-only fields: name on website, debut, bio, shirt
// link, hide; photos incl. the wide hero photo; "Draft bio with Claude"), Remove,
// new season (carry over), team details for the Data Package, Full club records.
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
---
<Layout title="Squad Profile Submissions | Lobi Stars Admin" description="Squad and staff profiles from the data portal." noindex>
  <div class="wrap sq">
    <AdminNav current="squad-profiles" />
    <div class="stag">Matchday › Squad</div>
    <h1 class="stitle">Profile <span class="r">submissions</span></h1>
    <p class="sq-lede">Profiles sent from the Squad &amp; Staff Data Portal. Only <b>verified</b> profiles appear on the website's Squad pages (public details only; the full date of birth and middle name only for people aged 18 and over).</p>
    <p class="sq-msg" id="msg" role="status" aria-live="polite" hidden></p>
    <ul class="sq-chips" id="chips"></ul>

    <section class="sq-card sq-names" id="namesBox" hidden aria-labelledby="h-names">
      <h2 id="h-names">Please check name order <span class="st CHANGES_REQUESTED" id="namesCount"></span></h2>
      <p class="muted">The form now asks for Surname, First name and Middle name. These profiles had the old single name, so the new fields were filled in from it (the reason is shown for each). They are already used on the website as "First name Surname". Check each against the passport or ID, correct it if needed, and press <b>Confirm</b>. The middle name is private. "Name on website" is only for someone publicly known by a different name; leave it empty otherwise.</p>
      <div class="sq-row"><button class="btn-o" type="button" id="namesCsv">Download this list (CSV)</button></div>
      <div class="sq-scroll"><table class="sq-table"><thead><tr><th>Old answers</th><th>Surname</th><th>First name</th><th>Middle name</th><th>Name on website</th><th>How it was filled in</th><th></th></tr></thead><tbody id="namesRows"></tbody></table></div>
    </section>

    <section class="sq-card sq-legacy" id="legacyBox" hidden aria-labelledby="h-legacy">
      <h2 id="h-legacy">Old squad files <span class="st PENDING_APPROVAL" id="legacyCount"></span></h2>
      <p class="muted">The Squad pages now come only from the Squad &amp; Staff Data Portal. These people are still kept as old hand-made files in the website. Tick the real people to move them into the portal (they go live straight away, marked “migrated – please review”, so check and complete each one). Placeholders are not people: leave them unticked. Then press <b>Move and switch off the old files</b>: anything not moved disappears from the website.</p>
      <div class="sq-scroll"><table class="sq-table"><thead><tr><th>Move</th><th>Name</th><th>Type</th><th>Details</th><th>Note</th></tr></thead><tbody id="legacyRows"></tbody></table></div>
      <div class="sq-row"><button class="btn-p" type="button" id="legacyGo">Move and switch off the old files</button></div>
    </section>

    <section class="sq-card">
      <div class="sq-row">
        <label class="sq-l">Season <select id="season"></select></label>
        <label class="sq-l">Search <input id="q" type="search" placeholder="Name or shirt number" /></label>
        <button class="btn-o" type="button" id="publish">Update the website now</button>
      </div>
      <div class="sq-filters" id="filters"></div>
      <div class="sq-scroll"><table class="sq-table"><thead><tr><th>Photo</th><th>Name</th><th>Type</th><th>Number / position or role</th><th>Status</th><th>Last saved</th><th></th></tr></thead><tbody id="rows"></tbody></table></div>
    </section>

    <section class="sq-card sq-detail" id="detail" hidden aria-live="polite"></section>

    <section class="sq-card" id="exportBox" aria-labelledby="h-ex" hidden>
      <h2 id="h-ex">Export data <span class="muted" style="font-size:14px;font-weight:600">(Super Admins only)</span></h2>
      <fieldset class="sq-deliver"><legend>Send the file</legend>
        <label><input type="radio" name="deliver" value="email" checked /> <b>By email</b> to <span id="exTo">dkakaan@lobistarsfc.com</span> <small class="muted">(change the list in Settings › Squad &amp; Staff Data Portal)</small></label>
        <label><input type="radio" name="deliver" value="download" /> <b>Download to this computer</b></label>
      </fieldset>
      <div class="sq-row">
        <label class="sq-l">Which profiles <select id="exWhich"><option value="verified">Live only</option><option value="submitted">Live and waiting for approval</option><option value="players">Players</option><option value="staff">Staff</option></select></label>
        <label class="sq-l">Season <select id="exSeason"><option value="current">Current season</option><option value="all">All seasons</option></select></label>
      </div>
      <div class="sq-row">
        <button class="btn-o" type="button" data-export="pdf">PDF</button><button class="btn-o" type="button" data-export="docx">Word</button>
        <button class="btn-o" type="button" data-export="xlsx">Excel</button><button class="btn-o" type="button" data-export="csv">CSV</button>
        <button class="btn-o" type="button" data-export="json">JSON</button><button class="btn-p" type="button" data-export="zip">Media Partner Data Package (ZIP)</button>
      </div>
      <p class="muted">These files contain Public and Media details only. Nobody else can export squad data: the Website &amp; Data Officer and the portal cannot.</p>
      <div id="fullBox" hidden>
        <h3>Full club records (Super Admins)</h3>
        <p class="muted">Every field including private details (middle name, date of birth, phone, email, emergency and guardian contacts). Needs your two-step code; recorded in the Activity Log.</p>
        <div class="sq-row"><button class="btn-o" type="button" data-full="records-xlsx">Full records (Excel)</button><button class="btn-o" type="button" data-full="records-pdf">Full records (PDF)</button></div>
      </div>
      <p class="sq-exstatus" id="exStatus" role="status" aria-live="polite" hidden></p>
    </section>

    <section class="sq-card" id="superBox" hidden>
      <h2>New season</h2>
      <p class="muted">Copies every live profile of a season into the new season (still live on the website, history and photos kept; the season's confirmations are asked again in the portal), and makes it the portal's current season.</p>
      <form class="sq-row" id="carry"><label class="sq-l">From <select id="carryFrom"></select></label><label class="sq-l">New season <input id="carryTo" placeholder="2027/28" maxlength="7" /></label><button class="btn-p" type="submit">Carry over squad</button></form>
      <h2>Team details (Data Package)</h2>
      <form class="sq-team" id="team">
        <label class="sq-l">Name <input name="name" /></label><label class="sq-l">Short name <input name="shortName" /></label><label class="sq-l">Nickname <input name="nickname" /></label>
        <label class="sq-l">Stadium <input name="stadium" /></label><label class="sq-l">City <input name="city" /></label><label class="sq-l">State <input name="state" /></label>
        <label class="sq-l">Competition <input name="competition" /></label>
        <label class="sq-l">Home kit colours <input name="home" placeholder="#C4161C, #F2B705" /></label><label class="sq-l">Away kit colours <input name="away" placeholder="#FFFFFF, #F2B705" /></label>
        <div><button class="btn-p" type="submit">Save team details</button></div>
      </form>
    </section>

    <section class="sq-card" id="exLogBox" hidden><h2>Export log</h2><div id="exLog"></div></section>
  </div>
</Layout>

<style>
  .sq { max-width: 1200px; padding-top: 20px; padding-bottom: 60px; }
  .sq-lede { color: var(--a-muted); max-width: 800px; line-height: 1.5; }
  .sq-card { background: var(--a-card); border: 1px solid var(--a-line); border-radius: 16px; padding: 16px; margin: 14px 0; display: grid; gap: 12px; }
  .sq-card > :global(*) { min-width: 0; } /* wide tables scroll inside the card instead of widening the page */
  .sq-card h2 { margin: 0; font-size: 18px; } .sq-card h3 { margin: 6px 0 0; font-size: 16px; }
  .sq-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: flex-end; }
  .sq-row button { min-height: 44px; }
  .sq-l { display: grid; gap: 4px; font-weight: 600; font-size: 14px; color: var(--a-muted); }
  .sq-l input, .sq-l select, .sq :global(.sq-note) { min-height: 44px; border: 1px solid var(--a-line); border-radius: 10px; padding: 6px 10px; background: var(--a-card); color: var(--a-ink); font: inherit; font-size: 15px; }
  .sq-chips { list-style: none; padding: 0; margin: 0; display: flex; gap: 8px; flex-wrap: wrap; }
  .sq :global(.sq-chips li) { padding: 6px 12px; border-radius: 999px; background: var(--a-card); border: 1px solid var(--a-line); }
  .sq-filters { display: flex; gap: 6px; flex-wrap: wrap; }
  .sq :global(.sq-filters button) { min-height: 40px; padding: 4px 12px; border-radius: 999px; border: 1px solid var(--a-line); background: var(--a-card); color: var(--a-ink); font-weight: 600; cursor: pointer; }
  .sq :global(.sq-filters button[aria-pressed="true"]) { background: #15181D; color: #fff; }
  .sq-scroll { overflow-x: auto; }
  .sq-table { width: 100%; min-width: 760px; border-collapse: collapse; font-size: 14px; }
  .sq :global(.sq-table th), .sq :global(.sq-table td) { text-align: left; padding: 8px; border-bottom: 1px solid var(--a-line); vertical-align: middle; }
  .sq :global(.sq-thumb) { width: 40px; height: 50px; object-fit: cover; border-radius: 6px; background: var(--a-line); display: inline-block; }
  .sq :global(.st) { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 12px; font-weight: 700; }
  .sq :global(.st.DRAFT) { background: #FEF3C7; color: #78350F; } .sq :global(.st.PENDING_APPROVAL) { background: #DBEAFE; color: #1E3A8A; } .sq :global(.st.LIVE) { background: #DCFCE7; color: #14532D; }
  .sq :global(.st.CHANGES_REQUESTED) { background: #FEE2E2; color: #7F1D1D; } .sq :global(.st.FORMER), .sq :global(.st.DELETED) { background: #E5E7EB; color: #374151; } .sq :global(.st.ON_LOAN) { background: #EDE9FE; color: #4C1D95; }
  .sq :global(.st.MIGRATED) { background: #FFEDD5; color: #7C2D12; }
  .sq :global(.sq-versions) { display: grid; gap: 6px; } .sq :global(.sq-versions li) { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .sq :global(.sq-dl) { display: grid; grid-template-columns: minmax(160px, 260px) 1fr; gap: 6px 14px; margin: 0; font-size: 14px; }
  .sq :global(.sq-dl dt) { color: var(--a-muted); } .sq :global(.sq-dl dd) { margin: 0; }
  .sq :global(.use) { display: inline-block; margin-left: 6px; padding: 0 7px; border-radius: 999px; font-size: 11px; font-weight: 700; }
  .sq :global(.use.public) { background: #DBEAFE; color: #1D4ED8; } .sq :global(.use.media) { background: #FEF3C7; color: #92400E; } .sq :global(.use.private) { background: #E5E7EB; color: #374151; }
  .sq :global(.sq-photos) { display: flex; gap: 12px; flex-wrap: wrap; }
  .sq :global(.sq-photos img) { width: 160px; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 12px; }
  .sq :global(.sq-acts) { display: flex; gap: 8px; flex-wrap: wrap; align-items: flex-end; }
  .sq :global(.sq-acts button) { min-height: 44px; }
  .sq :global(.sq-note) { flex: 1 1 280px; }
  .sq-deliver { border: 1px solid var(--a-line); border-radius: 12px; padding: 10px 14px; display: grid; gap: 8px; margin: 0; }
  .sq-deliver legend { font-weight: 700; padding: 0 6px; }
  .sq-deliver label { display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
  .sq-team { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; align-items: end; }
  .sq-msg { position: fixed; left: 50%; transform: translateX(-50%); bottom: 18px; z-index: 1500; max-width: calc(100vw - 32px); padding: 12px 16px; border-radius: 12px; margin: 0; box-shadow: 0 14px 34px rgba(0,0,0,.22); font-weight: 600; }
  .sq-msg.ok { background: #E8F7EE; color: #17643A; } .sq-msg.err { background: #FDECEC; color: #A3161B; }
  .sq-exstatus { margin: 0; padding: 10px 12px; border-radius: 10px; background: #E8F7EE; color: #17643A; font-weight: 600; }
  .sq-exstatus.err { background: #FDECEC; color: #A3161B; }
  .sq :global(.sq-names input) { min-height: 40px; width: 100%; min-width: 110px; border: 1px solid var(--a-line); border-radius: 8px; padding: 4px 8px; font: inherit; background: var(--a-card); color: var(--a-ink); }
  .sq :global(.conf-high) { color: #17643A; font-weight: 700; } .sq :global(.conf-review) { color: #A3161B; font-weight: 700; }
  .sq :global(.sq-edit) { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; align-items: start; border-top: 1px solid var(--a-line); padding-top: 12px; }
  .sq :global(.sq-edit .wide) { grid-column: 1 / -1; }
  .sq :global(.sq-edit label) { display: grid; gap: 4px; min-width: 0; font-weight: 600; font-size: 14px; color: var(--a-muted); }
  .sq :global(.sq-edit input:not([type=checkbox])), .sq :global(.sq-edit select), .sq :global(.sq-edit textarea) { width: 100%; max-width: 100%; box-sizing: border-box; }
  .sq :global(.sq-edit input:not([type=checkbox])), .sq :global(.sq-edit select), .sq :global(.sq-edit textarea) { min-height: 44px; border: 1px solid var(--a-line); border-radius: 10px; padding: 6px 10px; background: var(--a-card); color: var(--a-ink); font: inherit; font-size: 15px; }
  .sq :global(.sq-edit textarea) { min-height: 220px; line-height: 1.5; }
  .sq :global(.sq-edit small) { font-weight: 400; }
  .sq :global(.sq-edit .chk) { display: flex; gap: 8px; align-items: center; }
  .sq :global(.sq-old) { background: #FFF8E6; border-radius: 12px; padding: 10px 12px; font-size: 14px; }
  .sq :global(.sq-draft) { border: 2px solid #F2B705; border-radius: 12px; padding: 12px; display: grid; gap: 8px; }
  .sq :global(.sq-draft .warn) { background: #FEF3C7; color: #78350F; padding: 8px 10px; border-radius: 8px; font-weight: 600; }
  .sq :global(.sq-photos .ph-btns) { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; }
  @media (max-width: 640px) { .sq :global(.sq-dl) { grid-template-columns: 1fr; } }
</style>

<script>
  import { FIELDS, FIELD, labelOf, ageOn, fieldsFor, profileName } from '../../lib/squadFields.js';
  import { COUNTRY_OPTIONS, countryName } from '../../lib/countries.js';
  import { officialName } from '../../lib/names.js';
  import { runExport } from '../../scripts/squadPortal/exports';
  import { processPhoto } from '../../scripts/squadPortal/media';
  const H = { 'Content-Type': 'application/json', 'x-admin-code': sessionStorage.getItem('ls_admin_code') || '__session__' };
  const $ = (id: string) => document.getElementById(id) as any;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  const when = (iso?: string) => iso ? new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Lagos' }) : '';
  const FILTERS = [['submitted', 'Awaiting approval'], ['all', 'All current'], ['live', 'Live'], ['changes', 'Changes requested'], ['drafts', 'Drafts'], ['loan', 'On loan'], ['former', 'Former'], ['migrated', 'Migrated – please review'], ['players', 'Players'], ['staff', 'Staff']];
  // The status shown: a live profile with an edit shows the edit's state as well.
  const stKey = (p: any) => (p.pending && ['LIVE', 'ON_LOAN'].includes(p.status) ? p.pending : p.status);
  const view = { season: '', filter: new URLSearchParams(location.search).get('filter') || 'submitted', q: '' };
  let D: any = null, msgT = 0, qT = 0;
  function msg(t: string, ok = true) { const m = $('msg'); m.textContent = t; m.className = `sq-msg ${ok ? 'ok' : 'err'}`; m.hidden = false; clearTimeout(msgT); msgT = window.setTimeout(() => { m.hidden = true; }, 7000); }
  async function api(qs = '', body?: unknown) {
    const r = await fetch(`/api/admin/squad-profiles${qs}`, body ? { method: 'POST', headers: H, body: JSON.stringify(body) } : { headers: H, cache: 'no-store' });
    if (r.status === 401) { location.href = '/admin/login/?next=/admin/squad-profiles/'; throw new Error('Please sign in again.'); }
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { const e: any = new Error(d.error || 'Request failed'); e.data = d; throw e; }
    return d;
  }
  async function load() {
    try {
      const p = new URLSearchParams({ filter: view.filter, q: view.q, ...(view.season ? { season: view.season } : {}) });
      D = await api(`?${p}`); view.season = D.season;
      const c = D.counts;
      $('chips').innerHTML = [['Players', c.players], ['Staff', c.staff], ['Live', c.live], ['Awaiting approval', c.submitted], ['Changes requested', c.changes], ['Drafts', c.drafts], ['On loan', c.loan], ['Former', c.former], ['Migrated – please review', c.migrated]].filter(([, n], i) => i < 3 || n).map(([l, n]) => `<li><b>${n}</b> ${l}</li>`).join('');
      $('season').innerHTML = D.seasons.map((s: string) => `<option ${s === D.season ? 'selected' : ''}>${esc(s)}</option>`).join('');
      $('carryFrom').innerHTML = $('season').innerHTML;
      $('filters').innerHTML = FILTERS.map(([k, l]) => `<button type="button" data-f="${k}" aria-pressed="${k === view.filter}">${l}</button>`).join('');
      $('rows').innerHTML = D.profiles.length ? D.profiles.map((p: any) => `<tr>
        <td>${p.thumb ? `<img class="sq-thumb" src="${esc(p.thumb)}" alt="" loading="lazy" />` : '<span class="sq-thumb"></span>'}</td>
        <td><b>${esc(p.name || 'Unnamed draft')}</b>${p.nameStatus === 'check' ? ' <span class="st CHANGES_REQUESTED">Please check name order</span>' : ''}${p.migrated ? ' <span class="st MIGRATED">Migrated – please review</span>' : ''}${p.reviewNote ? `<br /><small>Note: ${esc(p.reviewNote)}</small>` : ''}</td><td>${p.type === 'player' ? 'Player' : 'Coach / staff'}</td>
        <td>${p.type === 'player' ? `${p.shirtNumber ?? '–'} · ${esc(p.position || '')}` : esc(p.role || '')}</td><td><span class="st ${stKey(p)}">${esc(p.statusLabel)}</span>${p.liveN ? `<br /><small class="muted">live version ${p.liveN}</small>` : ''}</td>
        <td>${esc(when(p.updatedAt))}<br /><small>${esc(p.updatedBy || '')}</small></td><td><button class="btn-o" type="button" data-open="${p.id}">Open</button></td></tr>`).join('') : '<tr><td colspan="7" class="muted">Nothing here.</td></tr>';
      $('fullBox').hidden = !D.canFull; $('superBox').hidden = !D.canSuper;
      $('exportBox').hidden = !D.canExport; $('exLogBox').hidden = !D.canExport;
      if (D.exportTo?.length) $('exTo').textContent = D.exportTo.join(', ');
      const t = D.team, f = $('team');
      for (const k of ['name', 'shortName', 'nickname', 'stadium', 'city', 'state', 'competition']) f.elements[k].value = t[k] || '';
      f.elements.home.value = (t.kitColours?.home || []).join(', '); f.elements.away.value = (t.kitColours?.away || []).join(', ');
      $('exLog').innerHTML = D.exportLog.length ? `<div class="sq-scroll"><table class="sq-table"><thead><tr><th>When</th><th>Who</th><th>Where</th><th>Format</th><th>Profiles</th><th>Filters</th></tr></thead><tbody>${D.exportLog.map((x: any) => `<tr><td>${esc(when(x.at))}</td><td>${esc(x.by)}</td><td>${esc(x.place)}</td><td>${esc(x.format)}${x.ok ? '' : ' (failed)'}</td><td>${x.profiles}</td><td>${esc(x.filters)}</td></tr>`).join('')}</tbody></table></div>` : '<p class="muted">No downloads yet.</p>';
      const id = new URLSearchParams(location.search).get('id'); if (id && $('detail').hidden) open(id);
      $('namesBox').hidden = !(D.canEdit && D.pendingNames);
      if (D.canEdit && D.pendingNames) loadNames();
      if (D.canSuper) loadLegacy();
    } catch (e: any) { msg(e.message, false); }
  }
  function value(f: any, v: any, type: string) {
    if (v === null || v === undefined || v === '' || (Array.isArray(v) && !v.length)) return '<span class="muted">–</span>';
    if (f.type === 'rows') return `<ul>${v.map((r: any) => `<li>${f.columns.map((c: any) => esc(r[c.key] ?? '')).filter(Boolean).join(' · ')}</li>`).join('')}</ul>`;
    if (f.type === 'checkbox') return v ? 'Yes' : 'No';
    if (f.key === 'dob') return `${esc(v)} (age ${ageOn(v) ?? '–'})`;
    if (f.type === 'country') return esc(countryName(v) || v);
    if (f.type === 'richtext') return `<div style="white-space:pre-wrap">${esc(v)}</div>`;
    return esc(Array.isArray(v) ? v.join(', ') : v);
  }
  const rowValue = (c: any, x: any) => c.type === 'country' ? countryName(x) || '' : x ?? '';

  // ── Name check (Super Admins) ──
  let NAMES: any[] = [];
  async function loadNames() {
    try {
      NAMES = (await api('?names=1')).names;
      $('namesCount').textContent = `${NAMES.length} to check`;
      const inp = (n: any, k: string) => `<input data-k="${k}" value="${esc(n[k] || '')}" aria-label="${k} for ${esc(n.original)}" />`;
      $('namesRows').innerHTML = NAMES.map(n => `<tr data-nid="${n.id}"><td>Full name: <b>${esc(n.original || '–')}</b><br />Display name: <b>${esc(n.oldDisplayName || '–')}</b><br /><small class="muted">${n.type === 'player' ? `Player${n.shirtNumber ? ` #${n.shirtNumber}` : ''}` : 'Coach / staff'} · ${esc(n.statusLabel)} · ${esc(n.season)}</small></td>
        <td>${inp(n, 'surname')}</td><td>${inp(n, 'firstName')}</td><td>${inp(n, 'middleName')}</td><td>${inp(n, 'websiteName')}</td>
        <td><small class="muted">${esc(n.rule || '')}</small></td>
        <td><button class="btn-p" type="button" data-confirm="${n.id}">Confirm</button></td></tr>`).join('') || '<tr><td colspan="7" class="muted">All names are confirmed.</td></tr>';
    } catch (e: any) { msg(e.message, false); }
  }
  $('namesRows').addEventListener('click', async (e: Event) => {
    const b = (e.target as HTMLElement).closest('[data-confirm]') as HTMLButtonElement | null; if (!b) return;
    const tr = b.closest('tr')!, v = (k: string) => (tr.querySelector(`[data-k="${k}"]`) as HTMLInputElement).value.trim();
    const body = { action: 'confirm_name', id: b.dataset.confirm, surname: v('surname'), firstName: v('firstName'), middleName: v('middleName'), websiteName: v('websiteName') };
    if (!confirm(`Save the name as ${officialName(body)} (shown on the website as "${body.websiteName || `${body.firstName} ${body.surname}`}")?`)) return;
    b.disabled = true;
    try { await api('', body); msg('Name confirmed.'); load(); } catch (err: any) { msg(err.message, false); b.disabled = false; }
  });
  $('namesCsv').addEventListener('click', () => {
    const rows = [['Profile ID', 'Season', 'Type', 'Status', 'Old full name', 'Old display name', 'Surname', 'First name', 'Middle name', 'Name on website', 'How it was filled in']]
      .concat(NAMES.map(n => [n.id, n.season, n.type, n.statusLabel, n.original, n.oldDisplayName, n.surname, n.firstName, n.middleName, n.websiteName, n.rule]));
    const csv = '\ufeff' + rows.map(r => r.map(c => `"${String(c ?? '').replace(/"/g, '""')}"`).join(',')).join('\r\n');
    const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' })); a.download = `lobi-stars-name-check-${new Date().toISOString().slice(0, 10)}.csv`; a.click();
  });

  // ── Old squad files: the migration list (Super Admins) ──
  async function loadLegacy() {
    try {
      const L = await api('?legacy=1');
      const todo = (L.list || []).filter((e: any) => !e.migrated);
      $('legacyBox').hidden = L.legacyOff || !todo.length;
      if ($('legacyBox').hidden) return;
      $('legacyCount').textContent = `${todo.length} still in the old files`;
      $('legacyRows').innerHTML = todo.map((e: any) => `<tr><td><input type="checkbox" data-lk="${esc(e.key)}" ${e.isSample ? '' : 'checked'} aria-label="Move ${esc(e.name)}" /></td>
        <td><b>${esc(e.name)}</b></td><td>${e.kind === 'player' ? 'Player' : 'Coach / staff'}</td>
        <td>${e.kind === 'player' ? `#${esc(e.number)} · ${esc(e.position)}${e.dob ? ` · born ${esc(e.dob)}` : ''}` : esc(e.role || e.group || '')}</td>
        <td>${e.isSample ? '<span class="st DRAFT">Placeholder, not a real person</span>' : 'Real person? Then move.'}</td></tr>`).join('');
    } catch (e: any) { msg(e.message, false); }
  }
  $('legacyGo').addEventListener('click', async () => {
    const keys = [...document.querySelectorAll<HTMLInputElement>('#legacyRows [data-lk]:checked')].map(i => i.dataset.lk!);
    if (!confirm(`${keys.length ? `Move ${keys.length} ${keys.length === 1 ? 'person' : 'people'} into the portal (live, marked "migrated – please review") and ` : ''}switch off the old squad files? Anything not moved disappears from the website Squad page.`)) return;
    try { const r = await api('', { action: 'migrate', keys, switchOff: true }); msg(`${r.migrated.length ? `Moved: ${r.migrated.join(', ')}. ` : ''}The old squad files are switched off.`); load(); }
    catch (e: any) { msg(e.message, false); }
  });

  // ── Earlier versions (Super Admins) ──
  async function showVersions(id: string) {
    const box = $('versionsBox'); if (!box) return;
    try {
      const { versions } = await api(`?versions=${encodeURIComponent(id)}`);
      box.innerHTML = versions.length ? `<h3>Live versions</h3><ul class="sq-versions">${versions.map((v: any, i: number) => `<li><b>Version ${v.n}</b> ${i === 0 ? '<span class="st LIVE">on the website</span>' : ''} approved ${esc(when(v.approvedAt))} by ${esc(v.approvedBy || '–')}${v.submittedBy ? ` · sent by ${esc(v.submittedBy)}` : ''}${v.note ? ` · ${esc(v.note)}` : ''}${i > 0 ? ` <button class="btn-o" type="button" data-restorev="${v.n}">Restore this version</button>` : ''}</li>`).join('')}</ul><p class="muted">Restoring makes that version the one waiting for approval; the website keeps the live one until it is approved.</p>` : '<p class="muted">No live version yet.</p>';
    } catch (e: any) { box.innerHTML = `<p class="muted">${esc(e.message)}</p>`; }
  }

  // ── Edit (Super Admins) ──
  // The answers the club edits here; repeatable rows (previous clubs, honours, international career) are changed in the portal (Request changes).
  const EDIT_KEYS = ['surname', 'firstName', 'middleName', 'websiteName', 'shirtNumber', 'positionGroup', 'primaryPosition', 'preferredFoot', 'role', 'roleOther', 'roleCoaching', 'dob', 'nationality', 'nationality2', 'nationalTeam', 'birthTown', 'birthCountry',
    'heightCm', 'joined', 'joinedStaff', 'debutDate', 'intlVerified', 'qualifications', 'socialInstagram', 'socialX', 'socialTiktok', 'interestingFact', 'bioHeadline', 'bio', 'shirtShopUrl', 'hideFromWebsite'];
  function editInput(f: any, v: any, type: string, data: any = {}) {
    const id = `ed_${f.key}`, val = v ?? '';
    const lab = `${esc(labelOf(f, type, data))}${f.required ? ' *' : ''}${f.hint ? `<small>${esc(f.hint)}</small>` : ''}`;
    if (f.type === 'checkbox') return `<label class="chk wide"><input type="checkbox" id="${id}" data-ek="${f.key}" ${v ? 'checked' : ''} /> ${lab}</label>`;
    let el: string;
    if (f.type === 'country') el = `<select id="${id}" data-ek="${f.key}"><option value="">–</option>${COUNTRY_OPTIONS.map(([c, n]) => `<option value="${c}" ${c === val ? 'selected' : ''}>${esc(n)}</option>`).join('')}</select>`;
    else if (f.type === 'select') el = `<select id="${id}" data-ek="${f.key}"><option value="">–</option>${f.options.map((o: string) => `<option ${o === val ? 'selected' : ''}>${esc(o)}</option>`).join('')}</select>`;
    else if (f.type === 'role') { const rs: any[] = D?.roles || [], opt = (n: string) => `<option ${n === val ? 'selected' : ''}>${esc(n)}</option>`; el = `<select id="${id}" data-ek="${f.key}"><option value="">–</option>${val && val !== 'Other' && !rs.some(r => r.name === val) ? opt(val) : ''}<optgroup label="Coaching staff">${rs.filter(r => r.category === 'COACHING').map(r => opt(r.name)).join('')}</optgroup><optgroup label="Club staff">${rs.filter(r => r.category !== 'COACHING').map(r => opt(r.name)).join('')}</optgroup>${opt('Other')}</select>`; }
    else if (f.type === 'textarea' || f.type === 'richtext') el = `<textarea id="${id}" data-ek="${f.key}" maxlength="${f.max || 400}">${esc(val)}</textarea>`;
    else el = `<input id="${id}" data-ek="${f.key}" type="${f.type === 'number' ? 'number' : f.type === 'date' || f.type === 'day' ? 'date' : f.type === 'month' ? 'month' : f.type === 'url' ? 'url' : 'text'}" value="${esc(val)}" maxlength="${f.max || 200}" />`;
    return `<label class="${f.type === 'richtext' || f.type === 'textarea' ? 'wide' : ''}">${lab}${el}</label>`;
  }
  function editPanel(p: any) {
    const fields = EDIT_KEYS.map(k => FIELD[k]).filter((f: any) => f && (f.for === 'all' || f.for === p.type) && !(f.showIf && !Object.entries(f.showIf).every(([k, v]) => p.data[k] === v)));
    const photo = (kind: string, label: string) => `<div><b>${label}</b><div class="ph-btns"><label class="btn-o" style="display:inline-flex;align-items:center;cursor:pointer">Upload<input type="file" accept="image/*" data-up="${kind}" hidden /></label>${p.photos?.[kind] ? `<button class="btn-o" type="button" data-delph="${kind}">Remove</button>` : ''}</div></div>`;
    return `<div class="sq-edit" id="editBox" data-eid="${p.id}">
      <p class="wide muted">Changes are saved straight away${['LIVE', 'ON_LOAN'].includes(p.status) ? '; the website keeps the live version until the change is approved' : ''}. Every change is in the Activity Log.</p>
      ${fields.map((f: any) => editInput(f, p.data[f.key], p.type, p.data)).join('')}
      <div class="wide sq-row">${photo('profile', 'Profile photo (cards, 4:5)')}${photo('hero', 'Wide header photo (16:9)')}${p.type === 'player' ? photo('action', 'Action photo') : ''}</div>
      <div class="wide sq-row"><button class="btn-p" type="button" id="saveEdit">Save changes</button><button class="btn-o" type="button" id="draftBio">Draft bio with Claude</button></div>
      <div class="wide" id="draftBox"></div>
    </div>`;
  }
  async function saveEdit(id: string) {
    const changes: Record<string, unknown> = {};
    document.querySelectorAll<HTMLInputElement>('#editBox [data-ek]').forEach(el => {
      const k = el.dataset.ek!, f = FIELD[k];
      changes[k] = el.type === 'checkbox' ? el.checked : f.type === 'number' ? (el.value === '' ? null : Number(el.value)) : el.value;
    });
    const r = await api('', { action: 'edit', id, changes });
    const bad = Object.entries(r.errors || {});
    if (bad.length) msg(bad.map(([k, m]) => `${labelOf(FIELD[k], r.profile.type, r.profile.data)}: ${m}`).join(' '), false);
    else msg(r.warnings?.length ? `Saved. ${r.warnings.join(' ')}` : 'Saved.', !r.warnings?.length);
    return r;
  }
  async function open(id: string) {
    try {
      const { profile: p } = await api(`?id=${encodeURIComponent(id)}`);
      const fields = fieldsFor(p.type, { admin: true });
      const old = FIELDS.filter((f: any) => f.retired && p.data[f.key] != null && p.data[f.key] !== '');
      const box = $('detail'); box.hidden = false;
      const live = ['LIVE', 'ON_LOAN'].includes(p.status), waiting = live ? ['PENDING_APPROVAL', 'CHANGES_REQUESTED'].includes(p.pending) : ['PENDING_APPROVAL', 'CHANGES_REQUESTED'].includes(p.status);
      // Approving and anything that changes the website: Super Admins only (also Squad › Approvals).
      const acts = !D?.canApprove ? [waiting ? '<p class="muted">Waiting for a Super Admin to approve it (Squad › Approvals).</p>' : ''] : [
        waiting ? `<button class="btn-p" type="button" data-act="approve">${live ? 'Approve changes' : 'Approve &amp; publish'}</button> <a class="btn-o" href="/admin/squad-approvals/?id=${encodeURIComponent(p.id)}">Compare in Approvals</a>` : '',
        (live ? p.pending === 'PENDING_APPROVAL' : p.status === 'PENDING_APPROVAL') ? '<input class="sq-note" id="note" maxlength="500" placeholder="What needs changing (shown in the portal)" /><button class="btn-o" type="button" data-act="request_changes">Request changes</button>' : '',
        live && p.pending ? '<button class="btn-o" type="button" data-act="discard">Discard the changes (keep the live version)</button>' : '',
        live ? '<button class="btn-o" type="button" data-act="left">Mark as left the club</button>' : '',
        p.status === 'FORMER' ? '<button class="btn-o" type="button" data-act="restore">Restore (back at the club)</button>' : '',
        D?.canSuper ? '<button class="btn-o" type="button" data-act="remove">Remove profile</button>' : '',
      ].join('');
      box.innerHTML = `<div class="sq-row" style="justify-content:space-between"><h2>${esc(p.name || 'Unnamed')} <span class="st ${stKey(p)}">${esc(p.statusLabel)}</span>${p.nameStatus === 'check' ? ' <span class="st CHANGES_REQUESTED">Please check name order</span>' : ''}${p.migrated ? ' <span class="st MIGRATED">Migrated – please review</span>' : ''}</h2><button class="btn-o" type="button" id="closeDetail">Close</button></div>
        <p class="muted">${p.type === 'player' ? 'Player' : 'Coach / staff'} · ${esc(p.season)} · submitted ${esc(when(p.submittedAt))} by ${esc(p.submittedBy || '–')}${p.verifiedAt ? ` · last approved ${esc(when(p.verifiedAt))} by ${esc(p.verifiedBy)}` : ''}${p.liveN ? ` · live version ${p.liveN}` : ''}${p.reviewNote ? ` · note: ${esc(p.reviewNote)}` : ''}</p>
        ${live && p.pending ? `<p class="sq-old"><b>${p.pending === 'DRAFT' ? 'Changes being made in the portal (not sent yet).' : p.pending === 'CHANGES_REQUESTED' ? 'Changes were sent back to the portal.' : 'Changes are waiting for approval.'}</b> Below are the new answers; the website still shows live version ${p.liveN}.</p>` : ''}
        <div class="sq-photos">${Object.entries(p.photos || {}).map(([k, ph]: any) => `<figure><img src="${esc(ph.url)}" alt="${k} photo" ${k === 'hero' ? 'style="aspect-ratio:16/9;width:280px"' : ''} /><figcaption class="muted">${k === 'profile' ? 'Profile' : k === 'hero' ? 'Wide header' : 'Action'} · ${esc(p.fileBase)}${k === 'profile' ? '' : `-${k}`}.jpg ${(ph.warnings || []).length ? `· ⚠ ${esc(ph.warnings.join(' '))}` : ''}</figcaption></figure>`).join('') || '<p class="muted">No photo.</p>'}</div>
        <dl class="sq-dl">${fields.map((f: any) => `<dt>${esc(labelOf(f, p.type, p.data))}<span class="use ${f.use}">${f.admin ? 'club' : f.use}</span></dt><dd>${f.type === 'rows' && p.data[f.key]?.length ? `<ul>${p.data[f.key].map((r: any) => `<li>${f.columns.map((c: any) => esc(rowValue(c, r[c.key]))).filter(Boolean).join(' · ')}</li>`).join('')}</ul>` : value(f, p.data[f.key], p.type)}</dd>`).join('')}</dl>
        ${p.type === 'player' && (p.data.internationalCareer?.length || p.data.nationalTeam) ? `<div class="sq-old"><b>International career:</b> ${p.data.intlVerified ? '✓ checked, shown on the website.' : 'not checked yet, so it is <b>not shown</b> anywhere public.'} Evidence: ${p.evidence ? `<a href="${esc(p.evidence.url)}" target="_blank" rel="noopener">${esc(p.evidence.name || 'file')}</a> (uploaded ${esc(when(p.evidence.uploadedAt))} by ${esc(p.evidence.by || '')})` : 'no file'}${p.data.intlEvidence ? ` · note: ${esc(p.data.intlEvidence)}` : ''}${D?.canEdit ? ' · tick “International career checked” in Edit once the evidence is seen.' : ''}</div>` : ''}
        ${old.length ? `<div class="sq-old"><b>Old answers</b> (questions no longer asked; kept for the club, never published): ${old.map((f: any) => `${esc(f.label.replace(/ \(old.*\)$/, ''))}: <b>${esc(p.data[f.key])}</b>`).join(' · ')}</div>` : ''}
        <div class="sq-acts" data-id="${p.id}">${acts}${D?.canEdit ? '<button class="btn-o" type="button" id="editBtn">Edit</button>' : ''}</div>
        ${D?.canSuper ? `<div id="versionsBox" data-id="${p.id}"></div>` : ''}
        <div id="editWrap"></div>`;
      if (D?.canSuper) showVersions(p.id);
      $('editBtn')?.addEventListener('click', () => { $('editWrap').innerHTML = editPanel(p); $('editBtn').hidden = true; wireEdit(p); $('editWrap').scrollIntoView({ behavior: 'smooth', block: 'start' }); });
      box.scrollIntoView({ behavior: 'smooth', block: 'start' });
      $('closeDetail').onclick = () => { box.hidden = true; history.replaceState(null, '', location.pathname); };
    } catch (e: any) { msg(e.message, false); }
  }
  $('detail').addEventListener('click', async (e: Event) => {
    const rv = (e.target as HTMLElement).closest('[data-restorev]') as HTMLElement | null;
    if (rv) {
      const id = (rv.closest('[data-id]') as HTMLElement).dataset.id;
      if (!confirm(`Restore version ${rv.dataset.restorev}? It will wait for approval; the website keeps the live version until then.`)) return;
      try { await api('', { action: 'restore_version', id, n: Number(rv.dataset.restorev) }); msg('Restored: it is waiting for approval.'); open(id!); load(); } catch (err: any) { msg(err.message, false); }
      return;
    }
    const b = (e.target as HTMLElement).closest('[data-act]') as HTMLElement | null; if (!b) return;
    const id = (b.closest('[data-id]') as HTMLElement).dataset.id, act = b.dataset.act;
    const sure = { approve: 'Approve this profile? Its public details go live on the website Squad page.', discard: 'Throw away the changes that are not approved? The live version stays as it is.', left: 'Mark this person as having left the club? They disappear from the website Squad page but stay in the records.', remove: 'Remove this profile? This cannot be undone.' } as any;
    if (sure[act!] && !confirm(sure[act!])) return;
    try { await api('', { action: act, id, note: ($('note') as HTMLInputElement | null)?.value }); msg({ approve: 'Approved. It is live; the website updates in about 2 minutes.', request_changes: 'Changes requested. The portal shows your note.', discard: 'Changes discarded; the live version stays.', left: 'Marked as left the club.', restore: 'Restored.', remove: 'Removed.' }[act!] || 'Done.'); $('detail').hidden = true; load(); }
    catch (err: any) { msg(err.message, false); }
  });
  function wireEdit(p: any) {
    $('saveEdit').onclick = async () => { try { await saveEdit(p.id); open(p.id); load(); } catch (e: any) { msg(e.message, false); } };
    document.querySelectorAll<HTMLInputElement>('#editBox [data-up]').forEach(inp => inp.addEventListener('change', async () => {
      const file = inp.files?.[0]; inp.value = ''; if (!file) return;
      const kind = inp.dataset.up as 'profile' | 'action' | 'hero';
      try {
        msg('Preparing the photo…');
        const r = await processPhoto(file, kind);
        const form = new FormData();
        form.append('id', p.id); form.append('kind', kind); form.append('width', String(r.width)); form.append('height', String(r.height)); form.append('warnings', JSON.stringify(r.warnings));
        form.append('w400', r.w400, 'w400'); form.append('w1200', r.w1200, 'w1200'); form.append('jpg', r.jpg, 'jpg'); if (r.w2000) form.append('w2000', r.w2000, 'w2000');
        const res = await fetch('/api/admin/squad-profiles', { method: 'POST', headers: { 'x-admin-code': H['x-admin-code'] }, body: form });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(d.error || 'The photo could not be saved.');
        msg(r.warnings.length ? `Photo saved. ${r.warnings.join(' ')}` : 'Photo saved.', !r.warnings.length); open(p.id);
      } catch (e: any) { msg(e.message, false); }
    }));
    document.querySelectorAll<HTMLButtonElement>('#editBox [data-delph]').forEach(b => b.addEventListener('click', async () => {
      if (!confirm('Remove this photo?')) return;
      try { await api('', { action: 'delete_photo', id: p.id, kind: b.dataset.delph }); msg('Photo removed.'); open(p.id); } catch (e: any) { msg(e.message, false); }
    }));
    $('draftBio').onclick = () => draftBio(p);
  }
  // "Draft bio with Claude": a preview only. "Use this draft" fills the Bio boxes; nothing is saved until "Save changes".
  function draftBio(p: any) {
    const box = $('draftBox');
    box.innerHTML = `<div class="sq-draft">
      <label class="sq-l">Extra details for Claude <small>(optional: facts the record does not have, e.g. how they joined, a favourite moment. No phone numbers, addresses or private details.)</small><textarea id="bioExtra" maxlength="1500" rows="4"></textarea></label>
      <div class="sq-row"><button class="btn-p" type="button" id="bioGo">Draft now</button><span class="muted">Uses only the public facts in this profile. Counts towards the monthly AI budget.</span></div>
      <div id="bioOut" aria-live="polite"></div></div>`;
    $('bioGo').onclick = async () => {
      const out = $('bioOut'), btn = $('bioGo');
      btn.disabled = true; btn.textContent = 'Drafting…'; out.innerHTML = '';
      try {
        const r = await api('', { action: 'draft_bio', id: p.id, extra: $('bioExtra').value });
        const d = r.proposal;
        out.innerHTML = `<p class="warn">Check every fact before using this bio. Claude only had the details in this profile; correct anything that is not right.${d.mock ? ' (Test mode: no AI was used.)' : ''}</p>
          <h3>${esc(d.headline)}</h3><div style="white-space:pre-wrap;line-height:1.6">${esc(d.bio)}</div>
          ${d.missing ? `<p class="muted"><b>Details that would improve it:</b> ${esc(d.missing)}</p>` : ''}
          <div class="sq-row"><button class="btn-p" type="button" id="bioUse">Use this draft</button><button class="btn-o" type="button" id="bioDiscard">Discard</button></div>`;
        $('bioUse').onclick = () => {
          const h = document.querySelector<HTMLInputElement>('#editBox [data-ek="bioHeadline"]'), b = document.querySelector<HTMLTextAreaElement>('#editBox [data-ek="bio"]');
          if (h) h.value = d.headline; if (b) b.value = d.bio;
          b?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          msg('The draft is in the Bio boxes. Read it, correct anything, then press "Save changes".');
        };
        $('bioDiscard').onclick = () => { box.innerHTML = ''; };
      } catch (e: any) { out.innerHTML = `<p class="warn">${esc(e.message)}</p>`; }
      finally { btn.disabled = false; btn.textContent = 'Draft again'; }
    };
  }
  $('rows').addEventListener('click', (e: Event) => { const b = (e.target as HTMLElement).closest('[data-open]') as HTMLElement | null; if (b) open(b.dataset.open!); });
  $('filters').addEventListener('click', (e: Event) => { const b = (e.target as HTMLElement).closest('[data-f]') as HTMLElement | null; if (b) { view.filter = b.dataset.f!; load(); } });
  $('season').addEventListener('change', () => { view.season = $('season').value; load(); });
  $('q').addEventListener('input', () => { clearTimeout(qT); qT = window.setTimeout(() => { view.q = $('q').value; load(); }, 300); });
  $('publish').addEventListener('click', async () => { try { const r = await api('', { action: 'publish' }); msg(r.message); } catch (e: any) { msg(e.message, false); } });
  $('carry').addEventListener('submit', async (e: Event) => { e.preventDefault(); if (!confirm(`Copy every verified profile of ${$('carryFrom').value} into ${$('carryTo').value} as drafts?`)) return; try { const r = await api('', { action: 'carry_over', from: $('carryFrom').value, to: $('carryTo').value }); msg(`${r.copied} profiles copied into the new season as drafts.`); view.season = ''; load(); } catch (err: any) { msg(err.message, false); } });
  $('team').addEventListener('submit', async (e: Event) => {
    e.preventDefault(); const f = (e.target as any).elements, list = (s: string) => s.split(/[\s,]+/).filter(Boolean);
    try { await api('', { action: 'team', team: { name: f.name.value, shortName: f.shortName.value, nickname: f.nickname.value, stadium: f.stadium.value, city: f.city.value, state: f.state.value, competition: f.competition.value, kitColours: { home: list(f.home.value), away: list(f.away.value) } } }); msg('Team details saved.'); load(); }
    catch (err: any) { msg(err.message, false); }
  });
  const status = (t: string, ok = true) => { const s = $('exStatus'); s.textContent = t; s.className = `sq-exstatus ${ok ? '' : 'err'}`; s.hidden = !t; };
  const deliver = () => ((document.querySelector('input[name="deliver"]:checked') as HTMLInputElement | null)?.value === 'download' ? 'download' : 'email') as 'email' | 'download';
  document.querySelectorAll<HTMLButtonElement>('[data-export]').forEach(b => b.addEventListener('click', () => runExport({ deliver: deliver(), place: 'admin', format: b.dataset.export as any, which: $('exWhich').value, season: $('exSeason').value, status, button: b })));
  document.querySelectorAll<HTMLButtonElement>('[data-full]').forEach(b => b.addEventListener('click', () => {
    const code = prompt('Enter the 6-digit code from your authenticator app (leave empty if you do not use two-step login):', '');
    if (code === null) return;
    runExport({ deliver: deliver(), place: 'admin', format: b.dataset.full as any, which: 'submitted', season: $('exSeason').value, status, button: b, extra: { code } });
  }));
  load();
</script>
