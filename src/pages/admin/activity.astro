---
// Settings › Activity Log: who did what, when and from where. Filter by person,
// type and dates. Entries can't be changed or deleted, and are kept for at
// least 12 months. Security alerts go to the Super Admins by email and the bell.
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
---
<Layout title="Activity Log | Lobi Stars Admin" description="What staff have done in the admin." noindex>
  <div class="wrap al">
    <AdminNav current="activity" />
    <div class="stag">Settings</div>
    <h1 class="stitle">Activity <span class="r">Log</span></h1>
    <p class="muted al-lede">Everything staff do in the admin, newest first: sign-ins, two-step login changes, scores and match changes, Predict &amp; Win payments, Rewards points, refunds, menu prices, partner and settings changes, roles, staff and every download. Entries can't be changed or deleted by anyone, and are kept for at least 12 months.</p>
    <form class="al-filters" id="f">
      <label>Search<input class="form-inp" id="q" type="search" placeholder="Name, action or detail" /></label>
      <label>Person<select class="form-sel" id="person"><option value="">Everyone</option></select></label>
      <label>Type<select class="form-sel" id="category"><option value="">All types</option></select></label>
      <label>From<input class="form-inp" id="from" type="date" /></label>
      <label>To<input class="form-inp" id="to" type="date" /></label>
      <button class="btn-p" type="submit">Show</button>
    </form>
    <div class="panel al-panel"><div class="scroll" id="log"><p class="muted">Loading…</p></div></div>
    <div class="al-more"><button type="button" class="btn-o" id="older" hidden>Show older</button></div>
  </div>
</Layout>

<style>
  .al { max-width: 1200px; padding-top: 28px; padding-bottom: 80px; }
  .al-lede { max-width: 820px; margin-bottom: 16px; }
  .al-filters { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; margin-bottom: 14px; }
  .al-filters label { display: grid; gap: 4px; font-weight: 700; font-size: 13px; flex: 1 1 150px; }
  .al-filters label:first-child { flex: 2 1 220px; }
  .al-panel { padding: 0; overflow: hidden; }
  .scroll { overflow-x: auto; max-height: 70vh; }
  .al-more { margin-top: 12px; text-align: center; }
  .al :global(table) { width: 100%; border-collapse: collapse; font-size: 14px; }
  .al :global(th) { text-align: left; padding: 10px 12px; font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.2px; text-transform: uppercase; position: sticky; top: 0; background: var(--a-card, #fff); }
  .al :global(td) { padding: 9px 12px; border-bottom: 1px solid var(--d4); vertical-align: top; }
  .al :global(td small) { color: var(--a-muted, #5B6470); }
  .al :global(.act) { display: inline-block; padding: 2px 8px; border-radius: 999px; background: #EEF2FF; color: #3730A3; font-size: 12px; font-weight: 700; white-space: nowrap; }
  .al :global(.act.export) { background: #FEF3C7; color: #92400E; } .al :global(.act.delete) { background: #FDECEC; color: #A3161B; } .al :global(.act.security) { background: #E8F7EE; color: #17643A; }
  .al :global(.empty) { padding: 30px; text-align: center; color: var(--lt); }
  .al :global(tr.emerg td) { background: #FDECEC; }
  .al :global(.emtag) { display: inline-block; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 99px; background: #A3161B; color: #fff; }
</style>

<script is:inline>
(function () {
  const H = { 'x-admin-code': '__session__' };
  const $ = id => document.getElementById(id);
  const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const when = ts => { const d = new Date(ts.includes('T') ? ts : ts.replace(' ', 'T') + 'Z'); return d.toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Lagos' }); };
  let offset = 0, rows = [], filled = false;
  function params() {
    const p = new URLSearchParams();
    for (const k of ['q', 'person', 'category', 'from', 'to']) { const v = $(k).value.trim(); if (v) p.set(k, v); }
    if (offset) p.set('offset', offset);
    return p.toString();
  }
  async function load(more) {
    if (!more) { offset = 0; rows = []; }
    const res = await fetch('/api/admin/activity?' + params(), { headers: H, cache: 'no-store' });
    const d = await res.json().catch(() => ({}));
    if (!res.ok) { $('log').innerHTML = `<p class="empty">${esc(d.error || 'Could not load the log.')}</p>`; return; }
    if (!filled) {
      filled = true;
      $('person').insertAdjacentHTML('beforeend', d.people.map(p => `<option value="${esc(p.staff_id)}">${esc(p.name)}</option>`).join(''));
      $('category').insertAdjacentHTML('beforeend', Object.entries(d.categories).map(([k, v]) => `<option value="${esc(k)}">${esc(v)}</option>`).join(''));
    }
    rows = rows.concat(d.log);
    const cls = r => /export|backup/.test(r.action) ? 'export' : /delete|remove|disabled/.test(r.action) ? 'delete' : r.category === 'security' ? 'security' : '';
    $('log').innerHTML = rows.length ? `<table><thead><tr><th>When</th><th>Who</th><th>What</th><th>Details</th><th>From</th></tr></thead><tbody>` +
      rows.map(r => `<tr${r.emergency ? ' class="emerg"' : ''}><td>${esc(when(r.ts))}</td><td>${r.emergency ? '<span class="emtag">🚨 Emergency account</span><br>' : ''}${esc(r.staff_name)}</td>` +
        `<td><span class="act ${cls(r)}">${esc(r.action.replace(/[_.]/g, ' '))}</span><br><small>${esc(d.categories[r.category] || '')}</small></td><td>${esc(r.detail)}</td>` +
        `<td>${r.device ? esc(r.device) : '<small>—</small>'}${r.location ? `<br><small>${esc(r.location)}</small>` : ''}${d.showIp && r.ip ? `<br><small>${esc(r.ip)}</small>` : ''}</td></tr>`).join('') +
      '</tbody></table>' : '<div class="empty-state"><b>📜</b><p>Nothing found.</p></div>';
    $('older').hidden = !d.more;
    offset = d.offset + d.log.length;
  }
  $('f').addEventListener('submit', e => { e.preventDefault(); load(false); });
  $('older').addEventListener('click', () => load(true));
  load(false);
})();
</script>
