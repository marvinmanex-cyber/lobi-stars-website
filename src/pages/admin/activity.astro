---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/admin/AdminNav.astro';
---
<Layout title="Activity Log | Lobi Stars Admin" description="What staff have done in the admin." noindex>
  <div class="wrap al">
    <AdminNav current="activity" />
    <div class="stag">Settings</div>
    <h1 class="stitle">Activity <span class="r">Log</span></h1>
    <p class="muted al-lede">Every export, deletion, unsubscribe, staff change, award change, membership confirmation and order update, newest first.</p>
    <form class="al-search" id="f"><label class="sr-only" for="q">Search the log</label><input class="form-inp" id="q" type="search" placeholder="Search by staff name, action or detail" /><button class="btn-p" type="submit">Search</button></form>
    <div class="panel al-panel"><div class="scroll" id="log"><p class="muted">Loading…</p></div></div>
  </div>
</Layout>

<style>
  .al { max-width: 1200px; padding-top: 28px; padding-bottom: 80px; }
  .al-lede { max-width: 760px; margin-bottom: 16px; }
  .al-search { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
  .al-search .form-inp { flex: 1 1 260px; }
  .al-panel { padding: 0; overflow: hidden; }
  .scroll { overflow-x: auto; max-height: 70vh; }
  .al :global(table) { width: 100%; border-collapse: collapse; font-size: 14px; }
  .al :global(th) { position: sticky; top: 0; background: #15181D; color: #fff; text-align: left; padding: 10px 12px; font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.2px; text-transform: uppercase; }
  .al :global(td) { padding: 9px 12px; border-bottom: 1px solid var(--d4); vertical-align: top; }
  .al :global(tbody tr:nth-child(even)) { background: #FAFBFC; }
  .al :global(tbody tr:hover) { background: #FFF8E1; }
  .al :global(.act) { display: inline-block; padding: 2px 8px; border-radius: 999px; background: #EEF2FF; color: #3730A3; font-size: 12px; font-weight: 700; white-space: nowrap; }
  .al :global(.act.export) { background: #FEF3C7; color: #92400E; } .al :global(.act.delete) { background: #FDECEC; color: #A3161B; }
  .al :global(.empty) { padding: 30px; text-align: center; color: var(--lt); }
</style>

<script is:inline>
(function () {
  const code = sessionStorage.getItem('ls_admin_code') || '__session__';
  const $ = id => document.getElementById(id);
  const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const when = ts => { const d = new Date(ts.includes('T') ? ts : ts.replace(' ', 'T') + 'Z'); return d.toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Lagos' }); };
  async function load(q) {
    const res = await fetch('/api/admin/activity' + (q ? '?q=' + encodeURIComponent(q) : ''), { headers: { 'x-admin-code': code } });
    const d = await res.json().catch(() => ({}));
    if (!res.ok) { $('log').innerHTML = `<p class="empty">${esc(d.error || 'Could not load the log.')}</p>`; return; }
    $('log').innerHTML = d.log.length ? '<table><thead><tr><th>When (WAT)</th><th>Staff</th><th>Action</th><th>Detail</th></tr></thead><tbody>' +
      d.log.map(r => `<tr><td>${esc(when(r.ts))}</td><td>${esc(r.staff_name)}</td><td><span class="act ${/export/.test(r.action) ? 'export' : /delete|remove/.test(r.action) ? 'delete' : ''}">${esc(r.action.replace(/_/g, ' '))}</span></td><td>${esc(r.detail)}</td></tr>`).join('') +
      '</tbody></table>' : '<p class="empty">Nothing in the log yet 🎉</p>';
  }
  $('f').addEventListener('submit', e => { e.preventDefault(); load($('q').value.trim()); });
  load('');
})();
</script>
