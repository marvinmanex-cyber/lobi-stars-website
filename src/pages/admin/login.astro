---
import Layout from '../../layouts/Layout.astro';
// The human check (Cloudflare Turnstile) appears after 3 wrong attempts.
import settings from '../../data/fan-settings.json';
const siteKey = settings.turnstileSiteKey || '';
---
<Layout title="Staff Login | Lobi Stars Admin" description="Lobi Stars FC staff login." noindex>
  <div class="wrap login-wrap">
    <div class="login-card">
      <div class="login-icon" aria-hidden="true">&#128274;</div>
      <h1 class="login-title">Staff login</h1>
      <p class="login-note" id="note" role="status" hidden></p>

      <div class="login-tabs" role="tablist" aria-label="Login type">
        <button type="button" role="tab" id="tabStaff" aria-selected="true" aria-controls="staffForm">Staff account</button>
        <button type="button" role="tab" id="tabOwner" aria-selected="false" aria-controls="ownerForm">Admin code (owner)</button>
      </div>

      <form id="staffForm" aria-labelledby="tabStaff">
        <label class="login-label" for="email">Email</label>
        <input id="email" type="email" autocomplete="username" required />
        <label class="login-label" for="password">Password</label>
        <input id="password" type="password" autocomplete="current-password" required />
        <div id="otpWrap" hidden>
          <label class="login-label" for="otp">6-digit code from your authenticator app</label>
          <input id="otp" autocomplete="one-time-code" maxlength="9" aria-describedby="otpHelp" />
          <p class="muted login-help" id="otpHelp">Lost your phone? Type one of your backup codes instead (like <code>abcd-efgh</code>).</p>
        </div>
        <button type="submit" class="btn-p">Log in</button>
      </form>

      <div id="captcha" class="login-captcha" data-sitekey={siteKey} hidden><div id="tsBox"></div></div>

      <form id="ownerForm" aria-labelledby="tabOwner" hidden>
        <p class="muted">The owner signs in with the club's admin code: the way in if nothing else works. Every use is emailed to the Super Admins.</p>
        <label class="login-label" for="code">Admin code</label>
        <input id="code" name="code" type="password" autocomplete="current-password" required />
        <button type="submit" class="btn-p" id="submit">Log in</button>
      </form>
      <a class="login-back" href="/">← Back to the website</a>

      <p class="login-err" id="err" role="alert" hidden></p>
    </div>
  </div>
</Layout>

<style>
  .login-wrap { padding-top: 60px; padding-bottom: 60px; display: flex; justify-content: center; }
  .login-card {
    width: 100%; max-width: 420px; background: var(--d2); border: 1px solid var(--d4); border-radius: 12px;
    padding: 32px 28px; box-shadow: 0 16px 40px rgba(15, 17, 21, .08); display: flex; flex-direction: column; gap: 12px;
  }
  .login-card form { display: flex; flex-direction: column; gap: 10px; }
  .login-icon { font-size: 34px; }
  .login-back { display: block; margin-top: 18px; text-align: center; color: var(--lt); font-weight: 600; text-decoration: none; }
  .login-back:hover { color: var(--red); text-decoration: underline; }
  .login-title { font: 400 38px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; margin: 0; }
  .login-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; background: var(--d3); padding: 4px; border-radius: 8px; }
  .login-tabs button { border: 0; background: none; padding: 10px 6px; border-radius: 6px; cursor: pointer; font: 700 13px/1.1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: var(--lt); }
  .login-tabs button[aria-selected='true'] { background: #fff; color: var(--red-text); box-shadow: 0 1px 4px rgba(0, 0, 0, .08); }
  .login-label { font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; color: var(--lt); margin-top: 6px; }
  .login-card input {
    padding: 13px 14px; border: 1px solid var(--d4); border-radius: 6px; font-size: 16px; background: var(--d3); color: var(--white);
  }
  .login-card input:focus { outline: 2px solid var(--red); outline-offset: 1px; }
  .login-card .btn-p { width: 100%; margin-top: 8px; }
  .login-err { color: #C11A1F; font-size: 14px; margin: 0; }
  .login-note { margin: 0; padding: 10px 12px; border-radius: 8px; background: #FFF4E5; color: #7A4B00; font-size: 14px; }
  .login-help { font-size: 13px; margin: 0; }
  .login-captcha { min-height: 66px; }
</style>

<script>
  const err = document.getElementById('err')!;
  const params = new URLSearchParams(location.search);
  const next = params.get('next') || '';
  const note = document.getElementById('note')!;
  if (params.has('idle')) { note.textContent = 'You were signed out after 30 minutes without activity. Please log in again.'; note.hidden = false; }
  else if (params.has('ended')) { note.textContent = 'You were signed out (12 hours is the longest a login lasts, or you were signed out on another device). Please log in again.'; note.hidden = false; }
  sessionStorage.removeItem('ls_admin_code');

  // The human check, shown after 3 wrong attempts.
  const SITE_KEY = document.getElementById('captcha')!.dataset.sitekey || '';
  let tsToken = '', tsReady = false;
  function showCaptcha() {
    const box = document.getElementById('captcha')!;
    if (!SITE_KEY) return;
    box.hidden = false;
    const w = window as unknown as { turnstile?: { render: (el: string, o: object) => void; reset: () => void } };
    if (tsReady) { w.turnstile?.reset(); tsToken = ''; return; }
    const draw = () => { tsReady = true; w.turnstile!.render('#tsBox', { sitekey: SITE_KEY, callback: (t: string) => { tsToken = t; } }); };
    if (w.turnstile) return draw();
    const sc = document.createElement('script');
    sc.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit'; sc.async = true; sc.onload = draw;
    document.head.appendChild(sc);
  }
  const target = /^\/admin(\/|$)/.test(next) && !next.startsWith('/admin/login') ? next : '/admin/dashboard/';
  const tabs = { staff: document.getElementById('tabStaff')!, owner: document.getElementById('tabOwner')! };
  const forms = { staff: document.getElementById('staffForm') as HTMLFormElement, owner: document.getElementById('ownerForm') as HTMLFormElement };

  function show(which: 'staff' | 'owner') {
    (['staff', 'owner'] as const).forEach(k => {
      tabs[k].setAttribute('aria-selected', String(k === which));
      forms[k].hidden = k !== which;
    });
    err.hidden = true;
  }
  tabs.staff.addEventListener('click', () => show('staff'));
  tabs.owner.addEventListener('click', () => show('owner'));

  async function login(body: Record<string, string>, marker: string, btn: HTMLButtonElement) {
    btn.disabled = true; err.hidden = true;
    try {
      const res = await fetch('/api/admin/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(tsToken ? { ...body, turnstile: tsToken } : body) });
      const data = await res.json().catch(() => ({}));
      if (data.needCode) {
        // Two-step login: show the code box and ask for the authenticator code.
        const w = document.getElementById('otpWrap')!; w.hidden = false;
        (document.getElementById('otp') as HTMLInputElement).focus();
      }
      if (data.needCaptcha) showCaptcha();
      if (!res.ok) throw new Error(data.error === 'Invalid admin code' ? 'That code is not correct.' : data.error || 'Login failed. Please try again.');
      // Admin pages send this with each request: a marker meaning "use my
      // session cookie" (the admin code itself is not kept in the browser).
      sessionStorage.setItem('ls_admin_code', marker);
      location.href = data.mustChangePassword ? '/admin/account/?must=password' : target;
    } catch (ex) {
      err.textContent = (ex as Error).message; err.hidden = false;
    } finally { btn.disabled = false; }
  }

  forms.staff.addEventListener('submit', e => {
    e.preventDefault();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value;
    if (!email || !password) return;
    const otp = (document.getElementById('otp') as HTMLInputElement).value.trim();
    login(otp ? { email, password, otp } : { email, password }, '__session__', forms.staff.querySelector('button')!);
  });
  forms.owner.addEventListener('submit', e => {
    e.preventDefault();
    const code = (document.getElementById('code') as HTMLInputElement).value.trim();
    if (!code) return;
    login({ code }, '__session__', forms.owner.querySelector('button')!);
  });
</script>
