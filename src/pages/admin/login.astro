---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Staff Login | Lobi Stars Admin" description="Lobi Stars FC staff login." noindex>
  <div class="wrap login-wrap">
    <form class="login-card" id="loginForm">
      <div class="login-icon" aria-hidden="true">&#128274;</div>
      <h1 class="login-title">Staff login</h1>
      <p class="muted">Enter the admin code to open the club admin area.</p>
      <label class="login-label" for="code">Admin code</label>
      <input id="code" name="code" type="password" autocomplete="current-password" required />
      <button type="submit" class="btn-p" id="submit">Log in</button>
      <p class="login-err" id="err" role="alert" hidden></p>
    </form>
  </div>
</Layout>

<style>
  .login-wrap { padding-top: 110px; padding-bottom: 60px; display: flex; justify-content: center; }
  .login-card {
    width: 100%; max-width: 400px; background: var(--d2); border: 1px solid var(--d4); border-radius: 12px;
    padding: 36px 30px; box-shadow: 0 16px 40px rgba(15, 17, 21, .08); display: flex; flex-direction: column; gap: 12px;
  }
  .login-icon { font-size: 34px; }
  .login-title { font: 400 38px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; margin: 0; }
  .login-label { font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; color: var(--lt); margin-top: 8px; }
  .login-card input {
    padding: 13px 14px; border: 1px solid var(--d4); border-radius: 6px; font-size: 16px; background: var(--d3); color: var(--white);
  }
  .login-card input:focus { outline: 2px solid var(--red); outline-offset: 1px; }
  .login-card .btn-p { width: 100%; margin-top: 6px; }
  .login-err { color: #C11A1F; font-size: 14px; margin: 0; }
</style>

<script>
  const form = document.getElementById('loginForm') as HTMLFormElement;
  const input = document.getElementById('code') as HTMLInputElement;
  const err = document.getElementById('err')!;
  const btn = document.getElementById('submit') as HTMLButtonElement;

  // Only ever send people back to an /admin page after logging in.
  const next = new URLSearchParams(location.search).get('next') || '';
  const target = /^\/admin(\/|$)/.test(next) && !next.startsWith('/admin/login') ? next : '/admin/matches';

  form.addEventListener('submit', async e => {
    e.preventDefault();
    const code = input.value.trim();
    if (!code) return;
    btn.disabled = true;
    err.hidden = true;
    try {
      const res = await fetch('/api/admin/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Login failed. Please try again.');
      // The Manage Matches and Analytics pages read the code from here, so
      // staff aren't asked for it a second time.
      sessionStorage.setItem('ls_admin_code', code);
      location.href = target;
    } catch (ex) {
      err.textContent = (ex as Error).message === 'Invalid admin code' ? 'That code is not correct.' : (ex as Error).message;
      err.hidden = false;
      btn.disabled = false;
    }
  });
</script>
