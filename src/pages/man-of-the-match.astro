---
import Layout from '../layouts/Layout.astro';
import MatchdayGamePage from '../components/fans/MatchdayGamePage.astro';
import MotmAnnouncement from '../components/MotmAnnouncement.astro';
// The winner card and sponsor are filled in on the server (functions/man-of-the-match.js).
---
<Layout title="Vote for Man of the Match | Lobi Stars Football Club" description="Vote for the Lobi Stars Man of the Match at every home game with a free fan account. Voting opens at 4:00 pm and the winner is announced at 5:50 pm, before the final whistle.">
  <MatchdayGamePage
    kind="vote"
    kicker="Matchday Live"
    title="Man of the"
    highlight="Match"
    intro="Who is the best Lobi Stars player on the day? At every Lobi Stars home game, fans choose the Man of the Match. Voting opens at 4:00 pm and the winner is announced at 5:50 pm, before the final whistle."
    steps={[
      { title: 'Create a fan account', text: 'It is free. Confirm your email address so your vote counts.' },
      { title: 'Vote from 4:00 pm', text: 'Voting opens automatically at kick-off. Open the game from Fixtures or this page and choose the Vote tab in Matchday Live.' },
      { title: 'Pick your player', text: 'Choose one Lobi Stars player that is performing the most on the field. One vote per fan per match.' },
      { title: 'See the winner', text: 'The Man of the Match is announced 5 minutes to the end of the match.' },
    ]}
    rules={[
      'Voting is for Lobi Stars home games only.',
      'Voting opens at 4:00 pm and closes at 5:50 pm.',
      'You can vote for players in the starting XI and substitutes who come on during the match. Unused substitutes cannot be voted for.',
      'One vote per verified fan account per match.',
      'The winner is announced automatically at 5:50 pm, together with how the top 3 players were voted: their votes and percentages.',
      'If players are level on votes, the player who reached that total first wins.',
      'All voting times use the official club clock (Nigerian time).',
    ]}
  >
    <MotmAnnouncement slot="top" />
  </MatchdayGamePage>
</Layout>
