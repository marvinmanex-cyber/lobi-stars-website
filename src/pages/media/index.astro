---
// /media -- the Press Room: the club's page for journalists. A newsroom look
// (different from the accreditation hub): the featured latest press release, a
// match-week strip (next home match, crests, accreditation countdown), four
// service tiles, club facts for reporters, the release list and the media contact.
// Content comes from the Media Centre (approved before publishing).
import Layout from '../../layouts/Layout.astro';
import { TEAM_LOGOS } from '../../../functions/api/_lib/teamLogos.js';
import ShareButton from '../../components/ShareButton.astro';
---
<Layout title="Media | Lobi Stars Football Club" description="The Lobi Stars FC Press Room: press releases, media accreditation for home matches at McCarthy Stadium, interview requests and the media contact.">
  <div class="pr" id="pr" data-logos={JSON.stringify(TEAM_LOGOS)}>
    <section class="pr-hero">
      <div class="wrap pr-hero-in">
        <div class="pr-hero-copy">
          <p class="pr-tag"><span></span>Lobi Stars FC · Media</p>
          <h1 class="pr-h1">The <em>Press</em> Room</h1>
          <p class="pr-lede">Official statements, match accreditation and interviews for journalists, photographers and broadcasters covering the Pride of Benue.</p>
          <div class="pr-hero-links"><a href="/media/press-releases/">Press releases</a><a href="/media/accreditation/">Accreditation</a><a href="/media/interview-request/">Interviews</a><ShareButton title="Lobi Stars FC Press Room" text="The Lobi Stars FC Press Room: press releases, media accreditation for home matches and interview requests." label="Share with media houses" class="pr-share" /></div>
        </div>
        <a class="pr-feature" id="feature" href="/media/press-releases/">
          <span class="pr-feature-k">Latest statement</span>
          <b id="fTitle">Official club statements appear here</b>
          <span class="pr-feature-sub" id="fSub">Press releases are published by the club's media team, each with a branded PDF.</span>
          <span class="pr-feature-d" id="fDate"></span>
          <span class="pr-feature-go">Read →</span>
        </a>
      </div>
    </section>

    <section class="wrap">
      <a class="pr-week" id="week" href="/media/accreditation/">
        <span class="pr-week-k">Match week</span>
        <span class="pr-week-m"><span class="pr-mini" id="wHome"></span><b id="wTeams">Next home match</b><span class="pr-mini" id="wAway"></span></span>
        <span class="pr-week-d" id="wWhen"></span>
        <span class="pr-week-s" id="wStatus">Accreditation</span>
      </a>
    </section>

    <section class="wrap pr-tiles" aria-label="Media services">
      <a class="pr-tile blue" href="/media/accreditation/"><span class="pr-n">01</span><b>Match accreditation</b><p>Apply to cover a home match at McCarthy Stadium. Applications close <span class="pr-close">6</span> hours before kick-off.</p><span class="pr-arrow">Apply →</span></a>
      <a class="pr-tile red" href="/media/press-releases/"><span class="pr-n">02</span><b>Press releases</b><p>Every official statement and announcement, with a PDF to download.</p><span class="pr-arrow">Read →</span></a>
      <a class="pr-tile white" href="/media/interview-request/"><span class="pr-n">03</span><b>Interview requests</b><p>Ask to speak to a player, the coach or a club official.</p><span class="pr-arrow">Request →</span></a>
      <a class="pr-tile dark" href="mailto:media@lobistarsfc.com"><span class="pr-n">04</span><b>Email the media team</b><p>media@lobistarsfc.com. We reply within one working day.</p><span class="pr-arrow">Write →</span></a>
    </section>

    <section class="wrap pr-cols">
      <div class="pr-list-box">
        <div class="pr-sec-h"><h2>Newsroom</h2><a href="/media/press-releases/">All releases →</a></div>
        <ol class="pr-list" id="prList"><li class="pr-empty">Loading…</li></ol>
      </div>
      <aside class="pr-facts">
        <h2>Club at a glance</h2>
        <dl>
          <div><dt>Club</dt><dd>Lobi Stars Football Club</dd></div>
          <div><dt>Nickname</dt><dd>Pride of Benue</dd></div>
          <div><dt>Home ground</dt><dd>McCarthy Stadium, Makurdi, Benue State</dd></div>
          <div><dt>Competition</dt><dd>Nigeria National League</dd></div>
          <div><dt>Media email</dt><dd><a href="mailto:media@lobistarsfc.com">media@lobistarsfc.com</a></dd></div>
          <div><dt>Website</dt><dd>lobistarsfc.com</dd></div>
        </dl>
      </aside>
    </section>

    <section class="pr-contact">
      <div class="wrap pr-contact-in">
        <div><h2>Talk to the media team</h2><p id="contact">Lobi Stars FC Media Department</p></div>
        <a class="pr-contact-btn" id="mail" href="mailto:media@lobistarsfc.com">media@lobistarsfc.com</a>
      </div>
    </section>
  </div>
</Layout>
<style is:global>
  .pr { --blue: #1C3F7A; --red: #E31E24; --ink: #12161D; --muted: #5B6472; background: #F4F6FA; }
  .pr-hero { position: relative; overflow: hidden; background: #fff; border-bottom: 1px solid #E3E6EB; }
  .pr-hero::before { content: ''; position: absolute; right: -120px; top: -60px; width: 520px; height: 520px; background: repeating-linear-gradient(135deg, rgba(227,30,36,.09) 0 18px, transparent 18px 36px, rgba(28,63,122,.08) 36px 54px, transparent 54px 72px); transform: rotate(8deg); }
  .pr-hero-in { position: relative; display: grid; gap: 28px; padding-top: 54px !important; padding-bottom: 54px !important; align-items: center; }
  @media (min-width: 960px) { .pr-hero-in { grid-template-columns: 1.15fr .85fr; } }
  .pr-tag { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 3px; text-transform: uppercase; color: var(--blue); }
  .pr-tag span { width: 34px; height: 4px; background: var(--red); border-radius: 2px; }
  .pr-h1 { margin: 0 0 16px; font: 400 clamp(56px, 9vw, 112px)/.88 'Bebas Neue', sans-serif; color: var(--ink); letter-spacing: 1px; }
  .pr-h1 em { font-style: normal; color: var(--red); }
  .pr-lede { max-width: 560px; margin: 0 0 20px; font-size: 18px; line-height: 1.6; color: var(--muted); }
  .pr-hero-links { display: flex; flex-wrap: wrap; gap: 8px; }
  .pr-hero-links a { padding: 10px 16px; border-radius: 999px; border: 2px solid var(--ink); color: var(--ink); text-decoration: none; font: 700 14px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; }
  .pr-hero-links a:first-child { background: var(--ink); color: #fff; }
  .pr-feature { position: relative; display: flex; flex-direction: column; gap: 10px; min-height: 260px; padding: 26px; border-radius: 4px; background: var(--blue); color: #fff; text-decoration: none; box-shadow: 14px 14px 0 var(--red); }
  .pr-feature-k { align-self: flex-start; padding: 5px 10px; background: var(--red); font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; }
  .pr-feature b { font: 400 clamp(30px, 3.4vw, 42px)/1.02 'Bebas Neue', sans-serif; letter-spacing: .5px; }
  .pr-feature-sub { color: rgba(255,255,255,.82); line-height: 1.5; }
  .pr-feature-d { margin-top: auto; font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; color: #BFD2F1; }
  .pr-feature-go { font: 700 15px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; }
  .pr-week { display: grid; grid-template-columns: auto 1fr; gap: 6px 16px; align-items: center; margin: 26px 0 0; padding: 14px 18px; border-radius: 12px; background: var(--ink); color: #fff; text-decoration: none; }
  @media (min-width: 900px) { .pr-week { grid-template-columns: auto auto 1fr auto; } }
  .pr-week-k { padding: 6px 10px; border-radius: 6px; background: var(--red); font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; }
  .pr-week-m { display: inline-flex; align-items: center; gap: 10px; }
  .pr-week-m b { font: 400 24px/1 'Bebas Neue', sans-serif; letter-spacing: .5px; }
  .pr-mini { width: 34px; height: 34px; display: inline-grid; place-items: center; }
  .pr-mini img { width: 100%; height: 100%; object-fit: contain; }
  .pr-week-d { color: rgba(255,255,255,.8); }
  .pr-week-s { justify-self: start; padding: 8px 12px; border-radius: 8px; background: rgba(255,255,255,.1); font: 700 14px/1.2 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: #8CF0A9; }
  @media (min-width: 900px) { .pr-week-s { justify-self: end; } }
  .pr-tiles { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); padding-top: 26px !important; }
  .pr-tile { position: relative; display: flex; flex-direction: column; gap: 8px; min-height: 230px; padding: 22px; border-radius: 4px; text-decoration: none; overflow: hidden; transition: transform .15s; }
  .pr-tile:hover { transform: translateY(-4px); }
  .pr-tile.blue { background: var(--blue); color: #fff; } .pr-tile.red { background: var(--red); color: #fff; }
  .pr-tile.white { background: #fff; color: var(--ink); border: 2px solid var(--ink); } .pr-tile.dark { background: var(--ink); color: #fff; }
  .pr-n { font: 400 64px/1 'Bebas Neue', sans-serif; opacity: .25; position: absolute; right: 14px; top: 8px; }
  .pr-tile b { font: 400 32px/1 'Bebas Neue', sans-serif; letter-spacing: .5px; margin-top: 40px; }
  .pr-tile p { margin: 0; flex: 1; line-height: 1.5; opacity: .9; }
  .pr-arrow { font: 700 15px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; }
  .pr-cols { display: grid; gap: 18px; grid-template-columns: 1fr; padding-top: 30px !important; padding-bottom: 40px !important; }
  @media (min-width: 900px) { .pr-cols { grid-template-columns: 1.55fr 1fr; } }
  .pr-list-box, .pr-facts { background: #fff; border-radius: 12px; padding: 22px; border: 1px solid #E3E6EB; }
  .pr-sec-h { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; border-bottom: 3px solid var(--ink); padding-bottom: 8px; margin-bottom: 4px; }
  .pr-sec-h h2, .pr-facts h2 { margin: 0; font: 400 36px/1 'Bebas Neue', sans-serif; color: var(--ink); }
  .pr-sec-h a { color: var(--red); font-weight: 700; text-decoration: none; }
  .pr-list { list-style: none; margin: 0; padding: 0; counter-reset: n; }
  .pr-list li { counter-increment: n; border-bottom: 1px solid #EEF0F3; }
  .pr-list a { display: grid; grid-template-columns: 46px 1fr; gap: 4px 12px; padding: 14px 0; color: var(--ink); text-decoration: none; }
  .pr-list a::before { content: counter(n, decimal-leading-zero); grid-row: span 3; font: 400 34px/1 'Bebas Neue', sans-serif; color: var(--red); }
  .pr-list small { font: 700 12px/1.4 'Barlow Condensed', sans-serif; letter-spacing: 1.4px; text-transform: uppercase; color: var(--blue); }
  .pr-list b { font-size: 18px; line-height: 1.3; } .pr-list a:hover b { color: var(--red); }
  .pr-list span { color: var(--muted); font-size: 14px; }
  .pr-empty { padding: 16px 0; color: var(--muted); }
  .pr-facts { border-top: 6px solid var(--red); }
  .pr-facts dl { margin: 12px 0 0; display: grid; gap: 0; }
  .pr-facts dl div { display: grid; grid-template-columns: 120px 1fr; gap: 10px; padding: 10px 0; border-bottom: 1px dashed #DDE1E8; }
  .pr-facts dt { font: 700 13px/1.4 'Barlow Condensed', sans-serif; letter-spacing: 1.2px; text-transform: uppercase; color: var(--muted); }
  .pr-facts dd { margin: 0; font-weight: 600; color: var(--ink); } .pr-facts a { color: var(--blue); }
  .pr-contact { background: var(--red); color: #fff; }
  .pr-contact-in { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; padding-top: 34px !important; padding-bottom: 34px !important; }
  .pr-contact h2 { margin: 0 0 4px; font: 400 40px/1 'Bebas Neue', sans-serif; }
  .pr-contact p { margin: 0; opacity: .9; }
  .pr-contact-btn { padding: 14px 22px; border-radius: 8px; background: #fff; color: var(--red); text-decoration: none; font: 700 18px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; }
</style>
<script>
  const $ = (id: string) => document.getElementById(id) as any;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  const LOGOS: Record<string, string> = JSON.parse(($('pr') as HTMLElement).dataset.logos || '{}');
  const mini = (name: string) => (LOGOS[name] ? `<img src="${esc(LOGOS[name])}" alt="" />` : '');
  // Match week: the next home match and when accreditation closes.
  fetch('/api/media/accreditation').then(r => r.json()).then((d: any) => {
    document.querySelectorAll('.pr-close').forEach(el => { el.textContent = String(d.closeHours); });
    const m = (d.matches || []).find((x: any) => x.open) || (d.matches || [])[0];
    if (!m) { $('wTeams').textContent = 'Next home match to be announced'; $('wStatus').textContent = 'Accreditation'; return; }
    const [home, away] = String(m.label).split(' v ');
    $('wHome').innerHTML = mini(home); $('wAway').innerHTML = mini(away || '');
    $('wTeams').textContent = `${home} v ${away || ''}`;
    $('wWhen').textContent = `${m.day} · Kick-off ${m.kickOff} · McCarthy Stadium`;
    $('week').href = `/media/accreditation/?match=${encodeURIComponent(m.slug || m.id)}`;
    const left = Date.parse(m.closesAt) - Date.now();
    if (!m.open) { $('wStatus').textContent = 'Accreditation closed'; $('wStatus').style.color = '#FF9C9F'; }
    else if (left <= 0 || m.reopened) $('wStatus').textContent = 'Accreditation open: apply now';
    else { const dd = Math.floor(left / 864e5), hh = Math.floor(left / 36e5) % 24; $('wStatus').textContent = `Accreditation open · closes in ${dd ? `${dd}d ` : ''}${hh}h`; }
  }).catch(() => { $('wTeams').textContent = 'Next home match'; });
  // The featured statement, the newsroom list and the contact.
  fetch('/api/media/press-releases').then(r => r.json()).then((d: any) => {
    const [first, ...rest] = d.latest || [];
    if (first) { $('fTitle').textContent = first.headline; $('fSub').textContent = first.subheadline || 'Read the full statement and download the PDF.'; $('fDate').textContent = `${first.date}${first.statement ? ' · Statement' : ''}`; $('feature').href = first.url; }
    const list = first ? [first, ...rest] : [];
    $('prList').innerHTML = list.length ? list.map((r: any) => `<li><a href="${esc(r.url)}"><small>${esc(r.date)}${r.statement ? ' · Statement' : ''}</small><b>${esc(r.headline)}</b>${r.subheadline ? `<span>${esc(r.subheadline)}</span>` : ''}</a></li>`).join('') : '<li class="pr-empty">No press releases yet. Official statements will appear here first.</li>';
    if (d.contact) {
      const mail = (String(d.contact).match(/[^\s@·,]+@[^\s@·,]+\.[a-z]{2,}/i) || [])[0];
      const text = String(d.contact).replace(mail || '\u0000', '').replace(/[\s·,–-]+$/, '').trim();
      if (text) $('contact').textContent = text;
      if (mail) { $('mail').href = `mailto:${mail}`; $('mail').textContent = mail; }
    }
  }).catch(() => { $('prList').innerHTML = '<li class="pr-empty">The newsroom could not load. Please refresh the page.</li>'; });
</script>
