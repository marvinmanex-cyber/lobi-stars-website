---
// /media/accreditation -- the public request form for media accreditation at a
// Lobi Stars FC HOME match (one match per application; closes 6 hours before
// kick-off). Decided by the media team in the Media Centre; the card is emailed.
// ?match=<slug> preselects the match (invitation links and match pages);
// ?update=<token> answers a request for more information.
import Layout from '../../layouts/Layout.astro';
import { TEAM_LOGOS } from '../../../functions/api/_lib/teamLogos.js';
---
<Layout title="Media accreditation | Lobi Stars Football Club" description="Request media accreditation for a Lobi Stars FC home match at McCarthy Stadium, Makurdi.">
  <section class="ah-hero" data-logos={JSON.stringify(TEAM_LOGOS)} id="hub">
    <div class="wrap ah-in">
      <div class="ah-copy">
        <p class="ah-kicker">Press &amp; Media · McCarthy Stadium, Makurdi</p>
        <h1 class="ah-title">Media Accreditation <span>Hub</span></h1>
        <p class="ah-lede">For journalists, photographers, camera crews, radio commentators and digital media covering Lobi Stars FC home matches. One match per application; applications close <b id="closeH">6</b> hours before kick-off.</p>
        <div class="ah-cta"><a class="ah-btn" href="#apply">Apply for accreditation</a><a class="ah-btn ghost" href="/media/">Media page</a></div>
      </div>
      <article class="ah-match" id="nextCard" aria-live="polite">
        <p class="ah-mlabel" id="nmLabel">Next home match</p>
        <div class="ah-teams">
          <div class="ah-team"><span class="ah-crest" id="nmHomeCrest"></span><b id="nmHome">Lobi Stars FC</b></div>
          <span class="ah-vs">VS</span>
          <div class="ah-team"><span class="ah-crest" id="nmAwayCrest"></span><b id="nmAway">Loading…</b></div>
        </div>
        <p class="ah-when" id="nmWhen"></p>
        <p class="ah-venue" id="nmVenue">McCarthy Stadium, Makurdi</p>
        <div class="ah-status" id="nmStatus"></div>
      </article>
    </div>
  </section>

  <section class="wrap ah-info" aria-label="How accreditation works">
    <div class="ah-steps">
      <div class="ah-step"><span>1</span><b>Apply online</b><p>Choose the match, add your press ID or letter and a passport photo.</p></div>
      <div class="ah-step"><span>2</span><b>Media team review</b><p>The club's media team approves, asks for more, or declines, by email.</p></div>
      <div class="ah-step"><span>3</span><b>Card by email</b><p>Approved? Your accreditation card (PDF with a QR code) is emailed to you.</p></div>
      <div class="ah-step"><span>4</span><b>Show it at the gate</b><p>Bring the card (phone or printed) and photo ID. Valid for that match only.</p></div>
    </div>
    <div class="ah-cards">
      <div class="ah-card"><h2>Access zones</h2><ul><li><b>Press Box</b> writers, radio and TV commentary</li><li><b>Pitchside</b> photographers and camera crews</li><li><b>Mixed Zone</b> post-match interviews</li></ul></div>
      <div class="ah-card"><h2>What you need</h2><ul><li>Press ID or a letter from your organisation (PDF/JPG)</li><li>A passport photo (plain background)</li><li>One application per match</li></ul></div>
      <div class="ah-card"><h2>Media rules</h2><ul><li>Stay in your access zone and wear your card</li><li>Follow stewards' instructions</li><li>Interviews only in the mixed zone</li></ul></div>
    </div>
    <div class="ah-more" id="moreMatches" hidden><h2>Other upcoming home matches</h2><div id="moreList"></div></div>
  </section>

  <div class="page-content wrap ac" id="apply">
    <div class="ah-formhead"><p class="ah-kicker dark">Application form</p><h2>Apply for accreditation</h2></div>
    <p class="ac-msg" id="msg" role="alert" hidden></p>
    <section class="panel" id="done" hidden><h2>Thank you</h2><p id="doneText">We have your request. Our media team will review it and email you. Please do not come to the stadium expecting accreditation until you receive your card.</p><p><a href="/media/">Back to the Media page</a></p></section>
    <form class="panel ac-form" id="f" novalidate>
      <p class="ac-info" id="infoReq" hidden></p>
      <div class="ac-f"><label for="eventId">Match <span class="req">*</span></label><select id="eventId" name="eventId" required><option value="">Loading the home matches…</option></select><small id="evHint"></small></div>
      <div class="ac-two">
        <div class="ac-f"><label for="email">Email <span class="req">*</span></label><input id="email" name="email" type="email" autocomplete="email" required /><small id="known"></small>
          <div class="ac-code" id="codeBox"><button type="button" class="ac-link" id="askCode">Applied before? Email me a code to fill in my details</button>
            <span id="codeRow" hidden><input id="code" inputmode="numeric" maxlength="6" placeholder="6-digit code" aria-label="Code from the email" /><button type="button" class="btn-o" id="useCode">Fill in</button></span></div></div>
        <div class="ac-f"><label for="fullName">Full name <span class="req">*</span></label><input id="fullName" name="fullName" autocomplete="name" maxlength="80" required /></div>
        <div class="ac-f"><label for="phone">Phone <span class="req">*</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="24" required placeholder="e.g. 0803 123 4567" /></div>
        <div class="ac-f"><label for="organisation">Media organisation <span class="req">*</span></label><input id="organisation" name="organisation" maxlength="120" required placeholder="or Freelance" /></div>
      </div>
      <fieldset class="ac-f"><legend>Staff or freelance <span class="req">*</span></legend><label class="ac-r"><input type="radio" name="employment" value="staff" required /> Staff</label><label class="ac-r"><input type="radio" name="employment" value="freelance" /> Freelance</label></fieldset>
      <div class="ac-f"><label for="role">Role <span class="req">*</span></label><select id="role" name="role" required><option value="">Choose…</option></select></div>
      <div class="ac-f"><label for="pressDoc">Press ID or letter from your organisation <span class="req">*</span></label><input id="pressDoc" name="pressDoc" type="file" accept="application/pdf,image/jpeg" /><small>PDF or JPG, up to 5 MB.</small></div>
      <div class="ac-f"><span class="ac-lbl">Passport photo <span class="req">*</span></span>
        <input id="photoIn" type="file" accept="image/jpeg,image/png,image/webp" />
        <small>Plain light background, face clearly visible, no sunglasses or hat. Drag the photo and use the slider so your face fills the frame.</small>
        <div class="ac-crop" id="crop" hidden><canvas id="cv" width="300" height="400" aria-label="Photo preview"></canvas><label class="ac-zoom">Zoom <input id="zoom" type="range" min="1" max="3" step="0.01" value="1" /></label></div>
        <small id="photoOnFile" hidden>We have your passport photo from an earlier application; add a new one only if you want to change it.</small></div>
      <div class="ac-f"><label for="equipment">Equipment you will bring <small>(optional)</small></label><textarea id="equipment" name="equipment" rows="2" maxlength="500" placeholder="e.g. 2 cameras, tripod, laptop"></textarea></div>
      <div class="ac-f"><label for="needs">Special needs <small>(optional)</small></label><textarea id="needs" name="needs" rows="2" maxlength="500" placeholder="e.g. wheelchair access, power socket"></textarea></div>
      <div class="ac-hp" aria-hidden="true"><label for="website">Leave this empty</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
      <label class="ac-agree"><input type="checkbox" name="agree" id="agree" value="1" required /> <span>I agree to the club's media rules: I will stay in my access zone, wear my accreditation at all times, follow stewards' instructions, not interview players outside the mixed zone, and use material only for news reporting. The club may withdraw accreditation at any time. <span class="req">*</span></span></label>
      <button class="btn-p" type="submit" id="send">Send my request</button>
      <p class="muted ac-small">Your details are used only to process this request and to contact you about Lobi Stars media matters. See the <a href="/privacy/">Privacy Policy</a>.</p>
    </form>
  </div>
</Layout>
<style is:global>
  /* Media Accreditation Hub (global: parts are drawn by the script; every class starts ah- or ac-): club colours (red #E31E24, blue #1C3F7A, white). */
  .ah-hero { position: relative; color: #fff; background:
      linear-gradient(115deg, rgba(14,28,56,.96) 0%, rgba(28,63,122,.9) 48%, rgba(193,26,31,.88) 100%),
      url('/images/stadium-2.webp') center / cover no-repeat; padding: 56px 0 64px; overflow: hidden; }
  .ah-hero::after { content: ''; position: absolute; inset: auto 0 0 0; height: 6px; background: linear-gradient(90deg, #E31E24, #fff 50%, #1C3F7A); }
  .ah-in { display: grid; gap: 28px; align-items: center; grid-template-columns: 1fr; }
  @media (min-width: 960px) { .ah-in { grid-template-columns: 1.1fr .9fr; } }
  .ah-kicker { margin: 0 0 10px; font: 700 13px/1.2 'Barlow Condensed', sans-serif; letter-spacing: 3px; text-transform: uppercase; color: #FFD9DA; }
  .ah-kicker.dark { color: #C11A1F; }
  .ah-title { margin: 0 0 14px; font: 400 clamp(44px, 7vw, 84px)/.95 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .ah-title span { color: #FF5A5F; }
  .ah-lede { max-width: 620px; font-size: 18px; line-height: 1.6; color: rgba(255,255,255,.9); margin: 0 0 22px; }
  .ah-cta { display: flex; flex-wrap: wrap; gap: 10px; }
  .ah-btn { display: inline-flex; align-items: center; min-height: 50px; padding: 0 22px; border-radius: 8px; background: #E31E24; color: #fff; text-decoration: none; font: 700 16px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; box-shadow: 0 8px 22px rgba(227,30,36,.35); }
  .ah-btn.ghost { background: transparent; border: 2px solid rgba(255,255,255,.6); box-shadow: none; }
  .ah-match { background: rgba(255,255,255,.97); color: #15181D; border-radius: 18px; padding: 22px 22px 18px; box-shadow: 0 24px 60px rgba(0,0,0,.35); border-top: 6px solid #E31E24; }
  .ah-mlabel { margin: 0 0 12px; font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 2.5px; text-transform: uppercase; color: #1C3F7A; text-align: center; }
  .ah-teams { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 10px; }
  .ah-team { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; }
  .ah-team b { font: 400 22px/1.05 'Bebas Neue', sans-serif; letter-spacing: .5px; }
  .ah-crest { width: 84px; height: 84px; display: grid; place-items: center; }
  .ah-crest img { width: 100%; height: 100%; object-fit: contain; }
  .ah-crest .ph { width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center; background: #1C3F7A; color: #fff; font: 400 34px/1 'Bebas Neue', sans-serif; }
  .ah-vs { font: 400 30px/1 'Bebas Neue', sans-serif; color: #E31E24; }
  .ah-when { margin: 14px 0 2px; text-align: center; font-weight: 700; font-size: 17px; }
  .ah-venue { margin: 0 0 14px; text-align: center; color: #5B6472; }
  .ah-status { border-radius: 12px; padding: 12px 14px; text-align: center; background: #EAF1FB; }
  .ah-status.open { background: #E7F6EC; } .ah-status.closed { background: #FDE8E9; }
  .ah-status b { display: block; font: 700 15px/1.3 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; }
  .ah-status.open b { color: #0B7A2E; } .ah-status.closed b { color: #C11A1F; }
  .ah-count { display: flex; justify-content: center; gap: 8px; margin-top: 8px; }
  .ah-count span { min-width: 56px; padding: 6px 4px; border-radius: 8px; background: #fff; box-shadow: 0 1px 0 rgba(0,0,0,.06); font: 400 26px/1 'Bebas Neue', sans-serif; }
  .ah-count small { display: block; font: 700 10px/1.4 Barlow, sans-serif; letter-spacing: 1px; color: #5B6472; text-transform: uppercase; }
  .ah-info { margin-top: 34px; padding-bottom: 8px; }
  .ah-steps { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); margin-bottom: 18px; }
  .ah-step { position: relative; background: #fff; border: 1px solid #E3E6EB; border-radius: 14px; padding: 18px 16px 16px 64px; }
  .ah-step span { position: absolute; left: 16px; top: 16px; width: 36px; height: 36px; border-radius: 50%; background: #1C3F7A; color: #fff; display: grid; place-items: center; font: 400 22px/1 'Bebas Neue', sans-serif; }
  .ah-step:nth-child(even) span { background: #E31E24; }
  .ah-step b { display: block; font: 700 17px/1.2 'Barlow Condensed', sans-serif; letter-spacing: .5px; text-transform: uppercase; margin-bottom: 4px; }
  .ah-step p { margin: 0; color: #5B6472; font-size: 15px; line-height: 1.45; }
  .ah-cards { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .ah-card { background: linear-gradient(180deg, #F6F8FC, #fff); border: 1px solid #E3E6EB; border-left: 5px solid #1C3F7A; border-radius: 14px; padding: 16px 18px; }
  .ah-card:nth-child(2) { border-left-color: #E31E24; }
  .ah-card h2 { margin: 0 0 8px; font: 400 26px/1 'Bebas Neue', sans-serif; letter-spacing: .5px; color: #15181D; }
  .ah-card ul { margin: 0; padding-left: 18px; line-height: 1.6; color: #3A4250; }
  .ah-more { margin-top: 18px; } .ah-more h2 { font: 400 24px/1 'Bebas Neue', sans-serif; margin: 0 0 8px; }
  .ah-more #moreList { display: flex; flex-wrap: wrap; gap: 8px; }
  .ah-chip { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 4px 12px 4px 6px; border-radius: 999px; background: #fff; border: 1px solid #E3E6EB; font-weight: 600; font-size: 14px; cursor: pointer; }
  .ah-chip img { width: 28px; height: 28px; object-fit: contain; }
  .ah-chip small { color: #5B6472; font-weight: 500; }
  .ah-formhead { margin: 10px 0 14px; } .ah-formhead h2 { margin: 0; font: 400 40px/1 'Bebas Neue', sans-serif; letter-spacing: .5px; }
  .ac .ac-form { border-top: 5px solid #E31E24; }
  .ac-lede { max-width: 760px; }
  .ac { max-width: 860px; }
  .ac-msg { padding: 12px 14px; border-radius: 10px; background: #FDE8E9; color: #8E1A20; font-weight: 600; }
  .ac-form { display: grid; gap: 4px; }
  .ac-f { display: flex; flex-direction: column; gap: 6px; margin: 0 0 14px; border: 0; padding: 0; min-width: 0; }
  .ac-f label, .ac-f legend, .ac-lbl { font-weight: 700; } .ac-f small { color: var(--muted, #5B6472); }
  .ac-f input:not([type=radio]):not([type=checkbox]), .ac-f select, .ac-f textarea { width: 100%; min-height: 46px; padding: 9px 12px; border: 1.5px solid #D6DAE1; border-radius: 10px; font: inherit; font-size: 16px; background: #fff; color: #15181D; box-sizing: border-box; }
  .ac-two { display: grid; gap: 0 16px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .ac-r { display: inline-flex; gap: 6px; align-items: center; font-weight: 500 !important; margin-right: 18px; }
  .ac-crop { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; } .ac-crop canvas { width: 180px; height: 240px; border-radius: 10px; border: 2px solid #D6DAE1; touch-action: none; cursor: grab; background: #eee; }
  .ac-zoom { display: flex; flex-direction: column; gap: 4px; font-weight: 600; }
  .ac-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .ac-agree { display: flex; gap: 10px; align-items: flex-start; margin: 4px 0 16px; line-height: 1.5; } .ac-agree input { width: 20px; height: 20px; flex: none; margin-top: 3px; }
  .ac-info { padding: 12px 14px; border-left: 4px solid #EE343C; background: #FFF6F6; border-radius: 8px; }
  .ac-small { font-size: 13px; } .req { color: #C9242C; }
  .ac-code { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; } .ac-link { background: none; border: 0; padding: 0; color: #1C3F7A; text-decoration: underline; font: inherit; font-size: 14px; cursor: pointer; text-align: left; }
  .ac-code input { width: 130px !important; min-height: 40px !important; } .ac-code span { display: inline-flex; gap: 6px; }
</style>
<script>
  const $ = (id: string) => document.getElementById(id) as any;
  const q = new URLSearchParams(location.search);
  const msg = (t: string) => { const m = $('msg'); m.textContent = t; m.hidden = !t; if (t) m.scrollIntoView({ behavior: 'smooth', block: 'center' }); };
  let photoBlob: Blob | null = null, img: ImageBitmap | null = null, zoom = 1, ox = 0, oy = 0;
  let formTok = '';
  const update = q.get('update');
  (async () => {
    const d = await fetch(`/api/media/accreditation?${new URLSearchParams([...(q.get('match') ? [['match', q.get('match')!]] : []), ...(update ? [['update', update]] : [])])}`).then(r => r.json()).catch(() => null);
    if (!d) { msg('The form could not load. Please refresh the page.'); return; }
    $('closeH').textContent = d.closeHours;
    hub(d);
    $('role').innerHTML += d.roles.map((r: string) => `<option>${r}</option>`).join('');
    const open = d.matches.filter((m: any) => m.open);
    $('eventId').innerHTML = open.length ? `<option value="">Choose one home match…</option>${open.map((m: any) => `<option value="${m.id}">${m.label} · ${m.day}, ${m.kickOff}</option>`).join('')}` : '<option value="">No home match is open for applications right now</option>';
    const closed = d.matches.filter((m: any) => !m.open);
    if (closed.length) $('evHint').textContent = `Closed (less than ${d.closeHours} hours to kick-off): ${closed.map((m: any) => m.label).join(', ')}.`;
    if (d.selected) $('eventId').value = d.selected;
    formTok = d.formToken || '';
    if (d.invited?.email && !update) { $('email').value = d.invited.email; fillFrom(d.invited); }
    if (update) {
      if (!d.update) { msg('This link has already been used or is no longer valid.'); $('f').hidden = true; return; }
      const u = d.update;
      $('infoReq').hidden = false; $('infoReq').textContent = `Our media team asked: “${u.infoRequest}”. Update your request below and send it again.`;
      for (const k of ['fullName', 'phone', 'email', 'organisation', 'equipment', 'needs']) $(k).value = u[k] || '';
      $('role').value = u.role; (document.querySelector(`input[name=employment][value="${u.employment}"]`) as HTMLInputElement | null)?.click();
      $('email').readOnly = true; $('eventId').disabled = true; $('photoOnFile').hidden = false; $('send').textContent = 'Send my updated request';
    }
  })();
  // ── The hub: the next (or chosen) home match with both crests, and when applications close ──
  const LOGOS: Record<string, string> = JSON.parse(($('hub') as HTMLElement).dataset.logos || '{}');
  const crest = (name: string) => LOGOS[name] ? `<img src="${LOGOS[name]}" alt="${name.replace(/"/g, '')} crest" width="84" height="84" />` : `<span class="ph">${(name || '?').charAt(0).toUpperCase()}</span>`;
  let hubMatches: any[] = [], hubClose = 6, tick = 0;
  function showMatch(m: any, label = 'Next home match') {
    if (!m) { $('nmAway').textContent = 'No home match scheduled'; $('nmHome').textContent = 'Lobi Stars FC'; $('nmHomeCrest').innerHTML = crest('Lobi Stars FC'); $('nmWhen').textContent = ''; $('nmStatus').className = 'ah-status'; $('nmStatus').innerHTML = '<b>Check back soon</b>New home matches appear here when they are added.'; return; }
    const [home, away] = String(m.label).split(' v ');
    $('nmHome').textContent = home; $('nmAway').textContent = away || '';
    $('nmHomeCrest').innerHTML = crest(home); $('nmAwayCrest').innerHTML = crest(away || '');
    $('nmWhen').textContent = `${m.day} · Kick-off ${m.kickOff}`;
    $('nmLabel').textContent = label;
    clearInterval(tick);
    const draw = () => {
      const left = Date.parse(m.closesAt) - Date.now();
      const st = $('nmStatus');
      if (!m.open) { st.className = 'ah-status closed'; st.innerHTML = `<b>Applications closed</b>They closed ${hubClose} hours before kick-off.`; clearInterval(tick); return; }
      st.className = 'ah-status open';
      if (left <= 0 || m.reopened) { st.innerHTML = '<b>Applications open</b>Opened again by the club\'s media team: apply now.'; return; }
      const dd = Math.floor(left / 864e5), hh = Math.floor(left / 36e5) % 24, mm = Math.floor(left / 6e4) % 60, ss = Math.floor(left / 1e3) % 60;
      st.innerHTML = `<b>Applications open · closing in</b><div class="ah-count"><span>${dd}<small>days</small></span><span>${String(hh).padStart(2, '0')}<small>hrs</small></span><span>${String(mm).padStart(2, '0')}<small>min</small></span><span>${String(ss).padStart(2, '0')}<small>sec</small></span></div>`;
    };
    draw(); tick = window.setInterval(draw, 1000);
  }
  function hub(d: any) {
    hubMatches = d.matches || []; hubClose = d.closeHours;
    const first = hubMatches.find((m: any) => m.id === d.selected) || hubMatches.find((m: any) => m.open) || hubMatches[0];
    showMatch(first, first && first.id === d.selected ? 'Your chosen match' : 'Next home match');
    const others = hubMatches.filter((m: any) => m !== first);
    if (others.length) {
      $('moreMatches').hidden = false;
      $('moreList').innerHTML = others.map((m: any) => { const away = String(m.label).split(' v ')[1] || ''; return `<button type="button" class="ah-chip" data-m="${m.id}">${LOGOS[away] ? `<img src="${LOGOS[away]}" alt="" />` : ''}${m.label.replace(/</g, '&lt;')} <small>${m.day}${m.open ? '' : ' · closed'}</small></button>`; }).join('');
    }
  }
  $('moreList').addEventListener('click', (e: Event) => {
    const b = (e.target as HTMLElement).closest('[data-m]') as HTMLElement | null; if (!b) return;
    const m = hubMatches.find((x: any) => x.id === b.dataset.m); showMatch(m, 'Chosen match');
    if (m?.open) $('eventId').value = m.id;
    $('hub').scrollIntoView({ behavior: 'smooth' });
  });
  $('eventId').addEventListener('change', () => { const m = hubMatches.find((x: any) => x.id === $('eventId').value); if (m) showMatch(m, 'Your chosen match'); });

  // Returning journalists: details prefilled from the email address.
  // Returning journalists: a code emailed to the address unlocks the saved details (never shown to anyone else).
  function fillFrom(d: any) {
    if (!d?.known) return;
    $('known').textContent = 'Welcome back: we filled in your details from your last request. Please check them.';
    if (!$('fullName').value) $('fullName').value = d.fullName || '';
    if (!$('organisation').value) $('organisation').value = d.organisation || '';
    if (d.role && !$('role').value) $('role').value = d.role;
    if (d.employment) (document.querySelector(`input[name=employment][value="${d.employment}"]`) as HTMLInputElement | null)?.click();
    $('photoOnFile').hidden = !d.hasPhoto;
    $('codeBox').hidden = true;
  }
  const post = (body: any) => fetch('/api/media/accreditation/prefill', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }).then(async r => ({ ok: r.ok, d: await r.json().catch(() => ({})) }));
  $('askCode').addEventListener('click', async () => {
    const e = $('email').value.trim(); if (!/^\S+@\S+\.\S+$/.test(e)) { msg('Enter your email address first.'); $('email').focus(); return; }
    const r = await post({ email: e });
    msg(''); $('known').textContent = r.ok ? r.d.message : (r.d.error || 'Could not send a code.');
    if (r.ok) { $('codeRow').hidden = false; $('code').focus(); }
  });
  $('useCode').addEventListener('click', async () => {
    const r = await post({ email: $('email').value.trim(), code: $('code').value.trim() });
    if (!r.ok || !r.d.known) { $('known').textContent = r.d.error || 'We could not find saved details for this email.'; return; }
    fillFrom(r.d);
  });
  // Passport photo: crop to 3:4 with drag and zoom, then a JPEG.
  const cv = $('cv') as HTMLCanvasElement, g = cv.getContext('2d')!;
  function draw() {
    if (!img) return;
    const base = Math.max(cv.width / img.width, cv.height / img.height) * zoom;
    const w = img.width * base, h = img.height * base;
    ox = Math.min(0, Math.max(cv.width - w, ox)); oy = Math.min(0, Math.max(cv.height - h, oy));
    g.fillStyle = '#fff'; g.fillRect(0, 0, cv.width, cv.height); g.drawImage(img, ox, oy, w, h);
  }
  $('photoIn').addEventListener('change', async () => {
    const f = $('photoIn').files?.[0]; if (!f) return;
    if (f.size > 5 * 1024 * 1024) { msg('The photo is larger than 5 MB. Please choose a smaller one.'); $('photoIn').value = ''; return; }
    if (!/^image\/(jpeg|png|webp)$/.test(f.type)) { msg('Choose a JPG, PNG or WebP photo.'); return; }
    img = await createImageBitmap(f).catch(() => null); if (!img) { msg('This photo could not be opened.'); return; }
    zoom = 1; ox = 0; oy = 0; $('zoom').value = '1'; $('crop').hidden = false; msg(''); draw();
    const base = Math.max(cv.width / img.width, cv.height / img.height); ox = (cv.width - img.width * base) / 2; oy = (cv.height - img.height * base) / 2; draw();
  });
  $('zoom').addEventListener('input', () => { zoom = Number($('zoom').value); draw(); });
  let drag: { x: number; y: number } | null = null;
  cv.addEventListener('pointerdown', e => { drag = { x: e.clientX, y: e.clientY }; cv.setPointerCapture(e.pointerId); });
  cv.addEventListener('pointermove', e => { if (!drag) return; const k = cv.width / cv.clientWidth; ox += (e.clientX - drag.x) * k; oy += (e.clientY - drag.y) * k; drag = { x: e.clientX, y: e.clientY }; draw(); });
  cv.addEventListener('pointerup', () => { drag = null; });
  async function photoJpeg(): Promise<Blob | null> {
    if (!img) return null;
    const out = document.createElement('canvas'); out.width = 600; out.height = 800;
    const k = 2, base = Math.max(cv.width / img.width, cv.height / img.height) * zoom;
    const og = out.getContext('2d')!; og.fillStyle = '#fff'; og.fillRect(0, 0, 600, 800); og.drawImage(img, ox * k, oy * k, img.width * base * k, img.height * base * k);
    return new Promise(res => out.toBlob(res, 'image/jpeg', 0.88));
  }
  $('f').addEventListener('submit', async (e: Event) => {
    e.preventDefault(); msg('');
    const f = $('f') as HTMLFormElement;
    if (!update && !$('eventId').value) return msg('Choose the match.');
    if (!$('agree').checked) return msg('Please agree to the club\'s media rules.');
    const doc = $('pressDoc').files?.[0];
    if (doc && doc.size > 5 * 1024 * 1024) return msg('The press ID / letter is larger than 5 MB.');
    if (!update && !doc) return msg('Add your press ID or a letter from your organisation.');
    const fd = new FormData(f);
    if ($('eventId').disabled) fd.set('eventId', $('eventId').value);
    fd.delete('photoIn');
    photoBlob = await photoJpeg();
    if (photoBlob) fd.set('photo', new File([photoBlob], 'passport.jpg', { type: 'image/jpeg' }));
    else if (!update && $('photoOnFile').hidden) return msg('Add a passport photo.');
    if (update) fd.set('update', update);
    if (q.get('invite')) fd.set('invite', q.get('invite')!);
    fd.set('agree', '1');
    fd.set('formToken', formTok);
    $('send').disabled = true; $('send').textContent = 'Sending…';
    try {
      const r = await fetch('/api/media/accreditation', { method: 'POST', body: fd });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { msg(d.error || 'Could not send. Please try again.'); return; }
      f.hidden = true; $('done').hidden = false;
      if (d.updated) $('doneText').textContent = 'Thank you: your updated request is with our media team. We will email you.';
      $('done').scrollIntoView({ behavior: 'smooth' });
    } catch { msg('No connection. Please try again.'); }
    finally { $('send').disabled = false; $('send').textContent = update ? 'Send my updated request' : 'Send my request'; }
  });
</script>
