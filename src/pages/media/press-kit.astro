---
// /media/press-kit -- the club's press kit for journalists: badge, colours,
// how to write the club name, squad photo, player headshots, fact sheet, media
// contact and media rules. Entries come from the Media Centre once a Super
// Admin approves them (loaded from /api/media/press-kit).
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Press kit | Lobi Stars Football Club" description="Lobi Stars FC press kit: club badge, colours, how to write the club name, squad photo, player headshots, fact sheet, media contact and media rules.">
  <div class="page-hero wrap">
    <div class="stag">Press &amp; Media</div>
    <h1 class="stitle">Press <span class="r">kit</span></h1>
    <div class="divr"></div>
    <p class="muted pk-lede">Official Lobi Stars FC material for journalists and broadcasters. Please use the club name and badge as shown here.</p>
  </div>
  <div class="page-content wrap pk">
    <div id="kit"><p class="muted">Loading…</p></div>
    <p class="pk-back"><a href="/media/">← Media &amp; Press</a></p>
  </div>
</Layout>
<style>
  .pk-lede { max-width: 720px; }
  .pk :global(.pk-sec) { margin: 0 0 26px; } .pk :global(.pk-sec h2) { margin: 0 0 10px; font-size: 24px; }
  .pk :global(.pk-item) { background: #fff; border: 1px solid #E2E4E9; border-radius: 14px; padding: 16px; margin: 0 0 12px; }
  .pk :global(.pk-item h3) { margin: 0 0 6px; font-size: 18px; } .pk :global(.pk-item p) { margin: 0 0 10px; white-space: pre-line; }
  .pk :global(.pk-files) { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); list-style: none; margin: 0; padding: 0; }
  .pk :global(.pk-files a) { display: grid; gap: 6px; text-decoration: none; color: inherit; font-size: 14px; font-weight: 600; }
  .pk :global(.pk-files img) { width: 100%; aspect-ratio: 1; object-fit: contain; background: #F4F5F7; border-radius: 10px; }
  .pk :global(.pk-doc) { display: grid; place-items: center; aspect-ratio: 1; background: #F4F5F7; border-radius: 10px; font-size: 36px; }
  .pk-back { margin-top: 24px; }
</style>
<script>
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  fetch('/api/media/press-kit').then(r => r.json()).then(d => {
    const box = document.getElementById('kit')!;
    box.innerHTML = d.sections.length ? d.sections.map((s: any) => `<section class="pk-sec"><h2>${esc(s.title)}</h2>${s.items.map((i: any) => `<article class="pk-item"><h3>${esc(i.title)}</h3>${i.text ? `<p>${esc(i.text)}</p>` : ''}${i.files.length ? `<ul class="pk-files">${i.files.map((f: any) => `<li><a href="${esc(f.url)}${f.kind === 'document' ? '?download=1' : ''}" download>${f.kind === 'image' ? `<img src="${esc(f.url)}" alt="${esc(f.label || i.title)}" loading="lazy" />` : '<span class="pk-doc" aria-hidden="true">📄</span>'}<span>${esc(f.label || 'Download')}</span></a></li>`).join('')}</ul>` : ''}</article>`).join('')}</section>`).join('')
      : '<p class="muted">The press kit is being prepared. For material now, email <a href="mailto:media@lobistarsfc.com">media@lobistarsfc.com</a>.</p>';
  }).catch(() => { document.getElementById('kit')!.innerHTML = '<p class="muted">The press kit could not load. Please refresh the page.</p>'; });
</script>
