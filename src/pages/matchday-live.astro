---
// Matchday Live page. Served for every /matches/<slug>/live URL (home games
// only) by functions/matches/[slug]/live.js; the match is loaded from
// /api/matches/<slug>. Countdowns use the SERVER time returned by the API,
// not the visitor's clock.
import Layout from '../layouts/Layout.astro';
import settings from '../data/matchday.json';
import LivePlayer from '../components/commentary/LivePlayer.astro';
---
<Layout title="Matchday Live | Lobi Stars Football Club" description="Matchday Live: watch Lobi Stars home games, listen to live commentary, vote for Man of the Match and play Predict & Win." noindex whiteLabel>
  <div id="mlLivePlayer" hidden><LivePlayer variant="full" /></div>
  <div id="ml" class="ml" data-settings={JSON.stringify(settings)}>
    <div class="wrap ml-loading" id="mlStatus" aria-live="polite">Loading Matchday Live&hellip;</div>
  </div>
</Layout>

<style>
  .ml-loading { padding: 80px 5%; text-align: center; color: var(--lt); }
  .ml :global(.ml-head) { background: radial-gradient(120% 140% at 50% 0%, #7A0F12 0%, #2A0507 55%, #15181D 100%); color: #fff; padding: 26px 0 0; }
  .ml :global(.ml-inner) { max-width: 1000px; margin: 0 auto; padding: 0 5%; }
  .ml :global(.ml-top) { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .ml :global(.ml-brand) { font: 400 22px/1 'Bebas Neue', sans-serif; letter-spacing: 2px; color: #FFC72C; }
  .ml :global(.ml-crumb) { color: rgba(255, 255, 255, .85); font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.2px; text-transform: uppercase; text-decoration: none; }
  .ml :global(.ml-crumb:hover) { color: #fff; text-decoration: underline; }
  .ml :global(.ml-comp) { margin-top: 18px; text-align: center; color: rgba(255, 255, 255, .8); font: 700 13px/1.4 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; }
  .ml :global(.ml-board) { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 14px; margin: 18px 0 12px; }
  .ml :global(.ml-team) { display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; font: 400 clamp(19px, 3vw, 30px)/1.05 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .ml :global(.ml-crest) { width: clamp(64px, 11vw, 100px); height: clamp(64px, 11vw, 100px); border-radius: 50%; object-fit: contain; background: #fff; padding: 4px; }
  .ml :global(.ml-crest--initials) { display: inline-flex; align-items: center; justify-content: center; color: #15181D; font-size: 28px; }
  .ml :global(.ml-mid) { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .ml :global(.ml-score) { font: 400 clamp(46px, 9vw, 76px)/1 'Bebas Neue', sans-serif; letter-spacing: 3px; white-space: nowrap; }
  .ml :global(.ml-ko) { font: 400 clamp(30px, 6vw, 48px)/1 'Bebas Neue', sans-serif; color: #FFC72C; }
  .ml :global(.ml-badge) { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 20px; background: rgba(255, 255, 255, .16); font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; }
  .ml :global(.ml-badge.live) { background: var(--red); }
  .ml :global(.ml-badge.live::before) { content: ''; width: 8px; height: 8px; border-radius: 50%; background: #fff; animation: mlpulse 1.2s infinite; }
  .ml :global(.ml-badge.ft) { background: #fff; color: #15181D; }
  @keyframes mlpulse { 50% { opacity: .2; } }
  .ml :global(.ml-info) { text-align: center; color: rgba(255, 255, 255, .88); font-size: 15px; line-height: 1.6; margin: 0; }
  .ml :global(.ml-count) { display: flex; justify-content: center; gap: 8px; margin: 16px 0 0; }
  .ml :global(.ml-count div) { min-width: 62px; padding: 10px 6px; border-radius: 8px; background: rgba(255, 255, 255, .1); text-align: center; }
  .ml :global(.ml-count b) { display: block; font: 400 28px/1 'Bebas Neue', sans-serif; }
  .ml :global(.ml-count span) { font: 700 10px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255, 255, 255, .7); }
  .ml :global(.ml-tabs) { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; margin-top: 24px; }
  .ml :global(.ml-tab) {
    display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 12px 6px 14px; border: 0; cursor: pointer;
    background: rgba(255, 255, 255, .08); color: rgba(255, 255, 255, .85); border-radius: 10px 10px 0 0;
    font: 700 14px/1.1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase;
  }
  .ml :global(.ml-tab span) { font-size: 20px; }
  .ml :global(.ml-tab[aria-selected='true']) { background: #fff; color: var(--red-text); }
  .ml :global(.ml-tab:focus-visible) { outline: 3px solid #FFC72C; outline-offset: -3px; }
  .ml :global(.ml-panel) { padding: 30px 0 40px; min-height: 260px; }
  .ml :global(.ml-card) { border: 1px solid var(--d4); border-radius: 14px; padding: 26px; background: #fff; text-align: center; max-width: 720px; margin: 0 auto; }
  .ml :global(.ml-card h2) { margin: 0 0 8px; font: 400 30px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .ml :global(.ml-card p) { margin: 0 0 16px; color: var(--lt); line-height: 1.6; }
  .ml :global(.ml-actions) { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .ml :global(.ml-note) { margin-top: 14px; font-size: 13px; color: var(--lt); }
  .ml :global(.ml-note a) { color: var(--red-text); font-weight: 600; }
  .ml :global(.ml-share) { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px; margin: 16px 0 4px; }
  .ml :global(.ml-share-k) { font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; color: var(--lt); }
  .ml :global(.ml-share-btn) { padding: 8px 14px; border-radius: 999px; color: #fff; text-decoration: none; font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; }
  .ml :global(.ml-share-btn.wa) { background: #157A42; } .ml :global(.ml-share-btn.x) { background: #15181D; } .ml :global(.ml-share-btn.fb) { background: #1565D8; }
  .ml :global(.ml-share-btn:hover), .ml :global(.ml-share-btn:focus-visible) { filter: brightness(1.12); outline: 3px solid #FFC72C; outline-offset: 2px; }
  .ml :global(.ml-rules) { margin: 18px 0 0; font-size: 14px; }
  .ml :global(.ml-rules a) { color: var(--red-text); font-weight: 600; }
  .ml :global(.pw-cd) { margin: 0 0 16px; font: 400 clamp(24px, 4vw, 32px)/1 'Bebas Neue', sans-serif; letter-spacing: 1px; color: var(--red-text); font-variant-numeric: tabular-nums; }
  .ml :global(.pw-mine) { margin: 0 0 12px; padding: 16px; border-radius: 12px; background: #E8F7EE; color: #17643A; font-weight: 700; line-height: 1.5; }
  .ml :global(.pw-form) { margin: 8px 0 14px; }
  .ml :global(.pw-row) { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 12px; max-width: 520px; margin: 0 auto 16px; }
  .ml :global(.pw-side) { display: flex; flex-direction: column; align-items: center; gap: 8px; min-width: 0; }
  .ml :global(.pw-crest) { width: 64px; height: 64px; border-radius: 50%; object-fit: contain; background: #fff; border: 1px solid var(--d4); }
  .ml :global(.pw-crest--initials) { display: inline-flex; align-items: center; justify-content: center; font: 400 22px/1 'Bebas Neue', sans-serif; color: var(--white); background: var(--d3); }
  .ml :global(.pw-team) { font: 700 15px/1.2 'Barlow Condensed', sans-serif; text-transform: uppercase; text-align: center; overflow-wrap: anywhere; }
  .ml :global(.pw-inp) { width: 88px; padding: 10px 6px; text-align: center; font: 400 44px/1 'Bebas Neue', sans-serif; border: 2px solid var(--d4); border-radius: 12px; color: var(--white); background: #fff; }
  .ml :global(.pw-inp:focus) { outline: none; border-color: var(--red); box-shadow: 0 0 0 3px rgba(227, 30, 36, .2); }
  .ml :global(.pw-dash) { font: 400 44px/1 'Bebas Neue', sans-serif; padding-bottom: 14px; }
  .ml :global(.pw-submit) { min-width: 220px; }
  .ml :global(.mv-err) { color: #A3161B; margin: 8px 0; }
  .ml :global(.pw-result) { display: flex; flex-direction: column; gap: 6px; align-items: center; padding: 22px; border-radius: 14px; color: #fff; margin-bottom: 14px; background: radial-gradient(130% 160% at 0% 0%, #7A0F12 0%, #2A0507 60%, #15181D 100%); }
  .ml :global(.pw-k) { font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; color: #FFC72C; }
  .ml :global(.pw-score) { font: 400 clamp(28px, 5vw, 40px)/1.05 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .ml :global(.pw-result p) { margin: 0; color: #fff; }
  .ml :global(.pw-winner) { font-weight: 700; font-size: 17px; }
  .ml :global(.pw-stats) { opacity: .8; font-size: 14px; }
  .ml :global(.pw-own) { font-weight: 600; }
  .ml :global(.ml-card--wide) { max-width: 1000px; }
  .ml :global(.mv-msg) { margin: 0 0 14px; color: var(--lt); line-height: 1.6; }
  .ml :global(.mv-msg a), .ml :global(.mv-mine) { color: var(--red-text); font-weight: 600; }
  .ml :global(.mv-count) { margin: 0 0 18px; font: 700 14px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.2px; text-transform: uppercase; color: var(--gold-text); }
  .ml :global(.mv-grid) { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .ml :global(.mv-card) { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 16px 10px 14px; border: 1px solid var(--d4); border-radius: 12px; background: #fff; min-width: 0; }
  .ml :global(.mv-face) { width: 84px; height: 84px; border-radius: 50%; object-fit: cover; background: var(--d3); margin-bottom: 6px; }
  .ml :global(.mv-face--n), .ml :global(.mv-win-face--n) { display: inline-flex; align-items: center; justify-content: center; font: 400 34px/1 'Bebas Neue', sans-serif; color: var(--red-text); }
  .ml :global(.mv-num) { font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; color: var(--lt); }
  .ml :global(.mv-pname) { font: 700 16px/1.2 'Barlow Condensed', sans-serif; text-transform: uppercase; text-align: center; overflow-wrap: anywhere; }
  .ml :global(.mv-pos) { font-size: 12px; color: var(--lt); text-align: center; }
  .ml :global(.mv-vote) { margin-top: 8px; width: 100%; padding: 9px 10px; }
  .ml :global(.mv-confirm) { position: sticky; bottom: 12px; margin-top: 16px; padding: 16px; border-radius: 12px; background: #15181D; color: #fff; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: center; box-shadow: 0 10px 30px rgba(0,0,0,.3); }
  .ml :global(.mv-confirm[hidden]) { display: none; }
  .ml :global(.mv-confirm p) { margin: 0; width: 100%; text-align: center; color: #fff; }
  .ml :global(.mv-confirm .btn-o) { color: #fff; border-color: rgba(255,255,255,.6); }
  .ml :global(.mv-confirm .mv-err) { color: #FFB4B4; }
  .ml :global(.mv-thanks) { display: flex; flex-direction: column; gap: 6px; padding: 20px; border-radius: 12px; background: #E8F7EE; color: #17643A; margin-bottom: 14px; }
  .ml :global(.mv-thanks strong) { font: 400 26px/1.1 'Bebas Neue', sans-serif; letter-spacing: .5px; }
  .ml :global(.mv-winners) { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; margin-bottom: 16px; }
  .ml :global(.mv-win) { display: flex; align-items: center; gap: 18px; padding: 20px; border-radius: 14px; text-align: left; color: #fff; background: radial-gradient(130% 160% at 0% 0%, #7A0F12 0%, #2A0507 60%, #15181D 100%); }
  .ml :global(.mv-win-face) { width: 110px; height: 110px; border-radius: 50%; object-fit: cover; background: #fff; border: 4px solid #FFC72C; flex-shrink: 0; }
  .ml :global(.mv-win-t) { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .ml :global(.mv-win-t strong) { font: 400 clamp(28px, 4vw, 38px)/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .ml :global(.mv-win-k) { font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; color: #FFC72C; }
  .ml :global(.mv-win-v) { font-weight: 700; }
  .ml :global(.mv-board) { list-style: none; margin: 0; padding: 0; text-align: left; }
  .ml :global(.mv-board li) { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; padding: 10px 0; border-bottom: 1px solid var(--d4); }
  .ml :global(.mv-board li.win .mv-name) { color: var(--red-text); font-weight: 700; }
  .ml :global(.mv-name) { overflow-wrap: anywhere; }
  .ml :global(.mv-pct) { font-variant-numeric: tabular-nums; color: var(--lt); }
  .ml :global(.mv-bar) { grid-column: 1 / -1; height: 8px; border-radius: 4px; background: linear-gradient(90deg, var(--red) var(--w), var(--d3) var(--w)); }
  @media (max-width: 420px) { .ml :global(.mv-grid) { grid-template-columns: 1fr 1fr; gap: 8px; } .ml :global(.mv-win) { flex-direction: column; text-align: center; } .ml :global(.mv-win-t) { align-items: center; } }
  .ml :global(.ml-card--bare) { border: 0; padding: 0; background: none; }
  .ml :global(.ml-src) { display: inline-flex; gap: 4px; padding: 4px; border-radius: 999px; background: var(--d3); margin: 0 0 16px; }
  .ml :global(.ml-src-btn) { border: 0; border-radius: 999px; padding: 8px 18px; background: transparent; cursor: pointer; font: 700 14px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: var(--white); }
  .ml :global(.ml-src-btn[aria-pressed='true']) { background: var(--red); color: #fff; }
  .ml :global(.ml-src-btn:focus-visible) { outline: 3px solid #FFC72C; outline-offset: 2px; }
  .ml :global(.ml-player) { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; background: #000; }
  .ml :global(.ml-player iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .ml :global(.ml-poster) {
    position: absolute; inset: 0; width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
    border: 0; cursor: pointer; color: #fff; padding: 16px; text-align: center;
    background: radial-gradient(120% 140% at 50% 0%, #7A0F12 0%, #2A0507 60%, #15181D 100%);
  }
  .ml :global(.ml-play) { width: 74px; height: 74px; border-radius: 50%; background: var(--red); position: relative; box-shadow: 0 0 0 8px rgba(227, 30, 36, .25); transition: transform .15s; }
  .ml :global(.ml-play::after) { content: ''; position: absolute; left: 30px; top: 22px; border-style: solid; border-width: 15px 0 15px 24px; border-color: transparent transparent transparent #fff; }
  .ml :global(.ml-poster:hover .ml-play), .ml :global(.ml-poster:focus-visible .ml-play) { transform: scale(1.08); }
  .ml :global(.ml-poster:focus-visible) { outline: 3px solid #FFC72C; outline-offset: -3px; }
  .ml :global(.ml-poster-t) { font: 400 clamp(22px, 4vw, 32px)/1.05 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .ml :global(.ml-poster-cd) { font: 400 clamp(26px, 5vw, 40px)/1 'Bebas Neue', sans-serif; letter-spacing: 2px; color: #FFC72C; font-variant-numeric: tabular-nums; }
  .ml :global(.ml-poster-s) { font-size: 13px; color: rgba(255, 255, 255, .75); }
  @media (max-width: 420px) { .ml :global(.ml-play) { width: 56px; height: 56px; } .ml :global(.ml-play::after) { left: 22px; top: 16px; border-width: 12px 0 12px 19px; } .ml :global(.ml-card) { padding: 18px 14px; } }
  @media (max-width: 520px) {
    .ml :global(.ml-tab) { font-size: 12px; padding: 10px 2px 12px; }
    .ml :global(.ml-tab span) { font-size: 18px; }
  }
</style>

<script>
  import { crest, fmtDate, fmtTime, hasScore } from '../lib/matchUi';
  import { liveEngine } from '../lib/livePlayer';
  import { ssrData } from '../lib/ssr';

  type M = { id: string; slug: string; home_team: string; away_team: string; competition: string; event_date: string; venue: string;
    status: string; home_score: number | null; away_score: number | null; is_home: boolean; kickoff_at: string | null;
    stream?: { youtube: { url: string; embed: string } | null; facebook: { url: string; embed: string } | null } };

  const root = document.getElementById('ml')!;
  const settings = JSON.parse(root.dataset.settings || '{}');
  const slug = location.pathname.replace(/^\/matches\//, '').replace(/\/live\/?$/, '').replace(/\/$/, '') || new URLSearchParams(location.search).get('m') || '';
  const TABS = [
    { id: 'watch', label: 'Watch Live', icon: '📺' },
    { id: 'commentary', label: 'Commentary', icon: '🎙️' },
    { id: 'vote', label: 'Vote MOTM', icon: '⭐' },
    { id: 'predict', label: 'Predict & Win', icon: '🎯' },
  ];
  let match: M | null = null;
  let clockOffset = 0; // server time - device time, so countdowns follow the server clock
  let active = TABS.some(t => `#${t.id}` === location.hash) ? location.hash.slice(1) : '';
  let timers: number[] = [];
  let source: 'youtube' | 'facebook' | '' = '';
  const serverNow = () => Date.now() + clockOffset;

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text?: string) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  };
  const link = (href: string, text: string, cls: string, external = false) => {
    const a = el('a', cls, text) as HTMLAnchorElement;
    a.href = href;
    if (external) { a.target = '_blank'; a.rel = 'noopener'; }
    return a;
  };
  const isLive = (m: M) => m.status === 'live' || m.status === 'half-time';
  const isOver = (m: M) => m.status === 'full-time';

  function header(m: M) {
    const head = el('section', 'ml-head');
    const inner = el('div', 'ml-inner');
    const top = el('div', 'ml-top');
    top.append(el('span', 'ml-brand', 'Matchday Live'), link(`/matches/${m.slug}/`, 'Match Centre →', 'ml-crumb'));
    inner.append(top, el('div', 'ml-comp', m.competition));

    const board = el('div', 'ml-board');
    const team = (name: string) => { const t = el('div', 'ml-team'); t.append(crest(name, 100, 'ml-crest'), el('span', '', name)); return t; };
    const mid = el('div', 'ml-mid');
    if ((isLive(m) || isOver(m)) && hasScore(m)) mid.append(el('div', 'ml-score', `${m.home_score} – ${m.away_score}`));
    else if (isLive(m) || isOver(m)) mid.append(el('div', 'ml-ko', 'VS'));
    else mid.append(el('div', 'ml-ko', fmtTime(m.event_date).replace(' WAT', '')));
    const label = isLive(m) ? (m.status === 'half-time' ? 'Half-time' : 'Live') : isOver(m) ? 'Full time' : m.status === 'postponed' ? 'Postponed' : m.status === 'cancelled' ? 'Cancelled' : 'Upcoming';
    mid.append(el('span', `ml-badge${isLive(m) ? ' live' : isOver(m) ? ' ft' : ''}`, label));
    board.append(team(m.home_team), mid, team(m.away_team));

    const info = el('p', 'ml-info');
    info.append(`${fmtDate(m.event_date, true)} · Kick-off ${fmtTime(m.event_date)}`, el('br'), `📍 ${m.venue}`);
    inner.append(el('h1', 'sr-only', `Matchday Live: ${m.home_team} vs ${m.away_team}`), board, info);

    const start = new Date(m.event_date).getTime();
    if (m.status === 'scheduled' && start > serverNow()) {
      const count = el('div', 'ml-count');
      count.setAttribute('aria-label', 'Time to kick-off');
      const parts = ['Days', 'Hrs', 'Mins', 'Secs'].map(u => { const d = el('div'); const b = el('b', '', '–'); d.append(b, el('span', '', u)); count.append(d); return b; });
      const tick = () => {
        const left = Math.max(0, start - serverNow());
        const v = [Math.floor(left / 864e5), Math.floor(left / 36e5) % 24, Math.floor(left / 6e4) % 60, Math.floor(left / 1e3) % 60];
        parts.forEach((p, i) => { p.textContent = String(v[i]).padStart(2, '0'); });
      };
      tick(); timers.push(window.setInterval(tick, 1000));
      inner.append(count);
    }

    const tabs = el('div', 'ml-tabs');
    tabs.setAttribute('role', 'tablist'); tabs.setAttribute('aria-label', 'Matchday Live');
    TABS.forEach((t, i) => {
      const b = el('button', 'ml-tab') as HTMLButtonElement;
      b.type = 'button'; b.id = `mltab-${t.id}`; b.setAttribute('role', 'tab');
      b.setAttribute('aria-selected', String(t.id === active)); b.setAttribute('aria-controls', 'mlpanel');
      b.tabIndex = t.id === active ? 0 : -1;
      const icon = el('span', '', t.icon); icon.setAttribute('aria-hidden', 'true');
      b.append(icon, t.label);
      b.addEventListener('click', () => select(t.id));
      b.addEventListener('keydown', e => {
        const n = e.key === 'ArrowRight' ? (i + 1) % TABS.length : e.key === 'ArrowLeft' ? (i - 1 + TABS.length) % TABS.length : -1;
        if (n >= 0) { e.preventDefault(); select(TABS[n].id); document.getElementById(`mltab-${TABS[n].id}`)?.focus(); }
      });
      tabs.append(b);
    });
    inner.append(tabs);
    head.append(inner);
    return head;
  }

  // Tab content. Watch, Vote and Predict get their full features in the next phases.
  function panel(id: string, m: M) {
    const card = el('div', id === 'commentary' ? 'ml-card ml-card--bare' : 'ml-card');
    if (id === 'watch') card.append(...watchPanel(m));
    if (id === 'commentary') {
      // The same Lobi Stars FC Live player as /commentary (moved, not copied, so it keeps playing).
      const player = document.querySelector<HTMLElement>('#mlLivePlayer [data-live-player], .ml-panel [data-live-player]');
      if (player) {
        player.dataset.forSlug = m.slug;
        card.append(player);
        liveEngine().refresh();
      }
      const more = el('p', 'ml-note'); more.append(link('/commentary/', 'Open the full Lobi Stars FC Live page', ''));
      card.append(more);
    }
    if (id === 'vote') { card.classList.add('ml-card--wide'); card.append(el('h2', '', 'Vote for Man of the Match')); const box = el('div', 'mv'); card.append(box); loadVote(box, m); }
    if (id === 'predict') { const box = el('div', 'pw'); card.append(box); loadPredict(box, m); }
    return card;
  }

  // Share buttons (WhatsApp, X, Facebook) for vote and prediction results.
  function shareRow(text: string, m: M) {
    const url = `${location.origin}/matches/${m.slug}/live/`;
    const row = el('div', 'ml-share');
    row.append(el('span', 'ml-share-k', 'Share'));
    const add = (label: string, href: string, cls: string) => { const a = link(href, label, `ml-share-btn ${cls}`, true); a.setAttribute('aria-label', `Share on ${label} (opens in a new tab)`); row.append(a); };
    add('WhatsApp', `https://wa.me/?text=${encodeURIComponent(`${text} ${url}`)}`, 'wa');
    add('X', `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(url)}`, 'x');
    add('Facebook', `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`, 'fb');
    return row;
  }
  const rulesLink = (href: string, text: string) => { const p = el('p', 'ml-rules'); p.append(link(href, text, '')); return p; };

  // ── Man of the Match voting. Every rule is checked again on the server. ──
  type Player = { slug: string; name: string; number: number | null; position: string; photo: string | null; role?: string };
  type Row = Player & { votes: number; pct: number; winner: boolean };
  type Motm = { state: 'before' | 'open' | 'closed' | 'off'; players: Player[]; totalVoters: number;
    fan: { firstName: string; verified: boolean } | null; myVote: { slug: string; name: string; at: string } | null;
    results: { total: number; rows: Row[]; winners: string[] } | null };

  const POS: Record<string, string> = { GK: 'Goalkeeper', DEF: 'Defender', MID: 'Midfielder', FWD: 'Forward' };
  const voters = (n: number) => `${n.toLocaleString('en-NG')} fan${n === 1 ? ' has' : 's have'} voted`;
  function face(p: Player, cls = 'mv-face') {
    if (p.photo) {
      const img = el('img', cls) as HTMLImageElement;
      img.src = p.photo; img.alt = ''; img.loading = 'lazy'; img.width = 120; img.height = 120;
      img.onerror = () => img.replaceWith(face({ ...p, photo: null }, cls));
      return img;
    }
    const f = el('span', `${cls} ${cls}--n`, p.number != null ? String(p.number) : p.name.charAt(0));
    f.setAttribute('aria-hidden', 'true');
    return f;
  }
  function authButtons(m: M) {
    const next = encodeURIComponent(`/matches/${m.slug}/live/#vote`);
    const a = el('div', 'ml-actions');
    a.append(link(`/fans/register/?next=${next}`, 'Register to vote', 'btn-p'), link(`/fans/login/?next=${next}`, 'Log in', 'btn-o'));
    return a;
  }

  async function loadVote(box: HTMLElement, m: M) {
    box.replaceChildren(el('p', 'mv-msg', 'Loading the matchday squad…'));
    let d: Motm;
    try {
      const res = await fetch(`/api/matches/${encodeURIComponent(m.slug)}/motm`, { credentials: 'same-origin' });
      if (!res.ok) throw new Error();
      d = await res.json();
    } catch { box.replaceChildren(el('p', 'mv-msg', 'Voting could not be loaded. Please refresh the page.')); return; }
    renderVote(box, m, d);
    box.append(rulesLink('/motm/rules/', 'Man of the Match voting rules'));
    // While voting is open, keep the "fans have voted" number fresh.
    if (d.state === 'open') timers.push(window.setInterval(async () => {
      try { const r = await fetch(`/api/matches/${encodeURIComponent(m.slug)}/motm`).then(x => x.json()); const t = box.querySelector('[data-voters]'); if (t) t.textContent = voters(r.totalVoters); } catch {}
    }, 30_000));
  }

  function renderVote(box: HTMLElement, m: M, d: Motm) {
    const out: Node[] = [];
    const count = el('p', 'mv-count', voters(d.totalVoters)); count.dataset.voters = '';

    if (d.state === 'off') { box.replaceChildren(el('p', 'mv-msg', 'There is no Man of the Match vote for this match.')); return; }

    if (d.state === 'closed') {
      const r = d.results!;
      if (!r.total) { out.push(el('p', 'mv-msg', 'Voting has closed. No votes were cast for this match.')); box.replaceChildren(...out); return; }
      const winners = r.rows.filter(x => x.winner);
      const wins = el('div', 'mv-winners');
      winners.forEach(w => {
        const c = el('div', 'mv-win');
        c.append(face(w, 'mv-win-face'));
        const t = el('div', 'mv-win-t');
        t.append(el('span', 'mv-win-k', winners.length > 1 ? '⭐ Joint Man of the Match' : '⭐ Man of the Match'), el('strong', '', w.name),
          el('span', '', `${w.number != null ? `#${w.number} · ` : ''}${POS[w.position] || w.position || ''}`), el('span', 'mv-win-v', `${w.votes} vote${w.votes === 1 ? '' : 's'} · ${w.pct}%`));
        c.append(t); wins.append(c);
      });
      out.push(wins);
      out.push(el('p', 'mv-msg', `Voting closed · ${r.total.toLocaleString('en-NG')} fan${r.total === 1 ? '' : 's'} voted`));
      if (d.myVote) out.push(el('p', 'mv-mine', `You voted for ${d.myVote.name}.`));
      const list = el('ol', 'mv-board');
      list.setAttribute('aria-label', 'Final vote results');
      r.rows.forEach(x => {
        const li = el('li', x.winner ? 'win' : '');
        const bar = el('span', 'mv-bar'); bar.style.setProperty('--w', `${x.pct}%`); bar.setAttribute('aria-hidden', 'true');
        li.append(el('span', 'mv-name', `${x.number != null ? `#${x.number} ` : ''}${x.name}`), el('span', 'mv-pct', `${x.votes} · ${x.pct}%`), bar);
        list.append(li);
      });
      out.push(list);
      out.push(shareRow(`⭐ ${winners.map(w => w.name).join(' & ')} ${winners.length > 1 ? 'are joint Lobi Stars Men' : 'is the Lobi Stars Man'} of the Match vs ${m.away_team}, voted by the fans!`, m));
      box.replaceChildren(...out);
      return;
    }

    if (d.state === 'before') out.push(el('p', 'mv-msg', `Voting opens at kick-off (${fmtTime(m.event_date)}). Only fans with a free, email-confirmed account can vote, one vote per match.`));
    if (d.state === 'open') {
      if (d.myVote) {
        const t = el('div', 'mv-thanks');
        t.append(el('strong', '', `Thanks! You voted for ${d.myVote.name}.`), el('span', '', 'Results are revealed at full time.'));
        box.replaceChildren(t, count, shareRow(`I voted for ${d.myVote.name} as Lobi Stars Man of the Match vs ${m.away_team}. Have your say:`, m));
        return;
      }
      if (!d.fan) out.push(el('p', 'mv-msg', 'Voting is open! Register or log in to vote for your Man of the Match.'), authButtons(m));
      else if (!d.fan.verified) {
        const p = el('p', 'mv-msg', 'Please confirm your email address to vote. ');
        p.append(link(`/fans/login/?next=${encodeURIComponent(`/matches/${m.slug}/live/#vote`)}`, 'Resend the confirmation email', ''));
        out.push(p);
      } else out.push(el('p', 'mv-msg', `Voting is open, ${d.fan.firstName}! Pick one player. Your vote can't be changed.`));
      out.push(count);
    } else if (!d.fan) out.push(authButtons(m));

    if (!d.players.length) { out.push(el('p', 'mv-msg', 'The matchday squad will appear here before kick-off.')); box.replaceChildren(...out); return; }

    const canVote = d.state === 'open' && !!d.fan?.verified && !d.myVote;
    const grid = el('ul', 'mv-grid');
    const confirmBar = el('div', 'mv-confirm'); confirmBar.hidden = true; confirmBar.setAttribute('role', 'alertdialog'); confirmBar.setAttribute('aria-live', 'assertive');
    d.players.forEach(p => {
      const li = el('li', 'mv-card');
      li.append(face(p), el('span', 'mv-num', p.number != null ? `#${p.number}` : ''), el('span', 'mv-pname', p.name), el('span', 'mv-pos', `${POS[p.position] || p.position || ''}${p.role ? ` · ${p.role}` : ''}`));
      if (canVote) {
        const b = el('button', 'btn-p mv-vote', 'Vote') as HTMLButtonElement;
        b.type = 'button';
        b.setAttribute('aria-label', `Vote for ${p.name}`);
        b.addEventListener('click', () => askConfirm(p));
        li.append(b);
      }
      grid.append(li);
    });

    function askConfirm(p: Player) {
      const yes = el('button', 'btn-p', `Confirm vote for ${p.name}`) as HTMLButtonElement;
      const no = el('button', 'btn-o', 'Cancel') as HTMLButtonElement;
      yes.type = no.type = 'button';
      const err = el('p', 'mv-err'); err.hidden = true;
      confirmBar.replaceChildren(el('p', '', `You're voting for ${p.name}. This can't be changed.`), yes, no, err);
      confirmBar.hidden = false; yes.focus();
      no.addEventListener('click', () => { confirmBar.hidden = true; });
      yes.addEventListener('click', async () => {
        yes.disabled = true; yes.textContent = 'Sending…';
        try {
          const res = await fetch(`/api/matches/${encodeURIComponent(m.slug)}/motm`, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ player: p.slug }) });
          const r = await res.json().catch(() => ({}));
          if (!res.ok && r.code !== 'voted') throw new Error(r.error || 'Your vote could not be saved. Please try again.');
          loadVote(box, m);
        } catch (e) { err.textContent = (e as Error).message; err.hidden = false; yes.disabled = false; yes.textContent = `Confirm vote for ${p.name}`; }
      });
    }
    out.push(grid, confirmBar);
    box.replaceChildren(...out);
  }

  // ── Predict & Win. Opening/closing times come from the server clock. ──
  type Predict = { state: 'notyet' | 'open' | 'closed' | 'result' | 'off'; prize: number; maxGoals: number; opensAt: string; closesAt: string | null;
    count: number; fan: { firstName: string; verified: boolean } | null; mine: { home: number; away: number; at: string; disqualified: boolean } | null;
    result: { home: number; away: number; winner: string | null; noWinnerText: string | null; correct: number; total: number; prize: number; youWon: boolean; claim: string | null } | null;
    serverTime: string };
  const naira = (n: number) => `₦${n.toLocaleString('en-NG')}`;
  const predicted = (n: number) => `${n.toLocaleString('en-NG')} fan${n === 1 ? ' has' : 's have'} predicted`;
  const fmtAt = (iso: string) => `${fmtDate(iso)}, ${new Date(iso).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit', timeZone: 'Africa/Lagos' })} WAT`;

  function countdown(target: number, prefix: string, onDone: () => void) {
    const c = el('p', 'pw-cd');
    const tick = () => {
      const left = target - serverNow();
      if (left <= 0) { onDone(); return; }
      const d = Math.floor(left / 864e5), h = Math.floor(left / 36e5) % 24, mi = Math.floor(left / 6e4) % 60, se = Math.floor(left / 1e3) % 60;
      c.textContent = `${prefix} ${d ? `${d}d ` : ''}${String(h).padStart(2, '0')}h ${String(mi).padStart(2, '0')}m ${String(se).padStart(2, '0')}s`;
    };
    tick(); timers.push(window.setInterval(tick, 1000));
    return c;
  }

  async function loadPredict(box: HTMLElement, m: M) {
    box.replaceChildren(el('p', 'mv-msg', 'Loading Predict & Win…'));
    let d: Predict;
    try {
      const res = await fetch(`/api/matches/${encodeURIComponent(m.slug)}/predict`, { credentials: 'same-origin' });
      if (!res.ok) throw new Error();
      d = await res.json();
      clockOffset = new Date(d.serverTime).getTime() - Date.now();
    } catch { box.replaceChildren(el('p', 'mv-msg', 'Predict & Win could not be loaded. Please refresh the page.')); return; }
    renderPredict(box, m, d);
    box.append(rulesLink('/predict-and-win/terms/', 'Predict & Win terms & conditions'));
  }

  function renderPredict(box: HTMLElement, m: M, d: Predict) {
    const out: Node[] = [el('h2', '', `Predict & Win ${naira(d.prize)}`)];
    const reload = () => { timers.forEach(clearInterval); timers = []; if (match) render(match, true); };
    const next = encodeURIComponent(`/matches/${m.slug}/live/#predict`);
    const auth = () => { const a = el('div', 'ml-actions'); a.append(link(`/fans/register/?next=${next}`, 'Register to play', 'btn-p'), link(`/fans/login/?next=${next}`, 'Log in', 'btn-o')); return a; };
    const myLine = () => d.mine ? el('div', 'pw-mine', `Your prediction: ${m.home_team} ${d.mine.home} – ${d.mine.away} ${m.away_team}, submitted at ${fmtAt(d.mine.at)}`) : null;

    if (d.state === 'off') { out.push(el('p', 'mv-msg', 'There is no Predict & Win for this match.')); box.replaceChildren(...out); return; }

    if (d.state === 'result' && d.result) {
      const r = d.result;
      const panel = el('div', 'pw-result');
      panel.append(el('span', 'pw-k', 'Final score'), el('strong', 'pw-score', `${m.home_team} ${r.home} – ${r.away} ${m.away_team}`));
      panel.append(el('p', 'pw-winner', r.winner ? `🏆 Winner: ${r.winner} (${naira(r.prize)})` : (r.noWinnerText || 'No correct prediction this time.')));
      panel.append(el('p', 'pw-stats', `${r.correct} correct prediction${r.correct === 1 ? '' : 's'} · ${r.total} total`));
      out.push(panel);
      out.push(shareRow(r.winner ? `🏆 ${m.home_team} ${r.home} – ${r.away} ${m.away_team}: someone predicted it exactly and won ${naira(r.prize)} on Lobi Stars Predict & Win!` : `${m.home_team} ${r.home} – ${r.away} ${m.away_team}. Nobody predicted it exactly on Lobi Stars Predict & Win this time. Try next home game!`, m));
      if (r.youWon) {
        const won = el('div', 'mv-thanks');
        won.append(el('strong', '', `🎉 Congratulations, you won ${naira(r.prize)}!`), el('span', '', r.claim || ''));
        out.push(won);
      } else if (d.mine) {
        out.push(el('p', 'pw-own', d.mine.disqualified ? 'Your entry for this match was disqualified.'
          : d.mine.home === r.home && d.mine.away === r.away ? `You predicted ${d.mine.home} – ${d.mine.away}: correct, but another fan got there first. So close!`
          : `You predicted ${d.mine.home} – ${d.mine.away}. Better luck next time!`));
      }
      box.replaceChildren(...out); return;
    }

    if (d.state === 'closed') {
      out.push(el('p', 'mv-msg', 'Predictions for this match have closed. The winner is announced at full time.'));
      const mine = myLine(); if (mine) out.push(mine);
      out.push(el('p', 'mv-count', predicted(d.count)));
      box.replaceChildren(...out); return;
    }

    if (d.state === 'notyet') {
      out.push(el('p', 'mv-msg', `Predict the final score of ${m.home_team} vs ${m.away_team}. The earliest exact prediction wins ${naira(d.prize)}. Predictions open 24 hours before kick-off and close at kick-off.`));
      out.push(countdown(new Date(d.opensAt).getTime(), 'Predictions open in', reload));
      if (!d.fan) out.push(auth());
      box.replaceChildren(...out); return;
    }

    // Open
    const closes = d.closesAt ? countdown(new Date(d.closesAt).getTime(), 'Predictions close in', reload) : null;
    if (d.mine) {
      out.push(myLine()!, el('p', 'mv-msg', "Predictions can't be changed. Good luck!"), shareRow(`I predicted ${m.home_team} ${d.mine.home} – ${d.mine.away} ${m.away_team} on Lobi Stars Predict & Win ${naira(d.prize)}. Make yours:`, m));
      if (closes) out.push(closes);
      out.push(el('p', 'mv-count', predicted(d.count)));
      box.replaceChildren(...out); return;
    }
    out.push(el('p', 'mv-msg', `Predict the exact final score. The earliest correct prediction wins ${naira(d.prize)}. One prediction per fan, and it can't be changed.`));
    if (closes) out.push(closes);
    if (!d.fan) { out.push(auth(), el('p', 'mv-count', predicted(d.count))); box.replaceChildren(...out); return; }
    if (!d.fan.verified) {
      const p = el('p', 'mv-msg', 'Please confirm your email address to play. ');
      p.append(link(`/fans/login/?next=${next}`, 'Resend the confirmation email', ''));
      out.push(p); box.replaceChildren(...out); return;
    }

    const form = el('form', 'pw-form') as HTMLFormElement;
    form.noValidate = true;
    const side = (team: string, name: string) => {
      const w = el('label', 'pw-side');
      const inp = el('input', 'pw-inp') as HTMLInputElement;
      inp.type = 'number'; inp.name = name; inp.min = '0'; inp.max = String(d.maxGoals); inp.step = '1'; inp.inputMode = 'numeric'; inp.required = true; inp.value = '0';
      inp.setAttribute('aria-label', `${team} goals`);
      w.append(crest(team, 64, 'pw-crest'), el('span', 'pw-team', team), inp);
      return { w, inp };
    };
    const h = side(m.home_team, 'home'), a = side(m.away_team, 'away');
    const row = el('div', 'pw-row'); row.append(h.w, el('span', 'pw-dash', '–'), a.w);
    const err = el('p', 'mv-err'); err.hidden = true; err.setAttribute('role', 'alert');
    const submit = el('button', 'btn-p pw-submit', 'Submit Prediction') as HTMLButtonElement; submit.type = 'submit';
    const confirmBox = el('div', 'mv-confirm'); confirmBox.hidden = true;
    form.append(row, err, submit, confirmBox);
    const goals = (i: HTMLInputElement) => { const n = Number(i.value); return i.value.trim() !== '' && Number.isInteger(n) && n >= 0 && n <= d.maxGoals ? n : null; };
    form.addEventListener('submit', e => {
      e.preventDefault();
      const hg = goals(h.inp), ag = goals(a.inp);
      if (hg === null || ag === null) { err.textContent = `Enter a whole number from 0 to ${d.maxGoals} for both teams.`; err.hidden = false; return; }
      err.hidden = true;
      const yes = el('button', 'btn-p', 'Submit') as HTMLButtonElement, no = el('button', 'btn-o', 'Change') as HTMLButtonElement;
      yes.type = no.type = 'button';
      const cErr = el('p', 'mv-err'); cErr.hidden = true;
      confirmBox.replaceChildren(el('p', '', `You predicted ${m.home_team} ${hg} – ${ag} ${m.away_team}. Submit? This cannot be changed.`), yes, no, cErr);
      confirmBox.hidden = false; yes.focus();
      no.addEventListener('click', () => { confirmBox.hidden = true; h.inp.focus(); });
      yes.addEventListener('click', async () => {
        yes.disabled = true; yes.textContent = 'Submitting…';
        try {
          const res = await fetch(`/api/matches/${encodeURIComponent(m.slug)}/predict`, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ home: hg, away: ag }) });
          const r = await res.json().catch(() => ({}));
          if (!res.ok && r.code !== 'predicted') throw new Error(r.error || 'Your prediction could not be saved. Please try again.');
          reload();
        } catch (e2) { cErr.textContent = (e2 as Error).message; cErr.hidden = false; yes.disabled = false; yes.textContent = 'Submit'; }
      });
    });
    out.push(form, el('p', 'mv-count', predicted(d.count)));
    box.replaceChildren(...out);
  }

  // Watch Live: the video player loads only when the fan presses Play (saves mobile data).
  function watchPanel(m: M): Node[] {
    const st = m.stream || { youtube: null, facebook: null };
    const sources = (['youtube', 'facebook'] as const).filter(k => st[k]);
    const start = new Date(m.event_date).getTime();
    const before = !isLive(m) && !isOver(m);
    const title = el('h2', '', isOver(m) ? 'Full match replay' : 'Watch live');
    const out: Node[] = [title];

    if (!sources.length) {
      out.push(el('p', '', isLive(m) ? 'Follow the live stream on our official channels.'
        : isOver(m) ? 'Catch up on the action on our official channels.'
        : `The live stream starts at kick-off, ${fmtTime(m.event_date)}. Watch it on our official channels.`));
      const a = el('div', 'ml-actions');
      const tag = (x: HTMLAnchorElement) => { x.dataset.track = 'watch_play'; x.dataset.trackLabel = m.slug; return x; };
      if (settings.youtubeChannel) a.append(tag(link(settings.youtubeChannel, '▶ YouTube channel', 'btn-p', true)));
      if (settings.facebookPage) a.append(tag(link(settings.facebookPage, 'Facebook page', 'btn-o', true)));
      out.push(a);
      return out;
    }

    if (!source || !st[source]) source = sources[0];
    if (sources.length > 1) {
      const sw = el('div', 'ml-src');
      sw.setAttribute('role', 'group'); sw.setAttribute('aria-label', 'Choose where to watch');
      sources.forEach(k => {
        const b = el('button', 'ml-src-btn', k === 'youtube' ? 'YouTube' : 'Facebook') as HTMLButtonElement;
        b.type = 'button'; b.setAttribute('aria-pressed', String(k === source));
        b.addEventListener('click', () => { source = k; if (match) render(match, true); });
        sw.append(b);
      });
      out.push(sw);
    }

    const player = el('div', 'ml-player');
    const poster = el('button', 'ml-poster') as HTMLButtonElement;
    poster.type = 'button';
    const playIcon = el('span', 'ml-play'); playIcon.setAttribute('aria-hidden', 'true');
    const label = el('span', 'ml-poster-t', isOver(m) ? 'Play full match replay' : isLive(m) ? 'Play live stream' : `Live stream starts at ${fmtTime(m.event_date)}`);
    const sub = el('span', 'ml-poster-s', `${source === 'youtube' ? 'YouTube' : 'Facebook'} · the video loads only when you press play`);
    poster.append(playIcon, label);
    if (before && start > serverNow()) {
      const cd = el('span', 'ml-poster-cd');
      const tick = () => {
        const left = Math.max(0, start - serverNow());
        const d = Math.floor(left / 864e5), h = Math.floor(left / 36e5) % 24, mi = Math.floor(left / 6e4) % 60, se = Math.floor(left / 1e3) % 60;
        cd.textContent = `${d ? `${d}d ` : ''}${String(h).padStart(2, '0')}:${String(mi).padStart(2, '0')}:${String(se).padStart(2, '0')}`;
      };
      tick(); timers.push(window.setInterval(tick, 1000));
      poster.append(cd);
    }
    poster.append(sub);
    poster.setAttribute('aria-label', `${label.textContent} on ${source === 'youtube' ? 'YouTube' : 'Facebook'}`);
    poster.addEventListener('click', () => {
      const s = st[source as 'youtube' | 'facebook']!;
      const f = document.createElement('iframe');
      f.src = s.embed;
      f.title = `${m.home_team} vs ${m.away_team} – ${isOver(m) ? 'full match replay' : 'live stream'}`;
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
      player.replaceChildren(f);
      player.dataset.playing = '1';
      (window as any).lsTrack?.('watch_play', m.slug);
    });
    player.append(poster);
    out.push(player);

    const note = el('p', 'ml-note');
    note.append('Trouble playing? ', link(st[source]!.url, `Open on ${source === 'youtube' ? 'YouTube' : 'Facebook'}`, '', true));
    out.push(note);
    return out;
  }

  function select(id: string) {
    active = id;
    history.replaceState(null, '', `#${id}`);
    if (match) render(match);
  }

  function render(m: M, force = false) {
    const playing = document.querySelector('#mlpanel .ml-player[data-playing]');
    if (!force && playing && active === 'watch') {
      // Only refresh the scoreboard so the video keeps playing.
      const head = root.querySelector('.ml-head');
      if (head) { timers.forEach(clearInterval); timers = []; head.replaceWith(header(m)); return; }
    }
    timers.forEach(clearInterval); timers = [];
    if (!active) active = isLive(m) ? 'watch' : isOver(m) ? 'vote' : 'predict';
    const body = el('div', 'ml-inner');
    const p = el('div', 'ml-panel');
    p.id = 'mlpanel'; p.setAttribute('role', 'tabpanel'); p.setAttribute('aria-labelledby', `mltab-${active}`); p.tabIndex = 0;
    p.append(panel(active, m));
    body.append(p);
    root.replaceChildren(header(m), body);
    document.title = `${m.home_team} vs ${m.away_team} | Matchday Live | Lobi Stars FC`;
  }

  async function load() {
    try {
      // First draw uses the match embedded by the server; later refreshes fetch it.
      const embedded = !match ? ssrData<{ match: M; serverTime: string }>('ssr-match') : null;
      let data;
      if (embedded) data = embedded;
      else {
        const res = await fetch(`/api/matches/${encodeURIComponent(slug)}`);
        if (res.status === 404) throw new Error('notfound');
        if (!res.ok) throw new Error('error');
        data = await res.json();
      }
      if (data.serverTime) clockOffset = new Date(data.serverTime).getTime() - Date.now();
      if (!data.match.is_home) { location.replace(`/matches/${data.match.slug}/`); return; }
      const key = (x: M) => `${x.status}${x.home_score}${x.away_score}${JSON.stringify(x.stream || {})}`;
      const before = match ? key(match) : '';
      match = data.match;
      if (!before || before !== key(match!)) render(match!);
    } catch (err) {
      if (match) return;
      const box = el('div', 'wrap ml-loading');
      box.append((err as Error).message === 'notfound' ? 'Sorry, we could not find that match. ' : 'Matchday Live could not be loaded. ');
      box.append(link('/fixtures', 'See all fixtures', ''));
      root.replaceChildren(box);
    }
  }
  load();
  // Keep status and score up to date.
  window.setInterval(load, 30_000);
</script>
