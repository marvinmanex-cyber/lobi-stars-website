---
// /season-tickets -- buy a season ticket: one pass, every Lobi Stars home
// match of the season, in a chosen stand. Prices and availability come from
// /api/season-tickets (set in Admin › Commerce › Season Tickets); when season
// tickets are switched off the page says so and points to match tickets.
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Season Tickets | Lobi Stars Football Club" description="Lobi Stars FC season tickets: one ticket for every home match of the season at McCarthy Stadium, Makurdi. Show the same QR code every match day.">
  <div class="page-hero wrap">
    <div class="stag">Every home match</div>
    <h1 class="stitle">Season <span class="r">Tickets</span></h1>
    <div class="divr"></div>
  </div>
  <div class="page-content wrap st">
    <p class="muted" id="stLoading">Loading…</p>
    <div class="st-off" id="stOff" hidden>
      <p>Season tickets are not on sale at the moment.</p>
      <a class="btn-p" href="/tickets/">Buy match tickets</a>
    </div>
    <div id="stOn" hidden>
      <p class="st-lede" id="stLede"></p>
      <p class="st-info" id="stInfo" hidden></p>
      <form class="st-form" id="stForm" novalidate>
        <fieldset class="st-tiers" id="stTiers"><legend>Choose your stand</legend></fieldset>
        <div class="st-2">
          <label>How many<select name="quantity" id="stQty"></select></label>
          <p class="st-total" aria-live="polite">Total: <b id="stTotal">–</b></p>
        </div>
        <label>Full name<input name="buyerName" autocomplete="name" required maxlength="80" /></label>
        <div class="st-2">
          <label>Email (your season tickets are sent here)<input name="buyerEmail" type="email" autocomplete="email" required maxlength="254" /></label>
          <label>Phone<input name="buyerPhone" type="tel" autocomplete="tel" required placeholder="0803 123 4567" /></label>
        </div>
        <p class="st-err" id="stErr" role="alert"></p>
        <button class="btn-p st-pay" type="submit">Pay with Paystack</button>
        <p class="st-small">Each season ticket gets one person into every Lobi Stars home match of the season, once per match. Card payments are handled securely by Paystack. By buying you agree to our <a href="/terms/">Terms</a>.</p>
      </form>
    </div>
  </div>
</Layout>

<style>
  .st { max-width: 760px; }
  .st-off { text-align: center; padding: 30px 0; display: grid; gap: 16px; justify-items: center; }
  .st-lede { font-size: 18px; line-height: 1.55; margin: 0 0 12px; }
  .st-info { background: var(--d3); border-radius: 12px; padding: 12px 16px; margin: 0 0 16px; line-height: 1.55; }
  .st-form { display: grid; gap: 14px; }
  .st-form label { display: grid; gap: 6px; font-weight: 700; font-size: 14px; }
  .st-form input, .st-form select { min-height: 48px; border: 1.5px solid var(--d4); border-radius: 10px; padding: 10px 12px; font: 400 16px 'Barlow', sans-serif; background: var(--d2); color: var(--white); width: 100%; box-sizing: border-box; }
  .st-tiers { border: 0; padding: 0; margin: 0; display: grid; gap: 10px; }
  .st-tiers legend { font-weight: 700; font-size: 14px; margin-bottom: 8px; }
  .st :global(.st-tier) { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border: 2px solid var(--d4); border-radius: 12px; cursor: pointer; background: var(--d2); }
  .st :global(.st-tier:has(input:checked)) { border-color: var(--red, #E31E24); background: rgba(227,30,36,.05); }
  .st :global(.st-tier input) { width: 20px; height: 20px; accent-color: #E31E24; flex: none; }
  .st :global(.st-tier b) { font: 400 24px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; flex: 1; }
  .st :global(.st-tier span) { font-weight: 700; font-size: 18px; }
  .st :global(.st-tier small) { display: block; font-weight: 400; color: var(--lt); font-size: 13px; }
  .st :global(.st-tier.out) { opacity: .5; cursor: not-allowed; }
  .st-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: end; }
  .st-total { margin: 0; font-size: 18px; }
  .st-err { margin: 0; color: #A3161B; font-weight: 700; }
  .st-err:empty { display: none; }
  .st-pay { min-height: 54px; font-size: 16px; }
  .st-small { margin: 0; color: var(--lt); font-size: 13px; line-height: 1.55; }
  .st [hidden] { display: none !important; }
  @media (max-width: 600px) { .st-2 { grid-template-columns: 1fr; } }
</style>

<script is:inline>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var data = null;
  var naira = function (k) { return '₦' + (k / 100).toLocaleString('en-NG'); };
  function total() {
    var t = document.querySelector('input[name=tier]:checked');
    var q = Number($('stQty').value) || 1;
    var tier = t && data.tiers.find(function (x) { return x.tier === t.value; });
    $('stTotal').textContent = tier ? naira(tier.priceKobo * q) : '–';
  }
  fetch('/api/season-tickets').then(function (r) { return r.json(); }).then(function (d) {
    data = d; $('stLoading').hidden = true;
    if (!d.enabled || !d.tiers.length) { $('stOff').hidden = false; return; }
    $('stOn').hidden = false;
    $('stLede').textContent = 'One ticket for every Lobi Stars home match of the ' + d.season + ' season' + (d.homeMatchesLeft ? ' (' + d.homeMatchesLeft + ' home match' + (d.homeMatchesLeft === 1 ? '' : 'es') + ' still to play)' : '') + '. Show the same QR code at the gate every match day.';
    if (d.info) { $('stInfo').textContent = d.info; $('stInfo').hidden = false; }
    d.tiers.forEach(function (t, i) {
      var lab = document.createElement('label'); lab.className = 'st-tier' + (t.soldOut ? ' out' : '');
      var inp = document.createElement('input'); inp.type = 'radio'; inp.name = 'tier'; inp.value = t.tier; inp.disabled = t.soldOut;
      if (!t.soldOut && !document.querySelector('input[name=tier]:checked')) inp.checked = true;
      var b = document.createElement('b'); b.textContent = t.label;
      var sm = document.createElement('small'); sm.textContent = t.soldOut ? 'Sold out' : t.remaining !== null ? t.remaining + ' left' : 'Season ticket';
      b.appendChild(sm);
      var price = document.createElement('span'); price.textContent = naira(t.priceKobo);
      lab.append(inp, b, price); $('stTiers').appendChild(lab);
      inp.addEventListener('change', total);
    });
    for (var i = 1; i <= d.maxPerOrder; i++) $('stQty').add(new Option(String(i), String(i)));
    $('stQty').addEventListener('change', total);
    total();
  }).catch(function () { $('stLoading').textContent = 'Could not load season tickets. Please try again.'; });

  $('stForm').addEventListener('submit', async function (e) {
    e.preventDefault(); $('stErr').textContent = '';
    var t = document.querySelector('input[name=tier]:checked');
    if (!t) { $('stErr').textContent = 'Choose a stand.'; return; }
    var btn = this.querySelector('.st-pay'); btn.disabled = true;
    try {
      var r = await fetch('/api/season-tickets/checkout', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tier: t.value, quantity: Number($('stQty').value), buyerName: this.buyerName.value, buyerEmail: this.buyerEmail.value, buyerPhone: this.buyerPhone.value }) });
      var d = await r.json().catch(function () { return {}; });
      if (!r.ok) { $('stErr').textContent = d.error || 'Something went wrong. Please try again.'; return; }
      location.href = d.authorizationUrl;
    } catch (x) { $('stErr').textContent = 'No connection. Please try again.'; }
    finally { btn.disabled = false; }
  });
})();
</script>
