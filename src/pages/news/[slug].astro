---
import Layout from '../../layouts/Layout.astro';
import WhatsAppChannel from '../../components/WhatsAppChannel.astro';
import NewsCarousel from '../../components/news/NewsCarousel.astro';
import RelativeTime from '../../components/news/RelativeTime.astro';
import { render } from 'astro:content';
import { getSortedNews, categoryHref, categorySlug, formatDate, videoEmbedUrl, type Article } from '../../lib/news';
import { getPlayers } from '../../lib/players';
import ShopCard from '../../components/ShopCard.astro';
import shop from '../../data/shop.json';

export async function getStaticPaths() {
  const all = await getSortedNews();
  return all.map(article => {
    // Four other stories from the same category, topped up with the latest
    // news if the category doesn't have enough.
    // Related: stories sharing a tagged player first, then the same category,
    // topped up with the latest news.
    const others = all.filter(a => a.id !== article.id);
    const tags = new Set(article.data.players || []);
    const byPlayer = others.filter(a => (a.data.players || []).some(p => tags.has(p)));
    const same = others.filter(a => a.data.category === article.data.category && !byPlayer.includes(a));
    const related = [...byPlayer, ...same, ...others.filter(a => !byPlayer.includes(a) && !same.includes(a))].slice(0, 4);
    return { params: { slug: article.id }, props: { article, related } };
  });
}

interface Props { article: Article; related: Article[] }
const { article, related } = Astro.props;
const a = article.data;
const { Content } = await render(article);

// Tagged players that exist on the public site (unknown or sample ones are skipped).
const squad = await getPlayers();
const tagged = (a.players || []).map(slug => squad.find(p => p.id === slug)).filter(Boolean) as typeof squad;
const playerName = (slug?: string | null) => squad.find(p => p.id === slug)?.data.name;
const teamNews = (a.teamNews || []).map(r => ({ ...r, label: r.name || playerName(r.player) || '' })).filter(r => r.label);
// Long-read layout for Features and series such as Heritage.
const longRead = a.category === 'Features' || !!a.series;
const words = (article.body || '').split(/\s+/).filter(Boolean).length;
const readMins = Math.max(1, Math.round(words / 220));
const edited = a.updatedAt && a.updatedAt.getTime() - a.publishedAt.getTime() > 60_000 ? a.updatedAt : null;
const fmtUpdated = (d: Date) => d.toLocaleString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Lagos' }) + ' WAT';
const STATUS_CLASS = { Available: 'ok', Doubtful: 'warn', Injured: 'bad', Suspended: 'sus' } as const;

const pageUrl = new URL(`/news/${article.id}`, Astro.site).toString();
const enc = encodeURIComponent;
const share = {
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${enc(pageUrl)}`,
  x: `https://x.com/intent/post?url=${enc(pageUrl)}&text=${enc(a.title)}`,
  whatsapp: `https://wa.me/?text=${enc(`${a.title} ${pageUrl}`)}`,
};
const site = Astro.site!.toString().replace(/\/$/, '');
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: a.title,
  description: a.summary,
  image: [new URL(a.coverImage, Astro.site).toString()],
  datePublished: a.publishedAt.toISOString(),
  dateModified: (edited || a.publishedAt).toISOString(),
  articleSection: a.category,
  mainEntityOfPage: pageUrl,
  author: a.author ? { '@type': 'Person', name: a.author, ...(a.authorRole ? { jobTitle: a.authorRole } : {}) } : { '@type': 'Organization', name: 'Lobi Stars FC', url: `${site}/` },
  ...(a.membersOnly ? { isAccessibleForFree: false, hasPart: { '@type': 'WebPageElement', isAccessibleForFree: false, cssSelector: '.art-members' } } : {}),
  ...(tagged.length ? { about: tagged.map(p => ({ '@type': 'Person', name: p.data.name, url: `${site}/squad/${p.id}/` })) } : {}),
  publisher: {
    '@type': 'Organization',
    name: 'Lobi Stars Football Club',
    logo: { '@type': 'ImageObject', url: `${site}/images/icon-512.png` },
  },
};
const embed = a.isVideo ? videoEmbedUrl(a.videoUrl) : null;
// Members-only: the story text (and any video) is cut out of the public page
// at build time and only sent by the server to confirmed members.
const membersOnly = a.membersOnly;
// "Shop the story": tagged shop products that still exist.
const products = (a.products || []).map(id => shop.products.find(p => p.id === id)).filter(Boolean).slice(0, 4) as typeof shop.products;
const directVideo = a.isVideo && !embed && a.videoUrl && /\.(mp4|webm)(\?|$)/i.test(a.videoUrl) ? a.videoUrl : null;
---
<Layout title={`${a.title} | Lobi Stars FC News`} description={a.summary} image={a.coverImage} imageAlt={a.imageAlt} type="article" jsonLd={[articleJsonLd]}>
  <Fragment slot="head">
    <meta property="article:published_time" content={a.publishedAt.toISOString()} />
    <meta property="article:section" content={a.category} />
    {edited && <meta property="article:modified_time" content={edited.toISOString()} />}
    {a.author && <meta name="author" content={a.author} />}
  </Fragment>

  <article class:list={['art', { 'art--long': longRead }]}>
    <div class="art-media">
      {embed && !membersOnly ? (
        <div class="art-video">
          <iframe src={embed} title={a.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      ) : directVideo && !membersOnly ? (
        <video class="art-video-el" src={directVideo} poster={a.coverImage} controls preload="metadata"></video>
      ) : (
        <div class="art-cover">
          <img src={a.coverImage} alt={a.imageAlt} width="1600" height="900" />
          {a.isVideo && (
            <div class="art-video-note">
              <span class="art-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" /></svg></span>
              <span>Video{a.videoDuration ? ` · ${a.videoDuration}` : ''} &mdash; coming soon</span>
            </div>
          )}
        </div>
      )}
    </div>

    <div class="art-col">
      <div class="art-meta">
        <a class="art-cat" href={categoryHref(a.category)}>{a.category}</a>
        <span class="art-date">{formatDate(a.publishedAt)}</span>
        <span aria-hidden="true">&middot;</span>
        <RelativeTime date={a.publishedAt} class="art-rel" />
        {a.series && <span class="art-series">{a.series}</span>}
        {membersOnly && <span class="art-series art-mo">Members only</span>}
        {longRead && <><span aria-hidden="true">&middot;</span><span>{readMins} min read</span></>}
      </div>
      <h1 class="art-title">{a.title}</h1>
      <p class="art-lead">{a.summary}</p>

      <div class="art-byline">
        {a.author && a.authorPhoto && <img class="art-author-img" src={a.authorPhoto} alt="" width="44" height="44" loading="lazy" />}
        <div>
          <span class="art-author">By {a.author || 'Lobi Stars FC'}{a.author && a.authorRole && <span class="art-role">, {a.authorRole}</span>}</span>
          <span class="art-dates">Published {formatDate(a.publishedAt)}{edited && <> · <strong>Updated {fmtUpdated(edited)}</strong></>}</span>
        </div>
      </div>

      {tagged.length > 0 && (
        <ul class="art-players" aria-label="Players in this story">
          {tagged.map(p => (
            <li><a href={`/squad/${p.id}/`}>{p.data.photo && <img src={p.data.photo} alt="" width="26" height="26" loading="lazy" />}<span>#{p.data.number} {p.data.name}</span></a></li>
          ))}
        </ul>
      )}

      <div class="art-share" aria-label="Share this story">
        <span class="art-share-label">Share</span>
        <a href={share.facebook} target="_blank" rel="noopener" aria-label="Share on Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.5V6.8c0-.8.5-1 1-1h2.4V2.1L14.1 2C10.6 2 9.8 4.6 9.8 6.3v2.2H7.5v3.9h2.3V22H14v-9.6h3l.5-3.9H14z" /></svg>
        </a>
        <a href={share.x} target="_blank" rel="noopener" aria-label="Share on X">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.8 3h3.1l-6.8 7.7 8 10.3h-6.3l-4.9-6.4L5.3 21H2.2l7.3-8.3L1.9 3h6.4l4.4 5.9L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5z" /></svg>
        </a>
        <a href={share.whatsapp} target="_blank" rel="noopener" aria-label="Share on WhatsApp">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2s.2-1.1.2-1.2l-.5-.3z" /></svg>
        </a>
        <button type="button" class="art-copy" data-copy={pageUrl} aria-label="Copy link to this story">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.6 13.4a1 1 0 0 1 0-1.4l3.5-3.5a3 3 0 0 1 4.2 4.2l-2.1 2.1a1 1 0 1 1-1.4-1.4l2.1-2.1a1 1 0 0 0-1.4-1.4L12 13.4a1 1 0 0 1-1.4 0zm2.8-2.8a1 1 0 0 1 0 1.4l-3.5 3.5a3 3 0 0 1-4.2-4.2l2.1-2.1a1 1 0 1 1 1.4 1.4l-2.1 2.1a1 1 0 0 0 1.4 1.4L12 10.6a1 1 0 0 1 1.4 0z" /></svg>
          <span data-copy-label>Copy link</span>
        </button>
      </div>

      <div class="art-body">
        {teamNews.length > 0 && (
          <section class="tn" aria-labelledby="tn-h">
            <h2 id="tn-h">Squad availability</h2>
            <div class="tn-scroll"><table>
              <thead><tr><th scope="col">Player</th><th scope="col">Status</th><th scope="col">Injury / reason</th><th scope="col">Expected return</th></tr></thead>
              <tbody>
                {teamNews.map(r => (
                  <tr>
                    <th scope="row">{r.player && playerName(r.player) ? <a href={`/squad/${r.player}/`}>{r.label}</a> : r.label}</th>
                    <td><span class:list={['tn-status', STATUS_CLASS[r.status]]}>{r.status}</span></td>
                    <td>{r.reason || '–'}</td>
                    <td>{r.expectedReturn || '–'}</td>
                  </tr>
                ))}
              </tbody>
            </table></div>
          </section>
        )}
        {membersOnly ? (
          <div class="art-members">
            <div class="art-lock" data-ms-lock>
              <p class="art-lock-k">Members only</p>
              <h2>This story is for Lobi Stars members</h2>
              <p>Official members can read the full story. Already a member? Log in with your fan account.</p>
              <div class="art-lock-acts">
                <a class="btn-p" href="/membership/">Become a member</a>
                <a class="btn-o" href={`/fans/login/?next=/news/${article.id}/`}>Log in</a>
              </div>
            </div>
            <i hidden data-ms-start></i>
            {embed ? <div class="art-video art-video--in"><iframe src={embed} title={a.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>
              : directVideo ? <video class="art-video-el art-video--in" src={directVideo} poster={a.coverImage} controls preload="metadata"></video> : null}
        <Content />
        {(a.gallery || []).length > 0 && (
          <div class="art-gallery">
            {(a.gallery || []).map(g => (
              <figure><img src={g.src} alt={g.caption || ''} loading="lazy" />{g.caption && <figcaption>{g.caption}</figcaption>}</figure>
            ))}
          </div>
        )}
            <i hidden data-ms-end></i>
          </div>
        ) : (
          <>
        <Content />
        {(a.gallery || []).length > 0 && (
          <div class="art-gallery">
            {(a.gallery || []).map(g => (
              <figure><img src={g.src} alt={g.caption || ''} loading="lazy" />{g.caption && <figcaption>{g.caption}</figcaption>}</figure>
            ))}
          </div>
        )}
          </>
        )}
      </div>

      {products.length > 0 && (
        <section class="art-shop" aria-labelledby="art-shop-h">
          <h2 id="art-shop-h">Shop the story</h2>
          <div class="art-shop-grid">{products.map(p => <ShopCard product={p} />)}</div>
          <a class="art-shop-all" href="/shop/">Visit the club shop &rarr;</a>
        </section>
      )}

      <div class="art-share art-share--end" aria-label="Share this story">
        <span class="art-share-label">Share this story</span>
        <a href={share.facebook} target="_blank" rel="noopener">Facebook</a>
        <a href={share.x} target="_blank" rel="noopener">X</a>
        <a href={share.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
      </div>

      <!-- Next Lobi Stars fixture: filled in on the server (functions/news/[slug].js). -->
      <div class="art-next" id="nextFixture" hidden></div>

      <WhatsAppChannel variant="card" />

      <a class="art-back" href={`/news?category=${categorySlug(a.category)}`}>&larr; More {a.category} news</a>
    </div>
  </article>

  <NewsCarousel title="Related news" articles={related} viewAllHref="/news" tone="band" />
</Layout>

<style>
  .art { padding-top: 32px; }
  .art-mo { background: #FFC72C !important; color: #15181D !important; }
  .art-lock { margin: 8px 0 26px; padding: 26px 24px; border-radius: 14px; background: linear-gradient(160deg, #15181D, #2A0507); color: #fff; border: 2px solid #C9A227; text-align: center; }
  .art-lock-k { margin: 0; font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; color: #FFC72C; }
  .art-lock h2 { margin: 10px 0 8px; font: 400 30px/1.05 'Bebas Neue', sans-serif; letter-spacing: 1px; color: #fff; }
  .art-lock p { color: rgba(255,255,255,.85); }
  .art-lock-acts { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 16px; }
  .art-lock .btn-o, .art-lock .btn-o:visited { color: #fff; border-color: rgba(255,255,255,.7); text-decoration: none; }
  .art-lock .btn-p, .art-lock .btn-p:visited { color: #fff; text-decoration: none; }
  .art-video--in { margin-bottom: 22px; }
  .art-shop { margin: 34px 0 10px; padding-top: 24px; border-top: 1px solid var(--d4); }
  .art-shop h2 { margin: 0 0 14px; font: 400 28px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .art-shop-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr)); gap: 14px; }
  .art-shop-all { display: inline-block; margin-top: 14px; color: var(--red-text); font-weight: 700; text-decoration: none; }
  @media (max-width: 520px) { .art-shop-grid { grid-template-columns: 1fr 1fr; gap: 10px; } }
  .art-media { max-width: 1100px; margin: 0 auto; padding: 0 5%; }
  .art-cover, .art-video, .art-video-el { position: relative; aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; background: #0F1115; width: 100%; display: block; }
  .art-cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .art-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .art-video-note {
    position: absolute; left: 16px; bottom: 16px; display: inline-flex; align-items: center; gap: 10px;
    background: rgba(15, 17, 21, .85); color: #fff; border-radius: 6px; padding: 8px 14px 8px 8px;
    font: 700 14px/1 'Barlow Condensed', sans-serif; letter-spacing: .6px; text-transform: uppercase;
  }
  .art-play { width: 32px; height: 32px; border-radius: 50%; background: var(--red); display: flex; align-items: center; justify-content: center; }
  .art-play svg { width: 16px; height: 16px; fill: #fff; }

  .art--long .art-media { max-width: 1320px; }
  .art--long .art-cover, .art--long .art-video { aspect-ratio: 21 / 9; }
  .art--long .art-col { max-width: 820px; }
  .art--long .art-body { font-size: 19px; }
  .art--long .art-body :global(blockquote) { margin: 2em -4%; padding: 18px 26px; border-left: 0; border-top: 4px solid var(--red); border-bottom: 1px solid var(--d4); font: 400 clamp(28px, 3.6vw, 38px)/1.15 'Bebas Neue', sans-serif; letter-spacing: .5px; text-align: center; color: var(--red-text); }
  .art-series { background: #15181D; color: #FFC72C; padding: 4px 9px; border-radius: 4px; }
  .art-byline { display: flex; align-items: center; gap: 12px; margin: -6px 0 18px; }
  .art-author-img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .art-byline div { display: flex; flex-direction: column; gap: 3px; }
  .art-author { font-weight: 700; font-size: 15px; }
  .art-role { font-weight: 400; color: var(--lt); }
  .art-dates { font-size: 13px; color: var(--lt); }
  .art-dates strong { color: var(--white); font-weight: 600; }
  .art-players { list-style: none; margin: 0 0 22px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .art-players a { display: inline-flex; align-items: center; gap: 7px; padding: 4px 12px 4px 4px; border: 1px solid var(--d4); border-radius: 999px; text-decoration: none; color: var(--white); font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: .5px; text-transform: uppercase; background: #fff; }
  .art-players a:hover, .art-players a:focus-visible { border-color: var(--red); color: var(--red-text); outline: none; }
  .art-players img { width: 26px; height: 26px; border-radius: 50%; object-fit: cover; }
  .art-players a:not(:has(img)) { padding-left: 12px; }
  .tn { margin: 0 0 2em; }
  .tn h2 { margin: 0 0 .6em !important; }
  .tn-scroll { overflow-x: auto; position: relative; }
  .tn table { width: 100%; border-collapse: collapse; font-size: 15px; line-height: 1.4; }
  .tn th, .tn td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--d4); vertical-align: top; }
  .tn thead th { font: 700 12px/1.2 'Barlow Condensed', sans-serif; letter-spacing: 1.2px; text-transform: uppercase; color: var(--lt); }
  .tn tbody th { font-weight: 700; }
  .tn-status { display: inline-block; padding: 3px 9px; border-radius: 999px; font: 700 12px/1.3 'Barlow Condensed', sans-serif; letter-spacing: .8px; text-transform: uppercase; white-space: nowrap; }
  .tn-status.ok { background: #E8F7EE; color: #17643A; }
  .tn-status.warn { background: #FFF4D6; color: #7A5300; }
  .tn-status.bad { background: #FDECEC; color: #A3161B; }
  .tn-status.sus { background: #EDE9FE; color: #4C2A9E; }
  .art-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; margin: 1.5em 0; }
  .art-gallery figure { margin: 0; }
  .art-gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; margin: 0 !important; }
  .art-gallery figcaption { font-size: 13px; color: var(--lt); margin-top: 4px; }
  .art-share--end { margin: 28px 0 0; }
  .art-next { margin: 28px 0 0; }
  .art-next :global(.anx) { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; padding: 18px 20px; border-radius: 14px; color: #fff; background: radial-gradient(130% 160% at 0% 0%, #7A0F12 0%, #2A0507 60%, #15181D 100%); }
  .art-next :global(.anx-k) { display: block; font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; color: #FFC72C; margin-bottom: 6px; }
  .art-next :global(.anx strong) { display: block; font: 400 26px/1.05 'Bebas Neue', sans-serif; letter-spacing: .5px; }
  .art-next :global(.anx-meta) { font-size: 14px; color: rgba(255, 255, 255, .85); }
  .art-next :global(.anx-acts) { display: flex; gap: 8px; flex-wrap: wrap; }
  .art-next :global(.anx-acts .btn-o) { color: #fff; border-color: rgba(255, 255, 255, .6); }
  .art-sample { margin: 0 0 20px; padding: 12px 16px; border-radius: 8px; background: #FFF6D6; border: 1px solid #F2D27A; color: #5C4300; font-size: 15px; line-height: 1.5; }
  .art-col { max-width: 720px; margin: 0 auto; padding: 32px 5% 20px; box-sizing: content-box; }
  .art-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px; color: var(--lt);
    font: 600 13px/1.2 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase;
  }
  .art-cat { color: var(--red-text); font-weight: 700; text-decoration: none; }
  .art-cat:hover, .art-cat:focus-visible { text-decoration: underline; }
  .art-title { margin: 14px 0 16px; font: 400 clamp(36px, 5.4vw, 58px)/1 'Bebas Neue', sans-serif; letter-spacing: 1px; color: var(--white); }
  .art-lead { margin: 0 0 24px; font-size: 19px; line-height: 1.6; color: var(--white); font-weight: 600; }

  .art-share { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 16px 0; border-top: 1px solid var(--d4); border-bottom: 1px solid var(--d4); margin-bottom: 32px; }
  .art-share-label { font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; color: var(--lt); margin-right: 4px; }
  .art-share a, .art-copy {
    height: 40px; min-width: 40px; border-radius: 20px; border: 1px solid var(--d4); background: var(--d2);
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; color: var(--white); cursor: pointer;
    padding: 0 10px; text-decoration: none; transition: background .2s, border-color .2s, color .2s;
    font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase;
  }
  .art-share svg { width: 18px; height: 18px; fill: currentColor; }
  .art-copy { padding: 0 14px 0 12px; }
  .art-share a:hover, .art-copy:hover { background: var(--red); border-color: var(--red); color: #fff; }
  .art-share a:focus-visible, .art-copy:focus-visible { outline: 3px solid var(--red); outline-offset: 2px; }

  .art-body { font-size: 17px; line-height: 1.8; color: var(--white); }
