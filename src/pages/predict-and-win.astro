---
import Layout from '../layouts/Layout.astro';
import MatchdayGamePage from '../components/fans/MatchdayGamePage.astro';
import { PRIZE_AMOUNT, PREDICTION_OPENS_HOURS_BEFORE, formatNaira } from '../../functions/api/_lib/predictSettings.js';
const prize = formatNaira(PRIZE_AMOUNT);
---
<Layout title="Predict & Win | Lobi Stars Football Club" description={`Predict the exact final score of Lobi Stars home games for free. The earliest correct prediction wins ${prize}.`}>
  <MatchdayGamePage
    kind="predict"
    kicker="Matchday Live"
    title="Predict &"
    highlight={`Win ${prize}`}
    intro={`Think you know how the game will finish? Predict the exact final score of every Lobi Stars home game. It's free, and the earliest correct prediction wins ${prize}.`}
    steps={[
      { title: 'Create a fan account', text: 'It is free. You must be 18 or over and confirm your email address.' },
      { title: 'Make your prediction', text: `Predictions open ${PREDICTION_OPENS_HOURS_BEFORE} hours before kick-off. Open the game on Matchday Live, choose the Predict tab and enter the final score.` },
      { title: 'Watch the match', text: 'Follow the game live and see how your prediction holds up.' },
      { title: 'Win', text: `The fan who predicted the exact score first wins ${prize}. The winner is announced at full time, and the club calls and emails them to come and collect the prize.` },
    ]}
    rules={[
      'Open to fans aged 18 and over. Club staff and players cannot win.',
      'Lobi Stars home games only. One prediction per fan account per match.',
      'Predictions close at kick-off (official club clock, Nigerian time), or at 4:00 pm Nigerian time if no kick-off time has been set.',
      `Prize: ${prize} per home game. If several fans predict the exact score, the earliest submission wins. If nobody predicts the exact score, nobody wins and the prize is not given out for that game.`,
      'Season Prediction League: every entry also scores 3 points for the exact score or 1 point for the correct result.',
      'The club will never ask for your bank details through the website.',
    ]}
  >
    <!-- Filled in on the server with the saved sponsor (functions/predict-and-win/index.js). -->
    <div id="predictSponsorTop" slot="top"><div class="pw-top-sp"><p data-predict-sponsor-line>Predict &amp; Win, sponsored by <strong>Prime Beverages &amp; Logistics Ltd</strong></p></div></div>
  </MatchdayGamePage>
</Layout>

<style is:global>
  .pw-top-sp { display: flex; align-items: center; gap: 14px; margin: 0 0 30px; padding: 12px 16px; border: 1px solid var(--d4); border-radius: 14px; background: #fff; }
  .pw-top-sp img { width: 72px; height: 72px; object-fit: contain; border-radius: 10px; background: #fff; flex: none; }
  .pw-top-sp p { margin: 0; font-size: 16px; }
</style>
