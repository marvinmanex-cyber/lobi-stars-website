---
import Layout from '../layouts/Layout.astro';
import MatchdayGamePage from '../components/fans/MatchdayGamePage.astro';
---
<Layout title="Predict & Win | Lobi Stars Football Club" description="Predict the final score of Lobi Stars home games with a free fan account for the chance to win.">
  <MatchdayGamePage
    kind="predict"
    kicker="Matchday Live"
    title="Predict &"
    highlight="Win"
    intro="Think you know how the game will finish? Predict the final score of every Lobi Stars home game for the chance to win."
    steps={[
      { title: 'Create a fan account', text: 'It is free. You must be 18 or over and confirm your email address.' },
      { title: 'Make your prediction', text: 'Before kick-off, open the game on Matchday Live, choose the Predict tab and enter the final score.' },
      { title: 'Watch the match', text: 'Follow the game live and see how your prediction holds up.' },
      { title: 'Win', text: 'Correct predictions are in with a chance to win. Winners are contacted by the club.' },
    ]}
    rules={[
      'Open to fans aged 18 and over. Club staff and players cannot win.',
      'Lobi Stars home games only. One prediction per fan account per match.',
      'Predictions close at kick-off (official club clock, Nigerian time).',
      'Prizes and full terms will be announced before launch. The club will never ask for your bank details through the website.',
    ]}
  />
</Layout>
