---
// Public club network score form. Approved submitters open it from their
// private link (?t=…) or type their 8-digit PIN, pick one of today's matches
// and send the score. Made for a phone at a ground with a weak signal: big
// buttons, nothing heavy. Each report is one source; it never changes the table
// on its own (see functions/api/scores/submit.js).
import Layout from '../../layouts/Layout.astro';
import settings from '../../data/fan-settings.json';
const siteKey = settings.turnstileSiteKey;
---
<Layout title="Send a Score | Lobi Stars FC" description="Score form for approved club contacts." noindex>
  <main class="ss">
    <h1>Send a <span>score</span></h1>
    <section id="pinBox" hidden>
      <p>Enter the 8-digit PIN the Lobi Stars Website &amp; Data Officer sent you.</p>
      <form id="pinForm" class="ss-pin"><label class="sr-only" for="pin">PIN</label>
        <input id="pin" inputmode="numeric" autocomplete="one-time-code" maxlength="8" pattern="[0-9]{8}" required placeholder="PIN" />
        <button class="ss-btn" type="submit">Continue</button></form>
    </section>
    <section id="formBox" hidden>
      <p class="ss-who" id="who"></p>
      <label class="ss-lbl" for="fx">Match</label>
      <select id="fx"></select>
      <div class="ss-score" aria-label="Score">
        <div class="ss-side"><b id="hName">Home</b><div class="ss-goals"><button type="button" data-g="h" data-d="-1" aria-label="Home one goal less">−</button><output id="hG">0</output><button type="button" data-g="h" data-d="1" aria-label="Home one goal more">+</button></div></div>
        <div class="ss-side"><b id="aName">Away</b><div class="ss-goals"><button type="button" data-g="a" data-d="-1" aria-label="Away one goal less">−</button><output id="aG">0</output><button type="button" data-g="a" data-d="1" aria-label="Away one goal more">+</button></div></div>
      </div>
      <div class="ss-lbl">Status</div>
      <div class="ss-status" role="group" aria-label="Status">
        <button type="button" data-st="LIVE" aria-pressed="true">Live</button>
        <button type="button" data-st="HALF_TIME" aria-pressed="false">Half-time</button>
        <button type="button" data-st="FULL_TIME" aria-pressed="false">Full time</button>
        <button type="button" data-st="POSTPONED" aria-pressed="false">Postponed</button>
        <button type="button" data-st="ABANDONED" aria-pressed="false">Abandoned</button>
      </div>
      <label class="ss-lbl" for="minute">Minute (optional)</label>
      <input id="minute" inputmode="numeric" maxlength="6" placeholder="e.g. 67 or 90+3" />
      {siteKey && <div class="cf-turnstile ss-ts" data-sitekey={siteKey}></div>}
      <button class="ss-btn ss-send" type="button" id="send">Send score</button>
      <p class="ss-note">Thank you. Send again whenever the score or status changes. Only the latest report from you counts.</p>
    </section>
    <p class="ss-msg" id="msg" role="status" aria-live="polite" hidden></p>
  </main>
  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Layout>

<style>
  .ss { max-width: 480px; margin: 0 auto; padding: 24px 16px 60px; font-family: 'Barlow', sans-serif; color: #15181D; }
  .ss h1 { font: 400 40px/1 'Bebas Neue', sans-serif; margin: 0 0 14px; } .ss h1 span { color: #E31E24; }
  .ss p { line-height: 1.5; }
  .ss-who { font-weight: 700; }
  .ss-lbl { display: block; font-weight: 700; margin: 16px 0 6px; }
  .ss select, .ss input { width: 100%; box-sizing: border-box; min-height: 50px; border: 1px solid #CBD2DA; border-radius: 12px; padding: 8px 12px; font: inherit; font-size: 17px; background: #fff; color: #15181D; }
  .ss-pin { display: grid; gap: 10px; } .ss-pin input { font-size: 26px; letter-spacing: 4px; text-align: center; }
  .ss-score { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 16px; }
  .ss-side { text-align: center; background: #F4F6F8; border-radius: 14px; padding: 12px 6px; }
  .ss-side b { display: block; min-height: 2.4em; font-size: 15px; line-height: 1.2; }
  .ss-goals { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 6px; }
  .ss-goals button { width: 52px; height: 52px; border-radius: 14px; border: 1px solid #CBD2DA; background: #fff; font-size: 28px; font-weight: 700; color: #15181D; touch-action: manipulation; cursor: pointer; }
  .ss-goals output { min-width: 36px; font: 400 44px/1 'Bebas Neue', sans-serif; }
  .ss-status { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .ss-status button { min-height: 50px; border-radius: 12px; border: 1px solid #CBD2DA; background: #fff; font-weight: 700; font-size: 14px; color: #15181D; cursor: pointer; }
  .ss-status button[aria-pressed="true"] { background: #15181D; color: #fff; border-color: #15181D; }
  .ss-ts { margin-top: 16px; }
  .ss-btn { min-height: 54px; width: 100%; border: 0; border-radius: 14px; background: #E31E24; color: #fff; font-weight: 800; font-size: 18px; cursor: pointer; }
  .ss-btn:disabled { opacity: .6; }
  .ss-send { margin-top: 16px; }
  .ss-note { font-size: 14px; color: #5B6470; }
  .ss-msg { padding: 12px 14px; border-radius: 12px; font-weight: 700; }
  .ss-msg.ok { background: #E8F7EE; color: #17643A; } .ss-msg.err { background: #FDECEC; color: #A3161B; }
</style>

<script is:inline>
(function () {
  const $ = id => document.getElementById(id);
  const cred = { t: new URLSearchParams(location.search).get('t') || '', pin: '' };
  const st = { h: 0, a: 0, status: 'LIVE' };
  let fixtures = [];
  function msg(t, ok) { const m = $('msg'); m.textContent = t; m.className = 'ss-msg ' + (ok ? 'ok' : 'err'); m.hidden = false; }
  async function post(body) {
    const r = await fetch('/api/scores/submit', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.assign({}, cred, body)) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { const e = new Error(d.error || 'Could not send. Check your signal and try again.'); e.status = r.status; throw e; }
    return d;
  }
  const kick = iso => new Date(iso).toLocaleString('en-GB', { weekday: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Lagos' });
  function pick() {
    const f = fixtures.find(x => String(x.id) === $('fx').value);
    $('hName').textContent = f ? f.home : 'Home'; $('aName').textContent = f ? f.away : 'Away';
  }
  async function open() {
    try {
      const d = await post({ action: 'open' });
      fixtures = d.fixtures || [];
      $('who').textContent = `Hello ${d.submitter.name} (${d.submitter.club}).`;
      $('fx').replaceChildren(...(fixtures.length ? fixtures.map(f => new Option(`${f.home} v ${f.away} · ${kick(f.kickoff_at)}`, f.id)) : [new Option('No conference matches today', '')]));
      pick();
      $('pinBox').hidden = true; $('formBox').hidden = false; $('msg').hidden = true;
    } catch (e) {
      msg(e.message, false);
      if (e.status === 403) { cred.t = ''; $('pinBox').hidden = false; $('formBox').hidden = true; }
    }
  }
  $('pinForm').addEventListener('submit', e => { e.preventDefault(); cred.pin = $('pin').value.replace(/\D/g, ''); open(); });
  $('fx').addEventListener('change', () => { st.h = 0; st.a = 0; $('hG').textContent = '0'; $('aG').textContent = '0'; pick(); });
  document.querySelector('.ss-score').addEventListener('click', e => {
    const b = e.target.closest('[data-g]'); if (!b) return;
    st[b.dataset.g] = Math.max(0, Math.min(99, st[b.dataset.g] + Number(b.dataset.d)));
    $(b.dataset.g + 'G').textContent = st[b.dataset.g];
  });
  document.querySelector('.ss-status').addEventListener('click', e => {
    const b = e.target.closest('[data-st]'); if (!b) return;
    st.status = b.dataset.st;
    document.querySelectorAll('.ss-status button').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
  });
  $('send').addEventListener('click', async () => {
    if (!$('fx').value) return msg('There is no match to send a score for right now.', false);
    const ts = document.querySelector('[name="cf-turnstile-response"]');
    const noScore = st.status === 'POSTPONED';
    const btn = $('send'); btn.disabled = true;
    try {
      await post({ action: 'send', fixtureId: Number($('fx').value), homeGoals: noScore ? null : st.h, awayGoals: noScore ? null : st.a, status: st.status, minute: $('minute').value, turnstile: ts ? ts.value : '' });
      const f = fixtures.find(x => String(x.id) === $('fx').value);
      msg(`Received: ${f.home} ${noScore ? '' : st.h + '–' + st.a + ' '}${f.away}${noScore ? ' postponed' : ''}. Thank you!`, true);
    } catch (e) { msg(e.message, false); }
    finally { btn.disabled = false; try { window.turnstile && window.turnstile.reset(); } catch (_) {} }
  });
  if (cred.t) open(); else $('pinBox').hidden = false;
})();
</script>
