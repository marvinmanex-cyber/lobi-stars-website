---
// /fans/account -- the fan's own account page (opened from the header's
// account icon). Shows the digital membership card (confirmed members), the
// membership status, and the fan's Prediction League position this season.
// Lobi Stars Rewards: join with one click, member number, Pride Points balance,
// profile bonus (state + date of birth) and recent activity (/api/rewards/*).
import FanAuthShell from '../../components/fans/FanAuthShell.astro';
---
<FanAuthShell title="My Account" heading="My account" description="Your Lobi Stars FC fan account." intro="">
  <div id="acc" aria-live="polite">
    <p class="fa-note info" id="accLoading">Checking your account…</p>
    <div id="accBody" hidden>
      <p class="acc-hi">Hi <strong id="accName"></strong></p>
      <section class="mcard-wrap" id="memCard" hidden aria-label="Digital membership card">
        <div class="mcard">
          <div class="mcard-top"><img class="club-logo" style="--logo-h:44px" src="/images/lobi-stars-badge.png" alt="" width="44" height="44" /><div><p class="mcard-club">Lobi Stars FC</p><p class="mcard-kind">Official Member</p></div><span class="mcard-season" id="mcSeason"></span></div>
          <p class="mcard-name" id="mcName"></p>
          <div class="mcard-row"><div><span>Member number</span><b id="mcId"></b></div><div><span>Member since</span><b id="mcSince"></b></div></div>
          <p class="mcard-foot">Pride of Benue &middot; Red &amp; Gold</p>
        </div>
        <p class="acc-small">Show this card at the club when asked. It is only valid for the season shown.</p>
      </section>
      <div class="acc-mem" id="memStatus" hidden></div>
      <section class="rw-box" id="rwBox" aria-labelledby="rwH" hidden>
        <h2 class="acc-h" id="rwH">Lobi Stars Rewards</h2>
        <div id="rwBody"></div>
      </section>
      <dl class="acc-dl">
        <div><dt>Email</dt><dd id="accEmail"></dd></div>
        <div><dt>Email confirmed</dt><dd id="accVerified"></dd></div>
        <div><dt>Account type</dt><dd id="accTier"></dd></div>
      </dl>
      <h2 class="acc-h">Prediction League <span class="acc-season" id="lgSeason"></span></h2>
      <p class="acc-league" id="lgMine">Loading…</p>
      <h2 class="acc-h">Matchday</h2>
      <ul class="acc-links">
        <li><a href="/predict-and-win/">Predict &amp; Win</a></li>
        <li><a href="/predict-and-win/league/">Prediction League table</a></li>
        <li><a href="/man-of-the-match/">Vote for Man of the Match</a></li>
        <li><a href="/awards/">Fan Awards</a></li>
        <li><a href="/commentary/">Lobi Stars FC Live commentary</a></li>
        <li><a href="/membership/">Membership</a></li>
      </ul>
      <button type="button" class="btn-o fa-submit" id="logoutBtn">Log out</button>
    </div>
  </div>
</FanAuthShell>

<style is:global>
  .rw-box { margin: 0 0 24px; padding: 16px; border-radius: 14px; border: 2px solid #C9A227; background: linear-gradient(135deg, rgba(193, 26, 31, .08), rgba(255, 199, 44, .14)); }
  .rw-pts { display: flex; flex-wrap: wrap; gap: 10px 22px; align-items: baseline; margin: 4px 0 12px; }
  .rw-pts b { font: 400 46px/1 'Bebas Neue', sans-serif; color: var(--red-text); letter-spacing: 1px; }
  .rw-pts span { font: 700 13px/1.3 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: var(--lt); }
  .rw-no { margin: 0; font: 700 14px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; }
  .rw-note { margin: 0 0 12px; padding: 10px 12px; border-radius: 8px; background: var(--d3); font-size: 14px; line-height: 1.5; }
  .rw-form { display: grid; gap: 10px; margin: 12px 0; }
  .rw-form .row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  @media (max-width: 480px) { .rw-form .row { grid-template-columns: 1fr; } }
  .rw-form select, .rw-form input[type=date] { width: 100%; min-height: 44px; box-sizing: border-box; padding: 0 10px; border-radius: 8px; border: 1.5px solid var(--d4); background: var(--d2); color: var(--white); font: inherit; }
  .rw-hist { list-style: none; margin: 8px 0 12px; padding: 0; display: grid; gap: 6px; }
  .rw-hist li { display: flex; justify-content: space-between; gap: 10px; padding: 8px 10px; border-radius: 8px; background: var(--d2); font-size: 14px; }
  .rw-hist .plus { color: #0B7A2E; font-weight: 700; }
  .rw-hist .minus { color: var(--red-text); font-weight: 700; }
  .rw-box .btn-p { min-height: 44px; }
  .rw-box a { color: var(--red-text); font-weight: 600; }
</style>

<style>
  .acc-hi { font-size: 18px; margin: 0 0 14px; }
  .acc-dl { display: grid; gap: 10px; margin: 0 0 22px; }
  .acc-dl div { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 10px; border-bottom: 1px solid var(--d4); flex-wrap: wrap; }
  .acc-dl dt { font: 700 13px/1.4 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: var(--lt); }
  .acc-dl dd { margin: 0; overflow-wrap: anywhere; }
  .acc-h { margin: 0 0 10px; font: 400 24px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .mcard-wrap { margin: 0 0 22px; }
  .mcard { position: relative; border-radius: 16px; padding: 18px 20px; color: #fff; background: radial-gradient(120% 140% at 0% 0%, #A3161B 0%, #4D0B0D 55%, #15181D 100%); border: 2px solid #C9A227; box-shadow: 0 14px 30px rgba(77, 11, 13, .3); aspect-ratio: 1.586; display: flex; flex-direction: column; max-width: 420px; margin: 0 auto; }
  .mcard-top { display: flex; align-items: center; gap: 10px; }
  .mcard-club { margin: 0; font: 400 22px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .mcard-kind { margin: 2px 0 0; font: 700 11px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; color: #FFC72C; }
  .mcard-season { margin-left: auto; padding: 4px 10px; border-radius: 999px; background: #FFC72C; color: #15181D; font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; }
  .mcard-name { margin: auto 0 8px; font: 400 clamp(24px, 7vw, 32px)/1 'Bebas Neue', sans-serif; letter-spacing: 1.5px; overflow-wrap: anywhere; }
  .mcard-row { display: flex; gap: 22px; flex-wrap: wrap; }
  .mcard-row span { display: block; font: 700 10px/1.2 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,.7); }
  .mcard-row b { font: 600 15px/1.3 'Barlow', sans-serif; letter-spacing: .5px; }
  .mcard-foot { margin: 10px 0 0; font: 700 10px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,.6); }
  .acc-small { font-size: 13px; color: var(--lt); text-align: center; margin: 8px 0 0; }
  .acc-mem { margin: 0 0 22px; padding: 14px 16px; border-radius: 10px; background: #FFF8E1; border: 1px solid #F1D27A; font-size: 15px; line-height: 1.5; }
  .acc-mem .btn-p { margin-top: 10px; }
  .acc-season { font: 600 15px 'Barlow', sans-serif; letter-spacing: 0; color: var(--lt); }
  .acc-league { margin: 0 0 22px; }
  .acc-league strong { color: var(--red-text); }
  .acc-links { margin: 0 0 22px; padding-left: 20px; line-height: 1.9; }
  .acc-links a { color: var(--red-text); font-weight: 600; }
</style>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  fetch('/api/auth/me').then(r => r.json()).then(({ member }) => {
    if (!member) { location.replace('/fans/login/?next=/fans/account/'); return; }
    $('accName').textContent = `${member.firstName} ${member.lastName}`;
    $('accEmail').textContent = member.email;
    $('accVerified').textContent = member.emailVerified ? 'Yes' : 'Not yet – check your inbox';
    const ms = member.membership || {};
    $('accTier').textContent = ms.active ? `Official member (${ms.season})` : member.tier === 'Official' ? 'Membership not yet confirmed' : 'Fan account';
    if (ms.active) {
      $('mcSeason').textContent = ms.season;
      $('mcName').textContent = `${member.firstName} ${member.lastName}`;
      $('mcId').textContent = member.id;
      $('mcSince').textContent = new Date(ms.since).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Africa/Lagos' });
      $('memCard').hidden = false;
    } else {
      const box = $('memStatus');
      const price = ms.priceKobo ? '₦' + (ms.priceKobo / 100).toLocaleString('en-NG') : '';
      box.innerHTML = `<strong>Become an official member for ${ms.season}</strong><br>Members get the digital membership card, members-only stories and priority access to tickets.${price ? ` Membership is ${price} for the season.` : ''}`;
      if (ms.onlinePayment) {
        const b = document.createElement('button'); b.type = 'button'; b.className = 'btn-p'; b.textContent = `Pay ${price} with Paystack`;
        b.addEventListener('click', async () => {
          b.disabled = true; b.textContent = 'Starting payment…';
          try {
            const r = await fetch('/api/membership/checkout', { method: 'POST' }); const d = await r.json();
            if (!r.ok || !d.authorizationUrl) throw new Error(d.error || 'Payment could not be started.');
            location.href = d.authorizationUrl;
          } catch (err) { b.disabled = false; b.textContent = `Pay ${price} with Paystack`; alert((err as Error).message); }
        });
        box.appendChild(document.createElement('br')); box.appendChild(b);
      } else {
        const p = document.createElement('p'); p.style.margin = '8px 0 0';
        p.textContent = ms.howToPay || 'Your membership is activated once the club confirms your payment. ';
        if (!ms.howToPay) { const a = document.createElement('a'); a.href = '/contact/'; a.textContent = 'Contact the club'; p.appendChild(a); }
        box.appendChild(p);
      }
      box.hidden = false;
    }
    $('accLoading').hidden = true; $('accBody').hidden = false;
    loadLeague();
  }).catch(() => { $('accLoading').textContent = 'Your account could not be loaded. Please try again.'; });
  const ordinal = (n: number) => n + (n % 100 > 10 && n % 100 < 14 ? 'th' : ['th', 'st', 'nd', 'rd'][n % 10] || 'th');
  function loadLeague() {
    fetch('/api/fans/league').then(r => (r.ok ? r.json() : Promise.reject())).then(d => {
      $('lgSeason').textContent = d.season;
      const el = $('lgMine');
      if (d.me) {
        el.innerHTML = `You are <strong></strong> of ${d.of} with ${d.me.points} point${d.me.points === 1 ? '' : 's'} (${d.me.exact} exact score${d.me.exact === 1 ? '' : 's'} from ${d.me.predictions} prediction${d.me.predictions === 1 ? '' : 's'}).`;
        el.querySelector('strong')!.textContent = ordinal(d.me.rank);
      } else el.textContent = d.staff ? 'Club staff and player accounts are not included in the league.' : 'No points yet this season. Predict the score at the next Lobi Stars home game to get on the table.';
    }).catch(() => { $('lgMine').textContent = 'Your league position could not be loaded right now.'; });
  }
  $('logoutBtn').addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' }).catch(() => {});
    location.href = '/';
  });
</script>

<script is:inline>
(function () {
  var box = document.getElementById('rwBox'), body = document.getElementById('rwBody');
  if (!box) return;
  var el = function (tag, props) { var n = document.createElement(tag); Object.keys(props || {}).forEach(function (k) { var v = props[k]; if (v == null || v === false) return; if (k === 'text') n.textContent = v; else if (k === 'class') n.className = v; else if (k.slice(0, 2) === 'on') n.addEventListener(k.slice(2), v); else n.setAttribute(k, v === true ? '' : v); }); for (var i = 2; i < arguments.length; i++) { var c = arguments[i]; if (c != null && c !== false) n.append(c); } return n; };
  var fmt = function (n) { return Number(n).toLocaleString('en-NG'); };
  var post = function (url, data) { return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); }); };
  function load() {
    var preview = false; try { preview = localStorage.getItem('ls_rewards_preview') === '1'; } catch (e) {}
    fetch('/api/rewards/me', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (d) { if (d.signedIn && (d.live || preview || d.joined)) { box.hidden = false; draw(d); } }).catch(function () {});
  }
  function draw(d) {
    var parts = [];
    if (!d.joined) {
      var agree = el('input', { type: 'checkbox', id: 'rwAgree' });
      var msg = el('p', { class: 'fa-err', role: 'alert' });
      parts.push(el('p', { text: 'Earn Pride Points when you buy tickets, jerseys and matchday food on lobistarsfc.com and when you come to home matches, then swap them for rewards. Free to join: you get ' + d.bonuses.welcome + ' points to start.' }),
        el('label', { class: 'fa-check', for: 'rwAgree' }, agree, el('span', {}, 'I agree to the ', el('a', { href: '/rewards/terms/', target: '_blank', text: 'Lobi Stars Rewards Terms' }), '.')),
        msg,
        el('button', { type: 'button', class: 'btn-p', text: 'Join Lobi Stars Rewards', onclick: function () {
          if (!agree.checked) { msg.textContent = 'Please tick "I agree to the Lobi Stars Rewards Terms".'; return; }
          var btn = this; btn.disabled = true;
          post('/api/rewards/join', { agree: true }).then(function (x) { if (x.ok) load(); else { msg.textContent = x.d.error || 'Could not join.'; btn.disabled = false; } });
        } }));
    } else {
      parts.push(el('p', { class: 'rw-no', text: 'Member number ' + d.memberNo }),
        el('div', { class: 'rw-pts' }, el('div', {}, el('b', { text: fmt(d.balance) }), ' ', el('span', { text: 'Pride Points' })), d.pending ? el('span', { text: fmt(d.pending) + ' pending' }) : null));
      if (!d.verified) parts.push(el('p', { class: 'rw-note', text: 'Confirm your email address (use the link we sent you) to start earning. Your ' + d.bonuses.welcome + ' welcome points are waiting.' }));
      if (d.status === 'suspended') parts.push(el('p', { class: 'rw-note', text: 'Your Rewards membership is on hold. Please contact the club via the Help Centre.' }));
      if (!d.profileBonusDone) {
        var st = el('select', { id: 'rwState' }, el('option', { value: '', text: 'Choose your state' }));
        d.states.forEach(function (x) { var o = el('option', { value: x, text: x }); if (x === d.profile.state) o.selected = true; st.append(o); });
        var dob = el('input', { type: 'date', id: 'rwDob', value: d.profile.dateOfBirth || '', max: new Date().toISOString().slice(0, 10) });
        var pm = el('p', { class: 'fa-err', role: 'alert' });
        parts.push(el('div', { class: 'rw-form' }, el('b', { text: 'Complete your profile: +' + d.bonuses.profile + ' points' }),
          el('div', { class: 'row' }, el('label', { for: 'rwState' }, el('span', { class: 'form-lbl', text: 'State of residence' }), st), el('label', { for: 'rwDob' }, el('span', { class: 'form-lbl', text: 'Date of birth' }), dob)),
          pm, el('button', { type: 'button', class: 'btn-p', text: 'Save my profile', onclick: function () {
            post('/api/rewards/profile', { state: st.value, dateOfBirth: dob.value }).then(function (x) { if (x.ok) load(); else pm.textContent = (x.d.errors && (x.d.errors.state || x.d.errors.dateOfBirth)) || x.d.error || 'Could not save.'; });
          } })));
      }
      if (d.history.length) {
        var ul = el('ul', { class: 'rw-hist' });
        d.history.slice(0, 5).forEach(function (h) { ul.append(el('li', {}, el('span', { text: h.description + (h.status === 'PENDING' ? ' (pending)' : '') }), el('span', { class: h.points >= 0 ? 'plus' : 'minus', text: (h.points >= 0 ? '+' : '') + fmt(h.points) }))); });
        parts.push(el('b', { text: 'Recent activity' }), ul);
      }
      parts.push(el('p', {}, el('a', { href: '/rewards/', text: 'About Lobi Stars Rewards' })));
    }
    body.replaceChildren.apply(body, parts);
  }
  load();
})();
</script>
