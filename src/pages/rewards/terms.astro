---
// /rewards/terms -- Lobi Stars Rewards Terms (approved by the club's legal
// adviser, October 2026). The text lives in functions/api/_lib/rewardsTerms.js
// and can be changed at any time in Admin › Rewards › Terms: this page is
// built with the approved text and swaps in the latest saved version from
// /api/rewards/terms. Out of search engines until Rewards is live.
import LegalPage from '../../components/LegalPage.astro';
import { DEFAULT_TERMS, DEFAULT_TERMS_UPDATED, parseTerms } from '../../../functions/api/_lib/rewardsTerms.js';
const blocks = parseTerms(DEFAULT_TERMS);
const nice = d => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Africa/Lagos' });
---
<LegalPage
  title="Lobi Stars Rewards Terms"
  tag="Lobi Stars Rewards"
  description="The terms of Lobi Stars Rewards, the free Star Points programme for Lobi Stars FC fans."
  updated={nice(DEFAULT_TERMS_UPDATED)}
  noindex
>
  <div id="rwTerms">
    {blocks.map(b => b.type === 'ul'
      ? <ul>{b.items.map(parts => <li>{parts.map(x => x.href ? <a href={x.href}>{x.text}</a> : x.text)}</li>)}</ul>
      : b.type === 'h2' ? <h2>{b.parts.map(x => x.href ? <a href={x.href}>{x.text}</a> : x.text)}</h2>
      : b.type === 'h3' ? <h3>{b.parts.map(x => x.href ? <a href={x.href}>{x.text}</a> : x.text)}</h3>
      : <p>{b.parts.map(x => x.href ? <a href={x.href}>{x.text}</a> : x.text)}</p>)}
  </div>
</LegalPage>

<script is:inline>
(function () {
  // The latest version saved in Admin › Rewards › Terms (text only: built with textContent, never HTML).
  var box = document.getElementById('rwTerms');
  var linkRe = /\[([^\]]{1,120})\]\(((?:\/[^\s)]*)|(?:https:\/\/[^\s)]+)|(?:mailto:[^\s)]+))\)/g;
  function inline(node, line) {
    var last = 0, m; linkRe.lastIndex = 0;
    while ((m = linkRe.exec(line))) {
      if (m.index > last) node.append(line.slice(last, m.index));
      var a = document.createElement('a'); a.href = m[2]; a.textContent = m[1]; node.append(a);
      last = m.index + m[0].length;
    }
    if (last < line.length) node.append(line.slice(last));
    return node;
  }
  function render(md) {
    var out = [], para = [], list = null;
    var flushP = function () { if (para.length) { out.push(inline(document.createElement('p'), para.join(' '))); para = []; } };
    var flushL = function () { if (list) { out.push(list); list = null; } };
    String(md).replace(/\r/g, '').split('\n').forEach(function (raw) {
      var line = raw.trim(), h, li;
      if (!line) { flushP(); flushL(); return; }
      if ((h = /^(#{2,3})\s+(.+)$/.exec(line))) { flushP(); flushL(); out.push(inline(document.createElement(h[1].length === 2 ? 'h2' : 'h3'), h[2])); return; }
      if ((li = /^[-*]\s+(.+)$/.exec(line))) { flushP(); if (!list) list = document.createElement('ul'); list.append(inline(document.createElement('li'), li[1])); return; }
      flushL(); para.push(line);
    });
    flushP(); flushL();
    return out;
  }
  fetch('/api/rewards/terms').then(function (r) { return r.json(); }).then(function (d) {
    if (!d || !d.custom || !d.body) return;
    box.replaceChildren.apply(box, render(d.body));
    var u = document.getElementById('lgUpdated');
    if (u && d.updated) u.textContent = new Date(d.updated + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Africa/Lagos' });
  }).catch(function () {});
})();
</script>
