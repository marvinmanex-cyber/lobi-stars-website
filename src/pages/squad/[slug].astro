---
// /squad/<firstname-surname>/ — a player's profile page (layout in
// components/squad/SquadProfile.astro). Title "[Name] | Lobi Stars FC", the
// description from the bio, a share image with the name and number, and
// schema.org Person data (member of the Lobi Stars FC SportsTeam).
import Layout from '../../layouts/Layout.astro';
import SquadProfile from '../../components/squad/SquadProfile.astro';
import NewsCarousel from '../../components/news/NewsCarousel.astro';
import { render } from 'astro:content';
import { getSortedNews } from '../../lib/news';
import { squadPlayers, type Person } from '../../lib/squadPeople';
import { profileDescription, personJsonLd, shareImage } from '../../lib/squadSeo';

export async function getStaticPaths() {
  const players = await squadPlayers();
  const news = await getSortedNews();
  return players.map((person, i) => {
    // Latest news about the player: stories tagged with them first, then stories that mention their name.
    const name = person.name.toLowerCase();
    const tagged = news.filter(a => (a.data.players || []).includes(person.slug));
    const mentions = news.filter(a => !tagged.includes(a) && `${a.data.title} ${a.data.summary} ${a.body ?? ''}`.toLowerCase().includes(name));
    const teammates = players.filter(x => x !== person && x.group === person.group).slice(0, 4);
    return { params: { slug: person.slug }, props: { person, prev: players[i - 1] || null, next: players[i + 1] || null, teammates, related: person.isSample ? [] : [...tagged, ...mentions].slice(0, 8) } };
  });
}

const { person, prev, next, teammates, related } = Astro.props as { person: Person; prev: Person | null; next: Person | null; teammates: Person[]; related: any[] };
const { Content } = await render(person.entry);
const hasBody = !!(person.entry.body ?? '').trim();
---
<Layout title={`${person.name} | Lobi Stars FC`} description={profileDescription(person)} image={shareImage(person)} imageAlt={`${person.name}, Lobi Stars FC`} noindex={person.isSample} jsonLd={person.isSample ? [] : [personJsonLd(person, Astro.site!)]}>
  <SquadProfile person={person} Content={Content} hasBody={hasBody} prev={prev} next={next} teammates={teammates} />
  {related.length > 0 && <NewsCarousel title={`Latest news about ${person.name}`} articles={related} viewAllHref="/news" tone="band" />}
</Layout>
