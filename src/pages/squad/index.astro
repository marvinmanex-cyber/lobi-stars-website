---
// /squad — the First Team squad: Goalkeepers, Defenders, Midfielders, Forwards
// (by shirt number) and Coaching Staff (Head Coach first). Only public people
// (approved in the portal and not hidden). The list markup comes from
// src/lib/squadRender.js; the server (functions/squad/[[path]].js) fills the same
// box with the live list, so an approval shows within seconds.
import Layout from '../../layouts/Layout.astro';
import '../../styles/squad.css';
import { squadPlayers, squadStaff } from '../../lib/squadPeople';
import { renderList } from '../../lib/squadRender.js';
import { CURRENT_SEASON } from '../../lib/site';

const players = await squadPlayers();
const staff = await squadStaff();
---
<Layout title="First Team Squad | Lobi Stars FC" description={`Meet the Lobi Stars FC First Team squad for ${CURRENT_SEASON}: goalkeepers, defenders, midfielders, forwards and coaching staff.`}>
  <div class="page-hero wrap">
    <div class="stag">Lobi Stars FC · {CURRENT_SEASON}</div>
    <h1 class="stitle">First Team <span class="r">Squad</span></h1>
    <div class="divr"></div>
  </div>

  <div class="page-content wrap sq" data-squad-root set:html={renderList({ players, staff, season: CURRENT_SEASON })} />
</Layout>
<script>
  // Tabs (All / Goalkeepers / … / Coaching Staff) and this season's highlights on the cards ("5 goals", "2× MOTM").
  const root = document.querySelector<HTMLElement>('[data-squad-root]');
  const tabs = [...(root?.querySelectorAll<HTMLButtonElement>('[data-sq-tab]') || [])];
  const show = (id: string) => {
    tabs.forEach(t => t.setAttribute('aria-selected', String(t.dataset.sqTab === id)));
    root!.querySelectorAll<HTMLElement>('.sq-group').forEach(g => { g.hidden = !!id && g.getAttribute('aria-labelledby') !== id; });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => show(t.dataset.sqTab!));
    t.addEventListener('keydown', e => { const k = e.key, j = k === 'ArrowRight' ? (i + 1) % tabs.length : k === 'ArrowLeft' ? (i - 1 + tabs.length) % tabs.length : -1; if (j >= 0) { e.preventDefault(); tabs[j].focus(); show(tabs[j].dataset.sqTab!); } });
  });
  if (root && root.querySelector('.sq-grid')) fetch('/api/squad/highlights').then(r => r.json()).then(d => {
    root.querySelectorAll<HTMLAnchorElement>('a.sc[href^="/squad/"]').forEach(a => {
      const slug = a.getAttribute('href')!.replace(/^\/squad\/|\/$/g, ''), h = d.players?.[slug];
      if (!h) return;
      const badges = [h.goals ? `${h.goals} goal${h.goals === 1 ? '' : 's'}` : '', h.cleanSheets ? `${h.cleanSheets} clean sheet${h.cleanSheets === 1 ? '' : 's'}` : '', h.motm ? `${h.motm > 1 ? `${h.motm}× ` : ''}MOTM` : ''].filter(Boolean);
      if (!badges.length) return;
      const box = document.createElement('span'); box.className = 'sc-badges';
      for (const b of badges) { const s = document.createElement('span'); s.textContent = b; box.append(s); }
      a.querySelector('.sc-body')?.append(box);
    });
  }).catch(() => {});
</script>
