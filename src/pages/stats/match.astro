---
// The page template for /stats/matches/<match>/ (functions/stats/matches/[slug].js fills it on the server from a
// match published in the Statistics Center: scoreline, line-ups, event timeline, team stats, player stats, report,
// highlights). Opened directly at /stats/match/ it is "not found" (functions/stats/match.js).
import Layout from '../../layouts/Layout.astro';
import MatchesTabs from '../../components/MatchesTabs.astro';
---
<Layout title="Match stats | Lobi Stars Football Club" description="Lobi Stars FC match statistics." noindex>
  <div class="page-hero wrap">
    <div class="stag" id="sxmKicker">Match stats</div>
    <h1 class="stitle" id="sxmTitle">Match <span class="r">Stats</span></h1>
    <MatchesTabs current="stats" />
  </div>
  <div class="page-content wrap sxm" id="sxmBody"><p class="sxm-empty">Loading…</p></div>
</Layout>

<style is:global>
  .sxm { padding-bottom: 80px; }
  @media (max-width: 767px) { .sxm { padding-bottom: 32px; } }
  .sxm-score { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px; text-align: center; padding: 20px 12px; background: var(--d2, #fff); border: 1px solid var(--d4); border-radius: 14px; }
  .sxm-team { display: grid; justify-items: center; gap: 8px; font: 700 clamp(13px, 3.6vw, 18px)/1.15 'Barlow Condensed', sans-serif; letter-spacing: .03em; text-transform: uppercase; }
  .sxm-team :global(span) { white-space: nowrap; }
  /* Club names never split: one club per line, the score between them */
  #sxmTitle :global(.fx-club) { display: block; white-space: nowrap; font-size: clamp(26px, 7vw, 1em); }
  #sxmTitle :global(.fx-mid) { display: block; font-size: .7em; line-height: 1.1; }
  .sxm-num { font: 400 clamp(44px, 9vw, 72px)/1 'Bebas Neue', sans-serif; letter-spacing: 2px; }
  .sxm-meta { margin: 10px 0 0; color: var(--lt); font-size: 14px; text-align: center; }
  .sxm-links { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin: 14px 0 0; }
  .sxm-h2 { margin: 32px 0 12px; font: 700 22px/1.2 'Barlow Condensed', sans-serif; text-transform: uppercase; letter-spacing: 1px; }
  .sxm-bars { display: grid; gap: 12px; }
  .sxm-bar { display: grid; grid-template-columns: 44px 1fr 44px; gap: 8px; align-items: center; font-variant-numeric: tabular-nums; }
  .sxm-bar b { text-align: center; } .sxm-bar span { grid-column: 1 / -1; text-align: center; font-size: 13px; color: var(--lt); text-transform: uppercase; letter-spacing: .06em; margin-bottom: -6px; }
  .sxm-track { display: flex; height: 8px; border-radius: 4px; overflow: hidden; background: var(--d4); gap: 2px; }
  .sxm-track i { display: block; height: 100%; background: var(--red); } .sxm-track i + i { background: #1C3F7A; }
  .sxm-tl { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .sxm-tl li { display: grid; grid-template-columns: 52px 1fr; gap: 10px; padding: 8px 0; border-top: 1px solid var(--d4); }
  .sxm-tl .m { font: 700 18px 'Barlow Condensed', sans-serif; color: var(--red-text, var(--red)); }
  .sxm-tl li.away { text-align: right; grid-template-columns: 1fr 52px; } .sxm-tl li.away .m { order: 2; }
  .sxm-tl small { display: block; color: var(--lt); }
  .sxm-period { font: 700 13px 'Barlow Condensed', sans-serif; letter-spacing: .1em; text-transform: uppercase; color: var(--lt); padding-top: 10px; }
  .sxm-lu { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .sxm-lu ol { list-style: none; margin: 0; padding: 0; } .sxm-lu li { padding: 6px 0; border-top: 1px solid var(--d4); } .sxm-lu li span { display: inline-block; width: 28px; color: var(--lt); font-variant-numeric: tabular-nums; }
  .sxm-lu h3 { margin: 0 0 6px; font: 700 18px 'Barlow Condensed', sans-serif; text-transform: uppercase; }
  .sxm-lu a { color: inherit; font-weight: 600; }
  .sxm-scroll { overflow-x: auto; }
  .sxm-t { width: 100%; border-collapse: collapse; font-size: 14px; } .sxm-t th, .sxm-t td { padding: 8px; border-top: 1px solid var(--d4); text-align: left; } .sxm-t th { font-size: 12px; color: var(--lt); text-transform: uppercase; letter-spacing: .05em; border-top: 0; }
  .sxm-t td.n, .sxm-t th.n { text-align: right; font-variant-numeric: tabular-nums; } .sxm-t a { color: inherit; font-weight: 600; }
  .sxm-report { line-height: 1.7; white-space: pre-line; }
  .sxm-empty { color: var(--lt); }
  .sxm-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .sxm-list a { display: flex; justify-content: space-between; gap: 12px; padding: 10px 12px; border: 1px solid var(--d4); border-radius: 10px; color: inherit; text-decoration: none; }
  .sxm-list a:hover, .sxm-list a:focus-visible { border-color: var(--red); }
</style>
