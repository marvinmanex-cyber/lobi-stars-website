---
// /stats/hub -- the public stats hub (27 Nov 2026): season leaderboards, all-time leaders and club records,
// head-to-head against every club, a player comparison tool and recent milestones. Data: /api/stats/hub.json
// (published Statistics Center matches only; youth players are not named unless the club allowed it).
import Layout from '../../layouts/Layout.astro';
import MatchesTabs from '../../components/MatchesTabs.astro';
import { CURRENT_SEASON } from '../../lib/site';
---
<Layout title="Stats Hub | Lobi Stars Football Club" description="Lobi Stars FC stats hub: season leaders, all-time records, head-to-head against every club, player comparison and milestones.">
  <div class="page-hero wrap">
    <div class="stag">{CURRENT_SEASON} Season</div>
    <h1 class="stitle">Stats <span class="r">Hub</span></h1>
    <MatchesTabs current="stats" />
  </div>
  <div class="page-content wrap hub">
    <p class="hub-back"><a href="/stats/">← Season stats</a></p>
    <div id="hub"><p class="hub-dim">Loading the statistics…</p></div>
  </div>
</Layout>

<script>
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  const root = document.getElementById('hub') as HTMLElement;
  const day = (d: string) => { try { return new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Africa/Lagos' }); } catch { return d; } };
  const name = (p: any) => (p.slug ? `<a href="/squad/${esc(p.slug)}/">${esc(p.name)}</a>` : esc(p.name));
  const board = (title: string, rows: any[], unit: string) => `<section class="hub-board"><h3>${esc(title)}</h3>${rows.length ? `<ol>${rows.map((r, i) => `<li><span class="hub-rank">${i + 1}</span><span class="hub-name">${name(r)}</span><span class="hub-val" aria-label="${r.value} ${esc(unit)}">${r.value}</span></li>`).join('')}</ol>` : '<p class="hub-dim">Nothing yet.</p>'}</section>`;
  const STATS: [string, string][] = [['apps', 'Appearances'], ['starts', 'Starts'], ['minutes', 'Minutes'], ['goals', 'Goals'], ['assists', 'Assists'], ['shots', 'Shots'], ['shotsOnTarget', 'Shots on target'], ['cleanSheets', 'Clean sheets'], ['motm', 'Man of the Match'], ['yellow', 'Yellow cards'], ['red', 'Red cards']];
  async function load() {
    let d: any;
    try { const r = await fetch('/api/stats/hub.json'); d = await r.json(); if (!r.ok) throw new Error(d.error); }
    catch { root.innerHTML = '<p class="hub-dim">The statistics are not available right now. Please try again later.</p>'; return; }
    if (!d.matchesRecorded) { root.innerHTML = '<p class="hub-dim">The stats hub fills up as match statistics are published.</p>'; return; }
    const rec = d.records;
    root.innerHTML = `
      <h2 class="hub-h2">Leaders ${esc(d.season)}</h2>
      <div class="hub-boards">${board('Goals', d.leaders.goals, 'goals')}${board('Assists', d.leaders.assists, 'assists')}${board('Appearances', d.leaders.apps, 'appearances')}${board('Clean sheets', d.leaders.cleanSheets, 'clean sheets')}${board('Man of the Match', d.leaders.motm, 'awards')}</div>
      <h2 class="hub-h2">All-time (recorded matches)</h2>
      <div class="hub-boards">${board('Goals', d.allTime.goals, 'goals')}${board('Appearances', d.allTime.apps, 'appearances')}${board('Assists', d.allTime.assists, 'assists')}</div>
      <h2 class="hub-h2">Club records</h2>
      <div class="hub-recs">
        <div class="hub-rec"><b>${rec.biggestWin ? esc(rec.biggestWin.score) : '—'}</b><span>Biggest win${rec.biggestWin ? ` · v ${esc(rec.biggestWin.opponent)}, ${esc(day(rec.biggestWin.date))}` : ''}</span></div>
        <div class="hub-rec"><b>${rec.mostGoalsInAMatch ? rec.mostGoalsInAMatch.goals : '—'}</b><span>Most goals in a match${rec.mostGoalsInAMatch ? ` · ${name(rec.mostGoalsInAMatch)} v ${esc(rec.mostGoalsInAMatch.opponent)}` : ''}</span></div>
        <div class="hub-rec"><b>${rec.longestWinRun}</b><span>Wins in a row</span></div>
        <div class="hub-rec"><b>${rec.longestUnbeatenRun}</b><span>Matches unbeaten</span></div>
      </div>
      <p class="hub-dim">From the ${d.matchesRecorded} match(es) with published statistics.</p>
      <h2 class="hub-h2">Compare players</h2>
      <div class="hub-cmp"><label>Player 1<select id="c1"></select></label><label>Player 2<select id="c2"></select></label><label>Period<select id="cp"><option value="season">${esc(d.season)}</option><option value="career">All recorded matches</option></select></label></div>
      <div class="hub-scroll"><table class="hub-t" id="ct"></table></div>
      <h2 class="hub-h2">Head-to-head</h2>
      <div class="hub-scroll"><table class="hub-t"><thead><tr><th>Opponent</th><th class="n">P</th><th class="n">W</th><th class="n">D</th><th class="n">L</th><th class="n">For</th><th class="n">Against</th></tr></thead><tbody>
        ${d.headToHead.map((h: any) => `<tr><td>${esc(h.opponent)}</td><td class="n">${h.p}</td><td class="n">${h.w}</td><td class="n">${h.d}</td><td class="n">${h.l}</td><td class="n">${h.gf}</td><td class="n">${h.ga}</td></tr>`).join('')}</tbody></table></div>
      ${d.milestones.length ? `<h2 class="hub-h2">Milestones</h2><ul class="hub-ms">${d.milestones.map((m: any) => `<li><span class="hub-dim">${esc(day(m.on))}</span> <b>${esc(m.title)}</b> <span class="hub-dim">${esc(m.detail || '')}</span></li>`).join('')}</ul>` : ''}`;
    const sel1 = document.getElementById('c1') as HTMLSelectElement, sel2 = document.getElementById('c2') as HTMLSelectElement, per = document.getElementById('cp') as HTMLSelectElement;
    const draw = () => {
      const list = d.players[per.value] as any[];
      const keep = [sel1.value, sel2.value];
      const opts = list.filter(p => p.slug).map(p => `<option value="${esc(p.slug)}">${esc(p.name)}</option>`).join('');
      sel1.innerHTML = opts; sel2.innerHTML = opts;
      if (keep[0] && list.some(p => p.slug === keep[0])) sel1.value = keep[0];
      if (keep[1] && list.some(p => p.slug === keep[1])) sel2.value = keep[1]; else if (sel2.options.length > 1) sel2.selectedIndex = 1;
      const a = list.find(p => p.slug === sel1.value), b = list.find(p => p.slug === sel2.value);
      const t = document.getElementById('ct') as HTMLTableElement;
      if (!a || !b) { t.innerHTML = '<tbody><tr><td class="hub-dim">Not enough players yet.</td></tr></tbody>'; return; }
      t.innerHTML = `<thead><tr><th></th><th class="n">${esc(a.name)}</th><th class="n">${esc(b.name)}</th></tr></thead><tbody>${STATS.map(([k, l]) => `<tr><td>${l}</td><td class="n${a[k] > b[k] ? ' hub-win' : ''}">${a[k]}</td><td class="n${b[k] > a[k] ? ' hub-win' : ''}">${b[k]}</td></tr>`).join('')}
        <tr><td>Goals + assists per 90</td>${[a, b].map(p => `<td class="n">${p.minutes ? (((p.goals + p.assists) * 90) / p.minutes).toFixed(2) : '—'}</td>`).join('')}</tr></tbody>`;
    };
    for (const s of [sel1, sel2, per]) s.addEventListener('change', draw);
    draw();
  }
  load();
</script>

<style>
  .hub { padding-bottom: 80px; }
  @media (max-width: 767px) { .hub { padding-bottom: 32px; } }
  .hub-back a { color: var(--red-text); font-weight: 600; text-decoration: none; }
  .hub :global(.hub-dim) { color: var(--lt); font-size: 14px; }
  .hub :global(.hub-h2) { margin: 34px 0 14px; font: 400 30px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .hub :global(.hub-boards) { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .hub :global(.hub-board) { border: 1px solid var(--d4); border-radius: 14px; background: #fff; overflow: hidden; }
  .hub :global(.hub-board h3) { margin: 0; padding: 12px 16px; background: #15181D; color: #fff; font: 400 22px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .hub :global(.hub-board ol) { list-style: none; margin: 0; padding: 6px 0; }
  .hub :global(.hub-board li) { display: flex; align-items: center; gap: 10px; padding: 7px 16px; }
  .hub :global(.hub-board li:first-child) { background: #FFF8E1; }
  .hub :global(.hub-board p) { padding: 10px 16px; margin: 0; }
  .hub :global(.hub-rank) { width: 20px; font: 700 14px/1 'Barlow Condensed', sans-serif; color: var(--lt); }
  .hub :global(.hub-name) { flex: 1; min-width: 0; overflow-wrap: anywhere; font-weight: 600; }
  .hub :global(.hub-name a), .hub :global(.hub-rec a) { color: var(--white); text-decoration: none; }
  .hub :global(.hub-val) { font: 400 24px/1 'Bebas Neue', sans-serif; color: var(--red-text); }
  .hub :global(.hub-recs) { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
  .hub :global(.hub-rec) { border: 1px solid var(--d4); border-radius: 12px; padding: 14px; background: #fff; }
  .hub :global(.hub-rec b) { display: block; font: 400 34px/1 'Bebas Neue', sans-serif; color: var(--red-text); }
  .hub :global(.hub-rec span) { font-size: 14px; color: var(--lt); }
  .hub :global(.hub-cmp) { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 10px; }
  .hub :global(.hub-cmp label) { display: flex; flex-direction: column; gap: 4px; font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: var(--lt); flex: 1 1 180px; min-width: 0; }
  .hub :global(.hub-cmp select) { padding: 9px 12px; border: 1px solid var(--d4); border-radius: 8px; font: 600 15px 'Barlow', sans-serif; background: #fff; color: var(--white); max-width: 100%; }
  .hub :global(.hub-scroll) { overflow-x: auto; }
  .hub :global(.hub-t) { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid var(--d4); border-radius: 12px; }
  .hub :global(.hub-t th), .hub :global(.hub-t td) { padding: 8px 12px; border-top: 1px solid var(--d4); text-align: left; }
  .hub :global(.hub-t .n) { text-align: right; font-variant-numeric: tabular-nums; }
  .hub :global(.hub-win) { font-weight: 700; color: var(--red-text); }
  .hub :global(.hub-ms) { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .hub :global(.hub-ms li) { border: 1px solid var(--d4); border-radius: 10px; padding: 10px 14px; background: #fff; }
</style>
