---
import Layout from '../../layouts/Layout.astro';
import FixturesBoard from '../../components/FixturesBoard.astro';
import { CURRENT_SEASON } from '../../lib/site';
---
<Layout title="Fixtures & Results | Lobi Stars Football Club" description={`Lobi Stars FC fixtures and results for the ${CURRENT_SEASON} season.`}>
  <div class="page-hero wrap">
    <div class="stag">{CURRENT_SEASON} Schedule &amp; Results</div>
    <h1 class="stitle">Fixtures &amp; <span class="r">Results</span></h1>
    <div class="divr"></div>
  </div>

  <div class="page-content wrap" id="results">
    <FixturesBoard />
  </div>
</Layout>
