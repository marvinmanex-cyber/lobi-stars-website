---
// /fixtures -- Lobi Stars (or all NNL Conference D) fixtures. The list is
// filled in on the server from the league data (functions/fixtures/index.js),
// managed in Admin › League › Fixtures.
import Layout from '../../layouts/Layout.astro';
import MatchesTabs from '../../components/MatchesTabs.astro';
import MatchAlerts from '../../components/MatchAlerts.astro';
import LeagueRoot from '../../components/league/LeagueRoot.astro';
import { CURRENT_SEASON } from '../../lib/site';
---
<Layout title="Fixtures | Lobi Stars Football Club" description={`Lobi Stars FC fixtures for the ${CURRENT_SEASON} NNL Conference D season: dates, kick-off times, venues, tickets and calendar downloads.`}>
  <div class="page-hero wrap">
    <div class="stag">{CURRENT_SEASON} Season</div>
    <h1 class="stitle">Fix<span class="r">tures</span></h1>
    <MatchesTabs current="fixtures" />
  </div>
  <div class="page-content wrap">
    <LeagueRoot which="fixtures" />
    <MatchAlerts />
  </div>
</Layout>
