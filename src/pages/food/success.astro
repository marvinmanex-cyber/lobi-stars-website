---
// Older Paystack return address. Confirms the payment on the server and
// forwards the fan to their order status page (/food/order/).
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Your Food Order | Lobi Stars Football Club" description="Your Lobi Stars FC matchday food order." noindex>
  <div class="page-content wrap" style="max-width:640px;padding-top:60px;min-height:50vh;">
    <div class="stag">Please Wait</div>
    <h1 class="stitle">Confirming your <span class="r">payment…</span></h1>
    <p class="muted" id="msg">This usually takes a few seconds.</p>
  </div>
</Layout>
<script is:inline>
(async function () {
  const p = new URLSearchParams(location.search);
  const reference = p.get('reference') || p.get('trxref');
  const msg = document.getElementById('msg');
  if (!reference) { msg.textContent = 'No payment reference was provided.'; return; }
  try {
    const d = await (await fetch('/api/food-verify?reference=' + encodeURIComponent(reference))).json();
    if (d.redirect) { location.replace(d.redirect); return; }
    msg.textContent = d.error || 'Your order could not be found. If you were charged, contact the club with this reference: ' + reference;
  } catch { msg.textContent = 'Network problem. Please refresh this page.'; }
})();
</script>
