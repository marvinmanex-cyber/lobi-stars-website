---
import ProgrammeBanner from '../components/programme/ProgrammeBanner.astro';
import MatchBar from '../components/news/MatchBar.astro';
import FoodPromo from '../components/FoodPromo.astro';
import Layout from '../layouts/Layout.astro';
import NewsHero from '../components/news/NewsHero.astro';
import NextMatches from '../components/news/NextMatches.astro';
import NewsCarousel from '../components/news/NewsCarousel.astro';
import ShopCard from '../components/ShopCard.astro';
import PartnersShowcase from '../components/partners/PartnersShowcase.astro';
import LiveBanner from '../components/LiveBanner.astro';
import WhatsAppChannel from '../components/WhatsAppChannel.astro';
import HomeHero from '../components/HomeHero.astro';
import MatchdayGames from '../components/fans/MatchdayGames.astro';
import ClubAtAGlance from '../components/ClubAtAGlance.astro';
import NewsletterCta from '../components/NewsletterCta.astro';
import MatchAlerts from '../components/MatchAlerts.astro';
import { getSortedNews } from '../lib/news';
import shop from '../data/shop.json';
import { CURRENT_SEASON } from '../lib/site';

const news = await getSortedNews();
// With fewer than 3 published stories the news rows would look empty, so they're hidden.
const enoughNews = news.length >= 3;
const featuredNews = enoughNews ? news.filter(a => a.data.isFeatured).slice(0, 5) : [];
const videoNews = enoughNews ? news.filter(a => a.data.isVideo).slice(0, 12) : [];
// "Across the Club": community, partner and off-pitch stories, kept out of Latest News.
const clubNews = enoughNews ? news.filter(a => a.data.category === 'Club').slice(0, 12) : [];
const latestNews = enoughNews ? news.filter(a => !(clubNews.length && a.data.category === 'Club')).slice(0, 12) : [];
const shopHighlights = shop.products.filter(p => p.inStock).slice(0, 4);

const site = Astro.site!.toString().replace(/\/$/, '');
const teamJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsTeam',
  name: 'Lobi Stars Football Club',
  alternateName: 'Lobi Stars FC',
  sport: 'Soccer',
  url: `${site}/`,
  logo: `${site}/images/lobi-stars-fc-transparent.png`,
  image: `${site}/images/og-default.jpg`,
  location: {
    '@type': 'StadiumOrArena',
    name: 'McCarthy Stadium',
    address: { '@type': 'PostalAddress', addressLocality: 'Makurdi', addressRegion: 'Benue State', addressCountry: 'NG' },
  },
  sameAs: ['https://www.facebook.com/LobiStars', 'https://x.com/LobiStars', 'https://www.instagram.com/lobistarsfc'],
};
---
<Layout
  title="Lobi Stars Football Club | Pride of Benue"
  description="Official website of Lobi Stars FC of Makurdi, Benue State: fixtures, results, news, tickets, membership and the club shop."
  jsonLd={[teamJsonLd]}
>
  <LiveBanner />
  <!-- "FULL TIME" banner for 24 hours after a match: filled in on the server (functions/index.js). -->
  <div class="ftb" id="ftBanner" hidden></div>
  <HomeHero />
  <!-- One hero, then the next match as a slim bar and the programme as one line under it. -->
  <MatchBar />
  <ProgrammeBanner />

  <NewsHero articles={featuredNews} />
  <NextMatches />
  <!-- Matchday services: In-Seat Food Ordering, next to the matches it is for. -->
  <FoodPromo />
  <MatchAlerts variant="band" />
  <MatchdayGames />
  <NewsCarousel title="Latest News" articles={latestNews} viewAllHref="/news" />
  <WhatsAppChannel variant="band" />
  <NewsCarousel title="Video" articles={videoNews} viewAllHref="/video" viewAllLabel="All videos" tone="band" />
  <NewsCarousel title="Across the Club" articles={clubNews} viewAllHref="/news?category=club" viewAllLabel="All club news" />
  <NewsletterCta />

  <section class="hp-sec hp-sec--shop" aria-labelledby="shop-title">
    <div class="hp-inner">
      <div class="hp-head">
        <h2 class="hp-title" id="shop-title">Club Shop</h2>
        <a class="hp-more" href="/shop">Visit the shop <span aria-hidden="true">&rarr;</span></a>
      </div>
      <!-- Phones (under 768px): a swipe slider, one product at a time, with dots and arrows. Larger screens: the grid as before. -->
      <div class="hp-shop" id="hpShop" aria-roledescription="carousel" aria-label="Club shop products">
        {shopHighlights.map((p, i) => <div class="hp-slide" role="group" aria-roledescription="slide" aria-label={`Product ${i + 1} of ${shopHighlights.length}`}><ShopCard product={p} /></div>)}
      </div>
      <div class="hp-shop-nav" id="hpShopNav" hidden>
        <button type="button" class="hp-shop-arrow" id="hpShopPrev" aria-label="Previous product"><span aria-hidden="true">&#8249;</span></button>
        <div class="hp-shop-dots" id="hpShopDots"></div>
        <button type="button" class="hp-shop-arrow" id="hpShopNext" aria-label="Next product"><span aria-hidden="true">&#8250;</span></button>
      </div>
      <a class="hp-shop-cta" href="/shop">Visit the Shop <span aria-hidden="true">&rarr;</span></a>
    </div>
  </section>

  <ClubAtAGlance />

  <section class="hp-member" aria-labelledby="member-title">
    <div class="hp-inner hp-member-inner">
      <div>
        <p class="hp-kicker">Join the Red &amp; Gold family</p>
        <h2 class="hp-member-title" id="member-title">Official {CURRENT_SEASON} Membership</h2>
        <p class="hp-member-text">Members get a membership card, merchandise discounts, priority ticket access and the club newsletter.</p>
      </div>
      <a class="btn-p hp-member-btn" href="/membership">Become a member</a>
    </div>
  </section>

  <PartnersShowcase />
</Layout>

<style>
  .ftb { background: #15181D; color: #fff; padding: 10px 5%; text-align: center; font: 700 14px/1.4 'Barlow Condensed', sans-serif; letter-spacing: .8px; text-transform: uppercase; }
  .ftb :global(strong) { color: #FFC72C; margin-right: 6px; }
  .ftb :global(a) { color: #fff; text-decoration: underline; text-underline-offset: 3px; margin: 0 4px; }
  .ftb :global(a:hover), .ftb :global(a:focus-visible) { color: #FFC72C; }
  .ftb :global(.ftb-sep) { opacity: .5; }
  /* Speed: sections far below the fold are only laid out when the visitor scrolls near them. */
  :global(.ncar), .hp-sec, .hp-member, :global(.mgs), :global(.ps) { content-visibility: auto; contain-intrinsic-size: auto 560px; }
  .hp-sec { padding: 48px 0; }
  .hp-inner { max-width: 1280px; margin: 0 auto; padding: 0 5%; }
  .hp-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 22px; }
  .hp-title { margin: 0; font: 400 clamp(30px, 4vw, 42px)/1 'Bebas Neue', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: var(--white); }
  .hp-more { font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.2px; text-transform: uppercase; color: var(--red-text); text-decoration: none; white-space: nowrap; }
  .hp-more:hover, .hp-more:focus-visible { text-decoration: underline; }
  .hp-shop { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }

  .hp-member { background: linear-gradient(120deg, var(--rdp), var(--red)); color: #fff; padding: 52px 0; }
  .hp-member-inner { display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap; }
  .hp-kicker { margin: 0; color: #FFC72C; font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; }
  .hp-member-title { margin: 10px 0 8px; font: 400 clamp(32px, 4.4vw, 50px)/1 'Bebas Neue', sans-serif; letter-spacing: 1px; color: #fff; }
  .hp-member-text { margin: 0; max-width: 620px; font-size: 16px; line-height: 1.6; color: rgba(255, 255, 255, .88); }
  .hp-member-btn { background: #fff; color: var(--rdp); }
  .hp-member-btn:hover { background: #FFC72C; color: #15181D; }

    display: flex; align-items: center; justify-content: center; height: 96px; padding: 14px; border: 1px solid var(--d4);
    border-radius: 10px; background: #fff; transition: border-color .2s, box-shadow .2s;
  }

  @media (max-width: 1000px) { .hp-shop { grid-template-columns: repeat(2, 1fr); } }
  .hp-slide { display: flex; min-width: 0; }
  .hp-slide > :global(.pc) { flex: 1; }
  .hp-shop-nav, .hp-shop-cta { display: none; }
  /* Phones only: one product at a time (CSS scroll-snap; a little JS for the dots and arrows). */
  @media (max-width: 767px) {
    .hp-sec--shop .hp-inner { padding: 0 16px; }
    .hp-shop { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; overscroll-behavior-x: contain; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .hp-shop::-webkit-scrollbar { display: none; }
    .hp-slide { flex: 0 0 100%; scroll-snap-align: center; scroll-snap-stop: always; }
    .hp-shop-nav:not([hidden]) { display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 14px; }
    .hp-shop-arrow { width: 44px; height: 44px; flex: none; border-radius: 50%; border: 1.5px solid var(--d4); background: var(--d2); color: var(--white); font: 400 28px/1 'Barlow', sans-serif; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
    .hp-shop-arrow:disabled { opacity: .35; cursor: default; }
    .hp-shop-arrow:focus-visible, .hp-shop-dots :global(button:focus-visible) { outline: 3px solid var(--red); outline-offset: 2px; }
    .hp-shop-dots { display: flex; gap: 2px; }
    .hp-shop-dots :global(button) { width: 28px; height: 44px; border: 0; background: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; padding: 0; }
    .hp-shop-dots :global(button::before) { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--d4); transition: background .2s, transform .2s; }
    .hp-shop-dots :global(button[aria-current="true"]::before) { background: #C11A1F; transform: scale(1.2); }
    .hp-shop-cta { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; margin-top: 12px; border-radius: 8px; background: #C11A1F; color: #fff; text-decoration: none; font: 700 15px/1 'Barlow Condensed', sans-serif; letter-spacing: .1em; text-transform: uppercase; }
    .hp-shop-cta:hover, .hp-shop-cta:focus-visible { background: #A3161B; }
  }
  @media (max-width: 767px) and (prefers-reduced-motion: reduce) { .hp-shop { scroll-behavior: auto; } }
</style>

<script is:inline>
// Club Shop slider on phones: dots (tap to jump, follow the swipe) and arrows (off at the ends).
(function () {
  var track = document.getElementById('hpShop'), nav = document.getElementById('hpShopNav');
  if (!track || !nav) return;
  var slides = Array.prototype.slice.call(track.querySelectorAll('.hp-slide'));
  var dotsBox = document.getElementById('hpShopDots'), prev = document.getElementById('hpShopPrev'), next = document.getElementById('hpShopNext');
  var phone = window.matchMedia('(max-width: 767px)'), reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (slides.length < 2) return;
  var current = 0;
  var dots = slides.map(function (s, i) {
    var b = document.createElement('button'); b.type = 'button'; b.setAttribute('aria-label', 'Show product ' + (i + 1) + ' of ' + slides.length);
    b.addEventListener('click', function () { go(i); }); dotsBox.append(b); return b;
  });
  function show(i) { current = i; dots.forEach(function (d, k) { d.setAttribute('aria-current', String(k === i)); }); prev.disabled = i === 0; next.disabled = i === slides.length - 1; }
  function go(i) { i = Math.max(0, Math.min(slides.length - 1, i)); track.scrollTo({ left: slides[i].offsetLeft - track.offsetLeft, behavior: reduce.matches ? 'auto' : 'smooth' }); show(i); }
  prev.addEventListener('click', function () { go(current - 1); });
  next.addEventListener('click', function () { go(current + 1); });
  var io = 'IntersectionObserver' in window ? new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting && e.intersectionRatio > .6) show(slides.indexOf(e.target)); }); }, { root: track, threshold: [.6] }) : null;
  function apply() { nav.hidden = !phone.matches; if (phone.matches) { slides.forEach(function (s) { io && io.observe(s); }); show(current); } else if (io) io.disconnect(); }
  if (phone.addEventListener) phone.addEventListener('change', apply);
  apply();
})();
</script>
