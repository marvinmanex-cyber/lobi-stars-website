---
import Layout from '../layouts/Layout.astro';
import NewsHero from '../components/news/NewsHero.astro';
import NextMatches from '../components/news/NextMatches.astro';
import NewsCarousel from '../components/news/NewsCarousel.astro';
import ShopCard from '../components/ShopCard.astro';
import PartnersShowcase from '../components/partners/PartnersShowcase.astro';
import LiveBanner from '../components/LiveBanner.astro';
import WhatsAppChannel from '../components/WhatsAppChannel.astro';
import MatchdayGames from '../components/fans/MatchdayGames.astro';
import { getSortedNews } from '../lib/news';
import shop from '../data/shop.json';
import { CURRENT_SEASON } from '../lib/site';

const news = await getSortedNews();
// With fewer than 3 published stories the news rows would look empty, so they're hidden.
const enoughNews = news.length >= 3;
const featuredNews = enoughNews ? news.filter(a => a.data.isFeatured).slice(0, 5) : [];
const videoNews = enoughNews ? news.filter(a => a.data.isVideo).slice(0, 12) : [];
// "Across the Club": community, partner and off-pitch stories, kept out of Latest News.
const clubNews = enoughNews ? news.filter(a => a.data.category === 'Club').slice(0, 12) : [];
const latestNews = enoughNews ? news.filter(a => !(clubNews.length && a.data.category === 'Club')).slice(0, 12) : [];
const shopHighlights = shop.products.filter(p => p.inStock).slice(0, 4);

const site = Astro.site!.toString().replace(/\/$/, '');
const teamJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsTeam',
  name: 'Lobi Stars Football Club',
  alternateName: 'Lobi Stars FC',
  sport: 'Soccer',
  url: `${site}/`,
  logo: `${site}/images/lobi-stars-fc.jpg`,
  image: `${site}/images/og-default.jpg`,
  location: {
    '@type': 'StadiumOrArena',
    name: 'McCarthy Stadium',
    address: { '@type': 'PostalAddress', addressLocality: 'Makurdi', addressRegion: 'Benue', addressCountry: 'NG' },
  },
  sameAs: ['https://www.facebook.com/LobiStars', 'https://x.com/LobiStars', 'https://www.instagram.com/lobistarsfc'],
};
---
<Layout
  title="Lobi Stars Football Club | Pride of Benue"
  description="Official website of Lobi Stars FC of Makurdi, Benue State: fixtures, results, news, tickets, membership and the club shop."
  jsonLd={[teamJsonLd]}
>
  <LiveBanner />
  <!-- "FULL TIME" banner for 24 hours after a match: filled in on the server (functions/index.js). -->
  <div class="ftb" id="ftBanner" hidden></div>
  <h1 class="sr-only">Lobi Stars Football Club &ndash; official website</h1>

  <NewsHero articles={featuredNews} />
  <NextMatches />
  <MatchdayGames />
  <NewsCarousel title="Latest News" articles={latestNews} viewAllHref="/news" />
  <WhatsAppChannel variant="band" />
  <NewsCarousel title="Video" articles={videoNews} viewAllHref="/video" viewAllLabel="All videos" tone="band" />
  <NewsCarousel title="Across the Club" articles={clubNews} viewAllHref="/news?category=club" viewAllLabel="All club news" />

  <section class="hp-sec" aria-labelledby="shop-title">
    <div class="hp-inner">
      <div class="hp-head">
        <h2 class="hp-title" id="shop-title">Club Shop</h2>
        <a class="hp-more" href="/shop">Visit the shop <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="hp-shop">
        {shopHighlights.map(p => <ShopCard product={p} />)}
      </div>
    </div>
  </section>

  <section class="hp-member" aria-labelledby="member-title">
    <div class="hp-inner hp-member-inner">
      <div>
        <p class="hp-kicker">Join the Red &amp; Gold family</p>
        <h2 class="hp-member-title" id="member-title">Official {CURRENT_SEASON} Membership</h2>
        <p class="hp-member-text">Members get a membership card, merchandise discounts, priority ticket access and the club newsletter.</p>
      </div>
      <a class="btn-p hp-member-btn" href="/membership">Become a member</a>
    </div>
  </section>

  <PartnersShowcase />
</Layout>

<style>
  .ftb { background: #15181D; color: #fff; padding: 10px 5%; text-align: center; font: 700 14px/1.4 'Barlow Condensed', sans-serif; letter-spacing: .8px; text-transform: uppercase; }
  .ftb :global(strong) { color: #FFC72C; margin-right: 6px; }
  .ftb :global(a) { color: #fff; text-decoration: underline; text-underline-offset: 3px; margin: 0 4px; }
  .ftb :global(a:hover), .ftb :global(a:focus-visible) { color: #FFC72C; }
  .ftb :global(.ftb-sep) { opacity: .5; }
  /* Speed: sections far below the fold are only laid out when the visitor scrolls near them. */
  :global(.ncar), .hp-sec, .hp-member, :global(.mgs), :global(.ps) { content-visibility: auto; contain-intrinsic-size: auto 560px; }
  .hp-sec { padding: 48px 0; }
  .hp-inner { max-width: 1280px; margin: 0 auto; padding: 0 5%; }
  .hp-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 22px; }
  .hp-title { margin: 0; font: 400 clamp(30px, 4vw, 42px)/1 'Bebas Neue', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: var(--white); }
  .hp-more { font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.2px; text-transform: uppercase; color: var(--red-text); text-decoration: none; white-space: nowrap; }
  .hp-more:hover, .hp-more:focus-visible { text-decoration: underline; }
  .hp-shop { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }

  .hp-member { background: linear-gradient(120deg, var(--rdp), var(--red)); color: #fff; padding: 52px 0; }
  .hp-member-inner { display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap; }
  .hp-kicker { margin: 0; color: #FFC72C; font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; }
  .hp-member-title { margin: 10px 0 8px; font: 400 clamp(32px, 4.4vw, 50px)/1 'Bebas Neue', sans-serif; letter-spacing: 1px; color: #fff; }
  .hp-member-text { margin: 0; max-width: 620px; font-size: 16px; line-height: 1.6; color: rgba(255, 255, 255, .88); }
  .hp-member-btn { background: #fff; color: var(--rdp); }
  .hp-member-btn:hover { background: #FFC72C; color: #15181D; }

    display: flex; align-items: center; justify-content: center; height: 96px; padding: 14px; border: 1px solid var(--d4);
    border-radius: 10px; background: #fff; transition: border-color .2s, box-shadow .2s;
  }

  @media (max-width: 1000px) { .hp-shop { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .hp-shop { gap: 12px; } }
</style>
