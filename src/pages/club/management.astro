---
import Layout from '../../layouts/Layout.astro';
import PersonCard from '../../components/PersonCard.astro';
import { getCollection } from 'astro:content';

const staff = (await getCollection('staff')).sort((a, b) => a.data.order - b.data.order);
const groups = (['Management', 'Coaching Staff'] as const)
  .map(g => ({ title: g, people: staff.filter(s => s.data.group === g) }))
  .filter(g => g.people.length);
---
<Layout title="Club Management | Lobi Stars Football Club" description="Meet the management and coaching staff of Lobi Stars Football Club.">
  <div class="page-hero wrap">
    <div class="stag">The Club</div>
    <h1 class="stitle">Club <span class="r">Management</span></h1>
    <div class="divr"></div>
  </div>
  <div class="page-content wrap">
    {groups.length === 0 && <div class="empty-state">Management profiles are coming soon.</div>}
    {groups.map(g => (
      <section class="mg-group" aria-labelledby={`mg-${g.title}`}>
        <h2 class="mg-title" id={`mg-${g.title}`}>{g.title}</h2>
        <ul class="mg-grid">
          {g.people.map(s => (
            <li>
              <PersonCard name={s.data.name} subtitle={s.data.role} photo={s.data.photo} />
              {s.data.bio && <p class="mg-bio">{s.data.bio}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Layout>

<style>
  .mg-group { margin-bottom: 44px; }
  .mg-title { margin: 0 0 18px; padding-bottom: 10px; border-bottom: 2px solid var(--d4); font: 400 32px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .mg-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 18px; }
  .mg-bio { margin: 10px 2px 0; color: var(--lt); font-size: 14px; line-height: 1.5; }
</style>
