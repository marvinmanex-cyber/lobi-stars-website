---
// /scores-centre/ -- the Scores Update Centre: NNL Conference D fixtures week by week, where staff
// update scores during games; each update changes the league table at once. Signed in with the
// shared access code and the person's name (functions/api/_lib/scoresCentre.js). Not linked from
// the public site, never indexed. Lobi Stars colours: blue #4C76B2, white, red #EE343C.
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="same-origin" />
  <meta name="theme-color" content="#4C76B2" />
  <title>Scores Update Centre | Lobi Stars FC</title>
  <link rel="icon" href="/images/lobi-stars-badge.png" />
  <link rel="manifest" href="/scores-centre/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/images/scores-centre/icon-192.png" />
  <style is:global>
    @font-face { font-family: 'Bebas Neue'; font-weight: 400; font-display: swap; src: url('/fonts/bebas-neue-400.woff2') format('woff2'); }
    @font-face { font-family: 'Barlow'; font-weight: 400; font-display: swap; src: url('/fonts/barlow-400.woff2') format('woff2'); }
    @font-face { font-family: 'Barlow'; font-weight: 600; font-display: swap; src: url('/fonts/barlow-600.woff2') format('woff2'); }
    @font-face { font-family: 'Barlow'; font-weight: 700; font-display: swap; src: url('/fonts/barlow-700.woff2') format('woff2'); }
    :root { --blue: #4C76B2; --blue-d: #2F4F80; --navy: #0F1E36; --red: #EE343C; --red-d: #C8202A; --ink: #14202E; --muted: #5E6B7A; --line: #DCE3EC; --bg: #F2F5F9; --card: #fff; --green: #138A3E; --amber: #B26A00; }
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    html, body { overflow-x: hidden; }
    body { margin: 0; background: var(--bg); color: var(--ink); font: 16px/1.45 'Barlow', Arial, sans-serif; -webkit-text-size-adjust: 100%; }
    button, input, select { font: inherit; }
    .h { font-family: 'Bebas Neue', Impact, sans-serif; font-weight: 400; letter-spacing: .5px; }

    /* Sign in */
    .si { min-height: 100vh; display: grid; place-items: center; padding: 24px 16px; background: linear-gradient(160deg, var(--navy), var(--blue-d) 60%, var(--blue)); }
    .si-box { width: 100%; max-width: 400px; }
    .si-brand { text-align: center; color: #fff; margin-bottom: 18px; }
    .si-brand img { width: 84px; height: 84px; }
    .si-brand p { margin: 6px 0 0; opacity: .85; }
    .si-brand h1 { margin: 2px 0 0; font-size: 42px; line-height: 1; }
    .card { background: var(--card); border-radius: 16px; padding: 20px; box-shadow: 0 10px 30px rgba(15, 30, 54, .12); }
    .field { margin: 0 0 14px; }
    .field label { display: block; font-weight: 600; margin-bottom: 6px; }
    .field input { width: 100%; min-height: 50px; border: 1.5px solid var(--line); border-radius: 10px; padding: 0 14px; font-size: 18px; }
    .field input:focus { outline: 3px solid rgba(76, 118, 178, .35); border-color: var(--blue); }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 0 18px; border-radius: 10px; border: 0; cursor: pointer; font-weight: 700; }
    .btn-red { background: var(--red); color: #fff; }
    .btn-red:hover { background: var(--red-d); }
    .btn-red:disabled { background: #E9B9BC; cursor: default; }
    .btn-ghost { background: transparent; color: var(--blue-d); border: 1.5px solid var(--line); }
    .wide { width: 100%; }
    .alert { background: #FDECEC; color: #8F1C22; border-radius: 10px; padding: 10px 12px; margin: 0 0 14px; }
    .small { color: var(--muted); font-size: 14px; }

    /* Top bar */
    .top { position: sticky; top: 0; z-index: 5; background: linear-gradient(90deg, var(--navy), var(--blue-d)); color: #fff; padding: 10px 16px; display: flex; align-items: center; gap: 12px; }
    .top img { width: 40px; height: 40px; }
    .top .t { line-height: 1.05; min-width: 0; }
    .top .t b { display: block; font-family: 'Bebas Neue', Impact, sans-serif; font-weight: 400; font-size: 24px; letter-spacing: .5px; }
    .top .t span { font-size: 13px; opacity: .85; }
    .top .me { margin-left: auto; display: flex; align-items: center; gap: 10px; font-size: 14px; }
    .top .me button { min-height: 38px; padding: 0 12px; border-radius: 8px; border: 1px solid rgba(255, 255, 255, .4); background: transparent; color: #fff; cursor: pointer; font-weight: 600; }
    @media (max-width: 560px) { .top .me span { display: none; } }

    main { max-width: 1180px; margin: 0 auto; padding: 16px; display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 18px; align-items: start; }
    @media (max-width: 960px) { main { grid-template-columns: minmax(0, 1fr); } }
    main > * { min-width: 0; }

    /* Weeks */
    .weeks { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
    .weeks .arrow { flex: none; width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid var(--line); background: #fff; cursor: pointer; font-size: 20px; color: var(--blue-d); }
    .weeks .arrow:disabled { opacity: .35; cursor: default; }
    .chips { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 2px; flex: 1; min-width: 0; }
    .chips::-webkit-scrollbar { display: none; }
    .chip { flex: none; min-height: 40px; padding: 0 14px; border-radius: 999px; border: 1.5px solid var(--line); background: #fff; cursor: pointer; font-weight: 600; color: var(--ink); }
    .chip[aria-current="true"] { background: var(--blue); border-color: var(--blue); color: #fff; }
    .week-h { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin: 4px 0 10px; }
    .week-h h2 { margin: 0; font-size: 34px; line-height: 1; }

    /* Match cards */
    .match { background: var(--card); border-radius: 14px; padding: 14px; margin-bottom: 12px; border: 1.5px solid transparent; box-shadow: 0 2px 10px rgba(15, 30, 54, .06); }
    .match.dirty { border-color: var(--red); }
    .match.lobi { box-shadow: inset 4px 0 0 var(--blue), 0 2px 10px rgba(15, 30, 54, .06); }
    .m-meta { display: flex; justify-content: space-between; gap: 8px; font-size: 13px; color: var(--muted); margin-bottom: 10px; }
    .m-row { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 8px; }
    .team { display: flex; align-items: center; gap: 8px; min-width: 0; font-weight: 700; }
    .team.away { flex-direction: row-reverse; text-align: right; }
    .team img { width: 34px; height: 34px; object-fit: contain; flex: none; }
    .team span { overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.15; }
    .score { display: flex; align-items: center; gap: 6px; }
    .step { display: flex; flex-direction: column; align-items: center; gap: 4px; }
    .step button { width: 40px; height: 34px; border-radius: 8px; border: 1.5px solid var(--line); background: #fff; cursor: pointer; font-size: 20px; line-height: 1; color: var(--blue-d); }
    .step output { font-family: 'Bebas Neue', Impact, sans-serif; font-size: 44px; line-height: .9; min-width: 40px; text-align: center; }
    .dash { font-family: 'Bebas Neue', Impact, sans-serif; font-size: 30px; color: var(--muted); }
    .statuses { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 0; }
    .st { min-height: 38px; padding: 0 12px; border-radius: 999px; border: 1.5px solid var(--line); background: #fff; cursor: pointer; font-size: 14px; font-weight: 600; }
    .st[aria-pressed="true"] { background: var(--navy); border-color: var(--navy); color: #fff; }
    .st[data-s="LIVE"][aria-pressed="true"] { background: var(--red); border-color: var(--red); }
    .st[data-s="HALF_TIME"][aria-pressed="true"] { background: var(--amber); border-color: var(--amber); }
    .st[data-s="FULL_TIME"][aria-pressed="true"] { background: var(--green); border-color: var(--green); }
    .m-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 12px; flex-wrap: wrap; }
    .m-foot .info { font-size: 13px; color: var(--muted); }
    .m-foot .info b { color: var(--ink); }
    .ok { color: var(--green); font-weight: 700; }
    .warn { color: var(--amber); font-weight: 700; }
    .m-actions { display: flex; gap: 8px; margin-left: auto; }
    .link { background: none; border: 0; color: var(--blue-d); text-decoration: underline; cursor: pointer; padding: 0 6px; min-height: 40px; }
    .live-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--red); margin-right: 5px; animation: blink 1.2s infinite; }
    @keyframes blink { 50% { opacity: .2; } }
    @media (prefers-reduced-motion: reduce) { .live-dot { animation: none; } }

    /* Table */
    aside .card { padding: 14px; }
    aside h2 { margin: 0 0 4px; font-size: 30px; line-height: 1; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th { text-align: left; font-size: 12px; color: var(--muted); font-weight: 600; padding: 6px 4px; border-bottom: 1.5px solid var(--line); }
    td { padding: 7px 4px; border-bottom: 1px solid var(--line); }
    td.n, th.n { text-align: center; }
    tr.lobi td { background: #EAF1FB; font-weight: 700; }
    .tteam { display: flex; align-items: center; gap: 6px; }
    .tteam img { width: 20px; height: 20px; object-fit: contain; }
    .mv { font-size: 11px; margin-left: 2px; }
    .mv.up { color: var(--green); } .mv.down { color: var(--red); }
    .recent { list-style: none; margin: 0; padding: 0; font-size: 13px; }
    .recent li { padding: 6px 0; border-bottom: 1px solid var(--line); }
    .recent time { color: var(--muted); margin-right: 6px; }
    .toast { position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%); background: var(--navy); color: #fff; padding: 12px 18px; border-radius: 12px; max-width: calc(100% - 32px); box-shadow: 0 8px 24px rgba(0, 0, 0, .25); z-index: 20; }
    .toast.err { background: var(--red-d); }
    .chip-live { display: inline-flex; align-items: center; gap: 4px; }
    .chip-live[aria-current="true"] { background: var(--red); border-color: var(--red); }
    .chip-live[aria-current="true"] .live-dot { background: #fff; }
    .online { font-size: 13px; color: var(--muted); margin: -4px 0 10px; min-height: 18px; }
    .on-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--green); margin-right: 6px; }
    .net { position: sticky; top: 60px; z-index: 4; background: #FFF4D6; color: #6B4A00; border-radius: 10px; padding: 8px 12px; margin-bottom: 10px; font-weight: 600; font-size: 14px; }
    .net.off { background: #FDECEC; color: #8F1C22; }
    .m-tags { display: flex; flex-wrap: wrap; gap: 6px; margin: -4px 0 8px; min-height: 0; }
    .m-tags:empty { display: none; }
    .clock, .sync, .cover { display: inline-flex; align-items: center; min-height: 26px; padding: 0 10px; border-radius: 999px; font-size: 13px; font-weight: 700; background: #EEF2F7; color: var(--ink); }
    .clock.on { background: #FDECEC; color: var(--red-d); }
    .sync.ok { background: #E7F6EC; color: var(--green); }
    .sync.wait { background: #FFF4D6; color: #6B4A00; }
    .sync.dirty { background: #FDECEC; color: var(--red-d); }
    .cover { background: #EAF1FB; color: var(--blue-d); }
    .cover.me { background: var(--blue); color: #fff; }
    .evs { list-style: none; margin: 10px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2px 12px; font-size: 14px; }
    .evs li.away { text-align: right; grid-column: 2; }
    .evs li.home { grid-column: 1; }
    .evs.edit { display: block; }
    .evs.edit li { padding: 4px 0; text-align: left; }
    .note { margin: 8px 0 0; font-size: 14px; background: #FFF9E8; border-radius: 8px; padding: 6px 10px; }
    .panel { margin-top: 12px; border-top: 1.5px dashed var(--line); padding-top: 10px; }
    .panel h3 { margin: 12px 0 6px; font-size: 15px; }
    .evf { display: flex; flex-wrap: wrap; gap: 6px; }
    .evf select, .evf input { min-height: 44px; border: 1.5px solid var(--line); border-radius: 10px; padding: 0 10px; background: #fff; max-width: 100%; }
    .evf input[name="player"], .evf input[name="note"] { flex: 1 1 160px; }
    .evf input[name="minute"] { width: 70px; }
    .row-btns { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .btn-ghost { min-height: 44px; }
    .x { border: 0; background: #FDECEC; color: var(--red-d); width: 30px; height: 30px; border-radius: 8px; cursor: pointer; margin-left: 6px; }
    .hist { list-style: none; margin: 0 0 8px; padding: 0; font-size: 13px; }
    .hist li { padding: 5px 0; border-bottom: 1px solid var(--line); color: var(--muted); }
    .hist li.act { color: var(--ink); }
    .hist time { margin-right: 4px; }
    .top .me .inst { background: #fff; color: var(--blue-d); border-color: #fff; }
    .awake { font-size: 12px; opacity: .8; }
  </style>
</head>
<body>
  <section class="si" id="si" hidden>
    <div class="si-box">
      <div class="si-brand">
        <img src="/images/lobi-stars-badge.webp" alt="Lobi Stars FC badge" width="84" height="84" />
        <p>Lobi Stars FC</p>
        <h1 class="h">Scores Update Centre</h1>
        <p>NNL Conference D · live scores and table</p>
      </div>
      <form class="card" id="siForm" novalidate>
        <p class="alert" id="siMsg" role="alert" hidden></p>
        <div class="field"><label for="siName">Your name</label><input id="siName" autocomplete="name" maxlength="60" required /></div>
        <div class="field"><label for="siCode">Access code</label><input id="siCode" type="password" inputmode="numeric" autocomplete="off" maxlength="12" required /></div>
        <button class="btn btn-red wide" type="submit">Sign in</button>
        <p class="small" style="margin:12px 0 0">You stay signed in until 2 hours pass without using the page. Every score you update is recorded with your name.</p>
      </form>
    </div>
  </section>

  <div id="app" hidden>
    <header class="top">
      <img src="/images/lobi-stars-badge.webp" alt="" width="40" height="40" />
      <div class="t"><b>Scores Update Centre</b><span id="comp">NNL Conference D</span></div>
      <div class="me"><span class="awake" id="awake" hidden title="The screen stays on while this page is open">☀ Screen on</span><span id="me"></span><button type="button" class="inst" id="install" hidden>Install app</button><button type="button" id="out">Sign out</button></div>
    </header>
    <main>
      <section aria-labelledby="wkH">
        <nav class="weeks" aria-label="Weeks">
          <button class="arrow" type="button" id="prev" aria-label="Previous week">‹</button>
          <div class="chips" id="chips"></div>
          <button class="arrow" type="button" id="next" aria-label="Next week">›</button>
        </nav>
        <div class="week-h"><h2 class="h" id="wkH">Week</h2><span class="small" id="wkSub"></span></div>
        <p class="online" id="online"></p>
        <p class="net" id="net" role="status" hidden></p>
        <div id="matches"></div>
      </section>
      <aside>
        <div class="card">
          <h2 class="h">League table</h2>
          <p class="small" id="tSub" style="margin:0 0 8px"></p>
          <div style="overflow-x:auto"><table><thead><tr><th class="n">#</th><th>Team</th><th class="n">P</th><th class="n">W</th><th class="n">D</th><th class="n">L</th><th class="n">GD</th><th class="n">Pts</th></tr></thead><tbody id="tbl"></tbody></table></div>
        </div>
        <div class="card" style="margin-top:14px">
          <h2 class="h" style="font-size:24px">Recent updates</h2>
          <ul class="recent" id="recent"></ul>
        </div>
      </aside>
    </main>
  </div>
  <div class="toast" id="toast" role="status" hidden></div>

  <script is:inline>
  (function () {
    var $ = function (id) { return document.getElementById(id); };
    var csrf = '', week = null, data = null, dirty = {}, openPanel = {}, hist = {}, busy = false, skew = 0, kinds = {};
    var LABEL = { SCHEDULED: 'Not started', LIVE: 'Live', HALF_TIME: 'Half-time', FULL_TIME: 'Full time', POSTPONED: 'Postponed', ABANDONED: 'Abandoned', CANCELLED: 'Cancelled' };
    var ORDER = ['SCHEDULED', 'LIVE', 'HALF_TIME', 'FULL_TIME', 'POSTPONED', 'ABANDONED', 'CANCELLED'];
    var ICON = { goal: '⚽', pen: '⚽ (pen)', og: '⚽ (og)', red: '🟥' };
    var QKEY = 'sc_queue';
    var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
    var lagos = function (iso, opts) { try { return new Date(iso).toLocaleString('en-GB', Object.assign({ timeZone: 'Africa/Lagos' }, opts)); } catch (e) { return ''; } };
    var hm = function (iso) { return lagos(String(iso).indexOf('T') > 0 ? iso : String(iso).replace(' ', 'T') + 'Z', { hour: '2-digit', minute: '2-digit' }); };
    var now = function () { return Date.now() + skew; };
    var toastT;
    function toast(msg, err) { var t = $('toast'); t.textContent = msg; t.className = 'toast' + (err ? ' err' : ''); t.hidden = false; clearTimeout(toastT); toastT = setTimeout(function () { t.hidden = true; }, err ? 7000 : 3500); }

    // ── Talking to the website ──
    // send(): { ok, status, d }; throws only when there is no connection.
    async function send(path, body) {
      var r = await fetch('/api/scores-centre/' + path, body ? { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf }, body: JSON.stringify(body) } : { cache: 'no-store' });
      var d = await r.json().catch(function () { return {}; });
      if (r.status === 401 && d.signedOut) { showSignIn('You were signed out (2 hours without activity). Please sign in again.'); throw new Error('signed out'); }
      return { ok: r.ok, status: r.status, d: d };
    }
    async function api(path, body) { var r = await send(path, body); if (!r.ok) throw new Error(r.d.error || 'Something went wrong. Please try again.'); return r.d; }

    // ── Updates waiting for the network (kept on this phone) ──
    var queue = []; try { queue = JSON.parse(localStorage.getItem(QKEY) || '[]'); } catch (e) { queue = []; }
    var saveQueue = function () { try { localStorage.setItem(QKEY, JSON.stringify(queue)); } catch (e) {} drawNet(); };
    var queued = function (id) { return queue.some(function (q) { return q.body.fixtureId === id; }); };
    function drawNet() {
      var n = queue.length, el = $('net');
      el.hidden = !n && navigator.onLine;
      el.textContent = !navigator.onLine ? (n ? 'No network · ' + n + ' update' + (n === 1 ? '' : 's') + ' waiting on this phone' : 'No network') : n ? 'Sending ' + n + ' waiting update' + (n === 1 ? '' : 's') + '…' : '';
      el.className = 'net' + (navigator.onLine ? '' : ' off');
    }
    async function flush() {
      if (!queue.length || !navigator.onLine || !csrf) return drawNet();
      while (queue.length) {
        var q = queue[0], r;
        try { r = await send('update', q.body); } catch (e) { return drawNet(); }
        queue.shift(); saveQueue();
        if (r.status === 409) toast('Not sent: ' + q.label + '. ' + (r.d.current ? r.d.current.by + ' changed it while you had no network. Check it and update again.' : ''), true);
        else if (!r.ok) toast('Not sent: ' + q.label + '. ' + (r.d.error || ''), true);
        else toast('Sent: ' + q.label + '. The table is updated.');
      }
      if (data) load().catch(function () {});
    }
    window.addEventListener('online', function () { drawNet(); flush(); });
    window.addEventListener('offline', drawNet);
    setInterval(flush, 15000);

    // ── Sign in / out ──
    function showSignIn(msg) { $('app').hidden = true; $('si').hidden = false; $('siMsg').hidden = !msg; if (msg) $('siMsg').textContent = msg; try { $('siName').value = localStorage.getItem('sc_name') || ''; } catch (e) {} ($('siName').value ? $('siCode') : $('siName')).focus(); }
    $('siForm').addEventListener('submit', async function (e) {
      e.preventDefault();
      var b = this.querySelector('button'); b.disabled = true;
      try {
        var r = await fetch('/api/scores-centre/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: $('siName').value, code: $('siCode').value }) });
        var d = await r.json().catch(function () { return {}; });
        if (!r.ok) throw new Error(d.error || 'Could not sign in.');
        try { localStorage.setItem('sc_name', $('siName').value.trim()); } catch (e2) {}
        $('siCode').value = '';
        await start();
      } catch (err) { $('siMsg').hidden = false; $('siMsg').textContent = err.message === 'Failed to fetch' ? 'No network. Try again when you have signal.' : err.message; }
      b.disabled = false;
    });
    $('out').addEventListener('click', async function () {
      if (queue.length && !confirm(queue.length + ' update(s) are still waiting for the network and will be lost if you sign out. Sign out anyway?')) return;
      try { await api('logout', {}); } catch (e) {}
      queue = []; saveQueue(); showSignIn('You are signed out.');
    });
    async function start() {
      var s;
      try { s = await fetch('/api/scores-centre/session', { cache: 'no-store' }); } catch (e) { $('si').hidden = false; $('siMsg').hidden = false; $('siMsg').textContent = 'No network. The page will work again when you have signal.'; return; }
      if (!s.ok) return showSignIn('');
      var d = await s.json(); csrf = d.csrf; kinds = d.eventKinds || {}; $('me').textContent = d.name;
      $('si').hidden = true; $('app').hidden = false;
      wake();
      await load();
      flush();
    }

    // ── The week ──
    async function load(w) {
      if (w !== undefined) { week = w; dirty = {}; openPanel = {}; hist = {}; }
      data = await api('week' + (week ? '?week=' + week : ''));
      skew = Date.parse(data.serverTime) - Date.now();
      week = data.week;
      draw();
    }
    function chipScroll() { var box = $('chips'), c = box.querySelector('[aria-current="true"]'); if (c) box.scrollLeft = c.offsetLeft - box.offsetLeft - (box.clientWidth - c.offsetWidth) / 2; }
    function draw() {
      $('comp').textContent = data.competition || 'NNL Conference D';
      $('chips').innerHTML = '<button class="chip chip-live" type="button" data-week="live" aria-current="' + (week === 'live') + '"><i class="live-dot"></i>Live now</button>'
        + data.weeks.map(function (n) { return '<button class="chip" type="button" data-week="' + n + '" aria-current="' + (n === week) + '">Week ' + n + '</button>'; }).join('');
      var i = week === 'live' ? -1 : data.weeks.indexOf(week);
      $('prev').disabled = week === 'live' || i <= 0; $('next').disabled = week !== 'live' && (i < 0 || i >= data.weeks.length - 1);
      chipScroll();
      $('wkH').textContent = week === 'live' ? 'Live now' : 'Week ' + week;
      var ko = data.matches.map(function (m) { return m.kickoff; }).filter(Boolean).sort()[0];
      $('wkSub').textContent = week === 'live' ? "Today's matches, live first" : ko ? lagos(ko, { weekday: 'short', day: 'numeric', month: 'short' }) : '';
      $('online').innerHTML = data.online && data.online.length ? '<i class="on-dot"></i>Online now: ' + data.online.map(esc).join(', ') : '';
      drawMatches(); drawTable(); drawNet();
    }
    function cur(m) { return dirty[m.id] || { home: m.homeGoals, away: m.awayGoals, status: m.status }; }
    // The match clock: from kick-off (or when staff said it kicked off) and the second-half start.
    function clock(m, status) {
      if (status === 'HALF_TIME') return 'HT';
      if (status === 'FULL_TIME') return 'FT';
      if (status !== 'LIVE') return '';
      var t = now();
      if (m.secondHalfAt) { var n2 = 46 + Math.floor((t - Date.parse(m.secondHalfAt)) / 60000); return (n2 > 90 ? '90+' + (n2 - 90) : Math.max(46, n2)) + "'"; }
      var n = 1 + Math.floor((t - Date.parse(m.kickedOffAt || m.kickoff)) / 60000);
      if (!(n >= 1)) n = 1;
      return (n > 45 ? '45+' + Math.min(n - 45, 30) : n) + "'";
    }
    function minuteNow(m) { var c = clock(m, cur(m).status); return c && /\d/.test(c) ? c.replace("'", '') : ''; }
    var teamName = function (m, side) { return (side === 'home' ? m.home : m.away) || { name: '?' }; };
    function drawMatches() {
      if (!data.matches.length) {
        $('matches').innerHTML = '<div class="card">' + (week === 'live' ? 'No matches today. <button type="button" class="link" data-week="' + data.liveRound + '">Open Week ' + data.liveRound + '</button>' : 'No matches in this week.') + '</div>';
        return;
      }
      $('matches').innerHTML = data.matches.map(function (m) {
        var c = cur(m), isDirty = !!dirty[m.id], wait = queued(m.id);
        var num = function (v) { return v == null ? '–' : v; };
        var side = function (t, cls) { return '<div class="team ' + cls + '">' + (t && t.crest ? '<img src="' + esc(t.crest) + '" alt="" loading="lazy" />' : '') + '<span>' + esc(t ? t.name : '?') + '</span></div>'; };
        var stepper = function (which, v) { return '<div class="step"><button type="button" data-inc="' + which + '" aria-label="Add a goal for ' + esc(teamName(m, which).name) + '">+</button><output>' + num(v) + '</output><button type="button" data-dec="' + which + '" aria-label="Take a goal away from ' + esc(teamName(m, which).name) + '">−</button></div>'; };
        var ck = clock(m, c.status);
        var badge = ck ? '<span class="clock' + (c.status === 'LIVE' ? ' on' : '') + '" data-clock="' + m.id + '">' + (c.status === 'LIVE' ? '<i class="live-dot"></i>' : '') + ck + '</span>' : '';
        var sync = wait ? '<span class="sync wait">⏳ Waiting for network</span>' : isDirty ? '<span class="sync dirty">Not saved yet</span>' : m.updatedAt && now() - Date.parse(m.updatedAt) < 90000 ? '<span class="sync ok">Saved ✓</span>' : '';
        var cover = m.covering ? '<span class="cover' + (m.coveringMe ? ' me' : '') + '">👤 ' + (m.coveringMe ? 'You are covering this' : 'Covered by ' + esc(m.covering)) + '</span>' : '';
        var evs = m.events.length ? '<ul class="evs">' + m.events.map(function (e) { return '<li class="' + e.side + '">' + ICON[e.kind] + ' ' + (e.minute ? esc(e.minute) + "' " : '') + esc(e.player || 'Not named') + ' <span class="small">(' + esc(teamName(m, e.side).short || teamName(m, e.side).name) + ')</span></li>'; }).join('') + '</ul>' : '';
        var note = m.note ? '<p class="note">📝 ' + esc(m.note) + '</p>' : '';
        var counted = m.counted ? '<span class="ok">✓ In the table</span>' : '<span class="warn">Not in the table yet</span>';
        var by = m.updatedBy ? ' · last update by <b>' + esc(m.updatedBy) + '</b> at ' + lagos(m.updatedAt, { hour: '2-digit', minute: '2-digit' }) : '';
        return '<article class="match' + (isDirty ? ' dirty' : '') + ((m.home && m.home.isLobi) || (m.away && m.away.isLobi) ? ' lobi' : '') + '" data-id="' + m.id + '">'
          + '<div class="m-meta"><span>' + (m.kickoff ? lagos(m.kickoff, { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : 'Date to be confirmed') + (week === 'live' ? ' · Week ' + m.round : '') + '</span><span>' + esc(m.venue || '') + '</span></div>'
          + '<div class="m-tags">' + badge + sync + cover + '</div>'
          + '<div class="m-row">' + side(m.home, 'home') + '<div class="score">' + stepper('home', c.home) + '<span class="dash">:</span>' + stepper('away', c.away) + '</div>' + side(m.away, 'away') + '</div>'
          + evs + note
          + '<div class="statuses" role="group" aria-label="Match status">' + ORDER.map(function (s) { return '<button type="button" class="st" data-s="' + s + '" aria-pressed="' + (c.status === s) + '">' + LABEL[s] + '</button>'; }).join('') + '</div>'
          + '<div class="m-foot"><span class="info">' + counted + by + '</span><div class="m-actions">'
          + '<button type="button" class="link" data-more aria-expanded="' + !!openPanel[m.id] + '">' + (openPanel[m.id] ? 'Less ▴' : 'Goals, cards, more ▾') + '</button>'
          + (isDirty ? '<button type="button" class="link" data-undo>Undo changes</button>' : '')
          + '<button type="button" class="btn btn-red" data-save' + (isDirty ? '' : ' disabled') + '>Update</button></div></div>'
          + (openPanel[m.id] ? panel(m) : '')
          + '</article>';
      }).join('');
    }
    function panel(m) {
      var st = cur(m).status, h = hist[m.id];
      var opts = function (o, sel) { return Object.keys(o).map(function (k) { return '<option value="' + k + '"' + (k === sel ? ' selected' : '') + '>' + esc(o[k]) + '</option>'; }).join(''); };
      return '<div class="panel">'
        + '<h3>Goals and red cards</h3>'
        + (m.events.length ? '<ul class="evs edit">' + m.events.map(function (e) { return '<li>' + ICON[e.kind] + ' ' + (e.minute ? esc(e.minute) + "' " : '') + esc(e.player || 'Not named') + ' (' + esc(teamName(m, e.side).name) + ') <button type="button" class="x" data-rmev="' + e.id + '" aria-label="Remove">✕</button></li>'; }).join('') + '</ul>' : '<p class="small">None yet. Scorers are optional: the score above is what counts.</p>')
        + '<form class="evf" data-evf><select name="kind" aria-label="What happened">' + opts(kinds.goal ? kinds : { goal: 'Goal', pen: 'Penalty goal', og: 'Own goal', red: 'Red card' }, 'goal') + '</select>'
        + '<select name="side" aria-label="Team"><option value="home">' + esc(teamName(m, 'home').name) + '</option><option value="away">' + esc(teamName(m, 'away').name) + '</option></select>'
        + '<input name="player" maxlength="60" placeholder="Player (optional)" aria-label="Player" />'
        + '<input name="minute" maxlength="6" inputmode="numeric" placeholder="Min" aria-label="Minute" value="' + esc(minuteNow(m)) + '" />'
        + '<button type="submit" class="btn btn-ghost">Add</button></form>'
        + '<p class="small">For an own goal, choose the team that <b>scored</b> it (the team that gained the goal).</p>'
        + '<h3>Match note</h3><form class="evf" data-notef><input name="note" maxlength="200" placeholder="e.g. Kick-off delayed 30 min" value="' + esc(m.note) + '" aria-label="Match note" /><button type="submit" class="btn btn-ghost">Save note</button></form>'
        + '<h3>Clock</h3><div class="row-btns">'
        + '<button type="button" class="btn btn-ghost" data-clockact="kickoff">Kicked off now</button>'
        + (st === 'HALF_TIME' || (st === 'LIVE' && !m.secondHalfAt) ? '<button type="button" class="btn btn-ghost" data-clockact="second-half">Second half started</button>' : '')
        + (m.kickedOffAt || m.secondHalfAt ? '<button type="button" class="link" data-clockact="reset">Reset clock</button>' : '')
        + '</div><p class="small">The clock counts from the planned kick-off unless you press <b>Kicked off now</b>. Press <b>Second half started</b> when the second half begins (it also sets the match to Live).</p>'
        + '<h3>Covering</h3><div class="row-btns">' + (m.coveringMe ? '<button type="button" class="btn btn-ghost" data-cover="0">Stop covering this match</button>' : '<button type="button" class="btn btn-ghost" data-cover="1">I\'m covering this match</button>' + (m.covering ? ' <span class="small">(' + esc(m.covering) + ' is covering it now)</span>' : '')) + '</div>'
        + '<h3>History</h3>'
        + (h ? (h.changes.length ? '<ul class="hist">' + h.changes.map(function (x) { return '<li class="' + (x.active ? 'act' : '') + '"><time>' + lagos(x.at, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) + '</time> ' + (x.home == null ? '' : x.home + '–' + x.away + ' ') + esc(LABEL[x.status] || x.status) + ' · ' + esc(x.by) + (x.centre ? '' : ' (' + esc(x.kind === 'OFFICIAL' ? 'official result' : 'admin') + ')') + (x.active ? ' <b>· counts now</b>' : '') + '</li>'; }).join('') + '</ul>' : '<p class="small">No changes yet.</p>')
          + (h.events.some(function (e) { return e.removedAt; }) ? '<p class="small">Removed: ' + h.events.filter(function (e) { return e.removedAt; }).map(function (e) { return (ICON[e.kind] || '') + ' ' + esc(e.player || '') + ' by ' + esc(e.removedBy); }).join('; ') + '</p>' : '')
          + '<div class="row-btns">' + (h.canUndo ? '<button type="button" class="btn btn-ghost" data-undolast>Undo last change</button>' : '') + (m.centreDecision ? '<button type="button" class="link" data-clear>Remove all scores set here</button>' : '') + '</div>'
          : '<button type="button" class="btn btn-ghost" data-hist>Show history</button>')
        + '</div>';
    }
    function drawTable() {
      var t = data.table;
      if (!t) { $('tbl').innerHTML = ''; $('tSub').textContent = 'No table yet.'; return; }
      $('tSub').innerHTML = (t.live ? '<i class="live-dot"></i>Live: matches in play count as they stand.' : 'Updates as soon as you press Update.') + (t.publicCountsLive ? '' : ' The public table counts finished matches only.');
      $('tbl').innerHTML = t.rows.map(function (r) {
        var mv = r.move > 0 ? '<span class="mv up">▲' + r.move + '</span>' : r.move < 0 ? '<span class="mv down">▼' + (-r.move) + '</span>' : '';
        return '<tr class="' + (r.isLobi ? 'lobi' : '') + '"><td class="n">' + r.pos + '</td><td><div class="tteam">' + (r.crest ? '<img src="' + esc(r.crest) + '" alt="" loading="lazy" />' : '') + esc(r.short || r.name) + mv + '</div></td><td class="n">' + r.p + '</td><td class="n">' + r.w + '</td><td class="n">' + r.d + '</td><td class="n">' + r.l + '</td><td class="n">' + (r.gd > 0 ? '+' : '') + r.gd + '</td><td class="n"><b>' + r.pts + '</b></td></tr>';
      }).join('');
      $('recent').innerHTML = (data.recent || []).length ? data.recent.map(function (x) { return '<li><time>' + hm(x.at) + '</time>' + esc(x.text) + '</li>'; }).join('') : '<li class="small">No updates yet.</li>';
    }
    function matchOf(el) { var a = el.closest('[data-id]'); return a && data.matches.find(function (m) { return m.id === Number(a.dataset.id); }); }
    function leaveOk() { return !Object.keys(dirty).length || confirm('You have scores not updated yet. Leave without saving them?'); }

    // ── Saving a score, with the checks ──
    async function save(m, btn) {
      var c = Object.assign({}, cur(m)), t = now();
      var ko = Date.parse(m.kickedOffAt || m.kickoff), name = m.home.name + ' v ' + m.away.name;
      if ((c.status === 'LIVE' || c.status === 'HALF_TIME') && ko && t - ko > 3 * 3600e3) {
        if (confirm(name + ' kicked off more than 3 hours ago, so it should be finished.\n\nOK: save it as Full time.\nCancel: keep it as ' + LABEL[c.status] + '.')) c.status = 'FULL_TIME';
      }
      if (m.status === 'FULL_TIME' && (c.status !== 'FULL_TIME' || c.home !== m.homeGoals || c.away !== m.awayGoals)
        && !confirm('This match is already finished (' + m.homeGoals + '–' + m.awayGoals + ', full time). Change it?')) return;
      if (((m.homeGoals || 0) > (c.home || 0) || (m.awayGoals || 0) > (c.away || 0)) && c.status !== 'SCHEDULED'
        && !confirm('You are taking a goal away (' + (m.homeGoals ?? 0) + '–' + (m.awayGoals ?? 0) + ' → ' + c.home + '–' + c.away + '). Is that right?')) return;
      if (c.status === 'FULL_TIME' && m.status !== 'FULL_TIME' && !confirm('Confirm full time:\n\n' + m.home.name + ' ' + c.home + '–' + c.away + ' ' + m.away.name)) return;
      if (m.covering && !m.coveringMe && !confirm(m.covering + ' is covering this match. Update it anyway?')) return;
      var body = { fixtureId: m.id, homeGoals: c.status === 'SCHEDULED' ? '' : c.home, awayGoals: c.status === 'SCHEDULED' ? '' : c.away, status: c.status, version: m.version };
      var label = m.home.name + ' ' + (c.status === 'SCHEDULED' ? 'v' : c.home + '–' + c.away) + ' ' + m.away.name + ' (' + LABEL[c.status] + ')';
      btn.disabled = true; btn.textContent = 'Updating…'; busy = true;
      try {
        var r;
        try { r = await send('update', body); }
        catch (netErr) {
          if (netErr.message === 'signed out') throw netErr;
          queue = queue.filter(function (q) { return q.body.fixtureId !== m.id; }); queue.push({ body: body, label: label, at: new Date().toISOString() }); saveQueue();
          delete dirty[m.id]; Object.assign(m, { homeGoals: c.home, awayGoals: c.away, status: c.status });
          toast('No network: ' + label + ' is kept on this phone and will be sent when the signal returns.', true);
          drawMatches(); busy = false; return;
        }
        if (r.status === 409 && r.d.current) {
          var x = r.d.current;
          if (!confirm(x.by + ' changed this match to ' + (x.homeGoals == null ? '' : x.homeGoals + '–' + x.awayGoals + ' ') + '(' + (LABEL[x.status] || x.status) + ')' + (x.at ? ' at ' + lagos(x.at, { hour: '2-digit', minute: '2-digit' }) : '') + ', after you opened it.\n\nReplace it with yours: ' + label + '?')) { delete dirty[m.id]; await load(); busy = false; return; }
          body.force = true; r = await send('update', body);
        }
        if (!r.ok) throw new Error(r.d.error || 'Could not update.');
        // Half-time → Live: the second half has started (for the clock), unless already noted.
        if (m.status === 'HALF_TIME' && c.status === 'LIVE' && !m.secondHalfAt) await send('clock', { fixtureId: m.id, action: 'second-half' }).catch(function () {});
        delete dirty[m.id];
        toast('Updated: ' + label + '. The table is updated.');
        await load();
      } catch (err) { if (err.message !== 'signed out') toast(err.message, true); btn.disabled = false; btn.textContent = 'Update'; }
      busy = false;
    }

    document.addEventListener('click', async function (e) {
      var el = e.target;
      var chip = el.closest('[data-week]');
      if (chip) { if (!leaveOk()) return; var w = chip.dataset.week; return load(w === 'live' ? 'live' : Number(w)).catch(function (err) { toast(err.message, true); }); }
      if (el.id === 'prev' || el.id === 'next') {
        if (!leaveOk()) return;
        var i = data.weeks.indexOf(week === 'live' ? data.liveRound : week) + (el.id === 'next' && week !== 'live' ? 1 : el.id === 'prev' ? -1 : 0);
        if (week === 'live' && el.id === 'next') i = data.weeks.indexOf(data.liveRound);
        if (data.weeks[i] == null) return;
        return load(data.weeks[i]).catch(function (err) { toast(err.message, true); });
      }
      if (el.id === 'install' && installEvt) { installEvt.prompt(); installEvt = null; $('install').hidden = true; return; }
      var m = matchOf(el); if (!m) return;
      var c = Object.assign({}, cur(m)), ko = Date.parse(m.kickedOffAt || m.kickoff);
      var startStatus = function () { return ko && now() - ko > 150 * 60e3 ? 'FULL_TIME' : 'LIVE'; };
      if (el.closest('[data-inc]')) { var k = el.closest('[data-inc]').dataset.inc; c[k] = Math.min(99, (c[k] == null ? 0 : c[k]) + 1); if (c.status === 'SCHEDULED') c.status = startStatus(); if (c.home == null) c.home = 0; if (c.away == null) c.away = 0; }
      else if (el.closest('[data-dec]')) { var k2 = el.closest('[data-dec]').dataset.dec; c[k2] = Math.max(0, (c[k2] == null ? 0 : c[k2]) - 1); if (c.home == null) c.home = 0; if (c.away == null) c.away = 0; }
      else if (el.closest('[data-s]')) { c.status = el.closest('[data-s]').dataset.s; if (['LIVE', 'HALF_TIME', 'FULL_TIME'].indexOf(c.status) >= 0) { if (c.home == null) c.home = 0; if (c.away == null) c.away = 0; } }
      else if (el.closest('[data-undo]')) { delete dirty[m.id]; return drawMatches(); }
      else if (el.closest('[data-save]')) return save(m, el.closest('[data-save]'));
      else if (el.closest('[data-more]')) { openPanel[m.id] = !openPanel[m.id]; return drawMatches(); }
      else if (el.closest('[data-hist]')) { try { hist[m.id] = await api('history?fixtureId=' + m.id); drawMatches(); } catch (err) { toast(err.message, true); } return; }
      else if (el.closest('[data-undolast]')) {
        if (!confirm('Undo the last change made here on ' + m.home.name + ' v ' + m.away.name + '?')) return;
        try { await api('undo', { fixtureId: m.id }); toast('Undone. The table is updated.'); hist[m.id] = null; delete hist[m.id]; await load(); openPanel[m.id] = true; hist[m.id] = await api('history?fixtureId=' + m.id); drawMatches(); } catch (err) { toast(err.message, true); }
        return;
      }
      else if (el.closest('[data-clear]')) {
        if (!confirm('Remove every score set here for ' + m.home.name + ' v ' + m.away.name + '? The match then follows its other score sources (for example Live Match Control).')) return;
        try { await api('clear', { fixtureId: m.id }); toast('Removed. The table is updated.'); delete hist[m.id]; await load(); } catch (err) { toast(err.message, true); }
        return;
      }
      else if (el.closest('[data-rmev]')) {
        if (!confirm('Remove this entry?')) return;
        try { await api('event-remove', { id: Number(el.closest('[data-rmev]').dataset.rmev) }); delete hist[m.id]; await load(); openPanel[m.id] = true; drawMatches(); } catch (err) { toast(err.message, true); }
        return;
      }
      else if (el.closest('[data-clockact]')) {
        var act = el.closest('[data-clockact]').dataset.clockact;
        if (act === 'reset' && !confirm('Reset the clock to the planned kick-off time?')) return;
        try {
          await api('clock', { fixtureId: m.id, action: act });
          if (act === 'second-half' && m.status !== 'LIVE') await api('update', { fixtureId: m.id, homeGoals: m.homeGoals ?? 0, awayGoals: m.awayGoals ?? 0, status: 'LIVE', version: m.version, force: false });
          if (act === 'kickoff' && m.status === 'SCHEDULED') await api('update', { fixtureId: m.id, homeGoals: 0, awayGoals: 0, status: 'LIVE', version: m.version });
          toast(act === 'kickoff' ? 'Kicked off: the clock starts now.' : act === 'second-half' ? 'Second half started: the match is Live.' : 'Clock reset.');
          await load(); openPanel[m.id] = true; drawMatches();
        } catch (err) { toast(err.message, true); }
        return;
      }
      else if (el.closest('[data-cover]')) {
        try { await api('cover', { fixtureId: m.id, on: el.closest('[data-cover]').dataset.cover === '1' }); await load(); openPanel[m.id] = true; drawMatches(); } catch (err) { toast(err.message, true); }
        return;
      }
      else return;
      var same = c.home === m.homeGoals && c.away === m.awayGoals && c.status === m.status;
      if (same) delete dirty[m.id]; else dirty[m.id] = c;
      drawMatches();
    });
    document.addEventListener('submit', async function (e) {
      var f = e.target, m = matchOf(f); if (!m) return;
      e.preventDefault();
      var b = f.querySelector('button'); b.disabled = true;
      try {
        if (f.hasAttribute('data-evf')) { await api('event', { fixtureId: m.id, kind: f.kind.value, side: f.side.value, player: f.player.value, minute: f.minute.value }); toast('Added.'); }
        else if (f.hasAttribute('data-notef')) { await api('note', { fixtureId: m.id, note: f.note.value }); toast(f.note.value.trim() ? 'Note saved.' : 'Note removed.'); }
        delete hist[m.id]; await load(); openPanel[m.id] = true; drawMatches();
      } catch (err) { toast(err.message, true); b.disabled = false; }
    });

    // Clocks tick; scores and the table refresh every 20 seconds (other people may be updating too),
    // never over unsaved changes or an open "Goals, cards, more" panel.
    setInterval(function () { if (!data) return; data.matches.forEach(function (m) { var el = document.querySelector('[data-clock="' + m.id + '"]'); if (el) { var ck = clock(m, cur(m).status); el.innerHTML = (cur(m).status === 'LIVE' ? '<i class="live-dot"></i>' : '') + ck; } }); }, 15000);
    setInterval(function () {
      var typing = document.activeElement && /INPUT|SELECT|TEXTAREA/.test(document.activeElement.tagName) && !$('app').hidden;
      if (!data || busy || document.hidden || Object.keys(dirty).length || Object.keys(openPanel).some(function (k) { return openPanel[k]; }) || typing || $('app').hidden) return;
      load().catch(function () {});
    }, 20000);
    window.addEventListener('beforeunload', function (e) { if (Object.keys(dirty).length) { e.preventDefault(); e.returnValue = ''; } });

    // Keep the screen on while the page is open (where the phone allows it).
    var lock = null;
    async function wake() { try { if ('wakeLock' in navigator && !document.hidden && !$('app').hidden) { lock = await navigator.wakeLock.request('screen'); $('awake').hidden = false; lock.addEventListener('release', function () { $('awake').hidden = true; }); } } catch (e) { /* not allowed: fine */ } }
    document.addEventListener('visibilitychange', function () { if (!document.hidden) { wake(); if (data && !Object.keys(dirty).length) load().catch(function () {}); flush(); } });

    // Install as an app.
    var installEvt = null;
    window.addEventListener('beforeinstallprompt', function (e) { e.preventDefault(); installEvt = e; $('install').hidden = false; });
    if ('serviceWorker' in navigator) navigator.serviceWorker.register('/scores-centre/sw.js', { scope: '/scores-centre/' }).catch(function () {});

    drawNet();
    start().catch(function () { showSignIn(''); });
  })();
  </script>
</body>
</html>
