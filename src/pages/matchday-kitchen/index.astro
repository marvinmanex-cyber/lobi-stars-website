---
// MatchDay Kitchen: the kitchen staff's own area (sign-in, the ticket-rail home
// screen, pages opened as tabs). Served by functions/matchday-kitchen/[[path]].js
// for /matchday-kitchen/ and /matchday-kitchen/login/ with strict security
// headers. Separate from the website admin: its own staff, sign-in and cookie.
// Inner pages are the panel page (panel.astro) in the tab frames.
import '../../styles/matchdayKitchen.css';
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="same-origin" />
  <meta name="theme-color" content="#0e7a26" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="MD Kitchen" />
  <meta name="application-name" content="MD Kitchen" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <title>MatchDay Kitchen | Lobi Stars FC</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/images/matchday-kitchen/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/matchday-kitchen/apple-touch-icon.png" />
  <link rel="manifest" href="/matchday-kitchen.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=Barlow+Condensed:wght@600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <section class="mk-signin" id="signin" hidden>
    <form class="mk-card" id="signinForm" novalidate>
      <img class="mk-signin-logo" src="/images/matchday-kitchen/logo-320.png" alt="MatchDay Kitchen logo" width="160" height="160" />
      <h1>MatchDay Kitchen</h1>
      <p class="mk-club">Lobi Stars FC</p>
      <p class="mk-ok" id="signinMsg" role="status" hidden></p>
      <p class="mk-err" id="signinErr" role="alert" hidden></p>
      <div id="codeFields">
        <div class="mk-field">
          <label for="loginCode">Your login code</label>
          <input class="mk-codein" id="loginCode" name="loginCode" inputmode="numeric" autocomplete="one-time-code" maxlength="9" placeholder="1234-5678" />
        </div>
      </div>
      <div id="adminFields" hidden>
        <div class="mk-field" id="otpField" hidden><label for="otp">Two-step code</label><input id="otp" inputmode="numeric" autocomplete="one-time-code" maxlength="20" /></div>
        <div class="mk-field">
          <label for="login">Website email (Super Admins)</label>
          <input id="login" name="login" type="email" autocomplete="username" spellcheck="false" maxlength="120" />
        </div>
        <div class="mk-field">
          <label for="password">Password</label>
          <div class="mk-pw">
            <input id="password" name="password" type="password" autocomplete="current-password" maxlength="72" />
            <button type="button" id="pwToggle" aria-controls="password" aria-pressed="false">Show</button>
          </div>
        </div>
      </div>
      <button class="mk-btn go big wide" type="submit" id="signinBtn">Sign in</button>
      <p class="mk-note" id="signinNote">Everything you do in the kitchen is recorded under your name. Don't share your login code.</p>
      <button type="button" class="mk-link" id="modeBtn">Super Admin? Sign in with your website email</button>
      <div class="mk-install" id="installBox" hidden>
        <p class="mk-install-t"><b>Kitchen staff app</b> Install MatchDay Kitchen on this phone, tablet or laptop. It opens straight to the kitchen, full screen, without the rest of the website.</p>
        <button type="button" class="mk-btn go wide" id="installBtn" hidden>Install the Kitchen app</button>
        <p class="mk-install-ios" id="iosHow" hidden>On iPhone or iPad (Safari): tap <b>Share</b> <span aria-hidden="true">⬆</span>, then <b>Add to Home Screen</b>, then <b>Add</b>.</p>
      </div>
    </form>
  </section>

  <div id="app" hidden>
    <header class="mk-top" id="top">
      <div class="mk-top-row">
        <img class="mk-top-logo" src="/images/matchday-kitchen/logo-96.png" alt="MatchDay Kitchen" width="48" height="48" />
        <button type="button" class="mk-tb on" id="homeBtn" aria-label="Home"><span aria-hidden="true">⌂</span><span class="lbl">Home</span></button>
        <button type="button" class="mk-tb wa" id="waBtn" aria-label="Open the kitchen's WhatsApp chats (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><path id="waPath" fill="currentColor" /></svg><span class="lbl">WhatsApp</span></button>
        <button type="button" class="mk-tb tg" id="tgBtn" aria-label="Open the kitchen's Telegram updates (opens in a new tab)"><svg viewBox="0 0 24 24" aria-hidden="true"><path id="tgPath" fill="currentColor" /></svg><span class="lbl">Telegram</span></button>
        <button type="button" class="mk-tb" id="fanBtn" aria-label="Open the fan ordering page in the browser"><span aria-hidden="true">🍽</span><span class="lbl">Fan menu</span></button>
        <span class="mk-spacer"></span>
        <button type="button" class="mk-tb" id="installTop" hidden aria-label="Install the Kitchen app"><span aria-hidden="true">⬇</span><span class="lbl">Install app</span></button>
        <button type="button" class="mk-tb" id="reloadBtn" hidden aria-label="Reload this page"><span aria-hidden="true">⟳</span><span class="lbl">Reload</span></button>
        <button type="button" class="mk-tb" id="fsBtn" hidden aria-label="Full screen"><span aria-hidden="true">⛶</span></button>
        <button type="button" class="mk-tb mk-sound" id="soundOn" hidden aria-label="Turn on order sounds"><span aria-hidden="true">🔈</span><span class="lbl">Tap to turn on order sounds</span></button>
        <span class="mk-clock" id="clock" aria-label="Time"></span>
        <div class="mk-who" id="who"></div>
        <button type="button" class="mk-tb" id="signoutBtn">Sign out</button>
      </div>
      <nav class="mk-tabs" id="tabs" aria-label="Open pages" hidden></nav>
      <div class="mk-alarm" id="alarm" role="alert" aria-live="assertive" hidden></div>
    </header>
    <main class="mk-home" id="home">
      <h1 class="mk-hello" id="hello"></h1>
      <button type="button" class="mk-shiftnag" id="shiftNag" hidden>You haven't started your shift. Start it now.</button>
      <section class="mk-ordering" id="ordering" aria-label="Food ordering for fans" hidden>
        <div class="mk-ordering-t"><b id="ordState"></b><span id="ordNote"></span></div>
        <div class="mk-ordering-btns" id="ordBtns" hidden>
          <button type="button" class="mk-btn go big" data-ordering="open">Open ordering</button>
          <button type="button" class="mk-btn stop big" data-ordering="closed">Close ordering</button>
          <button type="button" class="mk-btn big" data-ordering="auto">Automatic</button>
          <button type="button" class="mk-btn big" id="ordPause">Pause new orders</button>
        </div>
      </section>
      <section class="mk-pushbox" id="pushBox" aria-label="Order alerts on this device" hidden>
        <p id="pushText"></p>
        <div class="mk-pushbtns">
          <button type="button" class="mk-btn go big" id="pushOn" hidden>Turn on order alerts</button>
          <button type="button" class="mk-btn" id="pushTest" hidden>Send a test alert</button>
          <button type="button" class="mk-btn" id="pushOff" hidden>Turn off</button>
        </div>
      </section>
      <div id="groups"></div>
    </main>
    <div class="mk-frames" id="frames"></div>
  </div>

  <div class="mk-idle" id="idle" hidden role="alertdialog" aria-modal="true" aria-labelledby="idleTitle">
    <div class="mk-card">
      <h2 id="idleTitle">Still there?</h2>
      <p>Nobody has tapped for 20 minutes. You'll be signed out in</p>
      <div class="mk-count" id="idleCount">60</div>
      <button type="button" class="mk-btn go big wide" id="idleKeep">Keep me signed in</button>
    </div>
  </div>
  <div class="mk-toast" id="toast" role="status" hidden></div>

  <script>
    import '../../scripts/matchdayKitchen/shell';
    import '../../scripts/matchdayKitchen/app';
  </script>
</body>
</html>
