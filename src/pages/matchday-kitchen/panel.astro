---
// MatchDay Kitchen inner pages (kitchen screen, live board, orders, menu, …).
// functions/matchday-kitchen/[[path]].js serves this page for every inner
// address; src/scripts/matchdayKitchen/panel.ts draws the page for the address.
// Normally shown inside a tab of the home screen; also works on its own.
import '../../styles/matchdayKitchen.css';
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="same-origin" />
  <meta name="theme-color" content="#0e7a26" />
  <title>MatchDay Kitchen | Lobi Stars FC</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/images/matchday-kitchen/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/matchday-kitchen/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=Barlow+Condensed:wght@600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="mk-panel-head">
    <button type="button" class="mk-btn" id="pHome"><span aria-hidden="true">⌂</span> Home</button>
    <h1 id="pTitle">MatchDay Kitchen</h1>
    <span class="upd" id="pUpd" aria-live="polite"></span>
  </header>
  <main class="mk-main" id="pMain"><p class="mk-empty">Loading…</p></main>
  <dialog class="mk-dialog" id="pDialog">
    <form method="dialog">
      <h2 id="dTitle"></h2>
      <div id="dBody"></div>
      <div class="mk-actions">
        <button class="mk-btn" value="no" id="dNo">Cancel</button>
        <button class="mk-btn go" value="yes" id="dYes">Yes</button>
      </div>
    </form>
  </dialog>
  <dialog class="mk-dialog mk-paydlg" id="whyDlg" aria-labelledby="whyT">
    <form id="whyF" novalidate>
      <h2 id="whyT">Reject order</h2>
      <p class="mk-status" id="whySum" style="text-transform:none;letter-spacing:0"></p>
      <div class="mk-field" id="whyListBox"><label for="whyList">Why?</label><select id="whyList"><option value="">Choose a reason</option><option value="sold_out">An item is sold out</option><option value="kitchen_at_capacity">The kitchen is at capacity</option><option value="outside_delivery_zone">Outside the delivery area</option><option value="payment_issue">A problem with the payment</option><option value="other">Other</option></select></div>
      <div class="mk-field"><label for="whyNote" id="whyNoteL">Note (required for Other)</label><input id="whyNote" maxlength="300" autocomplete="off" /></div>
      <p class="mk-err" id="whyErr" role="alert" hidden></p>
      <div class="mk-actions"><button type="button" class="mk-btn" id="whyNo">Keep the order</button><button type="submit" class="mk-btn danger big" id="whyYes">Reject order</button></div>
    </form>
  </dialog>
  <dialog class="mk-dialog mk-paydlg" id="payDlg" aria-labelledby="payT">
    <form id="payF" novalidate>
      <h2 id="payT">Record payment</h2>
      <p class="mk-status" id="paySum" style="text-transform:none;letter-spacing:0"></p>
      <div class="mk-field">
        <label for="payFile">Payment evidence (required)</label>
        <input id="payFile" type="file" accept="image/*,application/pdf" class="mk-sr" />
        <label for="payFile" class="mk-btn mk-paypick" id="payPick">Tap to add the receipt: photo, screenshot or PDF</label>
        <img id="payPrev" alt="The payment evidence you chose" hidden />
        <p class="mk-status" id="payName" style="text-transform:none;letter-spacing:0" hidden></p>
      </div>
      <div class="mk-filters">
        <div class="mk-field"><label for="payHow">How they paid</label><select id="payHow"><option value="transfer">Bank transfer</option><option value="ussd">USSD / mobile app</option><option value="pos">POS</option><option value="cash">Cash</option></select></div>
        <div class="mk-field"><label for="payAmt">Amount received (₦)</label><input id="payAmt" inputmode="numeric" maxlength="9" /></div>
      </div>
      <div class="mk-field"><label for="payNote">Note (optional): bank reference or sender's name</label><input id="payNote" maxlength="200" autocomplete="off" /></div>
      <p class="mk-err" id="payErr" role="alert" hidden></p>
      <div class="mk-actions"><button type="button" class="mk-btn" id="payNo">Cancel</button><button type="submit" class="mk-btn go big" id="paySave">Mark order paid</button></div>
    </form>
    <div id="payDone" hidden>
      <h2>Payment recorded</h2>
      <p id="payDoneT"></p>
      <div class="mk-actions"><a class="mk-btn go big" id="payTell" target="mdk-whatsapp" rel="noopener" hidden>Tell the fan on WhatsApp</a><button type="button" class="mk-btn" id="payClose">Done</button></div>
    </div>
  </dialog>
  <div class="mk-toast" id="toast" role="status" hidden></div>
  <script>
    import '../../scripts/matchdayKitchen/panel';
  </script>
</body>
</html>
