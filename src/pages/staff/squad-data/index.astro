---
// The Squad & Staff Data Portal (private; served by functions/staff/[[path]].js at
// PORTAL_PATH, default /staff/squad-data). A standalone page: none of the public
// site's menus, links, search or analytics, never indexed. Its own login (one
// shared account set by a Super Admin); the app itself is in src/scripts/squadPortal/.
import settings from '../../../data/fan-settings.json';
const siteKey = settings.turnstileSiteKey;
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <meta name="theme-color" content="#B3121A" />
  <title>Squad &amp; Staff Data Portal | Lobi Stars FC</title>
  <link rel="icon" href="/images/lobi-stars-badge.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@700&display=swap" rel="stylesheet" />
</head>
<body>
  <div id="app" data-turnstile={siteKey}>
    <!-- SCREEN 1: SIGN IN -->
    <section class="sp-signin" id="signin" hidden>
      <div class="sp-brand">
        <span class="sp-badge sp-badge-lg"><img src="/images/lobi-stars-badge.webp" alt="Lobi Stars FC badge" width="96" height="96" /></span>
        <p class="sp-club">LOBI STARS FC</p>
        <p class="sp-pride">PRIDE OF BENUE</p>
        <h1 class="sp-h1">SQUAD &amp; STAFF DATA PORTAL</h1>
        <span class="sp-goldbar" aria-hidden="true"></span>
      </div>
      <div class="sp-signin-side">
        <form class="sp-card sp-signin-card" id="signinForm" novalidate>
          <h2 class="sp-h2">Sign in</h2>
          <p class="sp-muted">Use the portal username and password provided by the club.</p>
          <p class="sp-alert" id="signinMsg" role="alert" hidden></p>
          <div class="sp-field"><label for="siUser">Username</label><input id="siUser" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" required /></div>
          <div class="sp-field"><label for="siPass">Password</label>
            <div class="sp-pw"><input id="siPass" name="password" type="password" autocomplete="current-password" required /><button type="button" class="sp-pw-show" id="siShow" aria-label="Show password" aria-pressed="false">Show</button></div></div>
          <div class="sp-field"><label for="siName">Your name</label><input id="siName" name="name" autocomplete="name" placeholder="Who is entering data today?" required maxlength="60" aria-describedby="siNameHint" />
            <p class="sp-hint" id="siNameHint">Recorded with every profile you add or change.</p></div>
          <div class="sp-turnstile" id="siTurnstile" hidden></div>
          <button class="sp-btn sp-btn-red sp-btn-block" type="submit" id="siBtn">SIGN IN</button>
          <p class="sp-note"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24"><path fill="currentColor" d="M12 1a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2h-1V6a5 5 0 0 0-5-5Zm-3 8V6a3 3 0 0 1 6 0v3H9Z"/></svg>
            This login only opens the Squad &amp; Staff Data Portal. It has no access to any other part of the website.</p>
        </form>
      </div>
    </section>

    <!-- SIGNED IN -->
    <div id="portal" hidden>
      <header class="sp-header">
        <div class="sp-header-in">
          <span class="sp-badge"><img src="/images/lobi-stars-badge.webp" alt="" width="44" height="44" /></span>
          <div class="sp-header-titles"><b>LOBI STARS FC</b><span>Squad &amp; Staff Data Portal</span></div>
          <div class="sp-header-user"><span>Signed in as <b id="whoName"></b></span><button type="button" class="sp-btn sp-btn-ghost" id="signOut">Sign out</button></div>
        </div>
      </header>
      <main class="sp-main" id="main"></main>
      <footer class="sp-footer"><a href="/privacy/" target="_blank" rel="noopener">Privacy Policy</a></footer>
    </div>

    <!-- 2-minute warning before signing out after 60 minutes without activity -->
    <div class="sp-modal" id="idleWarn" role="alertdialog" aria-modal="true" aria-labelledby="idleTitle" hidden>
      <div class="sp-card sp-modal-card">
        <h2 class="sp-h2" id="idleTitle">Still there?</h2>
        <p>You will be signed out in <b id="idleLeft">2:00</b> because nothing has happened for a while. Your saved answers are kept.</p>
        <button type="button" class="sp-btn sp-btn-red" id="idleStay">Stay signed in</button>
      </div>
    </div>
    <p class="sp-toast" id="toast" role="status" aria-live="polite" hidden></p>
  </div>
  <script>
    import { startPortal } from '../../../scripts/squadPortal/app';
    startPortal();
  </script>
</body>
</html>

<style is:global>
  :root { --red: #B3121A; --red-d: #8E0E14; --gold: #F2B705; --ink: #16181D; --grey: #4A505C; --bg: #F3F4F6; --line: #E2E4E9; --white: #fff;
    --pub: #1D4ED8; --pub-bg: #DBEAFE; --med: #92400E; --med-bg: #FEF3C7; --prv: #374151; --prv-bg: #E5E7EB; }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body { background: var(--bg); color: var(--ink); font: 400 16px/1.5 'Barlow', system-ui, -apple-system, 'Segoe UI', sans-serif; -webkit-text-size-adjust: 100%; }
  [hidden] { display: none !important; }
  :focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
  a { color: var(--red); }
  .sp-h1, .sp-h2, .sp-h3, .sp-kicker { font-family: 'Barlow Condensed', 'Arial Narrow', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: .02em; margin: 0; }
  .sp-h2 { font-size: 26px; line-height: 1.1; }
  .sp-h3 { font-size: 20px; line-height: 1.15; }
  .sp-muted { color: var(--grey); margin: 6px 0 16px; }
  .sp-card { background: var(--white); border: 1px solid var(--line); border-radius: 16px; padding: 20px; }
  .sp-badge { display: inline-grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: #fff; border: 3px solid var(--gold); overflow: hidden; flex: none; }
  .sp-badge img { width: 84%; height: 84%; object-fit: contain; }
  .sp-badge-lg { width: 112px; height: 112px; border-width: 4px; }
  .sp-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 10px 18px; border-radius: 12px; border: 2px solid transparent; font: 700 16px/1.1 'Barlow Condensed', sans-serif; letter-spacing: .04em; text-transform: uppercase; cursor: pointer; text-decoration: none; }
  .sp-btn:disabled { opacity: .6; cursor: wait; }
  .sp-btn-red { background: var(--red); color: #fff; } .sp-btn-red:hover { background: var(--red-d); }
  .sp-btn-dark { background: var(--ink); color: #fff; }
  .sp-btn-gold { background: var(--gold); color: var(--ink); }
  .sp-btn-outline { background: transparent; border-color: currentColor; color: inherit; }
  .sp-btn-ghost { background: rgba(255,255,255,.12); color: #fff; border-color: rgba(255,255,255,.5); min-height: 44px; }
  .sp-btn-block { width: 100%; }
  .sp-field { display: grid; gap: 6px; margin: 0 0 16px; }
  .sp-field > label, .sp-label { font-weight: 600; font-size: 15px; }
  .sp-field input, .sp-field select, .sp-field textarea { width: 100%; min-height: 48px; padding: 10px 12px; border: 1.5px solid #C9CDD4; border-radius: 10px; background: #fff; color: var(--ink); font: inherit; font-size: 16px; }
  .sp-field input:focus, .sp-field select:focus, .sp-field textarea:focus { border-color: var(--ink); outline: 3px solid var(--gold); outline-offset: 1px; }
  .sp-hint { margin: 0; font-size: 14px; color: var(--grey); }
  .sp-alert { margin: 0 0 14px; padding: 10px 12px; border-radius: 10px; background: #FDECEC; color: #8E0E14; font-weight: 600; }
  .sp-pw { display: flex; gap: 6px; } .sp-pw input { flex: 1; }
  .sp-pw-show { min-width: 64px; min-height: 48px; border-radius: 10px; border: 1.5px solid #C9CDD4; background: #fff; font: 600 14px 'Barlow', sans-serif; cursor: pointer; }
  .sp-note { display: flex; gap: 8px; align-items: flex-start; margin: 16px 0 0; padding: 12px; border-radius: 10px; background: var(--bg); color: var(--grey); font-size: 14px; }
  .sp-note svg { flex: none; margin-top: 2px; }
  .sp-turnstile { margin: 0 0 16px; min-height: 65px; }

  /* Sign in */
  .sp-signin { min-height: 100vh; display: grid; grid-template-columns: 1fr; }
  .sp-brand { background: var(--red); color: #fff; padding: 36px 24px; display: grid; justify-items: center; align-content: center; text-align: center; gap: 4px; }
  .sp-club { margin: 14px 0 0; font: 700 22px/1 'Barlow Condensed', sans-serif; letter-spacing: .08em; }
  .sp-pride { margin: 0; font: 600 13px/1 'Barlow', sans-serif; letter-spacing: .24em; color: #FFE7A0; }
  .sp-brand .sp-h1 { margin-top: 18px; font-size: 32px; line-height: 1.05; max-width: 14ch; }
  .sp-goldbar { display: block; width: 64px; height: 5px; border-radius: 3px; background: var(--gold); margin-top: 14px; }
  .sp-signin-side { padding: 24px 16px 40px; display: grid; place-items: start center; }
  .sp-signin-card { width: 100%; max-width: 440px; }
  @media (min-width: 900px) {
    .sp-signin { grid-template-columns: minmax(360px, 44%) 1fr; }
    .sp-brand { padding: 48px; } .sp-brand .sp-h1 { font-size: 44px; }
    .sp-signin-side { place-items: center; padding: 48px; }
  }

  /* Signed in */
  .sp-header { background: var(--red); color: #fff; position: sticky; top: 0; z-index: 50; }
  .sp-header-in { max-width: 1200px; margin: 0 auto; padding: 10px 16px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .sp-header-titles { display: grid; line-height: 1.15; } .sp-header-titles b { font: 700 18px 'Barlow Condensed', sans-serif; letter-spacing: .06em; } .sp-header-titles span { font-size: 14px; opacity: .92; }
  .sp-header-user { margin-left: auto; display: flex; align-items: center; gap: 10px; font-size: 14px; flex-wrap: wrap; }
  .sp-main { max-width: 1200px; margin: 0 auto; padding: 20px 16px 120px; }
  .sp-footer { max-width: 1200px; margin: 0 auto; padding: 0 16px 28px; font-size: 14px; color: var(--grey); }
  .sp-modal { position: fixed; inset: 0; background: rgba(22,24,29,.6); display: grid; place-items: center; padding: 16px; z-index: 200; }
  .sp-modal-card { max-width: 420px; display: grid; gap: 12px; }
  /* Home */
  .sp-kicker { font-size: 15px; letter-spacing: .14em; }
  .sp-gold { color: #8A6400; }
  .sp-page-title { font-size: 34px; line-height: 1.05; margin: 4px 0 10px; }
  .sp-intro { max-width: 760px; color: var(--grey); margin: 0 0 18px; font-size: 17px; }
  .sp-how { margin: 0 0 18px; }
  .sp-steps { list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 10px; grid-template-columns: 1fr; }
  .sp-steps li { display: grid; gap: 4px; padding: 16px; }
  .sp-steps li span:last-child { color: var(--grey); }
  .sp-step { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--gold); color: var(--ink); font: 700 18px 'Barlow Condensed', sans-serif; }
  .sp-adds { display: grid; gap: 12px; grid-template-columns: 1fr; margin: 0 0 16px; }
  .sp-add { display: grid; gap: 4px; text-align: left; padding: 20px; border-radius: 16px; border: 0; color: #fff; cursor: pointer; min-height: 92px; }
  .sp-add b { font: 700 24px/1.05 'Barlow Condensed', sans-serif; letter-spacing: .03em; }
  .sp-add span { font-size: 15px; opacity: .92; }
  .sp-add-red { background: var(--red); } .sp-add-red:hover { background: var(--red-d); }
  .sp-add-dark { background: var(--ink); } .sp-add-dark:hover { background: #000; }
  .sp-chips { list-style: none; padding: 0; margin: 0 0 16px; display: flex; flex-wrap: wrap; gap: 8px; }
  .sp-chip { background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; color: var(--grey); }
  .sp-chip b { color: var(--ink); font-size: 18px; margin-right: 2px; }
  .sp-saved, .sp-export { margin: 0 0 16px; }
  .sp-saved-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 10px; }
  .sp-season { display: flex; gap: 8px; align-items: center; font-weight: 600; }
  .sp-season select { min-height: 44px; border: 1.5px solid #C9CDD4; border-radius: 10px; padding: 6px 10px; font: inherit; background: #fff; }
  .sp-search { max-width: 420px; }
  .sp-filters { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 12px; }
  .sp-filter { min-height: 44px; padding: 6px 14px; border-radius: 999px; border: 1.5px solid #C9CDD4; background: #fff; font: 600 15px 'Barlow', sans-serif; color: var(--ink); cursor: pointer; }
  .sp-filter[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .sp-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .sp-table { width: 100%; min-width: 760px; border-collapse: collapse; font-size: 15px; }
  .sp-table th { text-align: left; font: 700 13px 'Barlow Condensed', sans-serif; letter-spacing: .06em; text-transform: uppercase; color: var(--grey); padding: 8px; border-bottom: 2px solid var(--line); }
  .sp-table td { padding: 10px 8px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  .sp-thumb { width: 44px; height: 55px; object-fit: cover; border-radius: 8px; background: var(--bg); display: inline-grid; place-items: center; color: var(--grey); }
  .sp-badge-st { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 13px; font-weight: 600; white-space: nowrap; }
  .sp-badge-st.amber { background: #FEF3C7; color: #78350F; } .sp-badge-st.blue { background: #DBEAFE; color: #1E3A8A; } .sp-badge-st.green { background: #DCFCE7; color: #14532D; }
  .sp-badge-st.red { background: #FEE2E2; color: #7F1D1D; } .sp-badge-st.grey { background: #E5E7EB; color: #374151; }
  .sp-review-note { margin: 4px 0 0; font-size: 13px; color: #7F1D1D; }
  .sp-actions { white-space: nowrap; }
  .sp-link { background: none; border: 0; color: var(--red); font: 600 15px 'Barlow', sans-serif; text-decoration: underline; cursor: pointer; min-height: 44px; padding: 0 6px; }
  .sp-danger { color: #8E0E14; }
  .sp-empty { color: var(--grey); text-align: center; padding: 20px; }
  .sp-export-opts { display: grid; gap: 0 12px; grid-template-columns: 1fr; }
  .sp-export-btns { display: flex; flex-wrap: wrap; gap: 8px; margin: 4px 0 12px; }
  .sp-export-btns .sp-btn { flex: 1 1 160px; }
  .sp-export-zip { flex-basis: 100% !important; }
  .sp-export-status { margin: 8px 0 0; padding: 10px 12px; border-radius: 10px; background: #DCFCE7; color: #14532D; font-weight: 600; }
  .sp-export-status.err { background: #FDECEC; color: #8E0E14; }
  @media (min-width: 768px) {
    .sp-steps { grid-template-columns: repeat(3, 1fr); } .sp-adds { grid-template-columns: 1fr 1fr; } .sp-export-opts { grid-template-columns: 1fr 1fr; }
    .sp-page-title { font-size: 42px; }
  }

  /* Profile form */
  .sp-form-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 0 0 12px; }
  .sp-back { width: 48px; height: 48px; border-radius: 12px; border: 1px solid var(--line); background: #fff; font-size: 22px; cursor: pointer; }
  .sp-badge-sm { width: 40px; height: 40px; border-width: 2px; }
  .sp-pill { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: #fff; border: 1px solid var(--line); font-size: 14px; font-weight: 600; margin-left: auto; }
  .sp-pill .dot { width: 10px; height: 10px; border-radius: 50%; background: #16A34A; }
  .sp-pill.saving .dot { background: #D97706; } .sp-pill.offline .dot, .sp-pill.error .dot { background: #6B7280; }
  .sp-review { margin: 0 0 12px; padding: 12px 14px; border-radius: 12px; background: #FEE2E2; color: #7F1D1D; }
  .sp-review.sp-view { background: #DBEAFE; color: #1E3A8A; }
  .sp-dup { margin: 0 0 12px; padding: 12px 14px; border-radius: 12px; background: #FEF3C7; color: #78350F; }
  .sp-form { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
  .sp-form > * { min-width: 0; }
  .sp-main { overflow-x: clip; }
  .sp-secnav { position: sticky; top: 64px; z-index: 20; background: var(--bg); padding: 6px 0; }
  .sp-secnav ol { list-style: none; margin: 0; padding: 0; display: flex; gap: 6px; overflow-x: auto; }
  .sp-secnav a { display: inline-flex; align-items: center; min-height: 40px; padding: 4px 12px; border-radius: 999px; background: #fff; border: 1px solid var(--line); color: var(--ink); text-decoration: none; font-weight: 600; font-size: 14px; white-space: nowrap; }
  .sp-key { display: none; font-size: 14px; color: var(--grey); line-height: 2; }
  .sp-key p { margin: 10px 0 0; font-weight: 700; color: var(--ink); }
  .sp-sections { display: grid; gap: 16px; min-width: 0; }
  .sp-sec { scroll-margin-top: 130px; }
  .sp-sec > .sp-h3 { margin-bottom: 12px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .sp-flabel { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; font-weight: 600; font-size: 15px; padding: 0; }
  fieldset.sp-field { border: 0; padding: 0; min-width: 0; }
  .sp-use { display: inline-block; padding: 1px 9px; border-radius: 999px; font: 600 12px/1.6 'Barlow', sans-serif; letter-spacing: .02em; text-transform: none; }
  .sp-use.pub { background: var(--pub-bg); color: var(--pub); } .sp-use.med { background: var(--med-bg); color: var(--med); } .sp-use.prv { background: var(--prv-bg); color: var(--prv); }
  .sp-req { color: var(--red); margin-left: 3px; }
  .sp-opt { color: var(--grey); font-weight: 400; }
  .sp-count { margin: 0; text-align: right; font-size: 13px; color: var(--grey); }
  .sp-types { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .sp-type { min-height: 64px; border-radius: 14px; border: 2px solid #C9CDD4; background: #fff; font: 700 20px 'Barlow Condensed', sans-serif; letter-spacing: .03em; text-transform: uppercase; cursor: pointer; color: var(--ink); }
  .sp-type[aria-checked="true"] { border-color: var(--red); background: #FDECEC; color: var(--red); box-shadow: inset 0 0 0 1px var(--red); }
  .sp-checks { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 6px; }
  .sp-check { display: flex; gap: 10px; align-items: center; min-height: 44px; padding: 6px 10px; border: 1px solid var(--line); border-radius: 10px; background: #fff; cursor: pointer; }
  .sp-check input { width: 22px; height: 22px; flex: none; accent-color: var(--red); }
  .sp-check-lg { align-items: flex-start; padding: 12px; } .sp-check-lg input { margin-top: 2px; }
  .sp-rows { display: grid; gap: 8px; }
  .sp-row { display: grid; grid-template-columns: auto 1fr; gap: 6px 8px; padding: 10px; border: 1px solid var(--line); border-radius: 12px; background: #FAFAFB; }
  .sp-drag { grid-row: span 4; cursor: grab; color: var(--grey); align-self: center; padding: 4px; }
  .sp-cell { display: grid; gap: 2px; font-size: 13px; color: var(--grey); }
  .sp-cell input { min-height: 44px; border: 1.5px solid #C9CDD4; border-radius: 10px; padding: 6px 10px; font: inherit; font-size: 16px; color: var(--ink); width: 100%; }
  .sp-row-btns { display: flex; gap: 6px; justify-content: flex-end; }
  .sp-mini { width: 44px; height: 44px; border-radius: 10px; border: 1px solid var(--line); background: #fff; font-size: 18px; cursor: pointer; }
  .sp-add-row { margin-top: 8px; }
  .sp-warn, .sp-err { margin: 0; padding: 8px 10px; border-radius: 8px; background: #FEF3C7; color: #78350F; font-size: 14px; }
  .sp-err { background: #FDECEC; color: #8E0E14; }
  .sp-invalid input, .sp-invalid select, .sp-invalid textarea { border-color: #B3121A !important; }
  .sp-missing { outline: 3px solid var(--gold); outline-offset: 4px; border-radius: 10px; }
  .sp-audio { display: grid; gap: 6px; margin-top: 6px; }
  .sp-audio-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .sp-audio audio { width: 100%; max-width: 360px; }
  .sp-photo { margin: 0 0 16px; }
  .sp-photo-box { display: grid; grid-template-columns: 120px 1fr; gap: 14px; align-items: start; margin-top: 8px; }
  .sp-photo-prev { width: 120px; aspect-ratio: 4 / 5; border-radius: 12px; background: var(--bg); border: 1px dashed #C9CDD4; display: grid; place-items: center; overflow: hidden; color: var(--grey); font-size: 13px; text-align: center; }
  .sp-photo-prev img { width: 100%; height: 100%; object-fit: cover; }
  .sp-photo-btns { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .sp-photo-btns .sp-hint, .sp-filename, .sp-qwarn { flex-basis: 100%; margin: 0; }
  .sp-filename { font-size: 14px; color: #14532D; font-weight: 600; }
  .sp-qwarn { padding-left: 18px; color: #78350F; font-size: 14px; }
  .sp-guides { margin: 0; padding-left: 20px; color: var(--grey); }
  .sp-minor { margin-top: 12px; padding: 14px; border-radius: 12px; border: 2px solid var(--gold); background: #FFFBEB; }
  .sp-minor .sp-h3 { margin-bottom: 10px; font-size: 18px; }
  .sp-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; background: var(--ink); color: #fff; padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); display: flex; gap: 10px; align-items: center; flex-wrap: wrap; justify-content: flex-end; }
