---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Gate Scanner | Lobi Stars Football Club" description="Matchday ticket scanner for Lobi Stars FC staff." noindex>
  <div class="wrap" style="max-width:520px;padding-top:60px;padding-bottom:60px;min-height:70vh;">
    <div class="stag">Match Day</div>
    <h1 class="stitle">Gate <span class="r">Scanner</span></h1>

    <p id="who" class="muted" style="display:none;margin-top:12px;font-size:14px;"></p>
    <div id="gate-login" class="card" style="padding:24px;margin-top:20px;">
      <p class="muted" style="margin:0 0 12px;font-size:14px;"><b>Ticket stewards: use <a href="/gate-control/">Gate Control</a></b> (your Staff ID and password; scan with your phone, see every ticket's details).</p>
      <p class="muted" style="margin:0 0 12px;font-size:14px;">Matchday helpers: <a href="/helper/">sign in with your username and PIN</a>.</p>
      <label class="muted" style="display:block;margin-bottom:8px;font-size:13px;">Staff Code</label>
      <input id="staff-code" type="password" inputmode="numeric" placeholder="Enter staff code" style="width:100%;padding:12px;border-radius:6px;border:1px solid rgba(255,255,255,.2);background:var(--d3);color:var(--white);font-size:16px;margin-bottom:12px;"/>
      <button id="unlock-btn" class="btn-p" style="width:100%;">Start Scanning</button>
    </div>

    <div id="scan-ui" style="display:none;margin-top:20px;">
      <div class="card" style="padding:18px;margin-bottom:16px;">
        <label class="muted" style="display:block;margin-bottom:8px;font-size:13px;">
          Scan with a physical barcode scanner, or type a ticket code and press Enter:
        </label>
        <input id="ticket-input" type="text" placeholder="LS-TIX-..." autofocus autocomplete="off"
          style="width:100%;padding:14px;border-radius:6px;border:1px solid rgba(255,255,255,.2);background:var(--d3);color:var(--white);font-size:18px;font-family:monospace;"/>
      </div>

      <button id="camera-toggle" class="btn-o" style="width:100%;margin-bottom:16px;">📷 Use Camera Instead</button>
      <div id="camera-box" style="display:none;margin-bottom:16px;"></div>

      <div id="result" style="display:none;padding:28px;border-radius:10px;text-align:center;">
        <div id="result-icon" style="font-size:48px;margin-bottom:10px;"></div>
        <div id="result-title" style="font-family:'Bebas Neue',sans-serif;font-size:28px;letter-spacing:1px;"></div>
        <div id="result-detail" style="margin-top:8px;font-size:14px;"></div>
      </div>

      <div class="muted" id="scan-count" style="margin-top:20px;font-size:12px;text-align:center;">0 tickets scanned this session</div>
    </div>
  </div>
</Layout>

<script is:inline>
(function () {
  let staffCode = sessionStorage.getItem('ls_staff_code') || '';
  let scanCount = 0;

  const gateLogin = document.getElementById('gate-login');
  const scanUi = document.getElementById('scan-ui');
  const ticketInput = document.getElementById('ticket-input');
  const result = document.getElementById('result');
  const resultIcon = document.getElementById('result-icon');
  const resultTitle = document.getElementById('result-title');
  const resultDetail = document.getElementById('result-detail');
  const scanCountEl = document.getElementById('scan-count');
  const cameraToggle = document.getElementById('camera-toggle');
  const cameraBox = document.getElementById('camera-box');

  function unlock() {
    const code = document.getElementById('staff-code').value.trim();
    if (!code) return;
    staffCode = code;
    sessionStorage.setItem('ls_staff_code', code);
    gateLogin.style.display = 'none';
    scanUi.style.display = 'block';
    ticketInput.focus();
  }
  document.getElementById('unlock-btn').addEventListener('click', unlock);
  document.getElementById('staff-code').addEventListener('keydown', e => { if (e.key === 'Enter') unlock(); });

  if (staffCode) {
    gateLogin.style.display = 'none';
    scanUi.style.display = 'block';
  }
  // Signed in as a matchday helper (or staff with gate access): no staff code needed; the name goes on each scan.
  let signedIn = false;
  fetch('/api/admin/me', { headers: { 'x-admin-code': '__session__' }, cache: 'no-store' }).then(r => r.ok ? r.json() : null).then(d => {
    const a = d && d.admin;
    if (!a || !(a.permissions || []).includes('commerce.gate_scan')) return;
    signedIn = true;
    gateLogin.style.display = 'none';
    scanUi.style.display = 'block';
    const who = document.getElementById('who');
    const until = a.helperUntil ? ' · works until ' + new Date(a.helperUntil).toLocaleString('en-GB', { timeZone: 'Africa/Lagos', weekday: 'short', hour: '2-digit', minute: '2-digit' }) : '';
    who.textContent = 'Signed in as ' + a.name + until;
    who.style.display = 'block';
    ticketInput.focus();
  }).catch(() => {});

  async function validateTicket(rawInput) {
    // The QR now encodes a public verify URL (https://lobistarsfc.com/verify/<id>)
    // so a normal phone camera shows something meaningful, not a bare code --
    // pull the ticket ID back out of it here. Manual typing and physical
    // barcode scanners still send the bare ID directly, unaffected.
    let ticketId = rawInput;
    if (/^https?:\/\//i.test(rawInput)) {
      try {
        const parts = new URL(rawInput).pathname.split('/').filter(Boolean);
        ticketId = parts[parts.length - 1] || rawInput;
      } catch { /* fall through and try the raw input as-is */ }
    }
    ticketInput.value = '';
    result.style.display = 'block';
    resultIcon.textContent = '⏳';
    resultTitle.textContent = 'Checking...';
    resultDetail.textContent = '';
    result.style.background = 'rgba(255,255,255,.05)';

    try {
      const res = await fetch('/api/validate-ticket', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ticketId, staffCode, station: navigator.userAgent.slice(0, 40) }),
      });
      const data = await res.json();

      if (res.status === 401) {
        if (signedIn) { alert('Your helper login has finished or was switched off. Sign in again.'); location.href = '/helper/'; return; }
        sessionStorage.removeItem('ls_staff_code');
        alert('Staff code rejected. Please re-enter it.');
        location.reload();
        return;
      }

      if (data.valid) {
        scanCount++;
        scanCountEl.textContent = `${scanCount} ticket${scanCount === 1 ? '' : 's'} scanned this session`;
        result.style.background = 'rgba(76,175,80,.15)';
        resultIcon.textContent = '✅';
        // ADULT or CHILD (family bundle): staff may ask for proof of a child's age.
        const child = data.ticketType === 'child';
        resultTitle.textContent = child ? 'VALID: ADMIT CHILD' : 'VALID: ADMIT ADULT';
        // Plain text only: the buyer's name is typed by the buyer.
        resultDetail.replaceChildren(child ? 'CHILD ticket: check age if unsure.' : 'ADULT ticket', document.createElement('br'), `${data.ticket.buyer_name} · ${({ VIP: 'VIP Sitting', Premium: 'Grand Stand', Regular: 'Popular Stand' })[data.ticket.tier] || data.ticket.tier}`, document.createElement('br'), `${data.ticket.home_team} vs ${data.ticket.away_team}`);
      } else {
        // Amber for a ticket to another match, red for everything else.
        const wrong = data.code === 'wrong_match';
        result.style.background = wrong ? 'rgba(245,158,11,.22)' : 'rgba(212,32,43,.15)';
        resultIcon.textContent = wrong ? '⚠️' : '⛔';
        resultTitle.textContent = wrong ? 'WRONG MATCH' : data.code === 'used' ? 'ALREADY USED' : 'DO NOT ADMIT';
        resultDetail.textContent = data.reason || 'Invalid ticket';
      }
    } catch (err) {
      result.style.background = 'rgba(212,32,43,.15)';
      resultIcon.textContent = '⚠️';
      resultTitle.textContent = 'Connection Error';
      resultDetail.textContent = 'Check your network and try again.';
    }

    setTimeout(() => { ticketInput.focus(); }, 150);
  }

  ticketInput.addEventListener('keydown', e => {
    if (e.key === 'Enter' && ticketInput.value.trim()) {
      validateTicket(ticketInput.value.trim());
    }
  });
  // Physical barcode scanners emulate typing + Enter, but some emulate just
  // rapid keystrokes without a final Enter -- refocus keeps the field ready.
  document.addEventListener('click', () => { if (scanUi.style.display !== 'none') ticketInput.focus(); });

  // The phone's own camera (works on iPhone and Android): a <video playsinline muted> and,
  // about 8 times a second, the phone's built-in QR reader or jsQR (kept on this website).
  let stream = null, loop = 0, detector = null, last = '', lastAt = 0;
  const grab = document.createElement('canvas'), gctx = grab.getContext('2d', { willReadFrequently: true });
  const loadJsQR = () => window.jsQR ? Promise.resolve() : new Promise((ok, fail) => { const sc = document.createElement('script'); sc.src = '/vendor/jsqr-1.4.0.min.js'; sc.onload = ok; sc.onerror = fail; document.head.appendChild(sc); });
  function stopCam() {
    clearTimeout(loop); if (stream) stream.getTracks().forEach(t => t.stop()); stream = null;
    cameraBox.style.display = 'none'; cameraBox.innerHTML = ''; cameraToggle.textContent = '📷 Use Camera Instead';
  }
  async function readFrame(v) {
    const w = v.videoWidth, h = v.videoHeight; if (!w || v.readyState < 2) return null;
    if (detector) { try { const r = await detector.detect(v); return r[0] ? r[0].rawValue : null; } catch (e) { detector = null; await loadJsQR(); } }
    if (!window.jsQR) return null;
    const side = Math.min(w, h), size = Math.min(640, side); grab.width = size; grab.height = size;
    gctx.drawImage(v, (w - side) / 2, (h - side) / 2, side, side, 0, 0, size, size);
    const c = window.jsQR(gctx.getImageData(0, 0, size, size).data, size, size, { inversionAttempts: 'attemptBoth' });
    return c ? c.data : null;
  }
  cameraToggle.addEventListener('click', async () => {
    if (stream) { stopCam(); ticketInput.focus(); return; }
    try {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) throw new Error('no camera api');
      stream = await navigator.mediaDevices.getUserMedia({ audio: false, video: { facingMode: { ideal: 'environment' } } });
      cameraBox.style.display = 'block';
      cameraBox.innerHTML = '<video playsinline muted autoplay style="width:100%;aspect-ratio:1/1;object-fit:cover;background:#000;border-radius:10px;display:block"></video>';
      cameraToggle.textContent = '⌨️ Use Keyboard/Scanner Instead';
      const v = cameraBox.querySelector('video'); v.muted = true; v.srcObject = stream; await v.play().catch(() => {});
      if (window.BarcodeDetector) { try { if ((await BarcodeDetector.getSupportedFormats()).includes('qr_code')) detector = new BarcodeDetector({ formats: ['qr_code'] }); } catch (e) { detector = null; } }
      if (!detector) await loadJsQR();
      const tick = async () => {
        if (!stream) return;
        try { const text = await readFrame(v); const now = Date.now(); if (text && (text !== last || now - lastAt > 4000)) { last = text; lastAt = now; validateTicket(text.trim()); } } catch (e) { /* next frame */ }
        loop = setTimeout(tick, 120);
      };
      tick();
    } catch (e) {
      stopCam();
      alert(/NotAllowed|Permission/i.test(String(e && e.name)) ? 'The camera is blocked. Allow the camera for lobistarsfc.com in the browser settings, then try again.' : 'Could not start the camera. Use the keyboard/scanner input instead.');
    }
  });
})();
</script>
