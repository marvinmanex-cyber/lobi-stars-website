---
// /tickets/lookup -- re-open your tickets with the email you paid with and
// the order reference from your email (rate-limited: /api/tickets/lookup).
import Layout from '../../layouts/Layout.astro';
import TicketsView from '../../components/tickets/TicketsView.astro';
---
<Layout title="Find My Tickets | Lobi Stars Football Club" description="Lost your ticket email? Re-open your Lobi Stars FC match tickets with your email address and order reference." noindex>
  <div class="page-hero wrap">
    <div class="stag">Tickets</div>
    <h1 class="stitle">Find my <span class="r">tickets</span></h1>
    <div class="divr"></div>
  </div>
  <div class="page-content wrap">
    <form class="lk" id="lk" novalidate>
      <label>Email you paid with<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
      <label>Order reference (in your ticket email, e.g. LSBAS-…)<input name="reference" required maxlength="40" autocapitalize="characters" /></label>
      <p class="lk-err" id="lkErr" role="alert"></p>
      <button class="btn-p" type="submit">Show my tickets</button>
    </form>
    <p class="lk-msg" id="lkMsg" role="status" aria-live="polite"></p>
    <div id="lkTickets"></div>
    <a class="lk-food" href="/kitchen/?utm_source=find_tickets" data-track="kitchen_click" data-track-label="find_tickets">
      <img src="/images/matchday-kitchen/logo-96.png" alt="" width="56" height="56" loading="lazy" />
      <span><b>On match day: MatchDay Kitchen</b>Order food and drinks to your seat. Order ahead for kick-off or half-time.</span>
      <span class="lk-food-go">Order food →</span>
    </a>
  </div>
  <TicketsView />
</Layout>
<style>
  .lk-food { display: flex; align-items: center; gap: 14px; max-width: 640px; margin: 28px 0 0; padding: 14px 16px; border-radius: 14px; background: #0E7A26; color: #fff; text-decoration: none; }
  .lk-food img { width: 56px; height: 56px; border-radius: 50%; flex: none; }
  .lk-food b { display: block; font: 700 17px/1.2 'Barlow Condensed', sans-serif; letter-spacing: .04em; text-transform: uppercase; color: #FFE27A; }
  .lk-food span { font-size: 15px; line-height: 1.4; }
  .lk-food-go { margin-left: auto; padding: 10px 14px; border-radius: 10px; background: #fff; color: #0E7A26; font: 700 15px/1 'Barlow Condensed', sans-serif !important; white-space: nowrap; }
  @media (max-width: 520px) { .lk-food { flex-wrap: wrap; } .lk-food-go { margin-left: 0; } }
</style>

<style>
  .lk { display: grid; gap: 12px; max-width: 520px; margin-bottom: 24px; }
  .lk label { display: grid; gap: 6px; font-weight: 700; font-size: 14px; }
  .lk input { min-height: 46px; border: 1.5px solid var(--d4); border-radius: 8px; padding: 8px 12px; font: 400 16px 'Barlow', sans-serif; background: var(--d2); color: var(--white); }
  .lk .btn-p { min-height: 48px; justify-self: start; }
  .lk-err { margin: 0; color: #A3161B; font-weight: 700; }
  .lk-err:empty, .lk-msg:empty { display: none; }
  .lk-msg { font-weight: 600; }
</style>

<script is:inline>
(function () {
  var f = document.getElementById('lk');
  f.addEventListener('submit', function (e) {
    e.preventDefault();
    var err = document.getElementById('lkErr'); err.textContent = '';
    var btn = f.querySelector('button'); btn.disabled = true;
    fetch('/api/tickets/lookup', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: f.email.value, reference: f.reference.value }) })
      .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
      .then(function (res) {
        btn.disabled = false;
        if (!res.ok) { err.textContent = res.d.error || 'Something went wrong.'; return; }
        var n = window.lsRenderTickets(document.getElementById('lkTickets'), res.d);
        document.getElementById('lkMsg').textContent = n + ' ticket' + (n === 1 ? '' : 's') + ' for order ' + res.d.reference + '.';
      })
      .catch(function () { btn.disabled = false; err.textContent = 'No connection. Please try again.'; });
  });
})();
</script>
