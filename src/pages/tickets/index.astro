---
// /tickets -- buy tickets for one or several Lobi Stars home matches in one
// payment. Every home match from Matchday 1 is listed with its stands, prices
// and seats left (from /api/tickets/catalogue); matches not on sale, sold out
// or already played can't be ticked. "?event=<id>" pre-selects a match.
// Paying: /api/tickets/basket (Paystack). Season Tickets (one QR for every
// home match) are suggested when every remaining home match is selected.
import Layout from '../../layouts/Layout.astro';
import settings from '../../data/fan-settings.json';
const siteKey = settings.turnstileSiteKey;
---
<Layout title="Buy Tickets | Lobi Stars Football Club" description="Buy Lobi Stars FC home match tickets online: one match or the whole season in one payment, with QR-code tickets by email.">
  <div class="page-hero wrap">
    <div class="stag">Match Day</div>
    <h1 class="stitle">Buy <span class="r">Tickets</span></h1>
    <div class="divr"></div>
    <p class="tk-lede">Tick the home matches you want, choose a stand and how many tickets, then pay once. Your QR-code tickets arrive by email straight away. <a href="/tickets/lookup/">Find my tickets</a> · <a href="/food/">Order food to your seat</a></p>
  </div>
  <div class="page-content wrap">
    <div class="tk" data-tickets>
      <div class="tk-main">
        <!-- Shown only while season tickets are on sale (Admin › Commerce › Season Tickets). -->
        <a class="tk-seasonbar" id="seasonBanner" href="/season-tickets/" hidden><span><b>Season tickets</b><span id="seasonBannerText">One ticket for every home match.</span></span><span class="tk-seasonbtn">Buy a season ticket &rarr;</span></a>
        <div class="tk-tools">
          <button type="button" class="tk-tool" id="selAll">Select all home matches</button>
          <button type="button" class="tk-tool" id="selNext3">Select next 3 matches</button>
          <button type="button" class="tk-tool" id="selNone">Clear</button>
          <label class="tk-f">Stand for all ticked
            <select id="allTier"><option value="">Keep as is</option><option value="VIP">VIP Sitting</option><option value="Premium">Cover Stand</option><option value="Regular">Popular Stand</option></select>
          </label>
        </div>
        <p class="tk-msg" id="tkMsg" role="status" aria-live="polite"></p>
        <ol class="tk-list" id="tkList"><li class="tk-empty">Loading the home matches…</li></ol>
        <div class="tk-bar" id="tkBar" hidden><span><span id="barCount"></span> · <b id="barTotal"></b></span><a href="#sumH">Checkout</a></div>
      </div>
      <aside class="tk-sum" aria-labelledby="sumH">
        <h2 id="sumH">Your order</h2>
        <ul class="tk-sum-lines" id="sumLines"><li class="tk-muted">No matches selected yet.</li></ul>
        <p class="tk-total">Total <b id="sumTotal">₦0</b></p>
        <p class="tk-season" id="sumSeason" hidden></p>
        <form id="buyForm" class="tk-form" novalidate>
          <label class="tk-f">Full name<input name="buyerName" autocomplete="name" required maxlength="80" /></label>
          <label class="tk-f">Email (tickets are sent here)<input name="buyerEmail" type="email" autocomplete="email" required maxlength="254" /></label>
          <label class="tk-f">Phone<input name="buyerPhone" type="tel" autocomplete="tel" required placeholder="0803 123 4567" /></label>
          {siteKey && <div class="cf-turnstile" data-sitekey={siteKey}></div>}
          <p class="tk-err" id="buyErr" role="alert"></p>
          <button type="submit" class="btn-p tk-pay" id="payBtn" disabled>Pay with Paystack</button>
          <p class="tk-small">Card, bank transfer or USSD, handled securely by Paystack. One QR code per ticket; each admits one person, once, on the day of its match. By buying you agree to our <a href="/terms/">Terms</a>.</p>
        </form>
      </aside>
    </div>
  </div>
  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Layout>

<style>
  .tk-lede { margin: -10px 0 0; color: var(--lt); font-size: 15px; line-height: 1.6; max-width: 760px; }
  .tk-lede a { color: var(--red-text); font-weight: 700; }
  .tk { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; width: 100%; }
  @media (min-width: 1000px) { .tk { grid-template-columns: minmax(0, 1fr) 360px; align-items: start; } .tk-sum { position: sticky; top: 90px; } }
  .tk-seasonbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin: 0 0 16px; padding: 14px 18px; border-radius: 12px; background: #15181D; color: #fff; text-decoration: none; }
  .tk-seasonbar b { display: block; font: 400 22px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .tk-seasonbar span span { color: rgba(255,255,255,.85); font-size: 14px; }
  .tk-seasonbtn { background: #FFC72C; color: #15181D !important; font-weight: 700; padding: 10px 16px; border-radius: 999px; min-height: 24px; }
  .tk-tools { display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-end; margin-bottom: 14px; }
  .tk-tool { min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1.5px solid var(--d4); background: var(--d2); color: var(--white); font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; }
  .tk-tool:hover, .tk-tool:focus-visible { border-color: var(--red); color: var(--red-text); }
  .tk-f { display: grid; gap: 5px; font-weight: 700; font-size: 13px; }
  .tk-f input, .tk-f select, .tk :global(.tk-row select) { min-height: 44px; border: 1.5px solid var(--d4); border-radius: 8px; padding: 8px 10px; font: 400 16px 'Barlow', sans-serif; background: var(--d2); color: var(--white); box-sizing: border-box; width: 100%; }
  .tk-msg { margin: 0 0 10px; font-weight: 600; }
  .tk-msg:empty { display: none; }
  .tk-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .tk-empty, .tk-muted { color: var(--lt); }
  .tk :global(.tk-row) { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12px; align-items: start; padding: 14px 16px; border: 1.5px solid var(--d4); border-radius: 12px; background: var(--d2); }
  .tk :global(.tk-row.on) { border-color: var(--red); box-shadow: 0 0 0 1px var(--red); }
  .tk :global(.tk-row.off) { opacity: .55; }
  .tk :global(.tk-row input[type=checkbox]) { width: 24px; height: 24px; margin: 10px 0 0; accent-color: #E31E24; }
  .tk :global(.tk-row label.tk-check) { display: flex; align-items: flex-start; min-width: 44px; min-height: 44px; cursor: pointer; }
  .tk :global(.tk-head) { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; }
  .tk :global(.tk-head b) { font: 400 22px/1.1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .tk :global(.tk-meta) { color: var(--lt); font-size: 14px; line-height: 1.5; }
  .tk :global(.tk-state) { font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; padding: 6px 9px; border-radius: 4px; background: var(--d3); align-self: start; }
  .tk :global(.tk-state.out) { background: #FDECEC; color: #A3161B; }
  .tk :global(.tk-pick) { display: grid; grid-template-columns: minmax(0, 1fr) 110px; gap: 10px; margin-top: 10px; }
  .tk :global(.tk-pick[hidden]) { display: none; }
  .tk-sum { background: var(--d2); border: 1.5px solid var(--d4); border-radius: 14px; padding: 18px; }
  .tk-sum h2 { margin: 0 0 10px; font: 400 26px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .tk-sum-lines { list-style: none; margin: 0 0 10px; padding: 0; display: grid; gap: 6px; font-size: 14px; }
  .tk :global(.tk-sum-lines li) { display: flex; justify-content: space-between; gap: 10px; }
  .tk-total { display: flex; justify-content: space-between; font-size: 18px; margin: 10px 0; padding-top: 10px; border-top: 1px solid var(--d4); }
  .tk-season { background: #FFF7E6; color: #7A4B00; padding: 10px 12px; border-radius: 8px; font-size: 14px; line-height: 1.5; }
  .tk-season a { color: #7A4B00; font-weight: 700; }
  .tk-form { display: grid; gap: 12px; margin-top: 12px; }
  .tk-err { margin: 0; color: #A3161B; font-weight: 700; }
  .tk-err:empty { display: none; }
  .tk-pay { min-height: 52px; font-size: 16px; }
  .tk-pay:disabled { opacity: .5; cursor: not-allowed; }
  .tk-small { margin: 0; color: var(--lt); font-size: 13px; line-height: 1.5; }
  .tk [hidden] { display: none !important; }
  /* Phones: the order sits under the list; a slim bar keeps the total in view. */
  .tk-bar { display: none; }
  @media (max-width: 999px) {
    .tk-bar:not([hidden]) { display: flex; position: sticky; bottom: 72px; z-index: 5; justify-content: space-between; align-items: center; gap: 10px; margin-top: 12px; padding: 10px 14px; border-radius: 12px; background: #15181D; color: #fff; box-shadow: 0 -6px 20px rgba(15,17,21,.18); }
    .tk-bar b { font-size: 18px; }
    .tk-bar a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: 999px; background: var(--red); color: #fff; text-decoration: none; font-weight: 700; }
  }
</style>

<script is:inline>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var naira = function (k) { return '₦' + Math.round(k / 100).toLocaleString('en-NG'); };
  var el = function (tag, props) { var n = document.createElement(tag); Object.keys(props || {}).forEach(function (k) { var v = props[k]; if (v == null || v === false) return; if (k === 'text') n.textContent = v; else if (k === 'class') n.className = v; else if (k.slice(0, 2) === 'on') n.addEventListener(k.slice(2), v); else n.setAttribute(k, v === true ? '' : v); }); for (var i = 2; i < arguments.length; i++) { var c = arguments[i]; if (c != null && c !== false) n.append(c); } return n; };
  var TZ = 'Africa/Lagos';
  var STATE = { on_sale: '', sold_out: 'Sold out', not_on_sale: 'Not on sale yet', closed: 'Played or closed' };
  var matches = [], rows = new Map(), season = null;
  var pre = new URLSearchParams(location.search).get('event');

  function draw() {
    var list = $('tkList'); list.replaceChildren();
    if (!matches.length) { list.append(el('li', { class: 'tk-empty' }, 'No home matches yet. See the ', el('a', { href: '/fixtures/', text: 'fixtures' }), '.')); return; }
    matches.forEach(function (m) {
      var can = m.state === 'on_sale';
      var cb = el('input', { type: 'checkbox', 'aria-label': 'Buy tickets: ' + m.homeTeam + ' vs ' + m.awayTeam, disabled: !can });
      var tier = el('select', { 'aria-label': 'Stand' });
      m.tiers.forEach(function (t) { tier.add(new Option(t.label + ' · ' + naira(t.priceKobo) + (t.left !== null ? ' · ' + t.left + ' left' : ''), t.tier, false, false)); if (t.left === 0) tier.options[tier.options.length - 1].disabled = true; });
      var firstOpen = m.tiers.find(function (t) { return t.left !== 0; }); if (firstOpen) tier.value = firstOpen.tier;
      var qty = el('select', { 'aria-label': 'Number of tickets' });
      var fillQty = function () { var t = m.tiers.find(function (x) { return x.tier === tier.value; }); var max = Math.min(m.maxPerOrder, t && t.left !== null ? t.left : m.maxPerOrder); var cur = Number(qty.value) || 1; qty.replaceChildren(); for (var i = 1; i <= Math.max(1, max); i++) qty.add(new Option(i + ' ticket' + (i === 1 ? '' : 's'), i, false, i === Math.min(cur, max))); };
      fillQty();
      var pick = el('div', { class: 'tk-pick', hidden: true }, el('label', { class: 'tk-f' }, 'Stand', tier), el('label', { class: 'tk-f' }, 'Tickets', qty));
      var when = new Date(m.kickoff);
      var date = when.toLocaleDateString('en-GB', { timeZone: TZ, weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) + ', ' + when.toLocaleTimeString('en-US', { timeZone: TZ, hour: 'numeric', minute: '2-digit' }) + ' WAT';
      var low = m.tiers.length ? Math.min.apply(null, m.tiers.map(function (t) { return t.priceKobo; })) : 0;
      var left = m.tiers.some(function (t) { return t.left !== null; }) ? m.tiers.reduce(function (s, t) { return s + (t.left || 0); }, 0) : null;
      var stateText = m.state === 'not_on_sale' && m.opensAt ? 'On sale from ' + new Date(m.opensAt).toLocaleDateString('en-GB', { timeZone: TZ, day: 'numeric', month: 'short' }) : STATE[m.state];
      var row = el('li', { class: 'tk-row' + (can ? '' : ' off') },
        el('label', { class: 'tk-check' }, cb),
        el('div', {},
          el('div', { class: 'tk-head' }, el('b', { text: (m.matchday ? 'Matchday ' + m.matchday + ': ' : '') + 'Lobi Stars vs ' + m.awayTeam.replace(/\s+FC$/, '') }), stateText ? el('span', { class: 'tk-state' + (m.state === 'sold_out' ? ' out' : ''), text: stateText }) : null),
          el('div', { class: 'tk-meta', text: date + ' · ' + m.venue + (can && low ? ' · from ' + naira(low) : '') + (can && left !== null ? ' · ' + left + ' left' : '') }),
          pick));
      var r = { m: m, cb: cb, tier: tier, qty: qty, row: row, pick: pick };
      cb.addEventListener('change', function () { pick.hidden = !cb.checked; row.classList.toggle('on', cb.checked); summary(); });
      tier.addEventListener('change', function () { fillQty(); summary(); });
      qty.addEventListener('change', summary);
      rows.set(m.id, r);
      list.append(row);
      if (pre && pre === m.id && can) { cb.checked = true; pick.hidden = false; row.classList.add('on'); }
    });
    summary();
  }

  function selected() { return Array.from(rows.values()).filter(function (r) { return r.cb.checked; }); }
  function set(r, on) { if (r.cb.disabled) return; r.cb.checked = on; r.pick.hidden = !on; r.row.classList.toggle('on', on); }
  $('selAll').addEventListener('click', function () { rows.forEach(function (r) { set(r, true); }); summary(); });
  $('selNext3').addEventListener('click', function () { var n = 0; rows.forEach(function (r) { var on = !r.cb.disabled && n < 3; if (on) n++; set(r, on); }); summary(); });
  $('selNone').addEventListener('click', function () { rows.forEach(function (r) { set(r, false); }); summary(); });
  $('allTier').addEventListener('change', function () { var v = this.value; if (!v) return; selected().forEach(function (r) { var o = Array.from(r.tier.options).find(function (x) { return x.value === v && !x.disabled; }); if (o) { r.tier.value = v; r.tier.dispatchEvent(new Event('change')); } }); summary(); });

  function summary() {
    var sel = selected(), total = 0, lines = $('sumLines');
    lines.replaceChildren();
    if (!sel.length) lines.append(el('li', { class: 'tk-muted', text: 'No matches selected yet.' }));
    var basket = sel.map(function (r) {
      var t = r.m.tiers.find(function (x) { return x.tier === r.tier.value; }), q = Number(r.qty.value) || 1, sub = t.priceKobo * q;
      total += sub;
      lines.append(el('li', {}, el('span', { text: 'Lobi Stars vs ' + r.m.awayTeam.replace(/\s+FC$/, '') + ' · ' + t.label + ' × ' + q }), el('b', { text: naira(sub) })));
      return { eventId: r.m.id, tier: t.tier, quantity: q, unitKobo: t.priceKobo };
    });
    $('sumTotal').textContent = naira(total);
    $('tkBar').hidden = !sel.length;
    $('barTotal').textContent = naira(total);
    $('barCount').textContent = sel.length + ' match' + (sel.length === 1 ? '' : 'es');
    $('payBtn').disabled = !sel.length;
    $('payBtn').textContent = sel.length ? 'Pay ' + naira(total) + ' with Paystack' : 'Pay with Paystack';
    // Season Ticket saving: every remaining home match on sale, one stand, same number of tickets.
    var onSale = matches.filter(function (m) { return m.state === 'on_sale'; }).map(function (m) { return m.id; });
    var s = $('sumSeason'); s.hidden = true;
    if (season && season.enabled && basket.length && onSale.every(function (id) { return basket.some(function (b) { return b.eventId === id; }); })) {
      var tiers = Array.from(new Set(basket.map(function (b) { return b.tier; }))), qs = Array.from(new Set(basket.map(function (b) { return b.quantity; })));
      var st = tiers.length === 1 && qs.length === 1 ? (season.tiers || []).find(function (t) { return t.tier === tiers[0]; }) : null;
      if (st && st.priceKobo * qs[0] < total) { s.replaceChildren('Tip: a ', el('a', { href: '/season-tickets/', text: 'Season Ticket' }), ' covers every home match for ' + naira(st.priceKobo * qs[0]) + ' (save ' + naira(total - st.priceKobo * qs[0]) + ').'); s.hidden = false; }
    }
    return basket;
  }

  function load() {
    fetch('/api/tickets/catalogue', { cache: 'no-store' }).then(function (r) { if (!r.ok) throw new Error(); return r.json(); }).then(function (d) {
      matches = d.matches || []; rows.clear(); draw();
    }).catch(function () { $('tkList').replaceChildren(el('li', { class: 'tk-empty' }, 'The matches could not be loaded. Please refresh the page.')); });
  }
  fetch('/api/season-tickets').then(function (r) { return r.json(); }).then(function (d) {
    season = d; summary();
    if (d.enabled && d.tiers && d.tiers.length) { $('seasonBannerText').textContent = 'Every home match of the ' + d.season + ' season, from ' + naira(Math.min.apply(null, d.tiers.map(function (t) { return t.priceKobo; }))) + '.'; $('seasonBanner').hidden = false; }
  }).catch(function () {});
  load();

  $('buyForm').addEventListener('submit', function (e) {
    e.preventDefault();
    var f = this, err = $('buyErr'); err.textContent = '';
    var lines = summary().map(function (l) { return { eventId: l.eventId, tier: l.tier, quantity: l.quantity }; });
    if (!lines.length) { err.textContent = 'Tick at least one match.'; return; }
    var tokenEl = f.querySelector('[name="cf-turnstile-response"]');
    $('payBtn').disabled = true;
    fetch('/api/tickets/basket', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ lines: lines, buyerName: f.buyerName.value, buyerEmail: f.buyerEmail.value, buyerPhone: f.buyerPhone.value, turnstileToken: tokenEl ? tokenEl.value : '' }) })
      .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
      .then(function (res) {
        if (res.ok && res.d.authorizationUrl) { location.href = res.d.authorizationUrl; return; }
        err.textContent = res.d.error || 'Something went wrong. Please try again.';
        // A match that just sold out: untick it so the rest can be paid in one click.
        if (res.d.soldOut && res.d.eventId && rows.get(res.d.eventId)) { set(rows.get(res.d.eventId), false); summary(); load(); }
        if (window.turnstile && window.turnstile.reset) window.turnstile.reset();
        $('payBtn').disabled = !selected().length;
      })
      .catch(function () { err.textContent = 'No connection. Please try again.'; $('payBtn').disabled = false; });
  });
})();
</script>
