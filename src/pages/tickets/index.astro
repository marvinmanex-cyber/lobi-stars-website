---
// /tickets -- buy tickets for one or several Lobi Stars home matches in one
// payment. Every home match from Matchday 1 is listed with its stands, prices
// and seats left (from /api/tickets/catalogue); matches not on sale, sold out
// or already played can't be ticked. "?event=<id>" pre-selects a match.
// Paying: /api/tickets/basket (Paystack). Season Tickets (one QR for every
// home match) are suggested when every remaining home match is selected.
// Look (14 Oct 2026): stadium hero with the next match, 3-step progress,
// ticket-style match cards, stand cards, a sticky order summary (a slide-up
// sheet on phones), cross-sell and FAQ. The buying logic is unchanged: the
// per-match stand and quantity are still <select>s (hidden), driven by the
// visual controls, so selection, prices, totals and payment work as before.
import Layout from '../../layouts/Layout.astro';
import settings from '../../data/fan-settings.json';
import { TEAM_LOGOS } from '../../../functions/api/_lib/teamLogos.js';
const siteKey = settings.turnstileSiteKey;
const LOGOS = { ...TEAM_LOGOS, 'Lobi Stars FC': '/images/lobi-stars-badge.png', 'Lobi Stars': '/images/lobi-stars-badge.png' };
---
<Layout title="Buy Tickets | Lobi Stars Football Club" description="Buy Lobi Stars FC home match tickets online: one match or the whole season in one payment, with QR-code tickets by email.">
  <div class="tk" data-tickets>
    <!-- A. Hero -->
    <section class="tk-hero" aria-labelledby="tkTitle">
      <picture>
        <source type="image/webp" srcset="/images/hero-2-480w.webp 480w, /images/hero-2-960w.webp 960w, /images/hero-2.webp 1600w" sizes="100vw" />
        <img class="tk-hero-bg" src="/images/hero-2.jpg" alt="" width="1600" height="900" decoding="async" fetchpriority="high" />
      </picture>
      <div class="tk-hero-in">
        <div class="tk-hero-text">
          <p class="tk-kicker">Lobi Stars home matches · McCarthy Stadium</p>
          <h1 class="tk-h1" id="tkTitle">Buy <span>Tickets</span></h1>
          <p class="tk-sub">Be there when the Pride of Benue plays.</p>
          <ul class="tk-chips">
            <li><span class="tk-chip"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><path d="M14 14h3v3h-3zM18 18h3v3h-3z" /></svg>QR tickets by email</span></li>
            <li><span class="tk-chip"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>Secure Paystack payment</span></li>
            <li><a class="tk-chip tk-chip--link" href="/tickets/lookup/"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-4-4" /></svg>Find my tickets</a></li>
          </ul>
        </div>
        <div class="tk-next" id="tkNext" aria-live="polite">
          <p class="tk-next-k">Next home match</p>
          <div class="tk-next-skel" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <div class="tk-wrap">
      <!-- B. Progress -->
      <ol class="tk-steps" id="tkSteps" aria-label="Your progress">
        <li data-step="1" class="now"><span>1</span>Choose matches</li>
        <li data-step="2"><span>2</span>Choose your stand</li>
        <li data-step="3"><span>3</span>Pay</li>
      </ol>

      <!-- Shown only while season tickets are on sale (Admin › Commerce › Season Tickets). -->
      <a class="tk-seasonbar" id="seasonBanner" href="/season-tickets/" hidden><span><b>Season tickets</b><span id="seasonBannerText">One ticket for every home match.</span></span><span class="tk-seasonbtn">Buy a season ticket &rarr;</span></a>

      <div class="tk-grid">
        <div class="tk-main">
          <!-- C. Matches -->
          <h2 class="tk-h2">1. Choose your matches</h2>
          <div class="tk-tools" role="group" aria-label="Quick select">
            <button type="button" class="tk-tool" id="selAll">Select all home matches</button>
            <button type="button" class="tk-tool" id="selNext3">Select next 3 matches</button>
            <button type="button" class="tk-tool" id="selNone">Clear</button>
          </div>
          <p class="tk-msg" id="tkMsg" role="status" aria-live="polite"></p>
          <ol class="tk-list" id="tkList" aria-busy="true">
            <li class="tk-skel" aria-hidden="true"></li><li class="tk-skel" aria-hidden="true"></li><li class="tk-skel" aria-hidden="true"></li>
            <li class="tk-sr">Loading the home matches…</li>
          </ol>

          <!-- D. Stands -->
          <h2 class="tk-h2" id="standsH">2. Choose your stand</h2>
          <p class="tk-hint">Pick a stand for every match you've ticked, or change it on each match card.</p>
          <div class="tk-stands" id="tkStands" role="radiogroup" aria-labelledby="standsH">
            <!-- The stand cards are filled in from the match data (prices); descriptions below. -->
          </div>
          <!-- The existing "Stand for all ticked" control (hidden; the stand cards drive it). -->
          <label class="tk-sr">Stand for all ticked
            <select id="allTier" tabindex="-1"><option value="">Not chosen</option><option value="VIP">VIP Sitting</option><option value="Premium">Cover Stand</option><option value="Regular">Popular Stand</option></select>
          </label>
        </div>

        <!-- E + F. Order summary and checkout (a slide-up sheet on phones) -->
        <aside class="tk-sum" id="tkSum" aria-labelledby="sumH">
          <div class="tk-sum-head">
            <h2 id="sumH">3. Your order</h2>
            <button type="button" class="tk-sheet-x" id="sheetClose" aria-label="Close your order">&times;</button>
          </div>
          <ul class="tk-sum-lines" id="sumLines"><li class="tk-muted">No matches selected yet.</li></ul>
          <p class="tk-total"><span>Total</span><b id="sumTotal" aria-hidden="true">₦0</b><span class="tk-sr" id="sumTotalLive" aria-live="polite">Total ₦0</span></p>
          <p class="tk-season" id="sumSeason" hidden></p>
          <form id="buyForm" class="tk-form" novalidate>
            <div class="tk-fl"><input id="fName" name="buyerName" autocomplete="name" required maxlength="80" placeholder=" " /><label for="fName">Full name</label></div>
            <div class="tk-fl"><input id="fEmail" name="buyerEmail" type="email" autocomplete="email" required maxlength="254" placeholder=" " /><label for="fEmail">Email (tickets are sent here)</label><p class="tk-inline" id="fEmailMsg" aria-live="polite"></p></div>
            <div class="tk-fl"><input id="fPhone" name="buyerPhone" type="tel" autocomplete="tel" inputmode="tel" required placeholder=" " /><label for="fPhone">Phone (e.g. 0803 123 4567)</label><p class="tk-inline" id="fPhoneMsg" aria-live="polite"></p></div>
            {siteKey && <div class="cf-turnstile" data-sitekey={siteKey}></div>}
            <p class="tk-err" id="buyErr" role="alert"></p>
            <button type="submit" class="tk-pay" id="payBtn" disabled>
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
              <span id="payText">Pay with Paystack</span>
            </button>
            <p class="tk-paysub">Card, bank transfer or USSD</p>
            <p class="tk-small">Handled securely by Paystack. One QR code per ticket; each admits one person, once, on the day of its match. By buying you agree to our <a href="/terms/">Terms</a>.</p>
          </form>
        </aside>
      </div>

      <!-- G. Cross-sell -->
      <section class="tk-xsell" aria-label="Also on match day">
        <a class="tk-xcard tk-xcard--kitchen" href="/kitchen/">
          <img src="/images/matchday-kitchen-logo.png" alt="" width="72" height="72" loading="lazy" decoding="async" />
          <span><b>Order food to your seat</b><span>MatchDay Kitchen: order from your phone at McCarthy Stadium.</span></span>
          <span class="tk-xgo" aria-hidden="true">&rarr;</span>
        </a>
        <a class="tk-xcard" href="/programme/">
          <span class="tk-xicon" aria-hidden="true">MDP</span>
          <span><b>Matchday Programme</b><span>Read the official programme free before the match.</span></span>
          <span class="tk-xgo" aria-hidden="true">&rarr;</span>
        </a>
      </section>

      <!-- H. FAQ -->
      <section class="tk-faq" aria-labelledby="faqH">
        <h2 class="tk-h2" id="faqH">Questions</h2>
        <details>
          <summary>How do I get my tickets?</summary>
          <p>Straight after you pay, your QR-code tickets appear on the confirmation page and are emailed to the address you entered. There is one QR code per ticket: show it at the gate on your phone (a screenshot works) or printed.</p>
        </details>
        <details>
          <summary>I can't find my email</summary>
          <p>Check your spam or promotions folder first. You can also get your tickets again at <a href="/tickets/lookup/">Find my tickets</a> with your email address and order reference.</p>
        </details>
        <details>
          <summary>When do the gates open?</summary>
          <!-- TODO (Marvin to confirm): gate opening time for home matches. -->
          <p>Gate opening times will be announced before each home match. Each QR code admits one person, once, on the day of its match.</p>
        </details>
        <details>
          <summary>Can I give my ticket to someone else?</summary>
          <!-- TODO (Marvin to confirm): the club's ticket transfer policy. -->
          <p>Each ticket is a QR code that admits one person, once. The club will confirm its policy on passing tickets to someone else; in the meantime, contact us via the <a href="/help/">Help Centre</a>.</p>
        </details>
      </section>
    </div>

    <!-- Phones: the order total stays in view; it opens the order as a sheet. -->
    <div class="tk-bar" id="tkBar" hidden>
      <span class="tk-bar-txt"><span id="barCount"></span><b id="barTotal"></b></span>
      <button type="button" id="barBtn" aria-controls="tkSum" aria-expanded="false">Checkout</button>
    </div>
    <div class="tk-scrim" id="tkScrim" hidden></div>
  </div>
  {siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Layout>

<style>
  /* Tokens: the site's red, ink and greys (Layout.astro), plus a dark stadium hero. */
  .tk { --tk-red: var(--red); --tk-ink: #15181D; --tk-gold: #FFC72C; --tk-radius: 16px; overflow-x: clip; }
  .tk-wrap { max-width: 1280px; margin: 0 auto; padding: 0 5%; box-sizing: border-box; }
  .tk-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .tk [hidden] { display: none !important; }
  .tk :global(a:focus-visible), .tk :global(button:focus-visible), .tk :global(input:focus-visible), .tk :global(summary:focus-visible) { outline: 3px solid var(--tk-red); outline-offset: 2px; }

  /* A. Hero */
  .tk-hero { position: relative; isolation: isolate; color: #fff; background: var(--tk-ink); overflow: hidden; }
  .tk-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .tk-hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(115deg, rgba(10, 12, 16, .92) 0%, rgba(40, 6, 8, .82) 45%, rgba(227, 30, 36, .55) 100%); }
  .tk-hero-in { max-width: 1280px; margin: 0 auto; padding: 38px 5% 34px; display: grid; gap: 22px; align-items: center; }
  @media (min-width: 900px) { .tk-hero-in { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); padding: 56px 5% 50px; gap: 40px; } }
  .tk-kicker { margin: 0 0 8px; font: 700 13px/1.2 'Barlow Condensed', sans-serif; letter-spacing: .16em; text-transform: uppercase; color: var(--tk-gold); }
  .tk-h1 { margin: 0; font: 400 clamp(52px, 11vw, 96px)/.9 'Bebas Neue', sans-serif; letter-spacing: 1px; text-transform: uppercase; }
  .tk-h1 span { color: var(--tk-red); text-shadow: 0 2px 18px rgba(227, 30, 36, .35); }
  .tk-sub { margin: 10px 0 18px; font-size: 18px; color: rgba(255, 255, 255, .9); }
  .tk-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tk-chip { display: inline-flex; align-items: center; gap: 7px; min-height: 40px; padding: 0 14px; border-radius: 999px; background: rgba(255, 255, 255, .1); border: 1px solid rgba(255, 255, 255, .22); color: #fff; font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: .06em; text-transform: uppercase; text-decoration: none; backdrop-filter: blur(4px); }
  .tk-chip svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .tk-chip--link { min-height: 44px; background: #fff; color: var(--tk-ink); border-color: #fff; }
  .tk-chip--link:hover { background: var(--tk-gold); border-color: var(--tk-gold); }
  .tk-next { padding: 18px 20px; border-radius: var(--tk-radius); background: rgba(10, 12, 16, .72); border: 1px solid rgba(255, 255, 255, .16); border-top: 4px solid var(--tk-red); backdrop-filter: blur(6px); min-height: 190px; box-sizing: border-box; }
  .tk-next-k { margin: 0 0 10px; font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: .16em; text-transform: uppercase; color: var(--tk-gold); }
  .tk-next-skel { height: 130px; border-radius: 10px; background: linear-gradient(90deg, rgba(255,255,255,.06) 25%, rgba(255,255,255,.14) 37%, rgba(255,255,255,.06) 63%); background-size: 400% 100%; animation: tk-shimmer 1.4s ease infinite; }
  .tk :global(.tk-next-teams) { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 10px; text-align: center; }
  .tk :global(.tk-next-team) { display: flex; flex-direction: column; align-items: center; gap: 6px; font: 700 18px/1.1 'Barlow Condensed', sans-serif; min-width: 0; overflow-wrap: anywhere; }
  .tk :global(.tk-next-vs) { font: 400 22px/1 'Bebas Neue', sans-serif; color: rgba(255, 255, 255, .7); }
  .tk :global(.tk-next-when) { margin: 12px 0 10px; text-align: center; font-size: 15px; color: rgba(255, 255, 255, .9); }
  .tk :global(.tk-next-cd) { display: flex; justify-content: center; gap: 8px; }
  .tk :global(.tk-next-cd span) { display: inline-flex; flex-direction: column; align-items: center; gap: 3px; min-width: 52px; padding: 7px 4px 6px; border-radius: 8px; background: rgba(255, 255, 255, .1); border: 1px solid rgba(255, 255, 255, .16); }
  .tk :global(.tk-next-cd b) { font: 400 26px/1 'Bebas Neue', sans-serif; font-variant-numeric: tabular-nums; }
  .tk :global(.tk-next-cd small) { font: 700 10px/1 'Barlow Condensed', sans-serif; letter-spacing: .12em; text-transform: uppercase; color: rgba(255, 255, 255, .75); }
  .tk :global(.tk-badge) { display: inline-flex; align-items: center; justify-content: center; flex: none; object-fit: contain; overflow: visible; }
  .tk :global(.tk-badge--mono) { border-radius: 50%; }
  .tk :global(.tk-badge--mono) { background: rgba(127, 127, 127, .18); font: 700 15px/1 'Barlow Condensed', sans-serif; letter-spacing: .04em; }

  /* B. Progress */
  .tk-steps { list-style: none; margin: 22px 0 18px; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; counter-reset: none; }
  .tk-steps li { position: relative; display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-radius: 12px; background: var(--d3); color: var(--lt); font: 700 14px/1.15 'Barlow Condensed', sans-serif; letter-spacing: .04em; text-transform: uppercase; transition: background .25s, color .25s; }
  .tk-steps li span { flex: none; width: 28px; height: 28px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: var(--d2); border: 2px solid var(--d4); font-size: 15px; }
  .tk-steps li.now { background: var(--tk-ink); color: #fff; }
  .tk-steps li.now span { border-color: var(--tk-red); background: var(--tk-red); color: #fff; }
  .tk-steps li.done { color: var(--white); }
  .tk-steps li.done span { background: #17643A; border-color: #17643A; color: #fff; font-size: 0; }
  .tk-steps li.done span::after { content: '✓'; font-size: 15px; }
  @media (max-width: 520px) { .tk-steps li { flex-direction: column; text-align: center; font-size: 12px; padding: 8px 4px; } }

  .tk-seasonbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin: 0 0 16px; padding: 14px 18px; border-radius: 12px; background: var(--tk-ink); color: #fff; text-decoration: none; }
  .tk-seasonbar b { display: block; font: 400 22px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .tk-seasonbar span span { color: rgba(255,255,255,.85); font-size: 14px; }
  .tk-seasonbtn { background: var(--tk-gold); color: var(--tk-ink) !important; font-weight: 700; padding: 10px 16px; border-radius: 999px; }

  .tk-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; }
  @media (min-width: 1000px) { .tk-grid { grid-template-columns: minmax(0, 1fr) 380px; align-items: start; } }
  .tk-h2 { margin: 6px 0 12px; font: 400 clamp(26px, 3.4vw, 34px)/1 'Bebas Neue', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: var(--white); }
  .tk-hint { margin: -4px 0 12px; color: var(--lt); }

  /* C. Quick actions */
  .tk-tools { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
  .tk-tool { min-height: 44px; padding: 0 18px; border-radius: 999px; border: 1.5px solid var(--d4); background: var(--d2); color: var(--white); font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; transition: border-color .15s, color .15s, background .15s; }
  .tk-tool:hover, .tk-tool:focus-visible { border-color: var(--tk-red); color: var(--red-text); }
  .tk-msg { margin: 0 0 10px; font-weight: 600; }
  .tk-msg:empty { display: none; }

  /* C. Ticket cards */
  .tk-list { list-style: none; margin: 0 0 30px; padding: 0; display: grid; gap: 14px; }
  .tk-skel { height: 128px; border-radius: var(--tk-radius); background: linear-gradient(90deg, var(--d3) 25%, var(--d2) 37%, var(--d3) 63%); background-size: 400% 100%; animation: tk-shimmer 1.4s ease infinite; }
  @keyframes tk-shimmer { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }
  .tk :global(.tk-empty) { padding: 22px; border-radius: var(--tk-radius); border: 1.5px dashed var(--d4); color: var(--lt); text-align: center; }
  .tk :global(.tk-empty button) { margin-top: 10px; min-height: 44px; padding: 0 20px; border-radius: 999px; border: 0; background: var(--tk-red); color: #fff; font: 700 14px/1 'Barlow Condensed', sans-serif; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
  .tk :global(.tk-card) {
    --notch: 14px; position: relative; display: grid; grid-template-columns: 84px minmax(0, 1fr); background: var(--d2); border: 1.5px solid var(--d4);
    border-radius: var(--tk-radius); box-shadow: 0 1px 2px rgba(16, 24, 40, .05), 0 6px 16px -8px rgba(16, 24, 40, .14);
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  .tk :global(.tk-card:hover:not(.off)) { transform: translateY(-2px); box-shadow: 0 2px 4px rgba(16, 24, 40, .06), 0 14px 28px -12px rgba(16, 24, 40, .25); }
  .tk :global(.tk-card.on) { border-color: var(--tk-red); box-shadow: 0 0 0 1px var(--tk-red), 0 10px 26px -10px rgba(227, 30, 36, .45); animation: tk-pop .28s ease; }
  @keyframes tk-pop { 50% { transform: scale(1.012); } }
  .tk :global(.tk-card.off) { opacity: .62; }
  /* Date block, then a perforated edge with notches like a real ticket. */
  .tk :global(.tk-date) { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; padding: 12px 6px; border-radius: var(--tk-radius) 0 0 var(--tk-radius); background: var(--tk-ink); color: #fff; text-align: center; }
  .tk :global(.tk-date b) { font: 400 38px/.9 'Bebas Neue', sans-serif; }
  .tk :global(.tk-date span) { font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: .12em; text-transform: uppercase; }
  .tk :global(.tk-date small) { font: 600 12px/1 'Barlow', sans-serif; color: inherit; opacity: .88; }
  /* Date blocks take turns in the club colours (white or ink text, all AA). */
  .tk :global(.tk-date--1) { background: #C11A1F; }
  .tk :global(.tk-date--2) { background: var(--tk-gold); color: var(--tk-ink); }
  .tk :global(.tk-date--3) { background: #10224A; }
  .tk :global(.tk-date--4) { background: #4D0B0D; }
  .tk :global(.tk-body) { position: relative; padding: 14px 16px 14px 20px; border-left: 2px dashed var(--d4); display: grid; gap: 10px; }
  .tk :global(.tk-body::before), .tk :global(.tk-body::after) { content: ''; position: absolute; left: calc(var(--notch) / -2 - 1px); width: var(--notch); height: var(--notch); border-radius: 50%; background: var(--black); border: 1.5px solid var(--d4); }
  .tk :global(.tk-body::before) { top: calc(var(--notch) / -2 - 2px); clip-path: inset(50% 0 0 0); }
  .tk :global(.tk-body::after) { bottom: calc(var(--notch) / -2 - 2px); clip-path: inset(0 0 50% 0); }
  .tk :global(.tk-top) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px 14px; align-items: center; }
  .tk :global(.tk-labels) { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-bottom: 6px; }
  .tk :global(.tk-md) { font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: .12em; text-transform: uppercase; color: var(--red-text); }
  .tk :global(.tk-flag) { padding: 4px 8px; border-radius: 999px; font: 700 11px/1 'Barlow Condensed', sans-serif; letter-spacing: .08em; text-transform: uppercase; background: var(--tk-gold); color: var(--tk-ink); }
  .tk :global(.tk-flag--week) { background: var(--tk-ink); color: #fff; }
  .tk :global(.tk-state) { padding: 4px 8px; border-radius: 999px; font: 700 11px/1 'Barlow Condensed', sans-serif; letter-spacing: .08em; text-transform: uppercase; background: var(--d3); color: var(--white); }
  .tk :global(.tk-state.out) { background: #FDECEC; color: #A3161B; }
  .tk :global(.tk-teams) { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 10px; font: 700 20px/1.15 'Barlow Condensed', sans-serif; }
  .tk :global(.tk-teams i) { font: 400 16px/1 'Bebas Neue', sans-serif; font-style: normal; color: var(--lt); }
  .tk :global(.tk-team) { display: inline-flex; align-items: center; gap: 7px; min-width: 0; }
  .tk :global(.tk-meta) { margin-top: 5px; color: var(--lt); font-size: 14px; line-height: 1.45; }
  .tk :global(.tk-side) { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; }
  .tk :global(.tk-from) { font: 600 12px/1.1 'Barlow', sans-serif; color: var(--lt); }
