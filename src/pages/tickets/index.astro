      // Visual: segmented stand control and a quantity stepper.
      var segName = 'tier-' + m.id;
      var seg = el('div', { class: 'tk-seg', role: 'radiogroup', 'aria-label': 'Stand for ' + title });
      m.tiers.forEach(function (t) {
        var r = el('input', { type: 'radio', name: segName, value: t.tier, disabled: t.left === 0 });
        r.checked = tier.value === t.tier;
        r.addEventListener('change', function () { tier.value = t.tier; tier.dispatchEvent(new Event('change')); });
        seg.append(el('label', { title: t.left !== null ? t.left + ' left' : null }, r, t.label + ' · ' + naira(t.priceKobo)));
      });
      var out = el('output', { 'aria-live': 'polite', text: qty.value });
      var minus = el('button', { type: 'button', 'aria-label': 'One ticket fewer for ' + title, text: '−' });
      var plus = el('button', { type: 'button', 'aria-label': 'One more ticket for ' + title, text: '+' });
      var syncStep = function () { out.textContent = qty.value; minus.disabled = Number(qty.value) <= 1; plus.disabled = Number(qty.value) >= qty.options.length; Array.from(seg.querySelectorAll('input')).forEach(function (i) { i.checked = i.value === tier.value; }); };
      var bump = function (d) { var n = Math.min(qty.options.length, Math.max(1, Number(qty.value) + d)); qty.value = String(n); qty.dispatchEvent(new Event('change')); };
      minus.addEventListener('click', function () { bump(-1); }); plus.addEventListener('click', function () { bump(1); });
      var step = el('div', { class: 'tk-step', role: 'group', 'aria-label': 'Tickets for ' + title }, minus, out, plus);
      var pick = el('div', { class: 'tk-pick', hidden: true }, seg, step, tier, qty);
      var when = new Date(m.kickoff);
      var time = when.toLocaleTimeString('en-US', { timeZone: TZ, hour: 'numeric', minute: '2-digit' });
      var low = m.tiers.length ? Math.min.apply(null, m.tiers.map(function (t) { return t.priceKobo; })) : 0;
      var left = m.tiers.some(function (t) { return t.left !== null; }) ? m.tiers.reduce(function (s, t) { return s + (t.left || 0); }, 0) : null;
      var stateText = m.state === 'not_on_sale' && m.opensAt ? 'On sale from ' + new Date(m.opensAt).toLocaleDateString('en-GB', { timeZone: TZ, day: 'numeric', month: 'short' }) : STATE[m.state];
      var days = (Date.parse(m.kickoff) - now) / 864e5;
      var flag = firstUpcoming && firstUpcoming.id === m.id ? el('span', { class: 'tk-flag', text: 'Next match' }) : days >= 0 && days <= 7 ? el('span', { class: 'tk-flag tk-flag--week', text: 'This week' }) : null;
      var ribbon = el('span', { class: 'tk-ribbon', text: 'Selected', hidden: true });
      var row = el('li', { class: 'tk-card' + (can ? '' : ' off') },
        ribbon,
        el('div', { class: 'tk-date tk-date--' + (idx % 5), 'aria-hidden': 'true' },
          el('small', { text: when.toLocaleDateString('en-GB', { timeZone: TZ, weekday: 'short' }) }),
          el('b', { text: when.toLocaleDateString('en-GB', { timeZone: TZ, day: 'numeric' }) }),
          el('span', { text: when.toLocaleDateString('en-GB', { timeZone: TZ, month: 'short' }) })),
        el('div', { class: 'tk-body' },
          el('div', { class: 'tk-top' },
            el('div', {},
              el('div', { class: 'tk-labels' }, m.matchday ? el('span', { class: 'tk-md', text: 'Matchday ' + m.matchday }) : null, flag, stateText ? el('span', { class: 'tk-state' + (m.state === 'sold_out' ? ' out' : ''), text: stateText }) : null),
              el('div', { class: 'tk-teams' }, el('span', { class: 'tk-team' }, badge(m.homeTeam, 30), 'Lobi Stars'), el('i', { text: 'vs' }), el('span', { class: 'tk-team' }, badge(m.awayTeam, 30), short(m.awayTeam))),
              el('div', { class: 'tk-meta' }, el('time', { datetime: m.kickoff, text: when.toLocaleDateString('en-GB', { timeZone: TZ, weekday: 'long', day: 'numeric', month: 'long' }) + ' · ' + time }), el('br'), 'McCarthy Stadium, Makurdi' + (can && left !== null ? ' · ' + left + ' left' : ''))),
            el('div', { class: 'tk-side' },
              can && low ? el('span', { class: 'tk-from' }, 'from', el('b', { text: naira(low) })) : null,
              el('label', { class: 'tk-toggle' }, cb, svg('<path d="M5 12.5l4.5 4.5L19 7.5"/>')),
              el('span', { class: 'tk-toggle-l', 'aria-hidden': 'true', text: can ? 'Select' : '' }))),
          pick));
      var r = { m: m, cb: cb, tier: tier, qty: qty, row: row, pick: pick, ribbon: ribbon, sync: syncStep };
      cb.addEventListener('change', function () { pick.hidden = !cb.checked; row.classList.toggle('on', cb.checked); ribbon.hidden = !cb.checked; summary(); });
      tier.addEventListener('change', function () { fillQty(); syncStep(); summary(); });
      qty.addEventListener('change', function () { syncStep(); summary(); });
      syncStep();
      rows.set(m.id, r);
      list.append(row);
      if (pre && pre === m.id && can) { cb.checked = true; pick.hidden = false; row.classList.add('on'); ribbon.hidden = false; }
    });
    stands(); heroNext();
    summary();
  }

  function selected() { return Array.from(rows.values()).filter(function (r) { return r.cb.checked; }); }
  function set(r, on) { if (r.cb.disabled) return; r.cb.checked = on; r.pick.hidden = !on; r.row.classList.toggle('on', on); if (r.ribbon) r.ribbon.hidden = !on; }
  $('selAll').addEventListener('click', function () { rows.forEach(function (r) { set(r, true); }); summary(); });
  $('selNext3').addEventListener('click', function () { var n = 0; rows.forEach(function (r) { var on = !r.cb.disabled && n < 3; if (on) n++; set(r, on); }); summary(); });
  $('selNone').addEventListener('click', function () { rows.forEach(function (r) { set(r, false); }); summary(); });
  $('allTier').addEventListener('change', function () { var v = this.value; if (!v) return; selected().forEach(function (r) { var o = Array.from(r.tier.options).find(function (x) { return x.value === v && !x.disabled; }); if (o) { r.tier.value = v; r.tier.dispatchEvent(new Event('change')); } }); summary(); });

  // Animated total (the screen-reader text gets the final amount only).
  var shownTotal = 0, totalAnim;
  function showTotal(k) {
    $('sumTotalLive').textContent = 'Total ' + naira(k);
    var from = shownTotal; shownTotal = k; cancelAnimationFrame(totalAnim);
    if (reduce || from === k) { $('sumTotal').textContent = naira(k); return; }
    var t0 = performance.now();
    var frame = function (t) { var p = Math.min(1, (t - t0) / 350); $('sumTotal').textContent = naira(from + (k - from) * (1 - Math.pow(1 - p, 3))); if (p < 1) totalAnim = requestAnimationFrame(frame); };
    totalAnim = requestAnimationFrame(frame);
  }
  // B. Progress: 1 choose matches → 2 stand → 3 pay.
  var typed = false;
  function progress(n) {
    var cur = !n ? 1 : typed ? 3 : 2;
    document.querySelectorAll('#tkSteps li').forEach(function (li) { var s = Number(li.dataset.step); li.classList.toggle('done', s < cur); li.classList.toggle('now', s === cur); li.setAttribute('aria-current', s === cur ? 'step' : 'false'); });
  }

  function summary() {
    var sel = selected(), total = 0, tickets = 0, lines = $('sumLines');
    lines.replaceChildren();
    if (!sel.length) lines.append(el('li', { class: 'tk-muted', text: 'No matches selected yet. Tick a match above to start your order.' }));
    var basket = sel.map(function (r) {
      var t = r.m.tiers.find(function (x) { return x.tier === r.tier.value; }), q = Number(r.qty.value) || 1, sub = t.priceKobo * q;
      total += sub; tickets += q;
      var title = 'Lobi Stars vs ' + short(r.m.awayTeam);
      lines.append(el('li', { class: 'tk-line' },
        el('span', {}, el('b', { text: title }), el('small', { text: t.label + ' × ' + q })),
        el('span', { class: 'tk-lt', text: naira(sub) }),
        el('button', { type: 'button', 'aria-label': 'Remove ' + title, text: '×', onclick: function () { set(r, false); summary(); } })));
      return { eventId: r.m.id, tier: t.tier, quantity: q, unitKobo: t.priceKobo };
    });
    showTotal(total);
    $('tkBar').hidden = !sel.length;
    $('barTotal').textContent = naira(total);
    $('barCount').textContent = sel.length + ' match' + (sel.length === 1 ? '' : 'es') + ', ' + tickets + ' ticket' + (tickets === 1 ? '' : 's');
    if (!sel.length) closeSheet();
    $('payBtn').disabled = !sel.length;
    $('payText').textContent = sel.length ? 'Pay ' + naira(total) + ' with Paystack' : 'Pay with Paystack';
    progress(sel.length);
    // Season Ticket saving: every remaining home match on sale, one stand, same number of tickets.
    var onSale = matches.filter(function (m) { return m.state === 'on_sale'; }).map(function (m) { return m.id; });
    var s = $('sumSeason'); s.hidden = true;
    if (season && season.enabled && basket.length && onSale.every(function (id) { return basket.some(function (b) { return b.eventId === id; }); })) {
      var tiers = Array.from(new Set(basket.map(function (b) { return b.tier; }))), qs = Array.from(new Set(basket.map(function (b) { return b.quantity; })));
      var st = tiers.length === 1 && qs.length === 1 ? (season.tiers || []).find(function (t) { return t.tier === tiers[0]; }) : null;
      if (st && st.priceKobo * qs[0] < total) { s.replaceChildren('Tip: a ', el('a', { href: '/season-tickets/', text: 'Season Ticket' }), ' covers every home match for ' + naira(st.priceKobo * qs[0]) + ' (save ' + naira(total - st.priceKobo * qs[0]) + ').'); s.hidden = false; }
    }
    return basket;
  }

  function load() {
    var list = $('tkList');
    list.setAttribute('aria-busy', 'true');
    list.replaceChildren(el('li', { class: 'tk-skel', 'aria-hidden': 'true' }), el('li', { class: 'tk-skel', 'aria-hidden': 'true' }), el('li', { class: 'tk-sr', text: 'Loading the home matches…' }));
    fetch('/api/tickets/catalogue', { cache: 'no-store' }).then(function (r) { if (!r.ok) throw new Error(); return r.json(); }).then(function (d) {
      matches = d.matches || []; rows.clear(); draw();
    }).catch(function () {
      list.removeAttribute('aria-busy');
      list.replaceChildren(el('li', { class: 'tk-empty' }, 'The matches could not be loaded just now. Check your connection.', el('br'), el('button', { type: 'button', text: 'Try again', onclick: load })));
    });
  }
  fetch('/api/season-tickets').then(function (r) { return r.json(); }).then(function (d) {
    season = d; summary();
    if (d.enabled && d.tiers && d.tiers.length) { $('seasonBannerText').textContent = 'Every home match of the ' + d.season + ' season, from ' + naira(Math.min.apply(null, d.tiers.map(function (t) { return t.priceKobo; }))) + '.'; $('seasonBanner').hidden = false; }
  }).catch(function () {});
  load();

  // ── E. Phones: the order as a slide-up sheet ──
  var sheet = $('tkSum'), scrim = $('tkScrim'), lastFocus = null;
  function openSheet() { lastFocus = document.activeElement; sheet.classList.add('open'); scrim.hidden = false; $('barBtn').setAttribute('aria-expanded', 'true'); sheet.setAttribute('role', 'dialog'); sheet.setAttribute('aria-modal', 'true'); $('sheetClose').focus(); }
  function closeSheet() { if (!sheet.classList.contains('open')) return; sheet.classList.remove('open'); scrim.hidden = true; $('barBtn').setAttribute('aria-expanded', 'false'); sheet.removeAttribute('role'); sheet.removeAttribute('aria-modal'); if (lastFocus) lastFocus.focus(); }
  $('barBtn').addEventListener('click', openSheet);
  $('sheetClose').addEventListener('click', closeSheet);
  scrim.addEventListener('click', closeSheet);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeSheet(); });

  // ── F. Inline checks (shown as hints; the server checks everything again) ──
  var f = $('buyForm');
  ['fName', 'fEmail', 'fPhone'].forEach(function (id) { $(id).addEventListener('input', function () { if (!typed) { typed = true; progress(selected().length); } }); });
  var check = function (id, msgId, ok, msg) { var bad = $(id).value.trim() && !ok($(id).value.trim()); $(id).classList.toggle('bad', !!bad); $(id).setAttribute('aria-invalid', bad ? 'true' : 'false'); $(msgId).textContent = bad ? msg : ''; };
  $('fEmail').addEventListener('blur', function () { check('fEmail', 'fEmailMsg', function (v) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v); }, 'Please check your email address: your tickets are sent here.'); });
  $('fPhone').addEventListener('blur', function () { check('fPhone', 'fPhoneMsg', function (v) { return /^(\+?234|0)?[789][01]\d{8}$/.test(v.replace(/[\s-]/g, '')); }, 'Please enter a Nigerian mobile number, e.g. 0803 123 4567.'); });

  f.addEventListener('submit', function (e) {
    e.preventDefault();
    var err = $('buyErr'); err.textContent = '';
    var lines = summary().map(function (l) { return { eventId: l.eventId, tier: l.tier, quantity: l.quantity }; });
    if (!lines.length) { err.textContent = 'Tick at least one match.'; return; }
    var tokenEl = f.querySelector('[name="cf-turnstile-response"]');
    $('payBtn').disabled = true;
    fetch('/api/tickets/basket', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ lines: lines, buyerName: f.buyerName.value, buyerEmail: f.buyerEmail.value, buyerPhone: f.buyerPhone.value, turnstileToken: tokenEl ? tokenEl.value : '' }) })
      .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
      .then(function (res) {
        if (res.ok && res.d.authorizationUrl) { location.href = res.d.authorizationUrl; return; }
        err.textContent = res.d.error || 'Something went wrong. Please try again.';
        // A match that just sold out: untick it so the rest can be paid in one click.
        if (res.d.soldOut && res.d.eventId && rows.get(res.d.eventId)) { set(rows.get(res.d.eventId), false); summary(); load(); }
        if (window.turnstile && window.turnstile.reset) window.turnstile.reset();
        $('payBtn').disabled = !selected().length;
      })
      .catch(function () { err.textContent = 'No connection. Please try again.'; $('payBtn').disabled = false; });
  });
})();
</script>
