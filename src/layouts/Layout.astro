---
import HeadMeta from '../components/HeadMeta.astro';
import CookieConsent from '../components/CookieConsent.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CONTACT } from '../lib/site';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** Keep the page out of search engines (admin and transaction pages). */
  noindex?: boolean;
  /** Extra JSON-LD structured data for this page. */
  jsonLd?: Record<string, unknown>[];
}
const {
  title,
  description = "Official website of Lobi Stars Football Club - Pride of Benue",
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  jsonLd = [],
} = Astro.props;
const waLink = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent('Hello Lobi Stars Management, I have an inquiry.')}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<HeadMeta title={title} description={description} image={image} imageAlt={imageAlt} type={type} noindex={noindex} jsonLd={jsonLd} />
<slot name="head" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@300;400;600;700&family=Barlow+Condensed:wght@400;600;700&display=swap"/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@300;400;600;700&family=Barlow+Condensed:wght@400;600;700&display=swap" media="print" onload="this.media='all'"/>
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:wght@300;400;600;700&family=Barlow+Condensed:wght@400;600;700&display=swap"/></noscript>
<style is:global>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
:root{
  --red:#E31E24;--rd:#C11A1F;--rdp:#4D0B0D;
  --gold:#9C6B0A;--gd:#7A540A;
  --black:#FFFFFF;   /* page background */
  --dark:#F7F8FA;    /* secondary / band background */
  --d2:#FFFFFF;      /* card background */
  --d3:#F1F3F5;      /* input / chip fill */
  --d4:#E3E6EA;      /* hairline borders */
  --white:#15181D;   /* primary text (ink) */
  --lt:#5B6472;       /* secondary text */
  /* Darker red/gold for text, so small text passes WCAG AA contrast on the
     light grey section backgrounds too. Buttons keep the brand red. */
  --red-text:#C11A1F;
  --gold-text:#865C08;
}
html{scroll-behavior:smooth;}
body{font-family:'Barlow',sans-serif;background:var(--black);color:var(--white);overflow-x:hidden;}
a{color:inherit;}
.wrap{max-width:1200px;margin:0 auto;padding:0 5%;}
[hidden]{display:none !important;}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}

main{padding-top:72px;min-height:60vh;}
.skip-link{position:fixed;top:-60px;left:12px;z-index:3000;background:var(--red);color:#fff;padding:10px 16px;border-radius:6px;font-weight:700;text-decoration:none;}
.skip-link:focus{top:12px;}

/* SHARED headings/buttons used by all pages */
.stag{font-family:'Barlow Condensed',sans-serif;font-size:12px;font-weight:600;letter-spacing:5px;text-transform:uppercase;color: var(--gold-text);margin-bottom:10px;display:flex;align-items:center;gap:10px;}
.stag::before{content:'';display:block;width:22px;height:2px;background:var(--gold);flex-shrink:0;}
.stitle{font-family:'Bebas Neue',sans-serif;font-size:clamp(34px,5vw,58px);line-height:.95;letter-spacing:1px;color:var(--white);margin-bottom:14px;font-weight:400;}
.stitle .r{color: var(--red-text);}
.divr{width:56px;height:3px;background:var(--red);margin:14px 0 34px;}
.btn-p{background:var(--red);color:#fff;padding:13px 32px;text-decoration:none;font-family:'Barlow Condensed',sans-serif;font-size:14px;font-weight:700;letter-spacing:2px;text-transform:uppercase;border-radius:3px;transition:background .2s,transform .15s;display:inline-block;border:none;cursor:pointer;}
.btn-p:hover{background:var(--rd);transform:translateY(-2px);}
.btn-p:disabled{opacity:.6;cursor:default;transform:none;}
.btn-o{background:transparent;color:var(--white);padding:13px 32px;text-decoration:none;font-family:'Barlow Condensed',sans-serif;font-size:14px;font-weight:700;letter-spacing:2px;text-transform:uppercase;border-radius:3px;border:1.5px solid var(--d4);transition:border-color .2s,color .2s;display:inline-block;cursor:pointer;}
.btn-o:hover{border-color:var(--red);color: var(--red-text);}
.btn-p:focus-visible,.btn-o:focus-visible{outline:3px solid var(--gold);outline-offset:2px;}
.card{background:var(--d2);border:1px solid var(--d4);border-radius:8px;overflow:hidden;transition:transform .25s,border-color .25s,box-shadow .25s;}
.card:hover{transform:translateY(-4px);border-color:rgba(212,32,43,.35);box-shadow:0 16px 32px rgba(15,17,21,.08);}
.muted{color:var(--lt);}
.page-hero{padding:70px 5% 40px;}
.page-content{padding:0 5% 90px;}
.empty-state{padding:60px 20px;text-align:center;color:var(--lt);border:1px dashed var(--d4);border-radius:10px;}

/* FORMS (membership, contact, partners, food) */
.form-grp{margin-bottom:16px;}
.form-lbl{display:block;font-family:'Barlow Condensed',sans-serif;font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--lt);margin-bottom:7px;}
.form-inp,.form-ta,.form-sel{width:100%;background:var(--d3);border:1px solid var(--d4);border-radius:6px;padding:13px 14px;color:var(--white);font-family:'Barlow',sans-serif;font-size:16px;transition:border-color .2s;}
.form-inp:focus,.form-ta:focus,.form-sel:focus{outline:none;border-color:var(--red);box-shadow:0 0 0 3px rgba(227,30,36,.15);}
.form-ta{min-height:130px;resize:vertical;}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.form-error{color:#C11A1F;font-size:14px;margin:0 0 14px;}
.panel{background:var(--d2);border:1px solid var(--d4);border-radius:14px;padding:clamp(22px,4vw,40px);box-shadow:0 16px 40px rgba(15,17,21,.06);}
@media(max-width:600px){ .form-row{grid-template-columns:1fr;gap:0;} }

/* TOAST */
.toast{position:fixed;bottom:28px;left:50%;transform:translate(-50%,10px);background:#15181D;color:#fff;padding:13px 22px;border-radius:8px;font-family:'Barlow Condensed',sans-serif;font-size:15px;font-weight:700;letter-spacing:.5px;z-index:5000;opacity:0;transition:opacity .3s,transform .3s;pointer-events:none;max-width:90vw;text-align:center;}
.toast.show{opacity:1;transform:translate(-50%,0);}

/* WHATSAPP FLOAT */
.wa-float{position:fixed;bottom:24px;right:24px;z-index:998;width:56px;height:56px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(37,211,102,.45);text-decoration:none;transition:transform .2s;}
.wa-float:hover{transform:scale(1.1);}
.wa-float svg{width:30px;height:30px;fill:white;}
</style>
</head>
<body>
<a href="#main" class="skip-link">Skip to content</a>
<SiteHeader />

<main id="main">
  <slot />
</main>

<SiteFooter />

<a href={waLink} target="_blank" rel="noopener" class="wa-float" aria-label="Chat with Lobi Stars FC on WhatsApp">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" aria-hidden="true">
    <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.06 3.973L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
  </svg>
</a>

<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script is:inline>
  function showToast(msg){var t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(t._h);t._h=setTimeout(function(){t.classList.remove('show');},3200);}
</script>
<CookieConsent />
<script is:inline src="/track.js" defer></script>
</body>
</html>
