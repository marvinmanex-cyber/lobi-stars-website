---
// Fixtures or results, grouped by month. Matches come from the database
// (/api/matches -- managed in Admin > Manage Matches, with Match Centre
// scores) plus any fixtures entered in the content CMS. Whether a match is
// upcoming is decided in the browser against the current time, so a match
// whose kick-off has passed never shows as upcoming.
import { getCollection } from 'astro:content';

interface Props {
  show: 'upcoming' | 'results';
  /** Emit schema.org SportsEvent data for each match. */
  structuredData?: boolean;
}
const { show, structuredData = false } = Astro.props;

// The CMS saves kick-off as Nigerian wall-clock time with no timezone, which
// gets read as UTC; shift it back by WAT's +1h so 16:30 stays 16:30.
const WAT_OFFSET_MS = 60 * 60 * 1000;
const cms = (await getCollection('fixtures')).map(f => ({
  home_team: f.data.home,
  away_team: f.data.away,
  event_date: new Date(f.data.date.getTime() - WAT_OFFSET_MS).toISOString(),
  venue: f.data.venue,
  competition: f.data.competition,
  home_score: f.data.home_score ?? null,
  away_score: f.data.away_score ?? null,
  status: f.data.status === 'Completed' ? 'full-time' : 'scheduled',
}));
---
<div class="fxb" data-commentary="/commentary/" data-fixtures-board data-show={show} data-structured={structuredData ? '1' : undefined} data-cms={JSON.stringify(cms)}>
  <p class="fxb-empty" data-status>{show === 'upcoming' ? 'Fixtures for the next round will be announced soon.' : 'No results yet this season.'} <a href="/fixtures">See all fixtures</a></p>
  <div data-list></div>
</div>

<style>
  .fxb { max-width: 900px; }
  .fxb-empty { padding: 26px 18px; text-align: center; color: var(--lt); border: 1px dashed var(--d4); border-radius: 10px; margin: 0; }
  .fxb-empty[hidden] { display: none; }
  .fxb :global(.fx-month) { margin: 30px 0 12px; font: 400 26px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; color: var(--white); }
  .fxb :global(.fx-month:first-child) { margin-top: 0; }
  .fxb :global(.fx) { background: var(--d2); border: 1px solid var(--d4); border-radius: 12px; padding: 16px 18px; margin-bottom: 12px; }
  .fxb :global(.fx-meta) { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; font-size: 13px; color: var(--lt); margin-bottom: 14px; }
  .fxb :global(.fx-comp) { font-weight: 700; color: var(--white); }
  .fxb :global(.fx-ha) { font: 700 11px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; padding: 4px 7px; border-radius: 3px; background: var(--d3); color: var(--white); }
  .fxb :global(.fx-ha.home) { background: var(--red); color: #fff; }
  .fxb :global(.fx-when) { margin-left: auto; color: var(--gold-text); font-weight: 700; }
  .fxb :global(.fx-teams) { display: grid; grid-template-columns: 1fr auto 1fr; gap: 12px; align-items: center; font: 700 17px/1.2 'Barlow Condensed', sans-serif; }
  .fxb :global(.fx-team) { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .fxb :global(.fx-team.h) { justify-content: flex-end; text-align: right; }
  .fxb :global(.crest) { width: 34px; height: 34px; border-radius: 50%; object-fit: contain; background: #fff; border: 1px solid var(--d4); flex-shrink: 0; }
  .fxb :global(.crest--initials) { display: inline-flex; align-items: center; justify-content: center; background: var(--d3); color: var(--lt); font: 700 12px/1 'Barlow Condensed', sans-serif; }
  .fxb :global(.fx-mid) { font: 400 18px/1 'Bebas Neue', sans-serif; color: var(--lt); text-align: center; }
  .fxb :global(.fx-score) { background: #15181D; color: #fff; padding: 6px 12px; border-radius: 4px; font: 400 22px/1 'Bebas Neue', sans-serif; white-space: nowrap; }
  .fxb :global(.fx-pending) { background: var(--d3); color: var(--lt); padding: 6px 8px; border-radius: 4px; font: 700 11px/1.1 'Barlow Condensed', sans-serif; letter-spacing: .8px; text-transform: uppercase; text-align: center; }
  .fxb :global(.fx-venue) { margin-top: 12px; font-size: 13px; color: var(--lt); }
  .fxb :global(.fx-actions) { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--d4); }
  .fxb :global(.fx-btn) {
    display: inline-flex; align-items: center; gap: 6px; padding: 9px 14px; border-radius: 4px; border: 1.5px solid var(--d4);
    background: #fff; color: var(--white); text-decoration: none; cursor: pointer;
    font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.2px; text-transform: uppercase;
  }
  .fxb :global(.fx-btn:hover) { border-color: var(--red); color: var(--red-text); }
  .fxb :global(.fx-btn.primary) { background: var(--red); border-color: var(--red); color: #fff; }
  .fxb :global(.fx-btn.primary:hover) { background: var(--rd); color: #fff; }
  .fxb :global(.fx-btn:focus-visible) { outline: 3px solid var(--red); outline-offset: 2px; }
  @media (max-width: 560px) {
    .fxb :global(.fx-when) { margin-left: 0; width: 100%; }
    .fxb :global(.fx-teams) { font-size: 15px; }
    .fxb :global(.crest) { width: 28px; height: 28px; }
  }
</style>

<script>
  import { crest, fmtDate, fmtTime, monthKey, isLobi, hasScore, downloadIcs, googleCalUrl, STATUS_LABELS, type Match } from '../lib/matchUi';
  import { ssrData } from '../lib/ssr';
  import { isMatchDay, loadPreviews, watDay } from '../lib/matchUi';
  let previews: Record<string, string> = {};

  const DAY = 86_400_000;
  const norm = (s: string) => s.toLowerCase().replace(/\bfc\b|[^a-z]/g, '');
  const same = (a: Match, b: Match) => norm(a.home_team) === norm(b.home_team) && norm(a.away_team) === norm(b.away_team)
    && Math.abs(new Date(a.event_date).getTime() - new Date(b.event_date).getTime()) < 3 * DAY;

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  }

  function card(m: Match, upcoming: boolean) {
    const c = el('article', 'fx');
    const lobiHome = typeof (m as any).is_home === 'boolean' ? (m as any).is_home : isLobi(m.home_team);
    const lobiInvolved = lobiHome || isLobi(m.away_team);

    const meta = el('div', 'fx-meta');
    meta.append(el('span', 'fx-comp', m.competition));
    if (lobiInvolved) meta.append(el('span', `fx-ha ${lobiHome ? 'home' : 'away'}`, lobiHome ? 'Home' : 'Away'));
    meta.append(el('span', 'fx-when', `${fmtDate(m.event_date)} · ${fmtTime(m.event_date)}`));

    const teams = el('div', 'fx-teams');
    const h = el('div', 'fx-team h'); h.append(el('span', '', m.home_team), crest(m.home_team, 34));
    const a = el('div', 'fx-team'); a.append(crest(m.away_team, 34), el('span', '', m.away_team));
    let mid: HTMLElement;
    if (upcoming) mid = el('div', 'fx-mid', m.status === 'postponed' ? 'P–P' : 'VS');
    else if (hasScore(m)) mid = el('div', 'fx-score', `${m.home_score} – ${m.away_score}`);
    else mid = el('div', 'fx-pending', m.status && m.status !== 'scheduled' && m.status !== 'full-time' ? STATUS_LABELS[m.status] : 'Result pending');
    teams.append(h, mid, a);

    const venue = el('div', 'fx-venue', `📍 ${m.venue}`);
    const actions = el('div', 'fx-actions');
    if (m.slug) {
      const mc = el('a', 'fx-btn', 'Match Centre') as HTMLAnchorElement;
      mc.href = `/matches/${m.slug}/`;
      mc.setAttribute('aria-label', `Match Centre: ${m.home_team} vs ${m.away_team}`);
      actions.append(mc);
    }
    const preview = previews[watDay(m.event_date)];
    if (upcoming && preview) {
      const pv = el('a', 'fx-btn', 'Match Preview') as HTMLAnchorElement;
      pv.href = `/news/${preview}/`;
      actions.append(pv);
    }
    if (lobiHome && m.slug && isMatchDay(m as any)) {
      const ml = el('a', 'fx-btn primary', '● Matchday Live') as HTMLAnchorElement;
      ml.href = `/matches/${m.slug}/live/`;
      ml.setAttribute('aria-label', `Matchday Live: ${m.home_team} vs ${m.away_team}`);
      actions.append(ml);
    }
    const commentary = document.querySelector<HTMLElement>('[data-fixtures-board]')?.dataset.commentary;
    if (!lobiHome && lobiInvolved && upcoming && commentary && m.status !== 'postponed' && m.status !== 'cancelled') {
      // Away games: Lobi Stars FC Live commentary (home games have it inside Matchday Live).
      const ll = el('a', 'fx-btn', '🎧 Listen Live') as HTMLAnchorElement;
      ll.href = commentary;
      ll.dataset.track = 'commentary_click'; if (m.slug) ll.dataset.trackLabel = m.slug;
      ll.setAttribute('aria-label', `Listen live to ${m.home_team} vs ${m.away_team} on Lobi Stars FC Live`);
      actions.append(ll);
    }
    if (upcoming && lobiHome && m.id && (m as any).on_sale) {
      const t = el('a', 'fx-btn primary', 'Buy Tickets') as HTMLAnchorElement;
      t.href = `/tickets?event=${encodeURIComponent(m.id)}`;
      t.setAttribute('aria-label', `Buy tickets: ${m.home_team} vs ${m.away_team}`);
      actions.append(t);
    }
    if (upcoming) {
      const ics = el('button', 'fx-btn', '📅 Add to calendar (.ics)') as HTMLButtonElement;
      ics.type = 'button';
      ics.addEventListener('click', () => downloadIcs(m));
      const g = el('a', 'fx-btn', 'Google Calendar') as HTMLAnchorElement;
      g.href = googleCalUrl(m); g.target = '_blank'; g.rel = 'noopener';
      actions.append(ics, g);
    }

    c.append(meta, teams, venue);
    if (actions.childElementCount) c.append(actions);
    return c;
  }

  function sportsEventLd(m: Match) {
    const team = (name: string) => ({ '@type': 'SportsTeam', name });
    const s = document.createElement('script');
    s.type = 'application/ld+json';
    s.textContent = JSON.stringify({
      '@context': 'https://schema.org', '@type': 'SportsEvent', name: `${m.home_team} vs ${m.away_team}`,
      description: `${m.competition}: ${m.home_team} vs ${m.away_team} at ${m.venue}.`, sport: 'Soccer', startDate: m.event_date,
      eventStatus: m.status === 'postponed' ? 'https://schema.org/EventPostponed' : m.status === 'cancelled' ? 'https://schema.org/EventCancelled' : 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: { '@type': 'Place', name: m.venue, address: { '@type': 'PostalAddress', addressCountry: 'NG', streetAddress: m.venue } },
      homeTeam: team(m.home_team), awayTeam: team(m.away_team), competitor: [team(m.home_team), team(m.away_team)],
      organizer: { '@type': 'SportsOrganization', name: m.competition },
      ...(m.slug ? { url: `${location.origin}/matches/${m.slug}/` } : {}),
    });
    document.head.append(s);
  }

  async function init(board: HTMLElement) {
    const show = board.dataset.show;
    const status = board.querySelector<HTMLElement>('[data-status]')!;
    const list = board.querySelector<HTMLElement>('[data-list]')!;
    const cms: Match[] = JSON.parse(board.dataset.cms || '[]');

    // Embedded by the server (which also pre-rendered the list); fetch only as a fallback.
    let db: Match[] = ssrData<{ matches: Match[] }>('ssr-matches')?.matches || [];
    if (!document.getElementById('ssr-matches')) try {
      const res = await fetch('/api/matches');
      if (res.ok) db = (await res.json()).matches || [];
    } catch { /* show CMS fixtures only */ }

    previews = await loadPreviews();
    const now = Date.now();
    const merged = [...db, ...cms.filter(c => !db.some(d => same(d, c)))]
      .filter(m => m.status !== 'cancelled');
    const isPast = (m: Match) => m.status === 'full-time' || (hasScore(m) && m.status !== 'live') || new Date(m.event_date).getTime() <= now;
    const upcoming = show === 'upcoming';
    const items = merged
      .filter(m => upcoming ? !isPast(m) : isPast(m))
      .sort((x, y) => (new Date(x.event_date).getTime() - new Date(y.event_date).getTime()) * (upcoming ? 1 : -1));

    list.replaceChildren();
    if (!items.length) {
      status.hidden = false;
      status.textContent = upcoming ? 'Fixtures for the next round will be announced soon.' : 'No results yet this season.';
      return;
    }
    status.hidden = true;
    let month = '';
    for (const m of items) {
      const k = monthKey(m.event_date);
      if (k !== month) { month = k; list.append(el('h2', 'fx-month', k)); }
      list.append(card(m, upcoming));
      if (board.dataset.structured) sportsEventLd(m);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-fixtures-board]').forEach(init);
</script>
