---
// Homepage band "MatchDay Kitchen": tells fans they can order food to their
// seat and links to /kitchen/. Placed with the matchday sections (after
// Upcoming Matches). Says "ordering opens on home match days" by default; on
// the day, when ordering is open (/api/food/menu), it says so and names the match.
---
<section class="fp" aria-labelledby="fp-title">
  <div class="fp-wrap"><div class="fp-inner">
    <img class="fp-logo" src="/images/matchday-kitchen-logo.png" alt="" width="96" height="96" loading="lazy" decoding="async" />
    <div class="fp-text">
      <p class="fp-kicker">Matchday at McCarthy Stadium</p>
      <h2 class="fp-title" id="fp-title">MatchDay Kitchen</h2>
      <p class="fp-lede">Order food and drinks from your phone, pay online and we bring them to your seat. Stay in your seat and don't miss a moment of the match.</p>
      <p class="fp-status" data-food-status>Ordering opens on Lobi Stars home match days.</p>
    </div>
    <div class="fp-acts">
      <a class="fp-btn" href="/kitchen/" data-track="kitchen_click" data-track-label="home_section">Order food to your seat</a>
      <a class="fp-link" href="/tickets/">Buy match tickets</a>
    </div>
  </div></div>
</section>

<style>
  /* Same band colour as Upcoming Matches above, so the matchday sections read as one group. */
  .fp { padding: 0 0 36px; background: var(--dark); border-bottom: 1px solid var(--d4); }
  /* The same container as Upcoming Matches above. */
  .fp-wrap { max-width: 1280px; margin: 0 auto; padding: 0 5%; box-sizing: border-box; }
  .fp-inner {
    box-sizing: border-box; padding: 24px 28px;
    display: flex; align-items: center; justify-content: space-between; gap: 18px 32px; flex-wrap: wrap;
    background: var(--d2); border: 1px solid var(--d4); border-left: 5px solid var(--red); border-radius: 14px;
    box-shadow: 0 1px 2px rgba(16, 24, 40, .05), 0 6px 16px -6px rgba(16, 24, 40, .10);
  }
  .fp-logo { width: 96px; height: 96px; flex: none; object-fit: contain; }
  .fp-text { flex: 1 1 380px; min-width: 0; }
  .fp-kicker { margin: 0 0 6px; font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: .14em; text-transform: uppercase; color: var(--red-text); }
  .fp-title { margin: 0 0 8px; font: 400 clamp(28px, 3.6vw, 38px)/1 'Bebas Neue', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: var(--white); }
  .fp-lede { margin: 0 0 8px; max-width: 620px; font-size: 16px; line-height: 1.5; color: var(--white); }
  .fp-status { margin: 0; font: 700 14px/1.4 'Barlow Condensed', sans-serif; letter-spacing: .04em; color: var(--lt); }
  .fp-status.is-open { color: #17643A; }
  .fp-acts { display: flex; align-items: center; gap: 10px 18px; flex-wrap: wrap; }
  .fp-btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border-radius: 8px; background: #18C93A; color: #04140A; text-decoration: none; font: 700 14px/1 'Barlow Condensed', sans-serif; letter-spacing: .1em; text-transform: uppercase; }
  .fp-btn:hover, .fp-btn:focus-visible { background: #0F7A26; color: #fff; }
  .fp-link { display: inline-flex; align-items: center; min-height: 44px; color: var(--red-text); font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: .1em; text-transform: uppercase; text-decoration: underline; text-underline-offset: 3px; }
  .fp a:focus-visible { outline: 3px solid var(--red); outline-offset: 2px; }
  @media (max-width: 600px) {
    .fp { padding-bottom: 28px; }
    .fp-wrap { padding: 0 16px; }
  }
  /* Phones (under 768px): a compact header row (logo left, label and title right), then the text and full-width button. */
  @media (max-width: 767px) {
    .fp-inner { display: grid; grid-template-columns: 64px minmax(0, 1fr); grid-template-areas: "logo kicker" "logo title" "lede lede" "status status" "acts acts"; column-gap: 12px; row-gap: 0; align-items: center; padding: 16px; }
    .fp-text { display: contents; }
    .fp-logo { grid-area: logo; width: 64px; height: 64px; border-radius: 50%; align-self: center; }
    .fp-kicker { grid-area: kicker; align-self: end; margin: 0 0 4px; }
    .fp-title { grid-area: title; align-self: start; margin: 0; font-size: 27px; line-height: 1; overflow-wrap: anywhere; }
    .fp-lede { grid-area: lede; margin: 12px 0 8px; font-size: 16px; line-height: 1.5; }
    .fp-status { grid-area: status; margin: 0; }
    .fp-acts { grid-area: acts; display: flex; flex-direction: column; align-items: stretch; gap: 4px; margin-top: 14px; width: 100%; }
    .fp-btn { width: 100%; justify-content: center; box-sizing: border-box; min-height: 48px; padding: 0 14px; text-align: center; }
    .fp-link { justify-content: center; align-self: center; min-height: 44px; padding: 0 12px; }
  }
</style>

<script is:inline>
(function () {
  var el = document.querySelector('[data-food-status]');
  if (!el) return;
  fetch('/api/food/menu').then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
    if (d && d.open) {
      el.textContent = 'Ordering is open now' + (d.match ? ': ' + d.match + '.' : '.');
      el.classList.add('is-open');
    }
  }).catch(function () {});
})();
</script>
