---
// "Join the Lobi Stars WhatsApp Channel". Not shown at all until the channel
// address is set in the Content CMS (Site Settings & Shop › Season, Homepage
// Stats & Footer Text › Social links › WhatsApp Channel): the address comes from
// the shared list in src/data/social.ts, like the footer.
//   home: the homepage card (between the Matchday Fan Zone and the newsletter)
//   band: a full-width strip (Watch page)
//   card: a compact card (news articles)
import { WHATSAPP_CHANNEL_URL, WHATSAPP_CHANNEL_SHOWN, WHATSAPP_ICON } from '../data/social';
interface Props { variant?: 'home' | 'band' | 'card' }
const { variant = 'card' } = Astro.props;
const url = WHATSAPP_CHANNEL_URL;
// Shown while the address is still a placeholder too, with the button not clickable yet.
const show = WHATSAPP_CHANNEL_SHOWN;
---
{show && variant === 'home' && (
  <section class="wah" aria-labelledby="wah-title">
    <div class="wah-card">
      <div class="wah-badge" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={WHATSAPP_ICON} /></svg></div>
      <div class="wah-text">
        <p class="wah-eyebrow">Official channel</p>
        <h2 id="wah-title">Join the Lobi Stars WhatsApp Channel</h2>
        <p>Get match-day updates, team news, ticket releases and behind-the-scenes content straight to your phone.</p>
      </div>
      <div class="wah-cta">
        {url
          ? <a class="wah-btn" href={url} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-label="channel-home">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={WHATSAPP_ICON} /></svg>
              Join WhatsApp Channel<span class="sr-only"> (opens WhatsApp)</span>
            </a>
          : <span class="wah-btn wah-soon" aria-disabled="true" title="Coming soon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={WHATSAPP_ICON} /></svg>
              Join WhatsApp Channel<span class="sr-only"> (coming soon)</span>
            </span>}
        <p class="wah-note">Free to join. Your phone number stays private.</p>
      </div>
    </div>
  </section>
)}
{show && variant !== 'home' && (
  <section class:list={['wac', `wac--${variant}`]} aria-label="WhatsApp Channel">
    <div class="wac-inner">
      <svg class="wac-ic" viewBox="0 0 24 24" aria-hidden="true"><path d={WHATSAPP_ICON} /></svg>
      <div class="wac-text">
        <strong>Join our WhatsApp Channel</strong>
        <span>Get match updates, line-ups and goals straight to your phone.</span>
      </div>
      {url
        ? <a class="wac-btn" href={url} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-label={`channel-${variant}`}>Join the channel <span class="sr-only">(opens WhatsApp)</span></a>
        : <span class="wac-btn wac-soon" aria-disabled="true" title="Coming soon">Join the channel<span class="sr-only"> (coming soon)</span></span>}
    </div>
  </section>
)}

<style>
  /* Homepage card: white card with the site's rounded corners and soft shadow, WhatsApp-green button. */
  .wah { max-width: 1280px; margin: 0 auto; padding: 40px 5%; }
  .wah-card { display: flex; align-items: center; gap: 22px 28px; flex-wrap: wrap; background: #fff; border: 1px solid var(--d4);
    border-left: 5px solid #25D366; border-radius: 14px; padding: clamp(20px, 3vw, 32px); box-shadow: 0 16px 40px rgba(15, 17, 21, .06); }
  .wah-badge { width: 64px; height: 64px; border-radius: 50%; background: #E8F7EE; display: flex; align-items: center; justify-content: center; flex: none; }
  .wah-badge svg { width: 34px; height: 34px; fill: #1DA851; }
  .wah-text { flex: 1 1 380px; min-width: 0; }
  .wah-eyebrow { margin: 0 0 6px; font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; color: var(--red); }
  .wah-text h2 { margin: 0 0 8px; color: var(--white); font: 400 clamp(26px, 3.4vw, 36px)/1.05 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .wah-text p:last-child { margin: 0; color: var(--lt); line-height: 1.6; max-width: 640px; }
  .wah-cta { flex: none; display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .wah-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; padding: 0 24px; border-radius: 999px;
    background: #25D366; color: #fff; text-decoration: none; font: 700 15px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase;
    box-shadow: 0 6px 18px -6px rgba(37, 211, 102, .7); transition: background .2s, transform .2s; }
  .wah-btn svg { width: 20px; height: 20px; fill: #fff; flex: none; }
  .wah-btn:hover { background: #1DA851; transform: translateY(-1px); }
  .wah-btn:focus-visible { outline: 3px solid #FFC72C; outline-offset: 3px; }
  /* Not connected yet: looks the same, nothing happens on click. */
  .wah-soon, .wac-soon { cursor: default; }
  .wah-btn.wah-soon:hover { background: #25D366; transform: none; }
  .wac-btn.wac-soon:hover { background: #fff; outline: none; }
  .wah-note { margin: 0; font-size: 13px; color: var(--lt); text-align: center; }
  @media (max-width: 600px) {
    .wah { padding: 28px 16px; }
    .wah-card { flex-direction: column; align-items: flex-start; }
    .wah-text { flex: none; } /* stacked: the 380px basis would become a height */
    .wah-badge { width: 52px; height: 52px; } .wah-badge svg { width: 28px; height: 28px; }
    .wah-cta { width: 100%; } .wah-btn { width: 100%; }
  }
  /* Phones (the site's 767px breakpoint): the card floats on a full-width WhatsApp-green band
     (bright green on the left, fading lighter to the right) with green showing all round. */
  @media (max-width: 767px) {
    .wah { max-width: none; padding: 14px 12px; background: linear-gradient(100deg, #0FB341 0%, #2CC860 30%, #8FE3AC 68%, #E3F8EA 100%); }
    .wah-card { border: none; border-radius: 22px; box-shadow: 0 10px 28px rgba(8, 72, 32, .14); }
    .wah-btn { background: #0FB341; box-shadow: 0 8px 20px -6px rgba(15, 179, 65, .65); }
    .wah-btn:hover, .wah-btn.wah-soon:hover { background: #0C9A37; }
    .wah-badge svg { fill: #0FB341; }
  }
  @media (prefers-reduced-motion: reduce) { .wah-btn { transition: none; } .wah-btn:hover { transform: none; } }

  /* Strip and compact card (Watch page, news articles). */
  .wac { background: #157A42; color: #fff; }
  .wac-inner { max-width: 1280px; margin: 0 auto; padding: 22px 5%; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .wac-ic { width: 36px; height: 36px; fill: #fff; flex-shrink: 0; }
  .wac-text { flex: 1; min-width: 220px; display: flex; flex-direction: column; gap: 4px; }
  .wac-text strong { font: 700 17px/1.2 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; }
  .wac-text span { font-size: 15px; color: rgba(255, 255, 255, .92); }
  .wac-btn { background: #fff; color: #145F36; padding: 12px 22px; border-radius: 999px; text-decoration: none; white-space: nowrap;
    font: 700 14px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; }
  .wac-btn:hover, .wac-btn:focus-visible { background: #E8F7EE; outline: 3px solid #FFC72C; outline-offset: 2px; }
  .wac--card { border-radius: 14px; margin: 32px 0; }
  .wac--card .wac-inner { padding: 20px 22px; }
</style>
