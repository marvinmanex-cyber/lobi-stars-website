---
// The next Lobi Stars match as the featured match card (the same card as the
// homepage and /fixtures: date, kick-off and venue, countdown tiles, Tickets
// for home matches). Loads /api/league/overview; if that fails it says so and
// links to the fixtures. Not placed on a page yet: drop <NextMatchCard />
// wherever it should appear.
import '../../styles/fixture-card.css';
---
<section class="nmc" data-next-match aria-labelledby="nmc-h">
  <h2 id="nmc-h" class="nmc-h">Next match</h2>
  <div data-body><p class="nmc-msg">Loading the next match… <a href="/fixtures/">See all fixtures</a></p></div>
</section>

<style>
  .nmc-h { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .nmc-msg { margin: 0; color: var(--lt); } .nmc-msg a { color: var(--red-text); font-weight: 600; }
</style>

<script>
  import { fixtureCardHtml, shareAction } from '../../../functions/api/_lib/fixtureCard.js';
  import { startCountdowns } from '../../lib/fixtureCards';

  document.querySelectorAll<HTMLElement>('[data-next-match]').forEach(box => {
    const body = box.querySelector<HTMLElement>('[data-body]')!;
    const fail = (text: string) => { body.innerHTML = `<p class="nmc-msg">${text} <a href="/fixtures/">See all fixtures</a></p>`; };
    fetch('/api/league/overview').then(r => { if (!r.ok) throw new Error(); return r.json(); }).then(o => {
      const f = o.nextLobi;
      if (!f) return fail('The next fixture will be announced soon.');
      const matchUrl = f.matchUrl ? f.matchUrl.replace(/^https?:\/\/[^/]+/, '') : '';
      const acts = [];
      if (f.home.isLobi) acts.push('<a class="lg-btn primary" href="/tickets/">Tickets</a>');
      if (matchUrl) acts.push(`<a class="lg-btn" href="${encodeURI(matchUrl)}">Match Centre</a>`);
      acts.push(`<a class="lg-btn" href="/api/league/calendar.ics?fixture=${encodeURIComponent(f.id)}" download>Add to calendar</a>`);
      if (matchUrl) acts.push(shareAction(matchUrl, `${f.home.name} vs ${f.away.name}`));
      // Every value is escaped by the card builder.
      body.innerHTML = fixtureCardHtml({
        featured: true, home: f.home, away: f.away, kickoff: f.kickoff, venue: f.venue, status: f.status,
        homeGoals: f.homeGoals, awayGoals: f.awayGoals, matchday: f.matchday, competition: f.competition, actions: acts,
      });
      startCountdowns();
    }).catch(() => fail('The next match could not be loaded just now.'));
  });
</script>
