---
// Red "LIVE NOW" banner shown at the top of the homepage while a Lobi Stars
// HOME game is live. The live status comes from the server (/api/matches).
---
<a class="lb" id="liveBanner" href="/fixtures" hidden>
  <span class="lb-dot" aria-hidden="true"></span>
  <span class="lb-text"><strong>LIVE NOW:</strong> <span data-lb-teams></span> <span class="lb-cta">– Watch, Listen, Vote</span></span>
  <span class="lb-arrow" aria-hidden="true">&rarr;</span>
</a>

<style>
  .lb {
    display: flex; align-items: center; justify-content: center; gap: 10px; padding: 12px 5%;
    background: var(--red); color: #fff; text-decoration: none; text-align: center;
    font: 700 15px/1.3 'Barlow Condensed', sans-serif; letter-spacing: .8px; text-transform: uppercase;
  }
  .lb[hidden] { display: none; }
  .lb:hover, .lb:focus-visible { background: var(--rd); }
  .lb:focus-visible { outline: 3px solid #FFC72C; outline-offset: -3px; }
  .lb-dot { width: 10px; height: 10px; border-radius: 50%; background: #fff; flex-shrink: 0; animation: lbpulse 1.2s infinite; }
  .lb-text :global(span), .lb-text strong { color: #fff; }
  .lb-arrow { font-size: 18px; }
  @keyframes lbpulse { 50% { opacity: .25; } }
  @media (max-width: 480px) { .lb-cta { display: none; } }
</style>

<script>
  async function check() {
    const banner = document.getElementById('liveBanner') as HTMLAnchorElement | null;
    if (!banner) return;
    try {
      const { matches = [] } = await (await fetch('/api/matches')).json();
      const live = matches.find((m: any) => m.is_home && (m.status === 'live' || m.status === 'half-time'));
      if (!live) { banner.hidden = true; return; }
      const opponent = /lobi stars/i.test(live.home_team) ? live.away_team : live.home_team;
      banner.querySelector('[data-lb-teams]')!.textContent = `Lobi Stars vs ${opponent}`;
      banner.href = `/matches/${live.slug}/live/`;
      banner.hidden = false;
    } catch { /* leave hidden */ }
  }
  check();
  setInterval(check, 60_000);
</script>
