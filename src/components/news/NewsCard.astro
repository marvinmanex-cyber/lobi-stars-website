---
import type { Article } from '../../lib/news';
import { categoryHref } from '../../lib/news';
import RelativeTime from './RelativeTime.astro';

interface Props { article: Article }
const { article } = Astro.props;
const a = article.data;
const href = `/news/${article.id}`;
---
<article class="nc" data-cat={a.category}>
  <div class="nc-media">
    <img src={a.coverImage} alt={a.imageAlt} loading="lazy" decoding="async" width="640" height="360" />
    {a.isVideo && (
      <span class="nc-badge">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
        {a.videoDuration && <span>{a.videoDuration}</span>}
        <span class="sr-only">Video</span>
      </span>
    )}
  </div>
  <div class="nc-meta">
    <a class="nc-cat" href={categoryHref(a.category)}>{a.category}</a>
    <RelativeTime date={a.publishedAt} class="nc-time" />
  </div>
  <h3 class="nc-title"><a class="nc-link" href={href}>{a.title}</a></h3>
</article>

<style>
  .nc { position: relative; display: flex; flex-direction: column; min-width: 0; }
  .nc-media {
    position: relative; aspect-ratio: 16 / 9; border-radius: 10px; overflow: hidden;
    background: var(--d3);
  }
  .nc-media img {
    display: block; width: 100%; height: 100%; object-fit: cover;
    transition: transform .3s ease;
  }
  .nc:hover .nc-media img, .nc:focus-within .nc-media img { transform: scale(1.05); }

  .nc-badge {
    position: absolute; left: 10px; bottom: 10px; display: inline-flex; align-items: center; gap: 6px;
    background: rgba(15, 17, 21, .82); color: #fff; border-radius: 4px; padding: 4px 8px 4px 6px;
    font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: .5px;
  }
  .nc-badge span { color: #fff; }
  .nc-badge svg { width: 14px; height: 14px; fill: #fff; flex-shrink: 0; }

  .nc-meta {
    display: flex; align-items: center; gap: 10px; margin-top: 12px;
    font: 600 12px/1.2 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase;
  }
  .nc-cat {
    position: relative; z-index: 2; color: var(--red); font-weight: 700; text-decoration: none;
  }
  .nc-cat:hover, .nc-cat:focus-visible { text-decoration: underline; }
  .nc-time { color: var(--lt); }

  .nc-title {
    margin: 6px 0 0; font: 700 19px/1.25 'Barlow Condensed', sans-serif;
    letter-spacing: 0; text-transform: none; color: var(--white);
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .nc-link {
    color: inherit; text-decoration: underline transparent; text-underline-offset: 3px;
    transition: color .3s ease, text-decoration-color .3s ease;
  }
  /* Stretch the headline link over the whole card. */
  .nc-link::after { content: ''; position: absolute; inset: 0; z-index: 1; border-radius: 10px; }
  .nc-link:focus-visible { outline: none; }
  .nc-link:focus-visible::after { outline: 3px solid var(--red); outline-offset: 4px; }
  .nc:hover .nc-link, .nc-link:focus-visible { color: var(--red); text-decoration-color: currentColor; }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
</style>
