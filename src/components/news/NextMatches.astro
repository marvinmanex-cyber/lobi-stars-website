---
// Upcoming First Team fixtures, loaded in the browser from /api/events
// (the same source as the ticket shop and match countdown).
---
<section class="nm" aria-labelledby="nm-title" data-next-matches>
  <div class="nm-inner">
    <div class="nm-head">
      <h2 class="nm-title" id="nm-title">Next Matches</h2>
      <a class="nm-all" href="/fixtures">All fixtures <span aria-hidden="true">&rarr;</span></a>
    </div>
    <ul class="nm-track" data-nm-track aria-live="polite">
      <li class="nm-empty" data-nm-status>Loading fixtures&hellip;</li>
    </ul>
  </div>
</section>

<style>
  .nm { background: var(--dark); border-bottom: 1px solid var(--d4); padding: 36px 0; }
  .nm-inner { max-width: 1280px; margin: 0 auto; padding: 0 5%; }
  .nm-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
  .nm-title {
    margin: 0; font: 400 clamp(26px, 3.4vw, 34px)/1 'Bebas Neue', sans-serif; letter-spacing: 1px;
    text-transform: uppercase; color: var(--white);
  }
  .nm-all {
    font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.2px; text-transform: uppercase;
    color: var(--red-text); text-decoration: none; white-space: nowrap;
  }
  .nm-all:hover, .nm-all:focus-visible { text-decoration: underline; }
  .nm-track {
    list-style: none; margin: 0; padding: 2px 2px 6px; display: flex; gap: 16px; overflow-x: auto;
    scroll-snap-type: x mandatory; scrollbar-width: none;
  }
  .nm-track::-webkit-scrollbar { display: none; }
  .nm-empty { color: var(--lt); font-size: 15px; padding: 18px 0; }
  .nm-empty a { color: var(--red-text); font-weight: 600; }

  .nm-track :global(.nm-card) {
    flex: 0 0 300px; scroll-snap-align: start; background: var(--d2); border: 1px solid var(--d4);
    border-radius: 10px; padding: 16px 18px; display: flex; flex-direction: column; gap: 12px;
  }
  .nm-track :global(.nm-top) { display: flex; align-items: center; gap: 10px; }
  .nm-track :global(.nm-comp-logo) {
    flex-shrink: 0; min-width: 40px; height: 40px; padding: 0 6px; border-radius: 8px; background: var(--red); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font: 400 16px/1 'Bebas Neue', sans-serif; letter-spacing: 1px;
  }
  .nm-track :global(.nm-comp) { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .nm-track :global(.nm-comp-name) {
    color: var(--white); font: 700 13px/1.1 'Barlow Condensed', sans-serif; letter-spacing: .8px; text-transform: uppercase;
  }
  .nm-track :global(.nm-venue) { color: var(--lt); font-size: 12px; line-height: 1.3; }
  .nm-track :global(.nm-when) {
    color: var(--white); font: 600 14px/1.3 'Barlow Condensed', sans-serif; letter-spacing: .4px;
  }
  .nm-track :global(.nm-when b) { color: var(--red-text); }
  .nm-track :global(.nm-opp) { display: flex; align-items: center; gap: 12px; }
  .nm-track :global(.nm-crest) {
    width: 44px; height: 44px; border-radius: 50%; object-fit: contain; background: #fff; border: 1px solid var(--d4); flex-shrink: 0;
  }
  .nm-track :global(.nm-crest-fallback) {
    display: flex; align-items: center; justify-content: center; background: var(--d3); color: var(--lt);
    font: 400 20px/1 'Bebas Neue', sans-serif;
  }
  .nm-track :global(.nm-opp-name) { color: var(--white); font: 700 17px/1.2 'Barlow Condensed', sans-serif; }
  .nm-track :global(.nm-ha) {
    margin-left: auto; font: 700 11px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase;
    padding: 5px 8px; border-radius: 3px; background: var(--d3); color: var(--white);
  }
  .nm-track :global(.nm-ha.home) { background: var(--red); color: #fff; }
  .nm-track :global(.nm-link) {
    margin-top: auto; padding-top: 12px; border-top: 1px solid var(--d4); color: var(--red-text); text-decoration: none;
    font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.2px; text-transform: uppercase;
  }
  .nm-track :global(.nm-link:hover), .nm-track :global(.nm-link:focus-visible) { text-decoration: underline; }
</style>

<script>
  import { TEAM_LOGOS } from '../../../functions/api/_lib/teamLogos.js';
  import { matchSlug } from '../../../functions/api/_lib/matchSlug.js';

  type ClubEvent = { id: string; home_team: string; away_team: string; competition?: string; event_date: string; venue: string };

  // Only used by `astro dev`, where the Cloudflare /api functions don't run.
  const DEV_SAMPLE: ClubEvent[] = [
    { id: 'sample-1', home_team: 'Lobi Stars FC', away_team: 'Kada Warriors FC', competition: 'NNL Conference D', event_date: '2026-10-23T15:30:00Z', venue: 'McCarthy Stadium, Makurdi' },
    { id: 'sample-2', home_team: 'Wikki Tourists FC', away_team: 'Lobi Stars FC', competition: 'NNL Conference D', event_date: '2026-10-31T15:00:00Z', venue: 'Abubakar Tafawa Balewa Stadium, Bauchi' },
    { id: 'sample-3', home_team: 'Lobi Stars FC', away_team: 'Sokoto United FC', competition: 'NNL Conference D', event_date: '2026-11-07T15:30:00Z', venue: 'McCarthy Stadium, Makurdi' },
  ];

  const isLobi = (name: string) => /lobi stars/i.test(name);

  function compAbbr(comp: string) {
    const first = comp.trim().split(/\s+/)[0] || '';
    return /^[A-Z]{2,5}$/.test(first) ? first : comp.split(/\s+/).map(w => w[0]).join('').slice(0, 4).toUpperCase();
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, text?: string) {
    const e = document.createElement(tag);
    e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  }

  function card(ev: ClubEvent) {
    const home = isLobi(ev.home_team);
    const opponent = home ? ev.away_team : ev.home_team;
    const comp = ev.competition || 'NPFL';
    const d = new Date(ev.event_date);
    const date = d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Africa/Lagos' });
    const time = d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Africa/Lagos' });

    const li = el('li', 'nm-card');

    const top = el('div', 'nm-top');
    const logo = el('span', 'nm-comp-logo', compAbbr(comp));
    logo.setAttribute('aria-hidden', 'true');
    const compBox = el('div', 'nm-comp');
    compBox.append(el('span', 'nm-comp-name', comp), el('span', 'nm-venue', ev.venue));
    top.append(logo, compBox);

    const when = el('div', 'nm-when');
    when.append(`${date} · `, el('b', '', `${time} WAT`));

    const opp = el('div', 'nm-opp');
    const crestSrc = (TEAM_LOGOS as Record<string, string>)[opponent];
    if (crestSrc) {
      const img = el('img', 'nm-crest') as HTMLImageElement;
      img.src = crestSrc; img.alt = `${opponent} crest`; img.loading = 'lazy'; img.width = 44; img.height = 44;
      opp.append(img);
    } else {
      const fb = el('span', 'nm-crest nm-crest-fallback', opponent.charAt(0));
      fb.setAttribute('aria-hidden', 'true');
      opp.append(fb);
    }
    opp.append(el('span', 'nm-opp-name', opponent), el('span', `nm-ha ${home ? 'home' : 'away'}`, home ? 'Home' : 'Away'));

    const link = el('a', 'nm-link', 'Match Centre →') as HTMLAnchorElement;
    link.href = ev.id.startsWith('sample-') ? '/fixtures' : `/matches/${matchSlug(ev)}/`;
    link.setAttribute('aria-label', `Match Centre: Lobi Stars FC vs ${opponent}`);

    li.append(top, when, opp, link);
    return li;
  }

  async function load(section: HTMLElement) {
    const track = section.querySelector<HTMLElement>('[data-nm-track]')!;
    let events: ClubEvent[] = [];
    try {
      const res = await fetch('/api/events');
      if (!res.ok) throw new Error(String(res.status));
      events = (await res.json()).events || [];
    } catch {
      if (import.meta.env.DEV) events = DEV_SAMPLE;
    }
    const now = Date.now();
    const upcoming = events
      .filter(ev => (isLobi(ev.home_team) || isLobi(ev.away_team)) && new Date(ev.event_date).getTime() > now)
      .sort((a, b) => new Date(a.event_date).getTime() - new Date(b.event_date).getTime());

    track.replaceChildren();
    if (upcoming.length === 0) {
      const li = el('li', 'nm-empty', 'No upcoming First Team fixtures have been announced yet. ');
      const a = el('a', '', 'See all fixtures') as HTMLAnchorElement;
      a.href = '/fixtures';
      li.append(a);
      track.append(li);
      return;
    }
    upcoming.forEach(ev => track.append(card(ev)));
  }

  document.querySelectorAll<HTMLElement>('[data-next-matches]').forEach(load);
</script>
