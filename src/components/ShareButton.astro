---
// Share this page. Works without JavaScript: a <details> menu of plain links
// (WhatsApp, Facebook, X, Telegram, Email). With JavaScript, everything is
// worked out when the button is pressed (so it always shares the page you are
// on, even after in-page navigation): phones get their own share sheet,
// "Copy link" appears, links carry utm tags, and the click is counted
// anonymously (page and platform only) at /api/share/event.
// No third-party scripts, widgets or trackers.
interface Props {
  title?: string;
  text?: string;
  url?: string;
  hashtags?: string;
  variant?: 'button' | 'icon';
  label?: string;
  class?: string;
}
const { title, text, url, hashtags = 'LobiStarsFC', variant = 'button', label = 'Share', class: cls } = Astro.props;
const pageUrl = url || new URL(Astro.url.pathname, Astro.site).toString();
const withUtm = (src: string) => { const u = new URL(pageUrl); u.searchParams.set('utm_source', src); u.searchParams.set('utm_medium', 'social'); u.searchParams.set('utm_campaign', 'page_share'); return u.toString(); };
const t = title || '';
const e = encodeURIComponent;
const links = [
  { key: 'whatsapp', name: 'WhatsApp', href: `https://wa.me/?text=${e(`${t}\n${withUtm('whatsapp')}`.trim())}` },
  { key: 'facebook', name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${e(withUtm('facebook'))}` },
  { key: 'twitter', name: 'X', href: `https://x.com/intent/post?text=${e(t)}&url=${e(withUtm('twitter'))}&hashtags=${e(hashtags)}&via=LobiStars` },
  { key: 'telegram', name: 'Telegram', href: `https://t.me/share/url?url=${e(withUtm('telegram'))}&text=${e(t)}` },
  { key: 'email', name: 'Email', href: `mailto:?subject=${e(t)}&body=${e(`${t}\n${withUtm('email')}`.trim())}` },
];
---
<details class:list={['share', `share--${variant}`, cls]} data-share data-share-title={title} data-share-text={text} data-share-url={url} data-share-tags={hashtags}>
  <summary class="share-btn" aria-label="Share this page">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18 16.1c-.8 0-1.4.3-2 .8l-7.1-4.2c.1-.2.1-.5.1-.7s0-.5-.1-.7L16 7.2c.5.5 1.2.8 2 .8 1.7 0 3-1.3 3-3s-1.3-3-3-3-3 1.3-3 3c0 .2 0 .5.1.7L8 9.8C7.5 9.3 6.8 9 6 9c-1.7 0-3 1.3-3 3s1.3 3 3 3c.8 0 1.5-.3 2-.8l7.1 4.2c-.1.2-.1.4-.1.6 0 1.6 1.3 2.9 2.9 2.9s2.9-1.3 2.9-2.9-1.2-2.9-2.8-2.9z"/></svg>
    {variant === 'button' && <span>{label}</span>}
  </summary>
  <div class="share-menu">
    <p class="share-head" aria-hidden="true">Share this page</p>
    <ul>
      {links.map(l => (
        <li><a class={`share-opt share-opt--${l.key}`} href={l.href} target="_blank" rel="noopener noreferrer" data-share-to={l.key}><span class="share-dot" aria-hidden="true"></span>{l.name}</a></li>
      ))}
      <li class="share-js"><button type="button" class="share-opt share-opt--copy" data-share-to="copy"><span class="share-dot" aria-hidden="true"></span>Copy link</button></li>
    </ul>
    <p class="share-done" role="status" aria-live="polite"></p>
  </div>
</details>

<style is:global>
  .share { position: relative; display: inline-block; flex: none; }
  .share > summary { list-style: none; }
  .share > summary::-webkit-details-marker { display: none; }
  .share-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; min-width: 44px; box-sizing: border-box;
    padding: 8px 16px 8px 14px; border-radius: 999px; border: 1.5px solid var(--d4, #D5D9DE); background: var(--d2, #fff); color: var(--white, #111);
    font: 700 14px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; user-select: none;
    transition: border-color .15s, color .15s;
  }
  .share--icon .share-btn { padding: 0; width: 44px; }
  .share-btn svg { width: 18px; height: 18px; fill: currentColor; flex: none; }
  .share-btn:hover, .share[open] > .share-btn { border-color: var(--red, #E31E24); color: var(--red, #C11A1F); }
  .share-btn:focus-visible { outline: 3px solid var(--red, #E31E24); outline-offset: 2px; }
  .share-menu {
    position: absolute; right: 0; top: calc(100% + 8px); z-index: 60; width: 240px; max-width: calc(100vw - 32px); box-sizing: border-box;
    background: var(--d2, #fff); color: var(--white, #111); border: 1px solid var(--d4, #D5D9DE); border-radius: 14px;
    box-shadow: 0 14px 34px rgba(15, 17, 21, .18); padding: 8px;
  }
  .share.share--left .share-menu, .share.share--l .share-menu { right: auto; left: 0; }
  .share.share--r .share-menu { left: auto; right: 0; }
  .share-head { margin: 4px 8px 6px; font: 700 12px/1.2 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; color: var(--lt, #5B6470); }
  .share-menu ul { list-style: none; margin: 0; padding: 0; }
  .share-opt {
    display: flex; align-items: center; gap: 12px; width: 100%; min-height: 44px; box-sizing: border-box; padding: 8px 10px; border: 0; border-radius: 10px;
    background: none; color: inherit; font: 600 16px/1.2 'Barlow', sans-serif; text-decoration: none; text-align: left; cursor: pointer;
  }
  .share-opt:hover, .share-opt:focus-visible { background: var(--d3, #F1F3F5); }
  .share-opt:focus-visible { outline: 3px solid var(--red, #E31E24); outline-offset: -3px; }
  .share-dot { width: 12px; height: 12px; border-radius: 50%; flex: none; background: #5B6470; }
  .share-opt--whatsapp .share-dot { background: #25D366; }
  .share-opt--facebook .share-dot { background: #1877F2; }
  .share-opt--twitter .share-dot { background: #000; }
  .share-opt--telegram .share-dot { background: #229ED9; }
  .share-opt--copy .share-dot { background: #E31E24; }
  .share-js { display: none; }
  .share.js .share-js { display: block; }
  .share-done { margin: 0; min-height: 0; padding: 0 10px; font-weight: 700; color: #17643A; }
  .share-done:empty { display: none; }
  .share-done:not(:empty) { padding: 6px 10px 4px; }
  @media (max-width: 639px) {
    /* Above the bottom tab bar and the cookie notice. */
    .share[open]::before { content: ''; position: fixed; inset: 0; z-index: 3090; background: rgba(15, 17, 21, .45); }
    .share .share-menu, .share.share--l .share-menu, .share.share--r .share-menu, .share.share--left .share-menu { position: fixed; z-index: 3100; left: 0; right: 0; bottom: 0; top: auto; width: auto; max-width: none; border-radius: 18px 18px 0 0; padding: 12px 16px calc(16px + env(safe-area-inset-bottom)); animation: share-up .18s ease-out; }
    .share-head { text-align: center; margin: 2px 0 10px; }
    .share-opt { min-height: 52px; font-size: 17px; }
  }
  @keyframes share-up { from { transform: translateY(24px); opacity: .6; } }
  @media (prefers-reduced-motion: reduce) { .share-menu { animation: none; } .share-btn { transition: none; } }
  @media print { .share { display: none !important; } }
</style>

<script is:inline>
(function () {
  if (window.__lsShare) return; window.__lsShare = 1;
  var TRACK = /^(utm_[a-z]+|fbclid|gclid|src)$/i;
  function meta(sel) { var m = document.querySelector(sel); return m ? m.getAttribute('content') || m.getAttribute('href') || '' : ''; }
  // Everything is read when the button is used, never at page load.
  function info(box) {
    var raw = box.getAttribute('data-share-url') || meta('link[rel="canonical"]') || (location.origin + location.pathname);
    var u; try { u = new URL(raw, location.href); } catch (e) { u = new URL(location.origin + location.pathname); }
    u.hash = ''; Array.from(u.searchParams.keys()).forEach(function (k) { if (TRACK.test(k)) u.searchParams.delete(k); });
    return {
      url: u.toString(), path: u.pathname,
      title: box.getAttribute('data-share-title') || meta('meta[property="og:title"]') || document.title,
      text: box.getAttribute('data-share-text') || meta('meta[property="og:description"]'),
      tags: box.getAttribute('data-share-tags') || 'LobiStarsFC'
    };
  }
  function tagged(url, src) { var u = new URL(url); u.searchParams.set('utm_source', src); u.searchParams.set('utm_medium', 'social'); u.searchParams.set('utm_campaign', 'page_share'); return u.toString(); }
  function href(key, i) {
    var e = encodeURIComponent, u = tagged(i.url, key);
    if (key === 'whatsapp') return 'https://wa.me/?text=' + e(i.title + '\n' + u);
    if (key === 'facebook') return 'https://www.facebook.com/sharer/sharer.php?u=' + e(u);
    if (key === 'twitter') return 'https://x.com/intent/post?text=' + e(i.title) + '&url=' + e(u) + '&hashtags=' + e(i.tags) + '&via=LobiStars';
    if (key === 'telegram') return 'https://t.me/share/url?url=' + e(u) + '&text=' + e(i.title);
    if (key === 'email') return 'mailto:?subject=' + e(i.title) + '&body=' + e(i.title + '\n' + u);
    return u;
  }
  function count(path, platform) {
    try {
      var k = 'ls_share:' + path + ':' + platform;
      try { if (sessionStorage.getItem(k)) return; sessionStorage.setItem(k, '1'); } catch (e) {}
      if (navigator.sendBeacon) navigator.sendBeacon('/api/share/event', JSON.stringify({ path: path, platform: platform }));
    } catch (e) {}
  }
  function closeAll(except) { document.querySelectorAll('details[data-share][open]').forEach(function (d) { if (d !== except) d.open = false; }); }
  function fill(box) {
    var i = info(box);
    box.querySelectorAll('a[data-share-to]').forEach(function (a) { a.href = href(a.getAttribute('data-share-to'), i); });
    // Keep the menu inside the screen on wide layouts: open towards the side with room.
    var r = box.getBoundingClientRect(), roomRight = window.innerWidth - r.left >= 248;
    box.classList.toggle('share--l', roomRight); box.classList.toggle('share--r', !roomRight);
    return i;
  }
  function copy(text) {
    if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(text);
    return new Promise(function (ok, fail) {
      var t = document.createElement('textarea'); t.value = text; t.setAttribute('readonly', ''); t.style.position = 'fixed'; t.style.opacity = '0';
      document.body.appendChild(t); t.select();
      try { document.execCommand('copy') ? ok() : fail(); } catch (e) { fail(e); } finally { t.remove(); }
    });
  }
  function enhance() { document.querySelectorAll('details[data-share]').forEach(function (d) { d.classList.add('js'); }); }
  enhance();
  document.addEventListener('astro:page-load', enhance);
  document.addEventListener('astro:before-swap', function () { closeAll(); });

  document.addEventListener('click', function (ev) {
    var t = ev.target;
    var sum = t.closest && t.closest('details[data-share] > summary');
    if (sum) {
      var box = sum.parentElement;
      if (box.open) return; // closing
      var i = fill(box);
      closeAll(box);
      var coarse = window.matchMedia && matchMedia('(pointer: coarse)').matches;
      if (coarse && navigator.share) {
        ev.preventDefault();
        var data = { title: i.title, url: tagged(i.url, 'native') }; if (i.text) data.text = i.text;
        navigator.share(data).then(function () { count(i.path, 'native'); }).catch(function (err) {
          if (!err || err.name !== 'AbortError') { fill(box); box.open = true; }
        });
      }
      return;
    }
    var opt = t.closest && t.closest('details[data-share] [data-share-to]');
    if (opt) {
      var b = opt.closest('details[data-share]'), inf = info(b), key = opt.getAttribute('data-share-to');
      count(inf.path, key);
      if (key === 'copy') {
        var done = b.querySelector('.share-done');
        copy(tagged(inf.url, 'copy')).then(function () {
          done.textContent = 'Link copied';
          setTimeout(function () { done.textContent = ''; b.open = false; }, 2000);
        }).catch(function () { done.textContent = 'Could not copy. Copy the address from the address bar.'; });
        return;
      }
      if (opt.tagName === 'A') opt.href = href(key, inf);
      setTimeout(function () { b.open = false; }, 0);
      return;
    }
    // A tap outside, or on the dark backdrop behind the phone sheet, closes it.
    if (t.matches && t.matches('details[data-share]')) { t.open = false; return; }
    if (!(t.closest && t.closest('details[data-share]'))) closeAll();
  });
  document.addEventListener('keydown', function (ev) {
    if (ev.key !== 'Escape') return;
    var open = document.querySelector('details[data-share][open]');
    if (open) { open.open = false; var s = open.querySelector('summary'); if (s) s.focus(); }
  });
})();
</script>
