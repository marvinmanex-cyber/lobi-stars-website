---
// A country's flag with its name next to it (never the flag alone). Local SVG
// flags (public/flags/, flag-icons, MIT).
import { countryName, flagUrl } from '../../lib/countries.js';
interface Props { code: string | null | undefined; size?: number }
const { code, size = 18 } = Astro.props;
const name = countryName(code), src = flagUrl(code);
---
{name && (
  <span class="flag">
    {src && <img src={src} alt={`${name} flag`} width={Math.round(size * 4 / 3)} height={size} loading="lazy" decoding="async" />}
    <span>{name}</span>
  </span>
)}

<style>
  .flag { display: inline-flex; align-items: center; gap: 8px; }
  .flag img { flex: none; border-radius: 2px; box-shadow: 0 0 0 1px rgba(21, 24, 29, .12); object-fit: cover; }
</style>
