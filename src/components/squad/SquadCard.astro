---
// A squad card: the photo on a club-colour background, a large stylised shirt
// number, the first name small above the surname, and the position (or role
// for staff). The whole card is one link. A silhouette shows when there is no photo.
interface Props {
  href: string;
  firstName: string;
  surname: string;
  /** Shown instead of first name + surname when the person is known by another name. */
  name: string;
  subtitle: string;
  photo?: string | null;
  number?: number | null;
}
const { href, firstName, surname, name, subtitle, photo, number } = Astro.props;
// "Name on website" (e.g. a nickname) replaces the two-line name.
const plain = `${firstName} ${surname}`.trim();
const twoLine = !!surname && (!name || name === plain);
---
<a class="sc" href={href}>
  <div class="sc-photo">
    {number != null && <span class="sc-num" aria-hidden="true">{number}</span>}
    {photo
      ? <img src={photo} alt="" loading="lazy" decoding="async" width="400" height="500" />
      : <svg class="sc-sil" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="36" r="18" /><path d="M14 100c0-22 16-36 36-36s36 14 36 36z" /></svg>}
  </div>
  <div class="sc-body">
    {number != null && <span class="sr-only">Number {number}, </span>}
    {twoLine
      ? <span class="sc-name"><span class="sc-first">{firstName}</span><span class="sc-last">{surname}</span></span>
      : <span class="sc-name"><span class="sc-last">{name || plain}</span></span>}
    <span class="sc-sub">{subtitle}</span>
  </div>
</a>

<style>
  .sc { display: flex; flex-direction: column; height: 100%; border-radius: 14px; overflow: hidden; text-decoration: none; color: inherit; background: var(--d2); border: 1px solid var(--d4); transition: transform .25s, box-shadow .25s; }
  .sc:focus-visible { outline: 3px solid var(--red); outline-offset: 3px; }
  .sc-photo { position: relative; aspect-ratio: 4 / 5; overflow: hidden;
    background: radial-gradient(120% 80% at 50% 0%, #F0353B 0%, #C11A1F 55%, #7A0E12 100%); }
  .sc-photo::after { content: ''; position: absolute; inset: auto 0 0; height: 35%; background: linear-gradient(to top, rgba(77, 11, 13, .55), transparent); pointer-events: none; }
  .sc-num { position: absolute; top: 6px; left: 12px; z-index: 0; font: 400 clamp(88px, 15vw, 132px)/.85 'Bebas Neue', sans-serif; letter-spacing: -2px;
    color: transparent; -webkit-text-stroke: 2px rgba(255, 199, 44, .9); text-shadow: 0 6px 24px rgba(0, 0, 0, .18); }
  .sc-photo img { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform .35s; }
  .sc-sil { position: absolute; left: 15%; bottom: 0; z-index: 1; width: 70%; fill: rgba(255, 255, 255, .35); }
  .sc-body { padding: 12px 14px 16px; display: flex; flex-direction: column; gap: 6px; border-top: 4px solid #FFC72C; }
  .sc-name { display: flex; flex-direction: column; }
  .sc-first { font: 600 15px/1.1 'Barlow Condensed', sans-serif; color: var(--lt); text-transform: uppercase; letter-spacing: 1px; }
  .sc-last { font: 400 clamp(24px, 3vw, 30px)/1 'Bebas Neue', sans-serif; letter-spacing: .5px; color: var(--white); overflow-wrap: anywhere; }
  .sc-sub { font: 700 12px/1.2 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; color: var(--red-text); }
  @media (hover: hover) {
    .sc:hover { transform: translateY(-4px); box-shadow: 0 18px 34px rgba(15, 17, 21, .14); }
    .sc:hover .sc-photo img { transform: scale(1.05); }
  }
  @media (prefers-reduced-motion: reduce) { .sc, .sc-photo img { transition: none; } }
</style>
