---
// Thin dismissible bar at the very top of the site (inside the fixed header).
// Edited in the CMS (Site Settings -> Promo Bar). Start/end dates are checked
// in the visitor's browser against Nigerian time; dismissing hides it for the
// rest of the browsing session only.
import promo from '../data/promo.json';
const on = promo.enabled && !!promo.text?.trim();
const external = /^https?:\/\//.test(promo.url || '');
const key = `ls_promo_${(promo.text + promo.url).length}_${promo.start}_${promo.end}`;
---
{on && (
  <div class="promo" id="promoBar" data-start={promo.start} data-end={promo.end} data-key={key} role="region" aria-label="Announcement">
    <p class="promo-text">
      {promo.text}
      {promo.url && promo.linkText && (
        <a href={promo.url} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>{promo.linkText} <span aria-hidden="true">&rarr;</span></a>
      )}
    </p>
    <button type="button" class="promo-x" id="promoClose" aria-label="Dismiss announcement">&times;</button>
  </div>
  <script is:inline>
    (function () {
      var bar = document.getElementById('promoBar');
      if (!bar) return;
      // "YYYY-MM-DDTHH:mm" in Nigerian time (UTC+1) -> ms
      var wat = function (v) { return v ? Date.parse(v.length === 16 ? v + ':00+01:00' : v) : NaN; };
      var now = Date.now(), s = wat(bar.dataset.start), e = wat(bar.dataset.end);
      var dismissed = false;
      try { dismissed = sessionStorage.getItem(bar.dataset.key) === '1'; } catch (err) {}
      if (dismissed || (s && now < s) || (e && now > e)) return;
      document.documentElement.classList.add('has-promo');
      document.getElementById('promoClose').addEventListener('click', function () {
        document.documentElement.classList.remove('has-promo');
        try { sessionStorage.setItem(bar.dataset.key, '1'); } catch (err) {}
      });
    })();
  </script>
)}

<style is:global>
  .promo { display: none; align-items: center; justify-content: center; gap: 10px; height: 36px; padding: 0 44px; position: relative;
    background: var(--rdp); color: #fff; }
  html.has-promo .promo { display: flex; }
  html.has-promo { --header-h: 108px; }
  .promo-text { margin: 0; font: 700 13px/1.2 'Barlow Condensed', sans-serif; letter-spacing: .8px; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .promo-text a { color: #FFC72C; margin-left: 8px; text-decoration: underline; text-underline-offset: 3px; }
  .promo-x { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); width: 32px; height: 32px; border: 0; background: none; color: #fff; font-size: 22px; line-height: 1; cursor: pointer; border-radius: 50%; }
  .promo-x:hover, .promo-x:focus-visible { background: rgba(255,255,255,.15); outline: none; }
  .promo a:focus-visible { outline: 2px solid #FFC72C; outline-offset: 2px; }
  @media (max-width: 480px) { .promo-text { font-size: 12px; } .promo { padding: 0 40px 0 12px; justify-content: flex-start; } }
</style>
