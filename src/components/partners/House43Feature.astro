---
// House 43's partner page (theme: "house43"), built the same way as Ropajo's (RopajoFeature):
// a dark hero with the two logos and a "reserved table card" drawn in HTML/CSS, three
// highlights, "The Matchday Menu" (a team sheet of four dishes), "Together" (photos of
// Lobi Stars and House 43, from the partner file `gallery`, with placeholders until then)
// and a closing partner card. Class prefix h43- (Ropajo uses rj-).
import { existsSync } from 'node:fs';
import type { Partner } from '../../lib/partners';
import { website } from '../../lib/partners';

interface Props { partner: Partner }
const { partner } = Astro.props;
const p = partner.data;
const site = website(partner) ?? 'https://www.house43.org/';
const gallery = (p as any).gallery as { src: string; caption: string }[] ?? [];
// Logos: shown once the files are in public/ (a neutral word mark until then).
const has = (f: string) => existsSync(`public${f}`);
const LOGO = '/images/house43-logo.png', LOGO_CREAM = '/images/house43/logo-cream.png';
const heroLogo = has(LOGO_CREAM) ? LOGO_CREAM : has(LOGO) ? LOGO : null;
const cardLogo = has(LOGO) ? LOGO : null;

// Colour pictures (not line icons): a serving cloche, a map with two pins (Abuja and Jos), a coffee cup and a cocktail.
const highlights = [
  { t: 'Official hospitality', s: 'partner of Lobi Stars FC', icon: '<defs><linearGradient id="h43g-dome" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F3F4F6"/><stop offset="1" stop-color="#9CA3AF"/></linearGradient></defs><path d="M18 9c-1.5-2 1.5-3 0-5M24 8c-1.5-2 1.5-3 0-5M30 9c-1.5-2 1.5-3 0-5" fill="none" stroke="#E31E24" stroke-width="1.8" stroke-linecap="round"/><ellipse cx="24" cy="37.5" rx="20" ry="4" fill="#C9B488"/><path d="M7 35a17 17 0 0 1 34 0z" fill="url(#h43g-dome)" stroke="#6B7280" stroke-width="1"/><path d="M13 30a11 11 0 0 1 7-9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" opacity=".85"/><rect x="20.5" y="13" width="7" height="5.5" rx="2.75" fill="#E31E24"/>' },
  { t: 'Abuja & Jos', s: 'Maitama, Wuse and Jos', icon: '<rect x="3" y="5" width="42" height="38" rx="8" fill="#D9F0C8"/><path d="M3 33c9-4 15 3 24-1s13-5 18-3" fill="none" stroke="#3B9BE0" stroke-width="5"/><path d="M16 5v38M3 18h42" stroke="#fff" stroke-width="2.6"/><path d="M13 37s-6-5.5-6-10a6 6 0 0 1 12 0c0 4.5-6 10-6 10z" fill="#F2B705" stroke="#fff" stroke-width="1.5"/><circle cx="13" cy="27" r="2.2" fill="#fff"/><path d="M31 31s-9-8.5-9-15a9 9 0 0 1 18 0c0 6.5-9 15-9 15z" fill="#E31E24" stroke="#fff" stroke-width="1.6"/><circle cx="31" cy="16" r="3.6" fill="#fff"/>' },
  { t: 'Café · Bar · Lounge', s: 'and restaurant, open every day', icon: '<path d="M11 18c-1.5-2 1.5-3 0-5M17 18c-1.5-2 1.5-3 0-5" fill="none" stroke="#9CA3AF" stroke-width="1.8" stroke-linecap="round"/><ellipse cx="15" cy="40" rx="12" ry="2.6" fill="#C9B488"/><path d="M25 25h2a4 4 0 0 1 0 8h-2" fill="none" stroke="#8B5A2B" stroke-width="2.6"/><path d="M5 22h20v8a9 9 0 0 1-9 9h-2a9 9 0 0 1-9-9z" fill="#8B5A2B"/><ellipse cx="15" cy="22" rx="10" ry="1.8" fill="#5B3A1A"/><path d="M41 3l-3 11" stroke="#E31E24" stroke-width="1.8" stroke-linecap="round"/><path d="M29.5 12h16l-8 10z" fill="#F97316"/><path d="M28 11h19l-9.5 11.5z" fill="none" stroke="#6B7280" stroke-width="1.4" stroke-linejoin="round"/><path d="M37.5 22.5v13M33 36h9" stroke="#6B7280" stroke-width="2" stroke-linecap="round"/><circle cx="45" cy="11.5" r="3" fill="#84CC16" stroke="#fff" stroke-width="1"/>' },
];
// The Matchday Menu: four dishes from the House 43 menu, in matchday order (easy to change).
const menu = [
  { phase: 'Pre-match', dish: 'Classic Waffles & Sausages Breakfast' },
  { phase: 'First half', dish: 'Crispy Tilapia Fillet with Seafood Jollof' },
  { phase: 'Second half', dish: 'Grilled T-Bone with Signature Mash' },
  { phase: 'Extra time', dish: 'Savory Lamb & Greens Delight' },
];
// Until real photos arrive (partner file `gallery`): an illustration for each tile (public/images/house43/together/).
const placeholders = [
  { t: 'The squad at House 43', img: '/images/house43/together/squad.svg' },
  { t: 'Matchday hospitality', img: '/images/house43/together/matchday.svg' },
  { t: 'Club events & unveilings', img: '/images/house43/together/events.svg?v=2' },
  { t: 'Behind the scenes', img: '/images/house43/together/relax.svg' },
];
---
<div class="h43">
  <section class="h43-hero">
    <div class="wrap h43-hero-in">
      <div class="h43-intro">
        <!-- "A table for two": both logos in their own blue, each on a white dinner plate with a gold rim,
             a gold "&" coin between them and a fork and knife either side. -->
        <div class="h43-lockup" role="img" aria-label="Lobi Stars FC and House 43">
          <svg class="h43-cut" viewBox="0 0 20 90" aria-hidden="true"><path d="M4 2v20M10 2v20M16 2v20" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" fill="none"/><path d="M3 20q0 11 7 13q7-2 7-13" stroke="currentColor" stroke-width="2.4" fill="none"/><rect x="8" y="32" width="4" height="56" rx="2" fill="currentColor"/></svg>
          <span class="h43-plate"><img src="/images/house43/lobi-badge-plate.png" alt="" width="216" height="210" /></span>
          <span class="h43-amp" aria-hidden="true">&amp;</span>
          <span class="h43-plate"><img class="h43-plate-h43" src={cardLogo ?? heroLogo ?? LOGO} alt="" width="733" height="800" /></span>
          <svg class="h43-cut" viewBox="0 0 20 90" aria-hidden="true"><path d="M7 2c7 6 9 22 4 35H7z" fill="currentColor"/><rect x="6" y="38" width="7" height="50" rx="3.5" fill="currentColor"/></svg>
        </div>
        <p class="h43-names">Lobi Stars FC &amp; House 43</p>
        <h1 class="h43-h1">{p.name}</h1>
        <p class="h43-title">{p.officialTitle}</p>
        <p class="h43-desc">Lobi Stars FC’s hospitality home in Abuja and Jos. House 43 is proud to be the Official Hospitality Partner of the Pride of Benue, welcoming the club, its guests and supporters beyond Makurdi.</p>
        <div class="h43-btns">
          <a class="h43-btn" href={site} target="_blank" rel="sponsored noopener">Visit House 43<span class="sr-only"> (opens in a new tab)</span></a>
          <a class="h43-btn h43-btn--ghost" href="#h43-together">See us together</a>
        </div>
      </div>
      <!-- The reserved table card (HTML and CSS only). -->
      <div class="h43-cardwrap">
        <div class="h43-card-back" aria-hidden="true"></div>
        <div class="h43-card" role="img" aria-label="Reserved table card reading Table 43, Lobi Stars FC, Matchday">
          <div class="h43-card-top" aria-hidden="true"><span>No. 43</span><span class="h43-dots"><svg class="h43-star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17.3 5.8 20.9l1.6-7L2 9.2l7.1-.6z"/></svg><svg class="h43-star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17.3 5.8 20.9l1.6-7L2 9.2l7.1-.6z"/></svg><svg class="h43-star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17.3 5.8 20.9l1.6-7L2 9.2l7.1-.6z"/></svg></span><span>Matchday</span></div>
          <div class="h43-card-body" aria-hidden="true">
            <span class="h43-res">Reserved</span>
            <span class="h43-for">for the</span>
            <span class="h43-pob">Pride of Benue</span>
            <div class="h43-big"><svg class="h43-star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17.3 5.8 20.9l1.6-7L2 9.2l7.1-.6z"/></svg><b>43</b><svg class="h43-star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17.3 5.8 20.9l1.6-7L2 9.2l7.1-.6z"/></svg></div>
          </div>
          <div class="h43-card-foot" aria-hidden="true">Lobi Stars FC · Table for the squad</div>
        </div>
      </div>
    </div>
  </section>

  <section class="h43-high" aria-label="The partnership at a glance">
    <ul class="wrap h43-high-in">
      {highlights.map((h, i) => (
        <li class={`h43-hc h43-hc--${i}`}>
          <span class="h43-ic" aria-hidden="true"><svg viewBox="0 0 48 48" width="46" height="46" set:html={h.icon} /></span>
          <span><b>{h.t}</b><small>{h.s}</small></span>
        </li>
      ))}
    </ul>
  </section>

  <section class="h43-menu" aria-labelledby="h43-menu-h">
    <div class="wrap h43-menu-in">
      <div class="h43-menu-text">
        <h2 class="h43-h2" id="h43-menu-h"><span class="h43-h2-main">The Perfect Line-Up.</span> <span class="h43-h2-sub">Four Plates, One Winning Menu</span></h2>
        <p class="h43-lede">Four signature plates from the House 43 menu, served the way a matchday unfolds, from the pre-match breakfast to extra time.</p>
      </div>
      <div class="h43-sheet">
        <ol class="h43-sheet-list">
          {menu.map((m, i) => (
            <li><span class="h43-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="h43-sheet-t"><small>{m.phase}</small><em>{m.dish}</em></span></li>
          ))}
        </ol>
        <p class="h43-foot">From the House 43 menu. Dishes vary by branch.</p>
      </div>
    </div>
  </section>

  <section class="h43-together" id="h43-together" aria-labelledby="h43-t-h">
    <div class="wrap">
      <div class="h43-t-head">
        <p class="h43-eyebrow h43-eyebrow--dark">Together</p>
        <h2 class="h43-h2" id="h43-t-h">Lobi Stars <span>&amp;</span> House 43</h2>
        <p class="h43-sub">Moments from our partnership.</p>
      </div>
      {gallery.length > 0 ? (
        <ul class="h43-gal">
          {gallery.map(g => (
            <li><figure><img src={g.src} alt={g.caption || 'Lobi Stars FC and House 43'} loading="lazy" decoding="async" />{g.caption && <figcaption>{g.caption}</figcaption>}</figure></li>
          ))}
        </ul>
      ) : (
        <ul class="h43-gal">
          {placeholders.map(c => (
            <li><div class="h43-soon"><img src={c.img} alt="" width="400" height="500" loading="lazy" decoding="async" /><span class="h43-soon-chip">Photos coming soon</span><span class="h43-soon-t">{c.t}</span></div></li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="h43-about">
    <div class="wrap">
      <div class="h43-info">
        {cardLogo
          ? <img class="h43-info-logo" src={cardLogo} alt="House 43 – Official Hospitality Partner of Lobi Stars FC" width="733" height="800" loading="lazy" />
          : <span class="h43-info-mark" role="img" aria-label="House 43">HOUSE<b>43</b></span>}
        <p>A café, bar, lounge and restaurant in Maitama and Wuse, Abuja, and in Jos, serving from breakfast to dinner every day.</p>
        <a class="h43-link" href={site} target="_blank" rel="sponsored noopener">house43.org<span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></a>
      </div>
    </div>
  </section>
</div>

<style>
  @font-face { font-family: 'Playfair Display'; font-style: italic; font-weight: 500; font-display: swap; src: url('/fonts/playfair-display-italic-500.woff2') format('woff2'); }
  .h43 {
    --red: #E31E24; --red-2: #B3151A; --red-lt: #FF6B6F; --ink: #121212; --ink-2: #141414; --cream: #F6EFE0; --cream-2: #E8D9B5;
    --gold: #C9B488; --brown: #6B5A3A; --muted: #4A4F57;
    --serif: 'Playfair Display', Georgia, 'Times New Roman', serif;
    background: #fff; color: var(--ink);
  }
  .h43-eyebrow { margin: 0 0 8px; font: 700 13px/1.4 'Barlow Condensed', sans-serif; letter-spacing: .28em; text-transform: uppercase; color: var(--red-lt); }
  .h43-eyebrow--dark { color: var(--red-2); }

  /* Hero */
  .h43-hero { position: relative; overflow: hidden; background: radial-gradient(60% 70% at 90% 20%, rgba(227, 30, 36, .16), transparent 65%), var(--ink); color: #fff; border-top: 6px solid var(--red); }
  .h43-hero-in { display: grid; grid-template-columns: 1fr minmax(280px, 420px); gap: 64px; align-items: center; padding-top: 56px; padding-bottom: 64px; }
  .h43-lockup { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
  .h43-plate { position: relative; flex: none; display: grid; place-items: center; width: 104px; height: 104px; border-radius: 50%;
    background: radial-gradient(circle, #fff 0 70%, #FBF8F1 100%);
    box-shadow: 0 0 0 3px var(--gold), 0 0 0 7px rgba(201, 180, 136, .18), 0 16px 26px -12px rgba(0, 0, 0, .85); }
  .h43-plate img { width: 80%; height: 80%; object-fit: contain; }
  .h43-plate .h43-plate-h43 { width: 80%; height: 80%; }
  .h43-amp { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #F6EFE0, var(--gold) 70%);
    color: var(--ink); font: italic 500 26px/1 var(--serif); box-shadow: 0 6px 14px -6px rgba(0, 0, 0, .8); }
  .h43-cut { flex: none; width: 16px; height: 76px; color: var(--cream-2); opacity: .85; }
  .h43-lock-mark, .h43-info-mark { display: inline-flex; align-items: baseline; gap: 6px; padding: 8px 14px; border: 2px solid var(--cream-2); border-radius: 10px; color: var(--cream-2); font: 400 26px/1 'Bebas Neue', sans-serif; letter-spacing: 3px; }
  .h43-lock-mark b, .h43-info-mark b { color: var(--red-lt); font-weight: 400; }
  .h43-names { margin: 0 0 18px; font: 700 15px/1.3 'Barlow Condensed', sans-serif; letter-spacing: .08em; text-transform: uppercase; color: var(--cream-2); }
  .h43-h1 { margin: 0; font: 400 clamp(64px, 9vw, 120px)/.9 'Bebas Neue', sans-serif; letter-spacing: 2px; text-transform: uppercase; color: #fff; }
  .h43-title { margin: 8px 0 0; font: italic 500 clamp(24px, 2.6vw, 32px)/1.2 var(--serif); color: var(--cream-2); }
  .h43-desc { margin: 18px 0 28px; max-width: 540px; font-size: 18px; line-height: 1.6; color: #D9D9D9; }
  .h43-btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .h43-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 28px; border-radius: 10px; background: var(--red); border: 2px solid var(--red); color: #fff;
    font: 700 16px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; text-decoration: none; transition: background .2s, color .2s, border-color .2s; }
  .h43-btn:hover, .h43-btn:focus-visible { background: var(--red-2); border-color: var(--red-2); }
  .h43-btn--ghost { background: transparent; border-color: #fff; color: #fff; }
  .h43-btn--ghost:hover, .h43-btn--ghost:focus-visible { background: #fff; border-color: #fff; color: var(--ink); }
  .h43 a:focus-visible { outline: 3px solid var(--cream-2); outline-offset: 3px; }

  /* The reserved table card */
  .h43-cardwrap { position: relative; justify-self: center; width: min(100%, 380px); padding: 18px 10px; }
  /* The card in Lobi Stars colours: red, royal blue and gold, with ticket notches and three stars. */
  .h43-card-back { position: absolute; inset: 18px 10px; border-radius: 18px; background: linear-gradient(150deg, #2B5EB8, #0E2A55); border: 2px solid #F2B705; transform: rotate(-5deg); box-shadow: 0 24px 40px -20px rgba(0, 0, 0, .8); }
  .h43-card { position: relative; overflow: hidden; border-radius: 18px; color: var(--ink); text-align: center; transform: rotate(2deg); transition: transform .5s ease;
    background: repeating-linear-gradient(135deg, rgba(201, 180, 136, .12) 0 10px, transparent 10px 22px), linear-gradient(160deg, #FFFDF8 0%, #FBF6EC 55%, #F3EBDA 100%);
    box-shadow: 0 0 0 3px #F2B705, 0 30px 50px -22px rgba(0, 0, 0, .8); }
  .h43-cardwrap:hover .h43-card { transform: rotate(0deg) translateY(-4px); }
  .h43-card-top { display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; background: #1E4FA3; font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: .3em; text-transform: uppercase; color: #fff; }
  .h43-dots { display: inline-flex; gap: 4px; }
  .h43-dots .h43-star { width: 13px; height: 13px; }
  .h43-star { fill: #F2B705; flex: none; }
  .h43-card-body { position: relative; display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 18px 22px 12px; }
  .h43-card-body::before, .h43-card-body::after { content: ''; position: absolute; top: 46%; width: 24px; height: 24px; border-radius: 50%; background: var(--ink); }
  .h43-card-body::before { left: -12px; } .h43-card-body::after { right: -12px; }
  .h43-res { padding: 5px 12px; border-radius: 999px; background: #E31E24; font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: .4em; text-transform: uppercase; color: #fff; }
  .h43-for { margin-top: 4px; font: italic 500 21px/1.2 var(--serif); color: #B3151A; }
  .h43-pob { font: 400 38px/1 'Bebas Neue', sans-serif; letter-spacing: 2px; text-transform: uppercase; color: #0E2A55; }
  .h43-big { display: flex; align-items: center; justify-content: center; gap: 16px; margin: 10px 0 4px; }
  .h43-big .h43-star { width: 30px; height: 30px; filter: drop-shadow(0 2px 0 #0E2A55); }
  .h43-big b { font: 400 112px/.85 'Bebas Neue', sans-serif; color: #E31E24; text-shadow: 4px 4px 0 #1E4FA3, 8px 8px 0 rgba(14, 42, 85, .25); }
  .h43-card-foot { padding: 11px 14px; background: #0E2A55; font: 700 11px/1.3 'Barlow Condensed', sans-serif; letter-spacing: .22em; text-transform: uppercase; color: #F2B705; }

  /* Highlights */
  .h43-high { background: #fff; border-bottom: 1px solid #E6E1D6; }
  .h43-high-in { list-style: none; margin-top: 0; margin-bottom: 0; padding-top: 28px; padding-bottom: 28px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .h43-hc { display: flex; align-items: center; gap: 16px; padding: 20px; border-radius: 18px; box-shadow: 0 14px 28px -18px rgba(0, 0, 0, .45); }
  .h43-hc--0 { background: linear-gradient(135deg, #E31E24, #B3151A); color: #fff; }
  .h43-hc--1 { background: linear-gradient(135deg, #2A2A2A, #121212); color: #fff; }
  .h43-hc--2 { background: var(--cream); color: var(--ink); border: 1px solid var(--gold); }
  .h43-ic { flex: none; display: grid; place-items: center; width: 64px; height: 64px; border-radius: 18px; background: #fff; color: var(--red-2); box-shadow: 0 6px 14px -6px rgba(0, 0, 0, .35); }
  .h43-hc--1 .h43-ic { color: var(--ink); background: none; box-shadow: none; border-radius: 0; }
  .h43-hc--1 .h43-ic svg { width: 64px; height: 64px; }
  .h43-hc b { display: block; font: 400 26px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .h43-hc small { display: block; margin-top: 3px; font-size: 15px; }
  .h43-hc--2 small { color: var(--brown); }

  /* The Matchday Menu */
  .h43-menu { background: var(--cream); padding: 64px 0; }
  .h43-menu-in { display: grid; grid-template-columns: 1fr minmax(320px, 520px); gap: 56px; align-items: center; }
  .h43-h2 { margin: 0; font: 400 clamp(40px, 5.4vw, 64px)/.95 'Bebas Neue', sans-serif; letter-spacing: 1px; color: var(--ink); }
  .h43-h2 span { color: var(--red); }
  /* Two lines on every screen: "The Perfect Line-Up." then "Four Plates, One Winning Menu" in red. */
  .h43-menu .h43-h2 { font-size: clamp(36px, 4.6vw, 62px); }
  .h43-h2 .h43-h2-main { color: inherit; white-space: nowrap; }
  .h43-h2-sub { display: block; margin-top: 6px; white-space: nowrap; font-size: .66em; letter-spacing: .5px; }
  .h43-lede { margin: 14px 0 0; max-width: 480px; font-size: 18px; line-height: 1.65; color: var(--muted); }
  .h43-sheet { background: #fff; border: 2px solid var(--ink); border-radius: 6px; padding: 8px 24px 16px; box-shadow: 8px 8px 0 var(--ink); }
  .h43-sheet-list { list-style: none; margin: 0; padding: 0; }
  .h43-sheet-list li { display: flex; align-items: center; gap: 18px; padding: 16px 0; border-bottom: 2px dashed var(--gold); }
  .h43-no { flex: none; width: 58px; font: 400 52px/1 'Bebas Neue', sans-serif; color: var(--red); }
  .h43-sheet-t small { display: block; font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: .24em; text-transform: uppercase; color: var(--red-2); }
  .h43-sheet-t em { display: block; margin-top: 6px; font: italic 500 20px/1.3 var(--serif); color: var(--ink); }
  .h43-foot { margin: 12px 0 0; font-size: 13px; color: var(--muted); }

  /* Together */
  .h43-together { padding: 64px 0 70px; background: #fff; }
  .h43-t-head { text-align: center; margin-bottom: 28px; }
  .h43-sub { margin: 8px 0 0; color: var(--muted); font-size: 17px; }
  .h43-gal { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .h43-gal li { aspect-ratio: 4 / 5; min-width: 0; }
  .h43-gal figure { position: relative; margin: 0; height: 100%; border-radius: 16px; overflow: hidden; background: var(--ink-2); }
  .h43-gal img { width: 100%; height: 100%; object-fit: cover; display: block; }
