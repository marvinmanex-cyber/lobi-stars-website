---
// Ropajo Hotels' partner page (theme: "ropajo"). The same layout as every partner page
// (who the partner is, the partnership with Lobi Stars FC, a link to their website),
// dressed in a touch of Ropajo's brand: espresso brown and cream, a burgundy accent and
// their Abhaya Libre serif for headings, alongside the club's own fonts and badge.
// The partnership text is the partner file's body (src/content/partners/ropajo.md).
import type { Partner } from '../../lib/partners';
import { website } from '../../lib/partners';

interface Props { partner: Partner }
const { partner } = Astro.props;
const p = partner.data;
const site = website(partner) ?? 'https://ropajo.com/';
const pillars = [
  { title: 'Official Hotel Partner', text: 'Ropajo Hotels is the official hotel of Lobi Stars FC, the Pride of Benue.',
    icon: '<path d="M3 21V8l9-5 9 5v13"/><path d="M9 21v-6h6v6M8 10h.01M12 10h.01M16 10h.01"/>' },
  { title: 'Rooted in Lobi Quarters', text: 'Two Makurdi names, one home: Ropajo sits in Lobi Quarters, Makurdi.',
    icon: '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>' },
  { title: 'A base for visiting fans', text: 'Coming to Makurdi for a home match? Ropajo is the club’s recommended place to stay.',
    icon: '<path d="M4 20v-8a8 8 0 0 1 16 0v8"/><path d="M4 16h16M9 20v-4M15 20v-4"/>' },
];
---
<div class="rj">
  <section class="rj-top">
    <div class="wrap rj-top-in">
      <div class="rj-pair" aria-label="Lobi Stars FC and Ropajo Hotels">
        <img class="rj-badge" src="/images/lobi-stars-badge.png" alt="Lobi Stars FC badge" width="120" height="120" />
        <span class="rj-x" aria-hidden="true">&times;</span>
        <img class="rj-logo" src="/images/ropajo/logo-cream.png" alt="Ropajo Hotels logo" width="1074" height="828" />
      </div>
      <div class="rj-intro">
        <p class="rj-caps">{p.tier}</p>
        <h1 class="rj-h1">{p.name}</h1>
        <p class="rj-official">{p.officialTitle}</p>
        {p.shortDescription && <p class="rj-desc">{p.shortDescription}</p>}
        <a class="rj-btn" href={site} target="_blank" rel="sponsored noopener">Visit Ropajo Hotels<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
    </div>
  </section>

  <section class="rj-part" aria-labelledby="rj-part-h">
    <div class="wrap">
      <p class="rj-caps rj-caps--wine">Lobi Stars FC &times; Ropajo Hotels</p>
      <h2 class="rj-h2" id="rj-part-h">The partnership</h2>
      <div class="rj-body"><slot /></div>
      <ul class="rj-pillars">
        {pillars.map(x => (
          <li>
            <span class="rj-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={x.icon} /></span>
            <h3>{x.title}</h3>
            <p>{x.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="rj-about" aria-labelledby="rj-about-h">
    <div class="wrap rj-about-in">
      <div class="rj-about-text">
        <p class="rj-caps">About our partner</p>
        <h2 class="rj-h2 rj-h2--light" id="rj-about-h">Ropajo Hotels &amp; Apartments</h2>
        <p>Rooms and apartments, a pool, a restaurant serving local and intercontinental dishes, and a coffee space, at 9 Gondo Aluor Road, Lobi Quarters, Makurdi.</p>
        <a class="rj-btn rj-btn--cream" href={site} target="_blank" rel="sponsored noopener">Go to ropajo.com<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
      <div class="rj-photos">
        <img src="/images/ropajo/apartment.webp" alt="The living room of a Ropajo apartment" width="900" height="1200" loading="lazy" decoding="async" />
        <img src="/images/ropajo/pool.webp" alt="The pool at Ropajo Hotels" width="1200" height="957" loading="lazy" decoding="async" />
        <img src="/images/ropajo/restaurant.webp" alt="The Ropajo Hotels restaurant" width="900" height="1200" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>
</div>

<style>
  @font-face { font-family: 'Abhaya Libre'; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/abhaya-libre-500.woff2') format('woff2'); }
  @font-face { font-family: 'Abhaya Libre'; font-style: normal; font-weight: 600; font-display: swap; src: url('/fonts/abhaya-libre-600.woff2') format('woff2'); }
  .rj { --rj-espresso: #1F1515; --rj-espresso-2: #2B1E1C; --rj-cream: #FDF0D5; --rj-cream-2: #F3E2BF; --rj-wine: #7D041A; --rj-serif: 'Abhaya Libre', Georgia, serif; }
  .rj-caps { margin: 0 0 10px; font: 700 13px/1.4 'Barlow Condensed', sans-serif; letter-spacing: .3em; text-transform: uppercase; color: var(--rj-cream-2); }
  .rj-caps--wine { color: var(--rj-wine); }
  .rj-h2 { margin: 0 0 18px; font: 600 clamp(32px, 4vw, 46px)/1.08 var(--rj-serif); color: var(--rj-espresso); }
  .rj-h2--light { color: var(--rj-cream); }
  .rj-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 0 28px; border-radius: 10px; background: var(--rj-cream); color: var(--rj-espresso); border: 1.5px solid var(--rj-cream); font: 700 15px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; text-decoration: none; transition: background .2s, color .2s; }
  .rj-btn:hover, .rj-btn:focus-visible { background: transparent; color: var(--rj-cream); }
  .rj-btn--cream { background: transparent; color: var(--rj-cream); }
  .rj-btn--cream:hover, .rj-btn--cream:focus-visible { background: var(--rj-cream); color: var(--rj-espresso); }
  .rj a:focus-visible { outline: 2px solid var(--rj-cream); outline-offset: 3px; }

  /* Top: the club badge beside Ropajo's logo, then who they are (like every partner page). */
  .rj-top { background: radial-gradient(120% 140% at 0% 0%, #3A2723 0%, var(--rj-espresso) 55%); color: var(--rj-cream); border-bottom: 3px solid var(--rj-wine); }
  .rj-top-in { display: grid; grid-template-columns: minmax(260px, 420px) 1fr; gap: 48px; align-items: center; padding-top: 52px; padding-bottom: 56px; }
  .rj-pair { display: flex; align-items: center; justify-content: center; gap: 22px; padding: 30px 26px; border: 1px solid rgba(253, 240, 213, .22); border-radius: 18px; background: rgba(253, 240, 213, .04); }
  .rj-badge { width: 96px; height: auto; }
  .rj-x { font: 400 30px/1 var(--rj-serif); color: var(--rj-cream-2); opacity: .7; }
  .rj-logo { width: 150px; height: auto; }
  .rj-h1 { margin: 0; font: 600 clamp(42px, 5.4vw, 68px)/1 var(--rj-serif); color: var(--rj-cream); }
  .rj-official { margin: 10px 0 0; font: 700 22px/1.2 'Barlow Condensed', sans-serif; color: #F2B8A0; }
  .rj-desc { margin: 14px 0 26px; max-width: 600px; font-size: 17px; line-height: 1.7; color: rgba(253, 240, 213, .88); }

  /* The partnership, on cream. */
  .rj-part { background: var(--rj-cream); color: var(--rj-espresso); padding: 60px 0 64px; }
  .rj-body { max-width: 760px; font-size: 18px; line-height: 1.75; color: #3A2B28; }
  .rj-body :global(p) { margin: 0 0 1em; }
  .rj-body :global(a) { color: var(--rj-wine); text-underline-offset: 3px; }
  .rj-pillars { list-style: none; margin: 30px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .rj-pillars li { padding: 24px; border-radius: 14px; background: #fff; border: 1px solid #EAD6AE; border-top: 3px solid var(--rj-wine); box-shadow: 0 10px 24px -18px rgba(31, 21, 21, .45); }
  .rj-ic { display: grid; place-items: center; width: 46px; height: 46px; margin-bottom: 14px; border-radius: 12px; background: var(--rj-espresso); color: var(--rj-cream); }
  .rj-pillars h3 { margin: 0 0 6px; font: 600 24px/1.15 var(--rj-serif); color: var(--rj-espresso); }
  .rj-pillars p { margin: 0; font-size: 15.5px; line-height: 1.6; color: #4A3A36; }

  /* About Ropajo: a short note and three photos, with the link to their website. */
  .rj-about { background: var(--rj-espresso-2); color: var(--rj-cream); padding: 56px 0 60px; }
  .rj-about-in { display: grid; grid-template-columns: minmax(260px, 1fr) 1.5fr; gap: 40px; align-items: center; }
  .rj-about-text p:not(.rj-caps) { margin: 0 0 24px; font-size: 17px; line-height: 1.7; color: rgba(253, 240, 213, .85); }
  .rj-photos { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
  .rj-photos img { width: 100%; height: 260px; object-fit: cover; border-radius: 12px; display: block; }
  .rj-photos img:nth-child(2) { margin-top: 28px; }

  @media (max-width: 900px) { .rj-pillars { grid-template-columns: 1fr; } .rj-about-in { grid-template-columns: 1fr; } }
  @media (max-width: 760px) {
    .rj-top-in { grid-template-columns: 1fr; gap: 28px; padding-top: 32px; padding-bottom: 40px; }
    .rj-pair { gap: 16px; padding: 22px 16px; }
    .rj-badge { width: 76px; } .rj-logo { width: 120px; }
    .rj-btn { width: 100%; }
    .rj-part { padding: 44px 0 48px; } .rj-about { padding: 44px 0 48px; }
    .rj-photos img { height: 160px; } .rj-photos img:nth-child(2) { margin-top: 0; }
  }
</style>
