---
// Ropajo Hotels' partner page (theme: "ropajo"), styled to flow with ropajo.com:
// espresso brown and cream, a burgundy accent, the Abhaya Libre serif, widely spaced
// capitals, outlined buttons and large room photos. Photos are from ropajo.com.
import type { Partner } from '../../lib/partners';
import { website } from '../../lib/partners';

interface Props { partner: Partner }
const { partner } = Astro.props;
const p = partner.data;
const site = website(partner) ?? 'https://ropajo.com/';
const features = [
  { img: 'bedroom', alt: 'A Ropajo Hotels bedroom with a double bed, warm lighting and long curtains', kicker: 'Stay', title: 'Rooms & Apartments', text: 'Comfortable rooms and fully furnished apartments for a night, a weekend or a longer stay in Makurdi.' },
  { img: 'pool', alt: 'The Ropajo Hotels pool with a towel and a drink on a lounger', kicker: 'Relax', title: 'Pool & Party', text: 'Unwind by the pool after the match, or book the space for a celebration.' },
  { img: 'restaurant', alt: 'Staff setting the tables in the Ropajo Hotels restaurant', kicker: 'Dine', title: 'Restaurant', text: 'A relaxed restaurant with friendly service, from morning coffee to dinner.' },
  { img: 'dish', alt: 'A plate of pasta with vegetables and a boiled egg, served at Ropajo Hotels', kicker: 'Taste', title: 'Local and Intercontinental dishes', text: 'Nigerian favourites and international plates, prepared fresh in the Ropajo kitchen.' },
];
const phones = ['+2347040014800', '+2348157711115'];
const showPhone = (n: string) => n.replace(/^\+234(\d{3})(\d{3})(\d{4})$/, '0$1 $2 $3');
const address = '9 Gondo Aluor Road, Lobi Quarters, Makurdi, Benue';
---
<div class="rj">
  <section class="rj-hero">
    <div class="rj-brand">
      <a class="rj-back" href="/partners/">&larr; All partners</a>
      <img class="rj-logo" src="/images/ropajo/logo-cream.png" alt="Ropajo Hotels logo" width="1074" height="828" />
      <p class="rj-caps">Hotel and Apartment</p>
      <span class="rj-rule" aria-hidden="true"></span>
      <h1 class="rj-h1">{p.name}</h1>
      <p class="rj-official">{p.officialTitle} of Lobi Stars FC</p>
    </div>
    <div class="rj-photo">
      <img src="/images/ropajo/apartment.webp" alt="The living room of a Ropajo apartment, with a grey sofa, coloured cushions and a fitted kitchen" width="900" height="1200" fetchpriority="high" />
    </div>
  </section>

  <section class="rj-intro">
    <p class="rj-caps rj-caps--dark">High class luxury</p>
    <h2 class="rj-h2">In the heart of the Food Basket of Nigeria</h2>
    <div class="rj-text"><slot /></div>
    <div class="rj-btns">
      <a class="rj-btn rj-btn--solid" href={site} target="_blank" rel="sponsored noopener">Book your stay<span class="sr-only"> on ropajo.com (opens in a new tab)</span></a>
      <a class="rj-btn" href={site} target="_blank" rel="sponsored noopener">Visit ropajo.com<span class="sr-only"> (opens in a new tab)</span></a>
    </div>
  </section>

  <section class="rj-features" aria-label="At Ropajo Hotels">
    {features.map((f, i) => (
      <article class:list={['rj-feat', { 'rj-feat--flip': i % 2 === 1 }]}>
        <div class="rj-feat-img"><img src={`/images/ropajo/${f.img}.webp`} alt={f.alt} loading="lazy" decoding="async" /></div>
        <div class="rj-feat-text">
          <p class="rj-caps">{f.kicker}</p>
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </div>
      </article>
    ))}
  </section>

  <section class="rj-visit">
    <div class="rj-visit-in">
      <div>
        <p class="rj-caps">Location</p>
        <p class="rj-addr">{address}</p>
        <a class="rj-link" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('Ropajo Hotels, ' + address)}`} target="_blank" rel="noopener">View on Google Maps<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
      <div>
        <p class="rj-caps">Bookings and enquiries</p>
        {phones.map(n => <a class="rj-contact" href={`tel:${n}`}>{showPhone(n)}</a>)}
        <a class="rj-contact" href="mailto:ropajohotels2@gmail.com">ropajohotels2@gmail.com</a>
      </div>
      <div class="rj-fans">
        <p class="rj-caps">For Lobi Stars fans</p>
        <p>Coming to Makurdi for a home match? Make Ropajo your base for the weekend.</p>
        <a class="rj-btn rj-btn--cream" href={site} target="_blank" rel="sponsored noopener">Book now<span class="sr-only"> on ropajo.com (opens in a new tab)</span></a>
      </div>
    </div>
  </section>
</div>

<style>
  @font-face { font-family: 'Abhaya Libre'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/abhaya-libre-400.woff2') format('woff2'); }
  @font-face { font-family: 'Abhaya Libre'; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/abhaya-libre-500.woff2') format('woff2'); }
  @font-face { font-family: 'Abhaya Libre'; font-style: normal; font-weight: 600; font-display: swap; src: url('/fonts/abhaya-libre-600.woff2') format('woff2'); }
  .rj {
    --rj-espresso: #1F1515; --rj-espresso-2: #2B1E1C; --rj-cream: #FDF0D5; --rj-cream-2: #F6E3BD; --rj-wine: #7D041A;
    --rj-serif: 'Abhaya Libre', Georgia, 'Times New Roman', serif;
    font-family: var(--rj-serif); color: var(--rj-espresso); background: var(--rj-cream);
  }
  .rj img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .rj-caps { margin: 0; font: 500 13px/1.4 var(--rj-serif); letter-spacing: .32em; text-transform: uppercase; color: var(--rj-cream); opacity: .85; }
  .rj-caps--dark { color: var(--rj-wine); opacity: 1; }

  /* Hero: espresso panel with the logo beside a large room photo, as on ropajo.com. */
  .rj-hero { display: grid; grid-template-columns: 1fr 1fr; min-height: min(78vh, 680px); background: var(--rj-espresso); }
  .rj-brand { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 72px 28px 56px; color: var(--rj-cream); }
  .rj-back { position: absolute; top: 22px; left: 28px; color: var(--rj-cream); opacity: .8; font: 400 17px/1 var(--rj-serif); text-decoration: none; }
  .rj-back:hover, .rj-back:focus-visible { opacity: 1; text-decoration: underline; text-underline-offset: 4px; }
  .rj-logo { width: min(260px, 60%) !important; height: auto !important; margin-bottom: 18px; }
  .rj-rule { width: 56px; height: 1px; margin: 22px 0 18px; background: var(--rj-cream); opacity: .45; }
  .rj-h1 { margin: 0; font: 500 clamp(38px, 5vw, 64px)/1 var(--rj-serif); color: var(--rj-cream); letter-spacing: .01em; }
  .rj-official { margin: 12px 0 0; font: 400 20px/1.3 var(--rj-serif); font-style: italic; color: var(--rj-cream-2); }
  .rj-photo { position: relative; min-height: 360px; }
  .rj-photo img { position: absolute; inset: 0; }

  /* Intro on cream. */
  .rj-intro { max-width: 760px; margin: 0 auto; padding: 72px 24px 64px; text-align: center; }
  .rj-h2 { margin: 12px 0 22px; font: 500 clamp(32px, 4.2vw, 52px)/1.08 var(--rj-serif); color: var(--rj-espresso); }
  .rj-text { font-size: 20px; line-height: 1.65; color: #3A2B28; }
  .rj-text :global(p) { margin: 0 0 1em; }
  .rj-text :global(a) { color: var(--rj-wine); text-underline-offset: 3px; }
  .rj-btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 30px; }
  .rj-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 30px; border: 1.5px solid var(--rj-espresso); border-radius: 10px; color: var(--rj-espresso); font: 500 19px/1 var(--rj-serif); text-decoration: none; transition: background .2s, color .2s; }
  .rj-btn:hover, .rj-btn:focus-visible { background: var(--rj-espresso); color: var(--rj-cream); }
  .rj-btn--solid { background: var(--rj-espresso); color: var(--rj-cream); }
  .rj-btn--solid:hover, .rj-btn--solid:focus-visible { background: var(--rj-wine); border-color: var(--rj-wine); }
  .rj-btn--cream { border-color: var(--rj-cream); color: var(--rj-cream); }
  .rj-btn--cream:hover, .rj-btn--cream:focus-visible { background: var(--rj-cream); color: var(--rj-espresso); }
  .rj :focus-visible { outline: 2px solid var(--rj-wine); outline-offset: 3px; }

  /* Photo and text, alternating sides; espresso and cream panels in turn. */
  .rj-feat { display: grid; grid-template-columns: 1fr 1fr; height: clamp(400px, 38vw, 540px); }
  .rj-feat-img { position: relative; min-height: 0; overflow: hidden; }
  .rj-feat-img img { position: absolute; inset: 0; }
  .rj-feat-img img { transition: transform .8s ease; }
  .rj-feat:hover .rj-feat-img img { transform: scale(1.04); }
  .rj-feat-text { display: flex; flex-direction: column; justify-content: center; padding: 56px clamp(28px, 6vw, 88px); background: var(--rj-espresso); color: var(--rj-cream); }
  .rj-feat-text h3 { margin: 10px 0 14px; font: 500 clamp(32px, 4vw, 54px)/1.05 var(--rj-serif); color: var(--rj-cream); }
  .rj-feat-text p:last-child { margin: 0; max-width: 440px; font-size: 19px; line-height: 1.6; color: var(--rj-cream-2); }
  .rj-feat--flip .rj-feat-img { order: 2; }
  .rj-feat--flip .rj-feat-text { background: var(--rj-cream); color: var(--rj-espresso); }
  .rj-feat--flip .rj-feat-text h3 { color: var(--rj-espresso); }
  .rj-feat--flip .rj-feat-text p:last-child { color: #3A2B28; }
  .rj-feat--flip .rj-caps { color: var(--rj-wine); opacity: 1; }

  /* Location and contacts. */
  .rj-visit { background: var(--rj-espresso-2); border-top: 3px solid var(--rj-wine); color: var(--rj-cream); }
  .rj-visit-in { max-width: 1160px; margin: 0 auto; padding: 56px 24px 64px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 36px; }
  .rj-visit .rj-caps { margin-bottom: 12px; }
  .rj-addr { margin: 0 0 10px; font-size: 21px; line-height: 1.45; }
  .rj-link, .rj-contact { display: block; width: fit-content; color: var(--rj-cream); font-size: 20px; line-height: 1.9; text-decoration: underline; text-decoration-color: rgba(253, 240, 213, .35); text-underline-offset: 4px; }
  .rj-link:hover, .rj-contact:hover { text-decoration-color: var(--rj-cream); }
  .rj-fans p:not(.rj-caps) { margin: 0 0 18px; font-size: 20px; line-height: 1.5; color: var(--rj-cream-2); }
  .rj-visit :focus-visible { outline-color: var(--rj-cream); }

  @media (max-width: 860px) { .rj-visit-in { grid-template-columns: 1fr 1fr; } .rj-fans { grid-column: 1 / -1; } }
  @media (max-width: 760px) {
    .rj-hero, .rj-feat { grid-template-columns: 1fr; min-height: 0; height: auto; }
    .rj-brand { padding: 64px 20px 44px; }
    .rj-back { left: 16px; top: 18px; }
    .rj-photo { min-height: 0; aspect-ratio: 4 / 3; }
    .rj-feat-img, .rj-feat--flip .rj-feat-img { order: 0; aspect-ratio: 4 / 3; }
    .rj-feat-text { padding: 36px 20px 40px; }
    .rj-intro { padding: 52px 16px 48px; }
    .rj-text { font-size: 18px; }
    .rj-btn { width: 100%; }
    .rj-visit-in { grid-template-columns: 1fr; gap: 28px; padding: 44px 16px 48px; }
  }
  @media (prefers-reduced-motion: reduce) { .rj-feat-img img { transition: none; } .rj-feat:hover .rj-feat-img img { transform: none; } }
</style>
