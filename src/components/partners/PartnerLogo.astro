---
// A partner logo in a fixed-size white rounded card. Logos always show in
// full colour and are never stretched or cropped (object-fit: contain).
// Falls back to the partner's name as text if the logo file is missing.
// Shows "18+ | Drink Responsibly" for age-restricted partners.
//
// Card sizes by tier (desktop / mobile):
//   principal 260x130 / 200x100   kit   220x110 / 170x85
//   club      180x90  / 140x70    small 150x75  / 120x60   tiny 110x55 / 96x48
import { logoSrc, logoAlt, website, type Partner } from '../../lib/partners';

interface Props {
  partner: Partner;
  size?: 'principal' | 'kit' | 'club' | 'small' | 'tiny';
  /** Link to the partner's detail page ('page'), their website ('site') or nothing. */
  link?: 'page' | 'site' | 'none';
  label?: string;
}
const { partner, size = 'club', link = 'page', label } = Astro.props;
const src = logoSrc(partner);
const site = website(partner);
const href = link === 'page' ? `/partners/${partner.id}/` : link === 'site' ? site : null;
const external = link === 'site' && !!site;
const Tag = href ? 'a' : 'div';
const card = partner.data.cardColor ? `background:${partner.data.cardColor};border-color:${partner.data.cardColor};` : undefined;
---
<div class:list={['pl', `pl--${size}`]}>
  <Tag
    class="pl-box"
    style={card}
    href={href ?? undefined}
    data-track={href ? 'partner_click' : undefined}
    data-track-label={href ? partner.id : undefined}
    target={external ? '_blank' : undefined}
    rel={external ? 'sponsored noopener' : undefined}
    aria-label={href && !src ? logoAlt(partner) : undefined}
  >
    {src
      ? <img src={src} alt={logoAlt(partner)} loading="lazy" decoding="async" />
      : <span class="pl-name">{partner.data.name}</span>}
  </Tag>
  {label && <span class="pl-label">{label}</span>}
  {partner.data.ageRestricted && <span class="pl-age">18+ | Drink Responsibly</span>}
</div>

<style>
  .pl { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; flex: 0 0 auto; }
  .pl-box {
    display: flex; align-items: center; justify-content: center; box-sizing: border-box;
    background: #fff; border: 1px solid var(--d4); border-radius: 12px; padding: 12px;
    box-shadow: 0 2px 8px rgba(15, 17, 21, .05); text-decoration: none;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  a.pl-box:hover, a.pl-box:focus-visible { transform: translateY(-3px); box-shadow: 0 10px 22px rgba(15, 17, 21, .12); }
  a.pl-box:focus-visible { outline: 3px solid var(--red); outline-offset: 2px; }
  .pl-box img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .pl-name { font: 400 18px/1.05 'Bebas Neue', sans-serif; letter-spacing: 1px; color: var(--white); overflow-wrap: anywhere; }

  .pl--principal .pl-box { width: 260px; height: 130px; padding: 14px; }
  .pl--principal .pl-name { font-size: 34px; }
  .pl--kit .pl-box { width: 220px; height: 110px; padding: 14px; }
  .pl--kit .pl-name { font-size: 28px; }
  .pl--club .pl-box { width: 180px; height: 90px; }
  .pl--club .pl-name { font-size: 20px; }
  .pl--small .pl-box { width: 150px; height: 75px; padding: 10px; }
  .pl--small .pl-name { font-size: 15px; }
  .pl--tiny .pl-box { width: 110px; height: 55px; padding: 6px 8px; border-radius: 10px; }
  .pl--tiny .pl-name { font-size: 12px; }

  .pl-label { max-width: 220px; font: 700 12px/1.25 'Barlow Condensed', sans-serif; letter-spacing: 1.2px; text-transform: uppercase; color: var(--lt); }
  .pl-age { font: 700 11px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; color: var(--lt); }

  @media (max-width: 600px) {
    .pl--principal .pl-box { width: 200px; height: 100px; }
    .pl--principal .pl-name { font-size: 28px; }
    .pl--kit .pl-box { width: 170px; height: 85px; padding: 10px; }
    .pl--kit .pl-name { font-size: 22px; }
    .pl--club .pl-box { width: 140px; height: 70px; padding: 10px; }
    .pl--club .pl-name { font-size: 16px; }
    .pl--small .pl-box { width: 120px; height: 60px; padding: 8px; }
    .pl--small .pl-name { font-size: 13px; }
    .pl--tiny .pl-box { width: 96px; height: 48px; }
    .pl-label { max-width: 160px; font-size: 11px; }
  }
</style>
