---
// EN | Pidgin | Hausa | Tiv -- only languages that are fully translated and
// reviewed by a native speaker are listed; with English alone it is hidden.
import { SWITCHER } from '../lib/i18n';
---
{SWITCHER.length > 1 && (
  <div class="ls" aria-label="Language">
    {SWITCHER.map((l, i) => (
      <>{i > 0 && <span aria-hidden="true">|</span>}<a href={`?lang=${l.code}`} data-lang={l.code} lang={l.code === 'pcm' ? 'pcm-NG' : l.code}>{l.code === 'en' ? 'EN' : l.nativeName}</a></>
    ))}
  </div>
)}
<script is:inline>
(function () {
  var cur = 'en'; try { cur = localStorage.getItem('ls_lang') || 'en'; } catch (e) {}
  document.querySelectorAll('.ls [data-lang]').forEach(function (a) { if (a.dataset.lang === cur) a.setAttribute('aria-current', 'true'); });
})();
</script>
<style>
  .ls { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: rgba(255,255,255,.5); }
  .ls a { color: rgba(255,255,255,.8); text-decoration: none; padding: 8px 2px; }
  .ls a:hover, .ls a:focus-visible, .ls a[aria-current="true"] { color: #FFC72C; text-decoration: underline; }
</style>
