---
import { FOOTER_TAGLINE } from '../lib/site';
import { SOCIAL_SHOWN } from '../data/social';
import { optionalClub } from '../lib/nav';
import PartnerLogo from './partners/PartnerLogo.astro';
import { getPartners } from '../lib/partners';

interface Props { whiteLabel?: boolean }
const { whiteLabel = false } = Astro.props;
// On Lobi Stars FC Live pages the broadcast partner isn't shown (the commentary is white-label).
const WHITE_LABEL_HIDDEN = ['aeson-sports-management'];
// Partners appear once per page: not in the footer on the homepage ("Our Official Partners") or the partner pages.
const partnersOnPage = /^\/(partners(\/|$)|$)/.test(Astro.url.pathname);
const partners = partnersOnPage ? [] : (await getPartners()).filter(p => !(whiteLabel && WHITE_LABEL_HIDDEN.includes(p.id)));
const principal = partners.find(p => p.data.tier === 'Principal Partner');
const others = partners.filter(p => p !== principal);

const columns = [
  { title: 'Club', links: [
    ['History', '/club/history'], ['Honours', '/club/honours'], ['Stadium', '/club/stadium'],
    ['Partners', '/partners'], ['Fan Clubs', '/club/fan-clubs'],
    // Values, Community and Transparency appear once they have content.
    ...optionalClub.map(l => [l.label, l.href]),
  ] },
  { title: 'Matches', links: [
    ['Fixtures', '/fixtures'], ['Results', '/results'], ['League Table', '/table'],
    ['Buy Tickets', '/tickets'], ['Hospitality', '/hospitality'], ['Watch Live', '/watch'], ['Match Commentary', '/commentary'], ['Man of the Match', '/man-of-the-match'], ['Predict & Win', '/predict-and-win'], ['Fan Awards', '/awards'], ['Matchday Programme', '/programme'], ['MatchDay Kitchen', '/kitchen/'],
  ] },
  { title: 'Fans', links: [
    ['News', '/news'], ['Video', '/video'], ['Squad', '/squad'], ['Gallery', '/gallery'],
    ['Club Shop', '/shop'], ['Membership', '/membership'], ['Newsletter', '/newsletter'],
  ] },
  { title: 'Help', links: [
    ['Help Centre', '/help'], ['Contact Us', '/contact'], ['Search', '/search'],
  ] },
];

// Link columns are kept the same height: a long group is split into side-by-side
// columns of at most 4 links (12 Matches links -> 3 x 4), balanced (5 -> 3 + 2).
const MAX_ROWS = 4;
const layout = (n: number, max: number) => { const cols = Math.ceil(n / max); return Math.ceil(n / cols); };
const year = new Date().getFullYear();
---
<footer class="sf">
  <div class="sf-inner">
    <div class="sf-top">
      <div class="sf-brand">
        <a class="sf-logo" href="/">
          <img class="club-logo" style="--logo-h:56px" src="/images/lobi-stars-badge.png" alt="" width="56" height="56" loading="lazy" />
          <span>Lobi Stars<small>Football Club</small></span>
        </a>
        <p>{FOOTER_TAGLINE}</p>
        {SOCIAL_SHOWN.length > 0 && <p class="sf-follow" id="sf-follow">Follow us on social media</p>}
        {SOCIAL_SHOWN.length > 0 && (
          <ul class="sf-social" aria-labelledby="sf-follow">
            {SOCIAL_SHOWN.map(s => (
              <li>{s.live
                ? <a class={`sf-s--${s.id}`} href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`Lobi Stars on ${s.label}`} data-social={s.id}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon} fill-rule={s.evenodd ? 'evenodd' : undefined} /></svg>
                  </a>
                : <span class={`sf-s--${s.id} sf-soon`} role="img" aria-label={`Lobi Stars on ${s.label} (coming soon)`} title="Coming soon">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon} fill-rule={s.evenodd ? 'evenodd' : undefined} /></svg>
                  </span>}</li>
            ))}
          </ul>
        )}
      </div>

      <form class="sf-news" id="newsletterForm" novalidate>
        <h2 class="sf-news-title">Club Newsletter</h2>
        <p>Get the free Lobi Stars Weekly: club news, ticket releases and matchday updates by email. <a class="sf-news-more" href="/newsletter/">Newsletter options</a></p>
        <div class="sf-news-grid">
          <div><label class="sr-only" for="nlName">Full name</label><input id="nlName" name="fullName" placeholder="Full name" autocomplete="name" required maxlength="100" /></div>
          <div><label class="sr-only" for="nlPhone">Phone number</label><input id="nlPhone" name="phone" type="tel" inputmode="tel" placeholder="Phone number (e.g. 0803 123 4567)" autocomplete="tel" required /></div>
          <div><label class="sr-only" for="newsletterEmail">Email address</label><input id="newsletterEmail" name="email" type="email" placeholder="Email address" autocomplete="email" required /></div>
          <div><label class="sr-only" for="nlEmail2">Confirm email address</label><input id="nlEmail2" name="confirmEmail" type="email" placeholder="Confirm email address" autocomplete="email" required /></div>
        </div>
        <label class="sf-news-consent"><input type="checkbox" name="consent" required /> <span>Yes, send me Lobi Stars news by email. I agree to the <a href="/privacy/">Privacy Policy</a>.</span></label>
        <button type="submit" class="btn-p sf-news-btn">Sign up</button>
        <p class="sf-news-msg" id="newsletterMsg" role="status" aria-live="polite"></p>
      </form>
    </div>

    <div class="sf-cols">
      {columns.map(col => (
        <nav class="sf-col" aria-label={col.title} style={`--rows:${layout(col.links.length, MAX_ROWS)};--rows-m:${Math.ceil(col.links.length / 2)}`}>
          <h2>{col.title}</h2>
          <ul>{col.links.map(([label, href, ext]) => <li>{ext
            ? <a href={href} target="_blank" rel="noopener">{label} <span aria-hidden="true">&#8599;</span><span class="sr-only"> (opens in a new tab)</span></a>
            : <a href={href}>{label}</a>}</li>)}</ul>
        </nav>
      ))}
    </div>

    {partners.length > 0 && (
      <div class="sf-partners">
        <div class="sf-partners-head">
          <h2>Official Partners</h2>
          <a href="/partners">All partners &rarr;</a>
        </div>
        {principal && (
          <div class="sf-principal"><PartnerLogo partner={principal} size={principal.data.logoNoCard ? 'feature' : 'small'} label="Principal Partner" /></div>
        )}
        <ul>
          {others.map(p => <li><PartnerLogo partner={p} size="tiny" /></li>)}
        </ul>
      </div>
    )}

    <div class="sf-bottom">
      <div>&copy; <span data-year>{year}</span> Lobi Stars Football Club. All rights reserved.</div>
      <ul class="sf-legal">
        <li><a href="/privacy">Privacy Policy</a></li>
        <li><a href="/terms">Terms of Use</a></li>
        <li><a href="/accessibility">Accessibility</a></li>
        <li><a href="/sitemap">Sitemap</a></li>
        <li><button type="button" data-cookie-settings>Cookie settings</button></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .sf { background: #15181D; color: rgba(255, 255, 255, .78); margin-top: 70px; padding: 56px 0 24px; }
  @media (max-width: 767px) { .sf { margin-top: 0; } } /* phones: the page's own bottom padding is the gap */
  .sf-inner { max-width: 1280px; margin: 0 auto; padding: 0 5%; }
  .sf-top { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; padding-bottom: 40px; border-bottom: 1px solid rgba(255, 255, 255, .12); }
  .sf-logo { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; }
  .sf-logo span { font: 400 24px/1 'Bebas Neue', sans-serif; letter-spacing: 1.5px; color: #fff; }
  .sf-logo small { display: block; font: 600 10px/1.6 'Barlow Condensed', sans-serif; letter-spacing: 3px; color: #FFC72C; text-transform: uppercase; }
  .sf-brand p { margin: 16px 0 0; max-width: 420px; font-size: 14px; line-height: 1.7; color: rgba(255, 255, 255, .7); }
  .sf-brand .sf-follow { margin: 20px 0 0; font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; color: #FFC72C; }
  .sf-social { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; margin: 12px 0 0; padding: 0; }
  /* Phones: the icons spread evenly across the full width (first at the left edge, last at the right). */
  @media (max-width: 767px) { .sf-social { justify-content: space-between; gap: 8px; } }
  /* Each platform in its own brand colours (white logo on the brand colour). */
  .sf-social a, .sf-social .sf-soon {
    width: 44px; height: 44px; border-radius: 50%; border: 1px solid transparent;
    background-origin: border-box; /* the colour fills the whole circle (no band at the edge) */
    display: flex; align-items: center; justify-content: center; transition: transform .2s, filter .2s;
  }
  .sf-social svg { width: 19px; height: 19px; fill: #fff; }
  .sf-social a:hover, .sf-social a:focus-visible { transform: translateY(-2px); filter: brightness(1.12); }
  /* Not connected yet (address still to come): shown, but nothing happens on click. */
  .sf-soon { cursor: default; }
  .sf-social .sf-s--facebook { background: #1877F2; }
  .sf-social .sf-s--x { background: #000; border-color: rgba(255, 255, 255, .35); }
  /* Instagram's colours: a warm glow from the bottom left over a blue-to-purple base; no border, so the colour fills the circle to its edge. */
  .sf-social .sf-s--instagram { border: 0; background: radial-gradient(circle farthest-corner at 28% 108%, #FFDC80 0%, #FCAF45 14%, #F77737 28%, #F56040 40%, rgba(253, 29, 29, 0) 72%), linear-gradient(140deg, #405DE6 0%, #5851DB 22%, #833AB4 46%, #C13584 70%, #E1306C 100%); background-repeat: no-repeat; }
  .sf-social .sf-s--youtube { background: #FF0000; }
  .sf-social .sf-s--tiktok { background: #000; border-color: rgba(255, 255, 255, .35); }
  .sf-social .sf-s--whatsappChannel { background: #25D366; }

  .sf-news-title { margin: 0; font: 400 26px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; color: #fff; }
  .sf-news p { margin: 8px 0 14px; font-size: 14px; color: rgba(255, 255, 255, .7); }
  .sf-news-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .sf-news-grid input { width: 100%; }
  .sf-news-consent { display: flex; gap: 10px; align-items: flex-start; margin: 12px 0; font-size: 13px; line-height: 1.45; color: rgba(255, 255, 255, .85); cursor: pointer; }
  .sf-news-consent input { width: 18px; height: 18px; margin-top: 1px; flex-shrink: 0; accent-color: #E31E24; }
  .sf-news-consent a { color: #FFC72C; }
  .sf-news-btn { width: 100%; }
  @media (max-width: 520px) { .sf-news-grid { grid-template-columns: 1fr; } }
  .sf-news input:not([type=checkbox]) {
    flex: 1; min-width: 0; padding: 12px 14px; border-radius: 4px; border: 1px solid rgba(255, 255, 255, .25);
    background: rgba(255, 255, 255, .06); color: #fff; font-size: 15px;
  }
  .sf-news input::placeholder { color: rgba(255, 255, 255, .5); }
  .sf-news input:focus { outline: 2px solid #FFC72C; outline-offset: 1px; }
  .sf-news .btn-p { padding: 12px 22px; }
  .sf-news-more { color: #FFC72C; font-weight: 700; white-space: nowrap; }
  .sf-news-msg { min-height: 1.2em; margin: 10px 0 0 !important; }
  .sf-news-msg.ok { color: #7BE495 !important; }
  .sf-news-msg.err { color: #FF8A8E !important; }

  .sf-cols { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 32px 40px; padding: 40px 0; }
  .sf-col h2 { margin: 0 0 14px; font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; color: #FFC72C; }
  .sf-col ul { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-template-rows: repeat(var(--rows), auto); justify-content: start; gap: 10px 32px; }
  .sf-col li { white-space: nowrap; }
  .sf-col a { color: rgba(255, 255, 255, .75); text-decoration: none; font-size: 14px; }
  .sf-col a:hover, .sf-col a:focus-visible { color: #fff; text-decoration: underline; }

  .sf-partners { padding: 0 0 32px; }
  .sf-partners-head { display: flex; justify-content: center; align-items: baseline; gap: 18px; margin-bottom: 16px; }
  .sf-partners-head h2 { margin: 0; font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; color: #FFC72C; }
  .sf-partners-head a { color: rgba(255, 255, 255, .8); font-size: 14px; text-decoration: none; }
  .sf-partners-head a:hover { color: #fff; text-decoration: underline; }
  /* Principal partner on its own row, larger than the other partners. */
  .sf-principal { display: flex; justify-content: center; margin: 0 0 22px; }
  .sf-principal :global(.pl-label) { color: #FFC72C; font-size: 12px; }
  .sf-principal :global(.pl-age) { font-size: 11.5px; color: rgba(255, 255, 255, .85); }
  .sf-partners ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start; gap: 14px; }
  .sf-partners :global(.pl-age) { color: rgba(255, 255, 255, .75); font-size: 10px; }
  .sf-bottom {
    border-top: 1px solid rgba(255, 255, 255, .12); padding-top: 20px; display: flex; justify-content: space-between;
    align-items: center; flex-wrap: wrap; gap: 12px; font-size: 13px; color: rgba(255, 255, 255, .6);
  }
  .sf-legal { list-style: none; display: flex; flex-wrap: wrap; gap: 18px; margin: 0; padding: 0; }
  .sf-legal a, .sf-legal button {
    color: rgba(255, 255, 255, .75); text-decoration: none; background: none; border: 0; padding: 0; font: inherit; cursor: pointer;
  }
  .sf-legal a:hover, .sf-legal button:hover { color: #fff; text-decoration: underline; }
  .sf a:focus-visible, .sf button:focus-visible { outline: 2px solid #FFC72C; outline-offset: 2px; }

  @media (max-width: 860px) {
    .sf-top { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 1100px) {
    .sf-cols { display: grid; grid-template-columns: auto auto; justify-content: space-between; }
  }
  @media (max-width: 600px) {
    .sf-cols { grid-template-columns: 1fr; gap: 28px; }
    .sf-col ul { grid-template-rows: repeat(var(--rows-m), auto); grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 420px) { .sf-news-row { flex-direction: column; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-year]').forEach(el => { el.textContent = String(new Date().getFullYear()); });

  const form = document.getElementById('newsletterForm') as HTMLFormElement | null;
  if (form) {
    const msg = document.getElementById('newsletterMsg')!;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    form.addEventListener('submit', async e => {
      e.preventDefault();
      msg.className = 'sf-news-msg';
      const f = new FormData(form);
      const v = (k: string) => String(f.get(k) || '').trim();
      const show = (t: string, ok = false) => { msg.textContent = t; msg.classList.add(ok ? 'ok' : 'err'); };
      if (!v('fullName')) return show('Please enter your full name.');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v('email'))) return show('Please enter a valid email address.');
      if (v('email').toLowerCase() !== v('confirmEmail').toLowerCase()) return show('The email addresses do not match.');
      if (!f.get('consent')) return show('Please tick the box to agree to receive club news.');
      btn.disabled = true;
      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ fullName: v('fullName'), phone: v('phone'), email: v('email'), confirmEmail: v('confirmEmail'), consent: true, source: location.pathname }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Could not sign you up. Please try again.');
        show(data.message || "Thanks! You're on the list.", true);
        (window as any).lsGa?.('newsletter_signup', { location: 'footer' });
        form.reset();
      } catch (err) {
        show((err as Error).message);
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
