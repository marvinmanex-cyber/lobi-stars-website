---
// Floating "MatchDay Kitchen" button. It was shown on phones only, on match
// days (while in-seat ordering is open). Since October 2026 it is not shown on
// phones either (it covered content while scrolling): fans reach the kitchen
// from the homepage MatchDay Kitchen card, the menu, the footer and match
// pages. Tablet and desktop never showed it, so they are unchanged.
// Kept (hidden) so it can be switched back on in one place.
---
<a class="kfab" id="kfab" href="/kitchen/" hidden data-track="kitchen_click" data-track-label="floating_button">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v8M5 3v5a2 2 0 0 0 4 0V3M7 11v10M16 3c-1.7 1.2-2.5 3.4-2.5 6.5h2.5V21" /></svg>
  <span>MatchDay Kitchen</span>
</a>

<style is:global>
  .kfab { display: none; }
  /* Off on phones too (was: max-width 767px). Change "0px" back to "767px" to bring it back. */
  @media (max-width: 0px) {
    .kfab:not([hidden]) {
      display: inline-flex; align-items: center; gap: 8px; position: fixed; right: 16px; z-index: 998;
      bottom: calc(140px + env(safe-area-inset-bottom)); min-height: 48px; padding: 0 16px 0 14px; border-radius: 999px;
      background: #18C93A; color: #04140A; text-decoration: none; box-shadow: 0 6px 18px -4px rgba(24, 201, 58, .6);
      font: 700 14px/1 'Barlow Condensed', sans-serif; letter-spacing: .06em; text-transform: uppercase;
      animation: kfab-in .35s ease both;
    }
    .kfab svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
    .kfab:focus-visible { outline: 3px solid #0A1730; outline-offset: 2px; }
  }
  @keyframes kfab-in { from { opacity: 0; transform: translateY(10px); } }
  @media (prefers-reduced-motion: reduce) { .kfab { animation: none !important; } }
</style>

<script is:inline>
(function () {
  var fab = document.getElementById('kfab');
  // Not shown on any screen size now (see above), so it doesn't ask the server either.
  // To bring it back on phones, restore: if (!fab || /^\/(kitchen|food)(\/|$)/.test(location.pathname) || !window.matchMedia('(max-width: 767px)').matches) return;
  return;
  var show = function (open) { fab.hidden = !open; };
  try { var c = JSON.parse(sessionStorage.getItem('ls_kfab') || 'null'); if (c && Date.now() - c.at < 300000) return show(c.open); } catch (e) {}
  fetch('/api/food/menu').then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
    var open = !!(d && d.open);
    try { sessionStorage.setItem('ls_kfab', JSON.stringify({ open: open, at: Date.now() })); } catch (e) {}
    show(open);
  }).catch(function () {});
})();
</script>
