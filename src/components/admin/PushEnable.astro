---
// "Enable notifications" for staff phones/computers (food order alerts), and
// which alerts this person wants: paid orders and/or new unpaid orders.
// Works when the admin tab is closed too (the browser's push service wakes
// /admin-sw.js). Needs the VAPID keys set on the server.
---
<details class="pe" id="pe">
  <summary class="btn-o pe-btn" id="peBtn">🔔 Notifications</summary>
  <div class="pe-box">
    <p class="pe-k">On this device</p>
    <p class="pe-state" id="peState">Checking…</p>
    <label><input type="checkbox" id="pePaid" checked /> 🟢 Paid orders (start preparing)</label>
    <label><input type="checkbox" id="peUnpaid" /> 🟡 New orders awaiting payment</label>
    <div class="pe-acts">
      <button type="button" class="btn-p" id="peOn">Enable notifications</button>
      <button type="button" class="btn-o" id="peOff" hidden>Turn off</button>
      <button type="button" class="btn-o" id="peTest">Send test</button>
    </div>
    <p class="pe-small">On iPhone, first add the site to your Home Screen (Share → Add to Home Screen) and open it from there. Sounds and pop-ups inside the admin follow these choices too.</p>
  </div>
</details>

<style is:global>
  .pe { position: relative; }
  .pe > summary { list-style: none; cursor: pointer; }
  .pe > summary::-webkit-details-marker { display: none; }
  .pe-box { position: absolute; right: 0; top: calc(100% + 8px); z-index: 1500; width: min(340px, 92vw); padding: 16px; border-radius: 14px; background: var(--a-card, #fff); color: var(--a-ink, #15181D); border: 1px solid var(--a-line, #E3E6EA); box-shadow: 0 18px 40px rgba(15,17,21,.2); }
  .pe-k { margin: 0 0 4px; font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.5px; text-transform: uppercase; color: var(--lt); }
  .pe-state { margin: 0 0 10px; font-weight: 700; }
  .pe-box label { display: flex; gap: 8px; align-items: center; margin: 6px 0; font-size: 15px; }
  .pe-box input { width: 18px; height: 18px; accent-color: #16A34A; }
  .pe-acts { display: flex; gap: 8px; flex-wrap: wrap; margin: 12px 0 8px; }
  .pe-acts button { padding: 9px 14px; font-size: 13px; }
  .pe-small { margin: 0; font-size: 12px; color: var(--lt); }
</style>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const code = sessionStorage.getItem('ls_admin_code') || '__session__';
  const H = { 'Content-Type': 'application/json', 'x-admin-code': code };
  const w = window as any;
  let publicKey: string | null = null;
  const prefsKey = () => 'ls_food_prefs:' + (w.__lsAdmin?.id || '');
  const savePrefs = () => { try { localStorage.setItem(prefsKey(), JSON.stringify({ paid: ($('pePaid') as HTMLInputElement).checked, unpaid: ($('peUnpaid') as HTMLInputElement).checked })); } catch {} };
  const toKey = (b64: string) => { const p = '='.repeat((4 - (b64.length % 4)) % 4); const raw = atob((b64 + p).replace(/-/g, '+').replace(/_/g, '/')); return Uint8Array.from(raw, c => c.charCodeAt(0)); };
  const supported = 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;

  async function current() {
    if (!supported) return null;
    const reg = await navigator.serviceWorker.getRegistration('/admin/');
    return reg ? reg.pushManager.getSubscription() : null;
  }
  async function refresh() {
    try {
      const d = await (await fetch('/api/admin/food-alerts?after=999999999', { headers: H })).json();
      publicKey = d.push?.publicKey || null;
      const sub = await current();
      const st = $('peState');
      if (!supported) st.textContent = 'This browser can’t show notifications.';
      else if (!d.push?.ready) st.textContent = 'Not set up on the server yet (VAPID keys needed).';
      else if (Notification.permission === 'denied') st.textContent = 'Blocked in this browser’s site settings.';
      else st.textContent = sub ? '✅ Notifications are on.' : 'Off.';
      $('peOn').textContent = sub ? 'Save choices' : 'Enable notifications';
      $('peOff').hidden = !sub;
      ($('peOn') as HTMLButtonElement).disabled = !supported || !d.push?.ready;
    } catch { $('peState').textContent = 'Could not check.'; }
  }
  document.addEventListener('ls:admin', () => {
    try { const p = JSON.parse(localStorage.getItem(prefsKey()) || '{}'); if (p.paid === false) ($('pePaid') as HTMLInputElement).checked = false; if (p.unpaid) ($('peUnpaid') as HTMLInputElement).checked = true; } catch {}
  });
  $('pePaid').addEventListener('change', savePrefs);
  $('peUnpaid').addEventListener('change', savePrefs);
  $('pe').addEventListener('toggle', () => { if (($('pe') as HTMLDetailsElement).open) refresh(); });

  $('peOn').addEventListener('click', async () => {
    savePrefs();
    try {
      const perm = await Notification.requestPermission();
      if (perm !== 'granted') { $('peState').textContent = 'Permission was not given.'; return; }
      const reg = await navigator.serviceWorker.register('/admin-sw.js', { scope: '/admin/' });
      await navigator.serviceWorker.ready;
      const sub = (await reg.pushManager.getSubscription()) || await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: toKey(publicKey!) });
      const r = await fetch('/api/admin/food-alerts/subscribe', { method: 'POST', headers: H, body: JSON.stringify({
        subscription: sub.toJSON(), wantPaid: ($('pePaid') as HTMLInputElement).checked, wantUnpaid: ($('peUnpaid') as HTMLInputElement).checked,
        device: `${navigator.platform || ''} ${/Mobi/.test(navigator.userAgent) ? 'phone' : 'computer'}`.trim(),
      }) });
      if (!r.ok) throw new Error('Could not save');
      await refresh();
    } catch (err) { $('peState').textContent = `Could not turn on notifications: ${(err as Error).message}`; }
  });
  $('peOff').addEventListener('click', async () => {
    const sub = await current();
    if (sub) { await fetch('/api/admin/food-alerts/subscribe', { method: 'DELETE', headers: H, body: JSON.stringify({ endpoint: sub.endpoint }) }); await sub.unsubscribe(); }
    refresh();
  });
  $('peTest').addEventListener('click', async () => {
    const d = await (await fetch('/api/admin/food-alerts/test', { method: 'POST', headers: H })).json().catch(() => ({}));
    $('peState').textContent = d.pushReady ? `Test sent to ${d.pushSent} device(s). It also appears in the bell.` : 'Test sent to the bell (phone notifications need the VAPID keys).';
    document.dispatchEvent(new Event('ls:food-poll'));
  });
</script>
