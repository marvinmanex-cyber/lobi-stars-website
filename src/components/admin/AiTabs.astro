---
// Tabs at the top of the AI Fix pages. AI Settings is for Super Admins (hidden
// for others once we know who is signed in; the server refuses it anyway).
interface Props { current: 'fix' | 'history' | 'results' | 'settings' }
const { current } = Astro.props;
const TABS = [
  { id: 'fix', label: 'AI Fix', href: '/admin/ai/' },
  { id: 'history', label: 'Fix history', href: '/admin/ai/history/' },
  { id: 'results', label: 'Fix results', href: '/admin/ai/results/' },
  { id: 'settings', label: 'AI Settings', href: '/admin/ai/settings/', super: true },
];
---
<nav class="ait" aria-label="AI Fix">
  {TABS.map(t => <a href={t.href} aria-current={t.id === current ? 'page' : undefined} data-super={t.super ? '1' : undefined}>{t.label}</a>)}
</nav>
<style>
  .ait { display: flex; gap: 4px; flex-wrap: wrap; background: var(--a-soft); border: 1px solid var(--a-line); border-radius: 12px; padding: 4px; }
  .ait a { padding: 8px 14px; border-radius: 9px; font-size: 14px; font-weight: 700; color: var(--a-muted); text-decoration: none; }
  .ait a[aria-current="page"] { background: var(--a-card); color: var(--a-ink); box-shadow: 0 1px 4px rgba(0,0,0,.08); }
  .ait a:focus-visible { outline: 3px solid #FFC72C; outline-offset: 1px; }
</style>
<script is:inline>
  document.addEventListener('ls:admin', e => {
    if (e.detail && e.detail.permissions && e.detail.permissions.includes('ai.fix')) return;
    document.querySelectorAll('.ait [data-super]').forEach(a => { a.hidden = true; });
  });
</script>
