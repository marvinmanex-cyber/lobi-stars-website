---
// The Share Hub (Admin › Matchday Programme › Share): share one programme to
// all of the club's social platforms. Every link is the tracked share page
// lobistarsfc.com/m/<slug>?src=<platform>&v=<n> (a proper link card; fans sign
// in to read or download). Share images are made here in the browser from the
// programme cover. Telegram and Facebook can post automatically once their
// secrets are set; the others use their share window or copy-and-paste.
// Opened with window.lsOpenShareHub(programmeId).
---
<dialog class="sh" id="sh" aria-labelledby="shTitle">
  <header class="sh-head">
    <div class="sh-head-t">
      <p class="sh-k">Share Hub</p>
      <h2 id="shTitle">Programme</h2>
      <p class="sh-meta"><span class="sh-chip" id="shState"></span> <span id="shKick"></span></p>
    </div>
    <button type="button" class="sh-x" id="shClose" aria-label="Close the Share Hub">×</button>
  </header>
  <div class="sh-body">
    <p class="sh-msg" id="shMsg" role="status" aria-live="polite" hidden></p>

    <section class="sh-sec" aria-labelledby="shImgH">
      <div class="sh-sec-h"><h3 id="shImgH">Share images</h3><span class="sh-status" id="shImgStatus"></span></div>
      <p class="sh-warn" id="shStale" hidden>Share images are out of date because the PDF changed. New ones are being made and saved.</p>
      <div class="sh-2">
        <label class="sh-lbl">Headline<input id="shHead" maxlength="70" /></label>
        <label class="sh-lbl">Sub-line<input id="shSub" maxlength="90" /></label>
      </div>
      <div class="sh-imgs">
        <figure><canvas id="cvCard" width="1200" height="630"></canvas><figcaption>Link card 1200 × 630 <span id="szCard"></span></figcaption></figure>
        <figure><canvas id="cvSquare" width="1080" height="1080"></canvas><figcaption>Square 1080 × 1080 <span id="szSquare"></span></figcaption></figure>
        <figure><canvas id="cvStory" width="1080" height="1920"></canvas><figcaption>Story 1080 × 1920 <span id="szStory"></span></figcaption></figure>
      </div>
      <div class="sh-row"><button type="button" class="btn-o sm" id="shRegen">Regenerate</button><button type="button" class="btn-p sm" id="shSave">Save share images</button></div>
    </section>

    <section class="sh-sec" aria-labelledby="shAutoH">
      <h3 id="shAutoH">Post automatically</h3>
      <div id="shAuto"></div>
      <div class="sh-row">
        <button type="button" class="btn-p sm" id="shPostNow">Post now</button>
      </div>
      <div class="sh-sched">
        <label class="sh-lbl">Or post at (Nigeria time, WAT)<input type="datetime-local" id="shAt" /></label>
        <div class="sh-row">
          <button type="button" class="btn-o sm" id="shAtLive">When the programme goes live</button>
          <button type="button" class="btn-o sm" id="shAtHour">Now + 1 hour</button>
          <button type="button" class="btn-p sm" id="shSchedSave">Save schedule</button>
          <button type="button" class="btn-o sm" id="shSchedClear">Clear</button>
        </div>
        <p class="sh-note" id="shSchedNow"></p>
      </div>
      <div id="shResults"></div>
    </section>

    <div class="sh-cards" id="shCards"></div>

    <div class="sh-2">
      <section class="sh-sec" aria-labelledby="shRefH">
        <h3 id="shRefH">Refresh previews</h3>
        <p class="sh-note">Facebook keeps an old preview of a link. After changing the share images, open the Sharing Debugger and press <b>Scrape Again</b>. WhatsApp and X refresh by themselves, because every link carries <code>?v=</code>, which changes when the images change.</p>
        <a class="btn-o sm" id="shDebug" target="_blank" rel="noopener">Open Facebook Sharing Debugger ↗</a>
      </section>
      <section class="sh-sec" aria-labelledby="shHistH">
        <h3 id="shHistH">Post history</h3>
        <ul class="sh-hist" id="shHist"></ul>
      </section>
    </div>
    <p class="sh-note"><button type="button" class="sh-linkbtn" id="shSettings">Edit platforms, captions and hashtags</button></p>
  </div>
</dialog>

<dialog class="sh-confirm" id="shConfirm" aria-labelledby="shConfT">
  <h3 id="shConfT">Post now?</h3>
  <img id="shConfImg" alt="Link card that will be posted" />
  <div id="shConfList"></div>
  <div class="sh-row"><button type="button" class="btn-o sm" id="shConfNo">Cancel</button><button type="button" class="btn-p sm" id="shConfYes">Post now</button></div>
</dialog>

<dialog class="sh-confirm sh-set" id="shSet" aria-labelledby="shSetT">
  <div class="sh-sec-h"><h3 id="shSetT">Platforms, captions and hashtags</h3><button type="button" class="sh-x" id="shSetX" aria-label="Close">×</button></div>
  <p class="sh-note">Placeholders: {'{title}'} {'{kickoff_date}'} {'{kickoff_time}'} {'{venue}'} {'{link}'} {'{hashtags}'} {'{drop_date}'} {'{drop_time}'}. The platform key and tracked-link code never change.</p>
  <div id="shSetList"></div>
</dialog>

<style>
  .sh { border: 0; padding: 0; width: min(1180px, calc(100vw - 16px)); max-width: none; height: calc(100dvh - 16px); max-height: none; border-radius: 16px; background: var(--a-bg, #F4F5F7); color: var(--a-ink, #15181D); box-shadow: 0 30px 80px rgba(0,0,0,.4); }
  .sh[open] { display: flex; flex-direction: column; }
  .sh::backdrop, .sh-confirm::backdrop { background: rgba(15,17,21,.6); }
  .sh-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; padding: 14px 18px; background: #15181D; color: #fff; }
  .sh-k { margin: 0; font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; color: #FFC72C; }
  .sh-head h2 { margin: 4px 0; font: 400 28px/1.05 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .sh-meta { margin: 0; font-size: 14px; color: rgba(255,255,255,.8); }
  .sh-chip { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; background: #DCFCE7; color: #166534; }
  .sh-chip.up { background: #FEF3C7; color: #92400E; } .sh-chip.no { background: #E5E7EB; color: #374151; }
  .sh-x { width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgba(255,255,255,.12); color: inherit; font-size: 26px; cursor: pointer; flex: none; }
  .sh-set .sh-x { background: var(--a-soft, #F1F3F5); }
  .sh-body { overflow-y: auto; padding: 16px 18px 30px; flex: 1; }
  .sh-msg { position: sticky; top: 0; z-index: 5; margin: 0 0 12px; padding: 10px 14px; border-radius: 10px; font-weight: 600; background: #E8F7EE; color: #17643A; }
  .sh-msg.err { background: #FDECEC; color: #A3161B; }
  .sh-sec { background: var(--a-card, #fff); border: 1px solid var(--a-line, #E3E6EA); border-radius: 14px; padding: 14px 16px; margin-bottom: 14px; min-width: 0; }
  .sh-sec h3, .sh-confirm h3 { margin: 0 0 10px; font: 700 17px/1.2 'Barlow', sans-serif; }
  .sh-sec-h { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .sh-status { font-size: 13px; color: var(--a-muted); }
  .sh-warn { margin: 0 0 10px; padding: 10px 12px; border-radius: 10px; background: #FFF7E6; color: #7A4B00; }
  .sh-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .sh-lbl { display: grid; gap: 5px; font-size: 13px; font-weight: 700; color: var(--a-muted); }
  .sh-lbl input, .sh-lbl textarea { min-height: 42px; border: 1px solid var(--a-line); border-radius: 10px; padding: 8px 10px; background: var(--a-card); color: var(--a-ink); font: 400 15px 'Barlow', sans-serif; width: 100%; box-sizing: border-box; }
  .sh-imgs { display: grid; grid-template-columns: 2.2fr 1.1fr .62fr; gap: 12px; align-items: end; margin: 12px 0; }
  .sh-imgs figure { margin: 0; font-size: 12px; color: var(--a-muted); }
  .sh-imgs canvas { width: 100%; height: auto; display: block; border-radius: 6px; box-shadow: 0 6px 18px rgba(0,0,0,.18); background: #222; }
  .sh-row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }
  .sm { min-height: 40px; padding: 7px 14px; font-size: 13px; }
  .sh-note { margin: 6px 0; font-size: 13px; color: var(--a-muted); line-height: 1.5; }
  .sh-sched { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--a-line); }
  .sh :global(.sh-auto) { display: flex; gap: 10px; align-items: center; padding: 8px 0; font-size: 15px; }
  .sh :global(.sh-auto input) { width: 22px; height: 22px; accent-color: #E31E24; }
  .sh :global(.sh-auto small) { color: var(--a-muted); }
  .sh :global(.sh-res) { margin: 8px 0 0; padding: 8px 12px; border-radius: 10px; font-size: 14px; }
  .sh :global(.sh-res.ok) { background: #E8F7EE; color: #17643A; } .sh :global(.sh-res.bad) { background: #FDECEC; color: #A3161B; }
  .sh :global(.sh-res a) { color: inherit; font-weight: 700; }
  .sh-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 14px; margin-bottom: 14px; }
  .sh :global(.sh-card) { background: var(--a-card); border: 1px solid var(--a-line); border-radius: 14px; padding: 14px; display: grid; gap: 8px; align-content: start; min-width: 0; }
  .sh :global(.sh-card-h) { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }
  .sh :global(.sh-card-h b) { font: 700 18px 'Barlow', sans-serif; }
  .sh :global(.sh-card-h a) { font-size: 13px; }
  .sh :global(.sh-last) { font-size: 12px; padding: 2px 8px; border-radius: 999px; background: var(--a-soft); color: var(--a-muted); }
  .sh :global(.sh-last.ok) { background: #DCFCE7; color: #166534; } .sh :global(.sh-last.bad) { background: #FEE2E2; color: #991B1B; }
  .sh :global(.sh-card textarea) { width: 100%; min-height: 150px; border: 1px solid var(--a-line); border-radius: 10px; padding: 8px 10px; font: 400 14px/1.45 'Barlow', sans-serif; background: var(--a-card); color: var(--a-ink); box-sizing: border-box; resize: vertical; }
  .sh :global(.sh-count) { font-size: 12px; color: var(--a-muted); text-align: right; }
  .sh :global(.sh-count.over) { color: #DC2626; font-weight: 700; }
  .sh :global(.sh-link) { display: flex; gap: 6px; align-items: center; font: 600 12px ui-monospace, Menlo, monospace; overflow-wrap: anywhere; }
  .sh :global(.sh-link span) { flex: 1; min-width: 0; }
  .sh :global(.sh-hint) { font-size: 12px; color: #7A4B00; background: #FFF7E6; border-radius: 8px; padding: 6px 8px; }
  .sh :global(.sh-btns) { display: flex; gap: 6px; flex-wrap: wrap; }
  .sh :global(.sh-btns button), .sh :global(.sh-btns a), .sh :global(.sh-link button) { min-height: 38px; padding: 4px 10px; border-radius: 8px; border: 1px solid var(--a-line); background: var(--a-card); color: var(--a-ink); font: 700 13px 'Barlow', sans-serif; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; }
  .sh :global(.sh-btns .pri) { background: #E31E24; border-color: #E31E24; color: #fff; }
  .sh :global(.sh-stats) { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .sh :global(.sh-stats div) { background: var(--a-soft); border-radius: 8px; padding: 6px; text-align: center; }
  .sh :global(.sh-stats b) { display: block; font: 400 22px/1 'Bebas Neue', sans-serif; }
  .sh :global(.sh-stats span) { font-size: 11px; color: var(--a-muted); }
  .sh :global(details) { font-size: 13px; color: var(--a-muted); }
  .sh :global(details summary) { cursor: pointer; font-weight: 700; color: var(--a-ink); }
  .sh :global(details ul) { margin: 6px 0 0; padding-left: 18px; }
  .sh-hist { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: 14px; max-height: 260px; overflow-y: auto; }
  .sh :global(.sh-hist li) { display: flex; justify-content: space-between; gap: 8px; border-bottom: 1px solid var(--a-line); padding-bottom: 6px; }
  .sh-linkbtn { border: 0; background: none; padding: 6px 0; color: #B3161B; font: 700 14px 'Barlow', sans-serif; text-decoration: underline; cursor: pointer; }
  .sh-confirm { border: 0; border-radius: 16px; padding: 18px; width: min(560px, calc(100vw - 24px)); max-height: calc(100dvh - 24px); overflow-y: auto; background: var(--a-card, #fff); color: var(--a-ink, #15181D); }
  .sh-confirm img { width: 100%; border-radius: 8px; margin-bottom: 10px; }
  .sh-confirm :global(pre) { white-space: pre-wrap; font: 13px/1.45 'Barlow', sans-serif; background: var(--a-soft, #F1F3F5); padding: 10px; border-radius: 8px; max-height: 220px; overflow-y: auto; }
  .sh-confirm :global(.sh-warnline) { color: #92400E; font-weight: 700; font-size: 14px; }
  .sh-set { width: min(820px, calc(100vw - 24px)); }
  .sh-set :global(.sh-plat) { border: 1px solid var(--a-line); border-radius: 12px; padding: 12px; margin-bottom: 10px; display: grid; gap: 8px; }
  .sh-set :global(.sh-plat textarea) { min-height: 110px; }
  .sh [hidden], .sh-confirm [hidden] { display: none !important; }
  :global(input:focus-visible), :global(button:focus-visible) { outline: 3px solid #FFC72C; outline-offset: 2px; }
  @media (max-width: 760px) {
    .sh { width: 100vw; height: 100dvh; border-radius: 0; }
    .sh-2, .sh-imgs { grid-template-columns: 1fr; }
    .sh-cards { grid-template-columns: 1fr; }
    .sh-imgs figure:last-child canvas { max-width: 50%; }
  }
</style>

<script>
  import qrcode from 'qrcode-generator';

  const code = sessionStorage.getItem('ls_admin_code') || '__session__';
  const H = { 'x-admin-code': code };
  const $ = (id: string) => document.getElementById(id) as any;
  const el = (tag: string, props: Record<string, any> = {}, ...kids: any[]) => {
    const n: any = document.createElement(tag);
    for (const [k, v] of Object.entries(props)) { if (k === 'class') n.className = v; else if (k === 'text') n.textContent = v; else if (k.startsWith('on')) n.addEventListener(k.slice(2), v); else if (v !== undefined && v !== null && v !== false) n.setAttribute(k, v === true ? '' : v); }
    for (const c of kids) if (c != null) n.append(c);
    return n;
  };
  const WAT = { timeZone: 'Africa/Lagos' };
  const watLong = (iso: string) => iso ? new Date(iso).toLocaleString('en-GB', { ...WAT, weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';
  const dateLong = (iso: string) => iso ? new Date(iso).toLocaleDateString('en-GB', { ...WAT, weekday: 'long', day: 'numeric', month: 'long' }) : '';
  const isoToWat = (iso: string) => iso ? new Date(new Date(iso).getTime() + 3600e3).toISOString().slice(0, 16) : '';
  const watToIso = (v: string) => v ? new Date(`${v}:00+01:00`).toISOString() : null;
  const ago = (s: string) => { const d = (Date.now() - new Date(s.replace(' ', 'T') + (s.includes('Z') ? '' : 'Z')).getTime()) / 60000; return d < 1 ? 'just now' : d < 60 ? `${Math.round(d)} min ago` : d < 1440 ? `${Math.round(d / 60)} h ago` : `${Math.round(d / 1440)} days ago`; };
  const kb = (n: number) => `${Math.round(n / 1024)} KB`;
  const TIPS: Record<string, string[]> = {
    telegram: ['Post in the club channel; the button under the picture opens the programme.', 'Pin the post on match day.'],
    facebook: ['Paste the link last: Facebook shows the link card under your text.', 'If the picture is old, use Refresh previews below.'],
    twitter: ['Keep it short: X counts every link as 23 characters.', 'Pin the post until kick-off.'],
    whatsapp: ['Share to club groups and broadcast lists; the link card shows the programme cover.', 'For WhatsApp Status, post the story image: people can scan its QR code.'],
    instagram: ["Captions can't hold clickable links: put the bio link in your profile, or add a Link sticker to a Story.", 'Post the square image to the feed and the story image to Stories.'],
    tiktok: ['Use the story image as a photo post, or show it at the end of a video.', 'Put the bio link in your profile.'],
    youtube: ['Use the link card as a Community post image.', 'Add the tracked link to video descriptions on match day.'],
  };
  const IMAGE_FOR: Record<string, 'card' | 'square' | 'story'> = { telegram: 'card', facebook: 'card', twitter: 'card', youtube: 'card', instagram: 'square', whatsapp: 'story', tiktok: 'story' };
  const URL_RE = /https?:\/\/[^\s]+/g;
  const countFor = (key: string, t: string) => key === 'twitter' ? [...t.replace(URL_RE, 'x'.repeat(23))].length : [...t].length;
  const noLink = (t: string, url: string) => t.split(url).join('').replace(URL_RE, '').replace(/\n{3,}/g, '\n\n').trim();
  function intent(key: string, caption: string, url: string) {
    const e = encodeURIComponent;
    if (key === 'facebook') return `https://www.facebook.com/sharer/sharer.php?u=${e(url)}`;
    if (key === 'twitter') return `https://x.com/intent/post?text=${e(noLink(caption, url))}&url=${e(url)}`;
    if (key === 'whatsapp') return `https://wa.me/?text=${e(caption.includes(url) ? caption : `${caption}\n${url}`)}`;
    if (key === 'telegram') return `https://t.me/share/url?url=${e(url)}&text=${e(noLink(caption, url))}`;
    return null;
  }

  let id: number | null = null, hub: any = null, blobs: Record<string, Blob> = {}, cover: HTMLImageElement | null = null;
  const crest = new Image(); crest.src = '/images/lobi-stars-badge.png';
  let msgT: any;
  function msg(t: string, ok = true) { const m = $('shMsg'); m.textContent = t; m.className = `sh-msg ${ok ? '' : 'err'}`; m.hidden = false; clearTimeout(msgT); msgT = setTimeout(() => { m.hidden = true; }, 6000); }
  async function api(path: string, method = 'GET', body?: any) {
    const r = await fetch(path, { method, headers: body ? { ...H, 'Content-Type': 'application/json' } : H, body: body ? JSON.stringify(body) : undefined, cache: 'no-store' });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || 'Request failed');
    return d;
  }
  async function copy(text: string, what = 'Copied.') { try { await navigator.clipboard.writeText(text); msg(what); } catch { prompt('Copy this:', text); } }

  // ── A) open / header ──
  async function open(pid: number) {
    id = pid; blobs = {}; cover = null;
    const d = $('sh'); if (!d.open) d.showModal();
    try {
      hub = await api(`/api/admin/programmes/${pid}/share`);
      const p = hub.programme;
      $('shTitle').textContent = p.title;
      $('shState').textContent = hub.state === 'live' ? 'Live' : hub.state === 'upcoming' ? `Drops ${watLong(p.publishAt)}` : 'Not published';
      $('shState').className = `sh-chip ${hub.state === 'live' ? '' : hub.state === 'upcoming' ? 'up' : 'no'}`;
      $('shKick').textContent = p.kickoffAt ? `Kick-off ${watLong(p.kickoffAt)} (WAT)` : '';
      if (!$('shHead').dataset.for || $('shHead').dataset.for !== String(pid)) {
        $('shHead').value = p.title; $('shSub').value = [dateLong(p.kickoffAt), p.venue].filter(Boolean).join(' · ');
        $('shHead').dataset.for = String(pid);
      }
      $('shDebug').href = hub.debuggerUrl;
      drawAuto(); drawCards(); drawHistory(); drawSchedule();
      if (p.hasFiles) {
        await loadCover();
        await drawImages();
        $('shStale').hidden = !hub.assetsStale;
        $('shImgStatus').textContent = hub.assetsReady ? (hub.assetsStale ? 'Out of date' : 'Saved') : 'Not saved yet';
        if (!hub.assetsReady || hub.assetsStale) await saveImages(true);
      } else {
        $('shImgStatus').textContent = 'Upload the PDF first';
      }
    } catch (e: any) { msg(e.message, false); }
  }
  (window as any).lsOpenShareHub = open;
  $('shClose').addEventListener('click', () => $('sh').close());

  // ── B) share images (browser canvas) ──
  async function loadCover() {
    try {
      const r = await fetch(`/api/admin/programmes/${id}/page/cover.jpg`, { headers: H });
      if (!r.ok) return;
      const img = new Image(); img.src = URL.createObjectURL(await r.blob());
      await img.decode(); cover = img;
    } catch (e) { console.error('[share] cover', e); }
  }
  function wrap(g: CanvasRenderingContext2D, text: string, maxW: number) {
    const words = text.split(/\s+/), lines: string[] = []; let line = '';
    for (const w of words) { const t = line ? `${line} ${w}` : w; if (g.measureText(t).width > maxW && line) { lines.push(line); line = w; } else line = t; }
    if (line) lines.push(line); return lines;
  }
  function bg(g: CanvasRenderingContext2D, w: number, h: number) {
    const grad = g.createLinearGradient(0, 0, w * .5, h); grad.addColorStop(0, '#2A0507'); grad.addColorStop(.55, '#15181D'); grad.addColorStop(1, '#0B0D10');
    g.fillStyle = grad; g.fillRect(0, 0, w, h);
    g.fillStyle = '#E31E24'; g.fillRect(0, h - Math.max(10, h * .014), w, Math.max(10, h * .014));
  }
  function drawCover(g: CanvasRenderingContext2D, x: number, y: number, h: number) {
    const w = cover ? h * (cover.naturalWidth / cover.naturalHeight) : h * .707;
    g.save(); g.shadowColor = 'rgba(0,0,0,.55)'; g.shadowBlur = h * .06; g.shadowOffsetY = h * .02;
    g.fillStyle = '#333'; g.fillRect(x, y, w, h); g.restore();
    if (cover) g.drawImage(cover, x, y, w, h);
    return w;
  }
  function pill(g: CanvasRenderingContext2D, text: string, x: number, y: number, size: number, center = false) {
    g.font = `700 ${size}px Barlow, Arial, sans-serif`;
    const w = g.measureText(text).width + size * 1.6, h = size * 2;
    const px = center ? x - w / 2 : x;
    g.fillStyle = '#FFC72C'; g.beginPath(); (g as any).roundRect ? (g as any).roundRect(px, y, w, h, h / 2) : g.rect(px, y, w, h); g.fill();
    g.fillStyle = '#15181D'; g.textBaseline = 'middle'; g.textAlign = 'left'; g.fillText(text, px + size * .8, y + h / 2 + 1);
  }
  function lines(g: CanvasRenderingContext2D, arr: string[], x: number, y: number, lh: number) { arr.forEach((l, i) => g.fillText(l, x, y + i * lh)); return y + arr.length * lh; }
  const head = () => ($('shHead').value.trim() || hub?.programme.title || '').toUpperCase();
  const sub = () => $('shSub').value.trim();
  const PILL = 'Free for fans · Sign in to read or download';

  function drawCard() {
    const cv = $('cvCard') as HTMLCanvasElement, g = cv.getContext('2d')!, W = 1200, Hh = 630;
    bg(g, W, Hh);
    const cw = drawCover(g, 70, 70, 470);
    const x = 70 + cw + 56, maxW = W - x - 70;
    if (crest.complete && crest.naturalWidth) g.drawImage(crest, W - 70 - 64, 52, 64, 64);
    g.textAlign = 'left'; g.textBaseline = 'top';
    g.fillStyle = '#FFC72C'; g.font = '700 26px "Barlow Condensed", Barlow, sans-serif'; g.fillText('MATCH DAY PROGRAMME', x, 130);
    g.fillStyle = '#FFFFFF'; let size = 84; g.font = `400 ${size}px "Bebas Neue", Impact, sans-serif`;
    let ls = wrap(g, head(), maxW); while (ls.length > 3 && size > 48) { size -= 6; g.font = `400 ${size}px "Bebas Neue", Impact, sans-serif`; ls = wrap(g, head(), maxW); }
    let y = lines(g, ls.slice(0, 3), x, 170, size * .98);
    g.fillStyle = 'rgba(255,255,255,.85)'; g.font = '600 28px Barlow, Arial, sans-serif';
    y = lines(g, wrap(g, sub(), maxW).slice(0, 2), x, y + 14, 36);
    pill(g, PILL, x, Math.min(y + 24, 500), 22);
  }
  function drawSquare() {
    const cv = $('cvSquare') as HTMLCanvasElement, g = cv.getContext('2d')!, W = 1080;
    bg(g, W, W);
    const ch = 560, cw = cover ? ch * (cover.naturalWidth / cover.naturalHeight) : ch * .707;
    drawCover(g, (W - cw) / 2, 70, ch);
    g.textAlign = 'center'; g.textBaseline = 'top';
    g.fillStyle = '#FFC72C'; g.font = '700 30px "Barlow Condensed", Barlow, sans-serif'; g.fillText('MATCH DAY PROGRAMME', W / 2, 670);
    g.fillStyle = '#FFFFFF'; let size = 78; g.font = `400 ${size}px "Bebas Neue", Impact, sans-serif`;
    let ls = wrap(g, head(), W - 140); while (ls.length > 2 && size > 46) { size -= 6; g.font = `400 ${size}px "Bebas Neue", Impact, sans-serif`; ls = wrap(g, head(), W - 140); }
    let y = lines(g, ls.slice(0, 2), W / 2, 712, size * .98);
    g.fillStyle = 'rgba(255,255,255,.85)'; g.font = '600 30px Barlow, Arial, sans-serif'; g.fillText(sub(), W / 2, y + 8, W - 140);
    pill(g, PILL, W / 2, Math.min(y + 60, 960), 26, true);
  }
  function drawStory() {
    const cv = $('cvStory') as HTMLCanvasElement, g = cv.getContext('2d')!, W = 1080, Hh = 1920;
    bg(g, W, Hh);
    if (crest.complete && crest.naturalWidth) g.drawImage(crest, (W - 120) / 2, 70, 120, 120);
    const ch = 760, cw = cover ? ch * (cover.naturalWidth / cover.naturalHeight) : ch * .707;
    drawCover(g, (W - cw) / 2, 230, ch);
    g.textAlign = 'center'; g.textBaseline = 'top';
    g.fillStyle = '#FFC72C'; g.font = '700 34px "Barlow Condensed", Barlow, sans-serif'; g.fillText('MATCH DAY PROGRAMME', W / 2, 1035);
    g.fillStyle = '#FFFFFF'; let size = 88; g.font = `400 ${size}px "Bebas Neue", Impact, sans-serif`;
    let ls = wrap(g, head(), W - 140); while (ls.length > 2 && size > 52) { size -= 6; g.font = `400 ${size}px "Bebas Neue", Impact, sans-serif`; ls = wrap(g, head(), W - 140); }
    const y = lines(g, ls.slice(0, 2), W / 2, 1080, size * .98);
    g.fillStyle = 'rgba(255,255,255,.85)'; g.font = '600 32px Barlow, Arial, sans-serif'; g.fillText(sub(), W / 2, y + 6, W - 140);
    // QR code for the tracked link (works from a screenshot), dark on white, 4-module quiet zone.
    const url = hub ? `https://lobistarsfc.com/m/${hub.programme.slug}?src=status&v=${hub.shareVersion}` : 'https://lobistarsfc.com/programme';
    const q = qrcode(0, 'Q'); q.addData(url); q.make();
    const n = q.getModuleCount(), size2 = 380, cell = size2 / (n + 8), qx = (W - size2) / 2, qy = 1390;
    g.fillStyle = '#FFFFFF'; g.fillRect(qx, qy, size2, size2); g.fillStyle = '#111111';
    for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) if (q.isDark(r, c)) g.fillRect(Math.floor(qx + (c + 4) * cell), Math.floor(qy + (r + 4) * cell), Math.ceil(cell), Math.ceil(cell));
    g.fillStyle = '#FFFFFF'; g.font = '700 38px Barlow, Arial, sans-serif'; g.fillText('Link in bio', W / 2, qy + size2 + 26);
    g.fillStyle = 'rgba(255,255,255,.8)'; g.font = '600 28px Barlow, Arial, sans-serif'; g.fillText('or scan · lobistarsfc.com/programme', W / 2, qy + size2 + 78);
  }
  async function toJpeg(cv: HTMLCanvasElement, maxBytes: number, start = 0.9) {
    let q = start, b: Blob | null = null;
    while (q >= 0.4) { b = await new Promise<Blob | null>(r => cv.toBlob(r, 'image/jpeg', q)); if (b && b.size <= maxBytes) return b; q -= 0.08; }
    return b!;
  }
  async function drawImages() {
    try {
      if (document.fonts) await Promise.race([document.fonts.ready, new Promise(r => setTimeout(r, 2000))]);
      await Promise.race([Promise.all([document.fonts?.load('400 60px "Bebas Neue"'), document.fonts?.load('700 26px "Barlow Condensed"'), document.fonts?.load('600 28px Barlow')]), new Promise(r => setTimeout(r, 2000))]);
      if (!crest.complete) await new Promise(r => { crest.onload = r; setTimeout(r, 1500); });
      drawCard(); drawSquare(); drawStory();
      blobs.card = await toJpeg($('cvCard'), 280 * 1024);
      blobs.square = await toJpeg($('cvSquare'), 1900 * 1024, 0.88);
      blobs.story = await toJpeg($('cvStory'), 1900 * 1024, 0.88);
      $('szCard').textContent = `(${kb(blobs.card.size)})`; $('szSquare').textContent = `(${kb(blobs.square.size)})`; $('szStory').textContent = `(${kb(blobs.story.size)})`;
    } catch (e) { console.error('[share] images', e); }
  }
  async function saveImages(auto = false) {
    if (!blobs.card) await drawImages();
    try {
      const f = new FormData();
      f.append('card', blobs.card, 'card.jpg'); f.append('square', blobs.square, 'square.jpg'); f.append('story', blobs.story, 'story.jpg');
      const r = await fetch(`/api/admin/programmes/${id}/share-assets`, { method: 'POST', headers: H, body: f });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.error || 'Could not save the share images.');
      msg(auto ? 'Share images made and saved.' : 'Share images saved. Links now carry a new ?v= so previews refresh.');
      hub = await api(`/api/admin/programmes/${id}/share`);
      $('shStale').hidden = true; $('shImgStatus').textContent = 'Saved';
      drawCards(); drawSchedule();
    } catch (e: any) { msg(e.message, false); }
  }
  let redraw: any;
  ['shHead', 'shSub'].forEach(i => $(i).addEventListener('input', () => { clearTimeout(redraw); redraw = setTimeout(drawImages, 250); }));
  $('shRegen').addEventListener('click', drawImages);
  $('shSave').addEventListener('click', () => saveImages(false));

  // ── C) platform cards ──
  function drawCards() {
    $('shCards').replaceChildren(...hub.platforms.map((pl: any) => {
      const ta = el('textarea', { 'aria-label': `${pl.name} caption` }); ta.value = pl.caption;
      const counter = el('p', { class: 'sh-count' });
      const intentA = el('a', { target: '_blank', rel: 'noopener', text: 'Open post window', hidden: !intent(pl.key, '', pl.shareUrl) });
      const upd = () => {
        const n = countFor(pl.key, ta.value), over = n > pl.limit;
        counter.textContent = `${n} / ${pl.limit}${pl.key === 'twitter' ? ' (links count as 23)' : ''}`; counter.classList.toggle('over', over);
        const u = intent(pl.key, ta.value, pl.shareUrl); if (u) intentA.href = u;
      };
      let t: any;
      ta.addEventListener('input', () => { upd(); clearTimeout(t); t = setTimeout(async () => { try { await api(`/api/admin/programmes/${id}/share/captions`, 'PUT', { platformKey: pl.key, caption: ta.value }); } catch (e: any) { msg(e.message, false); } }, 800); });
      upd();
      const last = pl.lastPost;
      const lastTxt = !last ? 'Not posted yet' : last.status === 'failed' ? `Auto-post failed ${ago(last.at)}` : `${last.status === 'marked' ? 'Posted' : 'Auto-posted'} by ${last.staff ? last.staff.split('@')[0] : 'the scheduler'}, ${ago(last.at)}`;
      const kind = IMAGE_FOR[pl.key] || 'card';
      const isBio = ['instagram', 'tiktok'].includes(pl.key);
      return el('article', { class: 'sh-card', 'aria-label': pl.name },
        el('div', { class: 'sh-card-h' }, el('b', { text: pl.name }),
          pl.profileUrl ? el('a', { href: pl.profileUrl, target: '_blank', rel: 'noopener', text: 'Profile ↗' }) : null,
          el('span', { class: `sh-last ${last ? (last.status === 'failed' ? 'bad' : 'ok') : ''}`, text: lastTxt })),
        ta, counter,
        el('div', { class: 'sh-link' }, el('span', { text: pl.shareUrl }), el('button', { type: 'button', text: 'Copy', onclick: () => copy(pl.shareUrl, 'Link copied.') })),
        isBio ? el('p', { class: 'sh-hint', text: `${pl.name === 'Instagram' ? 'Instagram captions' : `${pl.name} captions`} can't hold clickable links. Use link in bio: ${pl.bioUrl}${pl.key === 'instagram' ? ' or a Story link sticker.' : '.'}` }) : null,
        isBio ? el('div', { class: 'sh-link' }, el('span', { text: pl.bioUrl }), el('button', { type: 'button', text: 'Copy', onclick: () => copy(pl.bioUrl, 'Bio link copied.') })) : null,
        el('div', { class: 'sh-btns' },
          el('button', { type: 'button', class: 'pri', text: 'Copy caption', onclick: () => copy(ta.value.includes(pl.shareUrl) || isBio ? ta.value : `${ta.value}\n${pl.shareUrl}`, 'Caption copied.') }),
          intentA,
          el('button', { type: 'button', text: `Download ${kind === 'card' ? 'link card' : kind} image`, onclick: () => download(kind) }),
          el('button', { type: 'button', text: 'Share from my phone', onclick: () => phoneShare(pl, ta.value, kind) }),
          el('button', { type: 'button', text: 'Mark as posted', onclick: () => mark(pl) })),
        el('details', {}, el('summary', { text: 'Tips' }), el('ul', {}, ...(TIPS[pl.key] || []).map(x => el('li', { text: x })))),
        el('div', { class: 'sh-stats' }, ...[['visits', 'Visits'], ['signedIn', 'Signed in'], ['downloads', 'Downloads'], ['newFans', 'New fans']].map(([k, l]) => el('div', {}, el('b', { text: String(pl.stats[k]) }), el('span', { text: l })))));
    }));
  }
  function download(kind: string) {
    const b = blobs[kind]; if (!b) { msg('Upload the PDF first so the images can be made.', false); return; }
    const a = el('a', { href: URL.createObjectURL(b), download: `lobi-stars-programme-${hub.programme.slug}-${kind}.jpg` }); document.body.append(a); a.click(); a.remove();
  }
  async function phoneShare(pl: any, caption: string, kind: string) {
    try {
      const text = caption.includes(pl.shareUrl) ? caption : `${caption}\n${pl.shareUrl}`;
      const file = blobs[kind] ? new File([blobs[kind]], `lobi-stars-programme-${kind}.jpg`, { type: 'image/jpeg' }) : null;
      if (file && navigator.canShare && navigator.canShare({ files: [file] })) await navigator.share({ files: [file], text, title: hub.programme.title });
      else if (navigator.share) await navigator.share({ title: hub.programme.title, text: caption, url: pl.shareUrl });
      else { await copy(text, 'This browser cannot share; the caption and link were copied.'); }
    } catch (e: any) { if (e?.name !== 'AbortError') msg(e.message || 'Could not share.', false); }
  }
  async function mark(pl: any) {
    try { await api(`/api/admin/programmes/${id}/share/mark`, 'POST', { platformKey: pl.key }); msg(`Marked as posted on ${pl.name}.`); await refresh(); }
    catch (e: any) { msg(e.message, false); }
  }
  async function refresh() { hub = await api(`/api/admin/programmes/${id}/share`); drawCards(); drawHistory(); drawAuto(); drawSchedule(); }

  // ── D) auto-post ──
  function drawAuto() {
    const autos = hub.platforms.filter((p: any) => p.autoCapable);
    $('shAuto').replaceChildren(...(autos.length ? autos.map((p: any) => el('label', { class: 'sh-auto' },
      el('input', { type: 'checkbox', value: p.key, disabled: !p.configured, checked: p.configured }),
      el('span', {}, el('b', { text: p.name }), ' ', el('small', { text: p.configured ? 'ready' : 'Set up auto-posting first: DEPLOYMENT.md › Share Hub (until then use Copy caption / Open post window).' })))) : [el('p', { class: 'sh-note', text: 'Telegram and Facebook are switched off in the platform settings.' })]));
    $('shPostNow').disabled = !autos.some((p: any) => p.configured);
  }
  const chosen = () => [...$('shAuto').querySelectorAll('input:checked')].map((i: any) => i.value);
  $('shPostNow').addEventListener('click', () => {
    const keys = chosen(); if (!keys.length) { msg('Tick at least one platform.', false); return; }
    $('shConfImg').src = blobs.card ? URL.createObjectURL(blobs.card) : hub.cardUrl;
    $('shConfList').replaceChildren(...keys.map(k => {
      const p = hub.platforms.find((x: any) => x.key === k);
      const posted = p.lastPost && p.lastPost.status !== 'failed';
      return el('div', {}, el('h3', { text: p.name }), posted ? el('p', { class: 'sh-warnline', text: `Already posted on ${p.name} ${ago(p.lastPost.at)}. Posting again makes a second post.` }) : null, el('pre', { text: p.caption }));
    }));
    $('shConfirm').showModal();
  });
  $('shConfNo').addEventListener('click', () => $('shConfirm').close());
  $('shConfYes').addEventListener('click', async () => { $('shConfirm').close(); await postNow(chosen()); });
  async function postNow(keys: string[]) {
    try {
      $('shPostNow').disabled = true;
      const d = await api(`/api/admin/programmes/${id}/share/post`, 'POST', { platforms: keys });
      showResults(d.results);
      await refresh();
    } catch (e: any) { msg(e.message, false); }
    finally { $('shPostNow').disabled = false; }
  }
  function showResults(results: any[]) {
    $('shResults').replaceChildren(...results.map(r => {
      const name = hub.platforms.find((x: any) => x.key === r.platform)?.name || r.platform;
      return r.ok
        ? el('p', { class: 'sh-res ok' }, `${name}: posted. `, r.externalUrl ? el('a', { href: r.externalUrl, target: '_blank', rel: 'noopener', text: 'Open the post ↗' }) : '')
        : el('p', { class: 'sh-res bad' }, `${name}: ${r.error} `, el('button', { type: 'button', class: 'btn-o sm', text: 'Retry', onclick: () => postNow([r.platform]) }));
    }));
  }
  function drawSchedule() {
    const s = hub.schedule;
    $('shSchedNow').textContent = s.at ? `Scheduled: ${s.platforms.join(' and ')} at ${watLong(s.at)} (WAT)${s.done ? ' (done)' : ''}.` : 'No scheduled post.';
    if (s.at) $('shAt').value = isoToWat(s.at);
    const failed = hub.history.filter((h: any) => h.status === 'failed' && !h.staff_email).slice(0, 3);
    if (failed.length && !$('shResults').children.length) showResults(failed.map((h: any) => ({ platform: h.platform_key, ok: false, error: `Scheduled post failed: ${h.error}` })));
  }
  $('shAtLive').addEventListener('click', () => { const p = hub.programme; $('shAt').value = isoToWat(hub.state === 'upcoming' && p.publishAt ? p.publishAt : new Date(Date.now() + 5 * 60000).toISOString()); });
  $('shAtHour').addEventListener('click', () => { $('shAt').value = isoToWat(new Date(Date.now() + 3600e3).toISOString()); });
  $('shSchedSave').addEventListener('click', async () => {
    try {
      const keys = chosen(); if (!$('shAt').value) { msg('Choose a date and time.', false); return; }
      await api(`/api/admin/programmes/${id}/share/schedule`, 'PUT', { at: watToIso($('shAt').value), platforms: keys });
      msg('Scheduled. The cron Worker posts it at that time.'); await refresh();
    } catch (e: any) { msg(e.message, false); }
  });
  $('shSchedClear').addEventListener('click', async () => {
    try { await api(`/api/admin/programmes/${id}/share/schedule`, 'PUT', { at: null }); $('shAt').value = ''; msg('Schedule cleared.'); await refresh(); } catch (e: any) { msg(e.message, false); }
  });

  // ── F) history ──
  function drawHistory() {
    const names = Object.fromEntries(hub.platforms.map((p: any) => [p.key, p.name]));
    $('shHist').replaceChildren(...(hub.history.length ? hub.history.map((h: any) => el('li', {},
      el('span', { text: `${names[h.platform_key] || h.platform_key}: ${h.status === 'marked' ? 'posted by hand' : h.status}${h.error ? ` (${h.error})` : ''}` }),
      el('span', {}, `${h.staff_email ? h.staff_email.split('@')[0] : 'scheduler'}, ${ago(h.created_at)} `, h.external_url ? el('a', { href: h.external_url, target: '_blank', rel: 'noopener', text: 'open' }) : ''))) : [el('li', { text: 'Nothing posted yet.' })]));
  }

  // ── G) platform settings ──
  $('shSettings').addEventListener('click', async () => {
    try {
      const d = await api('/api/admin/share/platforms');
      $('shSetList').replaceChildren(...d.platforms.map((p: any) => {
        const f: any = {};
        const inp = (k: string, label: string, val: string, ta = false) => { f[k] = el(ta ? 'textarea' : 'input', {}); f[k].value = val ?? ''; return el('label', { class: 'sh-lbl' }, label, f[k]); };
        const en = el('input', { type: 'checkbox' }); en.checked = !!p.is_enabled;
        return el('div', { class: 'sh-plat' },
          el('div', { class: 'sh-sec-h' }, el('b', { text: `${p.name} (code ${p.campaign_code}, ${p.effectiveMode})` }), el('label', { class: 'sh-auto' }, en, 'Show in Share Hub')),
          inp('profile_url', 'Profile link (https://…)', p.profile_url || ''),
          inp('hashtags', 'Hashtags', p.hashtags || ''),
          inp('sort_order', 'Order', String(p.sort_order)),
          inp('caption_live', 'Caption when live', p.caption_live, true),
          inp('caption_upcoming', 'Caption before it drops', p.caption_upcoming, true),
          el('div', { class: 'sh-row' }, el('button', { type: 'button', class: 'btn-p sm', text: 'Save', onclick: async () => {
            try {
              await api('/api/admin/share/platforms', 'PATCH', { key: p.key, profile_url: f.profile_url.value, hashtags: f.hashtags.value, sort_order: Number(f.sort_order.value), caption_live: f.caption_live.value, caption_upcoming: f.caption_upcoming.value, is_enabled: en.checked });
              msg(`${p.name} saved.`); if (id) await refresh();
            } catch (e: any) { alert(e.message); }
          } })));
      }));
      $('shSet').showModal();
    } catch (e: any) { msg(e.message, false); }
  });
  $('shSetX').addEventListener('click', () => $('shSet').close());
</script>
