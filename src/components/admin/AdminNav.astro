---
// The admin shell: a left sidebar grouped into colour-coded categories
// (collapsible on desktop, a slide-out menu on phones) and a top bar with the
// breadcrumb, admin search, notifications and who is signed in.
// The sidebar only shows what the signed-in person's role can open (the
// server enforces the same rules: functions/api/_lib/adminRoles.js).
// Pages keep including it the same way: <AdminNav current="fans" />.
interface Props { current?: string }
const { current = '' } = Astro.props;

type Item = { id: string; label: string; href: string; area: string; ext?: boolean; hint?: string };
type Cat = { id: string; icon: string; label: string; color: string; items: Item[] };
const CMS = '/admin/#/collections';
const CATEGORIES: Cat[] = [
  { id: 'overview', icon: '🏠', label: 'Overview', color: '#E31E24', items: [
    { id: 'dashboard', label: 'Dashboard', href: '/admin/dashboard/', area: 'overview' },
  ] },
  { id: 'matchday', icon: '⚽', label: 'Matchday', color: '#10B981', items: [
    { id: 'matches', label: 'Fixtures & Results', href: '/admin/matches/', area: 'matchday' },
    { id: 'match-centre', label: 'Live Match Control', href: '/admin/match-centre/', area: 'matchday-content', hint: 'Kick-off, score, squad, Man of the Match, stats, streams, content checklist' },
    { id: 'predictions', label: 'Predict & Win', href: '/admin/predictions/', area: 'matchday', hint: 'Entries, winners and prize payments' },
    { id: 'commentary', label: 'Live Commentary', href: '/admin/commentary/', area: 'matchday' },
    { id: 'cms-table', label: 'League Table', href: `${CMS}/settings/entries/leagueTable`, area: 'cms', ext: true },
  ] },
  { id: 'content', icon: '📰', label: 'Content', color: '#0EA5E9', items: [
    { id: 'news', label: 'News & Articles', href: '/admin/news/', area: 'content', hint: 'Including Team News' },
    { id: 'awards', label: 'Fan Awards', href: '/admin/awards/', area: 'content', hint: 'Goal / Player of the Month, Player of the Season' },
    { id: 'cms-players', label: 'Squad & Players', href: `${CMS}/players`, area: 'cms', ext: true },
    { id: 'cms-videos', label: 'Videos', href: `${CMS}/settings/entries/videos`, area: 'cms', ext: true },
    { id: 'cms-gallery', label: 'Gallery', href: `${CMS}/gallery`, area: 'cms', ext: true },
    { id: 'cms-club', label: 'Club Pages', href: `${CMS}/settings/entries/history`, area: 'cms', ext: true, hint: 'History, Honours, Stadium, Fan Clubs' },
    { id: 'cms', label: 'Content CMS (everything)', href: '/admin/', area: 'cms', ext: true },
  ] },
  { id: 'fans', icon: '👥', label: 'Fans & Inbox', color: '#8B5CF6', items: [
    { id: 'inbox', label: 'Inbox', href: '/admin/inbox/', area: 'inbox', hint: 'Read and reply to contact, sponsorship and hospitality messages' },
    { id: 'newsletter', label: 'Newsletter', href: '/admin/newsletter/', area: 'fans', hint: 'Write and send the weekly newsletter' },
    { id: 'fans', label: 'Fan Database', href: '/admin/fans/', area: 'fans' },
    { id: 'fans-newsletter', label: 'Newsletter Subscribers', href: '/admin/fans/?source=newsletter', area: 'fans' },
    { id: 'fans-accounts', label: 'Fan Accounts', href: '/admin/fans/?source=fan_account', area: 'fans' },
    { id: 'contact-sources-f', label: 'Contact Sources & Downloads', href: '/admin/contact-sources/', area: 'fans' },
    { id: 'fans-duplicates', label: 'Possible Duplicates', href: '/admin/fans/duplicates/', area: 'fans' },
    { id: 'members', label: 'Members', href: '/admin/members/', area: 'fans' },
  ] },
  { id: 'commerce', icon: '🛒', label: 'Commerce', color: '#F97316', items: [
    { id: 'scan', label: 'Ticket Scanner', href: '/scan/', area: 'commerce', ext: true },
    { id: 'food-live', label: 'Food: Live Order Board', href: '/admin/food-orders/live/', area: 'commerce', hint: 'Kitchen and runners on matchday' },
    { id: 'food-orders', label: 'Food: Orders', href: '/admin/food-orders/', area: 'commerce' },
    { id: 'food-analytics', label: 'Food: Analytics', href: '/admin/food-orders/analytics/', area: 'commerce' },
    { id: 'food-menu', label: 'Food: Menu & Prices', href: '/admin/food-orders/menu/', area: 'commerce', hint: 'Add items, prices, photos, sold out' },
    { id: 'shirt-orders', label: 'Shirt Personalisation Orders', href: '/admin/shirt-orders/', area: 'commerce' },
    { id: 'cms-shop', label: 'Shop Products', href: `${CMS}/settings/entries/shop`, area: 'cms', ext: true },
    { id: 'cms-hospitality', label: 'Hospitality Packages', href: `${CMS}/settings/entries/hospitality`, area: 'cms', ext: true },
    { id: 'cms-membership', label: 'Membership Settings', href: `${CMS}/settings/entries/membership`, area: 'cms', ext: true },
  ] },
  { id: 'partners', icon: '🤝', label: 'Partners', color: '#14B8A6', items: [
    { id: 'partners', label: 'Partners & Open Categories', href: '/admin/partners/', area: 'partners' },
    { id: 'inbox-sponsorship', label: 'Sponsorship Enquiries', href: '/admin/inbox/?source=sponsorship', area: 'inbox' },
    { id: 'newsletter-sponsors', label: 'Newsletter Sponsor Adverts', href: '/admin/newsletter/?tab=sponsors', area: 'partners', hint: 'Sponsor logos, links and adverts in the newsletter' },
    { id: 'analytics-partners', label: 'Partner Reports', href: '/admin/analytics/#sec-partners', area: 'analytics' },
    { id: 'cms-partners', label: 'Partner Profiles', href: `${CMS}/partners`, area: 'cms', ext: true },
  ] },
  { id: 'analytics', icon: '📊', label: 'Analytics', color: '#EC4899', items: [
    { id: 'analytics', label: 'Traffic & Engagement', href: '/admin/analytics/', area: 'analytics' },
    { id: 'contact-sources', label: 'Contact Sources', href: '/admin/contact-sources/', area: 'analytics' },
    { id: 'analytics-matchday', label: 'Matchday Analytics', href: '/admin/analytics/#sec-matchday', area: 'analytics' },
    { id: 'analytics-commentary', label: 'Commentary / Broadcast Report', href: '/admin/analytics/#sec-commentary', area: 'analytics' },
    { id: 'food-analytics-a', label: 'Food Analytics', href: '/admin/food-orders/analytics/', area: 'analytics' },
  ] },
  { id: 'settings', icon: '⚙️', label: 'Settings', color: '#64748B', items: [
    { id: 'cms-site', label: 'Site Settings & Social Links', href: `${CMS}/settings/entries/site`, area: 'cms', ext: true },
    { id: 'cms-promo', label: 'Promo Bar', href: `${CMS}/settings/entries/promo`, area: 'cms', ext: true },
    { id: 'commentary-settings', label: 'Commentary & Stream Settings', href: '/admin/commentary/', area: 'matchday' },
    { id: 'staff', label: 'Staff Users & Roles', href: '/admin/staff/', area: 'staff' },
    { id: 'inbox-settings', label: 'Inbox Emails & Templates', href: '/admin/inbox/?settings=1', area: 'inbox', hint: 'New-message alerts, daily summary, saved replies' },
    { id: 'export-log', label: 'Export Log', href: '/admin/fans/#exportLog', area: 'fans' },
    { id: 'activity', label: 'Activity Log', href: '/admin/activity/', area: 'settings' },
  ] },
];
const active = CATEGORIES.flatMap(c => c.items.map(i => ({ c, i }))).find(x => x.i.id === current);
const crumbs = active ? [active.c.label, active.i.label] : ['Admin'];
---
<script is:inline>
  // Apply the last theme straight away (no flash); the signed-in person's own choice is applied once known.
  try { if (localStorage.getItem('ls_admin_theme_last') === 'dark') document.body.classList.add('admin-dark'); } catch (e) {}
</script>
<div class="ash" data-current={current}>
  <aside class="ash-side" id="ashSide" aria-label="Admin menu">
    <div class="ash-brand">
      <a href="/admin/dashboard/" class="ash-logo"><img src="/images/lobi-stars-badge.png" alt="" width="34" height="34" /><span><b>Lobi Stars</b><small>Admin</small></span></a>
      <button type="button" class="ash-collapse" id="ashCollapse" aria-label="Collapse menu" title="Collapse menu">&laquo;</button>
    </div>
    <nav class="ash-nav">
      {CATEGORIES.map(c => (
        <section class="ash-cat" data-cat={c.id} style={`--cat:${c.color}`} hidden>
          <h2 class="ash-cat-h"><span class="ash-ico" aria-hidden="true">{c.icon}</span><span class="ash-cat-t">{c.label}</span></h2>
          <ul>
            {c.items.map(i => (
              <li data-area={i.area} hidden>
                <a href={i.href} aria-current={i.id === current ? 'page' : undefined} title={i.hint || i.label} target={i.ext && i.href.startsWith('/scan') ? '_blank' : undefined}>
                  <span class="ash-dot" aria-hidden="true"></span><span class="ash-lbl">{i.label}</span>{i.ext && <span class="ash-ext" aria-label="(opens the CMS or another tool)">↗</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </nav>
    <a href="/" class="ash-site">&larr; <span class="ash-lbl">Back to the website</span></a>
  </aside>
  <div class="ash-ov" id="ashOv" hidden></div>

  <header class="ash-top">
    <button type="button" class="ash-burger" id="ashBurger" aria-label="Open admin menu" aria-controls="ashSide" aria-expanded="false">☰</button>
    <nav class="ash-crumb" aria-label="Breadcrumb">{crumbs.map((c, i) => <><span aria-current={i === crumbs.length - 1 ? 'page' : undefined}>{c}</span>{i < crumbs.length - 1 && <span class="ash-sep" aria-hidden="true">›</span>}</>)}</nav>
    <form class="ash-search" id="ashSearch" role="search">
      <label class="sr-only" for="ashQ">Search the admin</label>
      <input id="ashQ" type="search" placeholder="Search fans, matches, news…" autocomplete="off" />
      <div class="ash-results" id="ashResults" hidden></div>
    </form>
    <div class="ash-bell-wrap">
      <button type="button" class="ash-bell" id="ashBell" aria-label="Notifications" aria-expanded="false">🔔<span class="ash-badge" id="ashBadge" hidden></span></button>
      <div class="ash-notes" id="ashNotes" hidden><p class="ash-empty">No new notifications.</p></div>
    </div>
    <div class="ash-user"><span class="ash-name" id="ashName"></span><span class="ash-role" id="ashRole"></span></div>
    <button type="button" class="ash-theme" id="ashMute" aria-label="Mute food order sounds" title="Food order sounds on/off" hidden>🔊</button>
    <button type="button" class="ash-theme" id="ashTheme" aria-label="Switch to dark mode" title="Dark / light mode">🌙</button>
    <button type="button" class="ash-out" id="anOut">Log out</button>
  </header>
</div>

<div class="ash-toasts" id="ashToasts" aria-live="assertive"></div>

<style is:global>
  .ash-toasts { position: fixed; right: 16px; bottom: 16px; z-index: 2000; display: flex; flex-direction: column; gap: 10px; width: min(380px, calc(100vw - 32px)); }
  .ash-toast { display: block; padding: 14px 16px; border-radius: 14px; color: #fff; text-decoration: none; box-shadow: 0 18px 40px rgba(0,0,0,.3); animation: ashin .25s ease-out; border: 2px solid rgba(255,255,255,.25); }
  .ash-toast b { display: block; font: 700 15px/1.3 'Barlow', sans-serif; margin-bottom: 3px; }
  .ash-toast span { font-size: 14px; opacity: .95; }
  .ash-toast.paid { background: linear-gradient(135deg, #15803D, #16A34A); }
  .ash-toast.unpaid { background: linear-gradient(135deg, #B45309, #F59E0B); }
  .ash-toast.whatsapp { background: linear-gradient(135deg, #128C7E, #25D366); }
  .ash-toast.test { background: linear-gradient(135deg, #1E40AF, #3B82F6); }
  @keyframes ashin { from { transform: translateY(12px); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .ash-toast { animation: none; } }
  .ash-notes .ash-food { border-left: 4px solid var(--k, #16A34A); }
  /* ── Design tokens ── */
  body.admin-body {
    --a-red: #E31E24; --a-gold: #EAB308; --a-emerald: #10B981; --a-sky: #0EA5E9; --a-purple: #8B5CF6;
    --a-orange: #F97316; --a-teal: #14B8A6; --a-pink: #EC4899; --a-slate: #64748B;
    --a-bg: #F5F6F8; --a-card: #FFFFFF; --a-soft: #F8FAFC; --a-zebra: #FAFBFC; --a-hover: #FFF8E1;
    --a-ink: #15181D; --a-muted: #5B6472; --a-line: #E3E6EA; --a-head: #15181D; --a-head-ink: #FFFFFF;
    color-scheme: light;
  }
  body.admin-body.admin-dark {
    --a-bg: #0F1216; --a-card: #1A1E24; --a-soft: #20252C; --a-zebra: #1E232A; --a-hover: #2A2416;
    --a-ink: #E8EAED; --a-muted: #A0A8B3; --a-line: #2E343C; --a-head: #252B33; --a-head-ink: #FFFFFF;
    /* the public site's variables, used by the existing admin pages */
    --black: #0F1216; --dark: #171B20; --d2: #1A1E24; --d3: #232931; --d4: #2E343C; --white: #E8EAED; --lt: #A0A8B3;
    --red-text: #FF6B6F; --gold-text: #F2C14E;
    color-scheme: dark;
  }
  body.admin-body { background: var(--a-bg); color: var(--a-ink); }
  body.admin-dark .ash-top, body.admin-dark .ash-bell, body.admin-dark .ash-out, body.admin-dark .ash-theme, body.admin-dark .ash-burger, body.admin-dark .ash-results, body.admin-dark .ash-notes { background: var(--a-card); color: var(--a-ink); border-color: var(--a-line); }
  body.admin-dark .ash-search input { background: var(--a-soft); color: var(--a-ink); border-color: var(--a-line); }
  body.admin-dark .ash-results a:hover, body.admin-dark .ash-notes a:hover { background: var(--a-soft); }
  body.admin-dark .stitle, body.admin-dark h1, body.admin-dark h2, body.admin-dark h3 { color: var(--a-ink); }
  body.admin-dark .muted { color: var(--a-muted); }
  body.admin-dark .btn-o { color: var(--a-ink); border-color: var(--a-line); }
  body.admin-dark input, body.admin-dark select, body.admin-dark textarea { background: var(--a-soft); color: var(--a-ink); border-color: var(--a-line); }
  .ash-theme { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--d4); background: #fff; cursor: pointer; font-size: 17px; flex-shrink: 0; }

  /* ── Tables: zebra rows, sticky headers, hover ── */
  body.admin-body .admin-main table { border-collapse: separate; border-spacing: 0; }
  body.admin-body .admin-main .scroll { max-height: 72vh; overflow: auto; border-radius: 12px; }
  body.admin-body .admin-main thead th { position: sticky; top: 0; z-index: 2; background: var(--a-head) !important; color: var(--a-head-ink) !important; }
  body.admin-body .admin-main thead th button { color: inherit; background: none; border: 0; font: inherit; cursor: pointer; letter-spacing: inherit; text-transform: inherit; padding: 0; }
  body.admin-body .admin-main tbody tr:nth-child(even) td { background: var(--a-zebra); }
  body.admin-body .admin-main tbody tr:hover td { background: var(--a-hover); }
  body.admin-body .admin-main td { border-bottom-color: var(--a-line) !important; }

  /* ── Coloured status badges (.badge or the existing .tag) ── */
  .badge, body.admin-body .admin-main .tag { display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: 999px; font: 700 12px/1.3 'Barlow', sans-serif; white-space: nowrap; background: color-mix(in srgb, var(--b, #64748B) 16%, var(--a-card)); color: color-mix(in srgb, var(--b, #64748B) 75%, var(--a-ink)); border: 1px solid color-mix(in srgb, var(--b, #64748B) 30%, transparent); }
  .badge.new, .tag.new { --b: #E31E24; } .badge.open, .tag.open, .tag.warn { --b: #F59E0B; } .badge.replied, .tag.replied { --b: #0EA5E9; }
  .badge.closed, .tag.closed, .tag.ok, .badge.ok { --b: #10B981; } .tag.win, .badge.win { --b: #EAB308; } .tag.bad, .badge.bad { --b: #E31E24; }

  /* ── Friendly empty states ── */
  .empty-state { text-align: center; padding: 34px 16px; color: var(--a-muted); border: 1px dashed var(--a-line); border-radius: 14px; background: var(--a-card); }
  .empty-state b { display: block; font-size: 36px; margin-bottom: 8px; }
  .empty-state p { margin: 0 0 12px; font-size: 15px; }
  .empty-state a, .empty-state button { display: inline-block; padding: 9px 16px; border-radius: 999px; background: var(--a-red); color: #fff; text-decoration: none; font-weight: 700; border: 0; cursor: pointer; }

  /* ── Long-table filter and pages (added automatically) ── */
  .tbl-tools { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin: 0 0 10px; }
  .tbl-tools input { flex: 1 1 220px; max-width: 360px; padding: 8px 12px; border-radius: 999px; border: 1px solid var(--a-line); background: var(--a-card); color: var(--a-ink); font: 14px 'Barlow', sans-serif; }
  .tbl-tools span { color: var(--a-muted); font-size: 13px; }
  .tbl-pager { display: flex; gap: 6px; align-items: center; justify-content: flex-end; flex-wrap: wrap; margin: 10px 0 0; }
  .tbl-pager button { min-width: 36px; height: 36px; padding: 0 10px; border-radius: 10px; border: 1px solid var(--a-line); background: var(--a-card); color: var(--a-ink); cursor: pointer; font-weight: 700; }
  .tbl-pager button[aria-current='page'] { background: var(--a-red); border-color: var(--a-red); color: #fff; }
  .tbl-pager button:disabled { opacity: .45; cursor: default; }

  /* ── Cards and panels use the tokens ── */
  body.admin-body .admin-main .panel { background: var(--a-card); border-color: var(--a-line); box-shadow: 0 8px 26px rgba(15,17,21,.05); border-radius: 16px; }
  body.admin-body .stag { color: var(--a-red); }
  body.admin-body main#main { padding-top: 0; }
  body.admin-body { --side: 260px; --top: 60px; padding-left: var(--side); padding-top: var(--top); background: var(--a-bg); }
  body.admin-body.ash-collapsed { --side: 72px; }
  .ash-side { position: fixed; top: 0; left: 0; bottom: 0; width: var(--side); background: #15181D; color: #fff; z-index: 1300; display: flex; flex-direction: column; transition: width .2s, transform .25s; overflow: hidden; }
  .ash-brand { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 12px 12px 16px; height: var(--top); border-bottom: 1px solid rgba(255,255,255,.08); flex-shrink: 0; }
  .ash-logo { display: flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; min-width: 0; }
  .ash-logo img { border-radius: 50%; background: #fff; flex-shrink: 0; padding: 3px; object-fit: contain; }
  .ash-logo b { display: block; font: 400 20px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .ash-logo small { display: block; font: 700 10px/1.2 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; color: #FFC72C; }
  .ash-collapse { background: rgba(255,255,255,.08); border: 0; color: #fff; width: 30px; height: 30px; border-radius: 8px; cursor: pointer; font-size: 16px; flex-shrink: 0; }
  .ash-nav { flex: 1; overflow-y: auto; padding: 8px 0 16px; scrollbar-width: thin; }
  .ash-cat { padding: 6px 10px; }
  .ash-cat-h { display: flex; align-items: center; gap: 10px; margin: 8px 6px 4px; font: 700 12px/1 'Barlow Condensed', sans-serif; letter-spacing: 1.6px; text-transform: uppercase; color: rgba(255,255,255,.6); white-space: nowrap; }
  .ash-ico { width: 30px; height: 30px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--cat) 22%, transparent); font-size: 15px; flex-shrink: 0; }
  .ash-cat ul { list-style: none; margin: 0; padding: 0; }
  .ash-cat a { display: flex; align-items: center; gap: 10px; padding: 8px 10px 8px 14px; margin: 1px 0; border-radius: 9px; color: rgba(255,255,255,.82); text-decoration: none; font: 600 14px/1.25 'Barlow', sans-serif; white-space: nowrap; }
  .ash-cat a:hover { background: rgba(255,255,255,.07); color: #fff; }
  .ash-cat a[aria-current='page'] { background: color-mix(in srgb, var(--cat) 26%, transparent); color: #fff; box-shadow: inset 3px 0 0 var(--cat); }
  .ash-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--cat); flex-shrink: 0; opacity: .85; }
  .ash-lbl { overflow: hidden; text-overflow: ellipsis; }
  .ash-ext { margin-left: auto; opacity: .5; font-size: 12px; }
  .ash-site { display: block; padding: 14px 18px; color: #FFC72C; text-decoration: none; font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; border-top: 1px solid rgba(255,255,255,.08); white-space: nowrap; }
  body.ash-collapsed .ash-lbl, body.ash-collapsed .ash-cat-t, body.ash-collapsed .ash-logo span, body.ash-collapsed .ash-ext, body.ash-collapsed .ash-dot { display: none; }
  body.ash-collapsed .ash-cat a { justify-content: center; padding: 8px 0; }
  body.ash-collapsed .ash-cat-h { justify-content: center; margin: 8px 0 2px; }
  body.ash-collapsed .ash-cat ul { display: none; }
  body.ash-collapsed .ash-cat:hover ul, body.ash-collapsed .ash-cat:focus-within ul { display: block; position: fixed; left: var(--side); background: #15181D; padding: 8px; border-radius: 0 10px 10px 0; min-width: 240px; box-shadow: 8px 8px 30px rgba(0,0,0,.3); }
  body.ash-collapsed .ash-cat:hover .ash-lbl, body.ash-collapsed .ash-cat:focus-within .ash-lbl, body.ash-collapsed .ash-cat:hover .ash-dot, body.ash-collapsed .ash-cat:focus-within .ash-dot { display: inline; }
  body.ash-collapsed .ash-cat:hover a, body.ash-collapsed .ash-cat:focus-within a { justify-content: flex-start; padding: 8px 12px; }
  body.ash-collapsed .ash-collapse { transform: rotate(180deg); }

  .ash-top { position: fixed; top: 0; left: var(--side); right: 0; height: var(--top); z-index: 1250; display: flex; align-items: center; gap: 12px; padding: 0 18px; background: #fff; border-bottom: 1px solid var(--d4); transition: left .2s; }
  .ash-burger { display: none; width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--d4); background: #fff; font-size: 18px; cursor: pointer; flex-shrink: 0; }
  .ash-crumb { display: flex; align-items: center; gap: 8px; min-width: 0; font: 700 14px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: var(--lt); white-space: nowrap; overflow: hidden; }
  .ash-crumb [aria-current='page'] { color: var(--white); overflow: hidden; text-overflow: ellipsis; }
  .ash-sep { color: var(--d4); }
  .ash-search { position: relative; margin-left: auto; flex: 0 1 320px; min-width: 0; }
  .ash-search input { width: 100%; padding: 9px 14px; border-radius: 999px; border: 1px solid var(--d4); background: #F5F6F8; font: 15px 'Barlow', sans-serif; }
  .ash-search input:focus { outline: none; border-color: var(--red); background: #fff; box-shadow: 0 0 0 3px rgba(227,30,36,.12); }
  .ash-results, .ash-notes { position: absolute; top: calc(100% + 8px); right: 0; width: min(420px, 92vw); max-height: 70vh; overflow-y: auto; background: #fff; border: 1px solid var(--d4); border-radius: 12px; box-shadow: 0 18px 40px rgba(15,17,21,.15); padding: 6px; z-index: 1400; }
  .ash-results a, .ash-notes a { display: block; padding: 9px 10px; border-radius: 8px; color: var(--white); text-decoration: none; font-size: 14px; line-height: 1.35; }
  .ash-results a:hover, .ash-notes a:hover, .ash-results a:focus { background: #F5F6F8; outline: none; }
  .ash-results small, .ash-notes small { display: block; color: var(--lt); font-size: 12px; }
  .ash-rtype { display: inline-block; font: 700 10px/1 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; padding: 3px 6px; border-radius: 4px; margin-right: 6px; color: #fff; vertical-align: 1px; }
  .ash-empty { margin: 0; padding: 12px; color: var(--lt); font-size: 14px; }
  .ash-bell-wrap { position: relative; }
  .ash-bell { position: relative; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--d4); background: #fff; cursor: pointer; font-size: 17px; }
  .ash-badge { position: absolute; top: -4px; right: -4px; min-width: 19px; height: 19px; padding: 0 5px; border-radius: 999px; background: var(--red); color: #fff; font: 700 11px/19px 'Barlow', sans-serif; }
  .ash-user { display: flex; flex-direction: column; line-height: 1.2; text-align: right; min-width: 0; }
  .ash-name { font-weight: 700; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 180px; }
  .ash-role { font-size: 12px; color: var(--lt); white-space: nowrap; }
  .ash-out { border: 1px solid var(--d4); background: #fff; border-radius: 8px; padding: 7px 12px; cursor: pointer; font: 600 13px 'Barlow', sans-serif; white-space: nowrap; }
  .ash-denied { margin: 0 0 18px; padding: 12px 16px; border-radius: 10px; background: #FFF4E5; color: #7A4B00; }

  @media (max-width: 1023px) {
    body.admin-body, body.admin-body.ash-collapsed { --side: 0px; }
    .ash-side { width: 280px; transform: translateX(-100%); }
    body.ash-open .ash-side { transform: none; }
    body.ash-collapsed .ash-lbl, body.ash-collapsed .ash-cat-t, body.ash-collapsed .ash-logo span, body.ash-collapsed .ash-ext, body.ash-collapsed .ash-dot { display: inline; }
    body.ash-collapsed .ash-cat ul { display: block; position: static; box-shadow: none; padding: 0; min-width: 0; }
    body.ash-collapsed .ash-cat a { justify-content: flex-start; padding: 8px 10px 8px 14px; }
    .ash-collapse { display: none; }
    .ash-ov { position: fixed; inset: 0; background: rgba(15,17,21,.5); z-index: 1290; }
    .ash-burger { display: inline-flex; align-items: center; justify-content: center; }
    .ash-user { display: none; }
  }
  @media (max-width: 640px) {
    .ash-top { gap: 8px; padding: 0 10px; }
    .ash-crumb span:not([aria-current]) { display: none; }
    .ash-search { flex: 1 1 auto; }
    .ash-search input { padding: 8px 12px; font-size: 14px; }
    .ash-out { padding: 7px 9px; }
  }
</style>

<script>
  const w = window as any;
  const code = sessionStorage.getItem('ls_admin_code') || '__session__';
  const H = { 'x-admin-code': code };
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  document.body.classList.add('admin-body');
  try { if (localStorage.getItem('ls_admin_collapsed') === '1') document.body.classList.add('ash-collapsed'); } catch {}

  // Role-based sidebar: show only what this person can open.
  fetch('/api/admin/me', { headers: H }).then(r => r.json()).then(d => {
    if (!d.admin) return;
    w.__lsAdmin = d.admin;
    // Each staff member's own light/dark choice (remembered on this device).
    try { const t = localStorage.getItem('ls_admin_theme:' + d.admin.id); if (t) setTheme(t === 'dark', false); } catch {}
    $('ashName').textContent = d.admin.name;
    $('ashRole').textContent = d.admin.roleLabel;
    const areas = new Set<string>(d.admin.areas);
    document.querySelectorAll<HTMLElement>('.ash-cat').forEach(cat => {
      let any = false;
      cat.querySelectorAll<HTMLElement>('li[data-area]').forEach(li => { const ok = areas.has(li.dataset.area!); li.hidden = !ok; any ||= ok; });
      cat.hidden = !any;
    });
    document.dispatchEvent(new CustomEvent('ls:admin', { detail: d.admin }));
    if (areas.has('commerce')) startFood();
  }).catch(() => {});
  if (new URLSearchParams(location.search).has('denied')) {
    const note = document.createElement('p');
    note.className = 'ash-denied'; note.setAttribute('role', 'alert');
    note.textContent = "Your role doesn't include that screen, so you've been brought to the dashboard. Ask a Super Admin if you need access.";
    document.querySelector('.ash')?.parentElement?.insertBefore(note, document.querySelector('.ash')!.nextSibling);
  }

  // Collapse (desktop) and slide-out (phones).
  $('ashCollapse').addEventListener('click', () => {
    const on = document.body.classList.toggle('ash-collapsed');
    try { localStorage.setItem('ls_admin_collapsed', on ? '1' : '0'); } catch {}
  });
  const setOpen = (on: boolean) => { document.body.classList.toggle('ash-open', on); $('ashOv').hidden = !on; $('ashBurger').setAttribute('aria-expanded', String(on)); };
  $('ashBurger').addEventListener('click', () => setOpen(!document.body.classList.contains('ash-open')));
  $('ashOv').addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') { setOpen(false); $('ashResults').hidden = true; $('ashNotes').hidden = true; } });

  // Admin search.
  const TYPE_COLOR: Record<string, string> = { Fan: '#8B5CF6', Match: '#10B981', News: '#0EA5E9', Member: '#8B5CF6', Message: '#F97316' };
  let timer = 0;
  const q = $('ashQ') as HTMLInputElement, results = $('ashResults');
  async function search() {
    const term = q.value.trim();
    if (term.length < 2) { results.hidden = true; return; }
    try {
      const d = await (await fetch(`/api/admin/search?q=${encodeURIComponent(term)}`, { headers: H })).json();
      results.innerHTML = d.results?.length
        ? d.results.map((r: any) => `<a href="${esc(r.href)}"><span class="ash-rtype" style="background:${TYPE_COLOR[r.type] || '#64748B'}">${esc(r.type)}</span>${esc(r.title)}<small>${esc(r.sub || '')}</small></a>`).join('')
        : `<p class="ash-empty">Nothing found for “${esc(term)}”.</p>`;
      results.hidden = false;
    } catch { results.hidden = true; }
  }
  q.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(search, 250); });
  $('ashSearch').addEventListener('submit', e => { e.preventDefault(); search(); });
  document.addEventListener('click', e => {
    if (!(e.target as HTMLElement).closest('.ash-search')) results.hidden = true;
    if (!(e.target as HTMLElement).closest('.ash-bell-wrap')) { $('ashNotes').hidden = true; $('ashBell').setAttribute('aria-expanded', 'false'); }
  });

  // Notifications.
  let serverNotes: any[] = [], foodUnread: any[] = [];
  function renderBell() {
    const total = serverNotes.length + foodUnread.length;
    $('ashBadge').hidden = !total; $('ashBadge').textContent = String(total);
    const food = foodUnread.map((a: any) => `<a class="ash-food" style="--k:${a.kind === 'paid' ? '#16A34A' : a.kind === 'unpaid' ? '#F59E0B' : a.kind === 'whatsapp' ? '#25D366' : '#3B82F6'}" href="/admin/food-orders/live/">${esc(a.title)}<small>${esc(a.body)}</small></a>`).join('');
    $('ashNotes').innerHTML = total
      ? food + serverNotes.map((n: any) => `<a href="${esc(n.href)}">${esc(n.icon || '•')} ${esc(n.title)}<small>${esc(n.sub || '')}</small></a>`).join('')
      : '<p class="ash-empty">No new notifications. All clear 🎉</p>';
  }
  async function notes() {
    try {
      const d = await (await fetch('/api/admin/notifications', { headers: H })).json();
      serverNotes = d.items || [];
      renderBell();
    } catch { /* keep quiet */ }
  }
  $('ashBell').addEventListener('click', () => {
    const n = $('ashNotes'); n.hidden = !n.hidden; $('ashBell').setAttribute('aria-expanded', String(!n.hidden));
    // Opening the bell marks food alerts as seen (they stay listed until it closes).
    if (!n.hidden && foodUnread.length && w.__lsAdmin) { try { localStorage.setItem('ls_food_seen:' + w.__lsAdmin.id, String(foodLast)); } catch {} }
    if (n.hidden && foodUnread.length) { foodUnread = []; renderBell(); }
  });

  // ── Food order alerts (Commerce staff): bell, pop-up and sound ──
  let foodLast = 0, foodHeard = -1, audio: AudioContext | null = null;
  const muted = () => { try { return localStorage.getItem('ls_food_mute:' + (w.__lsAdmin?.id || '')) === '1'; } catch { return false; } };
  const prefs = () => { try { return JSON.parse(localStorage.getItem('ls_food_prefs:' + (w.__lsAdmin?.id || '')) || '{}'); } catch { return {}; } };
  // Browsers only allow sound after the first tap or click on the page.
  const unlock = () => { try { audio ||= new (window.AudioContext || (window as any).webkitAudioContext)(); if (audio.state === 'suspended') audio.resume(); } catch {} };
  document.addEventListener('pointerdown', unlock, { passive: true });
  document.addEventListener('keydown', unlock);
  function tone(freq: number, start: number, dur: number, gain: number, type: OscillatorType) {
    if (!audio) return;
    const o = audio.createOscillator(), g = audio.createGain();
    o.type = type; o.frequency.value = freq;
    g.gain.setValueAtTime(0.0001, audio.currentTime + start);
    g.gain.exponentialRampToValueAtTime(gain, audio.currentTime + start + 0.02);
    g.gain.exponentialRampToValueAtTime(0.0001, audio.currentTime + start + dur);
    o.connect(g).connect(audio.destination); o.start(audio.currentTime + start); o.stop(audio.currentTime + start + dur + 0.05);
  }
  function chime(kind: string) {
    if (muted() || !audio) return;
    if (kind === 'unpaid') { tone(660, 0, 0.18, 0.12, 'sine'); tone(880, 0.2, 0.25, 0.12, 'sine'); return; }
    // PAID: louder and more urgent (two bursts of three beeps).
    for (const [i, f] of [1046, 1318, 1568, 1046, 1318, 1568].entries()) tone(f, i * 0.16 + (i > 2 ? 0.25 : 0), 0.13, 0.45, 'square');
  }
  function toast(a: any) {
    const t = document.createElement('a');
    t.className = `ash-toast ${a.kind}`; t.href = '/admin/food-orders/live/';
    t.innerHTML = `<b></b><span></span>`; t.querySelector('b')!.textContent = a.title; t.querySelector('span')!.textContent = a.body;
    $('ashToasts').prepend(t);
    setTimeout(() => t.remove(), a.kind === 'unpaid' ? 9000 : 20000);
  }
  async function foodPoll() {
    if (!w.__lsAdmin) return;
    let seen = 0;
    try { seen = Number(localStorage.getItem('ls_food_seen:' + w.__lsAdmin.id)) || 0; } catch {}
    try {
      const d = await (await fetch(`/api/admin/food-alerts?after=${seen}`, { headers: H, cache: 'no-store' })).json();
      foodLast = d.lastId || 0;
      if (!seen) { try { localStorage.setItem('ls_food_seen:' + w.__lsAdmin.id, String(foodLast)); } catch {} }
      foodUnread = seen ? (d.alerts || []) : [];
      const p = prefs();
      if (foodHeard >= 0) for (const a of [...(d.alerts || [])].reverse()) {
        if (a.id <= foodHeard) continue;
        if ((a.kind === 'unpaid' && p.unpaid === false) || (a.kind === 'paid' && p.paid === false)) continue;
        toast(a); chime(a.kind);
        document.dispatchEvent(new CustomEvent('ls:food-alert', { detail: a }));
      }
      foodHeard = foodLast;
      renderBell();
    } catch { /* try again shortly */ }
  }
  function startFood() {
    $('ashMute').hidden = false;
    const setMute = (m: boolean) => { $('ashMute').textContent = m ? '🔇' : '🔊'; $('ashMute').setAttribute('aria-label', m ? 'Unmute food order sounds' : 'Mute food order sounds'); };
    setMute(muted());
    $('ashMute').addEventListener('click', () => { const m = !muted(); try { localStorage.setItem('ls_food_mute:' + w.__lsAdmin.id, m ? '1' : '0'); } catch {} setMute(m); unlock(); });
    foodPoll(); window.setInterval(foodPoll, 8000);
    document.addEventListener('ls:food-poll', foodPoll);
  }
  w.__lsFoodChime = chime;
  notes(); window.setInterval(notes, 120_000);

  // Light / dark mode.
  function setTheme(dark: boolean, save = true) {
    document.body.classList.toggle('admin-dark', dark);
    const b = $('ashTheme');
    b.textContent = dark ? '☀️' : '🌙';
    b.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
    if (save) try {
      localStorage.setItem('ls_admin_theme_last', dark ? 'dark' : 'light');
      if (w.__lsAdmin) localStorage.setItem('ls_admin_theme:' + w.__lsAdmin.id, dark ? 'dark' : 'light');
    } catch {}
    document.dispatchEvent(new CustomEvent('ls:theme', { detail: { dark } }));
  }
  setTheme(document.body.classList.contains('admin-dark'), false);
  $('ashTheme').addEventListener('click', () => setTheme(!document.body.classList.contains('admin-dark')));

  // Long tables get a quick filter box and pages (25 rows a page). Tables the
  // server already pages (the fan database) are left alone.
  const PAGE = 25;
  function enhance(table: HTMLTableElement) {
    if (table.closest('[data-server-paged]') || !table.tBodies[0]) return;
    const rows = [...table.tBodies[0].rows];
    const box = table.closest('.scroll') || table;
    const prevTools = box.previousElementSibling?.classList.contains('tbl-tools') ? box.previousElementSibling : null;
    const prevPager = box.nextElementSibling?.classList.contains('tbl-pager') ? box.nextElementSibling : null;
    if (rows.length <= PAGE) { prevTools?.remove(); prevPager?.remove(); return; }
    if ((table as any).__enh === rows.length && prevTools) return;
    (table as any).__enh = rows.length;
    prevTools?.remove(); prevPager?.remove();
    const tools = document.createElement('div'); tools.className = 'tbl-tools';
    tools.innerHTML = `<input type="search" placeholder="Filter these ${rows.length} rows…" aria-label="Filter the table"><span></span>`;
    const pager = document.createElement('div'); pager.className = 'tbl-pager';
    box.before(tools); box.after(pager);
    const input = tools.querySelector('input')!, count = tools.querySelector('span')!;
    let page = 1;
    const draw = () => {
      const term = input.value.trim().toLowerCase();
      const match = rows.filter(r => !term || r.textContent!.toLowerCase().includes(term));
      const pages = Math.max(1, Math.ceil(match.length / PAGE));
      page = Math.min(page, pages);
      rows.forEach(r => { r.hidden = true; });
      match.slice((page - 1) * PAGE, page * PAGE).forEach(r => { r.hidden = false; });
      count.textContent = `${match.length} row${match.length === 1 ? '' : 's'}`;
      const nums = [...new Set([1, page - 1, page, page + 1, pages])].filter(n => n >= 1 && n <= pages).sort((a, b) => a - b);
      pager.innerHTML = `<button type="button" data-p="${page - 1}" ${page === 1 ? 'disabled' : ''} aria-label="Previous page">‹</button>` +
        nums.map(n => `<button type="button" data-p="${n}" ${n === page ? 'aria-current="page"' : ''}>${n}</button>`).join('') +
        `<button type="button" data-p="${page + 1}" ${page === pages ? 'disabled' : ''} aria-label="Next page">›</button>`;
      pager.hidden = pages === 1;
    };
    input.addEventListener('input', () => { page = 1; draw(); });
    pager.addEventListener('click', e => { const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-p]'); if (b && !b.disabled) { page = Number(b.dataset.p); draw(); } });
    draw();
  }
  const main = document.getElementById('main');
  if (main) {
    let t = 0;
    const scan = () => main.querySelectorAll<HTMLTableElement>('table').forEach(enhance);
    new MutationObserver(recs => {
      if (recs.every(r => [...r.addedNodes].every(n => n instanceof HTMLElement && (n.classList.contains('tbl-tools') || n.classList.contains('tbl-pager') || n.closest?.('.tbl-pager'))))) return;
      clearTimeout(t); t = window.setTimeout(scan, 80);
    }).observe(main, { childList: true, subtree: true });
    scan();
  }

  $('anOut').addEventListener('click', async () => {
    sessionStorage.removeItem('ls_admin_code');
    await fetch('/api/admin/logout', { method: 'POST' }).catch(() => {});
    location.href = '/admin/login/';
  });
</script>
