---
// The admin shell: a left sidebar grouped into colour-coded categories
// (collapsible on desktop, a slide-out menu on phones) and a top bar with the
// breadcrumb, admin search, notifications and who is signed in.
// The sidebar only shows what the signed-in person's role can open (the
// server enforces the same rules: functions/api/_lib/adminRoles.js).
// Pages keep including it the same way: <AdminNav current="fans" />.
import ChecklistBanner from './ChecklistBanner.astro';
interface Props { current?: string }
const { current = '' } = Astro.props;

// perm: the permission(s) the page needs ('a|b' = any; '' = everyone), as in adminRoles.js.
type Item = { id: string; label: string; href: string; perm: string; ext?: boolean; hint?: string };
type Cat = { id: string; icon: string; label: string; color: string; items: Item[] };
const CMS = '/admin/#/collections';
const CATEGORIES: Cat[] = [
  { id: 'overview', icon: '🏠', label: 'Overview', color: '#E31E24', items: [
    { id: 'dashboard', label: 'Dashboard', href: '/admin/dashboard/', perm: '' },
  ] },
  { id: 'matchday', icon: '⚽', label: 'Matchday', color: '#10B981', items: [
    { id: 'matches', label: 'Match Tickets & Settings', href: '/admin/matches/', perm: 'matchday.fixtures.edit|commerce.tickets.manage|broadcast.commentary.manage|matchday.live_control', hint: 'Ticket prices, commentary and sale settings per match (dates and results: League)' },
    { id: 'match-centre', label: 'Live Match Control', href: '/admin/match-centre/', perm: 'matchday.live_control|matchday.squad.edit|matchday.stats.edit|matchday.live_updates|broadcast.watch_live.edit|matchday.fixtures.edit|matchday.motm.manage', hint: 'Kick-off, score, squad, Man of the Match, stats, streams, content checklist' },
    { id: 'match-checklist', label: 'Match Checklist', href: '/admin/match-checklist/', perm: 'matchday.checklist.view', hint: 'Everything to do before, during and after the next match; PDF, email and daily reminders' },
    { id: 'other-games', label: 'Other Games', href: '/admin/scores/', perm: 'matchday.scores', hint: 'Scores for every conference match: reports from each source, official and verified results' },
    { id: 'score-adjustments', label: 'Points Adjustments', href: '/admin/league/table/#h-adj', perm: 'matchday.fixtures.edit', hint: 'Points deductions or awards, with reason and official reference (footnote on the public table)' },
    { id: 'score-messages', label: 'Score Messages', href: '/admin/scores/messages/', perm: 'matchday.scores', hint: 'Score emails and pasted WhatsApp messages; approve or reject the ones the website was not sure about' },
    { id: 'score-submitters', label: 'Club Network Submitters', href: '/admin/scores/submitters/', perm: 'matchday.scores', hint: 'People at other clubs who send scores: links, PINs, accuracy' },
    { id: 'predictions', label: 'Predict & Win', href: '/admin/predictions/', perm: 'matchday.predict.manage|matchday.predict.pay_prizes', hint: 'Entries, winners and prize payments' },
    { id: 'programmes', label: 'Matchday Programme', href: '/admin/programmes/', perm: 'content.programme.edit', hint: 'Upload the 4-page programme, publish or schedule it, QR codes and reading stats' },
    { id: 'share', label: 'Share any page', href: '/admin/share/', perm: 'matchday.live_updates|content.programme.edit|media.upload', hint: 'Check how any page of the site looks as a link card and post it to the club socials' },
    { id: 'commentary', label: 'Live Commentary', href: '/admin/commentary/', perm: 'broadcast.commentary.manage|settings.commentary' },
    { id: 'fan-alerts', label: 'Fan Match Alerts', href: '/admin/fan-alerts/', perm: 'matchday.live_updates', hint: 'Phone notifications for fans: radio show, kick-off, goals, full time' },
  ] },
  { id: 'league', icon: '🏆', label: 'League', color: '#F59E0B', items: [
    { id: 'league', label: 'League Dashboard', href: '/admin/league/', perm: 'matchday.fixtures.edit|matchday.live_control', hint: 'Next match, results due, data warnings, table summary' },
    { id: 'league-fixtures', label: 'Fixtures', href: '/admin/league/fixtures/', perm: 'matchday.fixtures.edit|matchday.live_control', hint: 'Dates, times, venues, postpone and reschedule' },
    { id: 'league-results', label: 'Results', href: '/admin/league/results/', perm: 'matchday.fixtures.edit|matchday.live_control', hint: 'Enter scores matchday by matchday; Live mode for the pitch side' },
    { id: 'league-table', label: 'Table & Rules', href: '/admin/league/table/', perm: 'matchday.fixtures.edit|matchday.live_control', hint: 'Points adjustments, tie decisions, rules and zones' },
    { id: 'league-teams', label: 'Clubs & Venues', href: '/admin/league/teams/', perm: 'matchday.fixtures.edit|matchday.live_control' },
    { id: 'league-import', label: 'Import & Export', href: '/admin/league/import/', perm: 'matchday.fixtures.edit', hint: 'Upload a revised fixture list (CSV); download fixtures and table' },
    { id: 'score-sources', label: 'Score Sources', href: '/admin/scores/sources/', perm: 'matchday.scores', hint: 'Where results for every conference game come from (two sources must agree); licence settings' },
    { id: 'score-unmatched', label: 'Unmatched Team Names', href: '/admin/scores/unmatched/', perm: 'matchday.scores', hint: 'Team names in score reports that match no team: link them once' },
    { id: 'league-audit', label: 'League History', href: '/admin/league/audit/', perm: 'matchday.fixtures.edit|matchday.live_control', hint: 'Every change, who and when; undo a mistake' },
  ] },
  { id: 'content', icon: '📰', label: 'Content', color: '#0EA5E9', items: [
    { id: 'news', label: 'News & Articles', href: '/admin/news/', perm: 'content.news.edit|content.news.publish|content.team_news.edit', hint: 'Including Team News' },
    { id: 'awards', label: 'Fan Awards', href: '/admin/awards/', perm: 'content.club_pages.edit', hint: 'Goal / Player of the Month, Player of the Season' },
    { id: 'cms-players', label: 'Squad & Players', href: `${CMS}/players`, perm: 'content.club_pages.edit|matchday.squad.edit', ext: true },
    { id: 'cms-videos', label: 'Videos', href: `${CMS}/settings/entries/videos`, perm: 'content.videos.edit', ext: true },
    { id: 'cms-gallery', label: 'Gallery', href: `${CMS}/gallery`, perm: 'content.gallery.edit', ext: true },
    { id: 'cms-club', label: 'Club Pages', href: `${CMS}/settings/entries/history`, perm: 'content.club_pages.edit', ext: true, hint: 'History, Honours, Stadium, Fan Clubs' },
    { id: 'cms', label: 'Content CMS (everything)', href: '/admin/', perm: 'commerce.hospitality.manage|commerce.personalisation.manage|commerce.shop.manage|content.club_pages.edit|content.gallery.edit|content.news.edit|content.news.publish|content.team_news.edit|content.videos.edit|fans.members.manage|matchday.predict.manage|matchday.squad.edit|media.upload|partners.manage|settings.promo_bar|settings.site|settings.social_links', ext: true },
  ] },
  { id: 'rewards', icon: '⭐', label: 'Rewards', color: '#C9A227', items: [
    { id: 'rewards', label: 'Lobi Stars Rewards', href: '/admin/rewards/', perm: 'rewards.settings|rewards.catalogue|rewards.members.view|rewards.points.adjust|rewards.fulfilment', hint: 'Star Points: settings, members, adjust points, launch switch' },
    { id: 'rewards-catalogue', label: 'Rewards Catalogue', href: '/admin/rewards/catalogue/', perm: 'rewards.catalogue', hint: 'What fans can redeem: points, stock, limits' },
    { id: 'rewards-terms', label: 'Rewards Terms', href: '/admin/rewards/terms/', perm: 'rewards.settings', hint: 'Change the Lobi Stars Rewards Terms at any time' },
    { id: 'rewards-fulfilment', label: 'Fulfilment & Vouchers', href: '/admin/rewards/fulfilment/', perm: 'rewards.fulfilment', hint: 'Experiences and items to arrange; check a voucher code' },
    { id: 'rewards-analytics', label: 'Rewards Reports', href: '/admin/rewards/analytics/', perm: 'analytics.view_all|rewards.settings', hint: 'Charts, checks for suspicious accounts, Excel download' },
  ] },
  { id: 'fans', icon: '👥', label: 'Fans & Inbox', color: '#8B5CF6', items: [
    { id: 'inbox', label: 'Inbox', href: '/admin/inbox/', perm: 'fans.inbox.read', hint: 'Read and reply to contact, sponsorship and hospitality messages' },
    { id: 'newsletter', label: 'Newsletter', href: '/admin/newsletter/', perm: 'fans.newsletter.manage', hint: 'Write and send the weekly newsletter' },
    { id: 'fans', label: 'Fan Database', href: '/admin/fans/', perm: 'fans.database.view|fans.accounts.view' },
    { id: 'fans-newsletter', label: 'Newsletter Subscribers', href: '/admin/fans/?source=newsletter', perm: 'fans.database.view|fans.accounts.view' },
    { id: 'fans-accounts', label: 'Fan Accounts', href: '/admin/fans/?source=fan_account', perm: 'fans.database.view|fans.accounts.view' },
    { id: 'contact-sources-f', label: 'Contact Sources & Downloads', href: '/admin/contact-sources/', perm: 'fans.database.view' },
    { id: 'fans-duplicates', label: 'Possible Duplicates', href: '/admin/fans/duplicates/', perm: 'fans.accounts.edit' },
    { id: 'members', label: 'Members', href: '/admin/members/', perm: 'fans.members.manage|fans.accounts.view' },
  ] },
  { id: 'commerce', icon: '🛒', label: 'Commerce', color: '#F97316', items: [
    { id: 'tickets', label: 'Match Tickets', href: '/admin/tickets/', perm: 'commerce.tickets.manage', hint: 'Prices, capacity, sale times and on/off per home match; orders, refunds, sales' },
    { id: 'ticket-discounts', label: 'Ticket Discounts', href: '/admin/tickets/discounts/', perm: 'commerce.tickets.manage', hint: 'Group, early-bird and family bundle discounts: on/off, percents, dates, limits, report' },
    { id: 'scan', label: 'Ticket Scanner', href: '/admin/tickets/scan/', perm: 'commerce.gate_scan' },
    { id: 'helpers', label: 'Matchday Helpers', href: '/admin/helpers/', perm: 'helpers.create', hint: 'Gate and kitchen helper logins for one match (username + PIN, QR, WhatsApp)' },
    { id: 'season-tickets', label: 'Season Tickets', href: '/admin/season-tickets/', perm: 'commerce.tickets.manage', hint: 'Prices, how many per stand, sales, cancel a season ticket' },
    { id: 'kitchen', label: 'Kitchen Screen', href: '/admin/kitchen/', perm: 'commerce.kitchen.board|commerce.kitchen.manage', hint: 'Full-screen app for the kitchen: accept, cooking, ready' },
    { id: 'food-live', label: 'Food: Live Order Board', href: '/admin/food-orders/live/', perm: 'commerce.kitchen.manage', hint: 'Kitchen and runners on matchday' },
    { id: 'kitchen-alerts', label: 'Food: Kitchen Alerts', href: '/admin/food-orders/kitchen-alerts/', perm: 'commerce.kitchen.manage', hint: 'Push + Telegram alerts, repeats, devices, log' },
    { id: 'food-orders', label: 'Food: Orders', href: '/admin/food-orders/', perm: 'commerce.kitchen.manage' },
    { id: 'food-analytics', label: 'Food: Analytics', href: '/admin/food-orders/analytics/', perm: 'commerce.kitchen.manage' },
    { id: 'food-menu', label: 'Food: Menu & Prices', href: '/admin/food-orders/menu/', perm: 'commerce.kitchen.manage', hint: 'Add items, prices, photos, sold out' },
    { id: 'shirt-orders', label: 'Shirt Personalisation Orders', href: '/admin/shirt-orders/', perm: 'commerce.personalisation.manage' },
    { id: 'cms-shop', label: 'Shop Products', href: `${CMS}/settings/entries/shop`, perm: 'commerce.shop.manage|commerce.personalisation.manage', ext: true },
    { id: 'cms-hospitality', label: 'Hospitality Packages', href: `${CMS}/settings/entries/hospitality`, perm: 'commerce.hospitality.manage', ext: true },
    { id: 'cms-membership', label: 'Membership Settings', href: `${CMS}/settings/entries/membership`, perm: 'fans.members.manage', ext: true },
  ] },
  { id: 'partners', icon: '🤝', label: 'Partners', color: '#14B8A6', items: [
    { id: 'partners', label: 'Partners & Open Categories', href: '/admin/partners/', perm: 'partners.manage|partners.reports' },
    { id: 'inbox-sponsorship', label: 'Sponsorship Enquiries', href: '/admin/inbox/?source=sponsorship', perm: 'partners.enquiries' },
    { id: 'newsletter-sponsors', label: 'Newsletter Sponsor Adverts', href: '/admin/newsletter/?tab=sponsors', perm: 'partners.manage', hint: 'Sponsor logos, links and adverts in the newsletter' },
    { id: 'partner-reports', label: 'Monthly Partner Reports', href: '/admin/partners/#prr', perm: 'partners.reports', hint: 'Email each sponsor their monthly numbers' },
    { id: 'analytics-partners', label: 'Partner Reports', href: '/admin/analytics/#sec-partners', perm: 'analytics.partners|analytics.view_all' },
    { id: 'cms-partners', label: 'Partner Profiles', href: `${CMS}/partners`, perm: 'partners.manage|media.upload', ext: true },
  ] },
  { id: 'analytics', icon: '📊', label: 'Analytics', color: '#EC4899', items: [
    { id: 'analytics', label: 'Traffic & Engagement', href: '/admin/analytics/', perm: 'analytics.view_all' },
    { id: 'contact-sources', label: 'Contact Sources', href: '/admin/contact-sources/', perm: 'analytics.view_all' },
    { id: 'analytics-matchday', label: 'Matchday Analytics', href: '/admin/analytics/#sec-matchday', perm: 'analytics.view_all' },
    { id: 'analytics-commentary', label: 'Commentary / Broadcast Report', href: '/admin/analytics/#sec-commentary', perm: 'analytics.broadcast|analytics.view_all' },
    { id: 'food-analytics-a', label: 'Food Analytics', href: '/admin/food-orders/analytics/', perm: 'analytics.view_all' },
  ] },
  { id: 'settings', icon: '⚙️', label: 'Settings', color: '#64748B', items: [
    { id: 'cms-site', label: 'Site Settings & Social Links', href: `${CMS}/settings/entries/site`, perm: 'settings.site|settings.social_links', ext: true },
    { id: 'cms-promo', label: 'Promo Bar', href: `${CMS}/settings/entries/promo`, perm: 'settings.promo_bar', ext: true },
    { id: 'commentary-settings', label: 'Commentary & Stream Settings', href: '/admin/commentary/', perm: 'settings.commentary|broadcast.commentary.manage' },
    { id: 'staff', label: 'Staff Users & Roles', href: '/admin/staff/', perm: 'staff.manage' },
    { id: 'approvals', label: 'Approvals', href: '/admin/approvals/', perm: 'approvals.approve', hint: 'Requests waiting for a Super Admin: new staff, big points changes, official statements' },
    { id: 'security', label: 'Login & Security', href: '/admin/security/', perm: 'staff.manage', hint: 'Require two-step login, IP allowlist, security alerts, who is signed in' },
    { id: 'account', label: 'My Account (password, two-step login)', href: '/admin/account/', perm: '' },
    { id: 'inbox-settings', label: 'Inbox Emails & Templates', href: '/admin/inbox/?settings=1', perm: 'fans.inbox.reply', hint: 'New-message alerts, daily summary, saved replies' },
    { id: 'export-log', label: 'Export Log', href: '/admin/fans/#exportLog', perm: 'logs.view|fans.export' },
    { id: 'activity', label: 'Activity Log', href: '/admin/activity/', perm: 'logs.view' },
    { id: 'squad-portal', label: 'Squad & Staff Data Portal', href: '/admin/squad-portal/', perm: 'squad.portal.manage', hint: 'The private portal link (copy and send), its login, on/off, sessions and season (Super Admins only)' },
    { id: 'health', label: '🩺 Website Health', href: '/admin/health/', perm: 'website.health', hint: 'Finds problems anywhere on the website and explains how to fix them (Super Admins only)' },
    { id: 'ai-fix', label: '🤖 AI Fix', href: '/admin/ai/', perm: 'ai.fix|ai.prepare', hint: 'Claude prepares fixes for the Analytics recommendations; a Super Admin applies them. Fix history and results' },
    { id: 'ai-settings', label: 'AI Settings', href: '/admin/ai/settings/', perm: 'ai.fix', hint: 'Monthly AI budget, spend, models and Test connection (Super Admins only)' },
    { id: 'backup', label: 'Data Backup', href: '/admin/backup/', perm: 'staff.manage', hint: 'Download a copy of all website data (Super Admin)' },
  ] },
];
const active = CATEGORIES.flatMap(c => c.items.map(i => ({ c, i }))).find(x => x.i.id === current);
const crumbs = active ? [active.c.label, active.i.label] : ['Admin'];
// "← Back": to the page you came from in the admin, otherwise up one level
// (Food sub-pages -> Food: Orders, Possible Duplicates -> Fan Database) or the Dashboard.
const here = Astro.url.pathname.replace(/\/?$/, '/');
const backTo = /^\/admin\/food-orders\/.+/.test(here) ? ['/admin/food-orders/', 'Food: Orders']
  : /^\/admin\/fans\/.+/.test(here) ? ['/admin/fans/', 'Fan Database'] : ['/admin/dashboard/', 'Dashboard'];
const showBack = here !== '/admin/dashboard/';
---
<script is:inline>
  // Apply the last theme straight away (no flash); the signed-in person's own choice is applied once known.
  try { if (localStorage.getItem('ls_admin_theme_last') === 'dark') document.body.classList.add('admin-dark'); } catch (e) {}
</script>
<div class="ash" data-current={current}>
  <aside class="ash-side" id="ashSide" aria-label="Admin menu">
    <div class="ash-brand">
      <a href="/admin/dashboard/" class="ash-logo"><img class="club-logo" style="--logo-h:36px" src="/images/lobi-stars-badge.png" alt="" width="36" height="36" /><span><b>Lobi Stars</b><small>Admin</small></span></a>
      <button type="button" class="ash-collapse" id="ashCollapse" aria-label="Collapse menu" title="Collapse menu">&laquo;</button>
    </div>
    <nav class="ash-nav">
      {CATEGORIES.map(c => (
        <section class="ash-cat" data-cat={c.id} style={`--cat:${c.color}`} hidden>
          <h2 class="ash-cat-h"><span class="ash-ico" aria-hidden="true">{c.icon}</span><span class="ash-cat-t">{c.label}</span></h2>
          <ul>
            {c.items.map(i => (
              <li data-perm={i.perm} hidden>
                <a href={i.href} aria-current={i.id === current ? 'page' : undefined} title={i.hint || i.label} target={i.ext && i.href.startsWith('/scan') ? '_blank' : undefined}>
                  <span class="ash-dot" aria-hidden="true"></span><span class="ash-lbl">{i.label}</span>{i.ext && <span class="ash-ext" aria-label="(opens the CMS or another tool)">↗</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </nav>
    <a href="/" class="ash-site">&larr; <span class="ash-lbl">Back to the website</span></a>
  </aside>
  <div class="ash-ov" id="ashOv" hidden></div>
  <div class="ash-idle" id="ashIdle" role="alertdialog" aria-live="assertive" aria-label="You will be signed out soon" hidden><p>You'll be signed out in <strong id="ashIdleLeft">2</strong> minute(s) because nothing has happened for a while.</p><button type="button" id="ashIdleStay">Stay signed in</button></div>

  <header class="ash-top">
    <button type="button" class="ash-burger" id="ashBurger" aria-label="Open admin menu" aria-controls="ashSide" aria-expanded="false">☰</button>
    {showBack && <a class="ash-back" href={backTo[0]} id="ashBack" title={`Back (or to ${backTo[1]})`}><span aria-hidden="true">←</span><span class="ash-back-t">Back</span></a>}
    <nav class="ash-crumb" aria-label="Breadcrumb">{crumbs.map((c, i) => <><span aria-current={i === crumbs.length - 1 ? 'page' : undefined}>{c}</span>{i < crumbs.length - 1 && <span class="ash-sep" aria-hidden="true">›</span>}</>)}</nav>
    <form class="ash-search" id="ashSearch" role="search">
      <label class="sr-only" for="ashQ">Search the admin</label>
      <input id="ashQ" type="search" placeholder="Search fans, matches, news…" autocomplete="off" />
      <div class="ash-results" id="ashResults" hidden></div>
    </form>
    <div class="ash-bell-wrap">
      <button type="button" class="ash-bell" id="ashBell" aria-label="Notifications" aria-expanded="false">🔔<span class="ash-badge" id="ashBadge" hidden></span></button>
      <div class="ash-notes" id="ashNotes" hidden><p class="ash-empty">No new notifications.</p></div>
    </div>
    <a class="ash-user" href="/admin/account/" title="My account: password and two-step login"><span class="ash-name" id="ashName"></span><span class="ash-role" id="ashRole"></span></a>
    <button type="button" class="ash-theme" id="ashMute" aria-label="Mute food order sounds" title="Food order sounds on/off" hidden>🔊</button>
    <button type="button" class="ash-theme" id="ashTheme" aria-label="Switch to dark mode" title="Dark / light mode">🌙</button>
    <button type="button" class="ash-out" id="anOut">Log out</button>
  </header>
</div>

<ChecklistBanner />

<div class="ash-toasts" id="ashToasts" aria-live="assertive"></div>

<style is:global>
  .ash-toasts { position: fixed; right: 16px; bottom: 16px; z-index: 2000; display: flex; flex-direction: column; gap: 10px; width: min(380px, calc(100vw - 32px)); }
  .ash-toast { display: block; padding: 14px 16px; border-radius: 14px; color: #fff; text-decoration: none; box-shadow: 0 18px 40px rgba(0,0,0,.3); animation: ashin .25s ease-out; border: 2px solid rgba(255,255,255,.25); }
  .ash-toast b { display: block; font: 700 15px/1.3 'Barlow', sans-serif; margin-bottom: 3px; }
  .ash-toast span { font-size: 14px; opacity: .95; }
  .ash-toast.paid { background: linear-gradient(135deg, #15803D, #16A34A); }
  .ash-toast.unpaid { background: linear-gradient(135deg, #B45309, #F59E0B); }
  .ash-toast.whatsapp { background: linear-gradient(135deg, #128C7E, #25D366); }
  .ash-toast.test { background: linear-gradient(135deg, #1E40AF, #3B82F6); }
  @keyframes ashin { from { transform: translateY(12px); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .ash-toast { animation: none; } }
  .ash-notes .ash-food { border-left: 4px solid var(--k, #16A34A); }
  /* ── Design tokens ── */
  body.admin-body {
    --a-red: #E31E24; --a-gold: #EAB308; --a-emerald: #10B981; --a-sky: #0EA5E9; --a-purple: #8B5CF6;
    --a-orange: #F97316; --a-teal: #14B8A6; --a-pink: #EC4899; --a-slate: #64748B;
    --a-bg: #F5F6F8; --a-card: #FFFFFF; --a-soft: #F8FAFC; --a-zebra: #FAFBFC; --a-hover: #FFF8E1;
    --a-ink: #15181D; --a-muted: #5B6472; --a-line: #E3E6EA; --a-head: #15181D; --a-head-ink: #FFFFFF;
    color-scheme: light;
  }
  body.admin-body.admin-dark {
    --a-bg: #0F1216; --a-card: #1A1E24; --a-soft: #20252C; --a-zebra: #1E232A; --a-hover: #2A2416;
    --a-ink: #E8EAED; --a-muted: #A0A8B3; --a-line: #2E343C; --a-head: #252B33; --a-head-ink: #FFFFFF;
    /* the public site's variables, used by the existing admin pages */
    --black: #0F1216; --dark: #171B20; --d2: #1A1E24; --d3: #232931; --d4: #2E343C; --white: #E8EAED; --lt: #A0A8B3;
    --red-text: #FF6B6F; --gold-text: #F2C14E;
    color-scheme: dark;
  }
  body.admin-body { background: var(--a-bg); color: var(--a-ink); }
  body.admin-dark .ash-top, body.admin-dark .ash-bell, body.admin-dark .ash-out, body.admin-dark .ash-theme, body.admin-dark .ash-burger, body.admin-dark .ash-back, body.admin-dark .ash-results, body.admin-dark .ash-notes { background: var(--a-card); color: var(--a-ink); border-color: var(--a-line); }
  body.admin-dark .ash-search input { background: var(--a-soft); color: var(--a-ink); border-color: var(--a-line); }
  body.admin-dark .ash-results a:hover, body.admin-dark .ash-notes a:hover { background: var(--a-soft); }
  body.admin-dark .stitle, body.admin-dark h1, body.admin-dark h2, body.admin-dark h3 { color: var(--a-ink); }
  body.admin-dark .muted { color: var(--a-muted); }
  body.admin-dark .btn-o { color: var(--a-ink); border-color: var(--a-line); }
  body.admin-dark input, body.admin-dark select, body.admin-dark textarea { background: var(--a-soft); color: var(--a-ink); border-color: var(--a-line); }
