---
// Homepage card "Match Day Programme: Lobi Stars vs … Read free", shown from
// the moment a programme is published until 6 hours after its kick-off (and
// only while "Homepage banner" is on in Admin › Matchday Programme). Fans can
// close it; it stays closed for that programme on this device.
---
<aside class="pgb" id="pgb" hidden aria-label="Match Day Programme">
  <div class="pgb-in">
    <a class="pgb-link" id="pgbLink" href="/programme/?src=homepage">
      <span class="pgb-k">Match Day Programme</span>
      <span class="pgb-t" id="pgbTitle"></span>
      <span class="pgb-go">Read free &rarr;</span>
    </a>
    <button type="button" class="pgb-x" id="pgbX" aria-label="Close the programme banner">×</button>
  </div>
</aside>

<style>
  .pgb { background: #FFC72C; color: #15181D; }
  .pgb-in { max-width: 1280px; margin: 0 auto; padding: 0 5%; display: flex; align-items: center; gap: 10px; }
  .pgb-link { flex: 1; min-width: 0; display: flex; align-items: center; gap: 6px 14px; flex-wrap: wrap; padding: 12px 0; color: inherit; text-decoration: none; }
  .pgb-k { font: 700 13px/1 'Barlow Condensed', sans-serif; letter-spacing: 2px; text-transform: uppercase; }
  .pgb-t { font: 400 22px/1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .pgb-go { font-weight: 700; text-decoration: underline; }
  .pgb-x { flex: none; width: 40px; height: 40px; border: 0; border-radius: 50%; background: transparent; font-size: 26px; line-height: 1; cursor: pointer; color: inherit; }
  .pgb-x:hover, .pgb-x:focus-visible { background: rgba(0, 0, 0, .1); }
  .pgb[hidden] { display: none; }
  @media (max-width: 600px) { .pgb-in { padding: 0 16px; } .pgb-t { font-size: 19px; } }
</style>

<script is:inline>
(function () {
  var box = document.getElementById('pgb');
  if (!box || box.dataset.ready) return; box.dataset.ready = '1';
  fetch('/api/programme/current').then(function (r) { return r.json(); }).then(function (d) {
    var p = d && d.enabled && d.homepageBanner && d.programme;
    if (!p) return;
    var now = new Date(d.serverTime || Date.now()).getTime();
    if (p.kickoffAt && now > new Date(p.kickoffAt).getTime() + 6 * 3600e3) return;
    try { if (localStorage.getItem('ls_pgb_closed') === p.slug) return; } catch (e) {}
    document.getElementById('pgbTitle').textContent = p.title;
    box.hidden = false;
    document.getElementById('pgbX').addEventListener('click', function () {
      box.hidden = true;
      try { localStorage.setItem('ls_pgb_closed', p.slug); } catch (e) {}
    });
  }).catch(function (e) { console.error('[programme banner]', e); });
})();
</script>
