---
// Homepage strip "MATCH DAY PROGRAMME · Lobi Stars FC vs <next opponent> ·
// Read free →". The server fills it in for every homepage request
// (functions/index.js + functions/api/_lib/programmeStrip.js): the opponent
// comes from THE next Lobi Stars match (the same as Upcoming Matches). The
// "Read free →" button always opens /programme/?src=homepage, which tells fans
// when the programme isn't out yet.
// Hidden while the programme feature or its "Homepage banner" switch is off,
// and when no match is left. Fans can close
// it; it stays closed for that match on this device.
---
<aside class="pgb" id="pgb" hidden aria-label="Match Day Programme"></aside>

<style>
  /* One thin line directly under the match bar (MatchBar.astro), same width. */
  .pgb { max-width: 1280px; margin: 8px auto 0; padding: 0 5%; box-sizing: border-box; color: #15181D; }
  .pgb[hidden] { display: none; }
  .pgb :global(.pgb-in) { display: flex; align-items: center; gap: 6px; padding: 0 4px 0 14px; border-radius: 10px; background: #FFC72C; }
  .pgb :global(.pgb-link) { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: 4px 14px; flex-wrap: wrap; min-height: 44px; padding: 4px 0; color: inherit; text-decoration: none; }
  .pgb :global(.pgb-txt) { display: flex; align-items: center; flex-wrap: wrap; gap: 2px 8px; min-width: 0; }
  .pgb :global(.pgb-k) { font: 700 12px/1.2 'Barlow Condensed', sans-serif; letter-spacing: .12em; text-transform: uppercase; }
  .pgb :global(.pgb-t) { font: 700 16px/1.2 'Barlow Condensed', sans-serif; letter-spacing: .02em; overflow-wrap: anywhere; }
  .pgb :global(.pgb-t)::before { content: '·'; margin-right: 8px; font-weight: 700; }
  .pgb :global(.pgb-ha) { display: inline-block; vertical-align: 1px; margin-left: 4px; padding: 2px 6px; border-radius: 999px; background: #15181D; color: #FFC72C; font: 700 10px/1 'Barlow Condensed', sans-serif; letter-spacing: .1em; text-transform: uppercase; }
  .pgb :global(.pgb-go) { display: inline-flex; align-items: center; min-height: 36px; font: 700 14px/1 'Barlow Condensed', sans-serif; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; text-decoration: underline; text-underline-offset: 3px; }
  .pgb :global(a.pgb-link:hover .pgb-go), .pgb :global(a.pgb-link:focus-visible .pgb-go) { color: #A3161B; }
  .pgb :global(a.pgb-link:focus-visible) { outline: 3px solid #15181D; outline-offset: 2px; border-radius: 6px; }
  .pgb :global(.pgb-x) { flex: none; width: 44px; height: 44px; border: 0; border-radius: 50%; background: transparent; font-size: 22px; line-height: 1; cursor: pointer; color: inherit; }
  .pgb :global(.pgb-x:hover), .pgb :global(.pgb-x:focus-visible) { background: rgba(0, 0, 0, .1); }
  /* Narrow screens: the label sits above the match, so no separator dot. */
  @media (max-width: 600px) { .pgb :global(.pgb-t)::before { content: none; } .pgb :global(.pgb-txt) { flex-direction: column; align-items: flex-start; } }
  @media (max-width: 420px) { .pgb { padding: 0 16px; } }
</style>

<script is:inline>
(function () {
  var box = document.getElementById('pgb');
  if (!box || box.dataset.ready) return; box.dataset.ready = '1';
  var inner = box.querySelector('.pgb-in');
  if (!inner) return;
  var key = inner.getAttribute('data-key');
  try { if (localStorage.getItem('ls_pgb_closed') === key) { box.hidden = true; return; } } catch (e) {}
  box.querySelector('.pgb-x').addEventListener('click', function () {
    box.hidden = true;
    try { localStorage.setItem('ls_pgb_closed', key); } catch (e) {}
  });
})();
</script>
