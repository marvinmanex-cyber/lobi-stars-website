---
// Contact / partnership form. Posts to the club's Formspree inbox (same
// endpoint the original homepage contact form used). Works without
// JavaScript; with JavaScript it submits in place and shows a message.
interface Props {
  kind: 'contact' | 'partnership' | 'hospitality';
  /** Hospitality form: package names to choose from. */
  packages?: string[];
  submitLabel?: string;
  /** Partnership form: Official Club Partner categories still available. */
  openCategories?: string[];
}
const { kind, submitLabel = kind === 'partnership' ? 'Send Partnership Request' : kind === 'hospitality' ? 'Send Hospitality Enquiry' : 'Send Message', openCategories = [], packages = [] } = Astro.props;
const SUBJECTS = { partnership: 'Partnership enquiry - lobistarsfc.com', hospitality: 'Hospitality enquiry - lobistarsfc.com', contact: 'Contact form - lobistarsfc.com' };
const FORMSPREE = 'https://formspree.io/f/xbdwbyaz';
// Principal and Kit partnerships are taken, so they're not offered.
const interests = [
  'Official Club Partner (category)',
  'Official Supplier',
  'Media & Broadcast Partner',
  'Institutional & Community Partner',
  'Stadium & Pitchside Advertising',
  'Digital & Social Media Activation',
  'Other',
];
---
<form class="eq" action={FORMSPREE} method="POST" data-enquiry>
  <input type="hidden" name="_subject" value={SUBJECTS[kind]} />
  <input type="hidden" name="form" value={kind} />
  <div class="form-row">
    <div class="form-grp"><label class="form-lbl" for={`${kind}-fn`}>{kind === 'partnership' ? 'Full Name' : 'First Name'}</label>
      <input class="form-inp" id={`${kind}-fn`} name={kind === 'partnership' ? 'name' : 'first_name'} autocomplete={kind === 'partnership' ? 'name' : 'given-name'} required /></div>
    {kind === 'partnership' ? (
      <div class="form-grp"><label class="form-lbl" for="partnership-co">Company</label>
        <input class="form-inp" id="partnership-co" name="company" autocomplete="organization" placeholder="Your organisation" required /></div>
    ) : (
      <div class="form-grp"><label class="form-lbl" for="contact-ln">Last Name</label>
        <input class="form-inp" id="contact-ln" name="last_name" autocomplete="family-name" required /></div>
    )}
  </div>
  <div class="form-row">
    <div class="form-grp"><label class="form-lbl" for={`${kind}-em`}>{kind === 'partnership' ? 'Work Email' : 'Email Address'}</label>
      <input class="form-inp" id={`${kind}-em`} name="email" type="email" autocomplete="email" required /></div>
    <div class="form-grp"><label class="form-lbl" for={`${kind}-ph`}>Phone {kind === 'contact' && <span>(optional)</span>}</label>
      <input class="form-inp" id={`${kind}-ph`} name="phone" type="tel" autocomplete="tel" placeholder="+234..." required={kind !== 'contact'} /></div>
  </div>
  {kind === 'partnership' ? (
    <div class="form-row">
      <div class="form-grp"><label class="form-lbl" for="partnership-in">Interest</label>
        <select class="form-sel" id="partnership-in" name="interest" data-interest>{interests.map(i => <option>{i}</option>)}</select></div>
      <div class="form-grp" data-category-wrap>
        <label class="form-lbl" for="partnership-cat">Partner category</label>
        <select class="form-sel" id="partnership-cat" name="category" data-category>
          {openCategories.length
            ? openCategories.map(c => <option value={c}>Official {c} Partner</option>)
            : <option value="Other">Tell us in your message</option>}
        </select>
      </div>
    </div>
  ) : kind === 'hospitality' ? (
    <>
      <div class="form-row">
        <div class="form-grp"><label class="form-lbl" for="hospitality-co">Company or group <span>(optional)</span></label>
          <input class="form-inp" id="hospitality-co" name="company" autocomplete="organization" /></div>
        <div class="form-grp"><label class="form-lbl" for="hospitality-guests">Number of guests</label>
          <input class="form-inp" id="hospitality-guests" name="guests" type="number" min="1" max="500" inputmode="numeric" required /></div>
      </div>
      <div class="form-row">
        <div class="form-grp"><label class="form-lbl" for="hospitality-match">Which match?</label>
          <input class="form-inp" id="hospitality-match" name="subject" placeholder="e.g. next home game, or a date" required /></div>
        {packages.length > 0 && (
          <div class="form-grp"><label class="form-lbl" for="hospitality-pkg">Package</label>
            <select class="form-sel" id="hospitality-pkg" name="category" data-package>{packages.map(n => <option>{n}</option>)}<option>Not sure yet</option></select></div>
        )}
      </div>
    </>
  ) : (
    <div class="form-grp"><label class="form-lbl" for="contact-sub">Subject</label>
      <input class="form-inp" id="contact-sub" name="subject" placeholder="How can we help?" required /></div>
  )}
  <div class="form-grp"><label class="form-lbl" for={`${kind}-msg`}>Message</label>
    <textarea class="form-ta" id={`${kind}-msg`} name="message" required
      placeholder={kind === 'partnership' ? 'How would you like to work with Lobi Stars?' : kind === 'hospitality' ? 'Tell us about your group or event, and anything you need.' : 'Write your message here...'}></textarea></div>
  {kind !== 'contact' && (
    <div class="form-grp eq-consent">
      <label><input type="checkbox" name="privacy_consent" value="yes" required />
        I agree that Lobi Stars FC may use these details to respond to my enquiry, as described in the <a href="/privacy" target="_blank">Privacy Policy</a>.</label>
    </div>
  )}
  <p class="eq-status" role="status" aria-live="polite" hidden></p>
  <button type="submit" class="btn-p eq-submit">{submitLabel}</button>
</form>

<style>
  .eq-submit { width: 100%; padding: 15px; font-size: 15px; }
  .eq-status { padding: 12px 14px; border-radius: 8px; font-size: 15px; margin: 0 0 14px; }
  .eq-status.ok { background: #E8F7EE; color: #17643A; }
  .eq-status.err { background: #FDECEC; color: #A3161B; }
  .form-lbl span { text-transform: none; letter-spacing: 0; font-weight: 400; }
  .eq-consent label { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; line-height: 1.5; color: var(--lt); cursor: pointer; }
  .eq-consent input { width: 18px; height: 18px; margin-top: 2px; flex-shrink: 0; accent-color: var(--red); }
  .eq-consent a { color: var(--red-text); font-weight: 600; }
</style>

<script>
  // Partnership form: the category list only applies to Official Club Partner.
  document.querySelectorAll<HTMLSelectElement>('[data-interest]').forEach(sel => {
    const wrap = sel.form?.querySelector<HTMLElement>('[data-category-wrap]');
    const cat = wrap?.querySelector('select');
    const sync = () => {
      const on = sel.selectedIndex === 0;
      if (wrap) wrap.hidden = !on;
      if (cat) cat.disabled = !on;
    };
    sel.addEventListener('change', sync);
    sync();
  });
  // Hospitality "Enquire" buttons pre-select the package and jump to the form.
  document.querySelectorAll<HTMLElement>('[data-enquire-package]').forEach(btn => btn.addEventListener('click', e => {
    const form = document.querySelector<HTMLFormElement>('[data-enquiry]');
    const pkg = form?.querySelector<HTMLSelectElement>('[data-package]');
    if (!form) return;
    e.preventDefault();
    if (pkg) pkg.value = btn.dataset.enquirePackage!;
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    form.querySelector<HTMLInputElement>('input:not([type=hidden])')?.focus({ preventScroll: true });
  }));
  // "Enquire" buttons pre-select a category and jump to the form.
  document.querySelectorAll<HTMLElement>('[data-enquire]').forEach(btn => btn.addEventListener('click', e => {
    const form = document.querySelector<HTMLFormElement>('[data-enquiry]');
    const interest = form?.querySelector<HTMLSelectElement>('[data-interest]');
    const cat = form?.querySelector<HTMLSelectElement>('[data-category]');
    if (!form || !interest || !cat) return;
    e.preventDefault();
    interest.selectedIndex = 0;
    interest.dispatchEvent(new Event('change'));
    cat.value = btn.dataset.enquire!;
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    form.querySelector<HTMLInputElement>('input:not([type=hidden])')?.focus({ preventScroll: true });
  }));

  document.querySelectorAll<HTMLFormElement>('[data-enquiry]').forEach(form => {
    const status = form.querySelector<HTMLElement>('.eq-status')!;
    const btn = form.querySelector<HTMLButtonElement>('.eq-submit')!;
    const label = btn.textContent;
    form.addEventListener('submit', async e => {
      if (!form.checkValidity()) return; // let the browser show what's missing
      e.preventDefault();
      btn.disabled = true; btn.textContent = 'Sending...';
      status.hidden = true; status.className = 'eq-status';
      try {
        // Save to the club's own database (fan database), then send to the Formspree inbox as before.
        const data: Record<string, unknown> = Object.fromEntries(new FormData(form).entries());
        data.privacy_consent = !!data.privacy_consent;
        await fetch('/api/enquiry', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) }).catch(() => {});
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error();
        form.reset();
        status.textContent = 'Thank you! Your message has been sent. We will get back to you shortly.';
        status.classList.add('ok');
      } catch {
        status.textContent = 'Sorry, your message could not be sent. Please try again or email us directly.';
        status.classList.add('err');
      } finally {
        status.hidden = false; btn.disabled = false; btn.textContent = label;
      }
    });
  });
</script>
