---
// Homepage hero: full-width stadium photo with the club name, shown on
// phones and laptops. Cross-fades through every slide in the CMS ("Hero
// Slides", in order number) rather than showing just the first one, so
// staff can add as many photos as they like.
import { getCollection } from 'astro:content';
const slides = (await getCollection('heroSlides')).sort((a, b) => a.data.order - b.data.order);
const photos = slides.length
  ? slides.map(s => ({ src: s.data.photo, mobileFit: s.data.mobileFit }))
  : [{ src: '/images/hero-1.jpg', mobileFit: 'cover' as const }];
---
<section class="hh" aria-labelledby="hh-title" data-hero-slider>
  {photos.map((photo, i) => (
    <img
      class:list={['hh-bg', { active: i === 0 }]}
      data-slide
      data-mobile-fit={photo.mobileFit}
      src={photo.src}
      alt=""
      width="1920" height="1080"
      loading={i === 0 ? 'eager' : 'lazy'}
      fetchpriority={i === 0 ? 'high' : 'auto'}
      decoding="async"
      sizes="100vw"
    />
  ))}
  <div class="hh-shade" aria-hidden="true"></div>
  <div class="hh-inner">
    <h1 class="hh-title" id="hh-title"><span class="hh-lobi">Lobi</span> <span class="hh-stars">Stars</span><span class="hh-fc">Football Club</span></h1>
    <p class="hh-tag">Glory to Glory</p>
    <div class="hh-acts">
      <a class="btn-p" href="/fixtures">Fixtures</a>
      <a class="btn-o hh-o" href="/tickets">Buy Tickets</a>
      <a class="btn-o hh-o" href="/shop">Club Shop</a>
    </div>
  </div>
  {photos.length > 1 && (
    <div class="hh-dots" data-dots aria-hidden="true">
      {photos.map((_, i) => <span class:list={['hh-dot', { active: i === 0 }]} data-dot></span>)}
    </div>
  )}
</section>

<style>
  .hh { position: relative; min-height: min(86vh, 820px); display: flex; align-items: center; justify-content: center; overflow: hidden; background: #0A0A0A; color: #fff; text-align: center; }
  .hh-bg {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center;
    opacity: 0; transition: opacity 1.3s ease; will-change: opacity, transform;
  }
  .hh-bg.active { opacity: 1; animation: hh-kb 7s ease forwards; }
  @keyframes hh-kb { from { transform: scale(1); } to { transform: scale(1.06); } }
  @media (prefers-reduced-motion: reduce) {
    .hh-bg.active { animation: none; }
  }
  .hh-dots { position: absolute; bottom: 18px; left: 50%; transform: translateX(-50%); z-index: 2; display: flex; gap: 7px; }
  .hh-dot { width: 7px; height: 7px; border-radius: 50%; background: rgba(255,255,255,.35); transition: all .3s; }
  .hh-dot.active { background: #FFC72C; width: 22px; border-radius: 4px; }
  .hh-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,10,.55) 0%, rgba(10,10,10,.35) 40%, rgba(77,11,13,.75) 100%); }
  .hh-inner { position: relative; padding: 48px 5%; max-width: 980px; }
  .hh-title { margin: 0; font: 400 clamp(64px, 14vw, 168px)/.86 'Bebas Neue', sans-serif; letter-spacing: 2px; color: #fff; text-shadow: 0 6px 30px rgba(0,0,0,.45); }
  .hh-stars { color: #FFC72C; }
  .hh-fc { display: block; margin-top: 10px; font: 700 clamp(15px, 2.4vw, 24px)/1 'Barlow Condensed', sans-serif; letter-spacing: clamp(6px, 1.4vw, 14px); text-transform: uppercase; color: #fff; }
  .hh-tag { margin: 18px 0 0; font: 700 clamp(14px, 1.8vw, 18px)/1 'Barlow Condensed', sans-serif; letter-spacing: 6px; text-transform: uppercase; color: rgba(255,255,255,.9); }
  .hh-acts { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-top: 30px; }
  .hh-o { color: #fff; border-color: rgba(255,255,255,.7); }
  .hh-o:hover { background: #fff; color: var(--rdp); border-color: #fff; }
  @media (max-width: 600px) {
    .hh { min-height: 72svh; }
    .hh-inner { padding: 40px 18px; }
    .hh-acts a { flex: 1 1 140px; padding-left: 12px; padding-right: 12px; }
    /* A wide group/lineup photo cropped to this tall, narrow box under the
       default "cover" fit loses the people at each edge -- "contain" shows
       the whole photo instead, letterboxed on the section's dark background. */
    .hh-bg[data-mobile-fit="contain"] { object-fit: contain; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero-slider]').forEach(hero => {
    const slides = hero.querySelectorAll<HTMLElement>('[data-slide]');
    const dots = hero.querySelectorAll<HTMLElement>('[data-dot]');
    if (slides.length < 2) return; // nothing to cycle

    let cur = 0;
    const show = (i: number) => {
      slides[cur]?.classList.remove('active');
      dots[cur]?.classList.remove('active');
      cur = (i + slides.length) % slides.length;
      slides[cur]?.classList.add('active');
      dots[cur]?.classList.add('active');
    };

    let timer = window.setInterval(() => show(cur + 1), 5500);
    // Pause the rotation once the tab/section is out of view so it doesn't
    // keep swapping images (and restarting the Ken Burns zoom) unseen.
    const io = new IntersectionObserver(([entry]) => {
      clearInterval(timer);
      if (entry.isIntersecting) timer = window.setInterval(() => show(cur + 1), 5500);
    }, { threshold: 0.1 });
    io.observe(hero);
  });
</script>
