---
// Layout for rules, terms and policy pages. `draft` shows a clear banner
// and keeps the page out of search engines until it has been reviewed.
import Layout from '../layouts/Layout.astro';

interface Props { title: string; description: string; tag?: string; updated: string; draft?: string }
const { title, description, tag = 'Legal', updated, draft } = Astro.props;
---
<Layout title={`${title} | Lobi Stars Football Club`} description={description} noindex={!!draft}>
  <div class="page-hero wrap">
    <div class="stag">{tag}</div>
    <h1 class="stitle">{title}</h1>
    <div class="divr"></div>
    <p class="lg-updated">Last updated: {updated}</p>
  </div>
  <div class="page-content wrap lg">
    {draft && <p class="lg-draft" role="note"><strong>DRAFT</strong> &ndash; {draft}</p>}
    <slot />
  </div>
</Layout>

<style>
  .lg-updated { margin: 14px 0 0; color: var(--lt); font-size: 14px; }
  .lg { max-width: 820px; padding-bottom: 80px; line-height: 1.7; font-size: 16px; }
  .lg-draft { background: #FFF4D6; border: 1px solid #F0C24B; color: #5C4300; border-radius: 10px; padding: 14px 18px; margin: 0 0 28px; }
  .lg :global(h2) { margin: 34px 0 10px; font: 400 28px/1.1 'Bebas Neue', sans-serif; letter-spacing: 1px; }
  .lg :global(h3) { margin: 22px 0 6px; font: 700 17px/1.3 'Barlow Condensed', sans-serif; letter-spacing: .5px; text-transform: uppercase; }
  .lg :global(p), .lg :global(li) { color: var(--white); }
  .lg :global(ol), .lg :global(ul) { padding-left: 22px; }
  .lg :global(li) { margin: 4px 0; }
  .lg :global(a) { color: var(--red-text); font-weight: 600; }
  .lg :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; margin: 10px 0 18px; }
  .lg :global(th), .lg :global(td) { text-align: left; vertical-align: top; padding: 8px 10px; border-bottom: 1px solid var(--d4); }
  .lg :global(th) { font: 700 13px/1.2 'Barlow Condensed', sans-serif; letter-spacing: 1px; text-transform: uppercase; color: var(--lt); }
  .lg :global(.lg-scroll) { overflow-x: auto; position: relative; }
</style>
